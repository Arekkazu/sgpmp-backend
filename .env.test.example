# | Fecha      | Nombre     | Que se hizo |
# |------------|------------|-------------|
# | 2026-11-21 | chebaztian | HU-IMP-CFG-04 ST-04a #1180: variables del compose de #1204 y MQTT_BROKER_URL/TOKEN; retiro de las credenciales M2M de AgroFusion |
# ============================================================
# SGPMP - Backend - Ambiente TEST
# ============================================================
# Plantilla de referencia.
# Copiar localmente como .env.test y completar los valores
# requeridos. Nunca versionar .env.test.
# ============================================================

# PostgreSQL TEST
POSTGRES_USER=sgpmp_test_user
POSTGRES_PASSWORD=
POSTGRES_DB=sgpmp_test

# Backend
SECRET_KEY=
JWT_EXPIRE_HOURS=8
REFRESH_TOKEN_EXPIRE_DAYS=7
FRONTEND_URL=

# Controla el comportamiento de la cookie refresh.
# En TEST desplegado por HTTPS usar production para habilitar
# Secure=true y SameSite=None.
# En pruebas locales por HTTP puede usarse test.
ENV=production

# Origen HTTPS real del Frontend TEST, sin / final.
# El valor definitivo lo configura Despliegue.
ALLOWED_ORIGINS=

ROOT_PATH=/api

# Correo SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Google reCAPTCHA v2 — clave secreta usada solo por el backend en RF-01.
# La site key pública se configura en el frontend, no en este repositorio.
RECAPTCHA_SECRET_KEY=

# Firebase
FIREBASE_CREDENTIALS_PATH=

# Almacenamiento de modelos
MODELOS_STORAGE_PATH=/tmp/sgpmp_modelos

# AgroFusion - SSO
AGROFUSION_SSO_PUBLIC_KEY_PATH=
AGROFUSION_PROJECT_CODE=
AGROFUSION_ISSUER=agrofusion-auth

# RF-71 - registro interno de modelos
RF71_INTERNAL_KEY=

# Broker MQTT (gateway HTTP del broker de TEST). Obligatorias: el
# compose de TEST no arranca sin ellas.
# URL del gateway del broker de TEST, sin / final. La confirma Despliegue.
MQTT_BROKER_URL=
# Sensible: la carga Despliegue.
MQTT_BROKER_TOKEN=

# ------------------------------------------------------------
# Variables que pasa docker-compose.test.yml desde el PR #1204
# (issue #1180). Hasta que #1204 se fusione, el compose de TEST
# todavía no las entrega al contenedor.
# ------------------------------------------------------------

# M07 - Entorno que se informa en SourceSystem.Environment (RF-97).
# Opcional: el compose pone TEST por defecto.
SGPMP_ENTORNO=TEST

# M04 - Firma HMAC de los artefactos de modelos (SEG-M04-01, RF-69).
# Sensible: la carga Despliegue. Sin valor, registrar un modelo
# responde 503 y activarlo responde 422.
M04_FIRMA_MODELOS_KEY=

# M04 - Cliente del motor de inferencia (RF-56/RF-66).
# Cargar URL y token solo cuando el motor de TEST tenga modelos
# (modelos_cargados > 0): si no, los paquetes quedan FALLIDO tras
# 5 intentos. Con la URL vacía, los paquetes quedan pendientes.
IOT_INFERENCIA_M04_URL=
# Sensible: la carga Despliegue (el mismo valor que en el motor).
IOT_INFERENCIA_M04_TOKEN=
IOT_INFERENCIA_TLS_MIN=1.3
# Vacía: CAs del sistema. Solo si el motor usa una CA privada.
IOT_INFERENCIA_CA_FILE=
# IOT_AUDITORIA_RESPALDO_PATH: la fija la imagen
# (/app/storage/auditoria_iot/fallas.sqlite3). No cargarla.

# OTA - URL firmada del artefacto (DEV-15). Sin secreto y base,
# POST /prediccion/ota/distribuciones responde 503.
# Sensible: la carga Despliegue.
OTA_URL_SECRET=
# URL pública del backend de TEST, sin / final. La confirma Despliegue.
OTA_URL_BASE=
OTA_URL_TTL_SEGUNDOS=86400

# RF-26 - Logos. TEST no tiene volumen para esta ruta: los logos
# se pierden en cada Deploy.
LOGOS_STORAGE_PATH=/tmp/sgpmp_logos

# Sandbox transaccional de pruebas (rollback por X-Test-Run-Id). Solo TEST.
# Apagado por defecto: activarlo (true) solo donde QA vaya a correr regresion.
# El secreto se genera con `openssl rand -hex 32` y se comparte por un canal
# seguro; nunca el valor de ejemplo.
ENABLE_TEST_SANDBOX=false
TEST_SANDBOX_SECRET=