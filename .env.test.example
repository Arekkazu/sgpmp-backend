# ============================================================
# SGPMP - Backend - Ambiente TEST
# ============================================================
# Plantilla de referencia.
# Copiar localmente como .env.test y completar los valores
# requeridos. Nunca versionar .env.test.
# ============================================================

# PostgreSQL TEST
POSTGRES_USER=sgpmp_test_user
POSTGRES_PASSWORD=
POSTGRES_DB=sgpmp_test

# Backend
SECRET_KEY=
JWT_EXPIRE_HOURS=8
REFRESH_TOKEN_EXPIRE_DAYS=7
FRONTEND_URL=

# Controla el comportamiento de la cookie refresh.
# En TEST desplegado por HTTPS usar production para habilitar
# Secure=true y SameSite=None.
# En pruebas locales por HTTP puede usarse test.
ENV=production

# Origen HTTPS real del Frontend TEST, sin / final.
# El valor definitivo lo configura Despliegue.
ALLOWED_ORIGINS=

ROOT_PATH=/api

# Correo SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Firebase
FIREBASE_CREDENTIALS_PATH=

# Almacenamiento de modelos
MODELOS_STORAGE_PATH=/tmp/sgpmp_modelos

# AgroFusion - SSO
AGROFUSION_SSO_PUBLIC_KEY_PATH=
AGROFUSION_PROJECT_CODE=
AGROFUSION_ISSUER=agrofusion-auth

# AgroFusion - integración M2M
AGROFUSION_HUB_CLIENT_ID=
AGROFUSION_HUB_CLIENT_SECRET=

# RF-71 - registro interno de modelos
RF71_INTERNAL_KEY=
