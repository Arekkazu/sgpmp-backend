# ==============================================================
# SGPMP - Backend - Ambiente PROD
# ==============================================================
# ESTO ES SOLO LA PLANTILLA. No contiene ningun valor real y no debe
# contenerlo nunca: es un archivo versionado y publico dentro del repositorio.
#
#   - El archivo `.env.prod` real NUNCA se versiona (`.gitignore` lo excluye).
#   - En PROD los valores NO se cargan desde un archivo: se inyectan como
#     variables de entorno en Dokploy. Este archivo es el catalogo de que
#     variables hay que cargar alli, y quien provee cada valor.
#   - Para validar el compose en local: copiar este archivo como `.env.prod`
#     y completarlo con valores FICTICIOS, nunca con credenciales reales.
#
# Las variables marcadas OBLIGATORIA usan la sintaxis ${VAR:?...} en
# docker-compose.prod.yml: si faltan, `docker compose config` falla con un
# mensaje explicito en vez de levantar un contenedor mal configurado.
#
# NO existe `DB_PORT` en esta plantilla, a diferencia de DEV y TEST. Es
# deliberado: en PROD el servicio `db` no publica ningun puerto al host, asi
# que la variable no tendria efecto. No agregarla por analogia con los otros
# ambientes.
#
# ENV no aparece como variable: docker-compose.prod.yml la fija en
# `ENV: production` de forma literal. Es intencional — si fuera parametrizable
# alguien podria cambiarla en Dokploy y perder en silencio las validaciones de
# cookie que el backend solo aplica cuando ENV vale exactamente "production".
# ==============================================================


# ==============================================================
# PostgreSQL — servicio `db`
# ==============================================================
# Las tres son OBLIGATORIAS. Las provee el DBA.
# docker-compose.prod.yml arma DATABASE_URL a partir de estas tres; no se
# define DATABASE_URL aparte.
# POSTGRES_DB ademas da el nombre del contenedor (`${POSTGRES_DB}-db`), que es
# el hostname por el que el backend alcanza la base dentro de la red.
#
# ADVERTENCIA (hallazgo de la validacion, pendiente en Desarrollo):
# alembic/baseline/esquema_baseline.sql contiene 979 sentencias
# `OWNER TO postgres` con el rol propietario hardcodeado. Sobre una base vacia
# creada con cualquier POSTGRES_USER distinto de `postgres`, el comando
# `alembic upgrade head` falla con `role "postgres" does not exist` y hace
# rollback limpio. La imagen de PostgreSQL crea como superusuario exactamente
# el nombre que reciba en POSTGRES_USER, asi que el valor elegido aqui
# determina si el esquema se puede construir con migraciones.
# No se detecto antes porque DEV y TEST partieron del dump del DBA: ahi la
# revision baseline ve que `modulo1` ya existe y solo se sella.
# Antes de construir PROD desde cero, coordinar con Desarrollo y el DBA (ver
# el reporte de validacion del ambiente PROD). El valor de esta variable lo
# sigue definiendo el DBA; este archivo no lo fija.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=


# ==============================================================
# Aplicacion
# ==============================================================

# ROOT_PATH — opcional, default `/api`. La provee Despliegue.
# Prefijo externo que Dokploy le asigna al servicio (su config de Path en el
# dominio). Solo afecta los links que genera /docs; el ruteo real lo maneja
# Traefik con "Strip Path".
ROOT_PATH=/api

# FRONTEND_URL — OBLIGATORIA. La provee Despliegue.
# URL del frontend de PROD, usada solo para armar los links de los correos
# (activacion de cuenta, recuperacion de contrasena). No controla CORS.
FRONTEND_URL=


# ==============================================================
# CORS y cookies
# ==============================================================

# ALLOWED_ORIGINS — OBLIGATORIA. La provee Despliegue.
# Origen HTTPS EXACTO del frontend de PROD, sin barra final. Varios origenes
# se separan por coma. localhost/127.0.0.1 ya esta permitido siempre aparte de
# esto, no hace falta listarlo.
# Es la causa raiz del incidente de mixed content de TEST: un origen con
# esquema http:// o con barra final no coincide y el navegador bloquea la
# peticion.
ALLOWED_ORIGINS=

# COOKIE_SECURE y COOKIE_SAMESITE — OBLIGATORIAS Y CRITICAS.
# Las provee Despliegue, segun el dominio definitivo.
# El backend las valida al arranque y SE NIEGA A LEVANTAR si faltan cuando
# ENV=production (que en PROD es siempre el caso).
#   - Si frontend y backend viven en dominios registrables DISTINTOS:
#       COOKIE_SECURE=true   COOKIE_SAMESITE=none
#   - Si comparten dominio registrable (solo difieren en la ruta, p. ej. / y
#     /api): son el MISMO sitio y COOKIE_SAMESITE=lax es suficiente.
# Los navegadores DESCARTAN una cookie con SameSite=None sin Secure: `none`
# obliga a COOKIE_SECURE=true. Si la cookie de refresh se descarta, el refresh
# falla y la sesion muere al navegar.
COOKIE_SECURE=
COOKIE_SAMESITE=


# ==============================================================
# JWT
# ==============================================================

# SECRET_KEY — OBLIGATORIA. La genera Implementacion.
# Clave de firma HS256 (el algoritmo es fijo, no configurable). Debe ser larga
# y aleatoria, y distinta de la de DEV y TEST. Generar al momento de
# configurar Dokploy y no reutilizar de ningun otro ambiente.
SECRET_KEY=

# Opcionales, con default en el compose. Las define Implementacion.
# JWT_EXPIRE_HOURS: vigencia del access token (default 8).
JWT_EXPIRE_HOURS=8
# JWT_LEEWAY_SECONDS: tolerancia de skew de reloj al verificar exp (default
# 30). Evita TOKEN_EXPIRADO espurios cuando el reloj del servidor va por
# detras del emisor del token.
JWT_LEEWAY_SECONDS=30
# REFRESH_TOKEN_EXPIRE_DAYS: vigencia del refresh token, que es opaco y viaja
# en cookie HttpOnly, no es un JWT (default 7).
REFRESH_TOKEN_EXPIRE_DAYS=7


# ==============================================================
# Almacenamiento
# ==============================================================
# Opcionales, con default en el compose. Las define Implementacion.
# Ambas apuntan al volumen persistente `sgpmp_modelos_prod`, montado en
# /app/storage/modelos. Si se dejan vacias aqui, el compose aplica esos mismos
# defaults; si se cambian a una ruta fuera del volumen, los datos se pierden
# en cada redespliegue.
# MODELOS_STORAGE_PATH: artefactos de los modelos de prediccion.
MODELOS_STORAGE_PATH=/app/storage/modelos
# LOGOS_STORAGE_PATH: logotipos institucionales (RF-26). Reutiliza el mismo
# volumen en vez de pedir uno nuevo.
LOGOS_STORAGE_PATH=/app/storage/modelos/logos


# ==============================================================
# SMTP — envio de correos
# ==============================================================
# Los valores los proveen Desarrollo (la cuenta) y Despliegue (su carga en
# Dokploy).
# SMTP_USER y SMTP_PASSWORD son OBLIGATORIAS: sin ellas fallan la activacion
# de cuenta y la recuperacion de contrasena, y fallan en silencio para el
# usuario final.
# SMTP_HOST y SMTP_PORT son opcionales, con default smtp.gmail.com:587.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=


# ==============================================================
# reCAPTCHA
# ==============================================================

# RECAPTCHA_SECRET_KEY — OBLIGATORIA. La provee Desarrollo.
# Clave secreta de Google reCAPTCHA v2, usada solo por el backend en RF-01.
# La site key publica se configura en el frontend, no en este repositorio.
RECAPTCHA_SECRET_KEY=


# ==============================================================
# Firebase — notificaciones push
# ==============================================================

# FIREBASE_CREDENTIALS_PATH — opcional. La provee Desarrollo.
# Vacia => las notificaciones push quedan deshabilitadas, sin romper el resto
# de la aplicacion.
# ATENCION: es la RUTA a un archivo DENTRO del contenedor, no el contenido del
# JSON. Si se usa en PROD, Despliegue debe montar el archivo de credenciales
# en el contenedor (bind mount o secret de Dokploy) y poner aqui esa ruta.
FIREBASE_CREDENTIALS_PATH=


# ==============================================================
# MQTT — integracion con el gateway AIoT (RF-23)
# ==============================================================
# Opcionales. MQTT_BROKER_URL la provee AIoT; MQTT_BROKER_TOKEN se coordina
# entre AIoT y el DBA.
# ATENCION: el hash SHA-256 de MQTT_BROKER_TOKEN debe existir como fila en
# modulo1.credenciales_servicio, con nombre_servicio='broker_mqtt' y
# es_activo=true. Si esa fila no esta, el broker rechaza TODAS las llamadas
# con 401. El backend solo deja una advertencia en el log al arrancar; no lo
# detecta ni lo corrige. La siembra de esa fila es responsabilidad del DBA.
MQTT_BROKER_URL=
MQTT_BROKER_TOKEN=


# ==============================================================
# AgroFusion — SSO e integracion
# ==============================================================
# Todas opcionales. Las provee Desarrollo.
# Vacias o ausentes => el SSO responde 503 y la sincronizacion
# server-to-server no se monta; el backend funciona 100% standalone sin esto.

# Mecanismo A — handoff de login interactivo (RS256).
# ATENCION: AGROFUSION_SSO_PUBLIC_KEY_PATH es la RUTA a un archivo DENTRO del
# contenedor, no el contenido de la clave. Si se usa en PROD, Despliegue debe
# montar ese archivo en el contenedor.
AGROFUSION_SSO_PUBLIC_KEY_PATH=
AGROFUSION_PROJECT_CODE=
AGROFUSION_ISSUER=agrofusion-auth

# Mecanismo B — sincronizacion server-to-server.
AGROFUSION_HUB_CLIENT_ID=
AGROFUSION_HUB_CLIENT_SECRET=


# ==============================================================
# RF-71 — registro de modelos de prediccion
# ==============================================================

# RF71_INTERNAL_KEY — opcional. La define Implementacion.
# Clave interna para el endpoint de registro de modelos de prediccion.
RF71_INTERNAL_KEY=
