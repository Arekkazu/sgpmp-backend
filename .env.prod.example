# ==============================================================
# Variables de entorno para despliegue en producción
# Copiar a .env.prod y rellenar los valores correspondientes
# ==============================================================

# PostgreSQL del servicio "db"
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Puerto interno del contenedor DB (no expuesto al host)
DB_PORT=

# --------------------------------------------------------------
# Configuración del Backend y Seguridad (JWT)
# --------------------------------------------------------------
ENV=production
SECRET_KEY=
FRONTEND_URL=
ALLOWED_ORIGINS=
ROOT_PATH=

# JWT
JWT_EXPIRE_HOURS=
JWT_LEEWAY_SECONDS=
REFRESH_TOKEN_EXPIRE_DAYS=

# Cookies (importante para HTTPS)
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# SMTP (correo de activación, recuperación, etc.)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# reCAPTCHA (RF‑01)
RECAPTCHA_SECRET_KEY=

# Firebase (push notifications)
FIREBASE_CREDENTIALS_PATH=

# Almacenamiento de artefactos de modelos y logos
MODELOS_STORAGE_PATH=
LOGOS_STORAGE_PATH=

# Integración AgroFusion (SSO)
AGROFUSION_SSO_PUBLIC_KEY_PATH=
AGROFUSION_PROJECT_CODE=
AGROFUSION_ISSUER=
AGROFUSION_HUB_CLIENT_ID=
AGROFUSION_HUB_CLIENT_SECRET=

# RF‑71 – clave interna para registro de modelos
RF71_INTERNAL_KEY=

# MQTT (RF‑23)
MQTT_BROKER_URL=
MQTT_BROKER_TOKEN=
