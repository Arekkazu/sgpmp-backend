                  "let j = {}; try { j = pm.response.json(); } catch (e) {}",
                  "pm.test('TC-M03-019 (2do envío): código ERROR_DUPLICADO', function () { pm.expect(j.error_code).to.eql('ERROR_DUPLICADO'); });",
                  "pm.test('TC-M03-019 (2do envío): no devuelve id_telemetria (no se persiste)', function () { pm.expect(j.id_telemetria).to.be.undefined; });"
