    {
      "name": "4. Verificación de registros persistidos",
      "item": [
        {
          "name": "TC-M03-019/020 - Registros persistidos del sensor",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Historial responde 200', function () { pm.response.to.have.status(200); });",
                  "const items = pm.response.json().items || [];",
                  "const real = items.filter(x => x.origen_dato === 'TIEMPO_REAL');",
                  "const edge = items.filter(x => x.origen_dato === 'EDGE_AGREGADO');",
                  "pm.test('TC-M03-019: un solo registro TIEMPO_REAL', function () {",
                  "  pm.expect(real.map(x => x.id_telemetria)).to.eql([Number(pm.collectionVariables.get('id_tel_real'))]);",
                  "});",
                  "pm.test('TC-M03-020: dos registros EDGE_AGREGADO (ventana 5 y ventana 10)', function () {",
                  "  const esperados = ['id_tel_v5', 'id_tel_v10'].map(k => Number(pm.collectionVariables.get(k))).sort();",
                  "  pm.expect(edge.map(x => x.id_telemetria).sort()).to.eql(esperados);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/iot/monitoreo/historial?fecha_inicio={{fecha_desde}}&fecha_fin={{fecha_hasta}}&sensor_id={{sensor_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "iot",
                "monitoreo",
                "historial"
              ],
              "query": [
                {
                  "key": "fecha_inicio",
                  "value": "{{fecha_desde}}"
                },
                {
                  "key": "fecha_fin",
                  "value": "{{fecha_hasta}}"
                },
                {
                  "key": "sensor_id",
                  "value": "{{sensor_id}}"
                }
              ]
            }
          },
          "response": []
        }
      ]
    }
