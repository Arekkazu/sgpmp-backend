    {
      "name": "3. TC-M03-062 Inyección de sensor ajeno",
      "item": [
        {
          "name": "TC-M03-062a - Credenciales válidas de A + sensor_id de B",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('ts_captura', new Date(Date.now() - 2000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('TC-M03-062a: rechazado con 401', function () { pm.response.to.have.status(401); });",
                  "let j = {}; try { j = pm.response.json(); } catch (e) {}",
                  "pm.test('TC-M03-062a: ERROR_AUTENTICACION o asociación inválida', function () {",
                  "  pm.expect(j.error_code).to.be.oneOf(['ERROR_AUTENTICACION', 'SENSOR_DISPOSITIVO_INVALIDO']);",
                  "});",
                  "pm.test('TC-M03-062a: no devuelve id_telemetria (no se persiste)', function () { pm.expect(j.id_telemetria).to.be.undefined; });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/iot/telemetria",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "iot",
                "telemetria"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": {{device_a}},\n  \"sensor_id\": {{sensor_b}},\n  \"tipo_variable\": \"TEMPERATURA_AMBIENTAL\",\n  \"valor\": 99.0,\n  \"unidad\": \"°C\",\n  \"timestamp_captura\": \"{{ts_captura}}\",\n  \"origen\": \"TIEMPO_REAL\",\n  \"access_key\": \"{{key_a}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "TC-M03-062b - access_key válida de A declarando device_id de B y sensor_id de B",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('ts_captura', new Date(Date.now() - 2000).toISOString());"
                ]
              }
