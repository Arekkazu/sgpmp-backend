        {
          "name": "Precondición: el sensor NO tiene calibración configurada (RF-24)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Historial de calibraciones responde 200', function () { pm.response.to.have.status(200); });",
                  "const b = pm.response.json();",
                  "pm.test('Sensor sin parámetros de calibración', function () { pm.expect((Array.isArray(b) ? b : (b.items || [])).length).to.eql(0); });"
                ]
