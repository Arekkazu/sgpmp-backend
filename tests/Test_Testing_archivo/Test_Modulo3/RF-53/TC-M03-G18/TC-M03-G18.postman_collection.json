    {
      "name": "2. TC-M03-063 Campos de solo-servidor en el payload",
      "item": [
        {
          "name": "TC-M03-063 - Payload válido con campos de solo-servidor forzados por el cliente",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('ts_captura', new Date(Date.now() - 2000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const rechazado = pm.response.code === 400 || pm.response.code === 422;",
                  "pm.collectionVariables.set('g18_rechazado', String(rechazado));",
                  "pm.test('TC-M03-063: los campos forzados se rechazan (4xx) o se ignoran (201)', function () {",
                  "  pm.expect(rechazado || pm.response.code === 201, 'HTTP ' + pm.response.code).to.eql(true);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "  const j = pm.response.json();",
                  "  pm.collectionVariables.set('id_tel', j.id_telemetria);",
                  "  pm.test('TC-M03-063: id_telemetria lo asigna el servidor (no \"forzado-123\" ni 1)', function () {",
                  "    pm.expect(j.id_telemetria).to.be.a('number'); pm.expect(j.id_telemetria).to.not.eql(1);",
                  "  });",
                  "  pm.test('TC-M03-063: estado real según reglas (ERROR_CALIBRACION, sensor sin calibrar), no el enviado', function () {",
                  "    pm.expect(j.estado_calidad).to.eql('ERROR_CALIBRACION');",
                  "  });",
                  "  pm.test('TC-M03-063: timestamp_procesamiento del servidor (no 2020-01-01)', function () {",
                  "    pm.expect(new Date(j.timestamp_procesamiento).getUTCFullYear()).to.be.at.least(2026);",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/iot/telemetria",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "iot",
                "telemetria"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": {{device_id}},\n  \"sensor_id\": {{sensor_id}},\n  \"tipo_variable\": \"TEMPERATURA_AMBIENTAL\",\n  \"valor\": 25.0,\n  \"unidad\": \"°C\",\n  \"timestamp_captura\": \"{{ts_captura}}\",\n  \"origen\": \"TIEMPO_REAL\",\n  \"id_registro\": \"forzado-123\",\n  \"id_telemetria\": 1,\n  \"estado_calidad\": \"LECTURA_VALIDA\",\n  \"calibrado\": true,\n  \"valor_ajustado\": 99.9,\n  \"timestamp_procesamiento\": \"2020-01-01T00:00:00Z\",\n  \"parametros_calibracion\": {\"ganancia\": \"9\", \"offset\": \"9\"},\n  \"access_key\": \"{{access_key}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Verificación del registro calculado en backend",
      "item": [
        {
          "name": "TC-M03-063 - Registro persistido calculado en backend (RF-59)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Historial responde 200', function () { pm.response.to.have.status(200); });",
                  "const items = pm.response.json().items || [];",
                  "if (pm.collectionVariables.get('g18_rechazado') === 'true') {",
                  "  pm.test('TC-M03-063 (rechazado): no se persistió nada', function () { pm.expect(items.length).to.eql(0); });",
                  "} else {",
                  "  const it = items.find(x => x.id_telemetria === Number(pm.collectionVariables.get('id_tel')));",
                  "  pm.test('TC-M03-063: la lectura está persistida', function () { pm.expect(it, 'lectura').to.exist; });",
                  "  if (it) {",
                  "    pm.test('TC-M03-063: estado persistido ERROR_CALIBRACION', function () { pm.expect(it.estado_calidad).to.eql('ERROR_CALIBRACION'); });",
                  "    pm.test('TC-M03-063: sin calibración aplicada (valor_ajustado null, no 99.9)', function () { pm.expect(it.valor_ajustado).to.be.null; });",
                  "    pm.test('TC-M03-063: valor = valor crudo enviado (25.0)', function () { pm.expect(Number(it.valor)).to.eql(25); });",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/iot/monitoreo/historial?fecha_inicio={{fecha_desde}}&fecha_fin={{fecha_hasta}}&sensor_id={{sensor_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "iot",
                "monitoreo",
                "historial"
              ],
              "query": [
                {
                  "key": "fecha_inicio",
                  "value": "{{fecha_desde}}"
                },
                {
                  "key": "fecha_fin",
                  "value": "{{fecha_hasta}}"
                },
                {
                  "key": "sensor_id",
                  "value": "{{sensor_id}}"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "TC-M03-063 - Sin parámetros de calibración aplicados (RF-62)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.collectionVariables.get('g18_rechazado') === 'true') { return; }",
                  "pm.test('Calidad responde 200', function () { pm.response.to.have.status(200); });",
                  "const p = pm.response.json().parametros_calibracion_aplicados;",
                  "pm.test('TC-M03-063: no se aplicaron los parámetros forzados (ganancia/offset 9)', function () {",
                  "  pm.expect(p === null || Object.keys(p).length === 0).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/iot/calidad/{{id_tel}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "iot",
                "calidad",
                "{{id_tel}}"
              ]
            }
          },
          "response": []
        }
      ]
    }
