    {
      "name": "3. TC-M03-065 Payload de 5 MB",
      "item": [
        {
          "name": "TC-M03-065 - Datagrama válido con metadata_sensor inflado a 5 MB",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('ts_captura', new Date(Date.now() - 2000).toISOString());",
                  "// 5 MB de relleno dentro de metadata_sensor (campo libre fuera del contrato de ingesta).",
                  "pm.collectionVariables.set('relleno', 'x'.repeat(5 * 1024 * 1024));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "console.log('TC-M03-065: HTTP ' + pm.response.code + ' en ' + pm.response.responseTime + ' ms (control: ' + pm.collectionVariables.get('ms_control') + ' ms)');",
                  "pm.test('TC-M03-065: payload rechazado (413 Payload Too Large o 400)', function () { pm.expect(pm.response.code).to.be.oneOf([413, 400]); });",
                  "pm.test('TC-M03-065: no se procesó (sin id_telemetria)', function () {",
                  "  let j = {}; try { j = pm.response.json(); } catch (e) {}",
                  "  pm.expect(j.id_telemetria).to.be.undefined;",
                  "});",
                  "pm.test('TC-M03-065: rechazo rápido, sin consumo excesivo (< 2 s)', function () { pm.expect(pm.response.responseTime).to.be.below(2000); });",
                  "pm.collectionVariables.unset('relleno');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/iot/telemetria",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "iot",
                "telemetria"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": {{device_id}},\n  \"sensor_id\": {{sensor_id}},\n  \"tipo_variable\": \"TEMPERATURA_AMBIENTAL\",\n  \"valor\": 25.0,\n  \"unidad\": \"°C\",\n  \"timestamp_captura\": \"{{ts_captura}}\",\n  \"origen\": \"TIEMPO_REAL\",\n  \"access_key\": \"{{access_key}}\",\n  \"metadata_sensor\": {\"relleno\": \"{{relleno}}\"}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "TC-M03-065 - El payload inflado no quedó persistido",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Historial responde 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('TC-M03-065: solo existe la lectura de control', function () {",
                  "  pm.expect((pm.response.json().items || []).map(x => x.id_telemetria)).to.eql([Number(pm.collectionVariables.get('id_tel_control'))]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/iot/monitoreo/historial?fecha_inicio={{fecha_desde}}&fecha_fin={{fecha_hasta}}&sensor_id={{sensor_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "iot",
                "monitoreo",
                "historial"
              ],
              "query": [
                {
                  "key": "fecha_inicio",
                  "value": "{{fecha_desde}}"
                },
                {
                  "key": "fecha_fin",
                  "value": "{{fecha_hasta}}"
                },
                {
                  "key": "sensor_id",
                  "value": "{{sensor_id}}"
                }
              ]
            }
          },
          "response": []
        }
      ]
    }
