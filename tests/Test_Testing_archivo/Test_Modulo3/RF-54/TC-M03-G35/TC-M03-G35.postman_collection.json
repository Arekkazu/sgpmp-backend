        {
          "name": "Evento 2 - SYNC_SUCCESS: lote de 5 aceptado completo",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const base = Number(pm.collectionVariables.get('t_base'));",
                  "const registros = [];",
                  "for (let i = 0; i < 5; i++) {",
                  "  registros.push({",
                  "    device_id: Number(pm.collectionVariables.get('device_id')),",
                  "    sensor_id: Number(pm.collectionVariables.get('sensor_id')),",
                  "    tipo_variable: 'TEMPERATURA_AMBIENTAL', valor: 24 + i / 10,",
                  "    unidad: i < 0 ? '%' : '°C',",
                  "    timestamp_captura: new Date(base - (50 - i) * 60000).toISOString(),",
                  "    origen: 'BUFFER_LOCAL',",
                  "    access_key: pm.collectionVariables.get('access_key')",
                  "  });",
                  "}",
                  "pm.collectionVariables.set('lote_ok', JSON.stringify({ registros: registros }));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('SYNC_SUCCESS: lote procesado (200)', function () { pm.response.to.have.status(200); });",
                  "const r = pm.response.json();",
                  "pm.test('SYNC_SUCCESS: 5 aceptados, 0 rechazados, 0 duplicados', function () {",
                  "  pm.expect([r.aceptados, r.rechazados, r.duplicados]).to.eql([5, 0, 0]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
