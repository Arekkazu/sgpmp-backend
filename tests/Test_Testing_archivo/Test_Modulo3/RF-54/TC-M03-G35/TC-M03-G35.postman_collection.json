      "item": [
        {
          "name": "TC-M03-058 - Eventos del buffer replicados en la auditoría global (RF-63)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Auditoría responde 200', function () { pm.response.to.have.status(200); });",
                  "const items = (pm.response.json().items || []);",
                  "console.log('TC-M03-058 eventos del dispositivo en RF-63:', JSON.stringify(items.map(e => [e.tipo_evento, e.resultado, e.entidad_afectada_tipo])));",
                  "const texto = (e) => [e.tipo_evento, e.descripcion, e.accion_detallada].map(x => JSON.stringify(x || '')).join(' ').toUpperCase();",
                  "const eventos = [[\"activación del buffer\", [\"BUFFER_ACTIVADO\", \"BUFFER_ACTIVE\", \"BUFFER_ACTIVO\", \"ACTIVACION_BUFFER\"]], [\"SYNC_SUCCESS\", [\"SYNC_SUCCESS\"]], [\"SYNC_PARTIAL_SUCCESS\", [\"SYNC_PARTIAL_SUCCESS\", \"SYNC_PARTIAL_FAILURE\"]], [\"SYNC_FAILURE\", [\"SYNC_FAILURE\"]], [\"DUPLICATE_DETECTED\", [\"DUPLICATE_DETECTED\"]], [\"BUFFER_OVERFLOW\", [\"BUFFER_OVERFLOW\"]], [\"BUFFER_DRAINED\", [\"BUFFER_DRAINED\"]]];",
                  "eventos.forEach(([nombre, claves]) => {",
                  "  pm.test('TC-M03-058: ' + nombre + ' registrado en RF-63', function () {",
                  "    pm.expect(items.some(e => claves.some(c => texto(e).includes(c))), nombre).to.eql(true);",
                  "  });",
                  "});",
                  "pm.test('TC-M03-058: cada evento trae tipo, timestamp, resultado y entidad BUFFER/DISPOSITIVO', function () {",
                  "  pm.expect(items.length, 'sin eventos del dispositivo').to.be.above(0);",
                  "  items.forEach(e => {",
                  "    pm.expect(e.tipo_evento, 'tipo').to.be.ok; pm.expect(e.fecha_hora, 'timestamp').to.be.ok; pm.expect(e.resultado, 'resultado').to.be.ok;",
                  "    pm.expect(['BUFFER', 'DISPOSITIVO']).to.include(e.entidad_afectada_tipo);",
                  "  });",
                  "});",
                  "pm.test('TC-M03-058: los eventos de sincronización informan la cantidad de datos', function () {",
                  "  const sync = items.filter(e => /SYNC/.test(texto(e)));",
                  "  pm.expect(sync.length, 'sin eventos de sincronización').to.be.above(0);",
                  "  sync.forEach(e => pm.expect(/\\d/.test(JSON.stringify(e.accion_detallada || e.descripcion || '')), 'cantidad').to.eql(true));",
                  "});",
                  "pm.test('TC-M03-058: el desborde informa la política aplicada', function () {",
                  "  const overflow = items.filter(e => texto(e).includes('BUFFER_OVERFLOW'));",
                  "  pm.expect(overflow.some(e => /POLITICA_(RECHAZO|SOBRESCRITURA)/.test(texto(e))), 'política').to.eql(true);",
                  "});"
                ]
              }
            }
