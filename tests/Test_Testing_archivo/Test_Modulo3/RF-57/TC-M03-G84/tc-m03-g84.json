{
  "info": {
    "name": "TC-M03-G84 - Fallo en la entrega de notificaciones: reintentos con backoff y escalamiento al siguiente actor (CA-8, E7)",
    "description": "RF-57 Postcondicion 3 / E7. Parte automatizable por API: la alerta se persiste aunque falle la notificacion y la bitacora puede consultarse por NOTIFICACION_FALLIDA. NO AUTOMATIZABLE con Postman: simular canal de notificacion no disponible, agotar reintentos y verificar backoff/escalamiento (requiere acceso a la cola o servicio de notificaciones o inyeccion de fallos). Segun el documento de desarrollo, notificaciones y canal push se planifican aparte: la ficha puede salir \"no implementado\". VARIABLES A CONFIGURAR ANTES DE EJECUTAR (ambiente TEST): device_id y sensor_<variable> con ids reales de dispositivo/sensores activos y vinculados; access_key = token de servicio de dispositivo (DEV-06) que se pasa como variable de entorno de Newman, nunca se escribe en la coleccion ni en el repositorio; correo_/contrasena_ de los roles que use cada caso. Script sin ejecutar: aun no se ha probado contra el ambiente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://api.inmero.co/back-sigab-test"
    },
    {
      "key": "correo_admin",
      "value": "admin.test@sgpmp.com.co"
    },
    {
      "key": "contrasena_admin",
      "value": "Administrador123#"
    },
    {
      "key": "token_admin",
      "value": ""
    },
    {
      "key": "device_id",
      "value": "1"
    },
    {
      "key": "access_key",
      "value": ""
    },
    {
      "key": "id_evento_edge",
      "value": "1"
    },
    {
      "key": "ids_alertas",
      "value": "[]"
    }
  ],
  "item": [
    {
      "name": "0A. Login admin.test (Administrador)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('ids_alertas', '[]');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login admin.test (Administrador) exitoso (200)', function () { pm.response.to.have.status(200); });",
              "try { pm.collectionVariables.set('token_admin', pm.response.json().token); } catch (e) {}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/sesiones/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"{{correo_admin}}\",\n  \"contrasena\": \"{{contrasena_admin}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "1. Persistencia de la alerta ante fallo de notificacion (TC-M03-156)",
      "item": [
        {
          "name": "1.1 Generar alerta CRITICO",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/iot/alertas",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": {{device_id}},\n  \"sensor_id\": {{sensor_temperatura_ambiental}},\n  \"access_key\": \"{{access_key}}\",\n  \"tipo_variable\": \"TEMPERATURA_AMBIENTAL\",\n  \"valor\": 37.0,\n  \"unidad\": \"°C\",\n  \"timestamp_evento\": \"{{ts_now}}\",\n  \"estado_dato\": \"LECTURA_VALIDA\",\n  \"severidad_edge\": \"CRITICO\",\n  \"origen_evento\": \"EDGE\",\n  \"id_evento_edge_computing\": {{id_evento_edge}},\n  \"reglas_activadas\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const _n = Date.now(); const _iso = (ms) => new Date(ms).toISOString();",
                  "pm.variables.set('ts_now', _iso(_n));",
                  "pm.variables.set('ts_m1s', _iso(_n - 1000));",
                  "pm.variables.set('ts_m10m', _iso(_n - 10*60000));",
                  "pm.variables.set('ts_m20m', _iso(_n - 20*60000));",
                  "pm.variables.set('ts_m31m', _iso(_n - 31*60000));",
                  "pm.variables.set('ts_p1h', _iso(_n + 3600000));",
                  "pm.variables.set('ts_p10m', _iso(_n + 10*60000));",
                  "pm.variables.set('uniq', String(_n).slice(-9));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "console.log('[TC-M03-G84 1.1] status=' + pm.response.code + ' t=' + pm.response.responseTime + 'ms body=' + pm.response.text().slice(0, 600));",
                  "let J; try { J = pm.response.json(); } catch (e) { J = {}; }",
                  "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
                  "if (J && J.id_alerta) { pm.collectionVariables.set('alerta_g84', String(J.id_alerta)); }",
                  "pm.test('Evento aceptado: es_duplicado=false e id_alerta presente', function () { pm.expect(J.es_duplicado).to.eql(false); pm.expect(J.id_alerta).to.exist; });",
                  "pm.test('severidad = CRITICO', function () { pm.expect(J.severidad).to.eql('CRITICO'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 La alerta queda persistida (aunque falle la notificacion)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": "{{base_url}}/iot/alertas/{{alerta_g84}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "console.log('[TC-M03-G84 1.2] status=' + pm.response.code + ' t=' + pm.response.responseTime + 'ms body=' + pm.response.text().slice(0, 600));",
                  "let J; try { J = pm.response.json(); } catch (e) { J = {}; }",
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Alerta persistida en estado ACTIVA', function () { pm.expect(J.estado_alerta).to.eql('ACTIVA'); });",
                  "(function () {",
                  "  const id = (J || {}).id_alerta; if (!id) { return; }",
                  "  const base = pm.variables.replaceIn('{{base_url}}'); const tk = pm.collectionVariables.get('token_admin');",
                  "  if (!tk) { return; }",
                  "  const hdr = {'Content-Type': 'application/json', 'Authorization': 'Bearer ' + tk};",
                  "  const patch = (estado, cb) => pm.sendRequest({url: base + '/iot/alertas/' + id + '/estado', method: 'PATCH', header: hdr, body: {mode: 'raw', raw: JSON.stringify({nuevo_estado: estado, motivo: 'QA limpieza automatica TC-M03'})}}, (e, r) => { if (cb) { cb(e, r); } });",
                  "  patch('DESCARTADA', (e, r) => { if (r && r.code === 200) { return; } patch('EN_ATENCION', () => patch('RESUELTA')); });",
                  "})();"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 Bitacora: entradas NOTIFICACION_FALLIDA (timestamp, id_alerta, actor destinatario y motivo)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/iot/auditoria?tipo_evento=NOTIFICACION_FALLIDA&pagina=1&por_pagina=10",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "iot",
                "auditoria"
              ],
              "query": [
                {
                  "key": "tipo_evento",
                  "value": "NOTIFICACION_FALLIDA"
                },
                {
                  "key": "pagina",
                  "value": "1"
                },
                {
                  "key": "por_pagina",
                  "value": "10"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "console.log('[TC-M03-G84 1.3] status=' + pm.response.code + ' t=' + pm.response.responseTime + 'ms body=' + pm.response.text().slice(0, 600));",
                  "let J; try { J = pm.response.json(); } catch (e) { J = {}; }",
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const _it = J.items || J.eventos || J.data || [];",
                  "pm.test('Consulta valida; cada intento fallido trae tipo_evento y fecha', function () { _it.forEach(function (e) { pm.expect(e.tipo_evento).to.eql('NOTIFICACION_FALLIDA'); }); });",
                  "console.log('[G84-1.3][OBSERVADO] NOTIFICACION_FALLIDA = ' + JSON.stringify(_it.slice(0, 3)));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Reintentos con backoff y escalamiento (TC-M03-156)",
      "item": [
        {
          "name": "2.1 Canal no disponible en el primer intento: reintento automatico",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/iot/alertas?pagina=1&por_pagina=1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "iot",
                "alertas"
              ],
              "query": [
                {
                  "key": "pagina",
                  "value": "1"
                },
                {
                  "key": "por_pagina",
                  "value": "1"
                }
              ]
            },
            "description": "Marcador de subcaso no automatizable con Postman/Newman. Motivo: requiere simular el canal de notificacion no disponible (cola/servicio de notificaciones o inyeccion de fallos)"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let J; try { J = pm.response.json(); } catch (e) { J = {}; }",
                  "pm.test.skip(\"NO AUTOMATIZABLE POR API - requiere simular el canal de notificacion no disponible (cola/servicio de notificaciones o inyeccion de fallos)\");"
                ]
              }
            }
          ]
        },
        {
          "name": "2.2 Reintentos agotados: notificacion encolada y escalamiento al siguiente actor (validar solo si CU-03 FA-07 sigue vigente)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/iot/alertas?pagina=1&por_pagina=1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "iot",
                "alertas"
              ],
              "query": [
                {
                  "key": "pagina",
                  "value": "1"
                },
                {
                  "key": "por_pagina",
                  "value": "1"
                }
              ]
            },
            "description": "Marcador de subcaso no automatizable con Postman/Newman. Motivo: requiere acceso a la cola de notificaciones"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let J; try { J = pm.response.json(); } catch (e) { J = {}; }",
                  "pm.test.skip(\"NO AUTOMATIZABLE POR API - requiere acceso a la cola de notificaciones\");"
                ]
              }
            }
          ]
        },
        {
          "name": "2.3 Usuario destinatario sin sesion activa",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/iot/alertas?pagina=1&por_pagina=1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "iot",
                "alertas"
              ],
              "query": [
                {
                  "key": "pagina",
                  "value": "1"
                },
                {
                  "key": "por_pagina",
                  "value": "1"
                }
              ]
            },
            "description": "Marcador de subcaso no automatizable con Postman/Newman. Motivo: requiere controlar la sesion del destinatario y observar el canal"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let J; try { J = pm.response.json(); } catch (e) { J = {}; }",
                  "pm.test.skip(\"NO AUTOMATIZABLE POR API - requiere controlar la sesion del destinatario y observar el canal\");"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Z. Limpieza - cerrar alertas de prueba creadas",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "  let ids = []; try { ids = JSON.parse(pm.collectionVariables.get('ids_alertas') || '[]'); } catch (e) {}",
              "  const base = pm.variables.replaceIn('{{base_url}}'); const tk = pm.collectionVariables.get('token_admin');",
              "  const hdr = {'Content-Type': 'application/json', 'Authorization': 'Bearer ' + tk};",
              "  const patch = (id, estado, cb) => pm.sendRequest({url: base + '/iot/alertas/' + id + '/estado', method: 'PATCH', header: hdr, body: {mode: 'raw', raw: JSON.stringify({nuevo_estado: estado, motivo: 'QA limpieza final TC-M03'})}}, (e, r) => { if (cb) { cb(e, r); } });",
              "  ids.forEach(function (id) { patch(id, 'DESCARTADA', function (e, r) { if (r && r.code === 200) { return; } patch(id, 'RESUELTA', function (e2, r2) { if (r2 && r2.code === 200) { return; } patch(id, 'EN_ATENCION', function () { patch(id, 'RESUELTA'); }); }); }); });",
              "  console.log('[TC-M03-G84] limpieza final: ' + ids.length + ' alerta(s) de prueba cerradas (DESCARTADA/RESUELTA)');",
              "  pm.collectionVariables.set('ids_alertas', '[]');",
              "})();",
              "pm.test('Limpieza final ejecutada', function () { pm.expect(true).to.be.true; });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_admin}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/iot/alertas?pagina=1&por_pagina=1",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "iot",
            "alertas"
          ],
          "query": [
            {
              "key": "pagina",
              "value": "1"
            },
            {
              "key": "por_pagina",
              "value": "1"
            }
          ]
        }
      }
    }
  ]
}