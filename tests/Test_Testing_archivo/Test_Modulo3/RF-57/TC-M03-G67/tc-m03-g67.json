    {
      "name": "1. Credenciales invalidas y dispositivo/sensor no autorizado (TC-M03-131)",
      "item": [
        {
          "name": "1.1 access_key ausente - rechazo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/iot/alertas",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": {{device_id}},\n  \"sensor_id\": {{sensor_temperatura_ambiental}},\n  \"tipo_variable\": \"TEMPERATURA_AMBIENTAL\",\n  \"valor\": 31.0,\n  \"unidad\": \"°C\",\n  \"timestamp_evento\": \"{{ts_now}}\",\n  \"estado_dato\": \"LECTURA_VALIDA\",\n  \"severidad_edge\": \"LEVE\",\n  \"origen_evento\": \"EDGE\",\n  \"id_evento_edge_computing\": {{id_evento_edge}},\n  \"reglas_activadas\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const _n = Date.now(); const _iso = (ms) => new Date(ms).toISOString();",
                  "pm.variables.set('ts_now', _iso(_n));",
                  "pm.variables.set('ts_m1s', _iso(_n - 1000));",
                  "pm.variables.set('ts_m10m', _iso(_n - 10*60000));",
                  "pm.variables.set('ts_m20m', _iso(_n - 20*60000));",
                  "pm.variables.set('ts_m31m', _iso(_n - 31*60000));",
                  "pm.variables.set('ts_p1h', _iso(_n + 3600000));",
                  "pm.variables.set('ts_p10m', _iso(_n + 10*60000));",
                  "pm.variables.set('uniq', String(_n).slice(-9));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "console.log('[TC-M03-G67 1.1] status=' + pm.response.code + ' t=' + pm.response.responseTime + 'ms body=' + pm.response.text().slice(0, 600));",
                  "let J; try { J = pm.response.json(); } catch (e) { J = {}; }",
                  "pm.test('HTTP en 401/403/422', function () { pm.expect([401, 403, 422]).to.include(pm.response.code); });",
                  "pm.test('No se crea alerta', function () { pm.expect(J.id_alerta).to.not.exist; });",
                  "pm.test('Respuesta de error con formato estándar (error_code / message)', function () { pm.expect(J).to.have.property('error_code'); pm.expect(J).to.have.property('message'); });",
                  "(function () {",
                  "  const id = (J || {}).id_alerta; if (!id) { return; }",
                  "  const base = pm.variables.replaceIn('{{base_url}}'); const tk = pm.collectionVariables.get('token_admin');",
                  "  if (!tk) { return; }",
                  "  const hdr = {'Content-Type': 'application/json', 'Authorization': 'Bearer ' + tk};",
                  "  const patch = (estado, cb) => pm.sendRequest({url: base + '/iot/alertas/' + id + '/estado', method: 'PATCH', header: hdr, body: {mode: 'raw', raw: JSON.stringify({nuevo_estado: estado, motivo: 'QA limpieza automatica TC-M03'})}}, (e, r) => { if (cb) { cb(e, r); } });",
                  "  patch('DESCARTADA', (e, r) => { if (r && r.code === 200) { return; } patch('EN_ATENCION', () => patch('RESUELTA')); });",
                  "})();"
                ]
              }
            }
          ]
        },
