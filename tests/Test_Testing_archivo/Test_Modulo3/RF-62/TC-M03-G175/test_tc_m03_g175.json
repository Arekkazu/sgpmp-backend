        {
          "name": "03-Descubrir-Sensores-Distintos",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/test-control/query",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "test-control",
                "query"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"SELECT s.id_sensores, s.id_dispositivo_iot, d.serial FROM modulo9.sensores s JOIN modulo9.dispositivos_iot d ON s.id_dispositivo_iot = d.id_dispositivo_iot WHERE s.es_activo = true AND d.es_activo = true ORDER BY s.id_sensores DESC LIMIT 2\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"[VERIFICACION SQL SOLO LECTURA] Status 200 - Sensores descubiertos\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const rows = pm.response.json().data || pm.response.json().rows || [];",
                  "    pm.expect(rows.length).to.be.above(0);",
                  "    const sB = rows[0];",
                  "    pm.collectionVariables.set(\"sensor_id_finca_b\", sB.id_sensores);",
                  "    pm.collectionVariables.set(\"device_id_finca_b\", sB.id_dispositivo_iot);",
                  "    pm.collectionVariables.set(\"device_serial_finca_b\", sB.serial);",
                  "});"
                ]
              }
            }
          ]
        },
