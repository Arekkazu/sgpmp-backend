                  "        pm.expect(pm.response.code, \"BOLA: Ingeniero no debe ver eventos financieros NIC41\").to.be.oneOf([403, 404]);",
                  "    });",
                  "} else {",
                  "    pm.test(\"Status 403/404 - INGENIERO_CAMPO rechazado en evento NIC41\", function () {",
