{
  "info": {
    "name": "TC-M03-G187: OWASP API8 - Security Misconfiguration & Error Handling",
    "_postman_id": "77777777-1111-4444-8888-000000000187",
    "description": "Pruebas de seguridad OWASP API8: Fuzzing exhaustivo y validación de ausencia de información técnica en errores sobre endpoints de auditoría RF-63.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
