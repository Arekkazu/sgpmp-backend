    {
      "name": "02_TC_355_Fuzzing_Entradas",
      "item": [
        {
          "name": "Fuzz 01: UUID Malformado en Path",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/iot/auditoria/not-a-valid-uuid-12345",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "iot",
                "auditoria",
                "not-a-valid-uuid-12345"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('02.01 UUID malformado debe retornar 422', function() {",
                  "    if (pm.response.code === 200) {",
                  "        pm.expect.fail('[DISCREPANCIA] UUID malformado respondió 200 OK');",
                  "    }",
                  "    pm.expect(pm.response.code).to.equal(422);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Fuzz 02: fecha_desde Malformada en Query",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/iot/auditoria?fecha_desde=not-a-date-format",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "iot",
                "auditoria"
              ],
              "query": [
                {
                  "key": "fecha_desde",
                  "value": "not-a-date-format"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('02.02 fecha_desde malformada debe retornar 422', function() {",
                  "    if (pm.response.code === 200) {",
                  "        pm.expect.fail('[DISCREPANCIA] fecha_desde malformada respondió 200 OK');",
                  "    }",
                  "    pm.expect(pm.response.code).to.equal(422);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Fuzz 03: XSS Payload en severidad_log",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/iot/auditoria?severidad_log=%3Cscript%3Ealert(1)%3C%2Fscript%3E",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "iot",
                "auditoria"
              ],
              "query": [
                {
                  "key": "severidad_log",
                  "value": "<script>alert(1)</script>"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('02.03 XSS payload en severidad_log debe retornar 422 o 400', function() {",
                  "    if (pm.response.code === 200) {",
                  "        pm.expect.fail('[DISCREPANCIA] Payload XSS en severidad_log respondió 200 OK');",
                  "    }",
                  "    pm.expect([400, 422]).to.include(pm.response.code);",
                  "    pm.expect(pm.response.text()).to.not.include('<script>alert(1)</script>');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Fuzz 04: SQL Injection Payload en tipo_evento",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/iot/auditoria?tipo_evento=' UNION SELECT null, null, null; DROP TABLE test; --",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "iot",
                "auditoria"
              ],
              "query": [
                {
                  "key": "tipo_evento",
                  "value": "' UNION SELECT null, null, null; DROP TABLE test; --"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('02.04 SQL Injection en tipo_evento debe retornar 400/422 o lista vacia sanitizada', function() {",
                  "    if (pm.response.code === 200) {",
                  "        const res = pm.response.json();",
                  "        const items = res.items || res;",
                  "        pm.expect(Array.isArray(items)).to.be.true;",
                  "        pm.expect(items.length).to.equal(0);",
                  "    } else {",
                  "        pm.expect([400, 422]).to.include(pm.response.code);",
                  "    }",
                  "    pm.expect(pm.response.text().toLowerCase()).to.not.include('syntax error');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Fuzz 05: Paginacion fuera de rango (pagina=-1, por_pagina=999999)",
