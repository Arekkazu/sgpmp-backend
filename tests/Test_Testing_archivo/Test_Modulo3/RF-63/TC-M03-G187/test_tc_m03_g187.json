              "path": [
                "iot",
                "auditoria"
              ],
              "query": [
                {
                  "key": "pagina",
                  "value": "-1"
                },
                {
                  "key": "por_pagina",
                  "value": "999999"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('02.05 Paginacion invalida debe retornar 422', function() {",
                  "    if (pm.response.code === 200) {",
                  "        pm.expect.fail('[DISCREPANCIA] Paginacion invalida (-1/999999) respondio 200 OK');",
                  "    }",
                  "    pm.expect(pm.response.code).to.equal(422);",
                  "});"
                ]
              }
            }
          ]
        },
        {
