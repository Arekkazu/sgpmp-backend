                  "pm.test('02.06 Body con tipos incorrectos debe retornar 422', function() {",
                  "    if (pm.response.code === 200) {",
                  "        pm.expect.fail('[DISCREPANCIA] Payload con tipos corruptos retorno 200 OK');",
                  "    }",
                  "    pm.expect(pm.response.code).to.equal(422);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Fuzz 07: Caracteres Unicode extremos (Null, Emojis, RTL)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/iot/auditoria?tipo_evento=%F0%9F%94%A5%F0%9F%92%80%E2%80%AEreversed",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "iot",
                "auditoria"
              ],
              "query": [
                {
                  "key": "tipo_evento",
                  "value": "🔥💀‮reversed"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('02.07 Caracteres unicode extremos deben ser manejados sin 500 (400, 422 o 200 vacio)', function() {",
                  "    pm.expect([200, 400, 422]).to.include(pm.response.code);",
                  "    pm.expect(pm.response.code).to.not.equal(500);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Fuzz 08: Buffer Overflow Simulator (UUID de 10,000 chars)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "iot",
                "auditoria",
                ""
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('02.08 Path de 10,000 caracteres debe retornar 422 o 414 en <2000 ms', function() {",
                  "    pm.expect([414, 422, 404]).to.include(pm.response.code);",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03_TC_356_Headers_Seguridad_y_Leaks",
      "item": [
        {
          "name": "Verificacion de Cabeceras y Ausencia de Internals en Respuestas Error",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/iot/auditoria/99999999-9999-9999-9999-999999999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "iot",
                "auditoria",
                "99999999-9999-9999-9999-999999999999"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('03.01 Respuesta 404 estructurada en JSON', function() {",
                  "    pm.expect(pm.response.code).to.equal(404);",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "",
                  "pm.test('03.02 Ausencia de cabeceras reveladoras de servidor/framework', function() {",
                  "    const headers = pm.response.headers;",
                  "    pm.expect(headers.has('X-Powered-By')).to.be.false;",
                  "    pm.expect(headers.has('X-AspNet-Version')).to.be.false;",
                  "    pm.expect(headers.has('X-Debug-Token')).to.be.false;",
                  "    const serverHeader = headers.get('Server');",
                  "    if (serverHeader) {",
                  "        console.log('[INFO] Cabecera Server presente:', serverHeader);",
                  "    }",
                  "});",
                  "",
                  "pm.test('03.03 Ausencia de stack trace, paths .py, sqlalchemy o queries SQL en body', function() {",
                  "    const body = pm.response.text();",
                  "    pm.expect(body).to.not.include('Traceback (most recent call last)');",
                  "    pm.expect(body).to.not.include('File \"');",
                  "    pm.expect(body).to.not.include('.py\", line');",
                  "    pm.expect(body).to.not.include('psycopg2');",
                  "    pm.expect(body).to.not.include('sqlalchemy');",
                  "    pm.expect(body).to.not.match(/SELECT .+ FROM/i);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-356 Escenarios de Forzado 500 [BLOQUEADO]",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
