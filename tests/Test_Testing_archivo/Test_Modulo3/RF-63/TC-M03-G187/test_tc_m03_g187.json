                  "console.log('[BLOQUEADO] TC-356 Forzar HTTP 500 cortando DB requiere acceso a la infraestructura del servidor/PostgreSQL. Imposible desde API externa HTTPS.');",
                  "console.log('[COBERTURA PARCIAL] Evaluado mediante inspeccion de respuestas 4xx, cabeceras seguras y ausencia de stack traces en error handlers estandar.');"
                ]
