    {
      "name": "01_Autenticacion",
      "item": [
        {
          "name": "Login Administrador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"correo_electronico\":\"administador.dev@gmail.com\",\"contrasena\":\"{{adminPassword}}\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/sesiones/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sesiones",
                ""
              ]
