    {
      "name": "02-Setup-Generacion-Eventos",
      "item": [
        {
          "name": "05-Generar-Batch-Telemetria",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/iot/telemetria/batch",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "iot",
                "telemetria",
                "batch"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"origen\": \"BUFFER_LOCAL\",\n  \"lecturas\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const sensorId = parseInt(pm.collectionVariables.get(\"sensor_id\"), 10);",
                  "const lecturas = [];",
                  "const baseEpoch = 1792137600; // 2026-10-16T08:00:00Z",
                  "for (let i = 0; i < 20; i++) {",
                  "    const dt = new Date((baseEpoch + (i * 600)) * 1000).toISOString();",
                  "    lecturas.push({",
                  "        id_sensor: sensorId,",
                  "        valor: 24.5 + (i * 0.1),",
                  "        timestamp_captura: dt",
                  "    });",
                  "}",
                  "pm.request.body.raw = JSON.stringify({ origen: \"BUFFER_LOCAL\", lecturas: lecturas });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200/201 - Ingesta batch completada\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
