      "name": "00-Setup-Baseline-Token-y-Setup",
      "item": [
        {
          "name": "00-Login-Admin-Baseline",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sesiones/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sesiones",
                ""
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo_electronico\": \"administador.dev@gmail.com\",\n  \"contrasena\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 - Login exitoso para generar token base\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.token).to.be.a(\"string\").and.not.be.empty;",
                  "    pm.collectionVariables.set(\"token_admin\", res.token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "01-Setup-Obtener-ID-Evento-Base",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/iot/auditoria?por_pagina=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "iot",
                "auditoria"
              ],
              "query": [
                {
                  "key": "por_pagina",
                  "value": "1"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.items && res.items.length > 0) {",
                  "    pm.collectionVariables.set(\"test_id_evento\", res.items[0].id_evento);",
                  "} else {",
                  "    pm.collectionVariables.set(\"test_id_evento\", \"00000000-0000-0000-0000-000000000001\");",
                  "}"
                ]
              }
            }
          ]
        }
      ]
