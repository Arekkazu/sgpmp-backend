                  "const baseToken = pm.collectionVariables.get(\"token_admin\");",
                  "if (baseToken && baseToken.includes(\".\")) {",
                  "    const parts = baseToken.split(\".\");",
                  "    try {",
                  "        let payload = JSON.parse(CryptoJS.enc.Utf8.stringify(CryptoJS.enc.Base64.parse(parts[1])));",
                  "        payload.sub = \"999999\";",
