                  "    pm.expect(b.message).to.equal(\"El token es inválido o ha expirado.\");",
                  "    const msgA = pm.collectionVariables.get(\"msg_351a\");",
                  "    if (msgA) {",
                  "        pm.expect(b.message).to.equal(msgA);",
                  "    }",
