  "item": [
    {
      "name": "00-Setup-Autenticacion",
      "item": [
        {
          "name": "00-Login-ADMIN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sesiones/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sesiones",
                ""
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo_electronico\": \"administador.dev@gmail.com\",\n  \"contrasena\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 - Login exitoso de ADMIN\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.token).to.be.a(\"string\").that.is.not.empty;",
                  "    pm.collectionVariables.set(\"token_admin\", res.token);",
                  "});"
                ]
              }
            }
          ]
        }
