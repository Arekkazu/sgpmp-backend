    {
      "name": "2. TC-M04-013 Bloqueo por modelos en PRODUCCIÓN/VALIDACIÓN (precondición)",
      "description": "",
      "item": [
        {
          "name": "TC-M04-013 - Precondición: patología en uso por un modelo en PRODUCCIÓN/VALIDACIÓN",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Modelos responde 200', function () { pm.response.to.have.status(200); });",
                  "const items = pm.response.json().items || [];",
                  "const estados = ['PRODUCCION', 'PRODUCCIÓN', 'VALIDACION', 'VALIDACIÓN', 'ACTIVO'];",
                  "const campos = ['patologias', 'patologias_cubiertas', 'id_patologias', 'ids_patologias'];",
                  "const estadosReales = [...new Set(items.map(m => m.estado_version))];",
                  "console.log('TC-M04-013 estados de modelo existentes:', JSON.stringify(estadosReales));",
                  "pm.test('TC-M04-013: existe un modelo en ' + estados.join('/') + ' vinculado a una patología', function () {",
                  "  const candidato = items.find(m => estados.includes(m.estado_version) && campos.some(c => (m[c] || []).length));",
                  "  pm.expect(candidato, 'Precondición no alcanzable: no hay modelos en ' + estados.join('/') +",
                  "    ' (estados reales: ' + estadosReales.join(', ') + ') o los modelos no declaran sus patologías').to.exist;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_vet}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/prediccion/modelos?limit=200",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "prediccion",
                "modelos"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "200"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
