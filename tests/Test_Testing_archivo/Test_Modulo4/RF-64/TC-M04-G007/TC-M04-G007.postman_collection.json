    {
      "name": "4. TC-M04-015 Auditoría de las operaciones",
      "item": [
        {
          "name": "TC-M04-015 - Operaciones del Veterinario auditadas (RF-73)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Auditoría responde 200', function () { pm.response.to.have.status(200); });",
                  "const items = pm.response.json().items || [];",
                  "console.log('TC-M04-015 auditoría:', JSON.stringify(items.map(e => [e.tipo_evento, e.id_usuario, e.fecha_evento])));",
                  "const vet = Number(pm.collectionVariables.get('id_usuario_vet'));",
                  "const version = (e) => { const p = e.payload_evento || {}; return (p.nuevo || p).version_catalogo; };",
                  "[[\"CATALOGO_PATOLOGIA_AGREGADA\", \"crear\", 1], [\"CATALOGO_PATOLOGIA_MODIFICADA\", \"editar\", 2], [\"CATALOGO_PATOLOGIA_INACTIVADA\", \"inactivar\", 2]].forEach(([tipo, operacion, versionEsperada]) => {",
                  "  const e = items.find(x => x.tipo_evento === tipo);",
                  "  pm.test('TC-M04-015: ' + operacion + ' auditada (' + tipo + ')', function () { pm.expect(e, tipo).to.exist; });",
                  "  if (e) {",
                  "    pm.test('TC-M04-015: ' + operacion + ' registra usuario, timestamp y operación', function () {",
                  "      pm.expect(e.id_usuario).to.eql(vet); pm.expect(e.fecha_evento).to.be.ok; pm.expect(e.tipo_evento).to.eql(tipo);",
                  "    });",
                  "    pm.test('TC-M04-015: ' + operacion + ' registra la version_catalogo resultante (' + versionEsperada + ')', function () {",
                  "      pm.expect(version(e)).to.eql(versionEsperada);",
                  "    });",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/prediccion/auditoria?id_referencia={{id_vet}}&fecha_desde={{inicio}}&por_pagina=50",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "prediccion",
                "auditoria"
              ],
              "query": [
                {
                  "key": "id_referencia",
                  "value": "{{id_vet}}"
                },
                {
                  "key": "fecha_desde",
                  "value": "{{inicio}}"
                },
                {
                  "key": "por_pagina",
                  "value": "50"
                }
              ]
            }
          },
          "response": []
        }
      ]
    }
