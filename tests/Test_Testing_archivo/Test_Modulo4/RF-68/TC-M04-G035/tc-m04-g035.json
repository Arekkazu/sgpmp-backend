  "item": [
    {
      "name": "0A. Login admin.test (Administrador)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login admin.test (Administrador) exitoso (200)', function () { pm.response.to.have.status(200); });",
              "try { pm.collectionVariables.set('token_admin', pm.response.json().token); } catch (e) {}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/sesiones/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"{{correo_admin}}\",\n  \"contrasena\": \"{{contrasena_admin}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "0S. Snapshot de la configuracion vigente del motor (se restaura al final)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Snapshot de configuracion del motor leido (200)', function () { pm.response.to.have.status(200); });",
              "try { const J = pm.response.json(); const keep = (J.items || []).map(function (c) { return {tipo_modelo: c.tipo_modelo, umbral_riesgo_alto: c.umbral_riesgo_alto, umbral_alerta_critica: c.umbral_alerta_critica, umbral_score_anomalia: c.umbral_score_anomalia, versiones_activas_por_componente: c.versiones_activas_por_componente, ventana_temporal_min: c.ventana_temporal_min, modo_ejecucion: c.modo_ejecucion, w_factor_sanitario: c.w_factor_sanitario, w_factor_ambiental: c.w_factor_ambiental, w_factor_densidad: c.w_factor_densidad, id_version_modelo_activa: c.id_version_modelo_activa, temp_min_config: c.temp_min_config, temp_max_config: c.temp_max_config, hr_min_config: c.hr_min_config, hr_max_config: c.hr_max_config, densidad_maxima_config: c.densidad_maxima_config}; }); pm.collectionVariables.set('cfg_snapshot', JSON.stringify(keep)); } catch (e) {}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_admin}}"
          }
        ],
        "url": "{{base_url}}/prediccion/motor-ia"
      }
    },
    {
      "name": "0. Preparacion",
      "item": [
        {
          "name": "0C. Configurar pesos por defecto W_fs=0.5, W_fa=0.3, W_fd=0.2 (RF-65)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": "{{base_url}}/prediccion/motor-ia",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo_modelo\": \"MODELO_RIESGO_CONTAGIO\",\n  \"ventana_temporal_min\": 10,\n  \"modo_ejecucion\": \"SERVIDOR\",\n  \"umbral_riesgo_alto\": 0.5,\n  \"umbral_alerta_critica\": 0.75,\n  \"w_factor_sanitario\": 0.5,\n  \"w_factor_ambiental\": 0.3,\n  \"w_factor_densidad\": 0.2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const _n = Date.now(); const _iso = (ms) => new Date(ms).toISOString();",
                  "pm.variables.set('ts_now', _iso(_n));",
                  "pm.variables.set('ts_m1s', _iso(_n - 1000));",
                  "pm.variables.set('ts_m10m', _iso(_n - 10*60000));",
                  "pm.variables.set('ts_m20m', _iso(_n - 20*60000));",
                  "pm.variables.set('ts_m31m', _iso(_n - 31*60000));",
                  "pm.variables.set('ts_p1h', _iso(_n + 3600000));",
                  "pm.variables.set('ts_p10m', _iso(_n + 10*60000));",
                  "pm.variables.set('uniq', String(_n).slice(-9));",
                  "const _d = (n) => new Date(Date.now() - n*864e5).toISOString().slice(0,10);",
                  "pm.variables.set('hoy', _d(0)); pm.variables.set('ayer', _d(1)); pm.variables.set('manana', _d(-1));",
                  "pm.variables.set('hoy_m30', _d(30)); pm.variables.set('hoy_m89', _d(89)); pm.variables.set('hoy_m90', _d(90)); pm.variables.set('hoy_m91', _d(91)); pm.variables.set('hoy_m60', _d(60));",
                  "if (!pm.collectionVariables.get('periodo_ini')) pm.variables.set('periodo_ini', _d(30)); else pm.variables.set('periodo_ini', pm.collectionVariables.get('periodo_ini'));",
                  "if (!pm.collectionVariables.get('periodo_fin')) pm.variables.set('periodo_fin', _d(0)); else pm.variables.set('periodo_fin', pm.collectionVariables.get('periodo_fin'));",
                  "const _t = JSON.parse(pm.collectionVariables.get('cfg_tocados') || '[]'); if (_t.indexOf('MODELO_RIESGO_CONTAGIO') < 0) { _t.push('MODELO_RIESGO_CONTAGIO'); pm.collectionVariables.set('cfg_tocados', JSON.stringify(_t)); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "console.log('[TC-M04-G035 0C.] status=' + pm.response.code + ' t=' + pm.response.responseTime + 'ms body=' + pm.response.text().slice(0, 600));",
                  "let J; try { J = pm.response.json(); } catch (e) { J = {}; }",
                  "pm.test('HTTP en 200/201', function () { pm.expect([200, 201]).to.include(pm.response.code); });",
                  "const R = (J && J.resultado) ? J.resultado : (J || {});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. TC-M04-23 - Rendimiento",
      "item": [
        {
          "name": "1.1 Lote de 1000 aves (1000 activos)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": "{{base_url}}{{ruta_contagio}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_lote\": {{id_lote}},\n  \"timestamp_calculo\": \"{{ts_now}}\",\n  \"n_enfermos_detectados\": 120,\n  \"total_activos_lote\": 1000,\n  \"qa_factores_simulados\": {\n    \"fs\": 0.3,\n    \"fa\": 0.5,\n    \"fd\": 0.6\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const _n = Date.now(); const _iso = (ms) => new Date(ms).toISOString();",
                  "pm.variables.set('ts_now', _iso(_n));",
                  "pm.variables.set('ts_m1s', _iso(_n - 1000));",
                  "pm.variables.set('ts_m10m', _iso(_n - 10*60000));",
                  "pm.variables.set('ts_m20m', _iso(_n - 20*60000));",
                  "pm.variables.set('ts_m31m', _iso(_n - 31*60000));",
                  "pm.variables.set('ts_p1h', _iso(_n + 3600000));",
                  "pm.variables.set('ts_p10m', _iso(_n + 10*60000));",
                  "pm.variables.set('uniq', String(_n).slice(-9));",
                  "const _d = (n) => new Date(Date.now() - n*864e5).toISOString().slice(0,10);",
                  "pm.variables.set('hoy', _d(0)); pm.variables.set('ayer', _d(1)); pm.variables.set('manana', _d(-1));",
                  "pm.variables.set('hoy_m30', _d(30)); pm.variables.set('hoy_m89', _d(89)); pm.variables.set('hoy_m90', _d(90)); pm.variables.set('hoy_m91', _d(91)); pm.variables.set('hoy_m60', _d(60));",
                  "if (!pm.collectionVariables.get('periodo_ini')) pm.variables.set('periodo_ini', _d(30)); else pm.variables.set('periodo_ini', pm.collectionVariables.get('periodo_ini'));",
                  "if (!pm.collectionVariables.get('periodo_fin')) pm.variables.set('periodo_fin', _d(0)); else pm.variables.set('periodo_fin', pm.collectionVariables.get('periodo_fin'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "console.log('[TC-M04-G035 1.1] status=' + pm.response.code + ' t=' + pm.response.responseTime + 'ms body=' + pm.response.text().slice(0, 600));",
                  "let J; try { J = pm.response.json(); } catch (e) { J = {}; }",
                  "pm.test('HTTP en 200/201', function () { pm.expect([200, 201]).to.include(pm.response.code); });",
                  "const R = (J && J.resultado) ? J.resultado : (J || {});",
                  "pm.test('Calculo del lote de 1000 aves <= 3000 ms', function () { pm.expect(pm.response.responseTime).to.be.at.most(3000); });",
                  "pm.collectionVariables.set('t_base', String(pm.response.responseTime));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Lanzar 5 lotes concurrentes de 50-500 activos",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": "{{base_url}}/prediccion/motor-ia"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () { const _w = Date.now(); while (Date.now() - _w < 6000) {} })();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "console.log('[TC-M04-G035 1.2] status=' + pm.response.code + ' t=' + pm.response.responseTime + 'ms body=' + pm.response.text().slice(0, 600));",
                  "let J; try { J = pm.response.json(); } catch (e) { J = {}; }",
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "(function () {",
                  "  const base = pm.variables.replaceIn('{{base_url}}'); const tk = pm.collectionVariables.get('token_admin'); const ruta = pm.collectionVariables.get('ruta_contagio');",
                  "  const hdr = {'Content-Type': 'application/json', 'Authorization': 'Bearer ' + tk}; const ids = JSON.parse(pm.collectionVariables.get('ids_lotes_concurrentes')); const tam = [50, 120, 250, 400, 500];",
                  "  pm.collectionVariables.set('burst', '[]');",
                  "  ids.forEach(function (id, i) { const body = {id_lote: id, timestamp_calculo: new Date().toISOString(), total_activos_lote: tam[i], n_enfermos_detectados: Math.floor(tam[i] * 0.1), qa_factores_simulados: {fs: 0.3, fa: 0.5, fd: 0.6}};",
                  "    pm.sendRequest({url: base + ruta, method: 'POST', header: hdr, body: {mode: 'raw', raw: JSON.stringify(body)}}, function (e, r) { const b = JSON.parse(pm.collectionVariables.get('burst') || '[]'); b.push({id: id, code: r ? r.code : 0, t: r ? r.responseTime : null}); pm.collectionVariables.set('burst', JSON.stringify(b)); }); });",
                  "})();",
                  "pm.test('5 lotes lanzados concurrentemente', function () { pm.expect(true).to.be.true; });"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 Evaluar concurrencia: sin degradacion significativa",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": "{{base_url}}/prediccion/motor-ia"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () { const _w = Date.now(); while (Date.now() - _w < 6000) {} })();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "console.log('[TC-M04-G035 1.3] status=' + pm.response.code + ' t=' + pm.response.responseTime + 'ms body=' + pm.response.text().slice(0, 600));",
                  "let J; try { J = pm.response.json(); } catch (e) { J = {}; }",
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const b = JSON.parse(pm.collectionVariables.get('burst') || '[]'); const base = parseFloat(pm.collectionVariables.get('t_base') || '3000');",
                  "console.log('[TC-M04-G035] lotes concurrentes=' + JSON.stringify(b));",
                  "pm.test('Los 5 lotes respondieron correctamente', function () { pm.expect(b.length).to.eql(5); b.forEach(function (x) { pm.expect(x.code).to.be.within(200, 299); }); });",
                  "pm.test('Cada lote concurrente responde en <= 3000 ms', function () { b.forEach(function (x) { pm.expect(x.t).to.be.at.most(3000); }); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. TC-M04-24 - Correlacion con eventos sanitarios reales",
      "item": [
        {
          "name": "2.1 Correlacion >= 0.75 entre estimaciones retrospectivas y brotes confirmados",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": "{{base_url}}/prediccion/motor-ia",
            "description": "Marcador de subcaso no automatizable con Postman/Newman. Motivo: es un analisis estadistico offline (pandas/scipy): ejecutar python tc-m04-g035_correlacion.py --estimaciones <csv> --eventos <csv> (falla si r < 0.75)"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let J; try { J = pm.response.json(); } catch (e) { J = {}; }",
                  "pm.test.skip(\"NO AUTOMATIZABLE CON POSTMAN - es un analisis estadistico offline (pandas/scipy): ejecutar python tc-m04-g035_correlacion.py --estimaciones <csv> --eventos <csv> (falla si r < 0.75)\");"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Z. Restaurar configuracion del motor (valores previos al caso)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "  let snap = []; try { snap = JSON.parse(pm.collectionVariables.get('cfg_snapshot') || '[]'); } catch (e) {}",
              "  const base = pm.variables.replaceIn('{{base_url}}'); const tk = pm.collectionVariables.get('token_admin');",
              "  const hdr = {'Content-Type': 'application/json', 'Authorization': 'Bearer ' + tk};",
              "  const tocar = JSON.parse(pm.collectionVariables.get('cfg_tocados') || '[]');",
              "  snap.filter(function (c) { return tocar.indexOf(c.tipo_modelo) >= 0; }).forEach(function (c) {",
              "    Object.keys(c).forEach(function (k) { if (c[k] === null || c[k] === undefined) { delete c[k]; } });",
              "    pm.sendRequest({url: base + '/prediccion/motor-ia', method: 'POST', header: hdr, body: {mode: 'raw', raw: JSON.stringify(c)}}, function (e, r) { console.log('[TC-M04-G035] restaurar config ' + c.tipo_modelo + ' -> ' + (r ? r.code : 'sin respuesta')); });",
              "  });",
              "  console.log('[TC-M04-G035] configuracion restaurada para: ' + tocar.join(', '));",
              "  pm.collectionVariables.set('cfg_tocados', '[]');",
              "})();",
              "pm.test('Restauracion de configuracion ejecutada', function () { pm.expect(true).to.be.true; });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_admin}}"
          }
        ],
        "url": "{{base_url}}/prediccion/motor-ia"
      }
    }
  ]
