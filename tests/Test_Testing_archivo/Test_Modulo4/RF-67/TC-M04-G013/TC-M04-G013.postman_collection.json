        {
          "name": "TC-M04-024 - El intento denegado queda auditado (RF-73)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Auditoría responde 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('TC-M04-024: el acceso denegado al historial quedó auditado', function () {",
                  "  pm.expect((pm.response.json().items || []).some(e => /HISTORIAL/i.test(e.tipo_evento) && e.resultado_operacion !== 'EXITOSO')).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
