                "exec": [
                  "const l = 'abcdefghijklmnopqrstuvwxyz'; let s = ''; for (let i = 0; i < 8; i++) s += l.charAt(Math.floor(Math.random() * 26));",
                  "pm.collectionVariables.set('sufijo', s);",
                  "const d = (n) => new Date(Date.now() + n * 86400000).toISOString().slice(0, 10);",
                  "pm.collectionVariables.set('hoy', d(0)); pm.collectionVariables.set('desde', d(-30));",
                  "pm.collectionVariables.set('ayer', d(-1)); pm.collectionVariables.set('manana', d(1)); pm.collectionVariables.set('futuro', d(30));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login (200)', function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set('token_admin', pm.response.json().token);"
