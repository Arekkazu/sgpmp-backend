    {
      "name": "2. TC-M04-024 Segregación por granja",
      "item": [
        {
          "name": "TC-M04-024 - Productor de la granja A consulta el activo de la granja B",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('TC-M04-024 (granja ajena): acceso denegado (403/404)', function () { pm.expect(pm.response.code).to.be.oneOf([403, 404]); });",
                  "pm.test('TC-M04-024 (granja ajena): no expone datos clínicos', function () { pm.expect(pm.response.text()).to.not.include('eventos'); pm.expect(pm.response.text()).to.not.include('nivel_riesgo'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_productor}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/prediccion/historial/{{id_activo}}?fecha_inicio={{desde}}&fecha_fin={{hoy}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "prediccion",
                "historial",
                "{{id_activo}}"
              ],
              "query": [
                {
                  "key": "fecha_inicio",
                  "value": "{{desde}}"
                },
                {
                  "key": "fecha_fin",
                  "value": "{{hoy}}"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "TC-M04-024 - IDOR: ids vecinos al del activo (id-1, id+1)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('id_vecino', String(Number(pm.collectionVariables.get('id_activo')) - 1));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('TC-M04-024 (IDOR): el Productor no ve historiales de activos ajenos por id incremental', function () {",
                  "  pm.expect(pm.response.code === 403 || pm.response.code === 404 || (pm.response.json().eventos || []).length === 0).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
