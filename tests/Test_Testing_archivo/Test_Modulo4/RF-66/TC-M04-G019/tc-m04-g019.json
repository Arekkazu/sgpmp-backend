              "script": {
                "type": "text/javascript",
                "exec": [
                  "console.log('[TC-M04-G019 2.2] status=' + pm.response.code + ' t=' + pm.response.responseTime + 'ms body=' + pm.response.text().slice(0, 600));",
                  "let J; try { J = pm.response.json(); } catch (e) { J = {}; }",
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const R = (J && J.resultado) ? J.resultado : (J || {});",
                  "pm.test('Hay un evento WARNING de latencia posterior a la inferencia lenta', function () { const it = (J.items || []).filter(function (e) { return /LATENCIA/i.test(e.tipo_evento || ''); }); console.log('[TC-M04-G019][OBSERVADO] eventos WARNING=' + (J.items || []).map(function (e) { return e.tipo_evento; }).join(',')); pm.expect(it.length).to.be.above(0); });"
                ]
