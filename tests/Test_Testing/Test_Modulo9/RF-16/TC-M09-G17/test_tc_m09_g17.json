{
	"info": {
		"_postman_id": "tc-m09-g17-referential-integrity-especie-id",
		"name": "TC-M09-G17 — Integridad referencial: id_especie inexistente o inactivo",
		"description": "Verifica que el backend rechace la creación de parámetros (Etapas, Patologías, Métricas) cuando el id_especie referenciado no existe (id_especie=999, id_especie=-1), está inactivo (id_especie=1), o no es válido (id_especie='abc').",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "https://sigab-backendtest-389pcb-a48238-158-69-200-27.sslip.io/api-sgpmp-test",
			"type": "string"
		},
		{
			"key": "admin_email",
			"value": "admin@pecuaria.co",
			"type": "string"
		},
		{
			"key": "admin_password",
			"value": "Test1234!",
			"type": "string"
		},
		{
			"key": "jwt_token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Paso 0: Auth Admin",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Auth Admin exitosa - HTTP 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"var resData = pm.response.json();",
							"pm.test('Token JWT recibido', function () {",
							"    pm.expect(resData.token).to.be.a('string').that.is.not.empty;",
							"});",
							"pm.collectionVariables.set('jwt_token', resData.token);"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"correo_electronico\": \"{{admin_email}}\",\n  \"contrasena\": \"{{admin_password}}\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/sesiones/",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"sesiones",
						""
					]
				}
			}
		},
		{
			"name": "Paso 1: TC-M09-40-A1 - Crear Etapa con id_especie Inexistente (999)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Especie inexistente - HTTP 404', function () {",
							"    pm.response.to.have.status(404);",
							"});",
							"var resData = pm.response.json();",
							"pm.test('Código de error ESPECIE_NO_ENCONTRADA', function () {",
							"    pm.expect(resData.error_code).to.eql('ESPECIE_NO_ENCONTRADA');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"id_especie\": 999,\n  \"nombre\": \"Etapa Especie Inexistente\",\n  \"descripcion\": \"Prueba de integridad referencial TC-M09-40-A1\",\n  \"duracion_dias\": 30\n}"
