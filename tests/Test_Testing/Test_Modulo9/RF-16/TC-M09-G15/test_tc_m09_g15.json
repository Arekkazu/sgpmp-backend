{
  "info": {
    "_postman_id": "tc-m09-g15-integridad-desactivacion",
    "name": "TC-M09-G15 - Integridad de desactivación de parámetros en uso",
    "description": "Suite E2E para TC-M09-G15 (TC-M09-36, TC-M09-37, TC-M09-38): Impedir desactivación de Etapas, Patologías y Métricas con registros asociados (HTTP 422).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": ""
    },
    {
      "key": "jwt_token",
      "value": ""
    },
    {
      "key": "admin_email",
      "value": ""
    },
    {
      "key": "admin_password",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Paso 1: Autenticación Admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"{{admin_email}}\",\n  \"contrasena\": \"{{admin_password}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/sesiones/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "sesiones",
            ""
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Paso 1: Autenticación exitosa - HTTP 200', function () {",
              "    pm.response.to.have.status(200);",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.token).to.be.a('string').that.is.not.empty;",
              "    pm.collectionVariables.set('jwt_token', jsonData.token);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Paso 2: TC-M09-36 - Impedir desactivación de ETAPA en uso (id=10)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": ""
        },
        "url": {
          "raw": "{{baseUrl}}/configuracion/ciclos/10/desactivar",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "configuracion",
            "ciclos",
            "10",
            "desactivar"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "console.log('Validando pre-request: Solicitando desactivacion de id_ciclo_biologico=10 (Fase juvenil cachama) con referencias_productivas > 0');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('TC-M09-36: Bloquear desactivación de ETAPA en uso - HTTP 422 BusinessRuleError', function () {",
              "    pm.response.to.have.status(422);",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.error_code).to.eql('ETAPA_CON_ACTIVOS');",
              "    pm.expect(jsonData.message).to.include('No es posible desactivar la etapa');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Paso 3: TC-M09-37 - Impedir desactivación de PATOLOGÍA en uso (id=7)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": ""
        },
        "url": {
          "raw": "{{baseUrl}}/configuracion/patologias/7/desactivar",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "configuracion",
            "patologias",
            "7",
            "desactivar"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "console.log('Validando pre-request: Solicitando desactivacion de id_especies_patologias=7 (Ich) vinculada a id_patologia=1 con dependencias en M04');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('TC-M09-37: Bloquear desactivación de PATOLOGÍA en uso - HTTP 422 BusinessRuleError', function () {",
              "    pm.response.to.have.status(422);",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.error_code).to.eql('PATOLOGIA_CON_DEPENDENCIAS');",
              "    pm.expect(jsonData.message).to.include('historial clínico');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Paso 4: TC-M09-38 - Impedir desactivación de MÉTRICA en uso (id=1)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": ""
        },
        "url": {
          "raw": "{{baseUrl}}/configuracion/metricas/1/desactivar",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "configuracion",
            "metricas",
            "1",
            "desactivar"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "console.log('Validando pre-request: Solicitando desactivacion de id_metrica_produccion=1 (Peso promedio individual) con 4 eventos productivos en BD');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('TC-M09-38: Bloquear desactivación de MÉTRICA en uso - HTTP 422 BusinessRuleError', function () {",
              "    pm.response.to.have.status(422);",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.error_code).to.eql('METRICA_CON_REGISTROS');",
              "    pm.expect(jsonData.message).to.include('registros productivos activos');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}