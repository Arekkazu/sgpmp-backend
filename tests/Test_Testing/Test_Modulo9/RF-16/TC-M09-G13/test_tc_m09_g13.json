{
  "info": {
    "_postman_id": "tc-m09-g13-validacion-patologias",
    "name": "TC-M09-G13 - Validación de campos de Patología (RF-16 / TC-M09-28 a TC-M09-30)",
    "description": "Caso de prueba E2E autocontenido para RF-16 / CU-02 (Módulo 9): Validaciones de nombres fuera de rango (2 y 101 caracteres), rechazo de descripción de 256 caracteres, y rechazo de duplicados case-insensitive.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://sigab-backendtest-389pcb-a48238-158-69-200-27.sslip.io/api-sgpmp-test",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "idEspecie",
      "value": "4",
      "type": "string"
    },
    {
      "key": "nom2Chars",
      "value": "",
      "type": "string"
    },
    {
      "key": "nom101Chars",
      "value": "",
      "type": "string"
    },
    {
      "key": "desc256Chars",
      "value": "",
      "type": "string"
    },
    {
      "key": "idPatologiaMastitis",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Autenticar Administrador",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Paso 0 - Autenticación Admin exitosa (HTTP 200 OK)', function () {",
              "    pm.response.to.have.status(200);",
              "    var res = pm.response.json();",
              "    pm.expect(res.token).to.be.a('string').and.not.empty;",
              "    pm.collectionVariables.set('jwt_token', res.token);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"admin@pecuaria.co\",\n  \"contrasena\": \"Test1234!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/sesiones/",
          "host": [ "{{baseUrl}}" ],
          "path": [ "sesiones", "" ]
        }
      }
    },
    {
      "name": "1. TC-M09-28a: Rechazar nombre de 2 caracteres ('Ma')",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "var nom2 = 'Ma';",
              "pm.expect(nom2.length).to.equal(2);",
              "console.log('TC-M09-28a: Nombre pre-request verificado programáticamente, Longitud real = ' + nom2.length);",
              "pm.collectionVariables.set('nom2Chars', nom2);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "console.log('TC-M09-28a STATUS:', pm.response.code);",
              "console.log('TC-M09-28a BODY:', pm.response.text());",
              "pm.test('TC-M09-28a - Rechazar nombre de 2 caracteres (HTTP 400 Bad Request)', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "var res = {};",
              "try { res = pm.response.json(); } catch(e) {}",
              "pm.test('TC-M09-28a - Respuesta de error capturada', function () {",
              "    pm.expect(res).to.have.property('error_code');",
              "    console.log('TC-M09-28a error_code real:', res.error_code, '| mensaje:', res.message);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_especie\": {{idEspecie}},\n  \"nombre\": \"{{nom2Chars}}\",\n  \"descripcion\": \"Prueba TC-M09-28a\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/configuracion/patologias",
          "host": [ "{{baseUrl}}" ],
          "path": [ "configuracion", "patologias" ]
        }
      }
    },
    {
      "name": "2. TC-M09-28b: Rechazar nombre de 101 caracteres",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "var nom101 = 'Patologia Con Nombre Extremadamente Largo Que Supera El Limite Permitido De Cincuenta Caracteres QA X';",
              "pm.expect(nom101.length).to.equal(101);",
              "console.log('TC-M09-28b: Nombre pre-request verificado programáticamente, Longitud real = ' + nom101.length);",
              "pm.collectionVariables.set('nom101Chars', nom101);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "console.log('TC-M09-28b STATUS:', pm.response.code);",
              "console.log('TC-M09-28b BODY:', pm.response.text());",
              "pm.test('TC-M09-28b - Rechazar nombre de 101 caracteres (HTTP 400 Bad Request)', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "var res = {};",
              "try { res = pm.response.json(); } catch(e) {}",
              "pm.test('TC-M09-28b - Respuesta de error capturada', function () {",
              "    pm.expect(res).to.have.property('error_code');",
              "    console.log('TC-M09-28b error_code real:', res.error_code, '| mensaje:', res.message);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_especie\": {{idEspecie}},\n  \"nombre\": \"{{nom101Chars}}\",\n  \"descripcion\": \"Prueba TC-M09-28b\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/configuracion/patologias",
          "host": [ "{{baseUrl}}" ],
          "path": [ "configuracion", "patologias" ]
        }
      }
    },
    {
      "name": "3. TC-M09-29: Rechazar descripción de 256 caracteres",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "var desc256 = 'D'.repeat(256);",
              "pm.expect(desc256.length).to.equal(256);",
              "console.log('TC-M09-29: Descripción pre-request verificada programáticamente, Longitud real = ' + desc256.length);",
              "pm.collectionVariables.set('desc256Chars', desc256);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "console.log('TC-M09-29 STATUS:', pm.response.code);",
              "console.log('TC-M09-29 BODY:', pm.response.text());",
              "pm.test('TC-M09-29 - Rechazar descripción de 256 caracteres (HTTP 400 Bad Request)', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "var res = {};",
              "try { res = pm.response.json(); } catch(e) {}",
              "pm.test('TC-M09-29 - Respuesta de error capturada', function () {",
              "    pm.expect(res).to.have.property('error_code');",
              "    console.log('TC-M09-29 error_code real:', res.error_code, '| mensaje:', res.message);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_especie\": {{idEspecie}},\n  \"nombre\": \"Patologia Valida QA\",\n  \"descripcion\": \"{{desc256Chars}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/configuracion/patologias",
          "host": [ "{{baseUrl}}" ],
          "path": [ "configuracion", "patologias" ]
        }
      }
    },
    {
      "name": "4. TC-M09-30a: Registrar patología base 'Mastitis'",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('TC-M09-30a - Registro de patología base Mastitis exitoso (HTTP 201 Created)', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "if (pm.response.code === 201) {",
              "    var res = pm.response.json();",
              "    pm.collectionVariables.set('idPatologiaMastitis', res.id_especies_patologias.toString());",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_especie\": {{idEspecie}},\n  \"nombre\": \"Mastitis\",\n  \"descripcion\": \"Patología base para prueba de duplicado TC-M09-30\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/configuracion/patologias",
          "host": [ "{{baseUrl}}" ],
          "path": [ "configuracion", "patologias" ]
        }
      }
    },
    {
      "name": "5. TC-M09-30b: Rechazar duplicado case-insensitive ('MASTITIS')",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "console.log('TC-M09-30b STATUS:', pm.response.code);",
              "console.log('TC-M09-30b BODY:', pm.response.text());",
              "pm.test('TC-M09-30b - Rechazar patología duplicada (HTTP 409 Conflict o HTTP 400 Bad Request)', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([409, 400]);",
              "});",
              "var res = {};",
              "try { res = pm.response.json(); } catch(e) {}",
              "pm.test('TC-M09-30b - Respuesta de error por duplicado capturada', function () {",
              "    pm.expect(res).to.have.property('error_code');",
              "    console.log('TC-M09-30b error_code real:', res.error_code, '| mensaje:', res.message);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_especie\": {{idEspecie}},\n  \"nombre\": \"MASTITIS\",\n  \"descripcion\": \"Intento de registro duplicado en mayúsculas TC-M09-30\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/configuracion/patologias",
          "host": [ "{{baseUrl}}" ],
          "path": [ "configuracion", "patologias" ]
        }
      }
    },
    {
      "name": "6. Limpieza: Desactivar patología base 'Mastitis'",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var id = pm.collectionVariables.get('idPatologiaMastitis');",
              "if (id) {",
              "    pm.test('Limpieza - Desactivación de patología Mastitis exitosa (HTTP 200 OK)', function () {",
              "        pm.response.to.have.status(200);",
              "    });",
              "} else {",
              "    console.log('Limpieza omitida (ID no asignado).');",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/configuracion/patologias/{{idPatologiaMastitis}}/desactivar",
          "host": [ "{{baseUrl}}" ],
          "path": [ "configuracion", "patologias", "{{idPatologiaMastitis}}", "desactivar" ]
        }
      }
    }
  ]
}
