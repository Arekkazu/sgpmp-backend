        },
        "url": {
          "raw": "{{baseUrl}}/configuracion/metricas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "configuracion",
            "metricas"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var payload = JSON.parse(pm.request.body.raw);",
              "pm.expect(payload.unidad_medida).to.be.undefined;",
              "console.log('Validando pre-request: unidad_medida es undefined (ausente)');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('TC-M09-32b: Rechazar unidad_medida ausente - HTTP 400', function () {",
              "    pm.response.to.have.status(400);",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.error_code).to.eql('VAL_ENTRADA');",
              "    var fieldMatch = jsonData.fields.some(function(f) { return f.field === 'unidad_medida'; });",
              "    pm.expect(fieldMatch).to.be.true;",
              "});"
            ]
          }
        }
      ]
    },
