    {
      "name": "Paso 5: TC-M09-34 - Rechazar coherencia incoherente (PESO vs litros)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_especie\": 4,\n  \"nombre\": \"Metrica Incoherente QA\",\n  \"unidad_medida\": \"litros\",\n  \"tipo_medicion\": \"PESO\",\n  \"aplica_a_tipo_activo\": \"AMBOS\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/configuracion/metricas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "configuracion",
            "metricas"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('TC-M09-34: Rechazar coherencia incoherente - HTTP 422 BusinessRuleError', function () {",
              "    pm.response.to.have.status(422);",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.error_code).to.eql('UNIDAD_MEDIDA_INCOHERENTE');",
              "    var fieldMatch = jsonData.fields.some(function(f) { return f.field === 'unidad_medida'; });",
              "    pm.expect(fieldMatch).to.be.true;",
              "});"
            ]
          }
        }
      ]
    },
