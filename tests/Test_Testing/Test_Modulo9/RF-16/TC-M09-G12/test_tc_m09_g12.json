    {
      "name": "7. TC-M09-26b: Rechazar duplicado case-insensitive ('ENGORDE')",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "console.log('TC-M09-26b STATUS:', pm.response.code);",
              "console.log('TC-M09-26b BODY:', pm.response.text());",
              "pm.test('TC-M09-26b - Rechazar etapa duplicada (HTTP 409 Conflict o HTTP 400 Bad Request)', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([409, 400]);",
              "});",
              "var res = {};",
              "try { res = pm.response.json(); } catch(e) {}",
              "pm.test('TC-M09-26b - Respuesta de error por duplicado capturada', function () {",
