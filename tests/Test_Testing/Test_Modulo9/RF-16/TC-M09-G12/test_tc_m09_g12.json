{
  "info": {
    "_postman_id": "tc-m09-g12-validacion-etapas",
    "name": "TC-M09-G12 - Validación de campos de Etapa productiva (RF-16 / TC-M09-22 a TC-M09-26)",
    "description": "Caso de prueba E2E autocontenido para RF-16 / CU-02 (Módulo 9): Validaciones de límites de nombre (3 y 50 caracteres), rechazo de duración cero, negativa y decimal, y rechazo de duplicados case-insensitive.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://sigab-backendtest-389pcb-a48238-158-69-200-27.sslip.io/api-sgpmp-test",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "idEspecie",
      "value": "4",
      "type": "string"
    },
    {
      "key": "nombre50Chars",
      "value": "",
      "type": "string"
    },
    {
      "key": "idEtapa3Chars",
      "value": "",
      "type": "string"
    },
    {
      "key": "idEtapa50Chars",
