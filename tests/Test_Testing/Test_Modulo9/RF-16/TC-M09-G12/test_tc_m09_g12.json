        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('TC-M09-23 - Etapa con nombre de 50 caracteres es aceptada (HTTP 201 Created)', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "if (pm.response.code === 201) {",
              "    var res = pm.response.json();",
              "    pm.expect(res.nombre.length).to.equal(50);",
              "    pm.collectionVariables.set('idEtapa50Chars', res.id_ciclo_biologico.toString());",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_especie\": {{idEspecie}},\n  \"nombre\": \"{{nombre50Chars}}\",\n  \"descripcion\": \"Prueba TC-M09-23 (50 caracteres)\",\n  \"duracion_dias\": 45\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/configuracion/ciclos",
          "host": [ "{{baseUrl}}" ],
          "path": [ "configuracion", "ciclos" ]
        }
      }
    },
