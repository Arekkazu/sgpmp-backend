  "item": [
    {
      "name": "0. Autenticar Administrador",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Paso 0 - Autenticación Admin exitosa (HTTP 200 OK)', function () {",
              "    pm.response.to.have.status(200);",
              "    var res = pm.response.json();",
              "    pm.expect(res.token).to.be.a('string').and.not.empty;",
              "    pm.collectionVariables.set('jwt_token', res.token);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"admin@pecuaria.co\",\n  \"contrasena\": \"Test1234!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/sesiones/",
          "host": [ "{{baseUrl}}" ],
          "path": [ "sesiones", "" ]
        }
      }
    },
    {
      "name": "1. TC-M09-22: Nombre de EXACTAMENTE 3 caracteres ('Cri')",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "var nom3 = 'Cri';",
              "console.log('TC-M09-22: Nombre a enviar = \"' + nom3 + '\", Longitud real = ' + nom3.length);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('TC-M09-22 - Etapa con nombre de 3 caracteres es aceptada (HTTP 201 Created)', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "if (pm.response.code === 201) {",
              "    var res = pm.response.json();",
              "    pm.expect(res.nombre).to.equal('Cri');",
              "    pm.collectionVariables.set('idEtapa3Chars', res.id_ciclo_biologico.toString());",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_especie\": {{idEspecie}},\n  \"nombre\": \"Cri\",\n  \"descripcion\": \"Prueba TC-M09-22 (3 caracteres)\",\n  \"duracion_dias\": 30\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/configuracion/ciclos",
          "host": [ "{{baseUrl}}" ],
          "path": [ "configuracion", "ciclos" ]
        }
      }
    },
    {
      "name": "2. TC-M09-23: Nombre de EXACTAMENTE 50 caracteres",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "var nom50 = 'Etapa Con Nombre Exacto De Cincuenta Caracteres QA';",
