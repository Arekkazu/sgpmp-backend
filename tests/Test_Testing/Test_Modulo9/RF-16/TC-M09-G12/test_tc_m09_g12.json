          "script": {
            "exec": [
              "var id = pm.collectionVariables.get('idEtapa3Chars');",
              "if (id) {",
              "    pm.test('Limpieza 1 - Desactivación de etapa Cri exitosa (HTTP 200 OK)', function () {",
              "        pm.response.to.have.status(200);",
              "    });",
              "} else {",
              "    console.log('Limpieza 1 omitida (ID no asignado).');",
              "}"
