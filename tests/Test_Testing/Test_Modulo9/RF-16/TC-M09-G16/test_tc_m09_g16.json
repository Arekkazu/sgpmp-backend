  "info": {
    "_postman_id": "tc-m09-g16-rbac-rf16",
    "name": "TC-M09-G16 - Restricción de permisos RBAC para Productor e Ingeniero sobre RF-16",
    "description": "Suite E2E para TC-M09-G16 (sub-caso TC-M09-39, OWASP A01). Verifica que usuarios con rol Productor e Ingeniero de Campo no puedan crear ni desactivar etapas, patologías ni métricas productivas por especie en /configuracion/, retornando HTTP 403 ACCESO_DENEGADO en las 12 combinaciones.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
