        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.collectionVariables.get('login_ok') !== '1') { return; }",
              "const code = pm.response.code;",
              "pm.collectionVariables.set('patch197_http', String(code));",
              "pm.test('TC-M09-197 PATCH idioma HTTP 200', function () { pm.expect(code).to.eql(200); });",
              "if (code !== 200) { return; }",
              "const json = pm.response.json();",
              "pm.test('PATCH locale_code en-US', function () { pm.expect(json.locale_code).to.eql('en-US'); });",
              "pm.test('es_por_defecto false (personal)', function () {",
              "    if (json.es_por_defecto != null) { pm.expect(json.es_por_defecto).to.eql(false); }",
              "});",
              "if (json.version_perfil != null) { pm.collectionVariables.set('version_perfil', String(json.version_perfil)); }"
            ]
          }
        }
