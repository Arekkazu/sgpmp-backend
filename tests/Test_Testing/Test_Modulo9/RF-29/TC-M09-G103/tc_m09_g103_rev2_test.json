            "const orig = pm.collectionVariables.get('locale_original');",
            "const json = pm.response.json();",
            "pm.test('GET post-restore locale_code == original', function () {",
            "    pm.expect(pm.response.code).to.eql(200);",
            "    pm.expect(json.locale_code).to.eql(orig);",
            "});"
          ]
        }
      }],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
