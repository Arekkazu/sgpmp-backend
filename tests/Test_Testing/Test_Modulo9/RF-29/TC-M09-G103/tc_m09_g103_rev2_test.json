    {
      "name": "06 GET /auditoria/ baseline tipo_evento=27",
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "if (pm.collectionVariables.get('login_ok') !== '1') { return; }",
            "const code = pm.response.code;",
            "pm.collectionVariables.set('audit_http_before', String(code));",
            "if (code === 401 || code === 403) {",
            "    pm.test('GET /auditoria/ no 401/403', function () { pm.expect(code).to.not.be.oneOf([401, 403]); });",
            "    pm.collectionVariables.set('abort_reason', 'GET /auditoria/ HTTP ' + code);",
            "    return;",
            "}",
            "pm.test('GET /auditoria/ baseline HTTP 200 o 206', function () { pm.expect([200, 206]).to.include(code); });",
            "const json = pm.response.json();",
            "let maxId = 0;",
            "(json.items || []).forEach(function (ev) {",
            "    if (ev && ev.id_evento > maxId) { maxId = ev.id_evento; }",
            "});",
            "pm.collectionVariables.set('audit_max_id_before', String(maxId));"
          ]
        }
      }],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Accept", "value": "application/json" }
