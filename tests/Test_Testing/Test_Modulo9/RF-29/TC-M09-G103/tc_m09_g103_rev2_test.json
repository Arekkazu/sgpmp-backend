    {
      "name": "09 GET /auditoria/ tipo_evento=27 tras PATCH 197",
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "if (pm.collectionVariables.get('login_ok') !== '1') { return; }",
            "const code = pm.response.code;",
            "pm.collectionVariables.set('audit_http_after', String(code));",
            "pm.test('GET /auditoria/ post-PATCH HTTP 200 o 206', function () { pm.expect([200, 206]).to.include(code); });",
            "if (code !== 200 && code !== 206) { return; }",
            "const json = pm.response.json();",
            "const items = json.items || [];",
            "const maxBefore = Number(pm.collectionVariables.get('audit_max_id_before') || 0);",
            "const uid = pm.collectionVariables.get('id_usuario');",
            "function detalleDe(ev) {",
            "    if (!ev) { return {}; }",
            "    if (ev.detalle && typeof ev.detalle === 'object') { return ev.detalle; }",
            "    if (typeof ev.detalle === 'string') { try { return JSON.parse(ev.detalle); } catch (e) { return {}; } }",
            "    return {};",
            "}",
            "const candidatos = items.filter(function (ev) {",
            "    if (!ev) { return false; }",
            "    if (Number(ev.tipo_evento) !== 27) { return false; }",
            "    if (maxBefore && ev.id_evento <= maxBefore) { return false; }",
            "    if (uid && ev.id_usuario != null && String(ev.id_usuario) !== String(uid)) { return false; }",
            "    const d = detalleDe(ev);",
            "    const ant = String(d.locale_anterior || '').toLowerCase();",
            "    const neu = String(d.locale_nuevo || '').toLowerCase();",
            "    return ant === 'es-co' && neu === 'en-us';",
            "});",
            "const evento = candidatos[0] || null;",
            "pm.collectionVariables.set('evento_idioma', evento ? ('ENCONTRADO_id=' + evento.id_evento) : 'NO_ENCONTRADO');",
            "if (evento) {",
            "    pm.collectionVariables.set('evento_id', String(evento.id_evento));",
            "    pm.collectionVariables.set('evento_detalle', JSON.stringify(detalleDe(evento)));",
            "}",
            "pm.test('TC-M09-197 registro consultable es-CO → en-US (tipo 27, posterior al baseline)', function () {",
            "    pm.expect(evento, 'No hay evento tipo 27 con locale_anterior=es-CO y locale_nuevo=en-US posterior al baseline').to.not.equal(null);",
            "});",
            "if (!evento) { return; }",
            "const d = detalleDe(evento);",
            "pm.test('usuario identificable (id_usuario)', function () {",
            "    pm.expect(evento.id_usuario).to.eql(Number(uid) || evento.id_usuario);",
            "    pm.expect(evento.id_usuario).to.exist;",
            "});",
            "pm.test('sesión o equivalente (id_sesion documentado si viene)', function () {",
            "    pm.expect(evento.id_usuario != null || evento.id_sesion != null).to.eql(true);",
            "});",
            "pm.test('fecha/hora fecha_evento', function () { pm.expect(evento.fecha_evento).to.exist; });",
            "pm.test('operación tipo_evento=27 CAMBIO_IDIOMA_PERSONAL', function () {",
            "    pm.expect(Number(evento.tipo_evento)).to.eql(27);",
            "});",
            "pm.test('valor anterior es-CO', function () { pm.expect(d.locale_anterior).to.eql('es-CO'); });",
            "pm.test('valor nuevo en-US', function () { pm.expect(d.locale_nuevo).to.eql('en-US'); });"
          ]
        }
      }],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/auditoria/?pagina=1&tamano=50&tipo_evento=27&id_usuario={{id_usuario}}",
          "host": ["{{baseUrl}}"],
          "path": ["auditoria", ""],
          "query": [
            { "key": "pagina", "value": "1" },
            { "key": "tamano", "value": "50" },
            { "key": "tipo_evento", "value": "27" },
            { "key": "id_usuario", "value": "{{id_usuario}}" }
          ]
        }
      }
    },
    {
      "name": "10 PATCH restaurar locale original",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const orig = pm.collectionVariables.get('locale_original') || 'es-CO';",
              "const vp = pm.collectionVariables.get('version_perfil');",
              "const body = { locale_code: orig };",
              "if (vp && vp !== 'null' && vp !== '') { body.version_perfil = Number(vp); }",
              "pm.request.body.raw = JSON.stringify(body);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.collectionVariables.get('login_ok') !== '1') { return; }",
              "const orig = pm.collectionVariables.get('locale_original');",
              "pm.test('Restore PATCH HTTP 200', function () { pm.expect(pm.response.code).to.eql(200); });",
              "if (pm.response.code === 200) {",
              "    const json = pm.response.json();",
              "    pm.test('Restore PATCH locale_code = original', function () { pm.expect(json.locale_code).to.eql(orig); });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\"locale_code\":\"es-CO\"}" },
        "url": "{{baseUrl}}/configuracion/personalizacion/idioma"
      }
    },
    {
      "name": "11 GET confirmar restauración",
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
