            "pm.test('GET catalogo tipos-evento HTTP 200', function () { pm.expect(pm.response.code).to.eql(200); });",
            "if (pm.response.code !== 200) { return; }",
            "const arr = pm.response.json();",
            "const t27 = (arr || []).find(function (x) { return x && Number(x.id_tipo_evento) === 27; });",
            "pm.test('Catálogo incluye id_tipo_evento 27 CAMBIO_IDIOMA_PERSONAL', function () {",
            "    pm.expect(t27, 'tipo 27 ausente en catálogo').to.exist;",
            "    if (t27 && t27.nombre) { pm.expect(String(t27.nombre)).to.include('IDIOMA'); }",
