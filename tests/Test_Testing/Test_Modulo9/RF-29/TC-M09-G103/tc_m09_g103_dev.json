  "item": [
    {
      "name": "00.1 POST /sesiones (un solo login)",
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "const code = pm.response.code;",
            "pm.collectionVariables.set('login_http', String(code));",
            "let json = {};",
            "try { json = pm.response.json(); } catch (e) { json = {}; }",
            "pm.test('Login HTTP 200 (un intento, sin refresh)', function () {",
            "    pm.expect(code).to.eql(200);",
            "});",
            "if (code === 200 && json.token) {",
            "    pm.collectionVariables.set('token', json.token);",
            "    pm.collectionVariables.set('login_ok', '1');",
            "    if (json.id_usuario != null) {",
            "        pm.collectionVariables.set('id_usuario', String(json.id_usuario));",
            "    }",
            "} else {",
            "    pm.collectionVariables.set('login_ok', '0');",
            "    pm.collectionVariables.set('abort_reason', 'Login HTTP ' + code + ' — G103 BLOQUEADO, sin reintento');",
            "    pm.execution.setNextRequest(null);",
            "}"
          ]
        }
      }],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"{{correo}}\",\n  \"contrasena\": \"{{contrasena}}\"\n}"
        },
        "url": "{{baseUrl}}/sesiones/"
      }
    },
    {
      "name": "01 GET idioma original (precheck)",
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "if (pm.collectionVariables.get('login_ok') !== '1') { return; }",
            "const code = pm.response.code;",
            "pm.test('PRECHECK GET idioma HTTP 200', function () { pm.expect(code).to.eql(200); });",
            "if (code === 401 || code === 403) {",
            "    pm.collectionVariables.set('abort_reason', 'GET idioma HTTP ' + code + ' — BLOQUEADO (permiso/sesión)');",
            "    pm.execution.setNextRequest(null);",
            "    return;",
            "}",
            "if (code !== 200) {",
            "    pm.collectionVariables.set('abort_reason', 'GET idioma HTTP ' + code);",
            "    pm.execution.setNextRequest(null);",
            "    return;",
            "}",
            "const json = pm.response.json();",
            "pm.collectionVariables.set('locale_original', json.locale_code || '');",
            "pm.collectionVariables.set('fuente_original', json.fuente || '');",
            "pm.collectionVariables.set('id_preferencia_original', json.id_preferencia_idioma == null ? '' : String(json.id_preferencia_idioma));",
            "pm.collectionVariables.set('version_perfil', json.version_perfil == null ? '' : String(json.version_perfil));",
            "pm.test('Precheck trae locale_code', function () {",
            "    pm.expect(json.locale_code).to.be.a('string').and.not.empty;",
            "});"
          ]
        }
      }],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Accept", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/configuracion/personalizacion/idioma"
      }
    },
    {
      "name": "02 Probe GET idioma/auditoria (no inventar contrato)",
