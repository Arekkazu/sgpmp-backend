    {
      "name": "05 GET /auditoria/ baseline M1 (pagina/tamano)",
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "if (pm.collectionVariables.get('login_ok') !== '1') { return; }",
            "const code = pm.response.code;",
            "pm.collectionVariables.set('audit_http_before', String(code));",
            "if (code === 401 || code === 403) {",
            "    pm.test('GET /auditoria/ baseline no 401/403 (si falla es BLOQUEADO de consulta M1)', function () {",
            "        pm.expect(code).to.not.be.oneOf([401, 403]);",
            "    });",
            "    pm.collectionVariables.set('abort_reason', 'GET /auditoria/ HTTP ' + code + ' — BLOQUEADO consulta M1');",
            "    return;",
            "}",
            "pm.test('GET /auditoria/ baseline HTTP 200 o 206', function () {",
            "    pm.expect([200, 206]).to.include(code);",
            "});",
            "const json = pm.response.json();",
            "pm.test('Contrato M1: total/pagina/tamano/items', function () {",
            "    pm.expect(json).to.have.property('total');",
            "    pm.expect(json).to.have.property('pagina');",
            "    pm.expect(json).to.have.property('tamano');",
            "    pm.expect(json.items).to.be.an('array');",
            "});",
            "pm.collectionVariables.set('audit_total_before', String(json.total));",
            "let maxId = 0;",
            "(json.items || []).forEach(function (ev) {",
            "    if (ev && ev.id_evento > maxId) { maxId = ev.id_evento; }",
            "});",
            "pm.collectionVariables.set('audit_max_id_before', String(maxId));"
          ]
        }
      }],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Accept", "value": "application/json" }
