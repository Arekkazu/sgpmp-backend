              "const json = pm.response.json();",
              "pm.test('PATCH persistió locale_code en-US (estado, no auditoría)', function () {",
              "    pm.expect(json.locale_code).to.eql('en-US');",
              "});",
              "pm.test('es_por_defecto false (preferencia personal, no global)', function () {",
              "    if (json.es_por_defecto != null) { pm.expect(json.es_por_defecto).to.eql(false); }",
              "});",
              "const uid = pm.collectionVariables.get('id_usuario');",
              "if (uid) {",
              "    pm.test('id_usuario del PATCH coincide con el login', function () {",
              "        pm.expect(String(json.id_usuario)).to.eql(uid);",
              "    });",
              "}",
              "if (json.version_perfil != null) {",
              "    pm.collectionVariables.set('version_perfil', String(json.version_perfil));",
              "}"
            ]
          }
