    {
      "name": "08 GET /auditoria/ tras PATCH 197 (pagina/tamano)",
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "if (pm.collectionVariables.get('login_ok') !== '1') { return; }",
            "const code = pm.response.code;",
            "pm.collectionVariables.set('audit_http_after', String(code));",
            "pm.test('GET /auditoria/ post-PATCH HTTP 200 o 206', function () {",
            "    pm.expect([200, 206]).to.include(code);",
            "});",
            "if (code !== 200 && code !== 206) { return; }",
            "const json = pm.response.json();",
            "const items = json.items || [];",
            "const maxBefore = Number(pm.collectionVariables.get('audit_max_id_before') || 0);",
            "const uid = pm.collectionVariables.get('id_usuario');",
            "function esConsultaAuditoria(ev) {",
            "    const t = JSON.stringify(ev).toLowerCase();",
            "    return t.includes('consulta') && t.includes('auditoria');",
            "}",
            "function pareceCambioIdioma(ev) {",
            "    const t = JSON.stringify(ev).toLowerCase();",
            "    if (esConsultaAuditoria(ev)) { return false; }",
            "    const tieneLocale = t.includes('idioma') || t.includes('locale') || t.includes('language') || t.includes('preferencia_idioma');",
            "    const tieneValores = t.includes('en-us') || (t.includes('es-co') && t.includes('en-us'));",
            "    return tieneLocale && tieneValores;",
            "}",
            "const candidatos = items.filter(function (ev) {",
            "    if (!ev) { return false; }",
            "    if (maxBefore && ev.id_evento <= maxBefore) { return false; }",
            "    if (uid && ev.id_usuario != null && String(ev.id_usuario) !== uid) { return false; }",
            "    return pareceCambioIdioma(ev);",
            "});",
            "const evento = candidatos[0] || null;",
            "if (evento) {",
            "    pm.collectionVariables.set('evento_idioma', 'ENCONTRADO_id=' + evento.id_evento);",
            "} else {",
            "    pm.collectionVariables.set('evento_idioma', 'NO_ENCONTRADO');",
            "    console.log('Después del cambio es-CO → en-US no se encontró evento de auditoría correspondiente en modulo1.eventos.');",
            "}",
            "pm.test('TC-M09-197: registro de auditoría consultable del cambio es-CO → en-US', function () {",
            "    pm.expect(",
            "        evento,",
            "        'Después del cambio es-CO → en-US no se encontró evento de auditoría correspondiente en modulo1.eventos.'",
            "    ).to.not.equal(null);",
            "});",
            "if (evento) {",
            "    const t = JSON.stringify(evento).toLowerCase();",
            "    pm.test('TC-M09-197 usuario o id_sesion presente', function () {",
            "        pm.expect(evento.id_usuario != null || evento.id_sesion != null).to.eql(true);",
            "    });",
            "    pm.test('TC-M09-197 fecha/hora', function () {",
            "        pm.expect(evento.fecha_evento).to.exist;",
            "    });",
            "    pm.test('TC-M09-197 operación (tipo_evento o descripcion de idioma)', function () {",
            "        pm.expect(evento.tipo_evento != null || (evento.descripcion && String(evento.descripcion).length > 0)).to.eql(true);",
            "    });",
            "    pm.test('TC-M09-197 valor anterior es-CO', function () {",
            "        pm.expect(t).to.include('es-co');",
            "    });",
            "    pm.test('TC-M09-197 valor nuevo en-US', function () {",
            "        pm.expect(t).to.include('en-us');",
            "    });",
            "}"
          ]
        }
      }],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/auditoria/?pagina=1&tamano=50",
          "host": ["{{baseUrl}}"],
          "path": ["auditoria", ""],
          "query": [
            { "key": "pagina", "value": "1" },
            { "key": "tamano", "value": "50" }
          ]
