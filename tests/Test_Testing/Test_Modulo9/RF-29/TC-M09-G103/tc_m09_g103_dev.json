    {
      "name": "09 PATCH restaurar locale original",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const orig = pm.collectionVariables.get('locale_original') || 'es-CO';",
              "const vp = pm.collectionVariables.get('version_perfil');",
              "const body = { locale_code: orig };",
              "if (vp && vp !== 'null') { body.version_perfil = Number(vp); }",
              "pm.request.body.raw = JSON.stringify(body);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.collectionVariables.get('login_ok') !== '1') { return; }",
              "const orig = pm.collectionVariables.get('locale_original');",
              "pm.test('Restore PATCH HTTP 200', function () { pm.expect(pm.response.code).to.eql(200); });",
              "if (pm.response.code === 200) {",
              "    const json = pm.response.json();",
              "    pm.test('Restore PATCH locale_code = original', function () {",
              "        pm.expect(json.locale_code).to.eql(orig);",
              "    });",
              "    if (json.version_perfil != null) {",
              "        pm.collectionVariables.set('version_perfil', String(json.version_perfil));",
              "    }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\"locale_code\":\"es-CO\"}" },
        "url": "{{baseUrl}}/configuracion/personalizacion/idioma"
      }
    },
    {
      "name": "10 GET confirmar restauración",
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "if (pm.collectionVariables.get('login_ok') !== '1') { return; }",
            "const orig = pm.collectionVariables.get('locale_original');",
            "const json = pm.response.json();",
            "pm.test('GET post-restore locale_code == original', function () {",
            "    pm.expect(pm.response.code).to.eql(200);",
            "    pm.expect(json.locale_code).to.eql(orig);",
            "});"
          ]
        }
