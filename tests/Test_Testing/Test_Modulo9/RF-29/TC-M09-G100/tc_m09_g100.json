              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"TC-M09-193 - Persistencia de en-US\", function () {",
              "    pm.expect(body.locale_code).to.eql(\"en-US\");",
              "});",
              "",
              "pm.test(\"TC-M09-193 - Fuente personal\", function () {",
