              "const json = pm.response.json();",
              "console.log('Estado DESPUES (respuesta del PATCH): ' + JSON.stringify(json));",
              "pm.test('nombre cambio respecto al estado anterior', function () {",
              "    pm.expect(json.nombre_infraestructura).to.not.eql(pm.collectionVariables.get('nombre_antes'));",
              "    pm.expect(json.nombre_infraestructura).to.eql('Estanque Editado TC-M09-G50');",
              "});",
              "pm.test('superficie cambio de ' + pm.collectionVariables.get('superficie_antes') + ' a 2750.50', function () {",
              "    pm.expect(parseFloat(json.superficie)).to.eql(2750.5);",
              "});",
              "pm.test('especie y modelo se conservan', function () {",
              "    pm.expect(json.especie_id).to.eql(pm.collectionVariables.get('id_especie_a'));",
              "    pm.expect(json.tipo_modelo_asignado).to.eql('MODELO_AVES');",
              "});",
              "pm.test('fecha_actualizacion rotada respecto al estado anterior', function () {",
              "    pm.expect(json.fecha_actualizacion).to.not.eql(pm.collectionVariables.get('antes_fecha'));",
              "});"
            ]
          }
        }
