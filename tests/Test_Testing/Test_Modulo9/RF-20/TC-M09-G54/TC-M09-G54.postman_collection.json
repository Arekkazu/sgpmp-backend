    {
      "name": "TC-M09-106e - Admin A y Admin B guardan EXACTAMENTE a la vez con la misma marca",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Este GET es la lectura comun de A y B (misma fecha_actualizacion). Desde aqui se lanzan los dos",
              "// PATCH con pm.sendRequest sin esperar uno al otro, asi que llegan al backend en paralelo.",
              "const TOTAL = 10;",
              "const n = parseInt(pm.collectionVariables.get('intento_simultaneo'), 10);",
              "// Repetir el par preparar/editar hasta completar TOTAL intentos; luego seguir con la lectura final.",
              "if (n < TOTAL) { postman.setNextRequest('TC-M09-106e - Preparar un area nueva para el intento simultaneo'); }",
              "",
              "pm.test('Intento ' + n + ': lectura comun disponible (200)', function () { pm.response.to.have.status(200); });",
              "const marca = pm.response.json().fecha_actualizacion;",
              "const base = pm.collectionVariables.get('base_url');",
              "const id = pm.collectionVariables.get('id_area_simultanea');",
              "const token = pm.collectionVariables.get('token_admin');",
              "const especie = pm.collectionVariables.get('id_especie');",
              "const res = {};",
              "",
              "function editar(quien, superficie) {",
              "    pm.sendRequest({",
              "        url: base + '/configuracion/infraestructuras/' + id,",
              "        method: 'PATCH',",
              "        header: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },",
              "        body: { mode: 'raw', raw: JSON.stringify({",
              "            nombre_infraestructura: 'Editada por ' + quien + ' ' + n,",
              "            tipo_area: 'Estanque', superficie: superficie, especie_id: especie, fecha_actualizacion: marca",
              "        }) }",
              "    }, function (err, r) {",
              "        res[quien] = err ? { code: 'ERR', body: String(err) } : { code: r.code, body: r.json() };",
              "        if (res.A && res.B) { verificar(); }",
              "    });",
              "}",
              "",
              "function verificar() {",
              "    pm.sendRequest({ url: base + '/configuracion/infraestructuras/' + id, method: 'GET',",
              "                     header: { 'Authorization': 'Bearer ' + token } }, function (err, r) {",
              "        const final = r.json().nombre_infraestructura;",
              "        const codigos = 'A=' + res.A.code + ' B=' + res.B.code;",
              "        console.log('Intento ' + n + ' (area ' + id + '): ' + codigos + ' | final=\"' + final + '\" | A=' + JSON.stringify(res.A.body).slice(0, 160) + ' | B=' + JSON.stringify(res.B.body).slice(0, 160));",
              "        const ganadores = ['A', 'B'].filter(q => res[q].code === 200);",
              "        const perdedores = ['A', 'B'].filter(q => res[q].code === 412);",
              "        pm.test('Intento ' + n + ': exactamente un 200 y un 412 CONFLICTO_CONCURRENCIA (obtenido ' + codigos + ')', function () {",
              "            pm.expect(ganadores.length, 'ediciones aceptadas a la vez').to.eql(1);",
              "            pm.expect(perdedores.length, 'ediciones rechazadas con 412').to.eql(1);",
              "            pm.expect(res[perdedores[0]].body.error_code).to.eql('CONFLICTO_CONCURRENCIA');",
              "        });",
              "        pm.test('Intento ' + n + ': no hay actualizacion perdida (el area refleja la unica edicion aceptada)', function () {",
              "            pm.expect(ganadores.length, 'si ambas son 200, una sobrescribio a la otra sin aviso').to.eql(1);",
              "            pm.expect(final).to.eql('Editada por ' + ganadores[0] + ' ' + n);",
              "        });",
              "    });",
              "}",
              "",
              "editar('A', '150.00');",
              "editar('B', '200.00');"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
