          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('El gate RBAC no lo bloquea (no 403)', function () { pm.expect(pm.response.code).to.not.eql(403); });",
              "const json = pm.response.json();",
              "console.log('Admin - crear area: status=' + pm.response.code + ' body=' + JSON.stringify(json));",
