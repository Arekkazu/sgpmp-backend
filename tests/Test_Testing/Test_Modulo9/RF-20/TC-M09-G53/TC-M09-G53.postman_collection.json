{
  "info": {
    "name": "RF-20 - TC-M09-G53 Auditoria de operaciones sobre areas productivas",
    "description": "RF-20 v1.1 (RFC-009). TC-M09-105: ejecuta sobre un area propia, en orden, registro, consulta del listado, modificacion, desactivacion y reactivacion. modulo9.auditorias_infraestructuras no tiene endpoint REST, asi que las filas de auditoria de esa area se verifican despues con verificar_auditoria_g53.py, que toma el id_infraestructura de la coleccion exportada por esta corrida. Se espera CREATE, GET, UPDATE, DEACTIVATE y UPDATE (la reactivacion se audita como UPDATE, no como CREATE).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://sigab-backendtest-389pcb-a48238-158-69-200-27.sslip.io/api-sgpmp-test"
    },
    {
      "key": "token_admin",
      "value": ""
    },
    {
      "key": "sufijo",
      "value": ""
    },
    {
      "key": "id_finca",
      "value": ""
    },
    {
      "key": "id_especie",
      "value": ""
    },
    {
      "key": "id_infraestructura",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Paso 1 - Login Administrador",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const letras = 'abcdefghijklmnopqrstuvwxyz';",
              "let sufijo = '';",
              "for (let i = 0; i < 10; i++) sufijo += letras.charAt(Math.floor(Math.random() * letras.length));",
              "pm.collectionVariables.set('sufijo', sufijo);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login exitoso (200)', function () { pm.response.to.have.status(200); });",
              "pm.collectionVariables.set('token_admin', pm.response.json().token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"admin@pecuaria.co\",\n  \"contrasena\": \"Test1234!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/sesiones/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "sesiones",
            ""
          ]
        }
      },
      "response": []
    },
    {
      "name": "Paso 2 - Registrar finca activa propia",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Finca creada (201)', function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set('id_finca', pm.response.json().id_finca);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token_admin}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Finca Auditoria Areas {{sufijo}}\",\n  \"ubicacion\": {\n    \"departamento\": \"Antioquia\",\n    \"municipio\": \"Medellin\",\n    \"vereda\": \"La Estrella\",\n    \"latitud\": \"6.25\",\n    \"longitud\": \"-75.56\"\n  },\n  \"tamano_h\": \"10.0\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/configuracion/fincas",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "configuracion",
            "fincas"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Paso 3 - Registrar especie activa MODELO_AVES",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Especie creada (201)', function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set('id_especie', pm.response.json().id_especie);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token_admin}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Aves Auditoria {{sufijo}}\",\n  \"descripcion\": \"Especie de prueba TC-M09-G53\",\n  \"tipo_modelo\": \"MODELO_AVES\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/configuracion/especies",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "configuracion",
            "especies"
          ]
        }
      },
      "response": []
    },
    {
      "name": "TC-M09-105 - Op 1 REGISTRO (debe auditarse como CREATE)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Area registrada (201)', function () { pm.response.to.have.status(201); });",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('id_infraestructura', json.id_infraestructura);",
              "console.log('OPERACION CREATE: id_infraestructura=' + pm.collectionVariables.get('id_infraestructura') + ' date=' + pm.response.headers.get('Date'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token_admin}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre_infraestructura\": \"Area Auditada\",\n  \"tipo_area\": \"Galpón\",\n  \"superficie\": \"300.00\",\n  \"finca_id\": {{id_finca}},\n  \"descripcion_infraestructura\": \"Creada por TC-M09-105\",\n  \"especie_id\": {{id_especie}},\n  \"tipo_modelo_asignado\": \"MODELO_AVES\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/configuracion/infraestructuras",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "configuracion",
            "infraestructuras"
          ]
        }
      },
      "response": []
    },
    {
      "name": "TC-M09-105 - Op 2 CONSULTA del listado (RF-20 audita el listado como GET)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Listado disponible (200)', function () { pm.response.to.have.status(200); });",
              "pm.test('Incluye el area', function () { pm.expect(pm.response.json().items.map(i => i.id_infraestructura)).to.include(pm.collectionVariables.get('id_infraestructura')); });",
              "console.log('OPERACION GET: id_infraestructura=' + pm.collectionVariables.get('id_infraestructura') + ' date=' + pm.response.headers.get('Date'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_admin}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/configuracion/infraestructuras?finca_id={{id_finca}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "configuracion",
            "infraestructuras"
          ],
          "query": [
            {
              "key": "finca_id",
              "value": "{{id_finca}}"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "TC-M09-105 - Op 3 MODIFICACION (debe auditarse como UPDATE)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Area modificada (200)', function () { pm.response.to.have.status(200); });",
              "pm.test('Cambios aplicados', function () { const json = pm.response.json(); pm.expect(json.nombre_infraestructura).to.eql('Area Auditada Editada'); pm.expect(parseFloat(json.superficie)).to.eql(350); });",
              "console.log('OPERACION UPDATE-edicion: id_infraestructura=' + pm.collectionVariables.get('id_infraestructura') + ' date=' + pm.response.headers.get('Date'));"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token_admin}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre_infraestructura\": \"Area Auditada Editada\",\n  \"tipo_area\": \"Galpón\",\n  \"superficie\": \"350.00\",\n  \"descripcion_infraestructura\": \"Editada por TC-M09-105\",\n  \"especie_id\": {{id_especie}},\n  \"tipo_modelo_asignado\": \"MODELO_AVES\",\n  \"fecha_actualizacion\": null\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/configuracion/infraestructuras/{{id_infraestructura}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "configuracion",
            "infraestructuras",
            "{{id_infraestructura}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "TC-M09-105 - Op 4 DESACTIVACION (debe auditarse como DEACTIVATE)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Area desactivada (200)', function () { pm.response.to.have.status(200); });",
              "pm.test('Queda inactiva', function () { pm.expect(pm.response.json().es_activo).to.eql(false); });",
              "console.log('OPERACION DEACTIVATE: id_infraestructura=' + pm.collectionVariables.get('id_infraestructura') + ' date=' + pm.response.headers.get('Date'));"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_admin}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/configuracion/infraestructuras/{{id_infraestructura}}/desactivar",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "configuracion",
            "infraestructuras",
            "{{id_infraestructura}}",
            "desactivar"
          ]
        }
      },
      "response": []
    },
    {
      "name": "TC-M09-105 - Op 5 REACTIVACION (RF-20 v1.1: debe auditarse como UPDATE, no como CREATE)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Area reactivada (200)', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.test('Queda activa con el mismo id (no se crea un area nueva)', function () {",
              "    pm.expect(json.es_activo).to.eql(true);",
              "    pm.expect(json.id_infraestructura).to.eql(pm.collectionVariables.get('id_infraestructura'));",
              "});",
              "console.log('OPERACION UPDATE-reactivacion: id_infraestructura=' + pm.collectionVariables.get('id_infraestructura') + ' date=' + pm.response.headers.get('Date'));"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_admin}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/configuracion/infraestructuras/{{id_infraestructura}}/reactivar",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "configuracion",
            "infraestructuras",
            "{{id_infraestructura}}",
            "reactivar"
          ]
        }
      },
      "response": []
    }
  ]
