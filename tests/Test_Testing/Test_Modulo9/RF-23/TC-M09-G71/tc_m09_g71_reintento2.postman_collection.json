    {
      "name": "Sub-caso 2 (TC-M09-137, BUG BOLA) - Ingeniero SIN relacion con la finca configura el dispositivo de todas formas",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "console.log('--- Sub-caso 2: Ingeniero de Campo (sin ninguna finca/activo asociado a la finca 1) intenta configurar un dispositivo de la finca 1 ---');",
              "console.log(pm.response.text());",
              "pm.test('CORREGIDO: se rechaza por falta de alcance (404, patron anti-enumeracion -- no revela si el dispositivo existe)', function () { pm.response.to.have.status(404); });",
              "let respuesta; try { respuesta = pm.response.json(); } catch (e) { respuesta = null; }",
              "pm.test('codigo de negocio DISPOSITIVO_NO_ENCONTRADO', function () { pm.expect(respuesta).to.not.equal(null); pm.expect(respuesta.error_code).to.equal('DISPOSITIVO_NO_ENCONTRADO'); });",
              "console.log('CONCLUSION: ConfigurarRemotamenteUseCase ahora recibe ids_fincas_permitidas y lo pasa a dispositivo_repo.obtener_por_id -- el fix bb97a10b (INC-M09-108-G71) esta desplegado en DEV.');"
            ]
          }
        }
