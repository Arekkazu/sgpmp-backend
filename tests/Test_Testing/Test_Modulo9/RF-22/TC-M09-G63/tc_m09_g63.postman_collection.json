    {
      "name": "Escenario 1 (TC-M09-125) - Rechazar asociacion con punto_instalacion vacio",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "console.log('--- Escenario 1: punto_instalacion vacio ---');",
              "console.log(pm.response.text());",
              "",
              "pm.test('Escenario 1: la asociacion con punto_instalacion vacio responde HTTP 400', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "let respuesta;",
              "try { respuesta = pm.response.json(); } catch (e) { respuesta = null; }",
              "",
              "pm.test('Escenario 1: el error indica VAL_ENTRADA', function () {",
              "    pm.expect(respuesta).to.not.equal(null);",
              "    pm.expect(respuesta.error_code).to.equal('VAL_ENTRADA');",
              "});",
              "",
              "if (respuesta) {",
              "    const errorPunto = (respuesta.fields || []).find(function (f) { return f.field === 'punto_instalacion'; });",
              "    pm.test('Escenario 1: el error de validacion senala el campo punto_instalacion como obligatorio', function () {",
              "        pm.expect(errorPunto, 'fields recibidos: ' + JSON.stringify(respuesta.fields)).to.not.equal(undefined);",
              "        pm.expect(errorPunto.message.toLowerCase()).to.include('obligatorio');",
              "    });",
              "    console.log('CONCLUSION escenario 1: ' + (errorPunto ? errorPunto.message : 'sin detalle'));",
              "}"
            ]
          }
        }
      ],
