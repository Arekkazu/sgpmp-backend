    {
      "name": "TC-M09-G64 - Reasignar el sensor a la nueva area con confirmar=true",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "console.log('--- Reasignacion del sensor a la nueva area (accion bajo prueba) ---');",
              "console.log(pm.response.text());",
              "",
              "pm.test('TC-M09-G64: la reasignacion confirmada responde HTTP 201 (nueva asociacion creada)', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "let respuesta;",
              "try { respuesta = pm.response.json(); } catch (e) { respuesta = null; }",
              "",
              "if (pm.response.code === 201 && respuesta) {",
              "    pm.collectionVariables.set('id_asociacion_nueva', respuesta.id_sensores_area_asociada);",
              "",
              "    pm.test('TC-M09-G64: la nueva asociacion es un registro distinto al de la asociacion original', function () {",
              "        pm.expect(respuesta.id_sensores_area_asociada).to.not.equal(Number(pm.collectionVariables.get('id_asociacion_original')));",
              "    });",
              "    pm.test('TC-M09-G64: la nueva asociacion queda en la nueva area productiva', function () {",
              "        pm.expect(respuesta.id_infraestructura).to.equal(Number(pm.collectionVariables.get('id_area_nueva')));",
              "    });",
              "    pm.test('TC-M09-G64: la nueva asociacion queda vigente (sin fecha de finalizacion)', function () {",
              "        pm.expect(respuesta.fecha_finalizacion).to.equal(null);",
              "    });",
              "",
              "    console.log('Nueva asociacion creada: id_sensores_area_asociada=' + respuesta.id_sensores_area_asociada + ', area=' + respuesta.id_infraestructura);",
              "} else {",
              "    postman.setNextRequest(null);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
