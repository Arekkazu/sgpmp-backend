    {
      "name": "Precondicion - Crear la asociacion original en el area de origen",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "console.log('--- Asociacion original (antes de la reasignacion) ---');",
              "console.log(pm.response.text());",
              "",
              "pm.test('Precondicion: la asociacion original responde HTTP 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "let respuesta;",
              "try { respuesta = pm.response.json(); } catch (e) { respuesta = null; }",
              "",
              "if (pm.response.code === 201 && respuesta) {",
              "    pm.collectionVariables.set('id_asociacion_original', respuesta.id_sensores_area_asociada);",
              "    console.log('Asociacion original creada: id_sensores_area_asociada=' + respuesta.id_sensores_area_asociada + ', area=' + respuesta.id_infraestructura);",
              "} else {",
              "    postman.setNextRequest(null);",
              "}"
            ]
          }
        }
      ],
