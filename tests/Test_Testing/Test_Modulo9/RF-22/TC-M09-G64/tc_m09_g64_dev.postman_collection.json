          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/configuracion/sensores/{{id_sensor}}/asociar",
          "host": [ "{{base_url}}" ],
          "path": [ "configuracion", "sensores", "{{id_sensor}}", "asociar" ]
        }
      },
      "response": []
    },
    {
      "name": "TC-M09-G64 - Verificar el cierre de la asociacion anterior y una unica activa en el historial",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "console.log('--- Historial completo de asociaciones del sensor tras la reasignacion ---');",
              "console.log(pm.response.text());",
              "",
              "pm.test('TC-M09-G64: el historial de asociaciones responde HTTP 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "let respuesta;",
              "try { respuesta = pm.response.json(); } catch (e) { respuesta = null; }",
              "",
              "if (pm.response.code === 200 && respuesta) {",
              "    const idOriginal = Number(pm.collectionVariables.get('id_asociacion_original'));",
              "    const idNueva = Number(pm.collectionVariables.get('id_asociacion_nueva'));",
              "    const items = respuesta.items || [];",
              "",
              "    pm.test('TC-M09-G64: el historial contiene ambas asociaciones (la original y la nueva)', function () {",
              "        pm.expect(items.length).to.be.at.least(2);",
              "    });",
              "",
              "    const original = items.find(function (a) { return a.id_sensores_area_asociada === idOriginal; });",
              "    const nueva = items.find(function (a) { return a.id_sensores_area_asociada === idNueva; });",
              "",
              "    pm.test('TC-M09-G64: la asociacion original quedo finalizada (fecha_finalizacion presente, tiene_estado=false)', function () {",
              "        pm.expect(original, 'no se encontro la asociacion original en el historial').to.not.equal(undefined);",
              "        pm.expect(original.fecha_finalizacion).to.not.equal(null);",
              "        pm.expect(original.tiene_estado).to.equal(false);",
              "    });",
              "",
              "    pm.test('TC-M09-G64: la asociacion nueva sigue vigente (sin fecha de finalizacion, tiene_estado=true)', function () {",
              "        pm.expect(nueva, 'no se encontro la nueva asociacion en el historial').to.not.equal(undefined);",
              "        pm.expect(nueva.fecha_finalizacion).to.equal(null);",
              "        pm.expect(nueva.tiene_estado).to.equal(true);",
              "    });",
              "",
              "    const activas = items.filter(function (a) { return a.fecha_finalizacion === null; });",
              "    pm.test('TC-M09-G64: se mantiene una unica asociacion activa para el sensor tras la reasignacion', function () {",
              "        pm.expect(activas.length).to.equal(1);",
              "    });",
              "",
              "    console.log('CONCLUSION: la reasignacion cerro correctamente la asociacion anterior (' + idOriginal + ') y dejo unicamente la nueva (' + idNueva + ') como activa.');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/configuracion/sensores/{{id_sensor}}/asociaciones",
          "host": [ "{{base_url}}" ],
          "path": [ "configuracion", "sensores", "{{id_sensor}}", "asociaciones" ]
        }
      },
      "response": []
    }
