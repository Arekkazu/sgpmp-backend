  "item": [
    {
      "name": "00-PRECHECK",
      "item": [
        {
          "name": "00.1 POST /sesiones (un solo login)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo_electronico\": \"{{correo}}\",\n  \"contrasena\": \"{{contrasena}}\"\n}"
            },
            "url": "{{baseUrl}}/sesiones/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const code = pm.response.code;",
                  "pm.collectionVariables.set('login_http', String(code));",
                  "let json = {};",
                  "try { json = pm.response.json(); } catch (e) { json = {}; }",
                  "pm.test('TC-G96 login HTTP 200 (un intento)', function () {",
                  "    pm.expect(code).to.eql(200);",
                  "});",
                  "if (code === 200 && json.token) {",
                  "    pm.collectionVariables.set('token', json.token);",
                  "    pm.collectionVariables.set('login_ok', '1');",
                  "} else {",
                  "    pm.collectionVariables.set('login_ok', '0');",
                  "    pm.collectionVariables.set('precheck_ok', '0');",
                  "    pm.collectionVariables.set('abort_reason', 'Login HTTP ' + code + ' — G96 BLOQUEADO, sin reintento ni PATCH');",
                  "    pm.execution.setNextRequest(null);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "00.2 GET dashboard (snapshot inicial)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/configuracion/personalizacion/dashboard"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.collectionVariables.get('login_ok') !== '1') { return; }",
                  "const code = pm.response.code;",
                  "pm.test('PRECHECK GET dashboard 200', function () { pm.expect(code).to.eql(200); });",
                  "if (code !== 200) {",
                  "    pm.collectionVariables.set('precheck_ok', '0');",
                  "    pm.collectionVariables.set('abort_reason', 'GET dashboard HTTP ' + code);",
                  "    pm.execution.setNextRequest(null);",
                  "    return;",
                  "}",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('snapshot_grid', JSON.stringify(json.grid || []));",
                  "pm.collectionVariables.set('snapshot_active', JSON.stringify(json.active_widget || []));",
                  "pm.collectionVariables.set('snapshot_version', json.version_perfil == null ? '' : String(json.version_perfil));",
                  "pm.collectionVariables.set('version_actual', json.version_perfil == null ? '' : String(json.version_perfil));",
                  "pm.test('PRECHECK snapshot tiene grid y active_widget', function () {",
                  "    pm.expect(json).to.have.property('grid');",
                  "    pm.expect(json).to.have.property('active_widget');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "00.3 GET widgets (catálogo dinámico)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/configuracion/personalizacion/dashboard/widgets"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.collectionVariables.get('login_ok') !== '1') { return; }",
                  "const code = pm.response.code;",
                  "pm.test('PRECHECK GET widgets 200', function () { pm.expect(code).to.eql(200); });",
                  "if (code !== 200) {",
                  "    pm.collectionVariables.set('precheck_ok', '0');",
                  "    pm.collectionVariables.set('abort_reason', 'GET widgets HTTP ' + code);",
                  "    pm.execution.setNextRequest(null);",
                  "    return;",
                  "}",
                  "const json = pm.response.json();",
                  "const widgets = Array.isArray(json) ? json : [];",
                  "pm.test('PRECHECK catálogo no vacío', function () {",
                  "    pm.expect(widgets.length, 'widgets autorizados').to.be.above(0);",
                  "});",
                  "if (!widgets.length) {",
                  "    pm.collectionVariables.set('precheck_ok', '0');",
                  "    pm.collectionVariables.set('abort_reason', 'Catálogo vacío: ningún widget autorizado');",
                  "    pm.execution.setNextRequest(null);",
                  "    return;",
                  "}",
                  "const a = widgets[0];",
                  "const b = widgets.length > 1 ? widgets[1] : widgets[0];",
                  "pm.collectionVariables.set('widget_id', String(a.id_widget));",
                  "pm.collectionVariables.set('widget_id_b', String(b.id_widget));",
                  "pm.collectionVariables.set('widget_clave', String(a.clave));",
                  "pm.collectionVariables.set('precheck_ok', '1');"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "TC-M09-184",
      "item": [
        {
          "name": "TC-M09-184 PATCH solapamiento misma celda",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const idA = parseInt(pm.collectionVariables.get('widget_id'), 10);",
                  "const idB = parseInt(pm.collectionVariables.get('widget_id_b'), 10);",
                  "const ver = pm.collectionVariables.get('version_actual');",
                  "const body = {",
                  "    layout_config: [",
                  "        { id_widget: idA, posicion_fila: 1, posicion_columna: 1, span_columnas: 1, visible: true, orden: 0 },",
                  "        { id_widget: idB, posicion_fila: 1, posicion_columna: 1, span_columnas: 1, visible: true, orden: 1 }",
                  "    ],",
                  "    active_widget: [pm.collectionVariables.get('widget_clave')]",
                  "};",
                  "if (ver) { body.version_perfil = parseInt(ver, 10); }",
                  "pm.request.body.update({ mode: 'raw', raw: JSON.stringify(body) });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.collectionVariables.get('precheck_ok') !== '1') { return; }",
                  "const code = pm.response.code;",
                  "let json = {};",
                  "try { json = pm.response.json(); } catch (e) { json = {}; }",
                  "pm.test('TC-M09-184 HTTP 409', function () { pm.expect(code).to.eql(409); });",
                  "pm.test('TC-M09-184 error_code SOLAPAMIENTO_WIDGETS', function () {",
                  "    pm.expect(json.error_code).to.eql('SOLAPAMIENTO_WIDGETS');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{baseUrl}}/configuracion/personalizacion/dashboard"
          }
        },
        {
          "name": "TC-M09-184 GET confirma snapshot intacto",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/configuracion/personalizacion/dashboard"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.collectionVariables.get('precheck_ok') !== '1') { return; }",
                  "function norm(grid) {",
                  "    return (grid || []).map(function (w) {",
                  "        return [w.id_widget, w.posicion_fila, w.posicion_columna, w.span_columnas, w.visible].join(':');",
                  "    }).sort();",
                  "}",
                  "const json = pm.response.json();",
                  "const snap = JSON.parse(pm.collectionVariables.get('snapshot_grid') || '[]');",
                  "const act = JSON.parse(pm.collectionVariables.get('snapshot_active') || '[]');",
                  "pm.test('TC-M09-184 GET 200', function () { pm.expect(pm.response.code).to.eql(200); });",
                  "pm.test('TC-M09-184 grid igual al snapshot (sin persistencia)', function () {",
                  "    pm.expect(norm(json.grid)).to.eql(norm(snap));",
                  "});",
                  "pm.test('TC-M09-184 active_widget igual al snapshot', function () {",
                  "    pm.expect(json.active_widget || []).to.eql(act);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
