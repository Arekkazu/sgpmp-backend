    {
      "name": "TC-M09-181",
      "item": [
        {
          "name": "TC-M09-181 PATCH grilla completa 4x3 (12 visibles span=1)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const idA = parseInt(pm.collectionVariables.get('widget_id'), 10);",
                  "const clave = pm.collectionVariables.get('widget_clave');",
                  "const ver = pm.collectionVariables.get('version_actual');",
                  "const layout = [];",
                  "let orden = 0;",
                  "for (let f = 1; f <= 3; f++) {",
                  "    for (let c = 1; c <= 4; c++) {",
                  "        layout.push({ id_widget: idA, posicion_fila: f, posicion_columna: c, span_columnas: 1, visible: true, orden: orden++ });",
                  "    }",
                  "}",
                  "const body = { layout_config: layout, active_widget: [clave] };",
                  "if (ver) { body.version_perfil = parseInt(ver, 10); }",
                  "pm.collectionVariables.set('layout_12', JSON.stringify(layout));",
                  "pm.request.body.update({ mode: 'raw', raw: JSON.stringify(body) });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.collectionVariables.get('precheck_ok') !== '1') { return; }",
                  "const code = pm.response.code;",
                  "let json = {};",
                  "try { json = pm.response.json(); } catch (e) { json = {}; }",
                  "pm.test('TC-M09-181 HTTP 200', function () { pm.expect(code).to.eql(200); });",
                  "if (code === 200) {",
                  "    pm.collectionVariables.set('mutacion_181', '1');",
                  "    if (json.version_perfil != null) {",
                  "        pm.collectionVariables.set('version_actual', String(json.version_perfil));",
                  "    }",
                  "    const visibles = (json.grid || []).filter(function (w) { return w.visible; });",
                  "    pm.test('TC-M09-181 grid tiene 12 visibles', function () {",
                  "        pm.expect(visibles.length).to.eql(12);",
                  "    });",
                  "    pm.test('TC-M09-181 filas 1-3, columnas 1-4, span=1, 12 celdas únicas', function () {",
                  "        const celdas = {};",
                  "        visibles.forEach(function (w) {",
                  "            pm.expect(w.posicion_fila).to.be.within(1, 3);",
                  "            pm.expect(w.posicion_columna).to.be.within(1, 4);",
                  "            pm.expect(w.span_columnas).to.eql(1);",
                  "            const k = w.posicion_fila + ',' + w.posicion_columna;",
                  "            pm.expect(celdas[k], 'celda duplicada ' + k).to.be.undefined;",
                  "            celdas[k] = true;",
                  "        });",
                  "        pm.expect(Object.keys(celdas).length).to.eql(12);",
                  "    });",
                  "} else {",
                  "    pm.collectionVariables.set('mutacion_181', '0');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{baseUrl}}/configuracion/personalizacion/dashboard"
          }
        }
