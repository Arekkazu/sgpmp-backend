                  "try { json = pm.response.json(); } catch (e) { json = {}; }",
                  "pm.test('TC-M09-186 POST /restaurar HTTP 200', function () { pm.expect(code).to.eql(200); });",
                  "if (code !== 200) {",
                  "    pm.collectionVariables.set('restaurar_ok', '0');",
                  "    pm.collectionVariables.set('abort_reason', 'POST restaurar HTTP ' + code + ' error_code=' + (json.error_code || ''));",
                  "    pm.execution.setNextRequest('99.1 GET version actual antes de restaurar snapshot');",
                  "    return;",
                  "}",
                  "pm.test('TC-M09-186 respuesta tiene grid y active_widget', function () {",
                  "    pm.expect(json).to.have.property('grid');",
                  "    pm.expect(json).to.have.property('active_widget');",
                  "});",
                  "const idRol = pm.collectionVariables.get('id_rol');",
                  "pm.test('TC-M09-186 rol conocido para comparar default', function () {",
                  "    pm.expect(idRol).to.eql('1');",
                  "});",
                  "if (idRol === '1') {",
                  "    const expectedGrid = [",
                  "        {id_widget:6,posicion_fila:1,posicion_columna:1,span_columnas:2,visible:true},",
                  "        {id_widget:9,posicion_fila:1,posicion_columna:3,span_columnas:1,visible:true},",
                  "        {id_widget:15,posicion_fila:1,posicion_columna:4,span_columnas:1,visible:true},",
                  "        {id_widget:14,posicion_fila:2,posicion_columna:1,span_columnas:2,visible:true},",
                  "        {id_widget:7,posicion_fila:2,posicion_columna:3,span_columnas:1,visible:true}",
                  "    ];",
                  "    const expectedActive = ['estado_iot','alertas_crit','cfg_pendiente','fincas_estado','cal_sensores'];",
                  "    pm.test('TC-M09-186 grid = default Admin rol 1', function () {",
                  "        pm.expect(normGrid(json.grid)).to.eql(normGrid(expectedGrid));",
                  "    });",
                  "    pm.test('TC-M09-186 active_widget = default Admin', function () {",
                  "        pm.expect(json.active_widget).to.eql(expectedActive);",
                  "    });",
                  "}",
                  "pm.collectionVariables.set('restaurar_ok', '1');",
                  "if (json.version_perfil != null) pm.collectionVariables.set('version_actual', String(json.version_perfil));"
                ]
              }
            }
          ]
        },
        {
          "name": "186.4 GET coincide con default tras restaurar",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/configuracion/personalizacion/dashboard"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.collectionVariables.get('restaurar_ok') !== '1') { return; }",
                  "function normGrid(grid) {",
                  "    return (grid || []).map(function (w) {",
                  "        return [w.id_widget, w.posicion_fila, w.posicion_columna, w.span_columnas, !!w.visible].join(':');",
                  "    }).sort();",
                  "}",
                  "const json = pm.response.json();",
                  "if (json.version_perfil != null) pm.collectionVariables.set('version_actual', String(json.version_perfil));",
                  "pm.test('TC-M09-186 GET 200 tras restaurar', function () { pm.expect(pm.response.code).to.eql(200); });",
                  "if (pm.collectionVariables.get('id_rol') === '1') {",
                  "    const expectedGrid = [",
                  "        {id_widget:6,posicion_fila:1,posicion_columna:1,span_columnas:2,visible:true},",
                  "        {id_widget:9,posicion_fila:1,posicion_columna:3,span_columnas:1,visible:true},",
                  "        {id_widget:15,posicion_fila:1,posicion_columna:4,span_columnas:1,visible:true},",
                  "        {id_widget:14,posicion_fila:2,posicion_columna:1,span_columnas:2,visible:true},",
                  "        {id_widget:7,posicion_fila:2,posicion_columna:3,span_columnas:1,visible:true}",
                  "    ];",
                  "    pm.test('TC-M09-186 GET grid = default Admin', function () {",
                  "        pm.expect(normGrid(json.grid)).to.eql(normGrid(expectedGrid));",
                  "    });",
                  "    pm.test('TC-M09-186 GET active_widget = default Admin', function () {",
                  "        pm.expect(json.active_widget).to.eql(['estado_iot','alertas_crit','cfg_pendiente','fincas_estado','cal_sensores']);",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
