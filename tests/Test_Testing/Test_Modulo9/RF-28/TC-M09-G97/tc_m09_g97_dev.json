                  "pm.test('TC-M09-188 GET B HTTP 200', function () { pm.expect(pm.response.code).to.eql(200); });",
                  "const m = (json.grid || []).find(function (w) {",
                  "    return w.visible && w.posicion_fila === 3 && w.posicion_columna === 4 && w.id_widget === idW && w.span_columnas === 1;",
                  "});",
                  "pm.test('TC-M09-188 persistencia: marcador presente en sesión B', function () {",
                  "    pm.expect(m).to.exist;",
                  "});",
                  "pm.test('TC-M09-188 persistencia: active_widget incluye clave del marcador', function () {",
                  "    pm.expect(json.active_widget || []).to.include(clave);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "99-RESTORE",
      "item": [
        {
          "name": "99.1 GET version actual antes de restaurar snapshot",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/configuracion/personalizacion/dashboard"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.collectionVariables.get('login_ok') !== '1') { return; }",
                  "pm.test('RESTORE pre-GET 200', function () { pm.expect(pm.response.code).to.eql(200); });",
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    if (json.version_perfil != null) pm.collectionVariables.set('version_actual', String(json.version_perfil));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "99.2 PATCH snapshot inicial (no POST /restaurar)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const grid = JSON.parse(pm.collectionVariables.get('snapshot_grid') || '[]');",
                  "const active = JSON.parse(pm.collectionVariables.get('snapshot_active') || '[]');",
                  "const body = { layout_config: grid, active_widget: active };",
                  "const ver = pm.collectionVariables.get('version_actual');",
                  "if (ver) { body.version_perfil = parseInt(ver, 10); }",
                  "pm.request.body.update({ mode: 'raw', raw: JSON.stringify(body) });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.collectionVariables.get('login_ok') !== '1') { return; }",
                  "const code = pm.response.code;",
                  "let json = {};",
                  "try { json = pm.response.json(); } catch (e) { json = {}; }",
                  "pm.test('RESTORE PATCH snapshot HTTP 200', function () { pm.expect(code).to.eql(200); });",
                  "if (code !== 200) {",
                  "    pm.collectionVariables.set('abort_reason', 'RESTORE PATCH HTTP ' + code + ' ' + (json.error_code || ''));",
                  "    pm.execution.setNextRequest(null);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{baseUrl}}/configuracion/personalizacion/dashboard"
          }
        },
        {
          "name": "99.3 GET verifica snapshot",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/configuracion/personalizacion/dashboard"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.collectionVariables.get('login_ok') !== '1') { return; }",
                  "function normGrid(grid) {",
                  "    return (grid || []).map(function (w) {",
                  "        return [w.id_widget, w.posicion_fila, w.posicion_columna, w.span_columnas, !!w.visible].join(':');",
                  "    }).sort();",
                  "}",
                  "const json = pm.response.json();",
                  "const snap = JSON.parse(pm.collectionVariables.get('snapshot_grid') || '[]');",
                  "const act = JSON.parse(pm.collectionVariables.get('snapshot_active') || '[]');",
                  "pm.test('RESTORE GET 200', function () { pm.expect(pm.response.code).to.eql(200); });",
                  "pm.test('RESTORE grid coincide con snapshot', function () {",
                  "    pm.expect(normGrid(json.grid)).to.eql(normGrid(snap));",
                  "});",
                  "pm.test('RESTORE active_widget coincide con snapshot', function () {",
                  "    pm.expect(json.active_widget || []).to.eql(act);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
