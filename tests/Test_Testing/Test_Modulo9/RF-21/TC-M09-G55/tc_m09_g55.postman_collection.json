{
  "info": {
    "name": "TC-M09-G55 - RF-21 camino feliz por categoria",
    "description": "RF-21 (matriz corregida, 2026-10-06). Ejecutado en TEST. Espera 201 con persistencia de atributos de CAMARA (resolucion, fps, area_cobertura_m2); la aserción de atributos falla si RF-21 v2.0 no está implementado.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('run')) pm.collectionVariables.set('run', String(Date.now()).slice(-6));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Login adm",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('login 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('tok_adm', pm.response.json().token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"admin@pecuaria.co\",\n  \"contrasena\": \"Test1234!\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/sesiones/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "sesiones",
            ""
          ]
        }
      }
    },
    {
      "name": "(a) Registrar SENSOR con es_activo=true",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const t0 = Date.now(); while (Date.now() - t0 < 6500) {}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test(\"HTTP 201\", () => { pm.response.to.have.status(201); });",
              "pm.test(\"es_activo true\", () => { pm.expect(j.es_activo).to.eql(true); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tok_adm}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/configuracion/dispositivos-iot",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "configuracion",
            "dispositivos-iot"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"serial\": \"QA-M09-G55-sen-{{run}}\", \"descripcion\": \"QA M09 G55 sen\", \"id_infraestructura\": 3, \"id_tipo_dispositivo\": 3, \"es_activo\": true}"
        }
      }
    },
    {
      "name": "(c) Registrar SENSOR sin es_activo",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const t0 = Date.now(); while (Date.now() - t0 < 6500) {}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test(\"HTTP 201\", () => { pm.response.to.have.status(201); });",
              "pm.test(\"activo por defecto = true\", () => { pm.expect(j.es_activo).to.eql(true); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tok_adm}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/configuracion/dispositivos-iot",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "configuracion",
            "dispositivos-iot"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"serial\": \"QA-M09-G55-sin-{{run}}\", \"descripcion\": \"QA M09 G55 sin\", \"id_infraestructura\": 3, \"id_tipo_dispositivo\": 3}"
        }
      }
    },
    {
      "name": "(b) Registrar CAMARA con resolucion, fps y area_cobertura_m2",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const t0 = Date.now(); while (Date.now() - t0 < 6500) {}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test(\"HTTP 201\", () => { pm.response.to.have.status(201); });",
              "pm.test(\"atributos de camara persistidos\", () => { pm.expect(j.resolucion).to.eql('1920x1080'); pm.expect(j.fps).to.eql(30); pm.expect(Number(j.area_cobertura_m2)).to.eql(50); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tok_adm}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/configuracion/dispositivos-iot",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "configuracion",
            "dispositivos-iot"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"serial\": \"QA-M09-G55-cam-{{run}}\", \"descripcion\": \"QA M09 G55 cam\", \"id_infraestructura\": 3, \"id_tipo_dispositivo\": 5, \"resolucion\": \"1920x1080\", \"fps\": 30, \"area_cobertura_m2\": 50, \"es_activo\": true}"
        }
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "https://sigab-backendtest-389pcb-a48238-158-69-200-27.sslip.io/api-sgpmp-test"
    },
    {
      "key": "tok_adm",
      "value": ""
    }
  ]
}