{
  "info": {
    "name": "TC-M09-G132 - RF-21 baja logica vs eliminacion fisica (parcial)",
    "description": "RF-21. Ejecutado en TEST. No hay endpoint DELETE para dispositivos (405 esperado). Parcial: sin dependencias reales (telemetría/alerta/sensor/historial) por no poder crearlas desde el API de dispositivos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('run')) pm.collectionVariables.set('run', String(Date.now()).slice(-6));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Login adm",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('login 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('tok_adm', pm.response.json().token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"admin@pecuaria.co\",\n  \"contrasena\": \"Test1234!\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/sesiones/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "sesiones",
            ""
          ]
        }
      }
    },
    {
      "name": "Setup - registrar dispositivo bj",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const t0 = Date.now(); while (Date.now() - t0 < 6500) {}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test(\"HTTP 201\", () => { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set('d1', j.id_dispositivo_iot);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tok_adm}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/configuracion/dispositivos-iot",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "configuracion",
            "dispositivos-iot"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"serial\": \"QA-M09-G132-bj-{{run}}\", \"descripcion\": \"QA M09 G132 bj\", \"id_infraestructura\": 3, \"id_tipo_dispositivo\": 3}"
        }
      }
    },
    {
      "name": "Eliminacion fisica -> 405",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test(\"HTTP 405\", () => { pm.response.to.have.status(405); });"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tok_adm}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/configuracion/dispositivos-iot/{{d1}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "configuracion",
            "dispositivos-iot",
            "{{d1}}"
          ]
        }
      }
    },
    {
      "name": "Baja logica (PATCH /desactivar) -> 200",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test(\"HTTP 200\", () => { pm.response.to.have.status(200); });",
              "pm.test(\"queda inactivo\", () => { pm.expect(j.es_activo).to.eql(false); });"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tok_adm}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/configuracion/dispositivos-iot/{{d1}}/desactivar",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "configuracion",
            "dispositivos-iot",
            "{{d1}}",
            "desactivar"
          ]
        }
      }
    },
    {
      "name": "El registro sigue existiendo tras la baja",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test(\"HTTP 200\", () => { pm.response.to.have.status(200); });",
              "pm.test(\"sigue inactivo\", () => { pm.expect(j.es_activo).to.eql(false); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tok_adm}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/configuracion/dispositivos-iot/{{d1}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "configuracion",
            "dispositivos-iot",
            "{{d1}}"
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "https://sigab-backendtest-389pcb-a48238-158-69-200-27.sslip.io/api-sgpmp-test"
    },
    {
      "key": "tok_adm",
      "value": ""
    }
  ]
}