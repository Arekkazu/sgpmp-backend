{
  "info": {
    "name": "TC-M09-G131-V2 - RF-21 precedencia del orden de validacion (parcial)",
    "description": "RF-21. Ejecutado en TEST solo para el escenario formato inválido + tipo inexistente -> 400 (matriz). Pendiente: serial duplicado + área inactiva (no hay área inactiva en TEST sin crear datos) y tipo inexistente + atributos de cámara faltantes (depende de CAMARA, §8.3).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('run')) pm.collectionVariables.set('run', String(Date.now()).slice(-6));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Login adm",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('login 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('tok_adm', pm.response.json().token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"admin@pecuaria.co\",\n  \"contrasena\": \"Test1234!\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/sesiones/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "sesiones",
            ""
          ]
        }
      }
    },
    {
      "name": "Serial de 51 caracteres + tipo inexistente -> 400 (formato primero)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const t0 = Date.now(); while (Date.now() - t0 < 6500) {}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test(\"HTTP 400\", () => { pm.response.to.have.status(400); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tok_adm}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/configuracion/dispositivos-iot",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "configuracion",
            "dispositivos-iot"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"serial\": \"CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC{{run}}\", \"descripcion\": \"QA M09 G131 prec\", \"id_infraestructura\": 3, \"id_tipo_dispositivo\": 9999}"
        }
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "https://sigab-backendtest-389pcb-a48238-158-69-200-27.sslip.io/api-sgpmp-test"
    },
    {
      "key": "tok_adm",
      "value": ""
    }
  ]
}