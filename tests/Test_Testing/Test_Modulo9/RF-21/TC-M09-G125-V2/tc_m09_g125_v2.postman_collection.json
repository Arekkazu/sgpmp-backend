          ],
          "path": [
            "configuracion",
            "dispositivos-iot"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"serial\": \"' OR '1'='1-{{run}}\", \"descripcion\": \"QA M09 G125 sqli\", \"id_infraestructura\": 3, \"id_tipo_dispositivo\": 3}"
        }
      }
