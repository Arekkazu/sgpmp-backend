        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test(\"HTTP 400\", () => { pm.response.to.have.status(400); });",
              "pm.test(\"error_code SERIAL_FORMATO_INVALIDO\", () => { pm.expect(j.error_code).to.eql('SERIAL_FORMATO_INVALIDO'); });"
