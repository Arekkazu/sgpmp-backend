              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test(\"HTTP 409\", () => { pm.response.to.have.status(409); });",
              "pm.test(\"error_code SERIAL_DUPLICADO\", () => { pm.expect(j.error_code).to.eql('SERIAL_DUPLICADO'); });"
