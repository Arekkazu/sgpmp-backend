    {
      "name": "Sincronizacion del registro encolado -> 409",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const t0 = Date.now(); while (Date.now() - t0 < 6500) {}"
