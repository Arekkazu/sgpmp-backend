{
  "info": {
    "name": "TC-M09-G57 - RF-21 identificador unico y consulta",
    "description": "RF-21 (matriz corregida). Ejecutado en TEST. Verifica que la consulta devuelve el tipo y que un SENSOR no muestra atributos de vision. La categoria derivada se espera en la respuesta (ficha G57).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('run')) pm.collectionVariables.set('run', String(Date.now()).slice(-6));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Login adm",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('login 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('tok_adm', pm.response.json().token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"admin@pecuaria.co\",\n  \"contrasena\": \"Test1234!\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/sesiones/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "sesiones",
            ""
          ]
        }
      }
    },
    {
      "name": "Setup - registrar dispositivo x1",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const t0 = Date.now(); while (Date.now() - t0 < 6500) {}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test(\"HTTP 201\", () => { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set('d1', j.id_dispositivo_iot);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tok_adm}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/configuracion/dispositivos-iot",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "configuracion",
            "dispositivos-iot"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"serial\": \"QA-M09-G57-x1-{{run}}\", \"descripcion\": \"QA M09 G57 x1\", \"id_infraestructura\": 3, \"id_tipo_dispositivo\": 3}"
        }
      }
    },
    {
      "name": "Setup - registrar dispositivo x2",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const t0 = Date.now(); while (Date.now() - t0 < 6500) {}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test(\"HTTP 201\", () => { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set('d2', j.id_dispositivo_iot);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tok_adm}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/configuracion/dispositivos-iot",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "configuracion",
            "dispositivos-iot"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"serial\": \"QA-M09-G57-x2-{{run}}\", \"descripcion\": \"QA M09 G57 x2\", \"id_infraestructura\": 3, \"id_tipo_dispositivo\": 3}"
        }
      }
    },
    {
      "name": "Consultar dispositivo 1",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test(\"HTTP 200\", () => { pm.response.to.have.status(200); });",
              "pm.test(\"id_tipo_dispositivo = 3\", () => { pm.expect(j.id_tipo_dispositivo).to.eql(3); });",
              "pm.test(\"SENSOR sin valores de vision\", () => { pm.expect(j.resolucion).to.be.null; pm.expect(j.fps).to.be.null; });",
              "pm.test(\"categoria derivada presente (ficha G57)\", () => { pm.expect(j.categoria).to.eql('SENSOR'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tok_adm}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/configuracion/dispositivos-iot/{{d1}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "configuracion",
            "dispositivos-iot",
            "{{d1}}"
          ]
        }
      }
    },
    {
      "name": "Consultar dispositivo 2 (identificador distinto)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test(\"HTTP 200\", () => { pm.response.to.have.status(200); });",
              "pm.test(\"id distinto del dispositivo 1\", () => { pm.expect(j.id_dispositivo_iot).to.not.eql(Number(pm.collectionVariables.get('d1'))); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tok_adm}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/configuracion/dispositivos-iot/{{d2}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "configuracion",
            "dispositivos-iot",
            "{{d2}}"
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "https://sigab-backendtest-389pcb-a48238-158-69-200-27.sslip.io/api-sgpmp-test"
    },
    {
      "key": "tok_adm",
      "value": ""
    }
  ]
}