              "",
              "console.log('8: ' + pm.response.code + ' ' + pm.response.text());",
              "pm.test('8 - version nueva creada (201)', function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) {",
              "    var body = pm.response.json();",
              "    pm.collectionVariables.set('id_plantilla_2', body.id_plantilla);",
              "    pm.test('8 - la nueva version es la version 2', function () { pm.expect(body.version).to.eql(2); });",
              "}",
              ""
            ]
          }
        }
