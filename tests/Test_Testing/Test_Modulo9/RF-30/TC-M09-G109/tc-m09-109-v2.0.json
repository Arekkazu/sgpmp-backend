        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "if (pm.response.code !== 200) {",
              "    console.log('7: fallo con ' + pm.response.code + ' ' + pm.response.text());",
              "    pm.test('7 - se pudo consultar la auditoria (requisito para esta verificacion)', function () { pm.response.to.have.status(200); });",
              "} else {",
              "    var data = pm.response.json();",
              "    var total1 = parseInt(pm.collectionVariables.get('total_auditoria_1'));",
              "    console.log('7: total auditoria tras intento fallido = ' + data.total + ' (antes del intento: ' + total1 + ')');",
              "",
              "    // Igual que arriba: esta asercion es lo que EXIGE la ficha. Rojo = el",
              "    // defecto sigue presente. Verde = ya se corrigio.",
              "    pm.test('TC-M09-G109 - el intento FALLIDO de creacion debe quedar registrado en auditoria', function () {",
              "        pm.expect(data.total, 'El total de auditoria no aumento tras el intento fallido -- los fallos no se estan registrando').to.be.above(total1);",
              "    });",
              "}",
              ""
            ]
          }
        }
      ]
    },
