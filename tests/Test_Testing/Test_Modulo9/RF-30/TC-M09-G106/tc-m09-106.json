{
  "info": {
    "name": "TC-M09-106 (TC-M09-203/204/205)",
    "description": "Inmutabilidad y versionado de plantillas de configuracion (RF-30/31). Adaptado a la implementacion real: no existe estado PUBLICADA ni endpoint de edicion -- 'modificar' es volver a crear con el mismo template_name, que el sistema convierte automaticamente en una nueva version. Requiere login previo (paso 0) con una cuenta que tenga permiso sobre el recurso 28 (plantillas). Ejecutar con: newman run tc-m09-106.json --reporters \"cli,htmlextra\" --reporter-htmlextra-export resultado-m09-106.html",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "https://sigab-backendtest-389pcb-a48238-158-69-200-27.sslip.io/api-sgpmp-test" },
    { "key": "correo_admin", "value": "admin.test@sgpmp.com.co" },
    { "key": "contrasena_admin", "value": "Administrador123#" },
    { "key": "token", "value": "" },
    { "key": "id_especie", "value": "" },
    { "key": "template_name", "value": "" },
    { "key": "id_plantilla_v1", "value": "" },
    { "key": "id_plantilla_v2", "value": "" }
  ],
  "item": [
    {
      "name": "0A. Login (obtener token)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "console.log('[LOGIN] status=' + pm.response.code + ' body=' + pm.response.text());",
        "pm.test('Login exitoso (200)', function () { pm.response.to.have.status(200); });",
        "if (pm.response.code === 200) {",
        "    pm.collectionVariables.set('token', pm.response.json().token);",
        "    console.log('Token obtenido OK');",
        "} else {",
        "    console.log('ATENCION: revisa correo_admin/contrasena_admin en las variables de la coleccion -- pueden estar desactualizados.');",
        "}"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"correo_electronico\": \"{{correo_admin}}\",\n  \"contrasena\": \"{{contrasena_admin}}\"\n}" },
        "url": "{{base_url}}/sesiones/"
      }
    },
    {
      "name": "0B. Obtener una especie activa (para usar como id_especie)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Responde 200', function () { pm.response.to.have.status(200); });",
        "var body = pm.response.json();",
        "pm.test('Hay al menos una especie activa', function () { pm.expect(body.items.length).to.be.above(0); });",
        "if (body.items && body.items.length > 0) {",
        "    pm.collectionVariables.set('id_especie', body.items[0].id_especie);",
        "    console.log('id_especie elegido: ' + body.items[0].id_especie + ' (' + (body.items[0].nombre || '') + ')');",
        "}"
      ] } }],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{base_url}}/configuracion/especies?solo_activas=true"
      }
    },
    {
      "name": "1. Crear plantilla version 1 (TC-M09-204 - punto de partida)",
      "event": [
        { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
          "pm.collectionVariables.set('template_name', 'QA-Inmutable-' + Date.now());"
        ] } },
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "pm.test('Se crea con 201', function () { pm.response.to.have.status(201); });",
          "var body = pm.response.json();",
          "pm.test('Version inicial es 1', function () { pm.expect(body.version).to.eql(1); });",
          "if (pm.response.code === 201) {",
          "    pm.collectionVariables.set('id_plantilla_v1', body.id_plantilla);",
          "    console.log('Plantilla v1 creada: id_plantilla=' + body.id_plantilla + ' version=' + body.version + ' template_name=' + pm.collectionVariables.get('template_name'));",
          "}"
        ] } }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
        "body": { "mode": "raw", "raw": "{\n  \"template_name\": \"{{template_name}}\",\n  \"id_especie\": {{id_especie}},\n  \"params_snapshot\": {\n    \"schema_version\": 1,\n    \"metricas_produccion\": [\n      { \"nombre\": \"peso_promedio_kg\", \"valor\": 1.2 }\n    ]\n  }\n}" },
        "url": "{{base_url}}/configuracion/plantillas"
      }
    },
    {
      "name": "2. TC-M09-203 - Intentar editar la plantilla v1 directamente (PUT)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('TC-M09-203: no debe existir forma de editar directamente (404 o 405, nunca 200)', function () {",
        "    pm.expect([404, 405]).to.include(pm.response.code);",
        "});"
      ] } }],
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
        "body": { "mode": "raw", "raw": "{\n  \"template_name\": \"intento-de-edicion-directa\",\n  \"id_especie\": {{id_especie}},\n  \"params_snapshot\": { \"schema_version\": 1, \"metricas_produccion\": [ { \"nombre\": \"peso_promedio_kg\", \"valor\": 9.9 } ] }\n}" },
        "url": "{{base_url}}/configuracion/plantillas/{{id_plantilla_v1}}"
      }
    },
    {
      "name": "3. TC-M09-203 - Intentar editar la plantilla v1 directamente (PATCH)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('TC-M09-203: no debe existir forma de editar directamente (404 o 405, nunca 200)', function () {",
        "    pm.expect([404, 405]).to.include(pm.response.code);",
        "});"
      ] } }],
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
        "body": { "mode": "raw", "raw": "{\n  \"template_name\": \"intento-de-edicion-directa\"\n}" },
        "url": "{{base_url}}/configuracion/plantillas/{{id_plantilla_v1}}"
      }
    },
    {
      "name": "4. TC-M09-204 - 'Modificar' = crear de nuevo con el mismo template_name (debe dar version 2)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Se crea con 201', function () { pm.response.to.have.status(201); });",
        "var body = pm.response.json();",
        "pm.test('TC-M09-204: la nueva version debe ser 2', function () { pm.expect(body.version).to.eql(2); });",
        "if (pm.response.code === 201) {",
        "    pm.collectionVariables.set('id_plantilla_v2', body.id_plantilla);",
        "    console.log('Plantilla v2 creada: id_plantilla=' + body.id_plantilla + ' version=' + body.version);",
        "}"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
        "body": { "mode": "raw", "raw": "{\n  \"template_name\": \"{{template_name}}\",\n  \"id_especie\": {{id_especie}},\n  \"params_snapshot\": {\n    \"schema_version\": 1,\n    \"metricas_produccion\": [\n      { \"nombre\": \"peso_promedio_kg\", \"valor\": 1.5 }\n    ]\n  }\n}" },
        "url": "{{base_url}}/configuracion/plantillas"
      }
    },
    {
      "name": "5. TC-M09-204 - Confirmar que la version 1 sigue intacta",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Responde 200', function () { pm.response.to.have.status(200); });",
        "var body = pm.response.json();",
        "pm.test('TC-M09-204: version 1 sigue existiendo con version=1 (no se sobrescribio)', function () {",
        "    pm.expect(body.version).to.eql(1);",
        "});",
        "pm.test('El snapshot de la version 1 NO cambio (peso_promedio_kg sigue en 1.2)', function () {",
        "    pm.expect(body.params_snapshot.metricas_produccion[0].valor).to.eql(1.2);",
        "});"
      ] } }],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{base_url}}/configuracion/plantillas/{{id_plantilla_v1}}"
      }
    },
    {
      "name": "6. TC-M09-205 - Crear una tercera vez (debe dar version 3, sin saltos ni reuso)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Se crea con 201', function () { pm.response.to.have.status(201); });",
        "var body = pm.response.json();",
        "pm.test('TC-M09-205: la version debe ser exactamente 3 (secuencia 1->2->3)', function () {",
        "    pm.expect(body.version).to.eql(3);",
        "});",
        "console.log('Secuencia final: v1=' + pm.collectionVariables.get('id_plantilla_v1') + ', v2=' + pm.collectionVariables.get('id_plantilla_v2') + ', v3=' + body.id_plantilla + ' (version ' + body.version + ')');"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
        "body": { "mode": "raw", "raw": "{\n  \"template_name\": \"{{template_name}}\",\n  \"id_especie\": {{id_especie}},\n  \"params_snapshot\": {\n    \"schema_version\": 1,\n    \"metricas_produccion\": [\n      { \"nombre\": \"peso_promedio_kg\", \"valor\": 1.8 }\n    ]\n  }\n}" },
        "url": "{{base_url}}/configuracion/plantillas"
      }
    }
  ]
}