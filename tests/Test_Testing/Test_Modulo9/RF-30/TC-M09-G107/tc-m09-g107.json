{
  "info": {
    "name": "TC-M09-G107 (TC-M09-206) - Prevencion de nombre de plantilla duplicado",
    "description": "CU-07 - Gestionar Plantillas de Configuracion - RF-30. Verifica que el sistema impida crear una plantilla con nombre duplicado (mismo template_name, misma especie y mismo params_snapshot que una ya existente), respondiendo 409 y sin dejar ningun registro duplicado en el listado.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "https://sigab-backendtest-389pcb-a48238-158-69-200-27.sslip.io/api-sgpmp-test" },
    { "key": "correo_admin", "value": "admin.test@sgpmp.com.co" },
    { "key": "contrasena_admin", "value": "Administrador123#" },
    { "key": "token_admin", "value": "" },
    { "key": "id_especie", "value": "" },
    { "key": "nombre_plantilla", "value": "" },
    { "key": "id_plantilla_original", "value": "" }
  ],
  "item": [
    {
      "name": "0A. Login admin.test",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/sesiones/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"{{correo_admin}}\",\n  \"contrasena\": \"{{contrasena_admin}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "console.log('[LOGIN] status=' + pm.response.code + ' body=' + pm.response.text());",
              "pm.test('Login exitoso (200)', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) { pm.collectionVariables.set('token_admin', pm.response.json().token); }"
            ]
          }
        }
      ]
    },
    {
      "name": "0B. Obtener una especie activa",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
        "url": "{{base_url}}/configuracion/especies?solo_activas=true"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "console.log('[ESPECIES] status=' + pm.response.code + ' body=' + pm.response.text());",
              "pm.test('Se obtiene el catalogo de especies activas (200)', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "const items = Array.isArray(body) ? body : (body.items || []);",
              "pm.test('Existe al menos una especie activa', function () { pm.expect(items.length).to.be.greaterThan(0); });",
              "if (items.length > 0) {",
              "  pm.collectionVariables.set('id_especie', items[0].id_especie);",
              "  pm.collectionVariables.set('nombre_plantilla', 'QA-G107-' + Date.now());",
              "  console.log('[ESPECIES] especie usada = ' + items[0].nombre + ' (id=' + items[0].id_especie + ')');",
              "  console.log('[ESPECIES] nombre de plantilla de prueba = ' + pm.collectionVariables.get('nombre_plantilla'));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "1. Crear la plantilla original",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_admin}}" }
        ],
        "url": "{{base_url}}/configuracion/plantillas",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"template_name\": \"{{nombre_plantilla}}\",\n  \"id_especie\": {{id_especie}},\n  \"params_snapshot\": {\n    \"ciclos_biologicos\": [\n      { \"nombre\": \"Etapa-G107\", \"descripcion\": \"Etapa de prueba TC-M09-G107\", \"duracion_dias\": 30 }\n    ]\n  }\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "console.log('[CREAR ORIGINAL] status=' + pm.response.code + ' body=' + pm.response.text());",
              "pm.test('Se crea la plantilla original (201)', function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) {",
              "  const body = pm.response.json();",
              "  pm.collectionVariables.set('id_plantilla_original', body.id_plantilla);",
              "  pm.test('La plantilla original queda en version 1', function () { pm.expect(body.version).to.eql(1); });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Intentar crear una plantilla duplicada (mismo nombre, misma especie, mismo snapshot)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_admin}}" }
        ],
        "url": "{{base_url}}/configuracion/plantillas",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"template_name\": \"{{nombre_plantilla}}\",\n  \"id_especie\": {{id_especie}},\n  \"params_snapshot\": {\n    \"ciclos_biologicos\": [\n      { \"nombre\": \"Etapa-G107\", \"descripcion\": \"Etapa de prueba TC-M09-G107\", \"duracion_dias\": 30 }\n    ]\n  }\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "console.log('[DUPLICADO] status=' + pm.response.code + ' body=' + pm.response.text());",
              "pm.test('Se rechaza el nombre duplicado (409)', function () { pm.response.to.have.status(409); });",
              "if (pm.response.code === 409) {",
              "  const body = pm.response.json();",
              "  pm.test('El error identifica el nombre duplicado', function () {",
              "    pm.expect(body.error_code || '').to.match(/DUPLICAD/i);",
              "  });",
              "  pm.test('La respuesta de rechazo no trae un id_plantilla nuevo', function () {",
              "    pm.expect(body.id_plantilla).to.be.undefined;",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Verificar que no quedo ningun duplicado en el listado",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
        "url": "{{base_url}}/configuracion/plantillas"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Se obtiene el listado de plantillas (200)', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "const items = Array.isArray(body) ? body : (body.items || []);",
              "const coincidencias = items.filter((p) => p.template_name === pm.collectionVariables.get('nombre_plantilla'));",
              "console.log('[LISTADO] coincidencias para \"' + pm.collectionVariables.get('nombre_plantilla') + '\": ' + coincidencias.length);",
              "pm.test('Existe exactamente UNA plantilla con ese nombre (no se creo un duplicado)', function () {",
              "  pm.expect(coincidencias.length).to.eql(1);",
              "});",
              "pm.test('La unica plantilla con ese nombre sigue siendo la original, en version 1', function () {",
              "  pm.expect(String(coincidencias[0].id_plantilla)).to.eql(String(pm.collectionVariables.get('id_plantilla_original')));",
              "  pm.expect(coincidencias[0].version).to.eql(1);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}