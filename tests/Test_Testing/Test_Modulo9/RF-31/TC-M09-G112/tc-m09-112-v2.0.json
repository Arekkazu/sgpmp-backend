        "url": "{{base_url}}/configuracion/plantillas"
      }
    },
    {
      "name": "4. TC-M09-216 v2.0 - Un umbral fuera del rango fisico real de la variable debe rechazarse (422)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "console.log('[TC-M09-216 v2.0] id_variable_ambiental=' + pm.collectionVariables.get('id_variable_real') + ' (confirmada=' + pm.collectionVariables.get('variable_confirmada') + ')');",
        "console.log('[TC-M09-216 v2.0] status=' + pm.response.code + ' body=' + pm.response.text());",
        "if (pm.response.code === 201) {",
        "    var b = pm.response.json();",
        "    console.log('DEFECTO SIGUE PRESENTE: se acepto un umbral con valor_min=-999/valor_max=999, fuera de cualquier rango fisico razonable (id_plantilla=' + b.id_plantilla + ').');",
        "}",
        "pm.test('TC-M09-216 v2.0 - un umbral con valores fuera del rango fisico real de la variable debe rechazarse con 422', function () {",
        "    pm.response.to.have.status(422);",
        "});",
        "if (pm.response.code === 422) {",
        "    var err = pm.response.json();",
        "    pm.test('TC-M09-216 v2.0 - el error trae el codigo RANGO_FISICO_INVALIDO', function () {",
        "        pm.expect(err.error_code).to.eql('RANGO_FISICO_INVALIDO');",
        "    });",
        "}"
      ] } }],
