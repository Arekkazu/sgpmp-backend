{
  "info": {
    "name": "RF-19 - TC-M09-G43 Edicion de una finca existente",
    "description": "Automatiza TC-M09-90: registra una finca, captura su estado 'antes', la edita con datos validos distintos (nombre, ubicacion, tamano_h) usando el fecha_actualizacion devuelto por el registro (FA-14), y compara ese estado 'antes' contra el estado 'despues' leido de forma independiente para confirmar que el cambio persistio.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "https://sigab-backendtest-389pcb-a48238-158-69-200-27.sslip.io/api-sgpmp-test" },
    { "key": "token_admin", "value": "" },
    { "key": "id_finca", "value": "" },
    { "key": "fecha_actualizacion_antes", "value": "" },
    { "key": "nombre_antes", "value": "" }
  ],
  "item": [
    {
      "name": "Paso 1 - Login Administrador",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login exitoso (200)', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.test('Respuesta contiene token', function () {",
              "    pm.expect(json.token).to.be.a('string').and.not.empty;",
              "});",
              "pm.collectionVariables.set('token_admin', json.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"admin@pecuaria.co\",\n  \"contrasena\": \"Test1234!\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{base_url}}/sesiones/", "host": ["{{base_url}}"], "path": ["sesiones", ""] }
      },
      "response": []
    },
    {
      "name": "Paso 2 - Registrar finca base (estado 'antes')",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const letras = 'abcdefghijklmnopqrstuvwxyz';",
              "let sufijo = '';",
              "for (let i = 0; i < 10; i++) sufijo += letras.charAt(Math.floor(Math.random() * letras.length));",
              "pm.collectionVariables.set('sufijo_unico', sufijo);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Finca base creada (201)', function () { pm.response.to.have.status(201); });",
              "const json = pm.response.json();",
              "console.log('Estado ANTES: ' + JSON.stringify(json));",
              "",
              "pm.collectionVariables.set('id_finca', json.id_finca);",
              "pm.collectionVariables.set('fecha_actualizacion_antes', json.fecha_actualizacion);",
              "pm.collectionVariables.set('nombre_antes', json.nombre);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_admin}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Finca Original {{sufijo_unico}}\",\n  \"ubicacion\": {\n    \"departamento\": \"Antioquia\",\n    \"municipio\": \"Medellin\",\n    \"vereda\": \"La Estrella\",\n    \"latitud\": \"6.25\",\n    \"longitud\": \"-75.56\"\n  },\n  \"tamano_h\": \"100.5\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{base_url}}/configuracion/fincas", "host": ["{{base_url}}"], "path": ["configuracion", "fincas"] }
      },
      "response": []
    },
    {
      "name": "TC-M09-90 - Editar la finca con datos validos distintos",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Edicion aceptada (200)', function () { pm.response.to.have.status(200); });",
              "",
              "const json = pm.response.json();",
              "console.log('Estado DESPUES (respuesta del PATCH): ' + JSON.stringify(json));",
              "",
              "pm.test('nombre cambio respecto al estado anterior', function () {",
              "    pm.expect(json.nombre).to.not.eql(pm.collectionVariables.get('nombre_antes'));",
              "    pm.expect(json.nombre).to.eql('Finca Editada ' + pm.collectionVariables.get('sufijo_unico'));",
              "});",
              "pm.test('ubicacion actualizada correctamente', function () {",
              "    pm.expect(json.ubicacion.departamento).to.eql('Cundinamarca');",
              "    pm.expect(json.ubicacion.municipio).to.eql('Bogota');",
              "    pm.expect(json.ubicacion.vereda).to.eql('El Rosal');",
              "    pm.expect(json.ubicacion.latitud).to.eql('4.60');",
              "    pm.expect(json.ubicacion.longitud).to.eql('-74.08');",
              "});",
              "pm.test('tamano_h actualizado correctamente', function () {",
              "    pm.expect(parseFloat(json.tamano_h)).to.eql(150.75);",
              "});",
              "pm.test('fecha_actualizacion rotada respecto al estado anterior', function () {",
              "    pm.expect(json.fecha_actualizacion).to.not.eql(pm.collectionVariables.get('fecha_actualizacion_antes'));",
              "});",
              "",
              "pm.collectionVariables.set('fecha_actualizacion_despues', json.fecha_actualizacion);"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_admin}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Finca Editada {{sufijo_unico}}\",\n  \"ubicacion\": {\n    \"departamento\": \"Cundinamarca\",\n    \"municipio\": \"Bogota\",\n    \"vereda\": \"El Rosal\",\n    \"latitud\": \"4.60\",\n    \"longitud\": \"-74.08\"\n  },\n  \"tamano_h\": \"150.75\",\n  \"fecha_actualizacion\": \"{{fecha_actualizacion_antes}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/configuracion/fincas/{{id_finca}}",
          "host": ["{{base_url}}"],
          "path": ["configuracion", "fincas", "{{id_finca}}"]
        }
      },
      "response": []
    },
    {
      "name": "Paso 4 - Releer la finca para confirmar la persistencia (comparacion antes/despues)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Detalle disponible (200)', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "console.log('Estado DESPUES (relectura independiente): ' + JSON.stringify(json));",
              "console.log('Comparacion -> nombre antes: \\'' + pm.collectionVariables.get('nombre_antes') + '\\', nombre despues: \\'' + json.nombre + '\\'');",
              "console.log('Comparacion -> fecha_actualizacion antes: ' + pm.collectionVariables.get('fecha_actualizacion_antes') + ', despues: ' + json.fecha_actualizacion);",
              "",
              "pm.test('Los datos editados persisten identicos a los devueltos por el PATCH', function () {",
              "    pm.expect(json.nombre).to.eql('Finca Editada ' + pm.collectionVariables.get('sufijo_unico'));",
              "    pm.expect(json.ubicacion.departamento).to.eql('Cundinamarca');",
              "    pm.expect(parseFloat(json.tamano_h)).to.eql(150.75);",
              "    pm.expect(json.fecha_actualizacion).to.eql(pm.collectionVariables.get('fecha_actualizacion_despues'));",
              "});",
              "pm.test('El nombre ya no es el original (comparacion antes/despues)', function () {",
              "    pm.expect(json.nombre).to.not.eql(pm.collectionVariables.get('nombre_antes'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
        "url": {
          "raw": "{{base_url}}/configuracion/fincas/{{id_finca}}",
          "host": ["{{base_url}}"],
          "path": ["configuracion", "fincas", "{{id_finca}}"]
        }
      },
      "response": []
    }
  ]
}
