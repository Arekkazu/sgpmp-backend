{
  "info": {
    "name": "RF-19 - TC-M09-G47 Auditoria de operaciones sobre fincas",
    "description": "Automatiza TC-M09-95: registra, edita y desactiva una finca, y confirma por API todo lo observable (200/201, valores reflejados, atribucion al id_usuario correcto) para cada una de las tres operaciones. Nota de alcance: modulo9.auditorias_fincas (donde cada use case -registrar/editar/desactivar- escribe CREATE/UPDATE/DEACTIVATE con snapshot antes/despues via AuditoriaFincaRepository) no tiene endpoint REST propio, igual que auditorias_configuraciones_globales en RF-18 (ver TC-M09-G37): el unico router de auditoria (/auditoria/) lee modulo1.eventos, tabla distinta que este flujo no usa. La verificacion puntual de las 3 filas de auditoria se hizo con SELECT directo en BD tras esta corrida (ver TC-M09-G47-resultados.md).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "https://sigab-backendtest-389pcb-a48238-158-69-200-27.sslip.io/api-sgpmp-test" },
    { "key": "token_admin", "value": "" },
    { "key": "id_usuario_admin", "value": "" },
    { "key": "id_finca", "value": "" }
  ],
  "item": [
    {
      "name": "Paso 1 - Login Administrador",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login exitoso (200)', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('token_admin', json.token);",
              "",
              "const payload = JSON.parse(atob(json.token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')));",
              "pm.collectionVariables.set('id_usuario_admin', String(payload.sub));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"admin@pecuaria.co\",\n  \"contrasena\": \"Test1234!\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{base_url}}/sesiones/", "host": ["{{base_url}}"], "path": ["sesiones", ""] }
      },
      "response": []
    },
    {
      "name": "TC-M09-95a - CREATE: registrar finca (debe auditarse)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const letras = 'abcdefghijklmnopqrstuvwxyz';",
              "let sufijo = '';",
              "for (let i = 0; i < 10; i++) sufijo += letras.charAt(Math.floor(Math.random() * letras.length));",
              "pm.collectionVariables.set('sufijo_unico', sufijo);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Finca creada (201)', function () { pm.response.to.have.status(201); });",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('id_finca', json.id_finca);",
              "pm.collectionVariables.set('fecha_actualizacion_previa', json.fecha_actualizacion);",
              "console.log('Finca creada para prueba de auditoria: id=' + json.id_finca);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_admin}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Finca Auditoria {{sufijo_unico}}\",\n  \"ubicacion\": {\n    \"departamento\": \"Antioquia\",\n    \"municipio\": \"Medellin\",\n    \"vereda\": \"La Estrella\",\n    \"latitud\": \"6.25\",\n    \"longitud\": \"-75.56\"\n  },\n  \"tamano_h\": \"10.0\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{base_url}}/configuracion/fincas", "host": ["{{base_url}}"], "path": ["configuracion", "fincas"] }
      },
      "response": []
    },
    {
      "name": "TC-M09-95b - UPDATE: editar la finca (debe auditarse)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Edicion aceptada (200)', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.test('tamano_h actualizado', function () { pm.expect(parseFloat(json.tamano_h)).to.eql(20); });",
              "pm.collectionVariables.set('fecha_actualizacion_post_edicion', json.fecha_actualizacion);"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_admin}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Finca Auditoria Editada {{sufijo_unico}}\",\n  \"ubicacion\": {\n    \"departamento\": \"Antioquia\",\n    \"municipio\": \"Medellin\",\n    \"vereda\": \"La Estrella\",\n    \"latitud\": \"6.25\",\n    \"longitud\": \"-75.56\"\n  },\n  \"tamano_h\": \"20.0\",\n  \"fecha_actualizacion\": \"{{fecha_actualizacion_previa}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/configuracion/fincas/{{id_finca}}",
          "host": ["{{base_url}}"],
          "path": ["configuracion", "fincas", "{{id_finca}}"]
        }
      },
      "response": []
    },
    {
      "name": "TC-M09-95c - DEACTIVATE: desactivar la finca (debe auditarse)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Desactivacion aceptada (200)', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.test('Queda inactiva', function () { pm.expect(json.es_activo).to.eql(false); });",
              "console.log('NOTA DE ALCANCE (gap): modulo9.auditorias_fincas no tiene endpoint REST. Verificacion manual con:');",
              "console.log(\"SELECT tipo_operacion, id_usuario, fecha_gestion FROM modulo9.auditorias_fincas WHERE id_finca = \" + pm.collectionVariables.get('id_finca') + \" ORDER BY fecha_gestion;\");",
              "console.log('Se esperan 3 filas: CREATE, UPDATE, DEACTIVATE, todas con id_usuario=' + pm.collectionVariables.get('id_usuario_admin') + '.');"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
        "url": {
          "raw": "{{base_url}}/configuracion/fincas/{{id_finca}}/desactivar",
          "host": ["{{base_url}}"],
          "path": ["configuracion", "fincas", "{{id_finca}}", "desactivar"]
        }
      },
      "response": []
    }
  ]
}
