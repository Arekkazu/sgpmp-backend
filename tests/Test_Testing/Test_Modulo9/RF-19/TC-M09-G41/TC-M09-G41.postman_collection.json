      },
      "response": []
    },
    {
      "name": "TC-M09-85c - Acepta nombre y ubicacion con formato valido (tildes y ene)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const letras = 'abcdefghijklmnopqrstuvwxyz';",
              "let sufijo = '';",
              "for (let i = 0; i < 10; i++) sufijo += letras.charAt(Math.floor(Math.random() * letras.length));",
              "pm.variables.set('sufijo_unico', sufijo);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Formato valido aceptado (201)', function () { pm.response.to.have.status(201); });",
              "const json = pm.response.json();",
              "console.log('Respuesta: ' + JSON.stringify(json));",
              "pm.test('Nombre con tildes/ene almacenado tal cual', function () {",
              "    pm.expect(json.nombre).to.eql('Finca Peñón Ácido ' + pm.variables.get('sufijo_unico'));",
              "});",
              "pm.test('Ubicacion con tildes/ene almacenada tal cual', function () {",
              "    pm.expect(json.ubicacion.municipio).to.eql('Cañón Bogotá');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_admin}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Finca Peñón Ácido {{sufijo_unico}}\",\n  \"ubicacion\": {\n    \"departamento\": \"Cundinamarca\",\n    \"municipio\": \"Cañón Bogotá\",\n    \"vereda\": \"La Estrella\",\n    \"latitud\": \"6.25\",\n    \"longitud\": \"-75.56\"\n  },\n  \"tamano_h\": \"10.0\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{base_url}}/configuracion/fincas", "host": ["{{base_url}}"], "path": ["configuracion", "fincas"] }
      },
      "response": []
    },
    {
      "name": "TC-M09-89a - Registrar finca base para la prueba de duplicado",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const letras = 'abcdefghijklmnopqrstuvwxyz';",
              "let sufijo = '';",
              "for (let i = 0; i < 10; i++) sufijo += letras.charAt(Math.floor(Math.random() * letras.length));",
              "pm.collectionVariables.set('sufijo_duplicado', sufijo);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Finca base creada (201)', function () { pm.response.to.have.status(201); });",
              "const json = pm.response.json();",
              "console.log('Respuesta: ' + JSON.stringify(json));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_admin}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Finca Duplicada {{sufijo_duplicado}}\",\n  \"ubicacion\": {\n    \"departamento\": \"Antioquia\",\n    \"municipio\": \"Medellin\",\n    \"vereda\": \"La Estrella\",\n    \"latitud\": \"6.25\",\n    \"longitud\": \"-75.56\"\n  },\n  \"tamano_h\": \"10.0\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{base_url}}/configuracion/fincas", "host": ["{{base_url}}"], "path": ["configuracion", "fincas"] }
      },
      "response": []
    },
    {
      "name": "TC-M09-89b - Rechaza segundo registro con el mismo nombre (case-insensitive)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Rechazado por duplicado (409)', function () { pm.response.to.have.status(409); });",
              "const json = pm.response.json();",
              "console.log('Respuesta: ' + JSON.stringify(json));",
              "pm.test('Codigo FINCA_DUPLICADA', function () {",
              "    pm.expect(json.error_code).to.eql('FINCA_DUPLICADA');",
              "});"
            ]
          }
        }
