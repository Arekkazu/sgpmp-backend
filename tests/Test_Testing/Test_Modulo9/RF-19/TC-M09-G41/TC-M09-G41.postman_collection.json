    {
      "name": "TC-M09-85b - Rechaza ubicacion con caracteres no permitidos (departamento con simbolos)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Rechazado por formato invalido (400)', function () { pm.response.to.have.status(400); });",
