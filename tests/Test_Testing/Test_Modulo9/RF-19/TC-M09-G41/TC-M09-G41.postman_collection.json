{
  "info": {
    "name": "RF-19 - TC-M09-G41 Validacion de campos y duplicados al registrar finca",
    "description": "Automatiza TC-M09-83 (nombre obligatorio), TC-M09-84 (estructura requerida de ubicacion), TC-M09-85 (formato de caracteres permitido/no permitido en nombre y ubicacion) y TC-M09-89 (unicidad de nombre). Todas son variantes de rechazo/aceptacion sobre POST /configuracion/fincas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "https://sigab-backendtest-389pcb-a48238-158-69-200-27.sslip.io/api-sgpmp-test" },
    { "key": "token_admin", "value": "" }
  ],
  "item": [
    {
      "name": "Paso 1 - Login Administrador",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login exitoso (200)', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.test('Respuesta contiene token', function () {",
              "    pm.expect(json.token).to.be.a('string').and.not.empty;",
              "});",
              "pm.collectionVariables.set('token_admin', json.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"admin@pecuaria.co\",\n  \"contrasena\": \"Test1234!\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{base_url}}/sesiones/", "host": ["{{base_url}}"], "path": ["sesiones", ""] }
      },
      "response": []
    },
    {
      "name": "TC-M09-83 - Rechaza registro sin nombre (vacio)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Rechazado por validacion (400)', function () { pm.response.to.have.status(400); });",
              "const json = pm.response.json();",
              "console.log('Respuesta: ' + JSON.stringify(json));",
              "pm.test('Codigo de error de validacion de entrada', function () {",
              "    pm.expect(json.error_code).to.eql('VAL_ENTRADA');",
              "});",
              "pm.test('Senala el campo nombre como faltante/invalido', function () {",
              "    pm.expect(json.fields.some(f => (f.field || '').includes('nombre'))).to.eql(true);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_admin}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"\",\n  \"ubicacion\": {\n    \"departamento\": \"Antioquia\",\n    \"municipio\": \"Medellin\",\n    \"vereda\": \"La Estrella\",\n    \"latitud\": \"6.25\",\n    \"longitud\": \"-75.56\"\n  },\n  \"tamano_h\": \"10.0\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{base_url}}/configuracion/fincas", "host": ["{{base_url}}"], "path": ["configuracion", "fincas"] }
      },
      "response": []
    },
    {
      "name": "TC-M09-84 - Rechaza ubicacion con estructura incompleta (falta vereda)",
      "event": [
