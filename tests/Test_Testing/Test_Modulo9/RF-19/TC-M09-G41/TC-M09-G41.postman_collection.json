        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Finca Ubicacion Invalida\",\n  \"ubicacion\": {\n    \"departamento\": \"Antioquia#1\",\n    \"municipio\": \"Medellin\",\n    \"vereda\": \"La Estrella\",\n    \"latitud\": \"6.25\",\n    \"longitud\": \"-75.56\"\n  },\n  \"tamano_h\": \"10.0\"\n}",
