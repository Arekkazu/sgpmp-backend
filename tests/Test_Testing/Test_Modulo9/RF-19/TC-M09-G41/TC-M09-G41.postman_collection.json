              "pm.test('Codigo de error de validacion de entrada', function () {",
              "    pm.expect(json.error_code).to.eql('VAL_ENTRADA');",
              "});",
              "pm.test('Senala el campo ubicacion.vereda como faltante', function () {",
              "    pm.expect(json.fields.some(f => (f.field || '').includes('vereda'))).to.eql(true);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_admin}}" }
