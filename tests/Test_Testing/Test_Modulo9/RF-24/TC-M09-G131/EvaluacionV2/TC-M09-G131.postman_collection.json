    {
      "name": "TC-M09-258 POST calibrar",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const iso = new Date().toISOString();",
              "pm.environment.set('fecha_258', iso);",
              "pm.environment.set('body_sent_258', pm.environment.get('body_258').replace('__FECHA__', iso));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Oraculo de la matriz: rechazo 4xx y ausencia de persistencia. RF-24 no fija codigo",
