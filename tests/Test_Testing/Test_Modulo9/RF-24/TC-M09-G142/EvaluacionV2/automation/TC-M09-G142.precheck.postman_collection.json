    {
      "name": "PRECHECK 09 · Especie AVES apta para el alta de lote",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{admin_session}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/configuracion/especies",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "configuracion/especies"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const cuerpo = () => { try { return pm.response.json(); } catch (e) { return {}; } };",
              "const b = cuerpo();",
              "pm.test('PRECHECK · especies consultables (200)', () => pm.expect(pm.response.code).to.eql(200));",
              "// El alta de un lote calcula su densidad inicial: la especie necesita",
              "// densidad_maxima_por_especie configurada en M09 o el POST M02 responde 422.",
              "const aptas = (b.items || []).filter(e => e.es_activo",
              "  && String(e.tipo_modelo) === 'MODELO_AVES'",
              "  && e.densidad_maxima_por_especie && Number(e.densidad_maxima_por_especie) > 0);",
              "pm.environment.set('especies_aptas', JSON.stringify(aptas.map(e => e.id_especie)));",
              "// La especie que se reporta debe ser la MISMA que impone la compuerta del runner, o el",
              "// precheck informa de una especie distinta de la que usara el RUN (en la ejecucion 2",
              "// decia 82, con 0 ciclos, mientras el RUN corria con la 78: confuso y sin motivo).",
              "const cualificada = String(pm.environment.get('especie_cualificada') || '').trim();",
              "const elegida = cualificada",
              "  ? (aptas.find(e => String(e.id_especie) === cualificada) || aptas[0])",
              "  : aptas[0];",
              "pm.environment.set('especie_id', elegida ? String(elegida.id_especie) : '');",
              "if (cualificada) {",
              "  pm.test('PRECHECK · la especie cualificada por la compuerta esta entre las aptas',",
              "    () => pm.expect(aptas.map(e => String(e.id_especie)), 'especies aptas')",
              "      .to.include(cualificada));",
              "}",
              "pm.test('PRECHECK · hay una especie AVES activa con densidad maxima (fixture potencial)',",
              "  () => pm.expect(aptas.length, 'especies AVES con densidad').to.be.above(0));"
            ]
          }
        }
      ]
    },
