{
  "info": {
    "name": "TC-M09-G142 — PRECHECK de solo lectura",
    "description": "Precheck previo al RUN oficial: comprueba OpenAPI, rutas M02/M03/M09 VISION y auditoria, autenticacion, permisos M02 del actor y el fixture potencial. No escribe nada: ningun POST funcional, ningun artefacto persistente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "PRECHECK 01 · OpenAPI de TEST",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/openapi.json",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "openapi.json"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const cuerpo = () => { try { return pm.response.json(); } catch (e) { return {}; } };",
              "const b = cuerpo();",
              "pm.test('PRECHECK · openapi.json disponible (200)', () => pm.expect(pm.response.code).to.eql(200));",
              "const paths = b.paths || {};",
              "const req = [[\"/activos-biologicos\", \"post\", \"M02 alta de activo\"], [\"/activos-biologicos/{id_activo}/cierre\", \"post\", \"M02 cierre de ciclo\"], [\"/activos-biologicos/{id_activo}/fases\", \"post\", \"M02 fases (setup del cierre)\"], [\"/iot/telemetria/vision\", \"post\", \"M03 observaciones VISION\"], [\"/configuracion/calibraciones-vision\", \"post\", \"M09 VISION calculo\"], [\"/configuracion/calibraciones-vision\", \"get\", \"M09 VISION historial\"], [\"/configuracion/calibraciones-vision/linea-base\", \"get\", \"M09 VISION linea base\"], [\"/auditoria/\", \"get\", \"RF-10 auditoria\"]];",
              "const faltan = [];",
              "req.forEach(function (r) { if (!paths[r[0]] || !paths[r[0]][r[1]]) faltan.push(r[1].toUpperCase() + ' ' + r[0]); });",
              "pm.environment.set('rutas_ausentes', JSON.stringify(faltan));",
              "pm.test('PRECHECK · estan las rutas M02, M03, M09 VISION y auditoria',",
              "  () => pm.expect(faltan, 'rutas ausentes').to.eql([]));"
            ]
          }
        }
      ]
    },
