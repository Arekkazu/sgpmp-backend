        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const cuerpo = () => { try { return pm.response.json(); } catch (e) { return {}; } };",
              "const b = cuerpo();",
              "pm.test('PRECHECK · permisos consultables (200)', () => pm.expect(pm.response.code).to.eql(200));",
              "const items = b.items || b.permisos || b || [];",
              "const m02 = (Array.isArray(items) ? items : []).filter(p => p.id_recurso === 29).map(p => p.id_accion);",
              "pm.environment.set('acciones_m02', JSON.stringify(m02.sort()));",
              "pm.test('PRECHECK · puede crear activos (recurso 29, accion 1)', () => pm.expect(m02).to.include(1));",
              "pm.test('PRECHECK · puede cerrar ciclo (recurso 29, accion 4)', () => pm.expect(m02).to.include(4));",
              "pm.test('PRECHECK · puede gestionar fases (recurso 29, accion 5)', () => pm.expect(m02).to.include(5));"
            ]
          }
        }
      ]
    },
