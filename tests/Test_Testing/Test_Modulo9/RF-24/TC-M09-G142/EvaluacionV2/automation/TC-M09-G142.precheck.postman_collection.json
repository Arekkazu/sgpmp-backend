          "raw": "{\"correo_electronico\": \"{{admin_correo}}\", \"contrasena\": \"{{admin_password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const cuerpo = () => { try { return pm.response.json(); } catch (e) { return {}; } };",
              "const b = cuerpo();",
              "pm.test('PRECHECK · el Administrador autentica (200)', () => pm.expect(pm.response.code).to.eql(200));",
              "pm.environment.set('admin_session', b.token || '');"
            ]
          }
        }
      ]
    },
