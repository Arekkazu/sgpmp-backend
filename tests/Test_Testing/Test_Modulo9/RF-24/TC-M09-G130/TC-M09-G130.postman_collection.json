{
  "info": {
    "name": "TC-M09-G130 — RF-24 v2.0 — Referencias a hardware inexistente",
    "description": "Verifica que RF-24 rechaza calibrar hardware inexistente. TC-M09-256: dispositivo inexistente en el body con un sensor real en la ruta. TC-M09-257: sensor inexistente en la ruta con un dispositivo real en el body. En ambos se exige HTTP 404 con el mensaje COMÚN de referencia del RF: un mensaje específico por entidad no es PASS aunque el código sea 404. Ninguno de los dos rechazos puede crear calibraciones. Si TC-256 persistiera una calibración, el RUN se detiene (STOP_ALL) y TC-257 no se ejecuta. El Administrador solo aparece en GET de precondición.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Login Ingeniero",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/sesiones/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"{{ing_email}}\",\n  \"contrasena\": \"{{ing_secret}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login del Ingeniero es exitoso (2xx)', () => pm.expect(pm.response.code).to.be.within(200, 299));",
              "pm.environment.set('ing_session', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Identidad Ingeniero",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{ing_session}}"
          }
        ],
        "url": "{{base_url}}/usuarios/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Perfil del Ingeniero responde 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));",
              "const b = pm.response.json();",
              "pm.test('El actor es Ingeniero de Campo', () => pm.expect(b.nombre_rol).to.eql('Ingeniero de Campo'));",
              "pm.test('La cuenta del Ingeniero esta activa', () => pm.expect(b.estado_cuenta).to.eql('Activo'));",
              "// id_usuario dinamico: no se hardcodea.",
              "pm.environment.set('ing_id', String(b.id_usuario));"
            ]
          }
        }
      ]
    },
    {
      "name": "Permisos Ingeniero",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{ing_session}}"
          }
        ],
        "url": "{{base_url}}/sesiones/me/permisos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Permisos responden 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));",
              "const it = pm.response.json().permisos || [];",
              "pm.test('El Ingeniero puede registrar calibraciones', () => pm.expect(it.some(p => p.id_recurso === 12 && p.id_accion === 1)).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "Login Administrador auxiliar",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/sesiones/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"{{admin_email}}\",\n  \"contrasena\": \"{{admin_secret}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Solo GET de precondicion. Los dos POST del caso los ejecuta el Ingeniero.",
              "pm.test('Login auxiliar de Administrador es exitoso (2xx)', () => pm.expect(pm.response.code).to.be.within(200, 299));",
              "pm.environment.set('admin_session', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Fixture dispositivo real",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_session}}"
          }
        ],
        "url": "{{base_url}}/configuracion/dispositivos-iot/{{device_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('El dispositivo real responde 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));",
              "const b = pm.response.json();",
              "pm.test('El dispositivo real del fixture existe', () => pm.expect(b.id_dispositivo_iot).to.eql(Number(pm.environment.get('device_id'))));",
              "pm.test('El dispositivo real esta activo', () => pm.expect(b.es_activo).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "Fixture sensor real del dispositivo",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{ing_session}}"
          }
        ],
        "url": "{{base_url}}/configuracion/dispositivos-iot/{{device_id}}/sensores"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Sensores responden 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));",
              "const sid = (x) => (x.id_sensor !== undefined ? x.id_sensor : x.id_sensores);",
              "const row = (pm.response.json().items || []).find(x => sid(x) === Number(pm.environment.get('sensor_id')));",
              "pm.test('El sensor real pertenece al dispositivo real', () => { pm.expect(row).to.exist; pm.expect(row.id_dispositivo_iot).to.eql(Number(pm.environment.get('device_id'))); });",
              "pm.test('El sensor real esta activo', () => pm.expect(row.es_activo).to.eql(true));",
              "pm.test('La categoria del sensor real es la esperada', () => pm.expect(row.categoria).to.eql(pm.environment.get('categoria')));"
            ]
          }
        }
      ]
    },
    {
      "name": "Fixture asociación vigente",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_session}}"
          }
        ],
        "url": "{{base_url}}/configuracion/sensores/{{sensor_id}}/asociaciones"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Asociaciones responden 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));",
              "const sid = (x) => (x.id_sensor !== undefined ? x.id_sensor : x.id_sensores);",
              "const row = (pm.response.json().items || []).find(x => x.tiene_estado === true && (x.fecha_finalizacion === null || x.fecha_finalizacion === undefined) && sid(x) === Number(pm.environment.get('sensor_id')) && x.id_dispositivo_iot === Number(pm.environment.get('device_id')) && x.id_infraestructura === Number(pm.environment.get('area_id')));",
              "pm.test('La asociacion del fixture esta vigente', () => pm.expect(row).to.exist);"
            ]
          }
        }
      ]
    },
    {
      "name": "Fixture rango de la categoría",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{ing_session}}"
          }
        ],
        "url": "{{base_url}}/configuracion/sensores/rangos-calibracion"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Rangos responden 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));",
              "const row = (pm.response.json().items || []).find(x => x.categoria === pm.environment.get('categoria'));",
              "pm.test('La categoria tiene rango publicado', () => pm.expect(row).to.exist);",
              "pm.test('El valor esta dentro del rango vigente', () => { const v = Number(pm.environment.get('valor')); pm.expect(v).to.be.above(Number(row.valor_min)); pm.expect(v).to.be.below(Number(row.valor_max)); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Confirmar dispositivo inexistente",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_session}}"
          }
        ],
        "url": "{{base_url}}/configuracion/dispositivos-iot/{{device_inexistente}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Se consulta con el Administrador a proposito: para el Ingeniero incluso un dispositivo",
              "// REAL responde 404 por alcance de finca, asi que su 404 no distinguiria 'no existe' de",
              "// 'fuera de alcance'. El Administrador ve todos los dispositivos, de modo que su 404 si",
              "// acredita inexistencia.",
              "pm.test('1. El ID de dispositivo elegido NO existe (404)', () => pm.expect(pm.response.code).to.eql(404));",
              "const b = pm.response.json();",
              "pm.environment.set('device_inexistente_error', JSON.stringify({ http: 404, error_code: b.error_code, message: b.message }));"
            ]
          }
        }
      ]
    },
    {
      "name": "Confirmar sensor inexistente (historial PRE)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{ing_session}}"
          }
        ],
        "url": "{{base_url}}/configuracion/sensores/{{sensor_inexistente}}/calibraciones"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('El historial del sensor inexistente responde 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));",
              "const b = pm.response.json();",
              "pm.test('1. El ID de sensor elegido no tiene calibraciones (total 0)', () => pm.expect(Number(b.total)).to.eql(0));",
              "pm.test('El historial del sensor inexistente viene vacio', () => pm.expect(b.items || []).to.eql([]));",
              "pm.environment.set('pre_257_total', String(b.total));",
              "pm.environment.set('pre_257_ids', JSON.stringify((b.items || []).map(x => x.id_calibracion)));"
            ]
          }
        }
      ]
    },
    {
      "name": "256 Historial PRE",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{ing_session}}"
          }
        ],
        "url": "{{base_url}}/configuracion/sensores/{{sensor_id}}/calibraciones"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Historial PRE de TC-256 responde 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));",
              "const b = pm.response.json();",
              "pm.environment.set('pre_256_total', String(b.total));",
              "pm.environment.set('pre_256_ids', JSON.stringify((b.items || []).map(x => x.id_calibracion)));"
            ]
          }
        }
      ]
    },
    {
      "name": "256 POST calibrar",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{ing_session}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/configuracion/sensores/{{sensor_id}}/calibrar",
        "body": {
          "mode": "raw",
          "raw": "{{body_sent_256}}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const iso = new Date().toISOString();",
              "pm.environment.set('fecha_256', iso);",
              "pm.environment.set('body_sent_256', pm.environment.get('body_256').replace('__FECHA__', iso));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('4. TC-M09-256 — el POST devuelve HTTP 404', () => pm.expect(pm.response.code).to.eql(404));",
              "const b = pm.response.json();",
              "const esperado = pm.environment.get('exp_msg');",
              "// RF-24 v2.0 exige el mensaje COMUN de referencia. Un mensaje especifico como",
              "// 'No existe un dispositivo IoT con ID 999999.' no es PASS aunque el HTTP sea 404.",
              "pm.test('5. TC-M09-256 — message coincide exactamente con el mensaje comun del RF', () => pm.expect(b.message).to.eql(esperado));",
              "if (b.error_code) console.log('TC-256 error_code obtenido: ' + b.error_code);",
              "pm.test('6. TC-M09-256 — la respuesta no devuelve id_calibracion', () => pm.expect(b.id_calibracion).to.be.undefined);"
            ]
          }
        }
      ]
    },
    {
      "name": "256 Historial POST",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{ing_session}}"
          }
        ],
        "url": "{{base_url}}/configuracion/sensores/{{sensor_id}}/calibraciones"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Historial POST de TC-256 responde 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));",
              "const b = pm.response.json();",
              "const ids = (b.items || []).map(x => x.id_calibracion);",
              "const pre = JSON.parse(pm.environment.get('pre_256_ids') || '[]');",
              "const nuevos = ids.filter(x => !pre.includes(x));",
              "pm.environment.set('post_256_total', String(b.total));",
              "pm.environment.set('post_256_ids', JSON.stringify(ids));",
              "pm.test('7. TC-M09-256 — el total del historial no cambia', () => pm.expect(Number(b.total)).to.eql(Number(pm.environment.get('pre_256_total'))));",
              "pm.test('8. TC-M09-256 — los IDs del historial son los mismos', () => pm.expect(ids.slice().sort()).to.eql(pre.slice().sort()));",
              "pm.test('TC-M09-256 — no se creo ninguna calibracion', () => pm.expect(nuevos).to.eql([]));",
              "if (nuevos.length) {",
              "  pm.environment.set('stop_all', 'SI');",
              "  pm.environment.set('stop_all_motivo', JSON.stringify({ caso: 'TC-M09-256', idsNuevos: nuevos, nota: 'una calibracion que debia rechazarse quedo persistida; no se ejecuta TC-257 hasta entender la contaminacion' }));",
              "  console.log('STOP_ALL: no se ejecuta TC-M09-257.');",
              "  postman.setNextRequest(null);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "257 POST calibrar",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{ing_session}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/configuracion/sensores/{{sensor_inexistente}}/calibrar",
        "body": {
          "mode": "raw",
          "raw": "{{body_sent_257}}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const iso = new Date().toISOString();",
              "pm.environment.set('fecha_257', iso);",
              "pm.environment.set('body_sent_257', pm.environment.get('body_257').replace('__FECHA__', iso));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('4. TC-M09-257 — el POST devuelve HTTP 404', () => pm.expect(pm.response.code).to.eql(404));",
              "const b = pm.response.json();",
              "const esperado = pm.environment.get('exp_msg');",
              "pm.test('5. TC-M09-257 — message coincide exactamente con el mensaje comun del RF', () => pm.expect(b.message).to.eql(esperado));",
              "if (b.error_code) console.log('TC-257 error_code obtenido: ' + b.error_code);",
              "pm.test('6. TC-M09-257 — la respuesta no devuelve id_calibracion', () => pm.expect(b.id_calibracion).to.be.undefined);"
            ]
          }
        }
      ]
    },
    {
      "name": "257 Historial POST del sensor inexistente",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{ing_session}}"
          }
        ],
        "url": "{{base_url}}/configuracion/sensores/{{sensor_inexistente}}/calibraciones"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('El historial del sensor inexistente responde 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));",
              "const b = pm.response.json();",
              "pm.test('7. TC-M09-257 — el historial del sensor inexistente sigue en total 0', () => pm.expect(Number(b.total)).to.eql(0));",
              "pm.test('TC-M09-257 — el historial del sensor inexistente sigue vacio', () => pm.expect(b.items || []).to.eql([]));",
              "pm.environment.set('post_257_total', String(b.total));",
              "pm.environment.set('post_257_ids', JSON.stringify((b.items || []).map(x => x.id_calibracion)));"
            ]
          }
        }
      ]
    }
  ]
}