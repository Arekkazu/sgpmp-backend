{
  "info": {
    "name": "TC-M09-G132 — RF-24 v2.0",
    "description": "El runner realiza GET PRE/POST, discovery y STOP_ALL; Newman envía un POST por variante.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [{
    "name": "Calibrar — variante seleccionada por el runner",
    "request": {
      "method": "POST",
      "header": [
        {"key":"Content-Type","value":"application/json"},
        {"key":"Authorization","value":"Bearer {{token}}"}
      ],
      "body": {"mode":"raw","raw":"{{body_json}}","options":{"raw":{"language":"json"}}},
      "url": "{{base_url}}/configuracion/sensores/{{sensor_id}}/calibrar"
    },
    "event": [{"listen":"test","script":{"type":"text/javascript","exec":[
      "var data = {}; try { data = pm.response.json(); } catch (e) {}",
      "if (pm.environment.get('expected_kind') === 'precision') {",
      "  pm.test('Éxito 2xx e id_calibracion', function () {",
      "    pm.expect(pm.response.code).to.be.within(200, 299);",
      "    pm.expect(data.id_calibracion).to.be.a('number');",
      "  });",
      "} else {",
      "  pm.test('HTTP 400 y mensaje exacto de formato', function () {",
      "    pm.expect(pm.response.code).to.eql(400);",
      "    pm.expect(data.message).to.eql(pm.environment.get('expected_message'));",
      "    pm.expect(data.id_calibracion).to.be.undefined;",
      "  });",
      "}"
    ]}}]
  }]
}
