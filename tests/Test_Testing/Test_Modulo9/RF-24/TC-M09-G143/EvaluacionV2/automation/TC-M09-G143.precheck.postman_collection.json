            "type": "text/javascript",
            "exec": [
              "const cuerpo = () => { try { return pm.response.json(); } catch (e) { return {}; } };",
              "const b = cuerpo();",
              "pm.test('PRECHECK · catalogo de tipos de evento (200)', () => pm.expect(pm.response.code).to.eql(200));",
              "const lista = Array.isArray(b) ? b : (b.items || []);",
              "const buscar = (n) => (lista.find(t => String(t.nombre).toUpperCase() === n) || {}).id_tipo_evento;",
              "const rechazada = buscar('CALIBRACION_RECHAZADA');",
              "const exitosa = buscar('CALIBRACION_EXITOSA');",
              "pm.environment.set('tipo_rechazada', rechazada ? String(rechazada) : '');",
              "pm.environment.set('tipo_exitosa', exitosa ? String(exitosa) : '');",
              "pm.test('PRECHECK · existe el tipo CALIBRACION_RECHAZADA en el catalogo',",
              "  () => pm.expect(rechazada, 'id de CALIBRACION_RECHAZADA').to.be.a('number'));"
            ]
          }
        }
