    {
      "name": "PRECHECK 09 · Especie AVES apta para el alta de lote",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{admin_session}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/configuracion/especies",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "configuracion/especies"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const cuerpo = () => { try { return pm.response.json(); } catch (e) { return {}; } };",
              "const b = cuerpo();",
              "pm.test('PRECHECK · especies (200)', () => pm.expect(pm.response.code).to.eql(200));",
              "// El alta de lote calcula la densidad inicial: la especie necesita",
              "// densidad_maxima_por_especie o M02 responde 422 DENSIDAD_MAXIMA_NO_CONFIGURADA.",
              "const aptas = (b.items || []).filter(e => e.es_activo",
              "  && String(e.tipo_modelo) === 'MODELO_AVES'",
              "  && e.densidad_maxima_por_especie && Number(e.densidad_maxima_por_especie) > 0);",
              "aptas.sort((x, y) => x.id_especie - y.id_especie);",
              "pm.environment.set('especies_aptas', JSON.stringify(aptas.map(e => e.id_especie)));",
              "pm.environment.set('especie_id', aptas.length ? String(aptas[0].id_especie) : '');",
              "pm.test('PRECHECK · hay especie AVES activa con densidad maxima',",
              "  () => pm.expect(aptas.length, 'especies AVES con densidad').to.be.above(0));"
            ]
          }
        }
      ]
    },
