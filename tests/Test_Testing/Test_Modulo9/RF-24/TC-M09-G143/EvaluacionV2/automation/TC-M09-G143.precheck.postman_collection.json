            "exec": [
              "const cuerpo = () => { try { return pm.response.json(); } catch (e) { return {}; } };",
              "const b = cuerpo();",
              "pm.test('PRECHECK · fincas del Ingeniero (200)', () => pm.expect(pm.response.code).to.eql(200));",
              "const ing = (b.items || []).filter(f => f.es_activo).map(f => f.id_finca);",
              "const adm = JSON.parse(pm.environment.get('fincas_admin') || '[]');",
              "const compartidas = ing.filter(f => adm.indexOf(f) >= 0);",
              "pm.environment.set('fincas_compartidas', JSON.stringify(compartidas));",
              "pm.environment.set('finca_id', compartidas.length ? String(compartidas.indexOf(163) >= 0 ? 163 : compartidas[0]) : '');",
              "pm.test('PRECHECK · hay finca QA en el alcance de los dos actores',",
              "  () => pm.expect(compartidas.length, 'fincas compartidas').to.be.above(0));"
            ]
          }
        }
