{
  "info": {
    "name": "TC-M09-G143 — PRECHECK de solo lectura",
    "description": "Precheck previo al RUN oficial: OpenAPI, rutas M02/M03/M09/auditoria, autenticacion de los dos actores, permisos, finca compartida, especie apta para el alta de lote y catalogo de tipos de evento RF-10. No escribe nada.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "PRECHECK 01 · OpenAPI de TEST",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/openapi.json",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "openapi.json"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const cuerpo = () => { try { return pm.response.json(); } catch (e) { return {}; } };",
              "const b = cuerpo();",
              "pm.test('PRECHECK · openapi.json disponible (200)', () => pm.expect(pm.response.code).to.eql(200));",
              "const paths = b.paths || {};",
              "const req = [[\"/activos-biologicos\", \"post\"], [\"/iot/telemetria/vision\", \"post\"], [\"/configuracion/calibraciones-vision\", \"post\"], [\"/configuracion/calibraciones-vision\", \"get\"], [\"/configuracion/calibraciones-vision/linea-base\", \"get\"], [\"/auditoria/\", \"get\"]];",
              "const faltan = [];",
              "req.forEach(r => { if (!paths[r[0]] || !paths[r[0]][r[1]]) faltan.push(r[1].toUpperCase() + ' ' + r[0]); });",
              "pm.environment.set('rutas_ausentes', JSON.stringify(faltan));",
              "pm.test('PRECHECK · estan las rutas M02, M03, M09 VISION y auditoria',",
              "  () => pm.expect(faltan, 'rutas ausentes').to.eql([]));"
            ]
          }
        }
      ]
    },
