        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const cuerpo = () => { try { return pm.response.json(); } catch (e) { return {}; } };",
              "const b = cuerpo();",
              "pm.test('PRECHECK · permisos del Administrador (200)', () => pm.expect(pm.response.code).to.eql(200));",
              "const items = b.items || b.permisos || b || [];",
              "const lista = Array.isArray(items) ? items : [];",
              "const de = (r) => lista.filter(p => p.id_recurso === r).map(p => p.id_accion).sort();",
              "pm.environment.set('admin_m02', JSON.stringify(de(29)));",
              "pm.environment.set('admin_infra', JSON.stringify(de(10)));",
              "pm.test('PRECHECK · el Administrador puede crear lotes (29.1)', () => pm.expect(de(29)).to.include(1));",
              "pm.test('PRECHECK · el Administrador puede crear areas (10.1)', () => pm.expect(de(10)).to.include(1));",
              "pm.test('PRECHECK · el Administrador puede crear dispositivos (11.1)', () => pm.expect(de(11)).to.include(1));"
            ]
          }
        }
      ]
