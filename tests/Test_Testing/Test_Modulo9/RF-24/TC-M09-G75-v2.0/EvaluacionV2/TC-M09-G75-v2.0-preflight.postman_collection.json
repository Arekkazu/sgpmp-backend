        "url": {
          "raw": "{{base_url}}/usuarios/me",
          "host": [
            "{{base_url}}/usuarios/me"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Permisos del Ingeniero",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Permisos responde 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));",
              "const ps = pm.response.json().permisos || [];",
              "const tiene = (r, a) => ps.some(x => x.id_recurso === r && x.id_accion === a);",
              "pm.test('Permiso de lectura de dispositivos (11,2)', () => pm.expect(tiene(11, 2)).to.eql(true));",
              "pm.test('Permiso de registro de calibraciones (12,1)', () => pm.expect(tiene(12, 1)).to.eql(true));",
              "pm.test('Permiso de consulta de historial (12,2)', () => pm.expect(tiene(12, 2)).to.eql(true));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{session_value}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/sesiones/me/permisos",
          "host": [
            "{{base_url}}/sesiones/me/permisos"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Dispositivo activo (Ingeniero)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Discovery corregido: el actor del caso intenta la lectura primero.",
              "pm.environment.set('disp_http_ingeniero', String(pm.response.code));",
              "if (pm.response.code >= 200 && pm.response.code <= 299) {",
              "  const b = pm.response.json();",
              "  pm.test('Dispositivo del fixture existe', () => pm.expect(b.id_dispositivo_iot).to.eql(Number(pm.environment.get('device_id'))));",
              "  pm.test('Dispositivo esta activo', () => pm.expect(b.es_activo).to.eql(true));",
              "  pm.test('Dispositivo leido por el Ingeniero de Campo', () => pm.expect(pm.response.code).to.be.within(200, 299));",
              "  pm.environment.set('disp_fuente', 'Ingeniero');",
              "  postman.setNextRequest('Sensores del dispositivo');",
              "} else {",
              "  // Sin alcance: no se marca fallo aqui; la lectura se delega al fallback de solo lectura.",
              "  pm.environment.set('disp_fuente', 'pendiente');",
              "  console.log('Dispositivo: el Ingeniero responde HTTP ' + pm.response.code + '; se intenta el fallback de Administrador.');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{session_value}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/configuracion/dispositivos-iot/{{device_id}}",
          "host": [
            "{{base_url}}/configuracion/dispositivos-iot/{{device_id}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Login Administrador auxiliar (fallback dispositivo)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Solo se ejecuta si el Ingeniero no tuvo alcance. Cuenta de solo lectura.",
              "pm.test('Login del Administrador auxiliar es exitoso (2xx)', () => pm.expect(pm.response.code).to.be.within(200, 299));",
              "const b = pm.response.json();",
              "pm.expect(b.token, 'token del Administrador').to.be.a('string').and.not.empty;",
              "pm.environment.set('admin_session', b.token);",
              "pm.environment.set('admin_fallback_usado', 'SI');"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
