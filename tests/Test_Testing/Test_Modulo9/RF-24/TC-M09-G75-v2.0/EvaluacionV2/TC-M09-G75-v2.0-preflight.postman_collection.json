    {
      "name": "Dispositivo activo (fallback Administrador)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Dispositivo responde 2xx con el fallback de Administrador', () => pm.expect(pm.response.code).to.be.within(200, 299));",
              "const b = pm.response.json();",
              "pm.test('Dispositivo del fixture existe', () => pm.expect(b.id_dispositivo_iot).to.eql(Number(pm.environment.get('device_id'))));",
              "pm.test('Dispositivo esta activo', () => pm.expect(b.es_activo).to.eql(true));",
              "pm.environment.set('disp_fuente', 'Administrador');",
              "pm.environment.set('disp_http_administrador', String(pm.response.code));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_session}}"
