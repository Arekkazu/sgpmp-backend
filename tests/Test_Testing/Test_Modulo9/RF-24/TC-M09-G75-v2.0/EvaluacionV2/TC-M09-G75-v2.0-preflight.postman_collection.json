          }
        }
      },
      "response": []
    },
    {
      "name": "Asociacion vigente del sensor (fallback Administrador)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Asociaciones responden 2xx con el fallback de Administrador', () => pm.expect(pm.response.code).to.be.within(200, 299));",
              "const sid = (x) => (x.id_sensor !== undefined ? x.id_sensor : x.id_sensores);",
              "const vigente = (x) => x.tiene_estado === true && (x.fecha_finalizacion === null || x.fecha_finalizacion === undefined);",
              "const row = (pm.response.json().items || []).find(x => vigente(x) && sid(x) === Number(pm.environment.get('sensor_id')) && x.id_dispositivo_iot === Number(pm.environment.get('device_id')) && x.id_infraestructura === Number(pm.environment.get('area_id')));",
              "pm.test('Asociacion sensor-dispositivo-area esta vigente', () => pm.expect(row).to.exist);",
              "pm.environment.set('asoc_fuente', 'Administrador');",
              "pm.environment.set('asoc_http_administrador', String(pm.response.code));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_session}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/configuracion/sensores/{{sensor_id}}/asociaciones",
          "host": [
            "{{base_url}}/configuracion/sensores/{{sensor_id}}/asociaciones"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Rango vigente de la categoria",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Rangos responde 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));",
              "const row = (pm.response.json().items || []).find(x => x.categoria === pm.environment.get('categoria'));",
              "pm.test('La categoria del caso tiene rango publicado', () => pm.expect(row).to.exist);",
              "pm.environment.set('range_min', String(row.valor_min));",
              "pm.environment.set('range_max', String(row.valor_max));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{session_value}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/configuracion/sensores/rangos-calibracion",
          "host": [
            "{{base_url}}/configuracion/sensores/rangos-calibracion"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Historial del sensor",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Historial responde 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));",
              "const items = pm.response.json().items || [];",
              "pm.test('El historial es consultable por el actor del caso', () => pm.expect(items).to.be.an('array'));",
              "// Las precondiciones del fixture quedan resueltas por el Ingeniero o por el fallback.",
              "pm.test('Precondicion de dispositivo resuelta', () => pm.expect(pm.environment.get('disp_fuente')).to.be.oneOf(['Ingeniero', 'Administrador']));",
              "pm.test('Precondicion de asociacion resuelta', () => pm.expect(pm.environment.get('asoc_fuente')).to.be.oneOf(['Ingeniero', 'Administrador']));",
              "// Persistencia de las calibraciones validas creadas por el RUN funcional oficial.",
              "const esperadas = String(pm.environment.get('ids_validas_del_run') || '').split(',').filter(Boolean).map(Number);",
              "for (const id of esperadas) {",
              "  pm.test('La calibracion ' + id + ' del RUN oficial sigue persistida', () => pm.expect(items.find(x => x.id_calibracion === id), 'id_calibracion ' + id).to.exist);",
              "}",
              "pm.environment.set('historial_total', String(pm.response.json().total));",
              "pm.environment.set('historial_ids', items.map(x => x.id_calibracion).join(','));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{session_value}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/configuracion/sensores/{{sensor_id}}/calibraciones",
          "host": [
            "{{base_url}}/configuracion/sensores/{{sensor_id}}/calibraciones"
          ]
        }
      },
      "response": []
    }
  ]
