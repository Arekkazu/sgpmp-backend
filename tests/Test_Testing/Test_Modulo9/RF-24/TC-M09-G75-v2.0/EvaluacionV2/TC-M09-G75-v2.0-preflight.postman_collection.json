        "url": {
          "raw": "{{base_url}}/configuracion/dispositivos-iot/{{device_id}}",
          "host": [
            "{{base_url}}/configuracion/dispositivos-iot/{{device_id}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Sensores del dispositivo",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Sensores del dispositivo responden 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));",
              "const sid = (x) => (x.id_sensor !== undefined ? x.id_sensor : x.id_sensores);",
              "const row = (pm.response.json().items || []).find(x => sid(x) === Number(pm.environment.get('sensor_id')));",
              "pm.test('Sensor del fixture pertenece al dispositivo', () => { pm.expect(row).to.exist; pm.expect(row.id_dispositivo_iot).to.eql(Number(pm.environment.get('device_id'))); });",
              "pm.test('Sensor esta activo', () => pm.expect(row.es_activo).to.eql(true));",
              "pm.test('Sensor es de la categoria del caso', () => pm.expect(row.categoria).to.eql(pm.environment.get('categoria')));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{session_value}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/configuracion/dispositivos-iot/{{device_id}}/sensores",
          "host": [
            "{{base_url}}/configuracion/dispositivos-iot/{{device_id}}/sensores"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Asociacion vigente del sensor (Ingeniero)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set('asoc_http_ingeniero', String(pm.response.code));",
              "const sid = (x) => (x.id_sensor !== undefined ? x.id_sensor : x.id_sensores);",
              "const vigente = (x) => x.tiene_estado === true && (x.fecha_finalizacion === null || x.fecha_finalizacion === undefined);",
              "if (pm.response.code >= 200 && pm.response.code <= 299) {",
              "  const row = (pm.response.json().items || []).find(x => vigente(x) && sid(x) === Number(pm.environment.get('sensor_id')) && x.id_dispositivo_iot === Number(pm.environment.get('device_id')) && x.id_infraestructura === Number(pm.environment.get('area_id')));",
              "  pm.test('Asociacion sensor-dispositivo-area esta vigente', () => pm.expect(row).to.exist);",
              "  pm.test('Asociaciones leidas por el Ingeniero de Campo', () => pm.expect(pm.response.code).to.be.within(200, 299));",
              "  pm.environment.set('asoc_fuente', 'Ingeniero');",
              "  postman.setNextRequest('Rango vigente de la categoria');",
              "} else {",
              "  pm.environment.set('asoc_fuente', 'pendiente');",
              "  console.log('Asociaciones: el Ingeniero responde HTTP ' + pm.response.code + '; se intenta el fallback de Administrador.');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{session_value}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/configuracion/sensores/{{sensor_id}}/asociaciones",
          "host": [
            "{{base_url}}/configuracion/sensores/{{sensor_id}}/asociaciones"
          ]
        }
      },
      "response": []
