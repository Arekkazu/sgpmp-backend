{
  "info": {
    "name": "TC-M09-G133 — RF-24 v2.0",
    "description": "El runner selecciona exactamente un request Newman por POST y reconcilia el historial por API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "TC-M09-264 Administrador",
      "request": {
        "method": "POST",
        "header": [
          {"key":"Content-Type","value":"application/json"},
          {"key":"Authorization","value":"Bearer {{token}}"}
        ],
        "body": {"mode":"raw","raw":"{{body_json}}","options":{"raw":{"language":"json"}}},
        "url": "{{base_url}}/configuracion/sensores/{{sensor_id}}/calibrar"
      },
      "event": [{"listen":"test","script":{"type":"text/javascript","exec":[
        "pm.test('Administrador: 2xx e id_calibracion', function () {",
        "  pm.expect(pm.response.code).to.be.within(200, 299);",
        "  pm.expect(pm.response.json().id_calibracion).to.be.a('number');",
        "});"
      ]}}]
    },
    {
      "name": "TC-M09-263/A Sin Authorization",
      "request": {
        "method": "POST",
        "header": [{"key":"Content-Type","value":"application/json"}],
        "body": {"mode":"raw","raw":"{{body_json}}","options":{"raw":{"language":"json"}}},
        "url": "{{base_url}}/configuracion/sensores/{{sensor_id}}/calibrar"
      },
      "event": [{"listen":"test","script":{"type":"text/javascript","exec":[
        "pm.test('Sin Authorization: rechazo 4xx', function () {",
        "  pm.expect(pm.response.code).to.be.within(400, 499);",
        "});"
      ]}}]
    },
    {
      "name": "TC-M09-263/B Token de sesión cerrada",
      "request": {
        "method": "POST",
        "header": [
          {"key":"Content-Type","value":"application/json"},
          {"key":"Authorization","value":"Bearer {{token}}"}
        ],
        "body": {"mode":"raw","raw":"{{body_json}}","options":{"raw":{"language":"json"}}},
        "url": "{{base_url}}/configuracion/sensores/{{sensor_id}}/calibrar"
      },
      "event": [{"listen":"test","script":{"type":"text/javascript","exec":[
        "pm.test('Token cerrado: rechazo 4xx', function () {",
        "  pm.expect(pm.response.code).to.be.within(400, 499);",
        "});"
      ]}}]
    }
  ]
}
