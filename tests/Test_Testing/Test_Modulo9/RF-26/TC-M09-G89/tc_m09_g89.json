{
  "info": {
    "_postman_id": "tc-m09-g89-rf26",
    "name": "TC-M09-G89 - Auditoría de cambios de identidad visual",
    "description": "Verificar que una modificación de identidad visual realizada por un Administrador quede registrada en auditoría con información de trazabilidad.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://sigab-backendtest-389pcb-a48238-158-69-200-27.sslip.io/api-sgpmp-test"
    },
    {
      "key": "id_finca",
      "value": "10"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "version",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Login Administrador",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"admin@pecuaria.co\",\n  \"contrasena\": \"Test1234!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/sesiones/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "sesiones",
            ""
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login exitoso', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "",
              "pm.test('Token recibido', function () {",
              "    pm.expect(json.token).to.exist;",
              "});",
              "",
              "pm.collectionVariables.set('token', json.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Consultar identidad visual antes del cambio",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/configuracion/identidad-visual/{{id_finca}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "configuracion",
            "identidad-visual",
            "{{id_finca}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Consulta de identidad visual exitosa', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "",
              "if (json.version !== undefined && json.version !== null) {",
              "    pm.collectionVariables.set('version', String(json.version));",
              "    console.log('Versión anterior:', json.version);",
              "}",
              "",
              "console.log('Identidad visual anterior:', JSON.stringify(json));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Modificar identidad visual",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"primary_color\": \"#224466\",\n  \"secondary_color\": \"#FFFFFF\",\n  \"org_display_name\": \"Organizacion Auditoria G89\",\n  \"version\": {{version}}\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/configuracion/identidad-visual/{{id_finca}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "configuracion",
            "identidad-visual",
            "{{id_finca}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Modificación de identidad visual exitosa', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "",
              "if (json.version !== undefined && json.version !== null) {",
              "    pm.collectionVariables.set('version', String(json.version));",
              "}",
              "",
              "console.log('Identidad visual modificada:', JSON.stringify(json));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Consultar auditoría del cambio",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auditoria/?pagina=1&tamano=50",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auditoria",
            ""
          ],
          "query": [
            {
              "key": "pagina",
              "value": "1"
            },
            {
              "key": "tamano",
              "value": "50"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Consulta de auditoría exitosa', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "const items = Array.isArray(json.items) ? json.items : [];",
              "",
              "console.log('Total registros de auditoría:', json.total);",
              "console.log('Registros consultados:', items.length);",
              "",
              "const relacionados = items.filter(item => {",
              "    const texto = JSON.stringify(item).toLowerCase();",
              "    return texto.includes('identidad') ||",
              "           texto.includes('visual') ||",
              "           texto.includes('configuracion');",
              "});",
              "",
              "console.log('Registros relacionados con identidad/configuración:', relacionados.length);",
              "console.log('Registros relacionados:', JSON.stringify(relacionados));",
              "",
              "pm.test('Existe registro de auditoría relacionado con identidad visual', function () {",
              "    pm.expect(relacionados.length).to.be.greaterThan(0);",
              "});",
              "",
              "if (relacionados.length > 0) {",
              "    const evento = relacionados[0];",
              "",
              "    pm.test('Registro contiene fecha/hora', function () {",
              "        pm.expect(evento.fecha_evento).to.exist;",
              "    });",
              "",
              "    pm.test('Registro contiene usuario', function () {",
              "        pm.expect(evento.id_usuario).to.exist;",
              "    });",
              "",
              "    pm.test('Registro contiene resultado de operación', function () {",
              "        pm.expect(evento.resultado).to.exist;",
              "    });",
              "",
              "    pm.test('Registro contiene módulo o detalle', function () {",
              "        pm.expect(evento.modulo || evento.detalle || evento.descripcion).to.exist;",
              "    });",
              "",
              "    console.log('Evento de auditoría encontrado:', JSON.stringify(evento));",
              "}"
            ]
          }
        }
      ]
    }
  ]
}