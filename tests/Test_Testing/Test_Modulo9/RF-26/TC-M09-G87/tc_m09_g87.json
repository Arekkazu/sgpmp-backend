{
  "info": {
    "_postman_id": "tc-m09-g87-rf26",
    "name": "TC-M09-G87 - Restricción de rol RF-26",
    "description": "Validar que un usuario no administrador no pueda modificar la identidad visual.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://sigab-backendtest-389pcb-a48238-158-69-200-27.sslip.io/api-sgpmp-test"
    },
    {
      "key": "id_finca",
      "value": "10"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Login usuario no administrador",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"ingeniero@pecuaria.co\",\n  \"contrasena\": \"Pruebas12#\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/sesiones/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "sesiones",
            ""
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login exitoso', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "pm.test('Token recibido', function () {",
              "    pm.expect(json.token).to.exist;",
              "});",
              "",
              "pm.collectionVariables.set('token', json.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "TC-M09-G87 - Intentar modificar identidad visual como Ingeniero",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"primary_color\": \"#112233\",\n  \"secondary_color\": \"#FFFFFF\",\n  \"org_display_name\": \"Intento no autorizado G87\",\n  \"version\": 1\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/configuracion/identidad-visual/{{id_finca}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "configuracion",
            "identidad-visual",
            "{{id_finca}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Acceso no administrador rechazado', function () {",
              "    pm.response.to.have.status(403);",
              "});",
              "",
              "const responseText = pm.response.text();",
              "",
              "pm.test('La respuesta indica acceso denegado', function () {",
              "    pm.expect(responseText).to.match(/ACCESO_DENEGADO|Acceso denegado|no tiene permisos/i);",
              "});",
              "",
              "console.log('Respuesta RBAC:', responseText);"
            ]
          }
        }
      ]
    }
  ]
}