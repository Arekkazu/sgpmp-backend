    {
      "name": "TC161 - Aceptar logotipo PNG válido",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "const farms = await new Promise((resolve, reject) => {",
              "  pm.sendRequest({",
              "    url: pm.variables.replaceIn('{{baseUrl}}') + '/configuracion/fincas',",
              "    method: 'GET',",
              "    header: { Authorization: 'Bearer ' + pm.variables.get('token') }",
              "  }, (err, res) => err ? reject(err) : resolve(res));",
              "});",
              "if (farms.code !== 200) throw new Error('No se pudo consultar fincas. HTTP ' + farms.code);",
              "const data = farms.json();",
              "const ids = (data.items || data.fincas || data.data || []).map(x => String(x.id_finca ?? x.id ?? '')).filter(Boolean);",
              "",
              "let chosen = null;",
              "for (const id of ids) {",
              "  const r = await new Promise((resolve, reject) => {",
              "    pm.sendRequest({",
              "      url: pm.variables.replaceIn('{{baseUrl}}') + '/configuracion/identidad-visual/' + id,",
              "      method: 'GET',",
              "      header: { Authorization: 'Bearer ' + pm.variables.get('token') }",
              "    }, (err, res) => err ? reject(err) : resolve(res));",
              "  });",
              "  if (r.code === 200 && (r.text().trim() === 'null' || r.text().trim() === '')) {",
              "    chosen = id;",
              "    break;",
              "  }",
              "}",
              "if (!chosen) throw new Error('No se encontró una finca sin identidad visual disponible.');",
              "pm.variables.set('id_finca_actual', chosen);",
              "console.log('Finca seleccionada: ' + chosen);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "pm.test('PNG válido aceptado', () => pm.expect([200,201]).to.include(pm.response.code));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/configuracion/identidad-visual/{{id_finca_actual}}",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "id_finca",
              "value": "{{id_finca_actual}}",
              "type": "text"
            },
            {
              "key": "primary_color",
              "value": "#3A7BD5",
              "type": "text"
            },
            {
              "key": "secondary_color",
              "value": "#FFFFFF",
              "type": "text"
            },
            {
              "key": "org_display_name",
              "value": "Organizacion G86 PNG",
              "type": "text"
            },
            {
              "key": "logo",
