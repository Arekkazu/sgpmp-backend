    { "key": "version", "value": "1" },
    { "key": "logo_path_ok", "value": "" },
    { "key": "nombre_ok", "value": "" }
  ],
  "item": [
    {
      "name": "00 - Login Admin",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"{{correo}}\",\n  \"contrasena\": \"{{contrasena}}\"\n}"
        },
        "url": { "raw": "{{base_url}}/sesiones/", "host": ["{{base_url}}"], "path": ["sesiones", ""] }
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Login HTTP 200', function () { pm.response.to.have.status(200); });",
            "const json = pm.response.json();",
            "pm.test('JWT presente', function () { pm.expect(json.token).to.be.a('string').and.not.empty; });",
            "if (json.token) { pm.collectionVariables.set('token', json.token); }"
          ]
        }
      }]
    },
    {
      "name": "00b - GET baseline identidad finca",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{base_url}}/configuracion/identidad-visual/{{finca_id}}",
          "host": ["{{base_url}}"],
          "path": ["configuracion", "identidad-visual", "{{finca_id}}"]
        }
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('GET baseline HTTP 200', function () { pm.response.to.have.status(200); });",
            "const json = pm.response.json();",
            "pm.test('Finca 6 tiene identidad aislable (no POST; fincas 1-5 ocupadas)', function () {",
            "    pm.expect(json).to.be.an('object');",
            "    pm.expect(json.id_finca).to.eql(parseInt(pm.collectionVariables.get('finca_id'), 10));",
            "    pm.expect(json.version).to.be.a('number');",
            "});",
            "if (json && json.version != null) {",
            "    pm.collectionVariables.set('version', String(json.version));",
            "    pm.collectionVariables.set('id_identidad_visual', String(json.id_identidad_visual));",
            "    pm.collectionVariables.set('restore_logo', json.logo_path || '');",
            "    pm.collectionVariables.set('restore_name', json.org_display_name || '');",
            "    pm.collectionVariables.set('restore_primary', json.primary_color || '');",
            "    pm.collectionVariables.set('restore_secondary', json.secondary_color || '');",
            "    pm.collectionVariables.set('logo_path_ok', json.logo_path || '');",
            "    pm.collectionVariables.set('nombre_ok', json.org_display_name || '');",
            "}"
          ]
        }
      }]
    },
    {
      "name": "161 - PATCH PNG válido",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "primary_color", "value": "{{primary_color}}", "type": "text" },
            { "key": "secondary_color", "value": "{{secondary_color}}", "type": "text" },
            { "key": "org_display_name", "value": "{{org_display_name}}", "type": "text" },
            { "key": "version", "value": "{{version}}", "type": "text" },
            { "key": "logo", "type": "file", "src": "logo.png" }
          ]
        },
        "url": {
          "raw": "{{base_url}}/configuracion/identidad-visual/{{finca_id}}",
          "host": ["{{base_url}}"],
          "path": ["configuracion", "identidad-visual", "{{finca_id}}"]
        }
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('161 PNG HTTP 200', function () { pm.response.to.have.status(200); });",
            "pm.test('161 sin traceback', function () {",
            "    const b = pm.response.text().toLowerCase();",
            "    pm.expect(b).to.not.include('traceback');",
            "});",
            "if (pm.response.code === 200) {",
            "    const json = pm.response.json();",
            "    const idFinca = parseInt(pm.collectionVariables.get('finca_id'), 10);",
            "    pm.test('161 campos y logo_path PNG', function () {",
            "        pm.expect(json.id_identidad_visual).to.be.a('number');",
            "        pm.expect(json.id_finca).to.eql(idFinca);",
            "        pm.expect(json.primary_color).to.eql('#3A7BD5');",
            "        pm.expect(json.secondary_color).to.eql('#FFFFFF');",
            "        pm.expect(json.org_display_name).to.eql(pm.collectionVariables.get('org_display_name'));",
            "        pm.expect(json.logo_path).to.be.a('string').and.include('.png');",
            "    });",
            "    pm.collectionVariables.set('version', String(json.version));",
            "    pm.collectionVariables.set('id_identidad_visual', String(json.id_identidad_visual));",
            "    pm.collectionVariables.set('logo_path_ok', json.logo_path);",
            "}"
          ]
        }
      }]
