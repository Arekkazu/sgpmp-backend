          "raw": "{{base_url}}/configuracion/identidad-visual/{{finca_id}}",
          "host": ["{{base_url}}"],
          "path": ["configuracion", "identidad-visual", "{{finca_id}}"]
        }
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Restore nombre HTTP 200', function () { pm.response.to.have.status(200); });",
            "if (pm.response.code === 200) {",
            "    const json = pm.response.json();",
            "    pm.test('Restore org_display_name', function () {",
            "        pm.expect(json.org_display_name).to.eql('QA G86 Finca Para Test Gap');",
            "        pm.expect(json.primary_color).to.eql('#3A7BD5');",
            "    });",
            "}"
          ]
        }
      }]
