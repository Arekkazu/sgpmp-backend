              "key": "primary_color",
              "value": "#3A7BD5",
              "type": "text"
            },
            {
              "key": "secondary_color",
              "value": "#FFFFFF",
              "type": "text"
            },
            {
              "key": "org_display_name",
              "value": "Organizacion Prueba",
              "type": "text"
            },
            {
              "key": "logo",
              "type": "file",
              "src": "./logo.png"
            }
          ]
