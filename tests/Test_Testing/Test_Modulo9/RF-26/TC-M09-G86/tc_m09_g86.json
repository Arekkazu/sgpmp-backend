        "url": {
          "raw": "{{base_url}}/configuracion/identidad-visual",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "configuracion",
            "identidad-visual"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('PNG válido aceptado', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "var json = pm.response.json();",
              "pm.expect(json).to.have.property('id_identidad_visual');",
              "pm.expect(json.id_finca).to.eql(84);",
              "pm.expect(json.logo_path).to.exist;",
              "pm.expect(json.primary_color).to.eql('#3A7BD5');",
              "pm.expect(json.secondary_color).to.eql('#FFFFFF');",
              "pm.expect(json.org_display_name).to.eql('Organizacion Prueba');",
              "pm.collectionVariables.set('version', json.version);"
            ]
          }
        }
      ]
