    {
      "name": "3. Sub-caso 3: Error Longitud <3 caracteres (2 caracteres)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Sub-caso 3: Debe rechazar nombre < 3 caracteres (400 Bad Request)', function () {",
              "    pm.response.to.have.status(400);",
              "    const response = pm.response.json();",
              "    pm.expect(response.error_code).to.eql('VAL_ENTRADA');",
              "    const fieldErr = response.fields.find(f => f.field === 'nombre');",
              "    pm.expect(fieldErr).to.exist;",
              "    pm.expect(fieldErr.message).to.include('El nombre debe tener entre 3 y 50 caracteres.');",
              "});"
            ]
          }
        }
