    {
      "name": "2. Sub-caso 2: Éxito Límite Superior (50 caracteres)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// baseStr = 40 chars exactamente + 10 random = 50 chars totales",
              "const baseStr = 'EspecieProductivaParaPruebasDeControlQui';",
              "let randSuffix = '';",
              "for (let i = 0; i < 10; i++) {",
              "    randSuffix += String.fromCharCode(97 + Math.floor(Math.random() * 26));",
              "}",
              "const nombreMax = baseStr + randSuffix;",
              "pm.collectionVariables.set('espMaximo', nombreMax);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code !== 201) {",
              "    console.log('[Sub-caso 2 LOG] Response Code:', pm.response.code, 'Body:', pm.response.text());",
              "}",
              "pm.test('Sub-caso 2: Debe registrar especie con 50 caracteres (201 Created)', function () {",
              "    pm.response.to.have.status(201);",
              "    const response = pm.response.json();",
              "    pm.expect(response.id_especie).to.be.a('number');",
              "    pm.expect(response.es_activo).to.be.true;",
              "    pm.expect(response.nombre.length).to.eql(50);",
              "    pm.collectionVariables.set('idEspecieMaxima', response.id_especie);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
