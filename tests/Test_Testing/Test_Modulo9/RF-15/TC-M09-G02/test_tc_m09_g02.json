    {
      "name": "1. Sub-caso 1: Éxito Límite Inferior (3 caracteres)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const l1 = String.fromCharCode(65 + Math.floor(Math.random() * 26));",
              "const l2 = String.fromCharCode(97 + Math.floor(Math.random() * 26));",
              "const l3 = String.fromCharCode(97 + Math.floor(Math.random() * 26));",
              "const nombreMin = l1 + l2 + l3;",
              "pm.collectionVariables.set('espMinimo', nombreMin);",
              "pm.collectionVariables.set('espMinimoUpper', nombreMin.toUpperCase());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code !== 201) {",
              "    console.log('[Sub-caso 1 LOG] Response Code:', pm.response.code, 'Body:', pm.response.text());",
              "}",
              "pm.test('Sub-caso 1: Debe registrar especie con 3 caracteres (201 Created)', function () {",
              "    pm.response.to.have.status(201);",
              "    const response = pm.response.json();",
              "    pm.expect(response.id_especie).to.be.a('number');",
              "    pm.expect(response.es_activo).to.be.true;",
              "    pm.expect(response.nombre).to.eql(pm.collectionVariables.get('espMinimo'));",
              "    pm.collectionVariables.set('idEspecieMinima', response.id_especie);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
