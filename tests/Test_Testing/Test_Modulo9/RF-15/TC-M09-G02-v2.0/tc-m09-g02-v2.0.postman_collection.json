    {
      "name": "NW-01-Login-Admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Variables de entorno de Postman al INICIO antes de cualquier aserción",
              "if (pm.environment.get('baseUrl')) { pm.collectionVariables.set('baseUrl', pm.environment.get('baseUrl')); }",
              "if (pm.environment.get('email')) { pm.collectionVariables.set('email', pm.environment.get('email')); }",
              "if (pm.environment.get('password')) { pm.collectionVariables.set('password', pm.environment.get('password')); }",
              "",
              "pm.test('NW-01: Autenticación exitosa del Administrador (HTTP 200)', function () {",
              "    pm.response.to.have.status(200);",
              "    var data = pm.response.json();",
              "    pm.expect(data).to.have.property('token');",
              "    pm.expect(data.token).to.be.a('string').and.not.empty;",
              "    pm.collectionVariables.set('token', data.token);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"{{email}}\",\n  \"contrasena\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/sesiones/",
          "host": ["{{baseUrl}}"],
          "path": ["sesiones", ""]
        }
      }
    },
    {
      "name": "NW-02-Preflight-Especies",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var token = pm.collectionVariables.get('token');",
              "if (!token) {",
              "    pm.test('NW-02: FALLA dependiente de NW-01 (Sin token de sesión)', function () {",
              "        pm.expect.fail('No se obtuvo token de sesión en NW-01');",
              "    });",
              "} else {",
              "    pm.test('NW-02: Preflight exitoso y verificación de fixture (HTTP 200)', function () {",
              "        pm.response.to.have.status(200);",
              "        var data = pm.response.json();",
              "        pm.expect(data).to.have.property('items');",
              "        var items = data.items;",
              "        ",
              "        var sub6Existente = pm.collectionVariables.get('sub6_existente').toLowerCase();",
              "        var encontradoFixture = items.some(function(i) { return (i.nombre || '').toLowerCase() === sub6Existente; });",
              "        pm.expect(encontradoFixture, 'El fixture Cachama Blanca debe existir en TEST').to.be.true;",
              "        ",
              "        var sub1 = pm.collectionVariables.get('sub1').toLowerCase();",
              "        var encontradoSub1 = items.some(function(i) { return (i.nombre || '').toLowerCase() === sub1; });",
              "        pm.expect(encontradoSub1, 'El nombre Oca debe estar libre previo a la prueba').to.be.false;",
              "        ",
              "        var sub2 = pm.collectionVariables.get('sub2').toLowerCase();",
              "        var encontradoSub2 = items.some(function(i) { return (i.nombre || '').toLowerCase() === sub2; });",
              "        pm.expect(encontradoSub2, 'El nombre de 50 chars debe estar libre previo a la prueba').to.be.false;",
              "    });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/configuracion/especies?solo_activas=false",
          "host": ["{{baseUrl}}"],
          "path": ["configuracion", "especies"],
          "query": [
            { "key": "solo_activas", "value": "false" }
          ]
        }
      }
