              "    pm.test('NW-03: FALLA dependiente de NW-01 (Sin token)', function () { pm.expect.fail('NW-01 falló'); });",
              "} else {",
              "    pm.test('NW-03: Registro exitoso con nombre de 3 caracteres (HTTP 201)', function () {",
              "        pm.response.to.have.status(201);",
              "        var data = pm.response.json();",
              "        pm.expect(data).to.have.property('id_especie');",
              "        pm.expect(data).to.have.property('nombre');",
              "        pm.expect(data.nombre.toLowerCase()).to.eql(pm.collectionVariables.get('sub1').toLowerCase());",
              "        pm.expect(data.es_activo).to.be.true;",
              "        pm.collectionVariables.set('id_sub1', data.id_especie);",
              "    });",
              "}"
