            "type": "text/javascript",
            "exec": [
              "pm.test('Autenticación exitosa', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "const token = json.token || json.access_token || json.accessToken;",
              "",
              "pm.test('El login retorna un JWT', function () {",
              "    pm.expect(token, 'No se encontró el JWT en la respuesta').to.be.a('string').and.not.empty;",
              "});",
              "",
              "if (token) {",
              "    pm.collectionVariables.set('token', token);",
              "}"
            ]
          }
        }
      ]
