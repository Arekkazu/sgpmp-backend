          ]
        },
        "description": "Consulta el contexto de interfaz de RF-25. El escenario de prueba contempla un JWT con rol inexistente. La variable rolInexistente documenta el valor utilizado para dicho escenario."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('El backend no debe conceder permisos incorrectos', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([401, 403]);",
              "});",
              "",
              "pm.test('No debe exponer información interna', function () {",
              "    const body = pm.response.text().toLowerCase();",
              "    pm.expect(body).not.to.include('traceback');",
              "    pm.expect(body).not.to.include('stack trace');",
              "    pm.expect(body).not.to.include('internal server error');",
              "});"
            ]
          }
        }
      ]
