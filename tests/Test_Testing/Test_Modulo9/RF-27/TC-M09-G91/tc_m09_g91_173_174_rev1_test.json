        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const code = pm.response.code;",
              "let json = {};",
              "try { json = pm.response.json(); } catch (e) { json = {}; }",
              "if (code === 200 && json.token) {",
              "  pm.collectionVariables.set('token_productor', json.token);",
              "  pm.collectionVariables.set('login_productor_ok', '1');",
              "} else {",
              "  pm.collectionVariables.set('login_productor_ok', '0');",
              "}",
              "pm.test('173 login productor HTTP 200 (un intento)', function () { pm.expect(code).to.eql(200); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
