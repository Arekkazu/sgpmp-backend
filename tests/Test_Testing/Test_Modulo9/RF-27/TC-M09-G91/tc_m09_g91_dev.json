  "item": [
    {
      "name": "00.1 POST /sesiones (un solo login admin)",
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "const code = pm.response.code;",
            "pm.collectionVariables.set('login_http', String(code));",
            "let json = {};",
            "try { json = pm.response.json(); } catch (e) { json = {}; }",
            "if (code !== 200 || !json.token) {",
            "    pm.collectionVariables.set('login_ok', '0');",
            "    pm.collectionVariables.set('abort_reason', 'Login HTTP ' + code + ' — G91 BLOQUEADO, sin cascada 401 ni PATCH');",
            "    pm.collectionVariables.set('tc173', 'BLOQUEADO');",
            "    pm.collectionVariables.set('tc174', 'BLOQUEADO');",
            "    pm.collectionVariables.set('tc175', 'BLOQUEADO');",
            "    pm.test('Login HTTP 200 (si 500, BLOQUEADO; no se interpretan 401 siguientes)', function () {",
            "        pm.expect(code).to.eql(200);",
            "    });",
            "    pm.execution.setNextRequest(null);",
            "    return;",
            "}",
            "pm.collectionVariables.set('token', json.token);",
            "pm.collectionVariables.set('login_ok', '1');",
            "pm.test('Login HTTP 200 (un intento, sin refresh)', function () {",
            "    pm.expect(code).to.eql(200);",
            "});"
          ]
        }
      }],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"{{correo}}\",\n  \"contrasena\": \"{{contrasena}}\"\n}"
        },
        "url": "{{baseUrl}}/sesiones/"
      }
    },
    {
      "name": "00.2 PRECHECK GET tema resuelto",
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "if (pm.collectionVariables.get('login_ok') !== '1') { return; }",
            "const code = pm.response.code;",
            "pm.test('PRECHECK GET tema resuelto HTTP 200', function () { pm.expect(code).to.eql(200); });",
            "if (code !== 200) {",
            "    pm.collectionVariables.set('abort_reason', 'GET tema HTTP ' + code);",
            "    pm.collectionVariables.set('tc173', 'BLOQUEADO');",
            "    pm.execution.setNextRequest(null);",
            "    return;",
            "}",
            "const json = pm.response.json();",
            "pm.collectionVariables.set('orig_resuelto_mode', String(json.theme_mode));",
            "pm.collectionVariables.set('orig_resuelto_fuente', String(json.fuente || ''));",
            "pm.collectionVariables.set('orig_resuelto_id', json.id_tema_visual == null ? '' : String(json.id_tema_visual));",
            "pm.test('PRECHECK resuelto tiene theme_mode y fuente', function () {",
            "    pm.expect(json.theme_mode).to.be.oneOf([1, 2, 3]);",
            "    pm.expect(json.fuente).to.be.oneOf(['personal', 'global', 'defecto']);",
            "});"
          ]
        }
      }],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Accept", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/configuracion/personalizacion/tema"
      }
    },
