            "    pm.collectionVariables.set('orig_global_mode', '');",
            "} else {",
            "    pm.collectionVariables.set('orig_global_existia', '1');",
            "    pm.collectionVariables.set('orig_global_json', JSON.stringify({ theme_mode: json.theme_mode, es_global: json.es_global, id_tema_visual: json.id_tema_visual }));",
            "    pm.collectionVariables.set('orig_global_mode', String(json.theme_mode));",
            "}"
          ]
