            "        pm.expect(json.theme_mode).to.eql(Number(pm.collectionVariables.get('orig_global_mode')));",
            "        pm.expect(json.es_global).to.eql(true);",
            "    });",
            "}"
          ]
        }
      }],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Accept", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/configuracion/personalizacion/tema/global"
      }
    }
  ]
}
