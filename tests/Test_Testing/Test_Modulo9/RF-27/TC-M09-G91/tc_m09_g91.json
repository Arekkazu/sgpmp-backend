          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"theme_mode\": 1\n}"
        },
        "url": {
          "raw": "{{base_url}}/configuracion/personalizacion/tema/global",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "configuracion",
            "personalizacion",
            "tema",
            "global"
          ]
        }
      }
    },
    {
      "name": "06 - TC-M09-173 - Verificar prioridad individual",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Resolución del tema exitosa', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "console.log('TC-M09-173 RESULTADO:', JSON.stringify(json, null, 2));",
              "",
              "pm.test('La preferencia individual tiene prioridad sobre la global', function () {",
              "    pm.expect(json.theme_mode).to.eql(2);",
              "});",
              "",
              "pm.test('La fuente corresponde a la preferencia individual', function () {",
              "    pm.expect(String(json.fuente).toLowerCase()).to.eql('personal');",
              "});"
            ]
