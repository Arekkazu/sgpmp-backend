              "pm.test('Configuración global Claro guardada', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "console.log('GLOBAL CLARO:', JSON.stringify(json, null, 2));",
              "",
              "pm.test('theme_mode global = 1', function () {",
              "    pm.expect(json.theme_mode).to.eql(1);",
              "});",
              "",
              "pm.test('Configuración global', function () {",
              "    pm.expect(json.es_global).to.eql(true);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
