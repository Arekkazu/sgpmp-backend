{
  "info": {
    "name": "TC-M09-G24 - niveles de alerta (fuera de rango, solapamiento, continuidad)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "TC-M09-52",
      "item": [
        {
          "name": "TC-M09-52 POST umbral",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/configuracion/umbrales",
            "body": {
              "mode": "raw",
              "raw": "{{payload}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b=pm.response.json();",
                  "const p=JSON.parse(pm.environment.get('payload'));",
                  "const num=x=>Number(x);",
                  "const ord=ns=>[...ns].sort((x,y)=>num(x.limite_inferior)-num(y.limite_inferior));",
                  "pm.test('POST enviado y respondido por el servidor',()=>{pm.expect(pm.response.code).to.be.a('number');pm.expect(pm.response.responseTime).to.be.a('number');});",
                  "const fuera=p.niveles.filter(n=>num(n.limite_inferior)<num(p.valor_min)||num(n.limite_superior)>num(p.valor_max));",
                  "pm.test('Payload valido salvo un unico nivel fuera del rango padre',()=>{pm.expect(p.niveles).to.have.lengthOf(3);pm.expect(num(p.valor_min)).to.be.below(num(p.valor_max));p.niveles.forEach(n=>pm.expect(num(n.limite_inferior)).to.be.below(num(n.limite_superior)));pm.expect(fuera).to.have.lengthOf(1);pm.expect(fuera[0].nivel).to.eql('critico');pm.expect(num(fuera[0].limite_superior)).to.be.above(num(p.valor_max));});",
                  "pm.test('HTTP exactamente 400',()=>pm.response.to.have.status(400));",
                  "pm.test('Respuesta indica nivel fuera del rango general',()=>{pm.expect(b.error_code).to.eql('NIVEL_FUERA_DE_RANGO');pm.expect(b.message).to.include('cae fuera del rango general');pm.expect(b.message).to.include(fuera[0].nivel);});",
                  "pm.test('Sin ID creado',()=>{pm.expect(b).not.to.have.property('id_umbral_ambiental');pm.expect(b).not.to.have.property('id');});",
                  "pm.test('Sin estado de creacion exitosa',()=>{pm.expect(b.es_activo).not.to.eql(true);pm.expect(b.success).not.to.eql(true);pm.expect(pm.response.code).not.to.eql(201);});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-M09-52 GET verificacion",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/configuracion/umbrales?id_especie={{id_especie}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b=pm.response.json();",
                  "const idVar=Number(pm.environment.get('id_variable'));",
                  "pm.test('GET posterior HTTP 200',()=>pm.response.to.have.status(200));",
                  "pm.test('Combinacion no persistida (activa ni inactiva)',()=>{pm.expect(b.items).to.be.an('array');pm.expect(b.items.filter(u=>u.id_variable_ambiental===idVar)).to.have.lengthOf(0);});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "TC-M09-53",
      "item": [
        {
          "name": "TC-M09-53 POST umbral",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/configuracion/umbrales",
            "body": {
              "mode": "raw",
              "raw": "{{payload}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b=pm.response.json();",
                  "const p=JSON.parse(pm.environment.get('payload'));",
                  "const num=x=>Number(x);",
                  "const ord=ns=>[...ns].sort((x,y)=>num(x.limite_inferior)-num(y.limite_inferior));",
                  "pm.test('POST enviado y respondido por el servidor',()=>{pm.expect(pm.response.code).to.be.a('number');pm.expect(pm.response.responseTime).to.be.a('number');});",
                  "const o=ord(p.niveles);const solapes=[];for(let i=0;i<o.length-1;i++)if(num(o[i].limite_superior)>num(o[i+1].limite_inferior))solapes.push([o[i].nivel,o[i+1].nivel,num(o[i+1].limite_inferior),num(o[i].limite_superior)]);",
                  "pm.test('Payload valido salvo un unico solapamiento intencional',()=>{pm.expect(p.niveles).to.have.lengthOf(3);pm.expect(num(p.valor_min)).to.be.below(num(p.valor_max));p.niveles.forEach(n=>{pm.expect(num(n.limite_inferior)).to.be.below(num(n.limite_superior));pm.expect(num(n.limite_inferior)).to.be.at.least(num(p.valor_min));pm.expect(num(n.limite_superior)).to.be.at.most(num(p.valor_max));});pm.expect(num(o[0].limite_inferior)).to.eql(num(p.valor_min));pm.expect(num(o[2].limite_superior)).to.eql(num(p.valor_max));pm.expect(solapes,'un unico solapamiento y ningun hueco').to.have.lengthOf(1);});",
                  "pm.test('HTTP exactamente 422 (BusinessRuleError SOLAPAMIENTO_NIVELES, contrato real de RF-17)',()=>pm.response.to.have.status(422));",
                  "pm.test('Respuesta identifica el solapamiento probado y no otra regla',()=>{pm.expect(b.error_code).to.eql('SOLAPAMIENTO_NIVELES');pm.expect(b.message).to.include('sin huecos ni solapamientos');pm.expect(b.message).to.include(solapes[0][0]);pm.expect(b.message).to.include(String(solapes[0][2]));});",
                  "pm.test('Sin ID creado',()=>{pm.expect(b).not.to.have.property('id_umbral_ambiental');pm.expect(b).not.to.have.property('id');});",
                  "pm.test('Sin estado de creacion exitosa',()=>{pm.expect(b.es_activo).not.to.eql(true);pm.expect(b.success).not.to.eql(true);pm.expect(pm.response.code).not.to.eql(201);});"
                ]
              }
            }
          ]
        },
