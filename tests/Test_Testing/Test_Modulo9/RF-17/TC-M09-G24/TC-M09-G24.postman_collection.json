    {
      "name": "TC-M09-54",
      "item": [
        {
          "name": "TC-M09-54 POST umbral",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/configuracion/umbrales",
            "body": {
              "mode": "raw",
              "raw": "{{payload}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b=pm.response.json();",
                  "const p=JSON.parse(pm.environment.get('payload'));",
                  "const num=x=>Number(x);",
                  "const ord=ns=>[...ns].sort((x,y)=>num(x.limite_inferior)-num(y.limite_inferior));",
                  "pm.test('POST enviado y respondido por el servidor',()=>{pm.expect(pm.response.code).to.be.a('number');pm.expect(pm.response.responseTime).to.be.a('number');});",
                  "pm.test('HTTP exactamente 201',()=>pm.response.to.have.status(201));",
                  "pm.test('ID creado positivo',()=>{pm.expect(b.id_umbral_ambiental).to.be.a('number');pm.expect(b.id_umbral_ambiental).to.be.above(0);pm.environment.set('id_creado',String(b.id_umbral_ambiental));});",
                  "pm.test('Especie y variable correctas',()=>{pm.expect(b.id_especie).to.eql(p.id_especie);pm.expect(b.id_variable_ambiental).to.eql(p.id_variable_ambiental);});",
                  "pm.test('Estado activo',()=>pm.expect(b.es_activo).to.eql(true));",
                  "pm.test('valor_min y valor_max correctos',()=>{pm.expect(num(b.valor_min)).to.eql(num(p.valor_min));pm.expect(num(b.valor_max)).to.eql(num(p.valor_max));});",
                  "pm.test('Exactamente tres niveles',()=>pm.expect(b.niveles).to.have.lengthOf(3));",
                  "pm.test('Niveles esperados',()=>{p.niveles.forEach(esp=>{const real=b.niveles.find(n=>n.nivel===esp.nivel);pm.expect(real,esp.nivel).to.not.be.undefined;pm.expect(num(real.limite_inferior)).to.eql(num(esp.limite_inferior));pm.expect(num(real.limite_superior)).to.eql(num(esp.limite_superior));});});",
                  "pm.test('Continuidad matematica de los niveles',()=>{const o=ord(b.niveles);o.forEach(n=>pm.expect(num(n.limite_inferior),n.nivel+' inferior<superior').to.be.below(num(n.limite_superior)));pm.expect(num(o[0].limite_inferior),'nivel1.inferior==valor_min').to.eql(num(b.valor_min));pm.expect(num(o[0].limite_superior),'nivel1.superior==nivel2.inferior').to.eql(num(o[1].limite_inferior));pm.expect(num(o[1].limite_superior),'nivel2.superior==nivel3.inferior').to.eql(num(o[2].limite_inferior));pm.expect(num(o[2].limite_superior),'nivel3.superior==valor_max').to.eql(num(b.valor_max));});",
                  "pm.test('Ausencia de solapamiento',()=>{const o=ord(b.niveles);for(let i=0;i<o.length-1;i++)pm.expect(num(o[i].limite_superior),'sin solapamiento').to.be.at.most(num(o[i+1].limite_inferior));});",
                  "pm.test('Cobertura completa del rango padre',()=>{const o=ord(b.niveles);const suma=o.reduce((acc,n)=>acc+(num(n.limite_superior)-num(n.limite_inferior)),0);pm.expect(Math.round(suma*100)/100,'cobertura completa sin huecos').to.eql(Math.round((num(b.valor_max)-num(b.valor_min))*100)/100);});"
                ]
              }
            }
          ]
        },
