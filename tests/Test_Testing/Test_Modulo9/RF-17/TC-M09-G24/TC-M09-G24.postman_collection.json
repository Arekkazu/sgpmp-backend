                  "const ord=ns=>[...ns].sort((x,y)=>num(x.limite_inferior)-num(y.limite_inferior));",
                  "const id=Number(pm.environment.get('id_creado'));",
                  "pm.test('GET posterior HTTP 200',()=>pm.response.to.have.status(200));",
                  "pm.test('Registro creado presente exactamente una vez',()=>{pm.expect(b.items).to.be.an('array');pm.expect(b.items.filter(u=>u.id_umbral_ambiental===id)).to.have.lengthOf(1);pm.expect(b.items.filter(u=>u.id_variable_ambiental===p.id_variable_ambiental)).to.have.lengthOf(1);});",
                  "pm.test('Valores persistidos conservados',()=>{const u=b.items.find(x=>x.id_umbral_ambiental===id);pm.expect(u.id_especie).to.eql(p.id_especie);pm.expect(u.id_variable_ambiental).to.eql(p.id_variable_ambiental);pm.expect(u.es_activo).to.eql(true);pm.expect(num(u.valor_min)).to.eql(num(p.valor_min));pm.expect(num(u.valor_max)).to.eql(num(p.valor_max));pm.expect(u.niveles).to.have.lengthOf(3);p.niveles.forEach(esp=>{const real=u.niveles.find(n=>n.nivel===esp.nivel);pm.expect(real,esp.nivel).to.not.be.undefined;pm.expect(num(real.limite_inferior)).to.eql(num(esp.limite_inferior));pm.expect(num(real.limite_superior)).to.eql(num(esp.limite_superior));});});",
                  "pm.test('Continuidad persistida sin huecos ni solapamientos',()=>{const u=b.items.find(x=>x.id_umbral_ambiental===id);{const o=ord(u.niveles);o.forEach(n=>pm.expect(num(n.limite_inferior),n.nivel+' inferior<superior').to.be.below(num(n.limite_superior)));pm.expect(num(o[0].limite_inferior),'nivel1.inferior==valor_min').to.eql(num(u.valor_min));pm.expect(num(o[0].limite_superior),'nivel1.superior==nivel2.inferior').to.eql(num(o[1].limite_inferior));pm.expect(num(o[1].limite_superior),'nivel2.superior==nivel3.inferior').to.eql(num(o[2].limite_inferior));pm.expect(num(o[2].limite_superior),'nivel3.superior==valor_max').to.eql(num(u.valor_max));}{const o=ord(u.niveles);for(let i=0;i<o.length-1;i++)pm.expect(num(o[i].limite_superior),'sin solapamiento').to.be.at.most(num(o[i+1].limite_inferior));}{const o=ord(u.niveles);const suma=o.reduce((acc,n)=>acc+(num(n.limite_superior)-num(n.limite_inferior)),0);pm.expect(Math.round(suma*100)/100,'cobertura completa sin huecos').to.eql(Math.round((num(u.valor_max)-num(u.valor_min))*100)/100);}});"
