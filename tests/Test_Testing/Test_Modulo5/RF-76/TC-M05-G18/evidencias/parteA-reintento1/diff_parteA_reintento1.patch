+def _correr_job_fin_retiro_real(bd: _BdMemoria, monkeypatch: pytest.MonkeyPatch) -> _FakeAsyncioEnMain:
+    """Una iteracion de ``main._revertir_retiros_vencidos_diariamente`` con el caso de uso REAL.
+
+    Bordes: ``sesion_sistema`` (sesion de BD del job), ``smtplib.SMTP`` y el reloj
+    (``hoy_usuario`` = 2026-11-10 y el ``asyncio.sleep`` del bucle). Puertos de otros
+    modulos como en la ronda 1: ``ActivoM02Adapter.listar_en_tratamiento`` y RF-44.
+    """
+    fake_asyncio = _FakeAsyncioEnMain()
+    contador = {"n": 0}
+
+    def _sesion_job() -> _SesionBorde:
+        contador["n"] += 1
+        return _SesionBorde(bd, f"job{contador['n']}", es_request=False)
+
+    class _ActivoListarDoble:
+        def __init__(self, _db: Any) -> None:
+            pass
+
+        def listar_en_tratamiento(self) -> list[int]:
+            bd.listar_en_tratamiento_calls += 1
+            return [k for k, a in bd.activos.items() if a["id_estado"] == ESTADO_EN_TRATAMIENTO]
+
+    class _EstadoRf44Doble:
+        def __init__(self, db: _SesionBorde) -> None:
+            self.db = db
+
+        def revertir_a_activo(self, *, id_activo: int, id_usuario: int, motivo: str) -> None:
+            bd.rf44_reversiones.append({"id_activo": id_activo, "id_usuario": id_usuario, "motivo": motivo})
+            self.db.staged_estado[id_activo] = ESTADO_ACTIVO
+
+    _SmtpBorde.bd = bd
+    monkeypatch.setattr(smtplib, "SMTP", _SmtpBorde)
+    monkeypatch.setattr(shared_database, "sesion_sistema", _sesion_job)
+    monkeypatch.setattr(main, "asyncio", fake_asyncio)
+    monkeypatch.setattr(shared_fechas, "hoy_usuario", lambda: FECHA_SIMULADA_S1)
+    monkeypatch.setattr(rev_uc_mod, "hoy_usuario", lambda: FECHA_SIMULADA_S1)
+    monkeypatch.setattr(activo_m02_mod, "ActivoM02Adapter", _ActivoListarDoble)
+    monkeypatch.setattr(estado_activo_m02_mod, "EstadoActivoM02Adapter", _EstadoRf44Doble)
+
+    async def _correr() -> None:
+        try:
+            await main._revertir_retiros_vencidos_diariamente()
