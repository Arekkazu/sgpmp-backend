+def _notificaciones_internas(bd: _BdMemoria, id_activo: int) -> list[dict[str, Any]]:
+    """Filas confirmadas de la bandeja (``modulo1.notificaciones``) referidas al activo, via su evento."""
+    nombres = {v: k for k, v in bd.tipos_eventos.items()}
+    eventos = {getattr(e, "id_evento", None): e for e in bd.tablas.get(EventosModel, [])}
+    salida = []
+    for n in bd.tablas.get(NotificacionesModel, []):
+        ev = eventos.get(getattr(n, "id_evento", None))
+        detalle = (getattr(ev, "detalle", None) or {}) if ev is not None else {}
+        id_tipo = getattr(ev, "tipo_evento", None) if ev is not None else None
+        fila = {
+            "id_usuario": n.id_usuario,
+            "rol": bd.usuarios.get(n.id_usuario, {}).get("rol"),
+            "id_tipo_evento": id_tipo,
+            "tipo_evento": nombres.get(id_tipo),
+            "id_activo": detalle.get("id_activo_biologico"),
+            "id_canal": getattr(n, "id_notificacion_canal", None),
+        }
+        if fila["id_activo"] == id_activo:
+            salida.append(fila)
+    return salida
