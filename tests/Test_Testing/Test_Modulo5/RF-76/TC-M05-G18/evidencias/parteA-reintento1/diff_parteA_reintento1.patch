+class _ConsultaBorde:
+    """Respuesta del borde a ``Session.query(...)`` con filtros de igualdad/IS sobre las filas de la BD."""
+
+    def __init__(self, sesion: "_SesionBorde", entidades: tuple[Any, ...]) -> None:
+        self.sesion = sesion
+        ent = entidades[0]
+        if isinstance(ent, type):
+            self.cls, self.columnas = ent, None
+        else:
+            self.cls, self.columnas = ent.class_, [e.key for e in entidades]
+        self.criterios: list[Any] = []
+        self.orden: list[Any] = []
+        self.limite: Optional[int] = None
+
+    def filter(self, *crits: Any) -> "_ConsultaBorde":
+        self.criterios.extend(crits)
+        return self
+
+    def filter_by(self, **kw: Any) -> "_ConsultaBorde":
+        for k, v in kw.items():
+            self.criterios.append(getattr(self.cls, k) == v)
+        return self
+
+    def order_by(self, *cols: Any) -> "_ConsultaBorde":
+        self.orden.extend(cols)
+        return self
+
+    def limit(self, n: int) -> "_ConsultaBorde":
+        self.limite = n
+        return self
+
+    def with_for_update(self, *_a: Any, **_k: Any) -> "_ConsultaBorde":
+        return self
+
+    def _resultado(self) -> list[Any]:
+        bd = self.sesion.bd
+        filas = bd.filas(self.cls) + [o for o in self.sesion.staged_orm if isinstance(o, self.cls)]
+        seleccion = []
+        for f in filas:
+            ok = True
+            for c in self.criterios:
+                r = _evaluar_criterio(f, c)
+                if r is None:
+                    bd.consultas_no_evaluables.append(f"{self.cls.__name__}: {str(c)[:120]}")
+                    continue
+                ok = ok and r
+            if ok:
+                seleccion.append(f)
+        for col in reversed(self.orden):
+            desc = isinstance(col, UnaryExpression) and col.modifier is sa_ops.desc_op
+            base = col.element if isinstance(col, UnaryExpression) else col
+            clave = getattr(base, "key", None)
+            seleccion.sort(key=lambda o: (getattr(o, clave, None) is None, getattr(o, clave, None) or 0), reverse=False)
+            if desc:
+                con = [o for o in seleccion if getattr(o, clave, None) is not None]
+                sin = [o for o in seleccion if getattr(o, clave, None) is None]
+                seleccion = list(reversed(con)) + sin
+        if self.limite is not None:
+            seleccion = seleccion[: self.limite]
+        if self.columnas:
+            return [tuple(getattr(f, c, None) for c in self.columnas) if len(self.columnas) > 1
+                    else _fila(**{self.columnas[0]: getattr(f, self.columnas[0], None)}) for f in seleccion]
+        return seleccion
+
+    def first(self) -> Any:
+        r = self._resultado()
+        if r and self.columnas and len(self.columnas) > 1:
+            return _fila(**dict(zip(self.columnas, r[0])))
+        return r[0] if r else None
+
+    def all(self) -> list[Any]:
+        return self._resultado()
+
+    def one_or_none(self) -> Any:
+        return self.first()
+
+    def scalar(self) -> Any:
+        r = self._resultado()
+        if not r:
+            return None
+        v = r[0]
+        return v[0] if isinstance(v, tuple) else v
+
