+def _fila(**valores: Any) -> Any:
+    tipo = namedtuple("Fila", list(valores.keys()))
+    return tipo(**valores)
+
+
+def _valor_der(expr: Any) -> Any:
+    if isinstance(expr, SaNull):
+        return None
+    if isinstance(expr, BindParameter):
+        return expr.effective_value
+    return _FALTA
+
+
+def _evaluar_criterio(obj: Any, crit: Any) -> Optional[bool]:
+    """Evalua igualdad / IS / IS NOT de columna contra literal. None = no evaluable."""
+    if not isinstance(crit, BinaryExpression):
+        return None
+    clave = getattr(crit.left, "key", None)
+    if not isinstance(clave, str):
+        return None
+    actual = getattr(obj, clave, _FALTA)
+    esperado = _valor_der(crit.right)
+    if actual is _FALTA or esperado is _FALTA:
+        return None
+    op = crit.operator
+    if op is sa_ops.eq:
+        return actual == esperado
+    if op is sa_ops.ne:
+        return actual != esperado
+    if op in (sa_ops.is_, getattr(sa_ops, "is_", None)):
+        return actual is None
+    if op in (getattr(sa_ops, "is_not", None), getattr(sa_ops, "isnot", None)):
+        return actual is not None
+    return None
+
