+class _SesionBorde:
+    """Sesion de BD falsa (borde). Registra cada llamada en ``bd.secuencia`` con su etiqueta."""
+
+    def __init__(self, bd: _BdMemoria, etiqueta: str, *, es_request: bool) -> None:
+        self.bd = bd
+        self.etiqueta = etiqueta
+        self.es_request = es_request
+        self.info: dict[str, Any] = {}
+        self.staged_orm: list[Any] = []
+        self.staged_audits: list[dict[str, Any]] = []
+        self.staged_estado: dict[int, int] = {}
+        self.closed = False
+        bd.sesiones.append(self)
+
+    def _log(self, op: str) -> None:
+        self.bd.secuencia.append((op, self.etiqueta))
+
+    def add(self, obj: Any) -> None:
+        self._log(f"add:{type(obj).__name__}")
+        self.staged_orm.append(obj)
+
+    def _escribir_pendientes(self) -> None:
+        """Escritura de las filas pendientes; aqui falla el guardado del registro en el escenario B."""
+        if self.bd.fallar_flush_medicamento is not None and any(
+            isinstance(o, RegistroMedicamentoModel) for o in self.staged_orm
+        ):
+            raise self.bd.fallar_flush_medicamento
+        for o in self.staged_orm:
+            clave = _clave_pk(type(o))
+            if getattr(o, clave, None) is None:
+                self.bd.pk_seq += 1
+                setattr(o, clave, self.bd.pk_seq)
+
+    def flush(self) -> None:
+        self._log("flush")
+        self._escribir_pendientes()
+
+    def refresh(self, _obj: Any) -> None:
+        return None
+
+    def in_transaction(self) -> bool:
+        return bool(self.staged_orm or self.staged_audits or self.staged_estado)
+
+    def commit(self) -> None:
+        self._escribir_pendientes()
+        self._log("commit")
+        for o in self.staged_orm:
+            self.bd.tablas.setdefault(type(o), []).append(o)
+        for a in self.staged_audits:
+            self.bd.auditorias_confirmadas.append({
+                "campos": a,
+                "sesion": self.etiqueta,
+                "id_sesion": id(self),
+                "indice_commit": len(self.bd.secuencia) - 1,
+            })
+        for id_activo, estado in self.staged_estado.items():
+            self.bd.activos[id_activo]["id_estado"] = estado
+        self.staged_orm, self.staged_audits, self.staged_estado = [], [], {}
+
+    def rollback(self) -> None:
+        self._log("rollback")
+        self.staged_orm, self.staged_audits, self.staged_estado = [], [], {}
+
+    def close(self) -> None:
+        self._log("close")
+        self.closed = True
+
+    def get(self, cls: type, pk: Any, **_kw: Any) -> Any:
+        clave = _clave_pk(cls)
+        for o in self.bd.filas(cls) + [x for x in self.staged_orm if isinstance(x, cls)]:
+            if getattr(o, clave, None) == pk:
+                return o
+        return None
+
+    def query(self, *entidades: Any) -> _ConsultaBorde:
+        return _ConsultaBorde(self, entidades)
+
+    def execute(self, stmt: Any, params: Optional[dict[str, Any]] = None) -> _ResultadoBorde:
+        p = params or {}
+        if isinstance(stmt, SaInsert):
+            tabla = getattr(stmt.table, "name", "")
+            if tabla == "auditorias_suministros":
+                self._log("execute:insert_auditorias_suministros")
+                if self.bd.fallar_insert_auditoria is not None:
+                    raise self.bd.fallar_insert_auditoria
+                compilado = stmt.compile(dialect=sa_pg.dialect()).params
+                self.staged_audits.append(dict(compilado))
+                return _ResultadoBorde([])
+            self.bd.sql_no_reconocido.append(f"INSERT {tabla}")
+            return _ResultadoBorde([])
+        if stmt is notif_email_mod._SQL_PRODUCTOR:
+            self._log("execute:sql_productor")
+            a = self.bd.activos.get(p.get("id_activo"))
+            u = self.bd.usuarios.get(a["id_usuario"]) if a else None
+            return _ResultadoBorde([_fila(nombre=u["nombre"], apellidos=u["apellidos"],
+                                          correo_electronico=u["correo_electronico"])] if u else [])
+        if stmt is notif_email_mod._SQL_USUARIO:
+            self._log("execute:sql_usuario")
+            u = self.bd.usuarios.get(p.get("id_usuario"))
+            return _ResultadoBorde([_fila(nombre=u["nombre"], apellidos=u["apellidos"],
+                                          correo_electronico=u["correo_electronico"])] if u else [])
+        if stmt is notif_email_mod._SQL_ACTIVO:
+            self._log("execute:sql_activo")
+            a = self.bd.activos.get(p.get("id_activo"))
+            return _ResultadoBorde([_fila(id_usuario=a["id_usuario"], identificador=a["identificador"])] if a else [])
+        if stmt is notif_m01_mod._SQL_TIPO_EVENTO:
+            self._log("execute:sql_tipo_evento")
+            idt = self.bd.tipos_eventos.get(p.get("nombre"))
+            return _ResultadoBorde([(idt,)] if idt is not None else [])
+        if stmt is notif_m01_mod._SQL_RESPONSABLES:
+            self._log("execute:sql_responsables")
+            a = self.bd.activos.get(p.get("id_activo"))
+            ids: list[int] = []
+            if a and a.get("id_usuario") is not None:
+                ids.append(a["id_usuario"])
+            ids.extend(self.bd.vets_finca.get(p.get("id_activo"), []))
+            return _ResultadoBorde([_fila(id_usuario=i) for i in dict.fromkeys(ids)])
+        sql = " ".join(str(stmt).split())
+        if sql.upper().startswith("SET LOCAL"):
+            self._log("execute:set_local")
+            return _ResultadoBorde([])
+        self.bd.sql_no_reconocido.append(sql[:160])
+        return _ResultadoBorde([])
