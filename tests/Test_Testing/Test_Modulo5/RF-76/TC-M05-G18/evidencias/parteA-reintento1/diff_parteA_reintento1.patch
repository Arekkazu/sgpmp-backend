+def _resumen_s3(resp: Any, bd: _BdMemoria, req: _SesionBorde) -> dict[str, Any]:
+    """Valores reales observados tras un POST fallido (sin interpretar)."""
+    try:
+        body = resp.json()
+    except ValueError:
+        body = {}
+    incidentes = [a for a in bd.auditorias_confirmadas if a["campos"].get("resultado") in _RESULTADOS_FALLO]
+    exitos = [a for a in bd.auditorias_confirmadas if a["campos"].get("resultado") not in _RESULTADOS_FALLO]
+    rollback_req = [i for i, (op, et) in enumerate(bd.secuencia) if op == "rollback" and et == "req"]
+    campos_inc = []
+    for inc in incidentes:
+        c = inc["campos"]
+        campos_inc.append({
+            "tipo_evento": c.get("tipo_evento", "(columna inexistente en auditorias_suministros)"),
+            "tipo_operacion": c.get("tipo_operacion"),
+            "resultado": c.get("resultado"),
+            "fecha_emision": c.get("fecha_emision"),
+            "id_activo": c.get("id_activo_biologico"),
+            "id_registro_suministro": c.get("id_registro_suministro", "(no existe en el incidente)"),
+            "registro_incompleto": c.get("registro_incompleto"),
+            "detalle_causa": (c.get("detalle_causa") or "")[:300],
+            "sesion": inc["sesion"],
+            "id_sesion": inc["id_sesion"],
+            "indice_commit": inc["indice_commit"],
+        })
+    return {
+        "http": resp.status_code,
+        "error_code": (body.get("error_code") or body.get("code") or "") if isinstance(body, dict) else "",
+        "registros_medicamento_confirmados": len(bd.tablas.get(RegistroMedicamentoModel, [])),
+        "estado_activo": bd.activos[ACTIVO_ID_PRUEBA]["id_estado"],
+        "rf44_marcados": len(bd.rf44_marcados),
+        "eventos_exito_confirmados": len(exitos),
+        "incidentes_confirmados": len(incidentes),
+        "incidentes": campos_inc,
+        "id_sesion_request": id(req),
+        "indices_rollback_req": rollback_req,
+        "secuencia": [f"{op}({et})" for op, et in bd.secuencia if not op.startswith("execute:sql")],
+        "sesiones_abiertas": [s.etiqueta for s in bd.sesiones],
+        "correos_enviados": len(bd.correos),
+        "sql_no_reconocido": list(bd.sql_no_reconocido),
+    }
+
+
+def _verificar_s3_incidente(obs: dict[str, Any], resp: Any, fuente: str) -> None:
+    """Asertos comunes de G18_S3_03a y G18_S3_03b (mismo esperado)."""
+    _assert_sin_violaciones_guard()
+    assert not obs["sql_no_reconocido"], f"INFRA: SQL no reconocido por el borde: {obs['sql_no_reconocido']}"
+    assert 500 <= obs["http"] < 600, f"[{fuente}] se esperaba HTTP 5xx, obtuvo {obs['http']}"
+    assert obs["error_code"], f"[{fuente}] la respuesta 5xx debe traer error_code no vacio"
+    _assert_sin_fugas_en_respuesta(resp)
+    assert obs["registros_medicamento_confirmados"] == 0, f"[{fuente}; RF-76 E10] no debe quedar registro de medicamento"
+    assert obs["estado_activo"] == ESTADO_ACTIVO and obs["rf44_marcados"] == 0, (
+        f"[{fuente}; RF-76 E10] el estado del activo debe quedar sin cambios"
+    )
+    assert obs["eventos_exito_confirmados"] == 0, f"[{fuente}] no debe quedar evento de exito del registro"
+    assert obs["incidentes_confirmados"] == 1, (
+        f"[{fuente}] se esperaba EXACTAMENTE 1 incidente de la operacion fallida, hay {obs['incidentes_confirmados']}"
+    )
+    inc = obs["incidentes"][0]
+    assert inc["tipo_operacion"], f"[RF-80 Restriccion 8] el incidente debe traer tipo de evento no nulo"
+    assert inc["resultado"] in _RESULTADOS_FALLO, f"[RF-80 Restriccion 8] resultado de fallo esperado: {inc['resultado']}"
+    assert inc["fecha_emision"] is not None, "[RF-80 Restriccion 8] fecha_emision no nula"
+    assert inc["sesion"] != "req" and inc["id_sesion"] != obs["id_sesion_request"], (
+        f"[{fuente}] el incidente debe escribirse con una sesion DISTINTA de la de la request; "
+        f"se escribio en '{inc['sesion']}' (id={inc['id_sesion']}, request id={obs['id_sesion_request']})"
+    )
+    assert obs["indices_rollback_req"], f"[{fuente}] no se observo rollback de la sesion principal"
+    assert inc["indice_commit"] > obs["indices_rollback_req"][0], (
+        f"[{fuente}] el incidente debe confirmarse DESPUES del rollback de la sesion principal"
+    )
+
