{"timestamp_local": "2026-11-07T20:55:36.595210-05:00", "server_date": "Sun, 08 Nov 2026 01:55:34 GMT", "duracion_ms": 117.45, "test": "test_b03_verificacion_integridad_hash_sha256", "metodo": "POST", "ruta": "/test-control/query", "params": null, "status_code": 200, "error_code": null, "error_conexion": null, "request_body": {"query": "SELECT pg_get_functiondef(oid) as def FROM pg_proc WHERE proname = 'calcular_hash_integridad'"}, "response_body": {"data": [{"def": "CREATE OR REPLACE FUNCTION modulo5.calcular_hash_integridad()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\nBEGIN\n  -- Calcula SHA-256 sobre todos los campos en orden alfabético (excluyendo hash_integridad)\n  NEW.hash_integridad := encode(\n    digest(\n      (SELECT string_agg(\n        format('%I=%L', key, value), ' & ' ORDER BY key\n      ) FROM jsonb_each_text(to_jsonb(NEW) - 'hash_integridad' - 'creado_en' - 'id_registro_suministro')),\n      'sha256'\n    ), 'hex'\n  );\n  RETURN NEW;\nEND;\n$function$\n"}]}}
