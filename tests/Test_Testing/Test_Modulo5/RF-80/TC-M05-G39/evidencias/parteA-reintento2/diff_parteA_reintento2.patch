+def test_a03_filtro_activo_ciclo_orden_emision():
+    """A03 (TC-M05-092; RF-80 v2.0 CA-4, RNF-08): filtro por activo y ciclo, ordenar_por=fecha_emision."""
+    c = _principal()
+    obs: dict[str, Any] = {}
+    try:
+        a02 = _CONTEXTO.get("a02")
+        assert a02 is not None, "Precondicion A03: A02 no dejo activo, ciclo ni eventos"
+        params = {
+            "id_activo_biologico": a02["activo"],
+            "id_ciclo_productivo": a02["ciclo_ref"],
+            "ordenar_por": "fecha_emision",
+            "pagina": 1,
+            "registros_por_pagina": 100,
+        }
+        r = c.get("admin", "/suministros/auditoria", params=params, paso="a03_filtro_orden")
+        items = (r.json().get("items") or []) if r.status_code == 200 else []
+        obs.update({
+            "parametros": params,
+            "http": r.status_code,
+            "x_request_id": _x_id(r),
+            "total": r.json().get("total") if r.status_code == 200 else None,
+            "lista": [[it.get("id_auditoria_suministro"), it.get("entidad_afectada"), it.get("fecha_emision")]
+                      for it in items],
+        })
+        assert r.status_code == 200, f"A03 GET /suministros/auditoria HTTP {r.status_code} [CA-4]"
+        devueltos = [int(it["id_auditoria_suministro"]) for it in items]
