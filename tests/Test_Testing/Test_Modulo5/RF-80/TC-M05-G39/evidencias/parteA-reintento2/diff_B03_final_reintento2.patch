+# Columnas de modulo5.auditorias_suministros: alembic/baseline/esquema_baseline.sql:25595-25619, mas
+# id_evento_m05 y version_hash_integridad, que agrega alembic/versions/d96480a11e01_rf80_identidad_integridad_auditoria_m05.py:23-24
+# y que fn_hash_evento_auditoria_m05 incluye en el hash v2 (to_jsonb(NEW)). Toda otra clave de la respuesta
+# (nombre_activo, nombre_usuario...) es de presentacion de la API y no entra en el hash.
+_COLUMNAS_AUDITORIA = frozenset({
+    "id_auditoria_suministro", "entidad_afectada", "tipo_operacion", "datos_anteriores", "datos_nuevos",
+    "id_usuario", "ip_origen", "fecha_evento", "id_sesion", "resultado", "fecha_emision", "id_activo_biologico",
+    "id_ciclo_productivo", "costo_afectado", "origen_precio", "clasificacion_registro", "retencion_aplicable",
+    "hash_integridad", "registro_incompleto", "detalle_causa", "numero_reintentos", "fecha_intentos",
+    "id_gestion_fases",
+    "id_evento_m05", "version_hash_integridad",
+})
+# Alcance de B03: entidades evaluadas en el reintento 1 (run-20261111-232824) mas resultado_ica.
+_ENTIDADES_B03 = ("registro_suministro", "provision_nic41", "auditorias_suministros", "resultado_ica")
+# Hash no verificable via API (CONFIRMACION_HASH_G39.txt): la respuesta devuelve sus numericos sin la escala
+# con la que se sellaron; se registran como observacion, fuera del checkpoint.
+_ENTIDADES_HASH_NO_VERIFICABLE = ("registros_consumo_alimentos", "registros_medicamentos")
+
+
+def _solo_columnas(evento: dict[str, Any]) -> tuple[dict[str, Any], list[str]]:
+    excluidas = sorted(k for k in evento if k not in _COLUMNAS_AUDITORIA)
+    return {k: v for k, v in evento.items() if k in _COLUMNAS_AUDITORIA}, excluidas
+
+
+def _numericos_texto_crudo(texto: str) -> dict[str, str]:
+    """Numericos de datos_nuevos/datos_anteriores/costo_afectado tal como vienen en el texto crudo."""
+    lit = json.loads(texto, parse_float=lambda x: f"<{x}>", parse_int=lambda x: f"<{x}>")
+    salida: dict[str, str] = {}
+
+    def recorrer(prefijo: str, v: Any) -> None:
+        if isinstance(v, dict):
+            for k, x in v.items():
+                recorrer(f"{prefijo}.{k}" if prefijo else k, x)
+        elif isinstance(v, str) and re.fullmatch(r"<-?[\d.eE+-]+>", v):
+            salida[prefijo] = v[1:-1]
+
+    for clave in ("datos_nuevos", "datos_anteriores", "costo_afectado"):
+        if isinstance(lit, dict) and clave in lit:
+            recorrer(clave, lit[clave])
+    return salida
+
