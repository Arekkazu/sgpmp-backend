                "exec": [
                  "const e = (() => { try { return pm.response.json(); } catch (x) { return {}; } })(); console.log(pm.response.text().slice(0, 1500));",
                  "pm.test('TC-M05-053a - HTTP 200', () => pm.response.to.have.status(200));",
