      "name": "2. TC-M05-058 Inmutabilidad del reporte en BD",
      "item": [
        {
          "name": "TC-M05-058a - Existe proteccion contra UPDATE/DELETE sobre provision_nic41",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('TC-M05-058a - consulta de auditoria respondida (200)', () => pm.response.to.have.status(200));",
                  "const filas = (pm.response.json() || {}).data || [];",
                  "console.log(JSON.stringify(filas));",
                  "const prot = filas.filter(f => /BEFORE (UPDATE OR DELETE|DELETE OR UPDATE|UPDATE|DELETE)/i.test(f.def));",
                  "console.log(JSON.stringify(filas));",
                  "pm.test('TC-M05-058a - hay un trigger BEFORE UPDATE/DELETE sobre provision_nic41', () => pm.expect(prot.length).to.be.above(0));",
                  "pm.test.skip('TC-M05-058b - UPDATE y DELETE reales: BLOQUEADO, /test-control/query es de solo lectura y member_qa no escribe; lo debe ejecutar el DBA', () => {});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/test-control/query",
            "body": {
              "mode": "raw",
              "raw": "{\"query\": \"SELECT t.tgname, pg_get_triggerdef(t.oid) AS def FROM pg_trigger t WHERE t.tgrelid = 'modulo5.provision_nic41'::regclass AND NOT t.tgisinternal\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
