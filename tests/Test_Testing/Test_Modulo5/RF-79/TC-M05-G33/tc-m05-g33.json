              "mode": "raw",
              "raw": "{\"query\": \"SELECT id_outbox_provision_m06::text AS id_evento, modalidad::text AS modalidad, estado::text AS estado, numero_intentos, json_contenido, fecha_creacion, fecha_entrega FROM modulo5.outbox_provisiones_m06 WHERE id_gestion_fases = {{id_fase_activa}} ORDER BY fecha_creacion\"}",
