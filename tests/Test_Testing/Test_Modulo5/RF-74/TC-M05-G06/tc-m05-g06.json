                  "pm.test('TC-M05-017 - ganancia_peso_kg = 0.5 x cantidad_actual (' + (0.5 * n) + ') (CA-6)', () => pm.expect((r.ganancia_peso_kg === null || r.ganancia_peso_kg === undefined ? null : Number(r.ganancia_peso_kg))).to.eql(0.5 * n));",
