                  "pm.test('TC-M05-017 - ca_calculado = 60 / (0.5 x cantidad) truncado a 4 decimales', () => pm.expect((r.ca_calculado === null || r.ca_calculado === undefined ? null : Number(r.ca_calculado))).to.eql(Math.floor(60 / (0.5 * n) * 10000) / 10000));",
                  "if (n === 100) pm.test('TC-M05-017 - con 100 individuos: ca = 1.2000 y EXCELENTE', () => { pm.expect((r.ca_calculado === null || r.ca_calculado === undefined ? null : Number(r.ca_calculado))).to.eql(1.2); pm.expect(r.clasificacion_ca).to.eql('EXCELENTE'); });"
