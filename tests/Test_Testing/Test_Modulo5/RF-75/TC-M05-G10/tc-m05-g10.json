      "name": "1. TC-M05-025 Activo no ACTIVO, inexistente o sin ciclo abierto",
      "item": [
        {
          "name": "TC-M05-025a - Activo 2 (INACTIVO) -> 422",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const c = [200, 201].includes(pm.response.code) ? pm.response.json() : {};",
                  "const e = pm.response.code >= 400 ? (() => { try { return pm.response.json(); } catch (x) { return {}; } })() : {};",
                  "console.log(pm.response.text().slice(0, 1500));",
                  "pm.test('TC-M05-025a - HTTP 422', () => pm.response.to.have.status(422));",
                  "pm.test('TC-M05-025a - code = ACTIVO_ESTADO_INVALIDO', () => pm.expect(e.error_code || e.code).to.eql('ACTIVO_ESTADO_INVALIDO'));",
                  "pm.test('TC-M05-025a - mensaje del E1 con estado INACTIVO', () => pm.expect(e.message).to.include('porque su estado actual es INACTIVO. Solo se permite el registro sobre activos en estado ACTIVO.'));"
                ]
              }
