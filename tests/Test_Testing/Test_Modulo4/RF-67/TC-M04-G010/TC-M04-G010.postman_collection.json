        {
          "name": "TC-M04-018 - Filtro por patología concreta",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('TC-M04-018 patología: HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const eventos = pm.response.json().eventos || [];",
                  "const inferencias = eventos.filter(e => e.tipo_evento === 'INFERENCIA');",
                  "pm.test('TC-M04-018 patología: devuelve las ' + pm.environment.get('esperado_patologia_a') + ' inferencias esperadas', function () {",
                  "  pm.expect(inferencias.length).to.eql(Number(pm.environment.get('esperado_patologia_a')));",
                  "});",
                  "pm.test('TC-M04-018 patología: todas son de la patología filtrada', function () {",
                  "  pm.expect(inferencias.filter(e => e.payload.id_patologia !== Number(pm.environment.get('id_patologia_a'))).length).to.eql(0);",
                  "});",
                  "pm.test('TC-M04-018 patología: traen el nombre de la patología', function () {",
                  "  pm.expect(inferencias.every(e => !!e.payload.nombre_patologia)).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
