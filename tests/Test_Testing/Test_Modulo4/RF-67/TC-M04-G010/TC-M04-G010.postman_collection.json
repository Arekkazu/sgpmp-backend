              ],
              "path": [
                "prediccion",
                "historial",
                "{{id_activo}}"
              ],
              "query": [
                {
                  "key": "fecha_inicio",
                  "value": "{{rango_desde}}"
                },
                {
                  "key": "fecha_fin",
                  "value": "{{rango_hasta}}"
                }
              ]
            }
          },
          "response": []
        },
