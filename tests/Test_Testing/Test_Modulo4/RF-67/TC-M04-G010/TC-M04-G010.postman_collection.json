        {
          "name": "TC-M04-018 - Con incluir_alertas=true",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('TC-M04-018 alertas: HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const eventos = pm.response.json().eventos || [];",
                  "const inferencias = eventos.filter(e => e.tipo_evento === 'INFERENCIA');",
                  "const alertas = eventos.filter(e => e.tipo_evento === 'ALERTA');",
                  "pm.test('TC-M04-018 alertas: la alerta de RF-57 aparece', function () { pm.expect(alertas.length).to.be.above(0); });",
                  "const a = alertas.find(e => e.id_resultado_inferencia === pm.environment.get('id_resultado_con_alerta'));",
                  "pm.test('TC-M04-018 alertas: correlacionada con su inferencia (id_resultado_inferencia)', function () { pm.expect(a, 'alerta correlacionada').to.exist; });",
                  "pm.test('TC-M04-018 alertas: corresponde a la alerta generada', function () {",
                  "  pm.expect(a && a.payload.id_alerta_patologica).to.eql(Number(pm.environment.get('id_alerta')));",
                  "});",
                  "pm.test('TC-M04-018 alertas: el orden general sigue siendo del más reciente al más antiguo', function () {",
                  "  const f = eventos.map(e => new Date(e.fecha_evento).getTime());",
                  "  pm.expect(f).to.eql(f.slice().sort((x, y) => y - x));",
                  "});"
                ]
              }
            }
          ],
