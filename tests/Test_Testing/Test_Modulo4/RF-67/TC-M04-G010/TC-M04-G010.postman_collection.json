    {
      "name": "2. TC-M04-017 Historial sin filtros",
      "item": [
        {
          "name": "TC-M04-017 - Historial sin filtros (rango amplio, sin alertas)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('TC-M04-017: HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const eventos = pm.response.json().eventos || [];",
                  "const inferencias = eventos.filter(e => e.tipo_evento === 'INFERENCIA');",
                  "pm.test('TC-M04-017: devuelve las ' + pm.environment.get('esperado_total') + ' inferencias esperadas', function () {",
                  "  pm.expect(inferencias.length).to.eql(Number(pm.environment.get('esperado_total')));",
                  "});",
                  "pm.test('TC-M04-017: ordenado del más reciente al más antiguo (fecha_evento DESC)', function () {",
                  "  const f = eventos.map(e => new Date(e.fecha_evento).getTime());",
                  "  pm.expect(f).to.eql(f.slice().sort((a, b) => b - a));",
                  "});",
                  "pm.test('TC-M04-017: cada evento trae tipo, activo, fecha e id de inferencia', function () {",
                  "  eventos.forEach(e => { pm.expect(e.tipo_evento).to.be.ok; pm.expect(e.fecha_evento).to.be.ok; pm.expect(e.id_resultado_inferencia).to.be.ok;",
                  "    pm.expect(e.id_activo_biologico).to.eql(Number(pm.environment.get('id_activo'))); });",
                  "});",
                  "pm.test('TC-M04-017: cada inferencia trae todos los campos exigidos', function () {",
                  "  const campos = ['nivel_riesgo', 'id_patologia', 'nombre_patologia', 'probabilidad_riesgo', 'probabilidad_enfermedad', 'confianza_global', 'tipo_modelo', 'id_version_modelo', 'modo_ejecucion', 'fecha_inicio_ventana', 'fecha_fin_ventana', 'tiene_alerta_generada'];",
                  "  inferencias.forEach(e => pm.expect(campos.filter(c => !(c in (e.payload || {}))), 'faltan').to.eql([]));",
                  "});",
                  "pm.test('TC-M04-017: sin incluir_alertas no aparecen eventos ALERTA', function () { pm.expect(eventos.filter(e => e.tipo_evento === 'ALERTA').length).to.eql(0); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_vet}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/prediccion/historial/{{id_activo}}?fecha_inicio={{desde}}&fecha_fin={{hasta}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "prediccion",
                "historial",
                "{{id_activo}}"
              ],
              "query": [
                {
                  "key": "fecha_inicio",
                  "value": "{{desde}}"
                },
                {
                  "key": "fecha_fin",
                  "value": "{{hasta}}"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. TC-M04-018 Historial con filtros",
      "item": [
        {
          "name": "TC-M04-018 - Filtro por rango de fechas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('TC-M04-018 fechas: HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const eventos = pm.response.json().eventos || [];",
                  "const inferencias = eventos.filter(e => e.tipo_evento === 'INFERENCIA');",
                  "pm.test('TC-M04-018 fechas: devuelve las ' + pm.environment.get('esperado_rango') + ' inferencias esperadas', function () {",
                  "  pm.expect(inferencias.length).to.eql(Number(pm.environment.get('esperado_rango')));",
                  "});",
                  "pm.test('TC-M04-018 fechas: todos los eventos dentro del rango', function () {",
                  "  const d = new Date(pm.environment.get('rango_desde') + 'T00:00:00Z').getTime();",
                  "  const h = new Date(pm.environment.get('rango_hasta') + 'T23:59:59.999Z').getTime();",
                  "  pm.expect(inferencias.filter(e => { const t = new Date(e.fecha_evento).getTime(); return t < d || t > h; }).length).to.eql(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_vet}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/prediccion/historial/{{id_activo}}?fecha_inicio={{rango_desde}}&fecha_fin={{rango_hasta}}",
              "host": [
