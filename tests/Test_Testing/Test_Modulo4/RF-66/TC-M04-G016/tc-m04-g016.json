                  "pm.test('El historial contiene el resultado recien generado', function () { const ev = (J.eventos || []); pm.expect(ev.length).to.be.above(0); const id = pm.collectionVariables.get('id_inferencia'); if (id) { pm.expect(ev.map(function (e) { return String(e.id_resultado_inferencia); })).to.include(id); } });"
                ]
