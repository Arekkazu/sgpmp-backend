    {
      "name": "2. TC-M04-02 - Seleccion del modelo correcto segun la categoria de tamano",
      "item": [
        {
          "name": "2.1 Paquete identico, unicamente categoria Pequena",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": "{{base_url}}{{ruta_inferencia}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_paquete\": \"{{$guid}}\",\n  \"id_activo_biologico\": {{id_activo_pequena}},\n  \"id_lote\": {{id_lote}},\n  \"especie\": \"Ave\",\n  \"categoria_tamano\": \"PEQUENA\",\n  \"timestamp_paquete\": \"{{ts_now}}\",\n  \"modo_ejecucion\": \"SERVIDOR\",\n  \"variables_telemetria\": [{\n      \"tipo_variable\": \"TEMPERATURA_CORPORAL\",\n      \"valor\": 38.6,\n      \"unidad\": \"°C\",\n      \"timestamp_captura\": \"{{ts_now}}\"\n    }, {\n      \"tipo_variable\": \"FRECUENCIA_CARDIACA\",\n      \"valor\": 62,\n      \"unidad\": \"lpm\",\n      \"timestamp_captura\": \"{{ts_now}}\"\n    }, {\n      \"tipo_variable\": \"FRECUENCIA_RESPIRATORIA\",\n      \"valor\": 24,\n      \"unidad\": \"rpm\",\n      \"timestamp_captura\": \"{{ts_now}}\"\n    }, {\n      \"tipo_variable\": \"ACTIVIDAD\",\n      \"valor\": 55,\n      \"unidad\": \"%\",\n      \"timestamp_captura\": \"{{ts_now}}\"\n    }, {\n      \"tipo_variable\": \"TEMPERATURA_AMBIENTAL\",\n      \"valor\": 22,\n      \"unidad\": \"°C\",\n      \"timestamp_captura\": \"{{ts_now}}\"\n    }, {\n      \"tipo_variable\": \"HUMEDAD_RELATIVA\",\n      \"valor\": 60,\n      \"unidad\": \"%\",\n      \"timestamp_captura\": \"{{ts_now}}\"\n    }]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const _n = Date.now(); const _iso = (ms) => new Date(ms).toISOString();",
                  "pm.variables.set('ts_now', _iso(_n));",
                  "pm.variables.set('ts_m1s', _iso(_n - 1000));",
                  "pm.variables.set('ts_m10m', _iso(_n - 10*60000));",
                  "pm.variables.set('ts_m20m', _iso(_n - 20*60000));",
                  "pm.variables.set('ts_m31m', _iso(_n - 31*60000));",
                  "pm.variables.set('ts_p1h', _iso(_n + 3600000));",
                  "pm.variables.set('ts_p10m', _iso(_n + 10*60000));",
                  "pm.variables.set('uniq', String(_n).slice(-9));",
                  "const _d = (n) => new Date(Date.now() - n*864e5).toISOString().slice(0,10);",
                  "pm.variables.set('hoy', _d(0)); pm.variables.set('ayer', _d(1)); pm.variables.set('manana', _d(-1));",
                  "pm.variables.set('hoy_m30', _d(30)); pm.variables.set('hoy_m89', _d(89)); pm.variables.set('hoy_m90', _d(90)); pm.variables.set('hoy_m91', _d(91)); pm.variables.set('hoy_m60', _d(60));",
                  "if (!pm.collectionVariables.get('periodo_ini')) pm.variables.set('periodo_ini', _d(30)); else pm.variables.set('periodo_ini', pm.collectionVariables.get('periodo_ini'));",
                  "if (!pm.collectionVariables.get('periodo_fin')) pm.variables.set('periodo_fin', _d(0)); else pm.variables.set('periodo_fin', pm.collectionVariables.get('periodo_fin'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "console.log('[TC-M04-G016 2.1] status=' + pm.response.code + ' t=' + pm.response.responseTime + 'ms body=' + pm.response.text().slice(0, 600));",
                  "let J; try { J = pm.response.json(); } catch (e) { J = {}; }",
                  "pm.test('HTTP en 200/201', function () { pm.expect([200, 201]).to.include(pm.response.code); });",
                  "const R = (J && J.resultado) ? J.resultado : (J || {});",
                  "const _esp = pm.collectionVariables.get('tipo_modelo_pequena');",
                  "const _mod = R.tipo_modelo || R.modelo_efectivo || (R.modelo && R.modelo.tipo_modelo);",
