    {
      "name": "07-TC-M04-258-Verificar-Auditoria-Hash-Invalido-Falla",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Verificación post-fix #719: el flujo OTA emite HASH_INVALIDO_DETECTADO además de DISTRIBUCION_FALLIDA.",
              "var data = pm.response.json();",
              "pm.test(\"07.01: Total de eventos HASH_INVALIDO_DETECTADO >= 1\", function () {",
              "    pm.expect(data.total, \"El backend debe emitir al menos un evento HASH_INVALIDO_DETECTADO en flujo OTA\").to.be.at.least(1);",
              "});",
              "pm.test(\"07.02: tipo_evento es HASH_INVALIDO_DETECTADO\", function () {",
              "    pm.expect(data.items && data.items.length > 0 ? data.items[0].tipo_evento : null).to.equal(\"HASH_INVALIDO_DETECTADO\");",
              "});",
              "pm.test(\"07.03: tipo_actor es DISPOSITIVO_EDGE y exclusividad de actor (RF-73 CA-13)\", function () {",
              "    var item = data.items && data.items.length > 0 ? data.items[0] : null;",
              "    pm.expect(item ? item.tipo_actor : null).to.equal(\"DISPOSITIVO_EDGE\");",
              "    pm.expect(item ? item.id_usuario : \"non-null\").to.be.null;",
              "    pm.expect(item ? item.id_sistema : null).to.equal(pm.environment.get(\"serial_dispositivo\") || pm.collectionVariables.get(\"serial_dispositivo\"));",
              "});",
              "pm.test(\"07.04: severidad_evento es CRITICAL\", function () {",
              "    pm.expect(data.items && data.items.length > 0 ? data.items[0].severidad_evento : null).to.equal(\"CRITICAL\");",
              "});",
              "pm.test(\"07.05: payload_evento.hash_esperado no nulo\", function () {",
              "    var p = data.items && data.items.length > 0 ? data.items[0].payload_evento : {};",
              "    pm.expect(p && p.hash_esperado !== undefined && p.hash_esperado !== null).to.be.true;",
              "});",
              "pm.test(\"07.06: payload_evento.hash_recibido no nulo\", function () {",
              "    var p = data.items && data.items.length > 0 ? data.items[0].payload_evento : {};",
              "    pm.expect(p && p.hash_recibido !== undefined && p.hash_recibido !== null).to.be.true;",
              "});"
            ]
          }
        }
      ],
