    {
      "name": "02-Preflight-Identificar-Despliegue-Pendiente",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"02.01: Consulta de despliegues OTA existentes (HTTP 200)\", function () {",
              "    pm.response.to.have.status(200);",
              "    var data = pm.response.json();",
              "    var items = Array.isArray(data) ? data : (data.items || []);",
              "    pm.expect(items).to.be.an(\"array\").and.not.empty;",
              "    var pendientes = items.filter(function (d) { return d.estado_despliegue === \"PENDIENTE\"; });",
              "    pm.expect(pendientes.length, \"Precondition missing: no PENDIENTE deployment in TEST\").to.be.at.least(1);",
              "    var chosen = pendientes.find(function (d) { return d.id_despliegue_ota === 11; }) || pendientes[0];",
              "    pm.environment.set(\"id_despliegue_ota\", String(chosen.id_despliegue_ota));",
              "    pm.collectionVariables.set(\"id_despliegue_ota\", String(chosen.id_despliegue_ota));",
              "    var serial = chosen.serial || \"QA-SEMILLA-ADM-M03-EDGE-01\";",
              "    pm.environment.set(\"serial_dispositivo\", serial);",
              "    pm.collectionVariables.set(\"serial_dispositivo\", serial);",
              "    var comp = chosen.componente || \"\";",
              "    pm.environment.set(\"componente\", comp);",
              "    pm.collectionVariables.set(\"componente\", comp);",
              "});"
            ]
          }
        }
      ],
