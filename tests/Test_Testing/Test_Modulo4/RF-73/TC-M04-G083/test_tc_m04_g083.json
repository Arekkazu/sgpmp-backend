      "name": "01-Login-ADMIN",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"01.01: Login exitoso del Administrador (HTTP 200)\", function () {",
              "    pm.response.to.have.status(200);",
              "    var data = pm.response.json();",
              "    var jwt = data.token || data.access_token;",
              "    pm.expect(jwt).to.be.a(\"string\").and.not.empty;",
              "    pm.environment.set(\"jwt_admin\", jwt);",
              "    pm.collectionVariables.set(\"jwt_admin\", jwt);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"correo_electronico\":\"administador.dev@gmail.com\",\"contrasena\":\"{{admin_password}}\"}"
        },
        "url": {
          "raw": "{{base_url}}/sesiones/",
