        }
      }
    },
    {
      "name": "03-TC-M04-257-Disparar-Distribucion-Sandbox-A",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const runId = pm.variables.replaceIn(\"{{$guid}}\");",
              "pm.environment.set(\"run_id_A\", runId);",
              "pm.collectionVariables.set(\"run_id_A\", runId);",
              "var token = pm.environment.get(\"broker_token\") || pm.collectionVariables.get(\"broker_token\");",
              "if (!token) {",
              "    console.warn(\"WARN: broker_token no configurado en environment ni collectionVariables.\");",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"03.01: Reporte OTA integrity_ok aceptado (HTTP 200)\", function () {",
              "    pm.response.to.have.status(200);",
              "    var data = pm.response.json();",
              "    var expectedId = Number(pm.environment.get(\"id_despliegue_ota\") || pm.collectionVariables.get(\"id_despliegue_ota\"));",
              "    pm.expect(data.id_despliegue_ota).to.equal(expectedId);",
              "    pm.environment.set(\"evento_rf73_sub1\", data.evento_rf73);",
              "    pm.collectionVariables.set(\"evento_rf73_sub1\", data.evento_rf73);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
