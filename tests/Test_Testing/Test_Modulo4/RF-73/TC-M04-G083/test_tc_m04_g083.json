    {
      "name": "04-TC-M04-257-Verificar-Auditoria-Modelo-Distribuido",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var data = pm.response.json();",
              "var expectedId = pm.environment.get(\"id_despliegue_ota\") || pm.collectionVariables.get(\"id_despliegue_ota\");",
              "var expectedSerial = pm.environment.get(\"serial_dispositivo\") || pm.collectionVariables.get(\"serial_dispositivo\");",
              "pm.test(\"04.01: Consulta de auditoria exitosa (HTTP 200)\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"04.02: Total de eventos MODELO_DISTRIBUIDO_EDGE >= 1\", function () {",
              "    pm.expect(data.total).to.be.at.least(1);",
              "});",
              "pm.test(\"04.03: tipo_evento es MODELO_DISTRIBUIDO_EDGE\", function () {",
              "    pm.expect(data.items[0].tipo_evento).to.equal(\"MODELO_DISTRIBUIDO_EDGE\");",
              "});",
              "pm.test(\"04.04: tipo_actor es DISPOSITIVO_EDGE\", function () {",
              "    pm.expect(data.items[0].tipo_actor).to.equal(\"DISPOSITIVO_EDGE\");",
              "});",
              "pm.test(\"04.05: id_sistema coincide con el serial del dispositivo\", function () {",
              "    pm.expect(data.items[0].id_sistema).to.equal(expectedSerial);",
              "});",
              "pm.test(\"04.06: severidad_evento es INFO\", function () {",
              "    pm.expect(data.items[0].severidad_evento).to.equal(\"INFO\");",
              "});",
              "pm.test(\"04.07: resultado_operacion es EXITOSO\", function () {",
              "    pm.expect(data.items[0].resultado_operacion).to.equal(\"EXITOSO\");",
              "});",
              "pm.test(\"04.08: payload_evento valida hash_verificado / integrity_ok\", function () {",
              "    var p = data.items[0].payload_evento || {};",
              "    var ok = (p.hash_verificado === true) || (p.evento_nodo === \"integrity_ok\") || (p.estado_despliegue === \"EN_PROCESO\");",
              "    pm.expect(ok).to.be.true;",
              "});",
              "pm.test(\"04.09: id_referencia coincide con id_despliegue_ota\", function () {",
              "    pm.expect(String(data.items[0].id_referencia)).to.equal(String(expectedId));",
              "});",
              "pm.test(\"04.10: correlacion_id no es nulo\", function () {",
              "    pm.expect(data.items[0].correlacion_id).to.not.be.null;",
              "});"
            ]
          }
        }
      ],
