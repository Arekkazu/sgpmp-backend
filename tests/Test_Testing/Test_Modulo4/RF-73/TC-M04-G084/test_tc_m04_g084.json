    {
      "name": "06-Verificar-Precondicion-Subcaso3-F1-Degradado",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"06.01: Verificar precondicion de F1 degradado (<0.80) en modelos activos (HTTP 200)\", function () {",
              "    pm.response.to.have.status(200);",
              "    var body = pm.response.json();",
              "    var items = body.items || body || [];",
              "    if (!Array.isArray(items) && body.modelos) {",
              "        items = body.modelos;",
              "    }",
              "    var count_activos_bajo_umbral = 0;",
              "    items.forEach(function (m) {",
              "        var estado = m.estado || m.estado_version;",
              "        var f1 = m.f1_score_global !== undefined ? m.f1_score_global : m.f1_score;",
              "        if (estado === \"ACTIVO\" && f1 !== null && f1 !== undefined && Number(f1) < 0.80) {",
              "            count_activos_bajo_umbral++;",
              "        }",
              "    });",
              "    pm.expect(count_activos_bajo_umbral).to.equal(0, \"Precondicion de degradacion no cumplida: no hay modelo ACTIVO con F1<0.80 en TEST. El subcaso 3 no puede activarse aunque el scheduler existiera.\");",
              "    pm.environment.set(\"count_f1_bajo\", count_activos_bajo_umbral);",
              "    pm.collectionVariables.set(\"count_f1_bajo\", count_activos_bajo_umbral);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
