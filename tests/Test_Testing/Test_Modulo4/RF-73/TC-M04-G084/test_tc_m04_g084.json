  "item": [
    {
      "name": "01-Login-ADMIN",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var pwd = pm.environment.get(\"admin_password\") || pm.collectionVariables.get(\"admin_password\");",
              "if (pwd) {",
              "    pm.collectionVariables.set(\"admin_password\", pwd);",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"01.01: Login exitoso del Administrador (HTTP 200)\", function () {",
              "    pm.response.to.have.status(200);",
              "    var data = pm.response.json();",
              "    var jwt = data.token || data.access_token;",
              "    pm.expect(jwt, \"Token JWT presente en respuesta\").to.be.a(\"string\").and.not.empty;",
              "    pm.environment.set(\"jwt_admin\", jwt);",
              "    pm.collectionVariables.set(\"jwt_admin\", jwt);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"correo_electronico\":\"administador.dev@gmail.com\",\"contrasena\":\"{{admin_password}}\"}"
        },
        "url": {
          "raw": "{{base_url}}/sesiones/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "sesiones",
            ""
          ]
        }
      }
    },
    {
      "name": "02-Preflight-Bitacora-Accesible",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var runId = pm.environment.get(\"run_id\") || pm.collectionVariables.get(\"run_id\");",
              "if (!runId) {",
              "    runId = \"test-m04-g084-\" + pm.variables.replaceIn('{{$guid}}').substring(0, 8);",
              "    pm.environment.set(\"run_id\", runId);",
              "    pm.collectionVariables.set(\"run_id\", runId);",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"02.01: Preflight exitoso sobre GET /prediccion/auditoria (HTTP 200)\", function () {",
              "    pm.response.to.have.status(200);",
              "    var body = pm.response.json();",
              "    pm.expect(body.total).to.be.at.least(0);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_admin}}"
          },
          {
            "key": "X-Test-Run-Id",
            "value": "{{run_id}}"
          },
          {
            "key": "X-Sandbox-Secret",
            "value": "{{sandbox_secret}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/prediccion/auditoria?por_pagina=1",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "prediccion",
            "auditoria"
          ],
          "query": [
            {
              "key": "por_pagina",
              "value": "1"
            }
          ]
        }
      }
    },
    {
      "name": "03-Sonda-REENTRENAMIENTO_INICIADO-Ausencia-Confirmada",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Hallazgo G084: RF-71 no existe en el backend. Confirmacion empirica de ausencia. Ver .diagnostico/diagnostico_G084.md",
              "pm.test(\"03.01: Confirmar ausencia de REENTRENAMIENTO_INICIADO en backend actual (HTTP 200)\", function () {",
              "    pm.response.to.have.status(200);",
              "    var body = pm.response.json();",
              "    pm.expect(body.total).to.equal(0, \"Confirmado: tipo_evento REENTRENAMIENTO_INICIADO no existe en el backend actual (RF-71 no implementado por decision de alcance)\");",
              "});"
            ]
          }
        }
      ],
