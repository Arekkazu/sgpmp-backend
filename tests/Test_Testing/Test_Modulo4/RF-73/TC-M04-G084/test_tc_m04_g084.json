            "exec": [
              "// Semilla historica (2 eventos CRITICAL, origen_registro=DIRECTO). Motor de drift RF-72 no implementado. Veredicto: BLOQUEADO_POR_DISENO.",
              "pm.test(\"05.01: Documentar estado de DEGRADACION_DETECTADA en auditoria (HTTP 200)\", function () {",
