          "path": [
            "prediccion",
            "retroalimentacion"
          ]
        }
      }
    },
    {
      "name": "09-Subcaso-2-Verificar-Eventos-Conflicto",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var baseUrl = pm.environment.get(\"base_url\") || pm.collectionVariables.get(\"base_url\") || \"https://api.inmero.co/api-sgpmp-test\";",
              "var jwtAdmin = pm.environment.get(\"jwt_admin\") || pm.collectionVariables.get(\"jwt_admin\");",
              "var runId = pm.environment.get(\"run_id\") || pm.collectionVariables.get(\"run_id\");",
              "var inf2Id = pm.environment.get(\"inferencia_2_id\") || pm.collectionVariables.get(\"inferencia_2_id\");",
              "var sandboxSecret = pm.environment.get(\"sandbox_secret\") || pm.collectionVariables.get(\"sandbox_secret\");",
              "",
              "// 9b. Asercion principal sobre respuesta CONFLICTO_RETROALIMENTACION",
              "pm.test(\"09b.01: Status 200 en consulta auditoria CONFLICTO_RETROALIMENTACION\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "var data9b = pm.response.json();",
              "pm.test(\"09b.02: Evento CONFLICTO_RETROALIMENTACION emitido (esperado >= 1)\", function () {",
              "    pm.expect(data9b.total, \"Evento CONFLICTO_RETROALIMENTACION no emitido (esperado por el caso - afectado por bug INC-M04-151-G085)\").to.be.at.least(1);",
              "    if (data9b.items && data9b.items.length > 0) {",
              "        var ev = data9b.items[0];",
              "        pm.expect(ev.severidad_evento).to.eql(\"WARNING\");",
              "        var p = ev.payload_evento || {};",
              "        var num = p.numero_retroalimentaciones || p.total_retroalimentaciones;",
              "        pm.expect(num).to.eql(2);",
              "        if (p.estados_registrados) {",
              "            pm.expect(p.estados_registrados).to.include(\"CORRECTO\");",
              "            pm.expect(p.estados_registrados).to.include(\"INCORRECTO\");",
              "        }",
              "    }",
              "});",
              "",
              "// 9a. Consulta secundaria para verificar retroalimentaciones registradas sobre inferencia 2",
              "pm.sendRequest({",
              "    url: baseUrl + \"/prediccion/auditoria?tipo_evento=RETROALIMENTACION_REGISTRADA&por_pagina=20\",",
              "    method: \"GET\",",
              "    header: {",
              "        \"Authorization\": \"Bearer \" + jwtAdmin,",
              "        \"X-Test-Run-Id\": runId,",
              "        \"X-Sandbox-Secret\": sandboxSecret",
              "    }",
              "}, function (err, res) {",
              "    pm.test(\"09a.01: Status 200 al consultar RETROALIMENTACION_REGISTRADA subcaso 2\", function () {",
              "        pm.expect(err).to.be.null;",
              "        pm.expect(res.code).to.eql(200);",
              "    });",
              "    if (!err && res.code === 200) {",
              "        var body9a = res.json();",
              "        var itemsInf2 = (body9a.items || []).filter(function (it) {",
              "            return it.payload_evento && it.payload_evento.id_resultado_inferencia === inf2Id;",
              "        });",
              "        pm.test(\"09a.02: Al menos 2 eventos para inferencia 2 y flag de conflicto detectado\", function () {",
              "            pm.expect(itemsInf2.length).to.be.at.least(2);",
              "            if (itemsInf2.length >= 2) {",
              "                var masReciente = itemsInf2[0];",
              "                var p = masReciente.payload_evento || {};",
              "                var flag = p.conflicto_retroalimentacion !== undefined ? p.conflicto_retroalimentacion : p.es_conflicto_retroalimentacion;",
              "                pm.expect(flag).to.be.true;",
              "            }",
              "        });",
              "    }",
              "});",
              "",
              "// 9c. Consulta diagnostica para evidencia del bug INC-M04-151-G085 (AUDITORIA_EVENTO_INVALIDO)",
              "pm.sendRequest({",
              "    url: baseUrl + \"/prediccion/auditoria?tipo_evento=AUDITORIA_EVENTO_INVALIDO&por_pagina=10\",",
              "    method: \"GET\",",
              "    header: {",
              "        \"Authorization\": \"Bearer \" + jwtAdmin,",
              "        \"X-Test-Run-Id\": runId,",
              "        \"X-Sandbox-Secret\": sandboxSecret",
              "    }",
              "}, function (err, res) {",
              "    pm.test(\"09c.01: Status 200 consulta diagnostica AUDITORIA_EVENTO_INVALIDO\", function () {",
              "        pm.expect(err).to.be.null;",
              "        pm.expect(res.code).to.eql(200);",
              "    });",
              "    if (!err && res.code === 200) {",
              "        var body9c = res.json();",
              "        var bugDetectado = false;",
              "        var bugPayload = null;",
              "        (body9c.items || []).forEach(function (it) {",
              "            var pStr = JSON.stringify(it.payload_evento || {});",
              "            if (pStr.indexOf(\"numero_retroalimentaciones\") !== -1 || pStr.indexOf(\"total_retroalimentaciones\") !== -1) {",
              "                bugDetectado = true;",
              "                bugPayload = it.payload_evento;",
              "            }",
              "        });",
              "        if (bugDetectado) {",
              "            pm.environment.set(\"bug_reproducido\", \"true\");",
              "            pm.environment.set(\"bug_detalle\", JSON.stringify(bugPayload));",
              "            console.log(\"[BUG DETECTADO INC-M04-151-G085]: AUDITORIA_EVENTO_INVALIDO persistido por discrepancia numero_retroalimentaciones\");",
              "        } else {",
              "            pm.environment.set(\"bug_reproducido\", \"false\");",
              "        }",
              "    }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_admin}}"
          },
          {
            "key": "X-Test-Run-Id",
            "value": "{{run_id}}"
          },
          {
            "key": "X-Sandbox-Secret",
            "value": "{{sandbox_secret}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/prediccion/auditoria?tipo_evento=CONFLICTO_RETROALIMENTACION&por_pagina=10",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "prediccion",
            "auditoria"
          ],
          "query": [
            {
              "key": "tipo_evento",
              "value": "CONFLICTO_RETROALIMENTACION"
            },
            {
              "key": "por_pagina",
              "value": "10"
            }
          ]
        }
      }
    },
