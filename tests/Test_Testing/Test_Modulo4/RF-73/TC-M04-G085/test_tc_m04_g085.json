    {
      "name": "04-Preparar-Sandbox-Inferencias",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var runId = pm.environment.get(\"run_id\") || pm.collectionVariables.get(\"run_id\");",
              "if (!runId) {",
              "    runId = \"test-m04-g085-\" + pm.variables.replaceIn('{{$guid}}');",
              "    pm.environment.set(\"run_id\", runId);",
              "    pm.collectionVariables.set(\"run_id\", runId);",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Item 04: obtener 2 inferencias del activo 876 para las pruebas",
              "pm.test(\"04.01: Endpoint /prediccion/inferencias responde 200\", () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const inferenciasAll = pm.response.json();",
              "pm.test(\"04.02: Endpoint devuelve array de inferencias\", () => {",
              "    pm.expect(Array.isArray(inferenciasAll)).to.be.true;",
              "    pm.expect(inferenciasAll.length).to.be.greaterThan(0);",
              "});",
              "",
              "// IDs de inferencias conocidas LIMPIAS (0 retros preexistentes).",
              "// Confirmados disponibles en TEST según informe forense 2026-10-30.",
              "// El V1 los usó y el sandbox revirtió sus retros.",
              "const IDS_LIMPIOS_CONOCIDOS = [",
              "    \"4d323521-30d4-4e7c-b3e4-6f1a0eadfc16\",",
              "    \"0449292d-c59e-43b5-ab0a-1379fe245b59\",",
              "    \"0d379ba6-93d0-4f79-8450-69367f385ef4\"",
              "];",
              "",
              "const inferenciasActivo876 = inferenciasAll.filter(",
              "    inf => inf.id_activo_biologico === 876",
              ");",
              "",
              "// Priorizar IDs limpios conocidos",
              "const inferenciasLimpias = inferenciasActivo876.filter(",
              "    inf => IDS_LIMPIOS_CONOCIDOS.includes(inf.id_resultado_inferencia)",
              ");",
              "",
              "pm.test(\"04.03: Existe al menos 2 inferencias LIMPIAS (0 retros preexistentes)\", () => {",
              "    pm.expect(inferenciasLimpias.length).to.be.at.least(2,",
              "        `Se encontraron ${inferenciasLimpias.length} inferencias limpias de ${inferenciasActivo876.length} totales del activo 876. ` +",
              "        `Si es < 2, coordinar con DBA/Dev para seed de inferencias limpias.`);",
              "});",
              "",
              "// Ordenar por fecha DESC para tomar las más recientes (por estabilidad)",
              "const inferenciasOrdenadas = inferenciasLimpias.sort(",
              "    (a, b) => new Date(b.fecha_inferencia) - new Date(a.fecha_inferencia)",
              ");",
              "",
              "const inferencia1 = inferenciasOrdenadas[0];",
              "const inferencia2 = inferenciasOrdenadas[1];",
              "",
              "pm.test(\"04.04: inferencia_1_id capturado y limpio\", () => {",
              "    pm.expect(inferencia1).to.not.be.undefined;",
              "    pm.expect(inferencia1.id_resultado_inferencia).to.be.a('string').and.not.empty;",
              "});",
              "",
              "pm.test(\"04.05: inferencia_2_id capturado y limpio\", () => {",
              "    pm.expect(inferencia2).to.not.be.undefined;",
              "    pm.expect(inferencia2.id_resultado_inferencia).to.be.a('string').and.not.empty;",
              "});",
              "",
              "pm.collectionVariables.set(\"inferencia_1_id\", inferencia1.id_resultado_inferencia);",
              "pm.collectionVariables.set(\"inferencia_2_id\", inferencia2.id_resultado_inferencia);",
              "pm.collectionVariables.set(\"inferencia_1_activo\", inferencia1.id_activo_biologico);",
              "pm.collectionVariables.set(\"inferencia_2_activo\", inferencia2.id_activo_biologico);",
              "pm.environment.set(\"inferencia_1_id\", inferencia1.id_resultado_inferencia);",
              "pm.environment.set(\"inferencia_2_id\", inferencia2.id_resultado_inferencia);",
              "pm.environment.set(\"inferencia_1_activo\", inferencia1.id_activo_biologico);",
              "pm.environment.set(\"inferencia_2_activo\", inferencia2.id_activo_biologico);",
              "",
              "console.log(`[ITEM-04] Total inferencias: ${inferenciasAll.length}`);",
              "console.log(`[ITEM-04] Activo 876: ${inferenciasActivo876.length}`);",
              "console.log(`[ITEM-04] Limpias conocidas: ${inferenciasLimpias.length}`);",
              "console.log(`[ITEM-04] inferencia_1_id = ${inferencia1.id_resultado_inferencia}`);",
              "console.log(`[ITEM-04] inferencia_2_id = ${inferencia2.id_resultado_inferencia}`);"
            ]
          }
        }
      ],
