    {
      "name": "06-Subcaso-1-Verificar-Retroalimentacion-Registrada",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"06.01: Status 200 en consulta auditoria RETROALIMENTACION_REGISTRADA\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var body = pm.response.json();",
              "var inf1Id = pm.environment.get(\"inferencia_1_id\") || pm.collectionVariables.get(\"inferencia_1_id\");",
              "var idRetro1 = pm.environment.get(\"id_retro_1\") || pm.collectionVariables.get(\"id_retro_1\");",
              "var idVet1 = pm.environment.get(\"id_vet1\") || pm.collectionVariables.get(\"id_vet1\");",
              "",
              "pm.test(\"06.02: Total eventos RETROALIMENTACION_REGISTRADA >= 1\", function () {",
              "    pm.expect(body.total).to.be.at.least(1);",
              "});",
              "",
              "var items = body.items || [];",
              "var matchItem = items.find(function (it) {",
              "    if (!it) return false;",
              "    var p = it.payload_evento || {};",
              "    return (p.id_resultado_inferencia === inf1Id) || (it.id_referencia === idRetro1);",
              "});",
              "",
              "pm.test(\"06.03: Evento RETROALIMENTACION_REGISTRADA para inferencia 1 localizado\", function () {",
              "    pm.expect(matchItem, \"No se encontro evento para inferencia 1\").to.be.ok;",
              "    if (matchItem) {",
              "        pm.expect(matchItem.tipo_actor).to.eql(\"USUARIO\");",
              "        pm.expect(String(matchItem.id_usuario)).to.eql(String(idVet1));",
              "        pm.expect(matchItem.severidad_evento).to.eql(\"INFO\");",
              "        var p = matchItem.payload_evento || {};",
              "        var flagConflicto = p.conflicto_retroalimentacion !== undefined ? p.conflicto_retroalimentacion : p.es_conflicto_retroalimentacion;",
              "        pm.expect(flagConflicto).to.be.false;",
              "    }",
              "});"
            ]
          }
        }
      ],
