{
  "info": {
    "name": "TC-M04-G089: Limites de paginacion (RF-73)",
    "_postman_id": "a0489001-0000-4000-8000-000000000089",
    "description": "Validación de límites de paginación en auditoría M04: tamaño por defecto (50), tamaño máximo permitido (200) y rechazo por exceso (201) según RF-73.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get(\"run_id\")) {",
          "    pm.collectionVariables.set(\"run_id\", \"test-\" + pm.variables.replaceIn('{{$guid}}'));",
          "}",
          "pm.request.headers.upsert({ key: 'X-Test-Run-Id',  value: pm.collectionVariables.get(\"run_id\") });",
          "pm.request.headers.upsert({ key: 'X-Sandbox-Secret', value: pm.collectionVariables.get(\"sandbox_secret\") });"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.inmero.co/back-sigab-test",
      "type": "string"
    },
    {
      "key": "run_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "sandbox_secret",
      "value": "377ab8a5ddc2e5b7f7fb5b58533329eb6ce7f22b99cbd6ad5ffecf3e05b7f8ff",
      "type": "string"
    },
    {
      "key": "admin_password",
      "value": "",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01-Login-ADMIN",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"NW-01: Autenticación exitosa del Administrador (HTTP 200)\", function () {",
              "    pm.response.to.have.status(200);",
              "    var data = pm.response.json();",
              "    pm.expect(data).to.have.property('token');",
              "    pm.collectionVariables.set('token', data.token);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"correo_electronico\":\"administador.dev@gmail.com\",\"contrasena\":\"{{admin_password}}\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/sesiones/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "sesiones",
            ""
          ]
        }
      }
    },
    {
      "name": "02-TC-M04-273-Paginacion-Default-50",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"TC-M04-273: Consulta sin parametros retorna paginacion por defecto (HTTP 200)\", function () {",
              "    pm.response.to.have.status(200);",
              "    var data = pm.response.json();",
              "    pm.expect(data).to.have.property('por_pagina');",
              "    if (data.por_pagina !== 50) {",
              "        console.log('[DISCREPANCIA] El valor default de por_pagina obtenido es ' + data.por_pagina + ' (esperado: 50)');",
              "    }",
              "    pm.expect(data.por_pagina).to.eql(50);",
              "    pm.expect(data).to.have.property('items');",
              "    pm.expect(Array.isArray(data.items)).to.be.true;",
              "    pm.expect(data.items.length).to.be.at.most(50);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/prediccion/auditoria",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "prediccion",
            "auditoria"
          ]
        }
      }
    },
    {
      "name": "03-TC-M04-274-Paginacion-Maximo-200",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"TC-M04-274: Consulta con por_pagina=200 es aceptada (HTTP 200)\", function () {",
              "    pm.response.to.have.status(200);",
              "    var data = pm.response.json();",
              "    pm.expect(data).to.have.property('por_pagina');",
              "    if (data.por_pagina !== 200) {",
              "        console.log('[DISCREPANCIA] Backend capeó por_pagina a ' + data.por_pagina + ' en vez de permitir 200');",
              "    }",
              "    pm.expect(data.por_pagina).to.eql(200);",
              "    pm.expect(data).to.have.property('items');",
              "    pm.expect(Array.isArray(data.items)).to.be.true;",
              "    pm.expect(data.items.length).to.be.at.most(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/prediccion/auditoria?pagina=1&por_pagina=200",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "prediccion",
            "auditoria"
          ],
          "query": [
            {
              "key": "pagina",
              "value": "1"
            },
            {
              "key": "por_pagina",
              "value": "200"
            }
          ]
        }
      }
    },
    {
      "name": "04-TC-M04-275-Paginacion-Excedida-201-Rechazo",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"TC-M04-275: Consulta con por_pagina=201 es rechazada con error de validacion (HTTP 422 o 400)\", function () {",
              "    if (pm.response.code === 200) {",
              "        pm.expect.fail(\"[DEFECTO CONOCIDO] El sistema aceptó por_pagina=201 con HTTP 200 violando el límite máximo estipulado de 200\");",
              "    }",
              "    pm.expect([400, 422]).to.include(pm.response.code);",
              "    var data = pm.response.json();",
              "    pm.expect(data).to.satisfy(function (d) {",
              "        return d.detail !== undefined || d.codigo !== undefined || d.mensaje !== undefined;",
              "    });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/prediccion/auditoria?pagina=1&por_pagina=201",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "prediccion",
            "auditoria"
          ],
          "query": [
            {
              "key": "pagina",
              "value": "1"
            },
            {
              "key": "por_pagina",
              "value": "201"
            }
          ]
        }
      }
    },
    {
      "name": "05-Teardown-Sandbox-Rollback",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"NW-Teardown: Rollback transaccional exitoso del sandbox (HTTP 200)\", function () {",
              "    pm.response.to.have.status(200);",
              "    var data = pm.response.json();",
              "    var statusMsg = data.status || data.mensaje || \"\";",
              "    pm.expect(statusMsg).to.include(\"Rollback exitoso\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "X-Sandbox-Secret",
            "value": "{{sandbox_secret}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/test-control/runs/{{run_id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "test-control",
            "runs",
            "{{run_id}}"
          ]
        }
      }
    }
  ]
}