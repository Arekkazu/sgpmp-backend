{
  "info": {
    "name": "TC-M04-G091: Resiliencia - Fallback backend y edge (RF-73)",
    "_postman_id": "a0491001-0000-4000-8000-000000000091",
    "description": "Diseño de pruebas para validar resiliencia de bitácora bajo caída de base de datos y corte de red en Edge con sincronización diferida (RF-73).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get(\"run_id\")) {",
          "    pm.collectionVariables.set(\"run_id\", \"test-\" + pm.variables.replaceIn('{{$guid}}'));",
          "}",
          "pm.request.headers.upsert({ key: 'X-Test-Run-Id',  value: pm.collectionVariables.get(\"run_id\") });",
          "pm.request.headers.upsert({ key: 'X-Sandbox-Secret', value: pm.collectionVariables.get(\"sandbox_secret\") });"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.inmero.co/back-sigab-test",
      "type": "string"
    },
    {
      "key": "run_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "sandbox_secret",
      "value": "377ab8a5ddc2e5b7f7fb5b58533329eb6ce7f22b99cbd6ad5ffecf3e05b7f8ff",
      "type": "string"
    },
    {
      "key": "admin_password",
      "value": "",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01-Login-ADMIN",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"NW-01: Autenticación exitosa del Administrador (HTTP 200)\", function () {",
              "    pm.response.to.have.status(200);",
              "    var data = pm.response.json();",
              "    pm.expect(data).to.have.property('token');",
              "    pm.collectionVariables.set('token', data.token);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"correo_electronico\":\"administador.dev@gmail.com\",\"contrasena\":\"{{admin_password}}\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/sesiones/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "sesiones",
            ""
          ]
        }
      }
    },
    {
      "name": "02-TC-M04-281-Verificar-Eventos-Fallback",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"TC-M04-281: Consulta de eventos generados bajo fallback (HTTP 200)\", function () {",
              "    pm.expect(pm.response.code).to.eql(200);",
              "    var data = pm.response.json();",
              "    pm.expect(data).to.have.property('items');",
              "    var fallbackItems = (data.items || []).filter(function (it) {",
              "        return it.origen_registro === 'FALLBACK';",
              "    });",
              "    if (fallbackItems.length === 0) {",
              "        console.log('[LIMITACION API] No existen eventos FALLBACK en entorno estable; verificación reservada a la fase de infraestructura con caída de BD inducida.');",
              "    } else {",
              "        fallbackItems.forEach(function (it) {",
              "            pm.expect(it.origen_registro).to.eql('FALLBACK');",
              "            pm.expect(it).to.have.property('fecha_evento');",
              "        });",
              "    }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/prediccion/auditoria?pagina=1&por_pagina=50",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "prediccion",
            "auditoria"
          ],
          "query": [
            {
              "key": "pagina",
              "value": "1"
            },
            {
              "key": "por_pagina",
              "value": "50"
            }
          ]
        }
      }
    },
    {
      "name": "03-TC-M04-282-Sincronizacion-FIFO-Fallback",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"TC-M04-282: Eventos de fallback sincronizados preservan orden cronológico FIFO (HTTP 200)\", function () {",
              "    pm.expect(pm.response.code).to.eql(200);",
              "    var data = pm.response.json();",
              "    var fallbackItems = (data.items || []).filter(function (it) {",
              "        return it.origen_registro === 'FALLBACK';",
              "    });",
              "    if (fallbackItems.length < 2) {",
              "        console.log('[LIMITACION API] Datos insuficientes de fallback (<2 eventos) para verificar monotonía FIFO; precondición de caída no ejecutada.');",
              "    } else {",
              "        for (var i = 1; i < fallbackItems.length; i++) {",
              "            var tPrev = new Date(fallbackItems[i - 1].fecha_evento).getTime();",
              "            var tCurr = new Date(fallbackItems[i].fecha_evento).getTime();",
              "            pm.expect(tCurr).to.be.at.least(tPrev);",
              "        }",
              "    }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/prediccion/auditoria?pagina=1&por_pagina=50",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "prediccion",
            "auditoria"
          ],
          "query": [
            {
              "key": "pagina",
              "value": "1"
            },
            {
              "key": "por_pagina",
              "value": "50"
            }
          ]
        }
      }
    },
    {
      "name": "04-TC-M04-283-Preservacion-Timestamp-Original",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"TC-M04-283: Preservación del timestamp original de captura en eventos sincronizados (HTTP 200)\", function () {",
              "    pm.expect(pm.response.code).to.eql(200);",
              "    var data = pm.response.json();",
              "    var fallbackItems = (data.items || []).filter(function (it) {",
              "        return it.origen_registro === 'FALLBACK';",
              "    });",
              "    if (fallbackItems.length === 0) {",
              "        console.log('[LIMITACION API] Precondición de datos ausente; verificación reservada a post-sincronización en fase de infraestructura.');",
              "    } else {",
              "        fallbackItems.forEach(function (it) {",
              "            pm.expect(it.fecha_evento).to.be.a('string');",
              "            var d = new Date(it.fecha_evento);",
              "            pm.expect(isNaN(d.getTime())).to.be.false;",
              "        });",
              "    }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/prediccion/auditoria?pagina=1&por_pagina=50",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "prediccion",
            "auditoria"
          ],
          "query": [
            {
              "key": "pagina",
              "value": "1"
            },
            {
              "key": "por_pagina",
              "value": "50"
            }
          ]
        }
      }
    },
    {
      "name": "05-TC-M04-284-Fallback-Edge-Sincronizacion-Diferida",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"TC-M04-284: Auditoría de eventos procedentes de Edge buffer diferido (HTTP 200)\", function () {",
              "    pm.expect(pm.response.code).to.eql(200);",
              "    var data = pm.response.json();",
              "    var edgeItems = (data.items || []).filter(function (it) {",
              "        return it.origen_registro === 'EDGE';",
              "    });",
              "    if (edgeItems.length === 0) {",
              "        console.log('[PENDIENTE_DEV] TC-M04-284: Buffer local Edge / agente de sincronización diferida (72h) en desarrollo. Precondición de red Edge requerida.');",
              "    } else {",
              "        edgeItems.forEach(function (it) {",
              "            pm.expect(it.origen_registro).to.eql('EDGE');",
              "            pm.expect(it).to.have.property('hash_evento');",
              "        });",
              "    }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/prediccion/auditoria?pagina=1&por_pagina=50",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "prediccion",
            "auditoria"
          ],
          "query": [
            {
              "key": "pagina",
              "value": "1"
            },
            {
              "key": "por_pagina",
              "value": "50"
            }
          ]
        }
      }
    },
    {
      "name": "06-Teardown-Sandbox-Rollback",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"NW-Teardown: Rollback transaccional exitoso del sandbox (HTTP 200)\", function () {",
              "    pm.response.to.have.status(200);",
              "    var data = pm.response.json();",
              "    var statusMsg = data.status || data.mensaje || \"\";",
              "    pm.expect(statusMsg).to.include(\"Rollback exitoso\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "X-Sandbox-Secret",
            "value": "{{sandbox_secret}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/test-control/runs/{{run_id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "test-control",
            "runs",
            "{{run_id}}"
          ]
        }
      }
    }
  ]
}