      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"TC-M04-285: Consulta de auditoría por correlacion_id (HTTP 200)\", function () {",
              "    pm.expect(pm.response.code).to.eql(200);",
              "    var data = pm.response.json();",
              "    var items = (data.items || []).filter(function (e) {",
              "        return String(e.correlacion_id).toLowerCase() === String(pm.collectionVariables.get('correlacion_id')).toLowerCase();",
              "    });",
              "    if (items.length < 3) {",
              "        console.log('[PENDIENTE_DEV] TC-M04-285: Menos de 3 eventos correlacionados en auditoría (productores en desarrollo). Contrato esperado: flujo completo inferencia -> alerta -> retroalimentación con mismo correlacion_id.');",
              "    } else {",
              "        pm.expect(items.length).to.eql(3);",
              "        var tipos = items.map(function(e) { return e.tipo_evento; });",
              "        pm.expect(tipos).to.include('INFERENCIA_EJECUTADA');",
              "        pm.expect(tipos).to.include('ALERTA_PREDICCION_GENERADA');",
              "        pm.expect(tipos).to.include('RETROALIMENTACION_REGISTRADA');",
              "    }",
              "});"
            ]
          }
        }
