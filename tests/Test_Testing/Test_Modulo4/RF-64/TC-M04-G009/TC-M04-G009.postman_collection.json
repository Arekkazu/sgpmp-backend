    {
      "name": "2. TC-M04-032 Mass assignment de es_base / version_catalogo",
      "item": [
        {
          "name": "TC-M04-032 - Crear enviando es_base=true y version_catalogo=999",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const ok = pm.response.code === 201;",
                  "pm.test('TC-M04-032: los campos de servidor se ignoran (201) o se rechazan (400/422)', function () {",
                  "  pm.expect(ok || [400, 422].includes(pm.response.code), 'HTTP ' + pm.response.code).to.eql(true);",
                  "});",
                  "if (ok) {",
                  "  const p = pm.response.json();",
                  "  pm.test('TC-M04-032: se crea con es_base=false', function () { pm.expect(p.es_base).to.eql(false); });",
                  "  pm.test('TC-M04-032: versión calculada por el backend (1), no 999', function () { pm.expect(p.version_catalogo).to.eql(1); });",
                  "  pm.test('TC-M04-032: activa e id propio (no los enviados)', function () { pm.expect(p.es_activo).to.eql(true); pm.expect(p.id_patologia).to.not.eql(1); });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_vet}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/prediccion/patologias",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "prediccion",
                "patologias"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre_patologia\": \"Asignacion Masiva {{sufijo}}\",\n  \"especie_aplicable\": \"{{id_especie}}\",\n  \"variables_sensoricas_asociadas\": [13, 15],\n  \"descripcion_clinica\": \"Cuadro clínico de prueba con alteración sostenida de las variables fisiológicas asociadas durante horas.\",\n  \"es_base\": true,\n  \"version_catalogo\": 999,\n  \"es_activo\": false,\n  \"id_patologia\": 1\n}",
              "options": {
