              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Catálogo responde 200', function () { pm.response.to.have.status(200); });",
                  "const items = pm.response.json().items || [];",
                  "pm.test('Solo se agregaron las 2 combinaciones válidas (bovino y porcino)', function () {",
                  "  pm.expect(items.length).to.eql(Number(pm.collectionVariables.get('total_antes')) + 2);",
                  "});",
                  "const suf = pm.collectionVariables.get('sufijo').toLowerCase();",
                  "const delCaso = items.filter(p => p.nombre_patologia.toLowerCase().replace(/\\s+/g, ' ').includes(suf));",
                  "pm.test('Del caso solo existen la referencia y las 2 combinaciones', function () {",
                  "  pm.expect(delCaso.map(p => p.id_patologia).sort((a, b) => a - b)).to.eql(",
                  "    ['id_referencia', 'id_combo_bovino', 'id_combo_porcino'].map(k => Number(pm.collectionVariables.get(k))).sort((a, b) => a - b));",
                  "});"
                ]
              }
            }
