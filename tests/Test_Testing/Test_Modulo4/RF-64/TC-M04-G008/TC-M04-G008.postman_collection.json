        {
          "name": "TC-M04-028 - Ninguna de las tres patologías existe en el catálogo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Catálogo responde 200', function () { pm.response.to.have.status(200); });",
                  "const suf = pm.collectionVariables.get('sufijo');",
                  "pm.test('TC-M04-028: no se creó ninguna patología del caso', function () {",
                  "  pm.expect((pm.response.json().items || []).filter(p => p.nombre_patologia.endsWith(suf)).map(p => p.nombre_patologia)).to.eql([]);",
                  "});"
