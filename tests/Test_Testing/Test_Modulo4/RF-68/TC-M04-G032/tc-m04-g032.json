    {
      "name": "0B. Precondicion: existe el endpoint de ejecucion (si no, el caso queda BLOQUEADO)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Precondicion: el endpoint de ejecucion existe. Si responde 404/405 el caso queda BLOQUEADO (funcionalidad no implementada) y las peticiones que dependen de el se omiten.",
              "var _rvar = 'ruta_contagio';",
              "var _cands = [\"/prediccion/riesgo-contagio\", \"/prediccion/contagio\", \"/prediccion/riesgo-contagio/calcular\", \"/prediccion/contagio/calcular\", \"/prediccion/estimar-contagio\"];",
              "var _base = pm.collectionVariables.get('base_url');",
              "var _tok = pm.collectionVariables.get('token_admin');",
              "var _rid = pm.variables.get('run_id'); var _sec = pm.variables.get('sandbox_secret') || '';",
              "var _faltan = function (c) { return c === 404 || c === 405; };",
              "var _resumen = [];",
              "var _final = function (existe, ruta) {",
              "    pm.collectionVariables.set('endpoint_disponible', existe ? 'true' : 'false');",
              "    if (existe && ruta) { pm.collectionVariables.set(_rvar, ruta); }",
              "    console.log('[TC-M04-G032 0B] endpoint ' + (existe ? ('DISPONIBLE en ' + ruta) : 'NO DISPONIBLE') + ' | probados: ' + _resumen.join(' ; '));",
              "    pm.test('0B. Existe el endpoint de ejecucion (POST distinto de 404/405). Si falla: caso BLOQUEADO, funcionalidad no implementada', function () {",
              "        pm.expect(existe, 'Ninguna ruta candidata existe: ' + _resumen.join(' ; ')).to.eql(true);",
              "    });",
              "};",
              "_resumen.push(pm.collectionVariables.get(_rvar) + ' -> ' + pm.response.code);",
              "if (!_faltan(pm.response.code)) {",
              "    _final(true, pm.collectionVariables.get(_rvar));",
              "} else {",
              "    var _i = 0;",
              "    var _sig = function () {",
              "        if (_i >= _cands.length) { _final(false, null); return; }",
              "        var _r = _cands[_i++];",
              "        if (_r === pm.collectionVariables.get(_rvar)) { _sig(); return; }",
              "        pm.sendRequest({ url: _base + _r, method: 'POST', header: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + _tok, 'X-Test-Run-Id': _rid, 'X-Sandbox-Secret': _sec }, body: { mode: 'raw', raw: '{}' } }, function (err, res) {",
              "            var _c = err ? 0 : res.code;",
              "            _resumen.push(_r + ' -> ' + (err ? 'error' : _c));",
              "            if (!err && !_faltan(_c)) { _final(true, _r); } else { _sig(); }",
              "        });",
              "    };",
              "    _sig();",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
