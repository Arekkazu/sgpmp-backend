              "script": {
                "type": "text/javascript",
                "exec": [
                  "const _n = Date.now(); const _iso = (ms) => new Date(ms).toISOString();",
                  "pm.variables.set('ts_now', _iso(_n));",
                  "pm.variables.set('ts_m1s', _iso(_n - 1000));",
                  "pm.variables.set('ts_m10m', _iso(_n - 10*60000));",
                  "pm.variables.set('ts_m20m', _iso(_n - 20*60000));",
                  "pm.variables.set('ts_m31m', _iso(_n - 31*60000));",
                  "pm.variables.set('ts_p1h', _iso(_n + 3600000));",
                  "pm.variables.set('ts_p10m', _iso(_n + 10*60000));",
                  "pm.variables.set('uniq', String(_n).slice(-9));",
                  "const _d = (n) => new Date(Date.now() - n*864e5).toISOString().slice(0,10);",
                  "pm.variables.set('hoy', _d(0)); pm.variables.set('ayer', _d(1)); pm.variables.set('manana', _d(-1));",
                  "pm.variables.set('hoy_m30', _d(30)); pm.variables.set('hoy_m89', _d(89)); pm.variables.set('hoy_m90', _d(90)); pm.variables.set('hoy_m91', _d(91)); pm.variables.set('hoy_m60', _d(60));",
                  "if (!pm.collectionVariables.get('periodo_ini')) pm.variables.set('periodo_ini', _d(30)); else pm.variables.set('periodo_ini', pm.collectionVariables.get('periodo_ini'));",
                  "if (!pm.collectionVariables.get('periodo_fin')) pm.variables.set('periodo_fin', _d(0)); else pm.variables.set('periodo_fin', pm.collectionVariables.get('periodo_fin'));",
                  "pm.collectionVariables.set('t0_g031', new Date(Date.now() - 2000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Se omite si el endpoint de ejecucion no existe (ver 0B): sin esto un 404 o una lista vacia daria resultados enganosos.",
                  "if (pm.collectionVariables.get('endpoint_disponible') !== 'true') {",
                  "    pm.test.skip('Omitido: el endpoint de ejecucion no existe (ver 0B)');",
                  "} else {",
                  "console.log('[TC-M04-G031 1.1] status=' + pm.response.code + ' t=' + pm.response.responseTime + 'ms body=' + pm.response.text().slice(0, 600));",
                  "let J; try { J = pm.response.json(); } catch (e) { J = {}; }",
                  "pm.test('HTTP en 200/201', function () { pm.expect([200, 201]).to.include(pm.response.code); });",
                  "const R = (J && J.resultado) ? J.resultado : (J || {});",
                  "const _w = R.pesos_aplicados || R.pesos || {};",
                  "pm.test('Pesos recalculados proporcionalmente: nuevo_W_fa = 0.60', function () { pm.expect(Math.abs(Number(_w.w_fa !== undefined ? _w.w_fa : _w.w_factor_ambiental) - 0.60)).to.be.below(0.0005); });",
                  "pm.test('Pesos recalculados proporcionalmente: nuevo_W_fd = 0.40', function () { pm.expect(Math.abs(Number(_w.w_fd !== undefined ? _w.w_fd : _w.w_factor_densidad) - 0.40)).to.be.below(0.0005); });",
                  "pm.test(\"P_contagio = 0.60 x 0.90 + 0.40 x 0.95 = 0.92\", function () { pm.expect(Math.abs(Number(Number(R.probabilidad_contagio)) - 0.92)).to.be.below(0.0005); });",
                  "pm.test(\"nivel_riesgo_contagio = Alto\", function () { pm.expect(String(R.nivel_riesgo_contagio).toLowerCase()).to.eql(\"alto\"); });",
                  "pm.test(\"confianza_baja = true\", function () { pm.expect(R.confianza_baja).to.eql(true); });",
                  "pm.test(\"alerta_id vacio (no se dispara alerta hacia RF-57)\", function () { pm.expect((R.alerta_id || R.id_alerta || (R.alerta && (R.alerta.id_alerta || R.alerta.id)) || null) === null).to.be.true; });",
                  "}"
                ]
              }
            }
          ]
        },
        {
