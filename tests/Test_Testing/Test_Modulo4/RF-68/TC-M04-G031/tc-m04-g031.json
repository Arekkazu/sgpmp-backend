                  "pm.variables.set('uniq', String(_n).slice(-9));",
                  "const _d = (n) => new Date(Date.now() - n*864e5).toISOString().slice(0,10);",
                  "pm.variables.set('hoy', _d(0)); pm.variables.set('ayer', _d(1)); pm.variables.set('manana', _d(-1));",
                  "pm.variables.set('hoy_m30', _d(30)); pm.variables.set('hoy_m89', _d(89)); pm.variables.set('hoy_m90', _d(90)); pm.variables.set('hoy_m91', _d(91)); pm.variables.set('hoy_m60', _d(60));",
                  "if (!pm.collectionVariables.get('periodo_ini')) pm.variables.set('periodo_ini', _d(30)); else pm.variables.set('periodo_ini', pm.collectionVariables.get('periodo_ini'));",
                  "if (!pm.collectionVariables.get('periodo_fin')) pm.variables.set('periodo_fin', _d(0)); else pm.variables.set('periodo_fin', pm.collectionVariables.get('periodo_fin'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Se omite si el endpoint de ejecucion no existe (ver 0B): sin esto un 404 o una lista vacia daria resultados enganosos.",
                  "if (pm.collectionVariables.get('endpoint_disponible') !== 'true') {",
                  "    pm.test.skip('Omitido: el endpoint de ejecucion no existe (ver 0B)');",
                  "} else {",
                  "console.log('[TC-M04-G031 1.2] status=' + pm.response.code + ' t=' + pm.response.responseTime + 'ms body=' + pm.response.text().slice(0, 600));",
                  "let J; try { J = pm.response.json(); } catch (e) { J = {}; }",
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "// No se filtra por tipo_alerta=RIESGO_CONTAGIO: ese valor no esta en el enum de la BD y hoy hace responder 500 (error ya reportado en G78).",
                  "pm.test('Ninguna alerta RIESGO_CONTAGIO posterior a la ejecucion 1.1 (confianza_baja suprime la alerta, CA-5)', function () {",
                  "    const gen = (J.items || []).filter(function (a) { return a.tipo_alerta === 'RIESGO_CONTAGIO'; });",
                  "    pm.expect(gen.length, 'alertas RIESGO_CONTAGIO generadas: ' + JSON.stringify(gen.map(function (a) { return a.id_alerta; }))).to.eql(0);",
                  "});",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Z. Teardown del sandbox - DELETE /test-control/runs/{{run_id}} (rollback)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
