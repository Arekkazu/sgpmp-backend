                  "const R = (J && J.resultado) ? J.resultado : (J || {});",
                  "pm.test('Fd se calcula con el historico de 30 dias: 9.5/15 = 0.6333', function () { const fd = R.factor_densidad !== undefined ? R.factor_densidad : R.fd; pm.expect(Math.abs(Number(fd) - 0.6333)).to.be.below(0.001); });",
                  "console.log('[TC-M04-G029][OBSERVADO] fuente_densidad=' + (R.fuente_densidad || R.origen_densidad));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Z. Restaurar configuracion del motor (valores previos al caso)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "  let snap = []; try { snap = JSON.parse(pm.collectionVariables.get('cfg_snapshot') || '[]'); } catch (e) {}",
              "  const base = pm.variables.replaceIn('{{base_url}}'); const tk = pm.collectionVariables.get('token_admin');",
              "  const hdr = {'Content-Type': 'application/json', 'Authorization': 'Bearer ' + tk};",
              "  const tocar = JSON.parse(pm.collectionVariables.get('cfg_tocados') || '[]');",
              "  snap.filter(function (c) { return tocar.indexOf(c.tipo_modelo) >= 0; }).forEach(function (c) {",
              "    Object.keys(c).forEach(function (k) { if (c[k] === null || c[k] === undefined) { delete c[k]; } });",
              "    pm.sendRequest({url: base + '/prediccion/motor-ia', method: 'POST', header: hdr, body: {mode: 'raw', raw: JSON.stringify(c)}}, function (e, r) { console.log('[TC-M04-G029] restaurar config ' + c.tipo_modelo + ' -> ' + (r ? r.code : 'sin respuesta')); });",
              "  });",
              "  console.log('[TC-M04-G029] configuracion restaurada para: ' + tocar.join(', '));",
              "  pm.collectionVariables.set('cfg_tocados', '[]');",
              "})();",
              "pm.test('Restauracion de configuracion ejecutada', function () { pm.expect(true).to.be.true; });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_admin}}"
          }
        ],
        "url": "{{base_url}}/prediccion/motor-ia"
      }
    }
  ]
}