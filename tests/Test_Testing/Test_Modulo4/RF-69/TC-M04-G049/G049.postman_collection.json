        { "key": "archivo_modelo", "src": "{{onnx_path}}", "type": "file" }
      ] }, "url": "{{base_url}}/prediccion/modelos" },
      "event": [
        { "listen": "prerequest", "script": { "type": "text/javascript", "exec": ["const b=pm.environment.get('base_url')||'';if(pm.environment.get('autorizado_run')!=='SI'||!pm.environment.get('run_id')||!(b==='https://www.api.inmero.co/api-sgpmp-test'||(pm.environment.get('ensayo_loopback')==='SI'&&/^http:\\/\\/(127\\.0\\.0\\.1|localhost):[0-9]+$/.test(b)))){pm.execution.skipRequest();throw Error('BLOQUEO_G049');}"] } },
        { "listen": "test", "script": { "type": "text/javascript", "exec": ["let x={};try{x=pm.response.json()}catch{};const id=x.id_version??x.id_version_modelo;pm.environment.set('version_1',String(id??''));if(pm.response.code===200||pm.response.code===201)pm.test('ID_UUID',()=>pm.expect(id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i));"] } }
      ]
