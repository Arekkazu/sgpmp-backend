{
  "info": {
    "name": "TC-M02-G113 - Fecha futura en evento de crecimiento (RF-40: HTTP 400)",
    "description": "RF-40, flujo alterno \"Fecha invalida - HTTP 400\". Brecha de cobertura detectada en la revision del RFC.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0A. Login admin.test",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('fecha_hoy', new Date().toISOString().slice(0,10));",
              "pm.collectionVariables.set('rid', String(Date.now()));",
              "pm.collectionVariables.set('fecha_inicio', new Date(Date.now() - 0*86400000).toISOString().slice(0,10));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login exitoso (200)', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) { pm.collectionVariables.set('token_admin', pm.response.json().token); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/sesiones/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"{{correo_admin}}\",\n  \"contrasena\": \"{{contrasena_admin}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "0B. Setup - activo INDIVIDUAL propio Macho (nace ACTIVO)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Activo creado (201)', function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) { pm.collectionVariables.set('id_activo', pm.response.json().id_activo_biologico); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token_admin}}"
          }
        ],
        "url": "{{base_url}}/activos-biologicos",
        "body": {
          "mode": "raw",
          "raw": "{\n \"tipo_activo\":\"INDIVIDUAL\",\"id_especie\":{{id_especie}},\"fecha_inicio_ciclo\":\"{{fecha_inicio}}\",\"origen_financiero\":\"nacimiento\",\"id_infraestructura\":{{id_infraestructura}},\"identificador\":\"QA-G113-M-{{rid}}\",\"raza\":\"QA G113\",\"sexo\":\"Macho\",\"fecha_nacimiento\":\"2025-01-15T00:00:00Z\",\"peso_inicial\":2.5\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "0C. Setup - registrar fase productiva activa (RF-37) Macho",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Fase registrada (201)', function () { pm.response.to.have.status(201); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token_admin}}"
          }
        ],
        "url": "{{base_url}}/activos-biologicos/{{id_activo}}/fases",
        "body": {
          "mode": "raw",
          "raw": "{ \"id_ciclo_productiva\": {{id_ciclo_productiva}}, \"motivo_cambio\": \"QA G113 fase activa\" }",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "TC-M02-327 - Rechazar evento de crecimiento con fecha futura",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('fecha_futura', new Date(Date.now() + 86400000).toISOString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "console.log('[TC-M02-327] status=' + pm.response.code + ' body=' + pm.response.text());",
              "pm.test('TC-M02-327 - RF-40 fecha futura: HTTP 400', function () { pm.response.to.have.status(400); });",
              "let b; try { b = pm.response.json(); } catch (e) { b = {}; }",
              "pm.test('TC-M02-327 - RF-40 fecha futura: mensaje esperado', function () { pm.expect(String(b.message || '')).to.match(/fecha del evento/i); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token_admin}}"
          }
        ],
        "url": "{{base_url}}/activos-biologicos/{{id_activo}}/eventos/crecimiento",
        "body": {
          "mode": "raw",
          "raw": "{ \"tipo_medicion\": \"PESO\", \"valor_medicion\": 250, \"unidad_medida\": \"kg\", \"fecha\": \"{{fecha_futura}}\", \"descripcion\": \"QA RFC TC-M02-327: fecha futura\" }",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "https://api.inmero.co/back-sigab-test"
    },
    {
      "key": "correo_admin",
      "value": "admin.test@sgpmp.com.co"
    },
    {
      "key": "contrasena_admin",
      "value": "Administrador123#"
    },
    {
      "key": "token_admin",
      "value": ""
    },
    {
      "key": "id_especie",
      "value": "3"
    },
    {
      "key": "id_infraestructura",
      "value": "6"
    },
    {
      "key": "id_ciclo_productiva",
      "value": "2"
    },
    {
      "key": "id_activo",
      "value": ""
    },
    {
      "key": "rid",
      "value": ""
    },
    {
      "key": "fecha_inicio",
      "value": ""
    }
  ]
}