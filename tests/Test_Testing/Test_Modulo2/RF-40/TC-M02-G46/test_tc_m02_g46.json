                "url": "https://sigab-backendtest-389pcb-a48238-158-69-200-27.sslip.io/api-sgpmp-test/activos-biologicos/291/eventos/crecimiento",
                "body": {
                  "mode": "raw",
                  "raw": "{\"tipo_medicion\": \"PESO\", \"valor_medicion\": 250, \"unidad_medida\": \"kg\", \"fecha\": \"2026-08-10T10:00:00Z\", \"descripcion\": \"TC-M02-087 Productor\"}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Rechazo funcional 4xx',()=>pm.expect(pm.response.code).to.be.within(400,499));",
                      "pm.test('No es un fallo de autenticacion o acceso',()=>pm.expect([401,403,404]).not.to.include(pm.response.code));",
                      "const text=pm.response.text().normalize('NFD').replace(/[\\u0300-\\u036f]/g,'').toLowerCase();",
                      "pm.test('Motivo corresponde a la regla',()=>pm.expect(text).to.match(/fecha|cronolog|anterior|ultimo/));",
                      "pm.test('Fecha oficial en campo contractual fecha',()=>pm.expect(JSON.parse(pm.request.body.raw).fecha).to.eql('2026-08-10T10:00:00Z'));",
                      "pm.test('Medicion valida y sin agregacion para INDIVIDUAL',()=>{const b=JSON.parse(pm.request.body.raw);pm.expect(b.tipo_medicion).to.eql('PESO');pm.expect(b.valor_medicion).to.eql(250);pm.expect(b.unidad_medida).to.eql('kg');pm.expect(b).not.to.have.property('tipo_agregacion');});"
                    ]
                  }
                }
              ]
