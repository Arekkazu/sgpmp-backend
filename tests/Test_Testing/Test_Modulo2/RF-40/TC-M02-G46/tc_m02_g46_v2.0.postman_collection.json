{
  "info": {
    "name": "TC-M02-G46 v2.0 - Coherencia temporal del crecimiento (RF-40: fecha inconsistente = HTTP 400)",
    "description": "v2.0: TC-M02-087 con codigo y mensaje del flujo alterno de RF-40 (400). Autocontenida: crea su propio activo. Datos de TEST (2026-10-02): especie 4 Cachama Blanca (tiene la metrica Peso/PESO/kg en RF-16), infraestructura 8, id_ciclo_productiva 10 (Ciclo QA JE Bovino, fase unica).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0A. Login admin.test",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('fecha_hoy', new Date().toISOString().slice(0,10));",
              "pm.collectionVariables.set('rid', String(Date.now()));",
              "pm.collectionVariables.set('fecha_inicio', new Date(Date.now() - 0*86400000).toISOString().slice(0,10));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login exitoso (200)', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) { pm.collectionVariables.set('token_admin', pm.response.json().token); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/sesiones/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"{{correo_admin}}\",\n  \"contrasena\": \"{{contrasena_admin}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "0B. Setup - activo INDIVIDUAL propio Macho (nace ACTIVO)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Activo creado (201)', function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) { pm.collectionVariables.set('id_activo', pm.response.json().id_activo_biologico); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token_admin}}"
          }
        ],
        "url": "{{base_url}}/activos-biologicos",
        "body": {
          "mode": "raw",
          "raw": "{\n \"tipo_activo\":\"INDIVIDUAL\",\"id_especie\":{{id_especie}},\"fecha_inicio_ciclo\":\"{{fecha_inicio}}\",\"origen_financiero\":\"nacimiento\",\"id_infraestructura\":{{id_infraestructura}},\"identificador\":\"QA-G46-M-{{rid}}\",\"raza\":\"QA G46\",\"sexo\":\"Macho\",\"fecha_nacimiento\":\"2025-01-15T00:00:00Z\",\"peso_inicial\":2.5\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "0C. Setup - registrar fase productiva activa (RF-37) Macho",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Fase registrada (201)', function () { pm.response.to.have.status(201); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token_admin}}"
          }
        ],
        "url": "{{base_url}}/activos-biologicos/{{id_activo}}/fases",
        "body": {
          "mode": "raw",
          "raw": "{ \"id_ciclo_productiva\": {{id_ciclo_productiva}}, \"motivo_cambio\": \"QA G46 fase activa\" }",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Setup - esperar que el activo quede registrado (1.5 s)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "setTimeout(function () {}, 1500);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Activo consultable (200)', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token_admin}}"
          }
        ],
        "url": "{{base_url}}/activos-biologicos/{{id_activo}}"
      }
    },
    {
      "name": "Control - primer registro de crecimiento (fecha = ahora)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('fecha_t1', new Date(Date.now() - 300).toISOString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "console.log('[Control] status=' + pm.response.code + ' body=' + pm.response.text());",
              "pm.test('Control - primer registro valido: HTTP 201', function () { pm.response.to.have.status(201); });",
              "let b; try { b = pm.response.json(); } catch (e) { b = {}; }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token_admin}}"
          }
        ],
        "url": "{{base_url}}/activos-biologicos/{{id_activo}}/eventos/crecimiento",
        "body": {
          "mode": "raw",
          "raw": "{ \"tipo_medicion\": \"PESO\", \"valor_medicion\": 250, \"unidad_medida\": \"kg\", \"fecha\": \"{{fecha_t1}}\", \"descripcion\": \"QA RFC G46 control\" }",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "TC-M02-087 - Rechazar fecha anterior al ultimo registro de crecimiento",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('fecha_t0', new Date(Date.now() - 1000).toISOString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "console.log('[TC-M02-087] status=' + pm.response.code + ' body=' + pm.response.text());",
              "pm.test('TC-M02-087 - RF-40 fecha anterior al ultimo registro: HTTP 400', function () { pm.response.to.have.status(400); });",
              "let b; try { b = pm.response.json(); } catch (e) { b = {}; }",
              "pm.test('TC-M02-087 - RF-40 fecha anterior al ultimo registro: mensaje esperado', function () { pm.expect(String(b.message || '')).to.match(/fecha del evento es inv[aá]lida o inconsistente con el historial/i); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token_admin}}"
          }
        ],
        "url": "{{base_url}}/activos-biologicos/{{id_activo}}/eventos/crecimiento",
        "body": {
          "mode": "raw",
          "raw": "{ \"tipo_medicion\": \"PESO\", \"valor_medicion\": 260, \"unidad_medida\": \"kg\", \"fecha\": \"{{fecha_t0}}\", \"descripcion\": \"QA RFC TC-M02-087: fecha anterior al ultimo registro\" }",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "https://api.inmero.co/back-sigab-test"
    },
    {
      "key": "correo_admin",
      "value": "admin.test@sgpmp.com.co"
    },
    {
      "key": "contrasena_admin",
      "value": "Administrador123#"
    },
    {
      "key": "token_admin",
      "value": ""
    },
    {
      "key": "id_especie",
      "value": "4"
    },
    {
      "key": "id_infraestructura",
      "value": "8"
    },
    {
      "key": "id_ciclo_productiva",
      "value": "10"
    },
    {
      "key": "id_activo",
      "value": ""
    },
    {
      "key": "rid",
      "value": ""
    },
    {
      "key": "fecha_inicio",
      "value": ""
    }
  ]
}