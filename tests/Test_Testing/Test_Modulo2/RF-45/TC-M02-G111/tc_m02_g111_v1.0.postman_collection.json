{
  "info": {
    "name": "TC-M02-G111 - Fecha de baja: futura y anterior al ultimo evento (RF-45: HTTP 400)",
    "description": "RF-45, flujo alterno \"Inconsistencia en la fecha de baja - HTTP 400\". Brecha de cobertura detectada en la revision del RFC. Datos de TEST (2026-10-02): especie 4 Cachama Blanca (tiene la metrica Peso/PESO/kg en RF-16), infraestructura 8, id_ciclo_productiva 10 (Ciclo QA JE Bovino, fase unica).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0A. Login admin.test",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('fecha_hoy', new Date().toISOString().slice(0,10));",
              "pm.collectionVariables.set('rid', String(Date.now()));",
              "pm.collectionVariables.set('fecha_inicio', new Date(Date.now() - 5*86400000).toISOString().slice(0,10));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login exitoso (200)', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) { pm.collectionVariables.set('token_admin', pm.response.json().token); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/sesiones/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"{{correo_admin}}\",\n  \"contrasena\": \"{{contrasena_admin}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "0B. Setup - activo INDIVIDUAL propio Macho (nace ACTIVO)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Activo creado (201)', function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) { pm.collectionVariables.set('id_activo', pm.response.json().id_activo_biologico); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token_admin}}"
          }
        ],
        "url": "{{base_url}}/activos-biologicos",
        "body": {
          "mode": "raw",
          "raw": "{\n \"tipo_activo\":\"INDIVIDUAL\",\"id_especie\":{{id_especie}},\"fecha_inicio_ciclo\":\"{{fecha_inicio}}\",\"origen_financiero\":\"nacimiento\",\"id_infraestructura\":{{id_infraestructura}},\"identificador\":\"QA-G111-M-{{rid}}\",\"raza\":\"QA G111\",\"sexo\":\"Macho\",\"fecha_nacimiento\":\"2025-01-15T00:00:00Z\",\"peso_inicial\":2.5\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "0C. Setup - registrar fase productiva activa (RF-37) Macho",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Fase registrada (201)', function () { pm.response.to.have.status(201); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token_admin}}"
          }
        ],
        "url": "{{base_url}}/activos-biologicos/{{id_activo}}/fases",
        "body": {
          "mode": "raw",
          "raw": "{ \"id_ciclo_productiva\": {{id_ciclo_productiva}}, \"motivo_cambio\": \"QA G111 fase activa\" }",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Setup - esperar (1.5 s)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "setTimeout(function () {}, 1500);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Activo consultable (200)', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token_admin}}"
          }
        ],
        "url": "{{base_url}}/activos-biologicos/{{id_activo}}"
      }
    },
    {
      "name": "Setup - registrar un evento de crecimiento (ultimo evento = hoy)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('fecha_t1', new Date(Date.now() - 300).toISOString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "console.log('[Control] status=' + pm.response.code + ' body=' + pm.response.text());",
              "pm.test('Control - ultimo evento valido: HTTP 201', function () { pm.response.to.have.status(201); });",
              "let b; try { b = pm.response.json(); } catch (e) { b = {}; }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token_admin}}"
          }
        ],
        "url": "{{base_url}}/activos-biologicos/{{id_activo}}/eventos/crecimiento",
        "body": {
          "mode": "raw",
          "raw": "{ \"tipo_medicion\": \"PESO\", \"valor_medicion\": 250, \"unidad_medida\": \"kg\", \"fecha\": \"{{fecha_t1}}\", \"descripcion\": \"QA RFC G111 ultimo evento\" }",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "TC-M02-323 - Rechazar baja con fecha futura",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('fecha_futura', new Date(Date.now() + (2)*86400000).toISOString().slice(0,10));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "console.log('[TC-M02-323] status=' + pm.response.code + ' body=' + pm.response.text());",
              "pm.test('TC-M02-323 - RF-45 fecha de baja futura: HTTP 400', function () { pm.response.to.have.status(400); });",
              "let b; try { b = pm.response.json(); } catch (e) { b = {}; }",
              "pm.test('TC-M02-323 - RF-45 fecha de baja futura: mensaje esperado', function () { pm.expect(String(b.message || '')).to.match(/fecha de baja/i); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token_admin}}"
          }
        ],
        "url": "{{base_url}}/activos-biologicos/{{id_activo}}/eventos/baja",
        "body": {
          "mode": "raw",
          "raw": "{ \"tipo_baja\": \"muerte\", \"fecha_baja\": \"{{fecha_futura}}\", \"motivo_baja\": \"QA RFC TC-M02-323: fecha futura\" }",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "TC-M02-324 - Rechazar baja con fecha anterior al ultimo evento registrado",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('fecha_ant', new Date(Date.now() + (-1)*86400000).toISOString().slice(0,10));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "console.log('[TC-M02-324] status=' + pm.response.code + ' body=' + pm.response.text());",
              "pm.test('TC-M02-324 - RF-45 fecha anterior al ultimo evento: HTTP 400', function () { pm.response.to.have.status(400); });",
              "let b; try { b = pm.response.json(); } catch (e) { b = {}; }",
              "pm.test('TC-M02-324 - RF-45 fecha anterior al ultimo evento: mensaje esperado', function () { pm.expect(String(b.message || '')).to.match(/fecha de baja/i); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token_admin}}"
          }
        ],
        "url": "{{base_url}}/activos-biologicos/{{id_activo}}/eventos/baja",
        "body": {
          "mode": "raw",
          "raw": "{ \"tipo_baja\": \"muerte\", \"fecha_baja\": \"{{fecha_ant}}\", \"motivo_baja\": \"QA RFC TC-M02-324: anterior al ultimo evento\" }",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    }
  ],
