    {
      "name": "Setup 2/2 - Registrar fase activa (requisito nuevo INC-M02-78-G58)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "console.log(pm.response.text());",
              "pm.test('fase activa registrada (HTTP 201)', function () { pm.response.to.have.status(201); });",
              "let respuesta; try { respuesta = pm.response.json(); } catch (e) { respuesta = null; }",
              "// Ancla las fechas de los pasos siguientes al 'fecha_inicio' que devuelve el propio",
              "// servidor (autoritativo), no al reloj del cliente Newman -- evita el problema de",
              "// desincronizacion de reloj cliente/servidor ya documentado (ver hallazgo 'Sin campo",
              "// fecha explicito' en la descripcion de este TC).",
              "const anclaServidor = respuesta ? Date.parse(respuesta.fecha_inicio) : Date.now();",
              "pm.collectionVariables.set('base_ts', anclaServidor);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
