    {
      "name": "Paso 3/4 (TC-M02-103) - CORREGIDO: parto con numero_crias ya NO da 500",
      "event": [
        {
          "listen": "prerequest",
          "script": {"type": "text/javascript", "exec": ["pm.collectionVariables.set('fecha_paso', new Date(parseInt(pm.collectionVariables.get('base_ts'), 10) + 60).toISOString());"]}
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "console.log(pm.response.text());",
              "pm.test('CORREGIDO: parto ya responde 201 (antes 500 ERROR_INTERNO desde 2026-09-08)', function () { pm.response.to.have.status(201); });",
