          "listen": "prerequest",
          "script": {"type": "text/javascript", "exec": ["pm.collectionVariables.set('nombre_finca', 'QA Reintento G cincuenta y tres cuatro');"]}
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "console.log(pm.response.text());",
              "pm.test('finca creada (HTTP 201)', function () { pm.response.to.have.status(201); });",
              "let respuesta; try { respuesta = pm.response.json(); } catch (e) { respuesta = null; }",
              "if (pm.response.code === 201 && respuesta) { pm.collectionVariables.set('id_finca', respuesta.id_finca); } else { postman.setNextRequest(null); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{token}}"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"{{nombre_finca}}\",\n  \"ubicacion\": {\"departamento\": \"Huila\", \"municipio\": \"Neiva\", \"vereda\": \"QA\", \"latitud\": \"2.9\", \"longitud\": \"-75.2\"},\n  \"tamano_h\": 10\n}",
          "options": {"raw": {"language": "json"}}
        },
        "url": {"raw": "{{base_url}}/configuracion/fincas", "host": ["{{base_url}}"], "path": ["configuracion", "fincas"]}
      }
