              "pm.test('el evento registrado es categoria parto con numero_cria correcto', function () {",
              "  pm.expect(respuesta && respuesta.evento && respuesta.evento.reproductivo && respuesta.evento.reproductivo.categoria).to.equal('parto');",
              "  pm.expect(respuesta && respuesta.evento && respuesta.evento.reproductivo && respuesta.evento.reproductivo.numero_cria).to.equal(2);",
              "});"
            ]
