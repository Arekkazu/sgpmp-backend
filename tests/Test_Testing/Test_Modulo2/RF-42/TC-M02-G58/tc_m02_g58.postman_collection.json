              "console.log(pm.response.text());",
              "pm.test('229 paso 4: la consulta del historial responde HTTP 200', function () { pm.response.to.have.status(200); });",
              "let respuesta; try { respuesta = pm.response.json(); } catch (e) { respuesta = null; }",
              "if (pm.response.code === 200 && respuesta) {",
              "    const reproductivos = (respuesta.registros || []).filter(function (r) { return r.categoria === 'REPRODUCTIVO'; });",
              "    pm.test('229: existe un registro REPRODUCTIVO de categoria parto con numero_cria=3, id_padre e id_madre consistentes (unica forma de verificar N:1, ya que la API no expone registros individuales por cria) -- BLOQUEADO en cascada por TC-M02-G53', function () {",
              "        const partos = reproductivos.filter(function (r) { return r.detalle_especifico && r.detalle_especifico.categoria === 'parto'; });",
              "        pm.expect(partos.length).to.equal(1);",
              "        pm.expect(partos[0].detalle_especifico.numero_cria).to.equal(3);",
              "    });",
              "    console.log('CONCLUSION sub-caso 229: ' + reproductivos.length + ' evento(s) REPRODUCTIVO(s) encontrados (se esperaban al menos inseminacion+diagnostico+parto). NOTA DE DISENO: aunque este bug se corrija, la API no expone genealogia por cria individual -- numero_cria es un entero agregado en un unico evento, no N registros con madre/padre propios.');",
