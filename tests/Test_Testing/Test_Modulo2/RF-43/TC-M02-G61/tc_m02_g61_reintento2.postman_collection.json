        "body": {"mode": "raw", "raw": "{\n  \"finca_id\": {{id_finca}},\n  \"nombre_infraestructura\": \"{{nombre_infra_mojarra}}\",\n  \"superficie\": 10,\n  \"especie_id\": {{id_especie_mojarra}},\n  \"tipo_area\": \"estanque\"\n}", "options": {"raw": {"language": "json"}}},
        "url": {"raw": "{{base_url}}/configuracion/infraestructuras", "host": ["{{base_url}}"], "path": ["configuracion", "infraestructuras"]}
      }
    },
