    {
      "name": "Sub-caso 3, verificacion - cantidad_actual bajo exactamente 15 y el lote sigue ACTIVO",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "console.log(pm.response.text());",
              "pm.test('lectura final del lote (HTTP 200)', function () { pm.response.to.have.status(200); });",
              "let respuesta; try { respuesta = pm.response.json(); } catch (e) { respuesta = null; }",
              "const antes = parseInt(pm.collectionVariables.get('cantidad_antes'), 10);",
              "const despues = respuesta && respuesta.detalle_poblacional ? respuesta.detalle_poblacional.cantidad_actual : null;",
              "pm.test('cantidad_actual bajo exactamente 15 (delta antes/despues)', function () { pm.expect(antes - despues).to.equal(15); });",
              "pm.test('el lote sigue ACTIVO (baja parcial no cierra el activo)', function () { pm.expect(respuesta.nombre_estado).to.equal('ACTIVO'); });"
            ]
          }
        }
      ],
