                  "  pm.expect(pm.collectionVariables.get('estado_antes_284')).to.eql('INACTIVO');",
                  "});",
                  "pm.test('TC-138/Productor: HTTP 409 CONFLICT', () => pm.expect(code, 'obtenido HTTP ' + code).to.eql(409));",
                  "pm.test('TC-138/Productor: el error_code corresponde a E-03 (estado no ACTIVO)', () => {",
