              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('OpenAPI HTTP 200',()=>pm.response.to.have.status(200));",
                  "const s=pm.response.json(); const P=s.paths;",
                  "pm.test('GET /transferencias/disponibles existe',()=>pm.expect(P['/activos-biologicos/{id_activo}/transferencias/disponibles']).to.have.property('get'));",
                  "pm.test('POST /transferencias existe',()=>pm.expect(P['/activos-biologicos/{id_activo}/transferencias']).to.have.property('post'));",
                  "const rs=Object.keys(P['/activos-biologicos/{id_activo}/transferencias'].post.responses);",
                  "pm.test('POST declara 201 como exito (y no 200)',()=>{pm.expect(rs).to.include('201');pm.expect(rs).to.not.include('200');});",
                  "pm.test('DTO exige origen, destino, fecha y motivo',()=>pm.expect(s.components.schemas.RegistrarTransferenciaDTO.required).to.have.members(['infraestructura_origen_id','infraestructura_destino_id','fecha_transferencia','motivo_transferencia']));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/openapi.json"
          }
        }
      ]
