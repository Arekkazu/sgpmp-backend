        {
          "name": "0. Setup - Crear lote poblacional dinámico (TC-M02-197)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo_activo\": \"POBLACIONAL\",\n  \"id_especie\": 40,\n  \"fecha_inicio_ciclo\": \"2026-09-01\",\n  \"origen_financiero\": \"nacimiento\",\n  \"id_infraestructura\": 48,\n  \"cantidad_inicial\": 10,\n  \"peso_promedio_inicial\": 2.0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/activos-biologicos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "activos-biologicos"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Setup TC-M02-197: Lote poblacional dinámico creado (HTTP 201)', function () {",
                  "    pm.response.to.have.status(201);",
                  "    var res = pm.response.json();",
