                  "    pm.collectionVariables.set('lote_baja_id', res.id_activo_biologico);",
                  "    console.log('Lote dinámico para baja aprovisionado:', res.id_activo_biologico);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "1. Aplicar baja total sobre lote dinámico",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo_baja\": \"venta\",\n  \"fecha_baja\": \"{{fecha_baja_dinamica}}\",\n  \"motivo_baja\": \"Baja total QA-TC-M02-197 sobre lote dinámico\",\n  \"cantidad_afectada\": 10\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/activos-biologicos/{{lote_baja_id}}/eventos/baja",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "activos-biologicos",
                "{{lote_baja_id}}",
                "eventos",
                "baja"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const safeDate = new Date(Date.now() - 60000).toISOString().split('T')[0];",
                  "pm.collectionVariables.set('fecha_baja_dinamica', safeDate);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Baja exitosa sobre lote dinámico (HTTP 201)', function () {",
                  "    pm.response.to.have.status(201);",
                  "    var res = pm.response.json();",
                  "    pm.expect(res).to.be.an('object');",
                  "    console.log('HTTP Status Lote Dinámico Baja:', pm.response.code);",
                  "    console.log('Body Lote Dinámico Baja:', pm.response.text());",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "2. Consultar lote dinámico tras intento de baja",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/activos-biologicos/{{lote_baja_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "activos-biologicos",
                "{{lote_baja_id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Consulta de lote dinámico completada (HTTP 200)', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var res = pm.response.json();",
                  "    console.log('Lote Dinámico Estado actual:', res.nombre_estado, 'ID Estado:', res.id_estado, 'Cantidad:', res.detalle_poblacional ? res.detalle_poblacional.cantidad_actual : 'N/A');",
                  "    pm.expect(res.detalle_poblacional.cantidad_actual).to.eql(0);",
                  "    pm.expect(res.id_estado).to.eql(6);",
                  "    pm.expect(res.nombre_estado).to.eql('BAJA');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "3. Teardown - Confirmar estado terminal lote dinámico",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/activos-biologicos/{{lote_baja_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "activos-biologicos",
                "{{lote_baja_id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Teardown TC-M02-197: Confirmar estado terminal BAJA (no residuos activos)', function () {",
                  "    try {",
                  "        pm.response.to.have.status(200);",
                  "        var res = pm.response.json();",
                  "        pm.expect(res.id_estado).to.eql(6);",
                  "        pm.expect(res.detalle_poblacional.cantidad_actual).to.eql(0);",
                  "        console.log('Teardown Lote Dinámico verificado exitosamente en estado BAJA');",
                  "    } catch (e) {",
                  "        console.log('Teardown TC-M02-197 advertencia:', e.message);",
