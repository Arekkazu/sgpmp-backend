  "item": [
    {
      "name": "TC-M02-196",
      "description": "Subcaso TC-M02-196: Evaluación de densidad de lote ante evento de crecimiento",
      "item": [
        {
          "name": "0. Autenticación Admin (TC-M02-196)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo_electronico\": \"{{admin_email}}\",\n  \"contrasena\": \"{{admin_password}}\",\n  \"correo\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sesiones/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sesiones",
                ""
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Autenticación Admin completada', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.token).to.be.a('string');",
                  "    pm.collectionVariables.set('jwt_token', res.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "1. Registrar evento de crecimiento sobre lote 296",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo_medicion\": \"PESO\",\n  \"valor_medicion\": 2.5,\n  \"unidad_medida\": \"kg\",\n  \"tipo_agregacion\": \"promedio\",\n  \"frecuencia\": \"semanal\",\n  \"nuevo_peso_promedio\": 2.5,\n  \"cantidad_medida\": 5,\n  \"descripcion\": \"Registro de crecimiento para evaluacion de densidad TC-M02-196\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/activos-biologicos/296/eventos/crecimiento",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "activos-biologicos",
                "296",
                "eventos",
                "crecimiento"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Respuesta de registro de crecimiento exitosa (HTTP 201)', function () {",
                  "    pm.response.to.have.status(201);",
                  "    console.log('HTTP Status TC-M02-196 Crecimiento:', pm.response.code);",
                  "    console.log('Body TC-M02-196 Crecimiento:', pm.response.text());",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "2. Consultar estado y métricas del lote 296",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/activos-biologicos/296",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "activos-biologicos",
                "296"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Consulta de lote 296 completada (HTTP 200) y métricas zootécnicas', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.detalle_poblacional).to.be.an('object');",
                  "    pm.expect(res.detalle_poblacional.cantidad_actual).to.be.a('number');",
                  "    pm.expect(Number(res.detalle_poblacional.peso_promedio)).to.be.closeTo(2.5, 0.1);",
                  "    pm.expect(Number(res.detalle_poblacional.biomasa_total)).to.be.above(0);",
                  "    console.log('Lote 296 - Densidad actual:', res.detalle_poblacional ? res.detalle_poblacional.densidad : 'N/A');",
                  "    console.log('Lote 296 - Cantidad actual:', res.detalle_poblacional ? res.detalle_poblacional.cantidad_actual : 'N/A');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "3. Teardown - Preservación y verificación de Lote 296",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/activos-biologicos/296",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "activos-biologicos",
                "296"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Teardown TC-M02-196: Confirmar estado activo y no alteración física', function () {",
                  "    try {",
                  "        pm.response.to.have.status(200);",
                  "        var res = pm.response.json();",
                  "        pm.expect(res.id_estado).to.eql(1);",
                  "        console.log('Teardown Lote 296 verificado exitosamente');",
                  "    } catch (e) {",
                  "        console.log('Teardown TC-M02-196 advertencia:', e.message);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
