          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-M02-199 Variante B2: Respuesta recibida (Rechazo 4xx o fallo por bug conocido PR #254)', function () {",
                  "    pm.expect([400, 422, 500]).to.include(pm.response.code);",
                  "});",
                  "",
                  "pm.test('TC-M02-199 Variante B2: Documentar código de error según comportamiento', function () {",
