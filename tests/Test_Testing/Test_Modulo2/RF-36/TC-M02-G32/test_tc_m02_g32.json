                  "});",
                  "",
                  "pm.test('TC-M02-199: Estado del lote 130 sigue siendo ACTIVO', function () {",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.nombre_estado || res.estado).to.eql('ACTIVO');",
                  "});"
