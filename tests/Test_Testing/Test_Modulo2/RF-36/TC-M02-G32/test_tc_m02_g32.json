            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-M02-199 Variante A2: Código HTTP es 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test('TC-M02-199 Variante A2: Código de error de validación de entrada VAL_ENTRADA', function () {",
                  "    var res = pm.response.json();",
