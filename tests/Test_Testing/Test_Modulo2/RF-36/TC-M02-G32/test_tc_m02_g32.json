        {
          "name": "1. Variante A: Rechazar evento productivo con tipo_producto no catalogado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo_producto\": \"TIPO_INEXISTENTE_XYZ\",\n  \"cantidad_producida\": 10,\n  \"unidad_medida\": \"kg\",\n  \"fecha_evento\": \"2026-09-11\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/activos-biologicos/130/eventos/productivo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "activos-biologicos",
                "130",
                "eventos",
                "productivo"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-M02-199 Variante A: Código de rechazo HTTP 4xx recibido', function () {",
                  "    pm.expect([400, 422]).to.include(pm.response.code);",
                  "});",
                  "",
                  "pm.test('TC-M02-199 Variante A: Código de error TIPO_PRODUCTO_NO_CATALOGADO o VAL_ENTRADA', function () {",
                  "    var res = pm.response.json();",
                  "    pm.expect(['TIPO_PRODUCTO_NO_CATALOGADO', 'VAL_ENTRADA']).to.include(res.error_code);",
                  "});",
                  "",
                  "pm.test('TC-M02-199 Variante A: Mensaje describe restricción de catálogo', function () {",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.message).to.be.a('string').and.not.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
