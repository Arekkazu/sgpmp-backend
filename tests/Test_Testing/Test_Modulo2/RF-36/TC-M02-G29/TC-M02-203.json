{
  "info": {
    "_postman_id": "tc-m02-203-auditoria-crecimiento",
    "name": "TC-M02-203 - Registro de auditoría tras evento CRECIMIENTO válido (RF-36 / RF-52)",
    "description": "Prueba de aceptación para RF-36 y RF-52: Registrar un evento de crecimiento válido y verificar la generación de la entrada de auditoría correspondiente con resultado EXITOSO.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://sigab-backendtest-389pcb-a48238-158-69-200-27.sslip.io/api-sgpmp-test",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "id_lote",
      "value": "130",
      "type": "string"
    },
    {
      "key": "admin_email",
      "value": "",
      "type": "string"
    },
    {
      "key": "admin_password",
      "value": "",
      "type": "string"
    },
    {
      "key": "cantidad_medida_dinamica",
      "value": "3",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Iniciar sesión como Administrador",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\",\n  \"correo_electronico\": \"{{admin_email}}\",\n  \"contrasena\": \"{{admin_password}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/sesiones/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "sesiones",
            ""
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Corrección 2026-09-19: credenciales parametrizadas via variables de entorno.",
              "pm.test('Checkpoint 0 - Autenticación exitosa (HTTP 200 OK)', function () {",
              "    pm.response.to.have.status(200);",
              "    var res = pm.response.json();",
              "    pm.expect(res.token).to.be.a('string');",
              "    pm.collectionVariables.set('jwt_token', res.token);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "0.1. Setup cantidad_medida dinamica",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/activos-biologicos/{{id_lote}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "activos-biologicos",
            "{{id_lote}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Setup 0.1 - Consulta de lote exitosa (HTTP 200 OK)', function () {",
              "    pm.response.to.have.status(200);",
              "    var res = pm.response.json();",
              "    var cant = (res.detalle_poblacional && res.detalle_poblacional.cantidad_actual) || res.cantidad_actual || 3;",
              "    pm.collectionVariables.set('cantidad_medida_dinamica', cant.toString());",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "1. Registrar evento de crecimiento válido (TC-M02-203)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tipo_medicion\": \"PESO\",\n  \"valor_medicion\": 58.0,\n  \"unidad_medida\": \"gr\",\n  \"nuevo_peso_promedio\": 58.0,\n  \"cantidad_medida\": {{cantidad_medida_dinamica}},\n  \"tipo_agregacion\": \"PROMEDIO\",\n  \"fecha\": \"{{fecha_evento_actual}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/activos-biologicos/{{id_lote}}/eventos/crecimiento",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "activos-biologicos",
            "{{id_lote}}",
            "eventos",
            "crecimiento"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Corrección 2026-09-15: margen de seguridad de 60s hacia atrás para evitar rechazo por clock skew (FECHA_FUTURA).",
              "const safeDate = new Date(Date.now() - 60000).toISOString();",
              "pm.collectionVariables.set('fecha_evento_actual', safeDate);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Código HTTP esperado: 200 OK o 201 Created (Evento de crecimiento registrado)', function () {",
              "    pm.expect([200, 201]).to.include(pm.response.code);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2. Consultar bitácora de auditoría y verificar registro de CRECIMIENTO (RF-52)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/activos-biologicos/auditoria?id_activo_biologico={{id_lote}}&rf_origen=RF40&resultado=EXITOSO&pagina=1&page_size=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "activos-biologicos",
            "auditoria"
          ],
          "query": [
            {
              "key": "id_activo_biologico",
              "value": "{{id_lote}}"
            },
            {
              "key": "rf_origen",
              "value": "RF40"
            },
            {
              "key": "resultado",
              "value": "EXITOSO"
            },
            {
              "key": "pagina",
              "value": "1"
            },
            {
              "key": "page_size",
              "value": "10"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Código HTTP esperado: 200 OK al consultar auditoría', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Existe al menos un registro de auditoría para el evento de crecimiento', function () {",
              "    var res = pm.response.json();",
              "    pm.expect(res.total_registros).to.be.above(0);",
              "    pm.expect(res.registros).to.be.an('array').that.is.not.empty;",
              "});",
              "",
              "pm.test('El registro de auditoría contiene rf_origen RF40, tipo_evento CRECIMIENTO y resultado EXITOSO', function () {",
              "    var res = pm.response.json();",
              "    var audit = res.registros[0];",
              "    pm.expect(audit.rf_origen).to.eql('RF40');",
              "    pm.expect(audit.tipo_evento).to.include('CRECIMIENTO');",
              "    pm.expect(audit.resultado).to.eql('EXITOSO');",
              "    // Corrección 2026-09-13: se actualiza credencial admin a administador.dev@gmail.com (admin@pecuaria.co presentaba error 500 en TEST desde esta fecha).",
              "    pm.expect([1, 104]).to.include(audit.id_usuario_responsable);",
              "    pm.expect(audit.id_activo_biologico).to.eql(parseInt(pm.variables.get('id_lote')));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}
