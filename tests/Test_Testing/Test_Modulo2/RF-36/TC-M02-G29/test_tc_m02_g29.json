            "exec": [
              "pm.test('Checkpoint Final - Consulta general de auditoría exitosa (HTTP 200 OK)', function () {",
              "    pm.response.to.have.status(200);",
              "    var res = pm.response.json();",
              "    pm.expect(res.total_registros).to.be.above(0);",
              "    pm.expect(res.registros).to.be.an('array').that.is.not.empty;",
