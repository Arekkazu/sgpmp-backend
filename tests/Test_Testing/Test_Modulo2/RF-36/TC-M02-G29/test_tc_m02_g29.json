{
  "info": {
    "_postman_id": "test-tc-m02-g29-suite-consolidada",
    "name": "TC-M02-G29 - Auditoría y Trazabilidad de Activos Biológicos (RF-36 / RF-52)",
    "description": "Suite consolidada de pruebas para RF-36 y RF-52: Verificación de auditoría en eventos agronómicos válidos (Crecimiento, Baja) y de intentos rechazados por validación (PATCH biomasa_total).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://sigab-backendtest-389pcb-a48238-158-69-200-27.sslip.io/api-sgpmp-test",
      "type": "string"
    },
    {
      "key": "admin_email",
      "value": "",
      "type": "string"
    },
    {
      "key": "admin_password",
      "value": "",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "id_lote",
      "value": "130",
      "type": "string"
    },
    {
      "key": "cantidad_medida_dinamica",
      "value": "3",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Iniciar sesión como Administrador",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\",\n  \"correo_electronico\": \"{{admin_email}}\",\n  \"contrasena\": \"{{admin_password}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/sesiones/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "sesiones",
            ""
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Checkpoint 0 - Autenticación exitosa (HTTP 200 OK)', function () {",
              "    pm.response.to.have.status(200);",
              "    var res = pm.response.json();",
              "    pm.expect(res.token).to.be.a('string');",
              "    pm.collectionVariables.set('jwt_token', res.token);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "0.1. Setup cantidad_medida dinámica",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/activos-biologicos/{{id_lote}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "activos-biologicos",
            "{{id_lote}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Setup 0.1 - Consulta previa de lote exitosa (HTTP 200 OK)', function () {",
              "    pm.response.to.have.status(200);",
              "    var res = pm.response.json();",
              "    var cant = (res.detalle_poblacional && res.detalle_poblacional.cantidad_actual) || res.cantidad_actual || 3;",
              "    if (cant > 3) cant = 3;",
              "    pm.collectionVariables.set('cantidad_medida_dinamica', cant.toString());",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "1.1. TC-M02-203 - Registrar evento de crecimiento válido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tipo_medicion\": \"PESO\",\n  \"valor_medicion\": 58.0,\n  \"unidad_medida\": \"gr\",\n  \"nuevo_peso_promedio\": 58.0,\n  \"cantidad_medida\": {{cantidad_medida_dinamica}},\n  \"tipo_agregacion\": \"PROMEDIO\",\n  \"fecha\": \"{{fecha_evento_actual}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/activos-biologicos/{{id_lote}}/eventos/crecimiento",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "activos-biologicos",
            "{{id_lote}}",
            "eventos",
            "crecimiento"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const safeDate = new Date(Date.now() - 60000).toISOString();",
              "pm.collectionVariables.set('fecha_evento_actual', safeDate);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('TC-M02-203 - Código HTTP esperado: 200 OK o 201 Created (Evento de crecimiento registrado)', function () {",
              "    pm.expect([200, 201]).to.include(pm.response.code);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "1.2. TC-M02-203 - Consultar bitácora y verificar auditoría de CRECIMIENTO (RF-52)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/activos-biologicos/auditoria?id_activo_biologico={{id_lote}}&rf_origen=RF40&resultado=EXITOSO&pagina=1&page_size=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "activos-biologicos",
            "auditoria"
          ],
          "query": [
            {
              "key": "id_activo_biologico",
              "value": "{{id_lote}}"
            },
            {
              "key": "rf_origen",
              "value": "RF40"
            },
            {
              "key": "resultado",
              "value": "EXITOSO"
            },
            {
              "key": "pagina",
              "value": "1"
            },
            {
              "key": "page_size",
              "value": "10"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('TC-M02-203 - Código HTTP esperado: 200 OK al consultar auditoría de crecimiento', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('TC-M02-203 - Existe registro de auditoría para el evento de crecimiento', function () {",
              "    var res = pm.response.json();",
              "    pm.expect(res.total_registros).to.be.above(0);",
              "    pm.expect(res.registros).to.be.an('array').that.is.not.empty;",
              "});",
              "",
              "pm.test('TC-M02-203 - Registro contiene rf_origen RF40, tipo_evento CRECIMIENTO y resultado EXITOSO', function () {",
              "    var res = pm.response.json();",
              "    var audit = res.registros[0];",
              "    pm.expect(audit.rf_origen).to.eql('RF40');",
              "    pm.expect(audit.tipo_evento).to.include('CRECIMIENTO');",
              "    pm.expect(audit.resultado).to.eql('EXITOSO');",
              "    pm.expect([1, 104]).to.include(audit.id_usuario_responsable);",
              "    pm.expect(audit.id_activo_biologico).to.eql(parseInt(pm.variables.get('id_lote') || pm.collectionVariables.get('id_lote')));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2.1. TC-M02-204 - Registrar evento de baja válido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tipo_baja\": \"VENTA\",\n  \"cantidad_afectada\": 1,\n  \"motivo_baja\": \"Prueba de auditoria TC-M02-204 suite V3\",\n  \"fecha_baja\": \"{{fecha_baja_actual}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/activos-biologicos/{{id_lote}}/eventos/baja",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "activos-biologicos",
            "{{id_lote}}",
            "eventos",
            "baja"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "var hoy = new Date().toISOString().split('T')[0];",
              "pm.collectionVariables.set('fecha_baja_actual', hoy);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('TC-M02-204 - Código HTTP esperado: 200 OK o 201 Created (Baja registrada exitosamente)', function () {",
              "    pm.expect([200, 201]).to.include(pm.response.code);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2.2. TC-M02-204 - Consultar bitácora y verificar auditoría de BAJA (RF-52)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/activos-biologicos/auditoria?id_activo_biologico={{id_lote}}&rf_origen=RF45&resultado=EXITOSO&pagina=1&page_size=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "activos-biologicos",
            "auditoria"
          ],
          "query": [
            {
              "key": "id_activo_biologico",
              "value": "{{id_lote}}"
            },
            {
              "key": "rf_origen",
              "value": "RF45"
            },
            {
              "key": "resultado",
              "value": "EXITOSO"
            },
            {
              "key": "pagina",
              "value": "1"
            },
            {
              "key": "page_size",
              "value": "10"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('TC-M02-204 - Código HTTP esperado: 200 OK al consultar auditoría de baja', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('TC-M02-204 - Existe registro de auditoría para el evento de baja', function () {",
              "    var res = pm.response.json();",
              "    pm.expect(res.total_registros).to.be.above(0);",
              "    pm.expect(res.registros).to.be.an('array').that.is.not.empty;",
              "});",
              "",
              "pm.test('TC-M02-204 - Registro contiene rf_origen RF45, tipo_evento BAJA y resultado EXITOSO', function () {",
              "    var res = pm.response.json();",
              "    var audit = res.registros[0];",
              "    pm.expect(audit.rf_origen).to.eql('RF45');",
              "    pm.expect(audit.tipo_evento).to.include('BAJA');",
              "    pm.expect(audit.resultado).to.eql('EXITOSO');",
              "    pm.expect([1, 104]).to.include(audit.id_usuario_responsable);",
              "    pm.expect(audit.id_activo_biologico).to.eql(parseInt(pm.variables.get('id_lote') || pm.collectionVariables.get('id_lote')));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "3.1. TC-M02-205 - Intentar modificar biomasa_total mediante PATCH (Rechazo)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"biomasa_total\": 999.99\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/activos-biologicos/{{id_lote}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "activos-biologicos",
            "{{id_lote}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('TC-M02-205 - Código HTTP esperado: 400 Bad Request (Rechazo de edición directa)', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test('TC-M02-205 - Error retornado es de validación de entrada (VAL_ENTRADA)', function () {",
              "    var res = pm.response.json();",
              "    pm.expect(res.error_code).to.eql('VAL_ENTRADA');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "3.2. TC-M02-205 - Consultar bitácora y verificar auditoría de intento rechazado (INC-M02-41-RF52)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/activos-biologicos/auditoria?id_activo_biologico={{id_lote}}&pagina=1&page_size=20",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "activos-biologicos",
            "auditoria"
          ],
          "query": [
            {
              "key": "id_activo_biologico",
              "value": "{{id_lote}}"
            },
            {
              "key": "pagina",
              "value": "1"
            },
            {
              "key": "page_size",
              "value": "20"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('TC-M02-205 - Código HTTP esperado: 200 OK al consultar auditoría de rechazo', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('TC-M02-205 - Existe registro de auditoría para el intento fallido/rechazado (INC-M02-41-RF52)', function () {",
              "    var res = pm.response.json();",
              "    var registros = res.registros || [];",
              "    var encontrado = registros.some(function (r) {",
              "        return ['RECHAZADO', 'FALLIDO'].includes(r.resultado) &&",
              "               ['RF35', 'RF36'].includes(r.rf_origen) &&",
              "               [1, 104].includes(r.id_usuario_responsable);",
              "    });",
              "    pm.expect(encontrado).to.be.true;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "3.3. TC-M02-205 - Verificar que biomasa_total permanece inalterada",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/activos-biologicos/{{id_lote}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "activos-biologicos",
            "{{id_lote}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('TC-M02-205 - Código HTTP esperado: 200 OK al consultar activo', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('TC-M02-205 - La biomasa_total permanece inalterada (no es 999.99)', function () {",
              "    var res = pm.response.json();",
              "    var biomasa = (res.detalle_poblacional && res.detalle_poblacional.biomasa_total) || res.biomasa_total;",
              "    pm.expect(biomasa).to.not.eql(999.99);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
