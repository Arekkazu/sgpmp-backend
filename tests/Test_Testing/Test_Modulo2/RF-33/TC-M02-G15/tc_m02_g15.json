        },
        "url": "{{base_url}}/sesiones/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login previo Ingeniero (descubrimiento) - HTTP 200', () => pm.expect(pm.response.code).to.eql(200));",
              "let d={}; try { d=pm.response.json(); } catch(e) {}",
              "const token=d.token ?? (d.data && d.data.token);",
              "if(!token) { return; }",
              "pm.sendRequest({",
              "  url: pm.collectionVariables.get('base_url') + '/activos-biologicos',",
              "  method: 'GET',",
              "  header: { Authorization: 'Bearer ' + token }",
              "}, function (err, res) {",
              "  if (err || !res) return;",
              "  let dd = {}; try { dd = res.json(); } catch(e) {}",
