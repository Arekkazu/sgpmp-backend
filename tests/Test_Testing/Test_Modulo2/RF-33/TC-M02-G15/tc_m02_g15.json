    {
      "name": "15 - TC-M02-031 - Ingeniero consulta la ficha del activo con datos financieros",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_ingeniero}}" }],
        "url": "{{base_url}}/activos-biologicos/{{activo_financiero_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let d={}; try { d=pm.response.json(); } catch(e) {}",
              "if (pm.response.code === 200) {",
              "  const costo = d.costo_adquisicion;",
              "  const soporte = d.soporte_documental ?? d.soporte_documental_costo;",
              "  const costoOculto = costo === undefined || costo === null;",
              "  const soporteOculto = soporte === undefined || soporte === null;",
              "  pm.test('TC-M02-031 - costo_adquisicion no visible para Ingeniero de Campo', () => pm.expect(costoOculto, 'costo_adquisicion=' + costo + ' fue expuesto a un rol sin permiso financiero').to.be.true);",
              "  pm.test('TC-M02-031 - soporte_documental no visible para Ingeniero de Campo', () => pm.expect(soporteOculto, 'soporte_documental=' + soporte + ' fue expuesto a un rol sin permiso financiero').to.be.true);",
              "} else if (pm.response.code === 403) {",
              "  pm.test('TC-M02-031 - Acceso denegado por completo (403); tambien satisface el criterio de no exponer datos financieros', () => pm.expect(true).to.be.true);",
              "} else {",
              "  pm.test('TC-M02-031 - Codigo de respuesta inesperado: ' + pm.response.code, () => pm.expect.fail('Se esperaba 200 (con campos financieros ocultos/enmascarados) o 403'));",
              "}"
            ]
          }
        }
      ]
    }
  ]
}
