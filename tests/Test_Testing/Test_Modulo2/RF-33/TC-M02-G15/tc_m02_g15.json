    {
      "name": "01 - TC-M02-027 - Login Productor (Finca 1)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"m2m.nuevo@ejemplo.com\",\n  \"contrasena\": \"Test1234!\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{base_url}}/sesiones/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login Productor - HTTP 200', () => pm.expect(pm.response.code).to.eql(200));",
              "let d={}; try { d=pm.response.json(); } catch(e) {}",
              "const token=d.token ?? (d.data && d.data.token);",
              "pm.test('Login Productor - token generado', () => pm.expect(token, 'No se encontro token').to.exist);",
              "if(token) pm.collectionVariables.set('token_productor', token);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Descubrir un activo propio del Productor (GET /activos-biologicos)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_productor}}" }],
        "url": "{{base_url}}/activos-biologicos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Listado propio - HTTP 200', () => pm.expect(pm.response.code).to.eql(200));",
              "let d={}; try { d=pm.response.json(); } catch(e) {}",
              "const items=Array.isArray(d) ? d : (d.registros ?? d.items ?? d.data ?? []);",
              "pm.test('El Productor tiene al menos un activo propio visible', () => pm.expect(items.length, 'GET /activos-biologicos devolvio 0 registros para este Productor').to.be.above(0));",
              "const ids = items.map(x => String(x.id_activo_biologico ?? x.id));",
              "pm.collectionVariables.set('ids_propios_productor', ids.join(','));",
              "pm.collectionVariables.set('id_lote_propio', ids[0]);",
              "console.log('Activos propios del Productor:', ids);"
            ]
          }
        }
      ]
    },
