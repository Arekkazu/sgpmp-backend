    {
      "name": "04 - Descubrir un activo AJENO al Productor (GET /activos-biologicos como Admin)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
        "url": "{{base_url}}/activos-biologicos?pagina=1&por_pagina=50"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Listado global (Admin) - HTTP 200', () => pm.expect(pm.response.code).to.eql(200));",
              "let d={}; try { d=pm.response.json(); } catch(e) {}",
              "const items=Array.isArray(d) ? d : (d.registros ?? d.items ?? d.data ?? []);",
              "const propios = new Set((pm.collectionVariables.get('ids_propios_productor') || '').split(',').filter(Boolean));",
              "const candidatos = items.filter(x => !propios.has(String(x.id_activo_biologico ?? x.id)));",
              "pm.test('Se encontro un activo que NO pertenece al Productor de prueba', () => pm.expect(candidatos.length, 'No se pudo distinguir un activo ajeno entre los primeros 50 registros').to.be.above(0));",
              "const ajeno = candidatos.find(x => x.tipo === 'INDIVIDUAL') ?? candidatos[0];",
              "if(ajeno) {",
              "  const id = String(ajeno.id_activo_biologico ?? ajeno.id);",
              "  pm.collectionVariables.set('id_lote_ajeno', id);",
              "  console.log('Activo ajeno elegido:', id, '(id_infraestructura=' + ajeno.id_infraestructura + ')');",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - TC-M02-027 - BOLA: consultar activo ajeno (GET)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_productor}}" }],
        "url": "{{base_url}}/activos-biologicos/{{id_lote_ajeno}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('TC-M02-027 GET - Rechaza acceso a activo de otra finca (403 o 404)', () => pm.expect([403,404]).to.include(pm.response.code));",
              "let d={}; try { d=pm.response.json(); } catch(e) {}",
              "if ([403,404].includes(pm.response.code)) {",
              "  pm.test('TC-M02-027 GET - No expone datos del activo ajeno', () => {",
              "    pm.expect(d).to.not.have.property('id_infraestructura');",
              "    pm.expect(d).to.not.have.property('detalle_poblacional');",
              "    pm.expect(d).to.not.have.property('costo_adquisicion');",
              "  });",
              "} else {",
              "  pm.test('TC-M02-027 GET - VULNERABILIDAD BOLA: se expuso el activo ajeno con HTTP ' + pm.response.code, () => pm.expect.fail('El activo ajeno no debia ser legible por este Productor'));",
              "}"
            ]
          }
        }
      ]
    },
