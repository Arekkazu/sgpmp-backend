              "let d={}; try { d=pm.response.json(); } catch(e) {}",
              "const estado=String(d.nombre_estado ?? d.estado ?? d.estado_activo ?? '').toUpperCase();",
              "pm.test('TC-M02-028 verificacion - El activo persistido esta ACTIVO, no CERRADO', () => pm.expect(estado).to.eql('ACTIVO'));",
              "const cantidadActual = (d.detalle_poblacional && d.detalle_poblacional.cantidad_actual) ?? d.cantidad_actual;",
              "if (cantidadActual !== undefined && cantidadActual !== null) {",
              "  pm.test('TC-M02-028 verificacion - cantidad_actual persistida es la inicial (10), no 9999', () => pm.expect(Number(cantidadActual)).to.eql(10));",
              "}"
            ]
          }
        }
