    {
      "name": "10 - TC-M02-028 - Crear lote inyectando estado y cantidad_actual forzados",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token_admin}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tipo_activo\": \"POBLACIONAL\",\n  \"id_especie\": {{especie_id}},\n  \"fecha_inicio_ciclo\": \"2026-09-09T00:00:00Z\",\n  \"origen_financiero\": \"nacimiento\",\n  \"id_infraestructura\": {{infraestructura_id}},\n  \"atributos_dinamicos\": {},\n  \"cantidad_inicial\": 10,\n  \"peso_promedio_inicial\": 2.5,\n  \"costo_adquisicion\": null,\n  \"soporte_documental\": null,\n  \"estado\": \"CERRADO\",\n  \"cantidad_actual\": 9999\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{base_url}}/activos-biologicos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let d={}; try { d=pm.response.json(); } catch(e) {}",
              "pm.test('TC-M02-028 - Registro aceptado (HTTP 201)', () => pm.expect(pm.response.code).to.eql(201));",
              "const id=d.id_activo_biologico ?? d.id_activo ?? d.id ?? (d.data && (d.data.id_activo_biologico ?? d.data.id_activo ?? d.data.id));",
              "pm.test('TC-M02-028 - ID generado', () => pm.expect(id, 'No se encontro ID del activo').to.exist);",
              "if(id !== undefined) pm.collectionVariables.set('activo_mass_assignment_id', String(id));",
              "const estado=String(d.nombre_estado ?? d.estado ?? d.estado_activo ?? (d.data && (d.data.nombre_estado ?? d.data.estado)) ?? '').toUpperCase();",
              "pm.test('TC-M02-028 - El estado inyectado (CERRADO) fue ignorado, activo queda ACTIVO', () => pm.expect(estado, 'El backend acepto el estado CERRADO inyectado por el usuario').to.eql('ACTIVO'));",
              "const cantidadActual = (d.detalle_poblacional && d.detalle_poblacional.cantidad_actual) ?? d.cantidad_actual;",
              "if (cantidadActual !== undefined && cantidadActual !== null) {",
              "  pm.test('TC-M02-028 - cantidad_actual inyectada (9999) fue ignorada', () => pm.expect(Number(cantidadActual), 'El backend acepto cantidad_actual=9999 inyectada por el usuario').to.eql(10));",
              "}"
            ]
          }
        }
      ]
    },
