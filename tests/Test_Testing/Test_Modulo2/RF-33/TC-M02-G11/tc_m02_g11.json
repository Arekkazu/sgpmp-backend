    {
      "name": "TC-M02-012-A - Rechazar fecha_inicio_ciclo futura",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tipo_activo\": \"POBLACIONAL\",\n  \"id_especie\": {{especie_id}},\n  \"fecha_inicio_ciclo\": \"{{fecha_futura}}\",\n  \"origen_financiero\": \"nacimiento\",\n  \"id_infraestructura\": {{infraestructura_id}},\n  \"atributos_dinamicos\": {},\n  \"identificador\": null,\n  \"raza\": null,\n  \"sexo\": null,\n  \"fecha_nacimiento\": null,\n  \"peso_inicial\": null,\n  \"cantidad_inicial\": 10,\n  \"peso_promedio_inicial\": 2.5\n}"
        },
        "url": {
          "raw": "{{base_url}}/activos-biologicos",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "activos-biologicos"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const tomorrow = new Date(Date.now() + 24 * 60 * 60 * 1000);",
              "const yyyy = tomorrow.getUTCFullYear();",
              "const mm = String(tomorrow.getUTCMonth() + 1).padStart(2, '0');",
              "const dd = String(tomorrow.getUTCDate()).padStart(2, '0');",
              "const fecha = `${yyyy}-${mm}-${dd}`;",
              "pm.collectionVariables.set(\"fecha_futura\", fecha);",
              "console.log(\"Fecha futura enviada:\", fecha);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"HTTP 400 - fecha futura es rechazada\", function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "const body = pm.response.json();",
              "const texto = JSON.stringify(body).toLowerCase();",
              "",
              "pm.test(\"El error corresponde a fecha_inicio_ciclo\", function () {",
              "    pm.expect(texto).to.include(\"fecha_inicio_ciclo\");",
              "});",
              "",
              "pm.test(\"El error indica que la fecha futura no es válida\", function () {",
              "    pm.expect(texto).to.satisfy(t =>",
              "        t.includes(\"futura\") ||",
              "        t.includes(\"actual\") ||",
              "        t.includes(\"posterior\") ||",
              "        t.includes(\"mayor\") ||",
              "        t.includes(\"fecha_inicio_ciclo\")",
              "    );",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
