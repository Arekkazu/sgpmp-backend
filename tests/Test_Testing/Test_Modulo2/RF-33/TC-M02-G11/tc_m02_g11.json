    {
      "name": "TC-M02-011-A - Rechazar cantidad_inicial = 0",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tipo_activo\": \"POBLACIONAL\",\n  \"id_especie\": {{especie_id}},\n  \"fecha_inicio_ciclo\": \"2026-09-09\",\n  \"origen_financiero\": \"nacimiento\",\n  \"id_infraestructura\": {{infraestructura_id}},\n  \"atributos_dinamicos\": {},\n  \"identificador\": null,\n  \"raza\": null,\n  \"sexo\": null,\n  \"fecha_nacimiento\": null,\n  \"peso_inicial\": null,\n  \"cantidad_inicial\": 0,\n  \"peso_promedio_inicial\": 2.5\n}"
        },
        "url": {
          "raw": "{{base_url}}/activos-biologicos",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "activos-biologicos"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"HTTP 400 - cantidad_inicial = 0 es rechazada\", function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "const body = pm.response.json();",
              "const texto = JSON.stringify(body).toLowerCase();",
              "",
              "pm.test(\"El error corresponde a cantidad_inicial\", function () {",
              "    pm.expect(texto).to.include(\"cantidad_inicial\");",
              "});",
              "",
              "pm.test(\"El mensaje indica que la cantidad debe ser mayor a 0\", function () {",
              "    pm.expect(texto).to.satisfy(t =>",
              "        t.includes(\"debe ser mayor a 0\") ||",
              "        t.includes(\"mayor a cero\") ||",
              "        t.includes(\"mayor que 0\")",
              "    );",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
