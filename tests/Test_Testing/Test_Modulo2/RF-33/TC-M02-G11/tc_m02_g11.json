              "});",
              "",
              "const body = pm.response.json();",
              "let infraestructuras = Array.isArray(body) ? body : (body.items || body.data || body.infraestructuras || []);",
              "",
              "const infraestructura = infraestructuras.find(i => i.es_activa === true || i.es_activo === true || i.estado === \"ACTIVO\") || infraestructuras[0];",
              "",
              "pm.test(\"Existe una infraestructura disponible\", function () {",
