    {
      "name": "Obtener especie activa",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/configuracion/especies",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "configuracion",
            "especies"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"HTTP 200 - Consulta de especies exitosa\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const body = pm.response.json();",
              "let especies = Array.isArray(body) ? body : (body.items || body.data || body.especies || []);",
              "",
              "const especie = especies.find(e => e.es_activo === true) || especies.find(e => e.estado === \"ACTIVO\") || especies[0];",
              "",
              "pm.test(\"Existe una especie disponible\", function () {",
              "    pm.expect(especie).to.exist;",
              "});",
              "",
              "if (especie) {",
              "    const id = especie.id_especie ?? especie.id;",
              "    pm.expect(id).to.exist;",
              "    pm.collectionVariables.set(\"especie_id\", String(id));",
              "    console.log(\"Especie seleccionada:\", id, especie.nombre_especie || especie.nombre);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
