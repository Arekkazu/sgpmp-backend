    {
      "name": "07 - TC-M02-018 - TRANSFERENCIA_INTERNA valida con costo y soporte",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const transferTimestamp = Date.now();",
              "pm.variables.set('timestamp', transferTimestamp);",
              "pm.collectionVariables.set('identificador_transferencia', 'TRF-' + transferTimestamp);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('TC-M02-018 - HTTP 201', function () {",
              "    pm.expect(pm.response.code).to.eql(201);",
              "});",
              "",
              "const transferResponse = pm.response.json();",
              "const transferData = transferResponse.data || transferResponse;",
              "",
              "const transferId = transferData.id_activo_biologico || transferData.id || transferResponse.id_activo_biologico || transferResponse.id;",
              "pm.collectionVariables.set('activo_transferencia_id', String(transferId || ''));",
              "",
              "pm.test('TC-M02-018 - activo creado', function () {",
              "    pm.expect(transferId).to.exist;",
              "});",
              "",
              "const transferOrigin = String(transferData.origen_financiero ?? transferResponse.origen_financiero ?? '').toLowerCase();",
              "",
              "pm.test('TC-M02-018 - origen TRANSFERENCIA_INTERNA', function () {",
              "    pm.expect(transferOrigin).to.eql('transferencia_interna');",
              "});",
              "",
              "const transferCost = transferData.costo_adquisicion ?? transferResponse.costo_adquisicion;",
              "",
              "pm.test('TC-M02-018 - costo registrado', function () {",
              "    pm.expect(Number(transferCost)).to.be.above(0);",
              "});",
              "",
              "const transferSupport = transferData.soporte_documental ?? transferResponse.soporte_documental;",
              "",
              "pm.test('TC-M02-018 - soporte registrado', function () {",
              "    pm.expect(transferSupport).to.exist;",
              "});",
              "",
              "console.log('Activo transferencia creado:', transferData);"
            ]
          }
        }
