      "name": "02 - Consultar especie activa",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Especies HTTP 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const speciesResponse = pm.response.json();",
              "const speciesItems = speciesResponse.items || speciesResponse.data || speciesResponse;",
              "const speciesList = Array.isArray(speciesItems) ? speciesItems : [];",
              "",
              "const selectedSpecies = speciesList.find(function (e) {",
              "    return e.es_activo === true || e.estado === 'ACTIVO' || e.estado_especie === 'ACTIVO';",
              "}) || speciesList.find(function (e) {",
              "    return Number(e.id_especie) === 4;",
              "});",
              "",
              "pm.expect(selectedSpecies, 'Debe existir una especie válida').to.exist;",
              "pm.collectionVariables.set('especie_id', String(selectedSpecies.id_especie));",
              "",
              "console.log('Especie seleccionada:', selectedSpecies);"
            ]
          }
        }
      ],
