{
  "info": {
    "name": "TC-M02-G14 v2.0 - COMPRA/DONACION: costo > 0 y soporte obligatorios; ausencia de cualquiera = HTTP 422 (RF-33 v1.2)",
    "description": "RF-33: si origen_financiero_activo = COMPRA o DONACION, costo_adquisicion > 0 y soporte documental obligatorios; en ausencia de cualquiera el sistema rechaza con HTTP 422. Complementa la v1 (que aceptaba 400/422).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0A. Login admin.test",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('fecha_hoy', new Date().toISOString().slice(0,10));",
              "pm.collectionVariables.set('rid', String(Date.now()));",
              "pm.collectionVariables.set('fecha_inicio', new Date(Date.now() - 0*86400000).toISOString().slice(0,10));",
              "pm.collectionVariables.set('rid', String(Date.now()).slice(-8));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login exitoso (200)', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) { pm.collectionVariables.set('token_admin', pm.response.json().token); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/sesiones/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"{{correo_admin}}\",\n  \"contrasena\": \"{{contrasena_admin}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "TC-M02-016a - COMPRA sin costo",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "console.log('[TC-M02-016a] status=' + pm.response.code + ' body=' + pm.response.text());",
              "pm.test('TC-M02-016a - COMPRA sin costo: HTTP 422', function () { pm.response.to.have.status(422); });",
              "let b; try { b = pm.response.json(); } catch (e) { b = {}; }",
              "pm.test('TC-M02-016a - COMPRA sin costo: no se crea el activo', function () { pm.expect(b.id_activo_biologico === undefined || b.id_activo_biologico === null).to.eql(true); });"
            ]
          }
        }
      ],
