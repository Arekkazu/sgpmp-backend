        "url": "{{base_url}}/configuracion/especies"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Especies - HTTP 200', () => pm.expect(pm.response.code).to.eql(200));",
              "let d={}; try { d=pm.response.json(); } catch(e) {}",
              "console.log('ESPECIES:', d);",
              "const items=Array.isArray(d) ? d : (d.items ?? d.data ?? []);",
              "const especie=items.find(x => x.es_activo === true || x.estado === 'ACTIVO' || x.estado_especie === 'ACTIVO') ?? items.find(x => x.id_especie === 4) ?? items[0];",
              "pm.test('Especie activa encontrada', () => pm.expect(especie, 'No se encontró especie activa').to.exist);",
              "if(especie) {",
              "  const id=especie.id_especie ?? especie.id;",
              "  pm.collectionVariables.set('especie_id', String(id));",
              "  console.log('ESPECIE SELECCIONADA:', id, especie.nombre ?? especie.nombre_especie);",
              "}"
            ]
          }
        }
      ]
    },
