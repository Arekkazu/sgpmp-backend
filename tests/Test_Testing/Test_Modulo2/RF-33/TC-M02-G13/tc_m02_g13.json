    {
      "name": "04 - TC-M02-015 - Crear activo enviando estado INACTIVO",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tipo_activo\": \"INDIVIDUAL\",\n  \"id_especie\": {{especie_id}},\n  \"fecha_inicio_ciclo\": \"2026-09-09T00:00:00Z\",\n  \"origen_financiero\": \"nacimiento\",\n  \"id_infraestructura\": {{infraestructura_id}},\n  \"atributos_dinamicos\": {},\n  \"identificador\": \"TCM02-G13-015-{{$timestamp}}\",\n  \"raza\": \"Cachama\",\n  \"sexo\": \"Macho\",\n  \"fecha_nacimiento\": \"2025-01-15T00:00:00Z\",\n  \"peso_inicial\": 2.5,\n  \"cantidad_inicial\": null,\n  \"peso_promedio_inicial\": null,\n  \"costo_adquisicion\": null,\n  \"soporte_documental\": null,\n  \"estado\": \"INACTIVO\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/activos-biologicos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "javascript",
            "exec": [
              "let d={}; try { d=pm.response.json(); } catch(e) {}",
              "console.log('TC-M02-015 RESPUESTA:', d);",
              "pm.test('TC-M02-015 - Registro aceptado', () => pm.expect(pm.response.code).to.eql(201));",
              "const id=d.id_activo_biologico ?? d.id_activo ?? d.id ?? (d.data && (d.data.id_activo_biologico ?? d.data.id_activo ?? d.data.id));",
              "pm.test('TC-M02-015 - ID generado', () => pm.expect(id, 'No se encontró ID del activo').to.exist);",
              "if(id !== undefined) pm.collectionVariables.set('activo_estado_id', String(id));",
              "const estado=String(d.nombre_estado ?? d.estado ?? d.estado_activo ?? (d.data && (d.data.nombre_estado ?? d.data.estado)) ?? '').toUpperCase();",
              "pm.test('TC-M02-015 - Estado inicial ACTIVO', () => pm.expect(estado).to.include('ACTIVO'));",
              "pm.test('TC-M02-015 - Estado no quedó INACTIVO', () => pm.expect(estado).to.not.eql('INACTIVO'));",
              "pm.test('TC-M02-015 - El usuario no controla el estado inicial', () => pm.expect(estado, 'El backend no devolvió estado ACTIVO').to.eql('ACTIVO'));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - TC-M02-020 - Crear activo poblacional para verificar snapshot",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tipo_activo\": \"POBLACIONAL\",\n  \"id_especie\": {{especie_id}},\n  \"fecha_inicio_ciclo\": \"2026-09-09T00:00:00Z\",\n  \"origen_financiero\": \"nacimiento\",\n  \"id_infraestructura\": {{infraestructura_id}},\n  \"atributos_dinamicos\": {},\n  \"identificador\": null,\n  \"raza\": null,\n  \"sexo\": null,\n  \"fecha_nacimiento\": null,\n  \"peso_inicial\": null,\n  \"cantidad_inicial\": 10,\n  \"peso_promedio_inicial\": 2.5,\n  \"costo_adquisicion\": null,\n  \"soporte_documental\": null\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/activos-biologicos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "javascript",
            "exec": [
              "let d={}; try { d=pm.response.json(); } catch(e) {}",
              "console.log('TC-M02-020 CREACION:', d);",
              "pm.test('TC-M02-020 - HTTP 201', () => pm.expect(pm.response.code).to.eql(201));",
              "const id=d.id_activo_biologico ?? d.id_activo ?? d.id ?? (d.data && (d.data.id_activo_biologico ?? d.data.id_activo ?? d.data.id));",
              "pm.test('TC-M02-020 - ID generado', () => pm.expect(id, 'No se encontró ID del activo poblacional').to.exist);",
              "if(id !== undefined) pm.collectionVariables.set('activo_snapshot_id', String(id));",
              "const pobl=d.detalle_poblacional ?? d.detallePoblacional ?? (d.data && (d.data.detalle_poblacional ?? d.data.detallePoblacional)) ?? {};",
              "const qi=pobl.cantidad_inicial ?? d.cantidad_inicial ?? (d.data && d.data.cantidad_inicial);",
              "const qp=pobl.peso_promedio_inicial ?? d.peso_promedio_inicial ?? (d.data && d.data.peso_promedio_inicial);",
              "const qa=pobl.cantidad_actual ?? d.cantidad_actual ?? (d.data && d.data.cantidad_actual);",
              "pm.test('TC-M02-020 - cantidad inicial persistida', () => pm.expect(Number(qi)).to.eql(10));",
              "pm.test('TC-M02-020 - peso promedio inicial persistido', () => pm.expect(Number(qp)).to.eql(2.5));",
              "pm.test('TC-M02-020 - cantidad actual inicia igual a cantidad inicial', () => pm.expect(Number(qa)).to.eql(10));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - TC-M02-020 - Consultar snapshot inicial en historial",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": "{{base_url}}/activos-biologicos/{{activo_snapshot_id}}/historial"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "javascript",
            "exec": [
              "let d={}; try { d=pm.response.json(); } catch(e) {}",
              "console.log('TC-M02-020 HISTORIAL:', d);",
              "pm.test('TC-M02-020 - Historial HTTP 200', () => pm.expect(pm.response.code).to.eql(200));",
              "const registros=d.registros ?? d.items ?? d.data ?? [];",
              "pm.test('TC-M02-020 - Existe al menos un registro historico', () => pm.expect(registros.length, 'El historial no contiene registros').to.be.above(0));",
              "const snapshot=registros.find(x => String(x.tipo_evento ?? x.tipoEvento ?? '').toUpperCase() === 'CREACION' || Number(x.version ?? x.version_historial ?? 0) === 1) ?? registros[0];",
              "pm.test('TC-M02-020 - Existe snapshot inicial', () => pm.expect(snapshot, 'No se encontró snapshot inicial').to.exist);",
              "if(snapshot) {",
              "  const version=Number(snapshot.version ?? snapshot.version_historial ?? snapshot.numero_version ?? 0);",
              "  const tipo=String(snapshot.tipo_evento ?? snapshot.tipoEvento ?? '').toUpperCase();",
              "  const qi=snapshot.cantidad_inicial ?? snapshot.cantidadInicial;",
              "  const qp=snapshot.peso_promedio_inicial ?? snapshot.pesoPromedioInicial;",
              "  const qa=snapshot.cantidad_actual ?? snapshot.cantidadActual;",
              "  pm.test('TC-M02-020 - Version 1', () => pm.expect(version).to.eql(1));",
              "  pm.test('TC-M02-020 - Tipo de evento CREACION', () => pm.expect(tipo).to.include('CREACION'));",
              "  pm.test('TC-M02-020 - cantidad_inicial = 10', () => pm.expect(Number(qi)).to.eql(10));",
              "  pm.test('TC-M02-020 - peso_promedio_inicial = 2.5', () => pm.expect(Number(qp)).to.eql(2.5));",
              "  pm.test('TC-M02-020 - cantidad_actual = cantidad_inicial = 10', () => pm.expect(Number(qa)).to.eql(10));",
              "}"
            ]
          }
        }
      ]
    },
