              "pm.test('021 GET costo=1000000', function () {",
              "  pm.expect(Number(pm.response.json().costo_adquisicion)).to.eql(1000000);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{base_url}}/activos-biologicos/{{activo_costo_id}}"
      }
    },
    {
      "name": "10 - PATCH RF-35 solo costo_adquisicion=2000000 (021)",
      "event": [
        {
          "listen": "prerequest",
          "script": { "type": "text/javascript", "exec": ["if (pm.collectionVariables.get('altaCostoOk') !== '1') { pm.execution.skipRequest(); }"] }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.collectionVariables.get('altaCostoOk') !== '1') { pm.test.skip('021 alta no 201'); return; }",
              "const json = (() => { try { return pm.response.json(); } catch (e) { return {}; } })();",
              "pm.test('021 intento A no es 201', function () { pm.expect(pm.response.code).to.not.eql(201); });",
              "pm.test('021 intento A no actualiza costo (400/422 o 200 con costo intacto)', function () {",
              "  if (pm.response.code === 200) {",
              "    pm.expect(Number(json.costo_adquisicion)).to.eql(1000000);",
              "  } else {",
              "    pm.expect(pm.response.code).to.be.oneOf([400, 422]);",
              "  }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"costo_adquisicion\": 2000000\n}" },
        "url": "{{base_url}}/activos-biologicos/{{activo_costo_id}}"
      }
    },
    {
      "name": "11 - PATCH RF-35 raza + costo extra (021)",
      "event": [
