    {
      "name": "Limpieza - desactivar metricas QA",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const ids = JSON.parse(pm.collectionVariables.get('ids_creadas') || '[]'); const base = pm.collectionVariables.get('base_url'); const tok = pm.collectionVariables.get('token_admin'); ids.forEach(function (id) { pm.sendRequest({ url: base + '/configuracion/metricas/' + id + '/desactivar', method: 'PATCH', header: { Authorization: 'Bearer ' + tok } }, function () {}); });"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Limpieza ejecutada (GET 200)', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
