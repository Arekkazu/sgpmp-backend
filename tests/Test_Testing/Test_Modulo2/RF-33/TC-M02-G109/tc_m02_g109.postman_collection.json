    {
      "name": "0A. Login admin.test",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('fecha_hoy', new Date().toISOString().slice(0,10));",
              "pm.collectionVariables.set('rid', String(Date.now()));",
              "pm.collectionVariables.set('fecha_inicio', new Date(Date.now() - 0*86400000).toISOString().slice(0,10));",
              "pm.collectionVariables.set('ids_creadas','[]');",
              "pm.collectionVariables.set('rid', String(Date.now()).slice(-8));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login exitoso (200)', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) { pm.collectionVariables.set('token_admin', pm.response.json().token); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
