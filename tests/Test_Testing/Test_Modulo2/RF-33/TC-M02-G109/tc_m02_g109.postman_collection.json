    {
      "name": "TC-M02-315 - Rechazar valor por debajo de valor_min o por encima de valor_max",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('GET metricas responde 200', function () { pm.response.to.have.status(200); });",
              "const b = pm.response.json(); const hay = (b.items || []).some((m) => 'valor_min' in m);",
              "console.log('[TC-M02-315] el backend expone valor_min/valor_max: ' + hay);",
              "if (!hay) { pm.test.skip('TC-M02-315 NO EJECUTABLE: el backend de TEST no expone valor_min/valor_max en las metricas (ver TC-M09-G130, RF-16 v1.2 sin implementar)'); } else { pm.test('TC-M02-315 requiere definir el rango en una metrica QA: completar esta coleccion', function () { pm.expect.fail('Backend ya expone valor_min/valor_max: completar el caso'); }); }"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
