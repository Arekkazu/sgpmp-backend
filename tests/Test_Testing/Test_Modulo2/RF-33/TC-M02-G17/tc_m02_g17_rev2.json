            "exec": [
              "if (pm.collectionVariables.get('loginOk') !== '1') { pm.test.skip('Login no OK'); return; }",
              "if (pm.collectionVariables.get('hay187') !== '1') {",
              "  pm.test.skip('TC-M02-187 BLOQUEADO POR CONFIGURACION: ninguna especie activa con es_obligatorio=true en GET /configuracion/metricas');",
              "  return;",
              "}",
              "const code = pm.response.code;",
              "let json = {}; try { json = pm.response.json(); } catch (e) {}",
              "console.log('TC-M02-187 omitir HTTP', code, JSON.stringify(json));",
              "if (code === 500) {",
              "  pm.test('TC-M02-187 BLOQUEADO: HTTP 500 no demuestra rechazo de atributo obligatorio', function () {",
              "    pm.expect.fail('HTTP 500 ERROR_INTERNO; validacion no comprobable');",
              "  });",
              "  return;",
              "}",
              "pm.test('TC-M02-187 HTTP 422', function () { pm.expect(code).to.eql(422); });",
              "pm.test('TC-M02-187 error_code ATRIBUTO_REQUERIDO (o equivalente de atributo obligatorio)', function () {",
              "  const ec = String(json.error_code || '');",
              "  const msg = String(json.message || '').toLowerCase();",
              "  const ok = ec === 'ATRIBUTO_REQUERIDO' || msg.indexOf('obligatorio') >= 0;",
              "  pm.expect(ok, 'error_code=' + ec + ' message=' + json.message).to.eql(true);",
              "});",
              "pm.test('TC-M02-187 no crea activo (sin id)', function () {",
              "  pm.expect(json.id_activo_biologico == null).to.eql(true);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
