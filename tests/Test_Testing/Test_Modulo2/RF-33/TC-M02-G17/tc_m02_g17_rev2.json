              "pm.test('Variables de descubrimiento disponibles (pueden quedar 0 si RF-16 no ofrece config)', function () {",
              "  pm.expect(pm.collectionVariables.get('hay187')).to.be.oneOf(['0','1']);",
              "  pm.expect(pm.collectionVariables.get('hay188')).to.be.oneOf(['0','1']);",
              "});"
            ]
          }
        }
      ],
      "request": {
