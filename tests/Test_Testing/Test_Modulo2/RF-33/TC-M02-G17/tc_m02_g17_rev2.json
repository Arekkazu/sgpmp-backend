              "console.log('hay188=' + pm.collectionVariables.get('hay188') + ' especie=' + pm.collectionVariables.get('especie_188') + ' attr=' + pm.collectionVariables.get('nombre_attr_188') + ' tipo=' + pm.collectionVariables.get('tipo_dato_188'));",
              "console.log('especie4', pm.collectionVariables.get('especie4_metricas'));",
