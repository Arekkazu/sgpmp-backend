    {
      "name": "01 - Login Admin (unico)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": ["if (!pm.environment.get('contrasena')) { throw new Error('BLOQUEADO: --env-var contrasena'); }"]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login HTTP 200', function () { pm.response.to.have.status(200); });",
              "let json = {}; try { json = pm.response.json(); } catch (e) {}",
              "pm.test('Token presente', function () { pm.expect(json.token).to.be.a('string').and.not.empty; });",
              "if (pm.response.code === 200 && json.token) {",
              "  pm.collectionVariables.set('token', json.token);",
              "  pm.collectionVariables.set('loginOk', '1');",
              "} else { pm.collectionVariables.set('loginOk', '0'); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"correo_electronico\": \"{{correo}}\",\n  \"contrasena\": \"{{contrasena}}\"\n}" },
        "url": "{{base_url}}/sesiones/"
      }
    },
    {
      "name": "02 - Infraactiva finca 1",
      "event": [
        {
          "listen": "prerequest",
          "script": { "type": "text/javascript", "exec": ["if (pm.collectionVariables.get('loginOk') !== '1') { pm.execution.skipRequest(); }"] }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.collectionVariables.get('loginOk') !== '1') { pm.test.skip('Login no OK'); return; }",
              "pm.test('GET infraestructuras responde', function () { pm.expect(pm.response.code).to.be.a('number'); });",
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json() || {};",
              "  const items = body.items || body.registros || [];",
              "  const inf = items.find(function (x) { return x.es_activo === true || x.es_activa === true; }) || items[0];",
              "  pm.test('Hay infraestructura', function () { pm.expect(inf).to.exist; });",
              "  if (inf) pm.collectionVariables.set('infraestructura_id', String(inf.id_infraestructura || inf.id));",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{base_url}}/configuracion/infraestructuras?finca_id=1&solo_activas=true"
      }
    },
    {
      "name": "03 - Catalogo especies + descubrimiento RF-16",
      "event": [
        {
          "listen": "prerequest",
          "script": { "type": "text/javascript", "exec": ["if (pm.collectionVariables.get('loginOk') !== '1') { pm.execution.skipRequest(); }"] }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.collectionVariables.get('loginOk') !== '1') { pm.test.skip('Login no OK'); return; }",
              "pm.test('GET especies HTTP 200', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code !== 200) { return; }",
              "const body = pm.response.json() || {};",
              "const especies = body.items || body.registros || [];",
              "pm.test('Hay especies en catalogo', function () { pm.expect(especies.length).to.be.above(0); });",
              "const base = pm.environment.get('base_url') || pm.collectionVariables.get('base_url');",
              "const token = pm.collectionVariables.get('token');",
              "function tipoActivo(aplica) {",
              "  const a = String(aplica || 'AMBOS').toUpperCase();",
              "  return a === 'INDIVIDUAL' ? 'INDIVIDUAL' : 'POBLACIONAL';",
              "}",
              "function valorIncompatible(tipoDato) {",
              "  const t = String(tipoDato || '').toUpperCase();",
              "  if (t === 'TEXTO') return { valor: 12345, enviado: 'number' };",
              "  if (t === 'BOOLEANO') return { valor: 'no-bool', enviado: 'string' };",
              "  return { valor: 'no-es-numero', enviado: 'string' };",
              "}",
              "const httpResumen = [];",
              "let hay187 = false;",
              "let hay188 = false;",
              "especies.slice(0, 40).forEach(function (esp) {",
              "  const idEsp = esp.id_especie || esp.id;",
              "  if (!idEsp) return;",
              "  const activa = esp.es_activo !== false && String(esp.estado || 'ACTIVO').toUpperCase() !== 'INACTIVO';",
              "  if (!activa) return;",
              "  const url = base + '/configuracion/metricas?id_especie=' + idEsp + '&solo_activas=true';",
              "  pm.sendRequest({ url: url, method: 'GET', header: { Authorization: 'Bearer ' + token } }, function (err, res) {",
              "    const code = err ? 0 : res.code;",
              "    let items = [];",
              "    try { const j = res.json() || {}; items = j.items || []; } catch (e) {}",
              "    httpResumen.push({ id_especie: idEsp, nombre: esp.nombre || esp.nombre_comun, http: code, n: items.length });",
              "    pm.collectionVariables.set('metricas_http_resumen', JSON.stringify(httpResumen));",
              "    if (Number(idEsp) === 4) {",
              "      pm.collectionVariables.set('especie4_metricas', JSON.stringify({ http: code, items: items }));",
              "    }",
              "    if (code !== 200) { return; }",
              "    items.forEach(function (m) {",
              "      if (!hay187 && m.es_obligatorio === true) {",
              "        hay187 = true;",
              "        pm.collectionVariables.set('hay187', '1');",
              "        pm.collectionVariables.set('especie_187', String(idEsp));",
              "        pm.collectionVariables.set('nombre_attr_187', String(m.nombre));",
              "        pm.collectionVariables.set('tipo_activo_187', tipoActivo(m.aplica_a_tipo_activo));",
              "        pm.collectionVariables.set('config_187', JSON.stringify({ id_especie: idEsp, metrica: m }));",
              "      }",
              "      const td = String(m.tipo_dato || '').toUpperCase();",
              "      if (!hay188 && ['NUMERICO','ENTERO','TEXTO','BOOLEANO'].indexOf(td) >= 0) {",
              "        hay188 = true;",
              "        const inc = valorIncompatible(td);",
              "        pm.collectionVariables.set('hay188', '1');",
              "        pm.collectionVariables.set('especie_188', String(idEsp));",
              "        pm.collectionVariables.set('nombre_attr_188', String(m.nombre));",
              "        pm.collectionVariables.set('tipo_dato_188', td);",
              "        pm.collectionVariables.set('tipo_enviado_188', inc.enviado);",
              "        pm.collectionVariables.set('valor_188', typeof inc.valor === 'string' ? inc.valor : JSON.stringify(inc.valor));",
              "        pm.collectionVariables.set('tipo_activo_188', tipoActivo(m.aplica_a_tipo_activo));",
              "        pm.collectionVariables.set('config_188', JSON.stringify({ id_especie: idEsp, metrica: m, valor_incompatible: inc.valor }));",
              "      }",
              "    });",
              "  });",
              "});",
              "const esp189 = especies.find(function (e) { return Number(e.id_especie || e.id) === 4; }) || especies[0];",
              "if (esp189) pm.collectionVariables.set('especie_189', String(esp189.id_especie || esp189.id));",
              "pm.test('Descubrimiento RF-16 lanzado (metricas por especie activa)', function () {",
              "  pm.expect(especies.length).to.be.above(0);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{base_url}}/configuracion/especies?solo_activas=true"
      }
    },
