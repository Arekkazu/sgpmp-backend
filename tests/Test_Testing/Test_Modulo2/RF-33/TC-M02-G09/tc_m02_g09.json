    {
      "name": "07 - Preparar activo con identificador BOV-001",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "console.log(\"============================================\");",
              "console.log(\"PRECONDICION TC-M02-008 - BOV-001\");",
              "console.log(\"STATUS:\", pm.response.code);",
              "console.log(\"BODY:\", pm.response.text());",
              "console.log(\"============================================\");",
              "",
              "pm.test(\"BOV-001 existe o fue creado\", function () {",
              "    pm.expect([201, 409]).to.include(pm.response.code);",
              "});",
              "",
              "if (pm.response.code === 201) {",
              "    const json = pm.response.json();",
              "    pm.collectionVariables.set(\"bov001_id\", json.id_activo_biologico || json.id);",
              "    console.log(\"BOV-001 creado con ID:\", json.id_activo_biologico || json.id);",
              "} else if (pm.response.code === 409) {",
              "    console.log(\"BOV-001 ya existe. Se utilizara para probar duplicidad.\");",
              "}"
            ],
            "type": "text/javascript"
          }
        }
