        {
          "listen": "test",
          "script": {
            "exec": [
              "console.log(\"============================================\");",
              "console.log(\"TC-M02-006 - IDENTIFICADOR + CANTIDAD_INICIAL\");",
              "console.log(\"STATUS:\", pm.response.code);",
              "console.log(\"BODY:\", pm.response.text());",
              "console.log(\"============================================\");",
              "",
              "pm.test(\"TC-M02-006 rechaza los campos excluyentes simultaneos\", function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "if (pm.response.code === 400) {",
              "    const json = pm.response.json();",
              "",
              "    pm.test(\"La respuesta contiene informacion de validacion\", function () {",
              "        pm.expect(json.message || json.fields || json.error_code).to.exist;",
              "    });",
