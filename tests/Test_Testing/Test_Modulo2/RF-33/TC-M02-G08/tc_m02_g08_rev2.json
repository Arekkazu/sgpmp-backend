              "pm.collectionVariables.set('activo_individual_id', String(id));",
              "pm.collectionVariables.set('altaIndividualOk', '1');",
              "pm.test('TC-M02-004 id_activo_biologico', function () { pm.expect(id).to.be.a('number'); });",
              "pm.test('TC-M02-004 tipo INDIVIDUAL', function () { pm.expect(json.tipo).to.eql('INDIVIDUAL'); });",
              "pm.test('TC-M02-004 identificador coincide', function () {",
              "    pm.expect(json.identificador).to.eql(pm.collectionVariables.get('identificador_individual'));",
              "});",
              "pm.test('TC-M02-004 id_especie', function () { pm.expect(String(json.id_especie)).to.eql(pm.collectionVariables.get('especie_id')); });",
              "pm.test('TC-M02-004 id_infraestructura', function () { pm.expect(String(json.id_infraestructura)).to.eql(pm.collectionVariables.get('infraestructura_id')); });",
              "pm.test('TC-M02-004 origen_financiero compra', function () { pm.expect(json.origen_financiero).to.eql('compra'); });",
