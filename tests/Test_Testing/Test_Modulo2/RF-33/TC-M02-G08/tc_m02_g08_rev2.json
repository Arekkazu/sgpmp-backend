              "if (pm.collectionVariables.get('precheckOk') !== '1') { pm.test.skip('Precheck incompleto'); return; }",
              "pm.test('TC-M02-004 POST HTTP 201', function () { pm.response.to.have.status(201); });",
              "if (pm.response.code !== 201) { pm.collectionVariables.set('altaIndividualOk', '0'); return; }",
              "const json = pm.response.json();",
