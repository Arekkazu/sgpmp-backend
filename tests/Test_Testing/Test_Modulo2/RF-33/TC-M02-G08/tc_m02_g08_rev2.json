    {
      "name": "01 - Login Productor (unico)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.environment.get('contrasena')) { throw new Error('BLOQUEADO: --env-var contrasena'); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login HTTP 200', function () { pm.response.to.have.status(200); });",
              "let json = {};",
              "try { json = pm.response.json(); } catch (e) {}",
              "pm.test('Token presente', function () { pm.expect(json.token).to.be.a('string').and.not.empty; });",
              "if (pm.response.code === 200 && json.token) {",
              "    pm.collectionVariables.set('token', json.token);",
              "    pm.environment.set('token', json.token);",
              "    pm.collectionVariables.set('loginOk', '1');",
              "} else {",
              "    pm.collectionVariables.set('loginOk', '0');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"correo_electronico\": \"{{correo}}\",\n  \"contrasena\": \"{{contrasena}}\"\n}" },
        "url": "{{base_url}}/sesiones/"
      }
    },
    {
      "name": "02 - GET fincas activas",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": ["if (pm.collectionVariables.get('loginOk') !== '1') { pm.execution.skipRequest(); }"]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.collectionVariables.get('loginOk') !== '1') { pm.test.skip('Login no OK'); return; }",
              "pm.test('GET fincas HTTP 200', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "const items = (json && json.items) || [];",
              "pm.test('Hay finca activa (items)', function () { pm.expect(items.length).to.be.above(0); });",
              "function scoreFinca(f) {",
              "    const n = String(f.nombre || '').toLowerCase();",
              "    if (n.indexOf('acuicola') >= 0 || n.indexOf('remanso') >= 0) return 3;",
              "    if (n.indexOf('camaron') >= 0) return 2;",
              "    return 1;",
              "}",
              "items.sort(function (a, b) { return scoreFinca(b) - scoreFinca(a); });",
              "if (items[0] && items[0].id_finca) { pm.collectionVariables.set('finca_id', String(items[0].id_finca)); }"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{base_url}}/configuracion/fincas?solo_activas=true"
      }
    },
    {
      "name": "03 - GET especies activas",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": ["if (pm.collectionVariables.get('loginOk') !== '1') { pm.execution.skipRequest(); }"]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.collectionVariables.get('loginOk') !== '1') { pm.test.skip('Login no OK'); return; }",
              "pm.test('GET especies HTTP 200', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "const items = ((json && json.items) || []).filter(function (e) { return e.es_activo === true; });",
              "pm.test('Hay especie activa', function () { pm.expect(items.length).to.be.above(0); });",
              "function scoreEsp(e) {",
              "    const n = String(e.nombre || '').toLowerCase();",
              "    if (n === 'cachama blanca') return 5;",
              "    if (n.indexOf('cachama') >= 0) return 4;",
              "    if (n.indexOf('camaron') >= 0) return 3;",
              "    if (n.indexOf('qa') >= 0 || n.indexOf('prueba') >= 0) return 0;",
              "    return 2;",
              "}",
              "items.sort(function (a, b) { return scoreEsp(b) - scoreEsp(a); });",
              "const usable = items.filter(function (e) { return scoreEsp(e) > 0; });",
              "const chosen = usable[0] || items[0];",
              "if (chosen && chosen.id_especie) { pm.collectionVariables.set('especie_id', String(chosen.id_especie)); }"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{base_url}}/configuracion/especies?solo_activas=true"
      }
    },
