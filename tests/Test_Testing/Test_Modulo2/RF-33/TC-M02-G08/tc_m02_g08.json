    {
      "name": "04 - Obtener infraestructura activa",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Consulta de infraestructura exitosa\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "const infraestructuras = Array.isArray(json) ? json : (json.items || json.infraestructuras || json.data || []);",
