    {
      "name": "05 - TC-M02-004 Registrar INDIVIDUAL valido",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const identificador = \"TCM02-IND-\" + Date.now();",
              "pm.collectionVariables.set(\"identificador_individual\", identificador);",
              "",
              "console.log(\"IDENTIFICADOR INDIVIDUAL:\", identificador);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "console.log(\"============================================\");",
              "console.log(\"RESPUESTA TC-M02-004 INDIVIDUAL:\");",
              "console.log(\"STATUS:\", pm.response.code);",
              "console.log(\"BODY:\", pm.response.text());",
              "console.log(\"============================================\");",
              "",
              "pm.test(\"Registro individual exitoso\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "if (pm.response.code === 201) {",
              "    const json = pm.response.json();",
              "    const activoId = json.id_activo_biologico || json.id;",
              "",
              "    pm.collectionVariables.set(\"activo_individual_id\", activoId);",
              "",
              "    pm.test(\"El activo individual tiene ID\", function () {",
              "        pm.expect(activoId).to.exist;",
              "    });",
              "",
              "    pm.test(\"El activo individual queda ACTIVO\", function () {",
              "        pm.expect(json.nombre_estado || json.estado || json.id_estado).to.exist;",
              "    });",
              "",
              "    console.log(\"ACTIVO INDIVIDUAL:\", activoId);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tipo_activo\": \"INDIVIDUAL\",\n  \"id_especie\": {{especie_id}},\n  \"fecha_inicio_ciclo\": \"2026-09-08\",\n  \"detalles_procedencia\": \"Compra para prueba TC-M02-004\",\n  \"origen_financiero\": \"compra\",\n  \"costo_adquisicion\": 2500000,\n  \"soporte_documental\": \"factura_TC-M02-004.pdf\",\n  \"id_infraestructura\": {{infraestructura_id}},\n  \"atributos_dinamicos\": {},\n  \"identificador\": \"{{identificador_individual}}\",\n  \"raza\": \"Cachama\",\n  \"sexo\": \"Macho\",\n  \"fecha_nacimiento\": \"2025-01-15T00:00:00Z\",\n  \"peso_inicial\": 420,\n  \"cantidad_inicial\": null,\n  \"peso_promedio_inicial\": null\n}"
        },
        "url": {
          "raw": "{{base_url}}/activos-biologicos",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "activos-biologicos"
          ]
        }
      }
    },
    {
      "name": "06 - Historial del activo INDIVIDUAL",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (!pm.collectionVariables.get(\"activo_individual_id\")) {",
              "    console.log(\"No se ejecuta historial individual porque no existe ID del activo.\");",
              "    return;",
              "}",
              "",
              "pm.test(\"Consulta de historial individual exitosa\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "console.log(\"RESPUESTA HISTORIAL INDIVIDUAL:\");",
              "console.log(JSON.stringify(json, null, 2));",
              "",
              "const registros = Array.isArray(json)",
              "    ? json",
              "    : (json.registros || json.items || json.historial || []);",
              "",
              "console.log(\"REGISTROS ENCONTRADOS:\", registros.length);",
              "",
              "if (registros.length === 0) {",
              "    console.log(\"ADVERTENCIA: El backend devuelve historial vacio para el activo individual.\");",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/activos-biologicos/{{activo_individual_id}}/historial",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "activos-biologicos",
            "{{activo_individual_id}}",
            "historial"
          ]
        }
      }
    },
    {
      "name": "07 - TC-M02-005 Registrar POBLACIONAL valido",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "console.log(\"RESPUESTA ACTIVO POBLACIONAL:\");",
              "console.log(pm.response.text());",
              "",
              "pm.test(\"Registro poblacional exitoso\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "if (pm.response.code === 201) {",
              "    const json = pm.response.json();",
              "    const activoId = json.id_activo_biologico || json.id;",
              "    const detalle = json.detalle_poblacional || {};",
              "",
              "    pm.collectionVariables.set(\"activo_poblacional_id\", activoId);",
              "",
              "    pm.test(\"El activo poblacional tiene ID\", function () {",
              "        pm.expect(activoId).to.exist;",
              "    });",
              "",
              "    pm.test(\"La cantidad actual inicia igual a la cantidad inicial\", function () {",
              "        pm.expect(Number(detalle.cantidad_actual)).to.eql(Number(detalle.cantidad_inicial));",
              "    });",
              "",
              "    console.log(\"ACTIVO POBLACIONAL:\", activoId);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
