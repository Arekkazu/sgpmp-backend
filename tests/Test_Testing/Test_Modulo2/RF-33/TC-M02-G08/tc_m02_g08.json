{
  "info": {
    "_postman_id": "tc-m02-g08-rf33",
    "name": "TC-M02-G08 - Registro exitoso de activos biologicos",
    "description": "Prueba funcional RF-33 para registrar activos biologicos individuales y poblacionales en TEST.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Login Productor",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Login exitoso\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"La respuesta contiene token\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.token).to.be.a(\"string\");",
              "    pm.collectionVariables.set(\"token\", json.token);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"productor@pecuaria.co\",\n  \"contrasena\": \"Test1234!\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/sesiones/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "sesiones",
            ""
          ]
        }
      }
    },
    {
      "name": "02 - Obtener fincas activas",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Consulta de fincas exitosa\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "const fincas = Array.isArray(json) ? json : (json.items || json.fincas || json.data || []);",
              "",
              "pm.test(\"Existe al menos una finca activa\", function () {",
              "    pm.expect(fincas.length).to.be.above(0);",
              "});",
              "",
              "if (fincas.length > 0) {",
              "    const fincaId = fincas[0].id_finca || fincas[0].id || fincas[0].finca_id;",
              "    pm.collectionVariables.set(\"finca_id\", fincaId);",
              "    console.log(\"FINCA_ID:\", fincaId);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/configuracion/fincas?solo_activas=true",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "configuracion",
            "fincas"
          ],
          "query": [
            {
              "key": "solo_activas",
              "value": "true"
            }
          ]
        }
      }
    },
    {
      "name": "03 - Obtener especie activa",
