              "if (especies.length > 0) {",
              "    const especie = especies[0];",
              "    const especieId = especie.id_especie || especie.id || especie.especie_id;",
              "    pm.collectionVariables.set(\"especie_id\", especieId);",
              "",
              "    console.log(\"ESPECIE_ID:\", especieId);",
              "    console.log(\"ESPECIE COMPLETA:\", especie);",
              "",
              "    pm.test(\"La especie tiene identificador\", function () {",
              "        pm.expect(especieId).to.exist;",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
