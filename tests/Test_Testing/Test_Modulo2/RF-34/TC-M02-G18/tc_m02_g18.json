  "item": [
    {
      "name": "01 - Login Productor",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"productor@pecuaria.co\",\n  \"contrasena\": \"Test1234!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/sesiones/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login HTTP 200', function () {",
              "    pm.expect(pm.response.code).to.eql(200);",
              "});",
              "",
              "var d = {};",
              "try {",
              "    d = pm.response.json();",
              "} catch (e) {}",
              "",
              "var token = d.token || d.access_token || (d.data && (d.data.token || d.data.access_token));",
              "",
              "pm.test('Token obtenido', function () {",
              "    pm.expect(token, 'No se obtuvo token').to.exist;",
              "});",
              "",
              "if (token) {",
              "    pm.environment.set('access_token', String(token));",
              "    pm.collectionVariables.set('access_token', String(token));",
              "    console.log('Token establecido correctamente.');",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - TC-M02-022 - Consultar asociacion ACTIVA",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": "{{base_url}}/activos-biologicos/{{activo_id}}/infraestructura?tipo_consulta=ACTIVA"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('TC-M02-022 - HTTP 200', function () {",
              "    pm.expect(pm.response.code).to.eql(200);",
              "});",
              "",
              "var d = {};",
              "try {",
              "    d = pm.response.json();",
              "} catch (e) {}",
              "",
              "console.log('TC-M02-022 RESPUESTA ACTIVA:', d);",
              "",
              "var raw = JSON.stringify(d).toLowerCase();",
              "",
              "pm.test('TC-M02-022 - Respuesta contiene informacion de infraestructura', function () {",
              "    pm.expect(raw).to.include('infraestructura');",
              "});",
              "",
              "if (d.advertencia_integridad !== undefined) {",
              "    pm.test('TC-M02-022 - advertencia_integridad es null', function () {",
              "        pm.expect(d.advertencia_integridad).to.eql(null);",
              "    });",
              "}",
              "",
              "var asociacion = d.asociacion_actual || d.asociacion || d.infraestructura || d.data || d;",
              "var fechaFin = asociacion.fecha_fin;",
              "",
              "if (fechaFin === undefined) {",
              "    fechaFin = asociacion.fechaFin;",
              "}",
              "",
              "if (fechaFin !== undefined) {",
              "    pm.test('TC-M02-022 - Asociacion activa tiene fecha_fin null', function () {",
              "        pm.expect(fechaFin).to.eql(null);",
              "    });",
              "}",
              "",
              "var tieneInfraestructura = false;",
              "",
              "if (asociacion.id_infraestructura !== undefined) {",
              "    tieneInfraestructura = true;",
              "}",
              "",
              "if (asociacion.nombre_infraestructura !== undefined) {",
              "    tieneInfraestructura = true;",
              "}",
              "",
              "if (raw.indexOf('infraestructura') !== -1) {",
              "    tieneInfraestructura = true;",
              "}",
              "",
              "pm.test('TC-M02-022 - Existe infraestructura asociada', function () {",
              "    pm.expect(tieneInfraestructura).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - TC-M02-023 - Consultar HISTORIAL completo",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": "{{base_url}}/activos-biologicos/{{activo_id}}/infraestructura?tipo_consulta=HISTORIAL"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('TC-M02-023 - HTTP 200', function () {",
              "    pm.expect(pm.response.code).to.eql(200);",
              "});",
              "",
              "var d = {};",
              "try {",
              "    d = pm.response.json();",
              "} catch (e) {}",
              "",
              "console.log('TC-M02-023 HISTORIAL:', d);",
              "",
              "var historial = [];",
              "",
              "if (Array.isArray(d.historial)) {",
              "    historial = d.historial;",
              "} else if (Array.isArray(d.registros)) {",
              "    historial = d.registros;",
              "} else if (Array.isArray(d.data)) {",
              "    historial = d.data;",
              "} else if (Array.isArray(d.items)) {",
              "    historial = d.items;",
              "} else if (d.data && Array.isArray(d.data.registros)) {",
              "    historial = d.data.registros;",
              "} else if (d.data && Array.isArray(d.data.items)) {",
              "    historial = d.data.items;",
              "}",
              "",
              "pm.test('TC-M02-023 - Existe estructura de historial', function () {",
              "    pm.expect(historial).to.be.an('array');",
              "});",
              "",
              "console.log('Cantidad de registros historicos:', historial.length);",
              "",
              "var ordenado = true;",
              "",
              "for (var i = 1; i < historial.length; i++) {",
              "    var anteriorRaw = historial[i - 1].fecha_inicio || historial[i - 1].fechaInicio;",
              "    var actualRaw = historial[i].fecha_inicio || historial[i].fechaInicio;",
              "",
              "    if (!anteriorRaw || !actualRaw) {",
              "        continue;",
              "    }",
              "",
              "    var anterior = new Date(anteriorRaw).getTime();",
              "    var actual = new Date(actualRaw).getTime();",
              "",
              "    if (!Number.isNaN(anterior) && !Number.isNaN(actual) && actual < anterior) {",
              "        ordenado = false;",
              "        break;",
              "    }",
              "}",
              "",
              "pm.test('TC-M02-023 - Historial ordenado por fecha_inicio ASC', function () {",
              "    pm.expect(ordenado).to.eql(true);",
              "});",
              "",
              "if (d.total_registros !== undefined) {",
              "    pm.test('TC-M02-023 - total_registros coincide', function () {",
              "        pm.expect(Number(d.total_registros)).to.eql(historial.length);",
              "    });",
              "}"
            ]
          }
        }
      ]
    },
