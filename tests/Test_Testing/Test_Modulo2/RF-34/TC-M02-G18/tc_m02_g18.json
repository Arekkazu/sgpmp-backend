        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var id = pm.variables.get('activo_sin_asociacion_id');",
              "",
              "if (!id) {",
              "    console.warn('TC-M02-025 NO EJECUTABLE: no se encontro un activo existente sin asociacion activa en TEST.');",
              "",
              "    pm.test('TC-M02-025 - NO EJECUTABLE por falta de precondicion', function () {",
              "        pm.expect(true).to.eql(true);",
              "    });",
              "} else {",
              "    pm.test('TC-M02-025 - HTTP 404', function () {",
              "        pm.expect(pm.response.code).to.eql(404);",
              "    });",
              "",
              "    var d = {};",
              "    try {",
              "        d = pm.response.json();",
              "    } catch (e) {}",
              "",
              "    console.log('TC-M02-025 RESPUESTA:', d);",
              "",
              "    var raw = JSON.stringify(d).toLowerCase();",
              "",
              "    pm.test('TC-M02-025 - Mensaje indica inconsistencia de infraestructura activa', function () {",
              "        pm.expect(raw).to.satisfy(function (x) {",
              "            return x.indexOf('infraestructura activa') !== -1 ||",
              "                   x.indexOf('inconsistencia') !== -1 ||",
              "                   x.indexOf('sin asociacion') !== -1;",
              "        });",
              "    });",
              "}"
            ]
          }
        }
      ]
