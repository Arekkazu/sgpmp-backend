      "name": "02-TC-M02-165",
      "item": [
        {
          "name": "TC-M02-165-A - GET sin credencial",
          "request": {
            "method": "GET",
            "header": [],
            "url": "https://sigab-backendtest-389pcb-a48238-158-69-200-27.sslip.io/api-sgpmp-test/activos-biologicos/279/datos-consolidados?tipo_dato=metricas"
