              "    var lista = Array.isArray(body) ? body : (body.items || []);",
              "    var activa = lista.find(function (e) { return e.es_activo !== false; }) || lista[0];",
              "    pm.expect(activa, 'debe existir al menos una especie en el catalogo').to.not.be.undefined;",
