    {
      "name": "TC-097 - La cuenta sin autorizacion clinica consulta el historial de eventos",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_prueba}}"
          }
        ],
        "url": "{{base_url}}/activos-biologicos/{{id_activo}}/eventos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code !== 200) {",
              "    console.log('TC-097 - La cuenta sin autorizacion clinica consulta el historial de eventos - RESPUESTA: ' + pm.response.text());",
              "}",
              "pm.test('TC-097 - RF-46: el historial responde 200 sobre un activo POBLACIONAL', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('TC-097 - RF-46: un rol sin autorizacion clinica (Ingeniero de Campo) NO debe ver diagnostico/medicamento/dosis sin restriccion', function () {",
              "    var body = pm.response.json();",
              "    var eventos = body.eventos || body.items || [];",
              "    var conSanitario = eventos.filter(function (e) { return e.sanitario; });",
              "    pm.expect(conSanitario.length, 'debe existir al menos un evento sanitario en el historial para poder evaluar la restriccion').to.be.greaterThan(0);",
              "",
              "    var expuestos = conSanitario.filter(function (e) {",
              "        var s = e.sanitario;",
              "        return (s.diagnostico && s.diagnostico.length > 0) ||",
              "               (s.medicamento && s.medicamento.length > 0) ||",
              "               (s.dosis !== null && s.dosis !== undefined);",
              "    });",
              "",
              "    pm.expect(",
              "        expuestos.length,",
              "        'RF-46 exige que el sistema no exponga registros de categorias no autorizadas para el rol del usuario: ' +",
              "        'se encontraron ' + expuestos.length + ' evento(s) sanitario(s) con diagnostico/medicamento/dosis visibles ' +",
              "        'para un rol (Ingeniero de Campo) sin autorizacion clinica declarada.'",
              "    ).to.eql(0);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
