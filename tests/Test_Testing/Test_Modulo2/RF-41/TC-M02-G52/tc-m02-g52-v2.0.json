    {
      "name": "SETUP-6 - Registrar activo POBLACIONAL de prueba",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_admin}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/activos-biologicos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tipo_activo\": \"POBLACIONAL\",\n  \"id_especie\": {{id_especie}},\n  \"fecha_inicio_ciclo\": \"{{fecha_hoy}}\",\n  \"origen_financiero\": \"compra\",\n  \"costo_adquisicion\": 500000,\n  \"soporte_documental\": \"Factura de compra No. TC-M02-G52-V2\",\n  \"id_infraestructura\": {{id_infraestructura}},\n  \"cantidad_inicial\": 50,\n  \"peso_promedio_inicial\": 1.2\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.collectionVariables.set('fecha_hoy', new Date().toISOString().slice(0,10));"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code !== 201) {",
              "    console.log('SETUP-6 - Registrar activo POBLACIONAL de prueba - RESPUESTA: ' + pm.response.text());",
              "}",
              "pm.test('SETUP-6 - Activo POBLACIONAL de prueba creado', function () {",
              "    pm.response.to.have.status(201);",
              "    var body = pm.response.json();",
              "    pm.expect(body.id_activo_biologico, 'debe devolver id_activo_biologico').to.not.be.undefined;",
              "    pm.collectionVariables.set('id_activo', String(body.id_activo_biologico));",
              "    pm.collectionVariables.set('activo_via_workaround', 'false');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "SETUP-6B - Workaround: buscar activo POBLACIONAL existente con datos clinicos (defecto 500 en creacion, ver TC-M02-G49)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_admin}}"
          }
        ],
        "url": "{{base_url}}/activos-biologicos?tipo=POBLACIONAL&page_size=100&pagina=1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code !== 200) {",
              "    console.log('SETUP-6B - Buscar activo POBLACIONAL existente (catalogo) - RESPUESTA: ' + pm.response.text());",
              "}",
              "",
              "var idActivoActual = pm.collectionVariables.get('id_activo');",
              "",
              "if (idActivoActual) {",
              "    console.log('SETUP-6B - OMITIDO: SETUP-6 ya registro un activo nuevo (id_activo=' + idActivoActual + '); no se necesita el workaround.');",
              "    pm.collectionVariables.set('activo_via_workaround', 'false');",
              "    pm.test('SETUP-6B - Paso informativo (omitido, SETUP-6 ya proveyo un activo nuevo)', function () {",
              "        pm.expect(true).to.be.true;",
              "    });",
              "} else if (pm.response.code !== 200) {",
              "    pm.collectionVariables.set('activo_via_workaround', 'false');",
              "    pm.test('SETUP-6B - El catalogo de activos biologicos POBLACIONAL es consultable (workaround)', function () {",
              "        pm.response.to.have.status(200);",
              "    });",
              "    postman.setNextRequest('CLEANUP-1 - Revocar el acceso a la finca de prueba');",
              "} else {",
              "    var body = pm.response.json();",
              "    var candidatos = (body.registros || []).filter(function (a) { return a.tipo === 'POBLACIONAL'; });",
              "    console.log('SETUP-6B - candidatos POBLACIONAL en TEST: ' + JSON.stringify(candidatos.map(function (a) { return a.id_activo_biologico; })));",
              "",
              "    var baseUrl = pm.collectionVariables.get('base_url');",
              "    var tokenAdmin = pm.collectionVariables.get('token_admin');",
              "    var idUsuarioPrueba = Number(pm.collectionVariables.get('id_usuario_prueba'));",
              "    var idFincaOriginal = pm.collectionVariables.get('id_finca');",
              "",
              "    function candidatoTieneDatosClinicos(idActivoBiologico, callback) {",
              "        pm.sendRequest({",
              "            url: baseUrl + '/activos-biologicos/' + idActivoBiologico + '/eventos',",
              "            method: 'GET',",
              "            header: { Authorization: 'Bearer ' + tokenAdmin }",
              "        }, function (err, res) {",
              "            if (err) {",
              "                console.log('SETUP-6B - error de red consultando eventos del activo ' + idActivoBiologico + ': ' + err.message);",
              "                callback(false);",
              "                return;",
              "            }",
              "            if (res.code !== 200) {",
              "                console.log('SETUP-6B - activo ' + idActivoBiologico + ' - GET eventos respondio ' + res.code + ': ' + res.text());",
              "                callback(false);",
              "                return;",
              "            }",
              "            var eBody = res.json();",
              "            var eventos = eBody.eventos || eBody.items || [];",
              "            var conDatos = eventos.filter(function (e) {",
              "                var s = e.sanitario;",
              "                return s && ((s.diagnostico && s.diagnostico.length > 0) ||",
              "                             (s.medicamento && s.medicamento.length > 0) ||",
              "                             (s.dosis !== null && s.dosis !== undefined));",
              "            });",
              "            callback(conDatos.length > 0);",
              "        });",
              "    }",
              "",
              "    function resolverFincaDeCandidato(candidato, callback) {",
              "        pm.sendRequest({",
              "            url: baseUrl + '/configuracion/infraestructuras/' + candidato.id_infraestructura,",
              "            method: 'GET',",
              "            header: { Authorization: 'Bearer ' + tokenAdmin }",
              "        }, function (err, resInfra) {",
              "            if (err || resInfra.code !== 200) {",
              "                console.log('SETUP-6B - no se pudo resolver la infraestructura ' + candidato.id_infraestructura + ' del activo ' + candidato.id_activo_biologico + (err ? (': ' + err.message) : (' - respuesta ' + resInfra.code)));",
              "                callback(null);",
              "                return;",
              "            }",
              "            callback(resInfra.json().id_finca);",
              "        });",
              "    }",
              "",
              "    function fincaEsOtorgable(idFinca, callback) {",
              "        pm.sendRequest({",
              "            url: baseUrl + '/configuracion/fincas/' + idFinca,",
              "            method: 'GET',",
              "            header: { Authorization: 'Bearer ' + tokenAdmin }",
              "        }, function (err, resFinca) {",
              "            if (err || resFinca.code !== 200) {",
              "                console.log('SETUP-6B - no se pudo consultar el propietario de la finca ' + idFinca + (err ? (': ' + err.message) : (' - respuesta ' + resFinca.code)));",
              "                callback(false);",
              "                return;",
              "            }",
              "            var propietario = resFinca.json().id_usuario;",
              "            var otorgable = (propietario === null || propietario === undefined || Number(propietario) === idUsuarioPrueba);",
              "            if (!otorgable) {",
              "                console.log('SETUP-6B - la finca ' + idFinca + ' ya pertenece a otro usuario (id_usuario=' + propietario + '); se descarta este candidato para no reasignarla.');",
              "            }",
              "            callback(otorgable);",
              "        });",
              "    }",
              "",
              "    function otorgarFinca(idFinca, callback) {",
              "        var fincasAOtorgar = [Number(idFincaOriginal), Number(idFinca)].filter(function (n) { return !isNaN(n); });",
              "        pm.sendRequest({",
              "            url: baseUrl + '/usuarios/' + idUsuarioPrueba + '/fincas',",
              "            method: 'PUT',",
              "            header: { Authorization: 'Bearer ' + tokenAdmin, 'Content-Type': 'application/json' },",
              "            body: { mode: 'raw', raw: JSON.stringify({ ids_fincas: fincasAOtorgar }) }",
              "        }, function (err, resFincas) {",
              "            if (err || resFincas.code !== 200) {",
              "                console.log('SETUP-6B - no se pudo otorgar acceso a la finca ' + idFinca + (err ? (': ' + err.message) : (' - respuesta ' + resFincas.code + ': ' + resFincas.text())));",
              "                callback(false);",
              "                return;",
              "            }",
              "            callback(true);",
              "        });",
              "    }",
              "",
              "    function evaluarCandidato(indice, callback) {",
              "        if (indice >= candidatos.length) {",
              "            callback(null);",
              "            return;",
              "        }",
              "        var candidato = candidatos[indice];",
              "        candidatoTieneDatosClinicos(candidato.id_activo_biologico, function (calificaClinicamente) {",
              "            if (!calificaClinicamente) {",
              "                evaluarCandidato(indice + 1, callback);",
              "                return;",
              "            }",
              "            console.log('SETUP-6B - activo ' + candidato.id_activo_biologico + ' tiene eventos sanitarios con datos clinicos; verificando si su finca es otorgable...');",
              "            resolverFincaDeCandidato(candidato, function (idFinca) {",
              "                if (!idFinca) {",
              "                    evaluarCandidato(indice + 1, callback);",
              "                    return;",
              "                }",
              "                fincaEsOtorgable(idFinca, function (otorgable) {",
              "                    if (!otorgable) {",
              "                        evaluarCandidato(indice + 1, callback);",
              "                        return;",
              "                    }",
              "                    otorgarFinca(idFinca, function (otorgado) {",
              "                        if (!otorgado) {",
              "                            evaluarCandidato(indice + 1, callback);",
              "                            return;",
              "                        }",
              "                        callback({ candidato: candidato, idFinca: idFinca });",
              "                    });",
              "                });",
              "            });",
              "        });",
              "    }",
              "",
              "    evaluarCandidato(0, function (resultado) {",
              "        if (!resultado) {",
              "            pm.collectionVariables.set('activo_via_workaround', 'false');",
              "            pm.test('SETUP-6B - Se encuentra un activo POBLACIONAL existente, con datos clinicos y con finca otorgable, para evaluar RF-46 (workaround por el defecto 500 en creacion, ver TC-M02-G49)', function () {",
              "                pm.expect.fail('No se encontro en TEST ningun activo POBLACIONAL con eventos sanitarios (diagnostico/medicamento/dosis) cuya finca se pudiera otorgar a la cuenta de prueba (las fincas candidatas ya pertenecen a otros usuarios). TC-M02-G52 v2.0 queda bloqueado por el defecto ERROR_INTERNO en POST /activos-biologicos (ver TC-M02-G49) combinado con la falta de datos de prueba propios.');",
              "            });",
              "            postman.setNextRequest('CLEANUP-1 - Revocar el acceso a la finca de prueba');",
              "            return;",
              "        }",
              "",
              "        console.log('SETUP-6B - activo ' + resultado.candidato.id_activo_biologico + ' pertenece a la finca ' + resultado.idFinca + ', otorgada a la cuenta de prueba.');",
              "",
              "        pm.collectionVariables.set('id_activo', String(resultado.candidato.id_activo_biologico));",
              "        pm.collectionVariables.set('id_finca_workaround', String(resultado.idFinca));",
              "        pm.collectionVariables.set('activo_via_workaround', 'true');",
              "",
              "        pm.test('SETUP-6B - Se encuentra un activo POBLACIONAL existente con datos clinicos y se habilita el acceso de la cuenta de prueba (workaround por el defecto 500 en creacion, ver TC-M02-G49)', function () {",
              "            pm.expect(resultado.candidato.id_activo_biologico).to.be.a('number');",
              "        });",
              "",
              "        postman.setNextRequest('DIAG-1 - Login con la cuenta de prueba (ya en rol Ingeniero de Campo)');",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
