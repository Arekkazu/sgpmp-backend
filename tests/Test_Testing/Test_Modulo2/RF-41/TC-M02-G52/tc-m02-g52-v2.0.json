    {
      "name": "0A - Login Admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/sesiones/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"{{admin_email}}\",\n  \"contrasena\": \"{{admin_password}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code !== 200) {",
              "    console.log('0A - RESPUESTA DEL LOGIN ADMIN (no fue 200): ' + pm.response.text());",
              "}",
              "pm.test('0A - Login admin devuelve 200 y token', function () {",
              "    pm.response.to.have.status(200);",
              "    var body = pm.response.json();",
              "    var token = body.token || body.access_token || (body.data && body.data.token);",
              "    pm.expect(token, 'debe existir un token de acceso').to.be.a('string').and.not.empty;",
              "    pm.collectionVariables.set('token_admin', token);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "0B - Consultar catalogo de roles y ubicar Ingeniero de Campo",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_admin}}"
          }
        ],
        "url": "{{base_url}}/roles/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('0B - Se puede leer el catalogo de roles', function () {",
              "    pm.response.to.have.status(200);",
              "    var roles = pm.response.json();",
              "    var lista = Array.isArray(roles) ? roles : (roles.items || []);",
              "    pm.collectionVariables.set('roles_catalogo_json', JSON.stringify(lista));",
              "    var ingeniero = lista.find(function (r) {",
              "        return (r.nombre_rol || '').toLowerCase().indexOf('ingeniero de campo') !== -1;",
              "    });",
              "    pm.expect(ingeniero, 'debe existir el rol Ingeniero de Campo en el catalogo').to.not.be.undefined;",
              "    pm.collectionVariables.set('id_rol_ingeniero_campo', String(ingeniero.id_rol));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "0C - Consultar detalle de la cuenta de prueba (rol original)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_admin}}"
          }
        ],
        "url": "{{base_url}}/usuarios/{{id_usuario_prueba}}/detalle"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code !== 200) {",
              "    console.log('0C - RESPUESTA (no fue 200): ' + pm.response.text());",
              "}",
              "pm.test('0C - Se obtiene el detalle de la cuenta de prueba', function () {",
              "    pm.response.to.have.status(200);",
              "    var body = pm.response.json();",
              "    pm.expect(body.nombre_rol, 'debe traer nombre_rol').to.not.be.undefined;",
              "    var catalogo = JSON.parse(pm.collectionVariables.get('roles_catalogo_json') || '[]');",
              "    var rolActual = catalogo.find(function (r) { return r.nombre_rol === body.nombre_rol; });",
              "    pm.expect(rolActual, 'debe encontrarse el id_rol correspondiente a ' + body.nombre_rol + ' en el catalogo').to.not.be.undefined;",
              "    pm.collectionVariables.set('id_rol_original', String(rolActual.id_rol));",
              "    pm.collectionVariables.set('nombre_prueba', body.nombre);",
              "    pm.collectionVariables.set('apellidos_prueba', body.apellidos);",
              "    pm.collectionVariables.set('version_prueba', String(body.version));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
