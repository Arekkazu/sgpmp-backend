            "key": "Authorization",
            "value": "Bearer {{token_admin}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/configuracion/fincas",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Finca Prueba Control Clinico Sensible {{sufijo_random_letras}}\",\n  \"ubicacion\": {\n    \"departamento\": \"Huila\",\n    \"municipio\": \"Neiva\",\n    \"vereda\": \"La Ficha\",\n    \"latitud\": 2.9273,\n    \"longitud\": -75.2819\n  },\n  \"tamano_h\": 12.5\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "var letras = 'abcdefghijklmnopqrstuvwxyz';",
              "var sufijo = '';",
              "for (var i = 0; i < 8; i++) { sufijo += letras.charAt(Math.floor(Math.random() * letras.length)); }",
              "pm.collectionVariables.set('sufijo_random_letras', sufijo);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code !== 201) {",
              "    console.log('SETUP-2 - Crear finca de prueba - RESPUESTA: ' + pm.response.text());",
              "}",
              "pm.test('SETUP-2 - Finca de prueba creada', function () {",
              "    pm.response.to.have.status(201);",
              "    var body = pm.response.json();",
              "    pm.expect(body.id_finca, 'debe devolver id_finca').to.not.be.undefined;",
              "    pm.collectionVariables.set('id_finca', String(body.id_finca));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
