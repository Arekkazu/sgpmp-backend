        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre_infraestructura\": \"QA-G50-Infra-{{$timestamp}}\",\n  \"tipo_area\": \"Estanque\",\n  \"superficie\": 500.0,\n  \"finca_id\": \"{{id_finca_creada_g50}}\",\n  \"descripcion_infraestructura\": \"Infraestructura de prueba QA TC-M02-G50\"\n}"
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "console.log('SETUP-2 infra: ' + pm.response.code + ' body=' + pm.response.text());",
              "pm.test('SETUP-2 - infraestructura creada (201)', function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) { pm.collectionVariables.set('id_infraestructura_creada_g50', pm.response.json().id_infraestructura); }",
              ""
            ]
          }
        }
      ]
