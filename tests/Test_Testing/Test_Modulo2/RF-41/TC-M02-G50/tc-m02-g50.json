    {
      "name": "SETUP-3. Admin registra el activo de prueba (INDIVIDUAL, especie Cachama Blanca, sin eventos previos)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token_admin}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/activos-biologicos",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "activos-biologicos"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tipo_activo\": \"INDIVIDUAL\",\n  \"id_especie\": 4,\n  \"fecha_inicio_ciclo\": \"2026-01-01\",\n  \"origen_financiero\": \"nacimiento\",\n  \"id_infraestructura\": \"{{id_infraestructura_creada_g50}}\",\n  \"identificador\": \"QA-G50-Activo-{{$timestamp}}\",\n  \"raza\": \"QA\",\n  \"sexo\": \"Macho\",\n  \"fecha_nacimiento\": \"2024-01-01T00:00:00Z\"\n}"
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "console.log('SETUP-3 activo: ' + pm.response.code + ' body=' + pm.response.text());",
              "pm.test('SETUP-3 - activo creado en estado ACTIVO (201)', function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) { pm.collectionVariables.set('id_activo_g50', pm.response.json().id_activo_biologico); }",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "TC-092. Intentar registrar TRATAMIENTO directamente, sin ningun DIAGNOSTICO previo",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token_admin}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/activos-biologicos/{{id_activo_g50}}/eventos/sanitario",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "activos-biologicos",
            "{{id_activo_g50}}",
            "eventos",
            "sanitario"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tipo\": \"TRATAMIENTO\",\n  \"medicamento\": \"Antibiotico QA-G50\",\n  \"dosis\": 10,\n  \"unidad_dosis\": \"mg/kg\",\n  \"frecuencia\": 2,\n  \"duracion\": 5,\n  \"observaciones\": \"Intento directo sin diagnostico previo - QA G50\"\n}"
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "console.log('TC-092 tratamiento sin diagnostico previo: ' + pm.response.code + ' body=' + pm.response.text());",
              "pm.test('TC-092 - se rechaza con 422 (violacion de secuencia logica)', function () { pm.response.to.have.status(422); });",
              "if (pm.response.code === 422) {",
              "    var b = pm.response.json();",
              "    pm.test('TC-092 - el codigo de error es DIAGNOSTICO_PREVIO_REQUERIDO', function () {",
              "        pm.expect(b.error_code).to.eql('DIAGNOSTICO_PREVIO_REQUERIDO');",
              "    });",
              "}",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "TC-093. Intentar registrar DIAGNOSTICO sin el campo obligatorio 'diagnostico'",
