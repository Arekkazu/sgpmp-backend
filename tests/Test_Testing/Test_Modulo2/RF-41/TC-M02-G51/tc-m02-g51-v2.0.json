        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "pm.test('TC-096d - el inventario OpenAPI responde 200', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "    var spec = pm.response.json();",
              "    var rutasEventos = Object.keys(spec.paths || {}).filter(function (p) { return p.indexOf('/eventos') !== -1 && p.indexOf('/activos-biologicos') !== -1; });",
              "    console.log('TC-096d - rutas de eventos encontradas: ' + JSON.stringify(rutasEventos));",
              "    var metodosPeligrosos = [];",
              "    rutasEventos.forEach(function (p) {",
              "        var metodos = Object.keys(spec.paths[p]);",
              "        ['delete', 'put', 'patch'].forEach(function (m) {",
              "            if (metodos.indexOf(m) !== -1) { metodosPeligrosos.push(m.toUpperCase() + ' ' + p); }",
              "        });",
              "    });",
              "    console.log('TC-096d - metodos de modificacion/eliminacion encontrados: ' + JSON.stringify(metodosPeligrosos));",
              "    pm.test('TC-096d - ninguna ruta de eventos de activos biologicos declara DELETE, PUT ni PATCH', function () {",
              "        pm.expect(metodosPeligrosos).to.eql([]);",
              "    });",
              "}",
              ""
            ]
          }
