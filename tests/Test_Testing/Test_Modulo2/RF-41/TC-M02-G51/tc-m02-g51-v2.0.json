    {
      "name": "TC-096d. Confirmar por OpenAPI que ninguna ruta de eventos declara metodos DELETE/PUT/PATCH",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/openapi.json",
          "host": [ "{{base_url}}" ],
          "path": [ "openapi.json" ]
