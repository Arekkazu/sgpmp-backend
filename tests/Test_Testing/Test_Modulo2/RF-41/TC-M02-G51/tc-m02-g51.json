        ],
        "url": {
          "raw": "{{base_url}}/activos-biologicos",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "activos-biologicos"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tipo_activo\": \"INDIVIDUAL\",\n  \"id_especie\": 4,\n  \"fecha_inicio_ciclo\": \"2026-01-01\",\n  \"origen_financiero\": \"nacimiento\",\n  \"id_infraestructura\": \"{{id_infraestructura_creada_g51}}\",\n  \"identificador\": \"QA-G51-Activo-{{$timestamp}}\",\n  \"raza\": \"QA\",\n  \"sexo\": \"Macho\",\n  \"fecha_nacimiento\": \"2024-01-01T00:00:00Z\"\n}"
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "console.log('SETUP-3 activo: ' + pm.response.code + ' body=' + pm.response.text());",
              "pm.test('SETUP-3 - activo creado en estado ACTIVO (201)', function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) { pm.collectionVariables.set('id_activo_g51', pm.response.json().id_activo_biologico); }",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "TC-094. Precondicion: intentar poner el activo en BAJA via RF-45 (bloqueado por defecto de TC-M02-G36)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token_admin}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/activos-biologicos/{{id_activo_g51}}/eventos/baja",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "activos-biologicos",
            "{{id_activo_g51}}",
            "eventos",
            "baja"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tipo_baja\": \"muerte\",\n  \"fecha_baja\": \"{{fecha_hoy_g51}}\",\n  \"motivo_baja\": \"Baja de prueba QA G51 - precondicion para TC-094\"\n}"
        }
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "var hoy = new Date().toISOString().slice(0,10);",
              "pm.collectionVariables.set('fecha_hoy_g51', hoy);",
              ""
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "console.log('TC-094 precondicion (poner activo en BAJA): ' + pm.response.code + ' body=' + pm.response.text());",
              "pm.test('TC-094 - NO EJECUTABLE: la precondicion (activo en BAJA) sigue bloqueada por el defecto de TC-M02-G36 (500)', function () {",
              "    pm.expect(pm.response.code).to.eql(500);",
              "});",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "TC-094b. Control: confirmar que el activo sigue ACTIVO (el intento de baja no tuvo efecto)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token_admin}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/activos-biologicos/{{id_activo_g51}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "activos-biologicos",
            "{{id_activo_g51}}"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "console.log('TC-094b estado del activo: ' + pm.response.code + ' body=' + pm.response.text());",
              "pm.test('TC-094b - se puede consultar el activo (200)', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "    pm.test('TC-094b - el activo sigue en ACTIVO, el intento fallido no dejo el activo en un estado intermedio', function () {",
              "        pm.expect(pm.response.json().nombre_estado).to.eql('ACTIVO');",
              "    });",
              "}",
              ""
            ]
          }
        }
      ]
    },
