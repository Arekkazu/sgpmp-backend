  "item": [
    {
      "name": "0A. Login Admin - admin.test (autorizado explicitamente por Daniela)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/sesiones/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "sesiones",
            ""
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"{{correo_admin_test}}\",\n  \"contrasena\": \"{{contrasena_admin_test}}\"\n}"
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "console.log('0A admin.test login: ' + pm.response.code + ' body=' + pm.response.text());",
              "pm.test('0A - login admin.test responde 200', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) { pm.collectionVariables.set('token_admin', pm.response.json().token); }",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "SETUP-1. Admin crea una finca de prueba",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token_admin}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/configuracion/fincas",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "configuracion",
            "fincas"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Finca Prueba QA {{sufijo_finca_g51}}\",\n  \"ubicacion\": {\n    \"departamento\": \"Huila\",\n    \"municipio\": \"Neiva\",\n    \"vereda\": \"La Ceiba\",\n    \"latitud\": 2.9273,\n    \"longitud\": -75.2819\n  },\n  \"tamano_h\": 10.5\n}"
        }
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "var letras = 'abcdefghijklmnopqrstuvwxyz';",
              "var suf = '';",
              "for (var i = 0; i < 8; i++) { suf += letras.charAt(Math.floor(Math.random() * letras.length)); }",
              "pm.collectionVariables.set('sufijo_finca_g51', suf);",
              ""
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "console.log('SETUP-1 finca: ' + pm.response.code + ' body=' + pm.response.text());",
              "pm.test('SETUP-1 - finca creada (201)', function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) { pm.collectionVariables.set('id_finca_creada_g51', pm.response.json().id_finca); }",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "SETUP-2. Admin crea una infraestructura dentro de esa finca",
