              "pm.test('SETUP-2 - infraestructura creada (201)', function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) { pm.collectionVariables.set('id_infraestructura_creada_g51', pm.response.json().id_infraestructura); }",
              ""
