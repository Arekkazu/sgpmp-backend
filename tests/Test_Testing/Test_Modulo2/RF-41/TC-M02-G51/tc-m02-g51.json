        "url": {
          "raw": "{{base_url}}/configuracion/infraestructuras",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "configuracion",
            "infraestructuras"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre_infraestructura\": \"QA-G51-Infra-{{$timestamp}}\",\n  \"tipo_area\": \"Estanque\",\n  \"superficie\": 500.0,\n  \"finca_id\": \"{{id_finca_creada_g51}}\",\n  \"descripcion_infraestructura\": \"Infraestructura de prueba QA TC-M02-G51\"\n}"
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
