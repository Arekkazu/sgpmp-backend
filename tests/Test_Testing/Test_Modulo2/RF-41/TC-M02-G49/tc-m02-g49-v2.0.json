              "}"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "var yaEstabaActivo = pm.response.code === 409 && pm.response.json().error_code === 'ESTADO_REDUNDANTE';",
              "if (pm.response.code !== 200 && !yaEstabaActivo) {",
              "    console.log('CLEANUP-1 - Restaurar el estado original del activo - RESPUESTA: ' + pm.response.text());",
              "}",
              "pm.test('CLEANUP-1 - El activo de prueba queda (o ya estaba) en ACTIVO', function () {",
              "    if (!yaEstabaActivo) {",
              "        pm.response.to.have.status(200);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
