    {
      "name": "SETUP-4B - Workaround: buscar activo INDIVIDUAL existente en estado ACTIVO (por si SETUP-4 sigue bloqueado)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_admin}}"
          }
        ],
        "url": "{{base_url}}/activos-biologicos?tipo=INDIVIDUAL&page_size=100&pagina=1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code !== 200) {",
              "    console.log('SETUP-4B - Buscar activo INDIVIDUAL existente (catalogo) - RESPUESTA: ' + pm.response.text());",
              "}",
              "",
              "var idActivoActual = pm.collectionVariables.get('id_activo');",
              "",
              "if (idActivoActual) {",
              "    console.log('SETUP-4B - OMITIDO: SETUP-4 ya registro un activo nuevo (id_activo=' + idActivoActual + '); no se necesita el workaround.');",
              "    pm.test('SETUP-4B - Paso informativo (omitido, SETUP-4 ya proveyo un activo nuevo)', function () {",
              "        pm.expect(true).to.be.true;",
              "    });",
              "} else if (pm.response.code !== 200) {",
              "    pm.collectionVariables.set('activo_via_workaround', 'false');",
              "    pm.test('SETUP-4B - El catalogo de activos biologicos INDIVIDUAL es consultable (workaround)', function () {",
              "        pm.response.to.have.status(200);",
              "    });",
              "    postman.setNextRequest('CLEANUP-2 - Verificacion de salud del servicio');",
              "} else {",
              "    var body = pm.response.json();",
              "    var candidatos = (body.registros || []).filter(function (a) {",
              "        return a.tipo === 'INDIVIDUAL' && a.nombre_estado === 'ACTIVO';",
              "    });",
              "    console.log('SETUP-4B - candidatos INDIVIDUAL en estado ACTIVO: ' + JSON.stringify(candidatos.map(function (a) { return a.id_activo_biologico; })));",
              "",
              "    if (candidatos.length === 0) {",
              "        pm.collectionVariables.set('activo_via_workaround', 'false');",
              "        pm.test('SETUP-4B - Se encuentra un activo INDIVIDUAL existente en estado ACTIVO para probar RF-41/RF-44 (workaround por el defecto 500 en creacion)', function () {",
              "            pm.expect.fail('No se encontro en TEST ningun activo INDIVIDUAL en estado ACTIVO para usar como workaround del defecto ERROR_INTERNO en POST /activos-biologicos. TC-M02-G49 v2.0 queda bloqueado por este defecto.');",
              "        });",
              "        postman.setNextRequest('CLEANUP-2 - Verificacion de salud del servicio');",
              "    } else {",
              "        var elegido = candidatos[0];",
              "        pm.collectionVariables.set('id_activo', String(elegido.id_activo_biologico));",
              "        pm.collectionVariables.set('activo_via_workaround', 'true');",
              "        console.log('SETUP-4B - se usara el activo existente ' + elegido.id_activo_biologico + ' (estado ACTIVO) como workaround.');",
              "        pm.test('SETUP-4B - Se encuentra un activo INDIVIDUAL existente en estado ACTIVO para probar RF-41/RF-44 (workaround por el defecto 500 en creacion)', function () {",
              "            pm.expect(elegido.id_activo_biologico).to.be.a('number');",
              "        });",
              "    }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
