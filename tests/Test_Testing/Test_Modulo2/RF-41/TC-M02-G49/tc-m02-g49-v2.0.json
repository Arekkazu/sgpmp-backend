              "    var exitosos = registros.filter(function (r) { return r.resultado === 'EXITOSO'; });",
              "    pm.expect(exitosos.length, 'debe haber al menos un registro EXITOSO de rf_origen RF41 para este activo').to.be.greaterThan(0);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
