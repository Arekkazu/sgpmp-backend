    {
      "name": "TC-095b2 - Restaurar el activo a ACTIVO (RF-41 vigente: un evento sanitario solo se registra con el activo ACTIVO)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_admin}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/activos-biologicos/{{id_activo}}/estado",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"estado_nuevo\": \"ACTIVO\",\n  \"fecha_cambio_estado\": \"{{fecha_hoy}}\",\n  \"motivo_cambio\": \"TC-M02-G49 v3.0: volver a ACTIVO antes de probar el aislamiento\"\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('fecha_hoy')) { pm.collectionVariables.set('fecha_hoy', new Date().toISOString().slice(0,10)); }"
            ]
          }
        },
        {
