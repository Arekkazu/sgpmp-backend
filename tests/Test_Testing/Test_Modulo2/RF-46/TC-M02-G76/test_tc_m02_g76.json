    {
      "name": "TC-M02-210",
      "description": "Subcaso TC-M02-210: Consultar historial con filtro sin resultados (E-04)",
      "item": [
        {
          "name": "00 - Autenticación Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo_electronico\": \"admin@pecuaria.co\",\n  \"contrasena\": \"Test1234!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sesiones/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sesiones",
                ""
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[TC-M02-210] Autenticación exitosa (200 OK)', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var data = pm.response.json();",
                  "    pm.expect(data).to.have.property('token');",
                  "    pm.collectionVariables.set('jwt_token', data.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "TC-M02-210 - Consultar historial con filtro sin resultados (E-04)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/activos-biologicos/{{id_activo}}/historial?categoria_evento=BAJA",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "activos-biologicos",
                "{{id_activo}}",
                "historial"
              ],
              "query": [
                {
                  "key": "categoria_evento",
                  "value": "BAJA"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[TC-M02-210] Estado HTTP 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('[TC-M02-210] total_registros es 0', function () {",
                  "    pm.expect(pm.response.json().total_registros).to.eql(0);",
                  "});",
                  "",
                  "pm.test('[TC-M02-210] registros es array vacío', function () {",
                  "    pm.expect(pm.response.json().registros).to.be.an('array').that.is.empty;",
                  "});",
                  "",
                  "pm.test('[TC-M02-210] Mensaje informativo presente', function () {",
                  "    const json = pm.response.json();",
                  "    const mensaje = json.mensaje || json.message || json.detail || '';",
                  "    pm.expect(mensaje.toLowerCase()).to.include('no se encontraron eventos');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
