            ],
            "url": {
              "raw": "{{baseUrl}}/activos-biologicos/{{id_activo}}/historial",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "activos-biologicos",
                "{{id_activo}}",
                "historial"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// NOTA DE CONCURRENCIA: Este test requiere ejecución aislada sin escrituras concurrentes sobre el activo de prueba.",
                  "pm.test('[TC-M02-212.4] Estado HTTP 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('[TC-M02-212.4] Historial inalterado tras intentos de escritura', function () {",
                  "    var totalActual = pm.response.json().total_registros;",
                  "    var totalPrevio = parseInt(pm.collectionVariables.get('total_registros_pre_escritura'), 10);",
