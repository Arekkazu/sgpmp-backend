        },
        {
          "name": "TC-M02-212.1 - Rechazo de método de escritura POST",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"evento\": \"falso\",\n  \"categoria\": \"TEST\",\n  \"descripcion\": \"Intento de escritura no autorizada\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/activos-biologicos/{{id_activo}}/historial",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "activos-biologicos",
                "{{id_activo}}",
                "historial"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[TC-M02-212.1] Estado HTTP debe ser 405 Method Not Allowed', function () {",
                  "    pm.response.to.have.status(405);",
                  "});",
                  "",
                  "pm.test('[TC-M02-212.1] Encabezado Allow debe incluir GET', function () {",
                  "    var allowHeader = pm.response.headers.get('Allow');",
                  "    pm.expect(allowHeader).to.not.be.null;",
                  "    pm.expect(allowHeader).to.include('GET');",
                  "});",
                  "",
                  "pm.test('[TC-M02-212.1] Cuerpo indica Method Not Allowed', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.detail).to.eql('Method Not Allowed');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
