      "name": "SETUP-1. Admin crea una finca de prueba (sin asignar a Productor B)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token_admin}}"
          }
        ],
        "url": "{{base_url}}/configuracion/fincas",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Finca Prueba QA {{sufijo_finca}}\",\n  \"ubicacion\": {\n    \"departamento\": \"Huila\",\n    \"municipio\": \"Neiva\",\n    \"vereda\": \"La Ceiba\",\n    \"latitud\": 2.9273,\n    \"longitud\": -75.2819\n  },\n  \"tamano_h\": 10.5\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "var letras = 'abcdefghijklmnopqrstuvwxyz';",
              "var suf = '';",
              "for (var i=0;i<8;i++){ suf += letras.charAt(Math.floor(Math.random()*26)); }",
              "pm.collectionVariables.set('sufijo_finca', suf);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "console.log('[SETUP-1 finca] status=' + pm.response.code + ' body=' + pm.response.text());",
              "pm.test('SETUP: la finca de prueba se crea correctamente (201)', function(){ pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) {",
              "  var b = pm.response.json();",
              "  pm.collectionVariables.set('id_finca_creada', b.id_finca);",
              "  console.log('[SETUP-1 finca] id_finca_creada=' + b.id_finca + ' id_usuario=' + b.id_usuario);",
              "}"
            ]
          }
        }
      ]
    },
