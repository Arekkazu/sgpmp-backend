          "raw": "{\n  \"tipo_activo\": \"INDIVIDUAL\",\n  \"id_especie\": {{id_especie_valida}},\n  \"id_infraestructura\": {{id_infraestructura_valida}},\n  \"fecha_inicio_ciclo\": \"2026-01-01\",\n  \"origen_financiero\": \"compra\",\n  \"costo_adquisicion\": 5000.00,\n  \"soporte_documental\": \"Factura-QA-G05-BIG\",\n  \"identificador\": \"QA-G05-BIG-{{$timestamp}}\",\n  \"raza\": \"QA\",\n  \"sexo\": \"Macho\",\n  \"fecha_nacimiento\": \"2024-01-01T00:00:00Z\",\n  \"atributos_dinamicos\": {\"nota_extensa\": \"{{big_string}}\"}\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "var chunk = 'x'.repeat(1024*1024);",
              "var big = '';",
              "for (var i=0;i<3;i++){ big += chunk; }",
              "pm.collectionVariables.set('big_string', big);",
              "console.log('[183a] payload generado: ' + (big.length/1024/1024).toFixed(2) + ' MB, id_infraestructura usado=' + pm.collectionVariables.get('id_infraestructura_valida') + ', id_especie usado=' + pm.collectionVariables.get('id_especie_valida'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "console.log('[183a] status=' + pm.response.code + ' tiempo=' + pm.response.responseTime + 'ms');",
              "pm.test('Rechaza el payload sobredimensionado antes de procesarlo (400 o 413)', function () {",
              "  pm.expect([400,413]).to.include(pm.response.code);",
              "});",
              "pm.test('No degrada a un error no controlado (nunca 500)', function () {",
              "  pm.expect(pm.response.code).to.not.equal(500);",
              "});",
              "var raw = pm.response.text();",
              "var patrones = [/Traceback/i, /site-packages/i, /psycopg2/i, /sqlalchemy/i, /File \"\\/.*\\.py\"/i];",
              "patrones.forEach(function(p){",
              "  pm.test('No expone detalle interno en el cuerpo (' + p + ')', function(){ pm.expect(p.test(raw)).to.eql(false); });",
              "});"
            ]
          }
        }
      ]
    },
