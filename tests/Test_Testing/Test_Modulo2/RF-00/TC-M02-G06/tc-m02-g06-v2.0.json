    {
      "name": "0A - Login Admin",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/sesiones/",
        "body": { "mode": "raw", "raw": "{\n  \"correo_electronico\": \"{{admin_email}}\",\n  \"contrasena\": \"{{admin_password}}\"\n}" }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "var letras = 'abcdefghijklmnopqrstuvwxyz';",
              "var sufijo = '';",
              "for (var i = 0; i < 8; i++) { sufijo += letras.charAt(Math.floor(Math.random() * letras.length)); }",
              "pm.collectionVariables.set('sufijo_random_letras', sufijo);",
              "pm.collectionVariables.set('identificador_largo', 'X'.repeat(300));"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code !== 200) {",
              "    console.log('0A - RESPUESTA DEL LOGIN ADMIN (no fue 200): ' + pm.response.text());",
              "}",
              "pm.test('0A - Login admin devuelve 200 y token', function () {",
              "    pm.response.to.have.status(200);",
              "    var body = pm.response.json();",
              "    var token = body.token || body.access_token || (body.data && body.data.token);",
              "    pm.expect(token, 'debe existir un token de acceso').to.be.a('string').and.not.empty;",
              "    pm.collectionVariables.set('token_admin', token);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
