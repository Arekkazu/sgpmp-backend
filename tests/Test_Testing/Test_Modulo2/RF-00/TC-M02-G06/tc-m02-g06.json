          ],
          "path": [
            "auditoria",
            ""
          ],
          "query": [
            {
              "key": "id_usuario",
              "value": "{{id_usuario_prod2}}"
            },
            {
              "key": "tipo_evento",
              "value": "4"
            },
            {
              "key": "tamano",
              "value": "10"
            }
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "var body = pm.response.text();",
              "console.log('TC-185a auditoria login_fallido: ' + pm.response.code);",
              "pm.test('TC-185a - consulta de auditoria responde 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('TC-185a - el registro de auditoria NO contiene la contrasena incorrecta usada (marcador)', function () {",
              "    pm.expect(body).to.not.include(pm.collectionVariables.get('marcador_password_login_fallido'));",
              "});",
              "pm.test('TC-185a - el registro de auditoria NO contiene la contrasena real de Productor B', function () {",
              "    pm.expect(body).to.not.include(pm.collectionVariables.get('contrasena_prod2'));",
              "});",
              "pm.test('TC-185a - no hay patron de hash bcrypt ($2a$/$2b$/$2y$) en la respuesta', function () {",
              "    pm.expect(/\\$2[aby]\\$/.test(body)).to.eql(false);",
              "});",
              ""
            ]
          }
        }
      ]
    },
