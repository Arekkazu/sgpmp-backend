          "raw": "{\n  \"correo_electronico\": \"{{correo_admin_test}}\",\n  \"contrasena\": \"{{contrasena_admin_test}}\"\n}"
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "console.log('0A admin.test login: ' + pm.response.code + ' body=' + pm.response.text());",
              "pm.test('0A - login admin.test responde 200 o 201', function () {",
              "    pm.expect([200, 201]).to.include(pm.response.code);",
              "});",
              "if (pm.response.code === 200 || pm.response.code === 201) {",
              "    var json = pm.response.json();",
              "    pm.collectionVariables.set('token_admin', json.token);",
              "}",
              ""
