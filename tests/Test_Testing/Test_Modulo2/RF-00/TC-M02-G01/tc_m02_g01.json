    {
      "name": "05 - TC-M02-002 Rechazar nombre duplicado exacto",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400, 409 o 422', function () {",
              "    pm.expect([400, 409, 422]).to.include(pm.response.code);",
              "});",
              "",
              "let json = {};",
              "try {",
              "    json = pm.response.json();",
              "} catch (e) {",
              "}",
              "",
              "const texto = JSON.stringify(json).toLowerCase();",
              "",
              "pm.test('La respuesta indica duplicidad o existencia previa', function () {",
              "    pm.expect(texto).to.match(/duplic|existe|ya.*registr|already|unique/);",
              "});"
