          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "configuracion",
            "especies"
          ]
        }
      }
    },
    {
      "name": "03 - TC-M02-001 Registrar especie nueva valida",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "let json = {};",
              "try {",
              "    json = pm.response.json();",
              "} catch (e) {",
              "}",
              "",
              "const id = json.id_especie ?? json.id;",
              "",
              "pm.test('La respuesta contiene identificador de especie', function () {",
              "    pm.expect(id).to.exist;",
              "});",
              "",
              "pm.test('La respuesta contiene el nombre creado', function () {",
              "    pm.expect(String(json.nombre || '').trim().toLowerCase()).to.eql(",
              "        String(pm.collectionVariables.get('nombreNuevo')).trim().toLowerCase()",
              "    );",
              "});",
              "",
              "if (id !== undefined && id !== null) {",
              "    pm.collectionVariables.set('especieCreadaId', String(id));",
              "}",
              "",
              "const estado = json.es_activo ?? json.estado ?? json.activo;",
              "",
              "if (estado !== undefined && estado !== null) {",
              "    pm.test('La especie queda activa', function () {",
              "        if (typeof estado === 'boolean') {",
              "            pm.expect(estado).to.eql(true);",
              "        } else {",
              "            pm.expect(String(estado).toUpperCase()).to.be.oneOf(['ACTIVO', 'ACTIVE']);",
              "        }",
              "    });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
