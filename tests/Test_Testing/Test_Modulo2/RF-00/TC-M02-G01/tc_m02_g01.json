    {
      "name": "04 - Verificar especie creada en catalogo",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "let json = {};",
              "try {",
              "    json = pm.response.json();",
              "} catch (e) {",
              "}",
              "",
              "function obtenerRegistros(data) {",
              "    if (Array.isArray(data)) return data;",
              "    if (Array.isArray(data.registros)) return data.registros;",
              "    if (Array.isArray(data.items)) return data.items;",
              "    if (Array.isArray(data.data)) return data.data;",
              "    if (Array.isArray(data.especies)) return data.especies;",
              "    return [];",
              "}",
              "",
              "const registros = obtenerRegistros(json);",
              "const nombre = String(pm.collectionVariables.get('nombreNuevo')).trim().toLowerCase();",
              "",
              "const encontrados = registros.filter(function (e) {",
              "    return String(e.nombre || '').trim().toLowerCase() === nombre;",
              "});",
              "",
              "pm.test('La especie nueva aparece en el catalogo', function () {",
              "    pm.expect(encontrados.length).to.eql(1);",
              "});",
              "",
              "if (encontrados.length === 1) {",
              "    const especie = encontrados[0];",
              "    const estado = especie.es_activo ?? especie.estado ?? especie.activo;",
              "",
              "    if (estado !== undefined && estado !== null) {",
              "        pm.test('La especie creada esta activa', function () {",
              "            if (typeof estado === 'boolean') {",
              "                pm.expect(estado).to.eql(true);",
              "            } else {",
              "                pm.expect(String(estado).toUpperCase()).to.be.oneOf(['ACTIVO', 'ACTIVE']);",
              "            }",
              "        });",
              "    }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
