              "    return;",
              "}",
              "",
              "pm.test('GET post-alta HTTP 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "let json = {};",
              "try { json = pm.response.json(); } catch (e) {}",
              "const items = Array.isArray(json.items) ? json.items : [];",
              "const nombre = String(pm.collectionVariables.get('nombreNuevo')).trim().toLowerCase();",
              "const encontrados = items.filter(function (e) {",
              "    return String(e.nombre || '').trim().toLowerCase() === nombre;",
              "});",
              "",
              "pm.test('TC-M02-001 exactamente una especie con ese nombre', function () {",
              "    pm.expect(encontrados.length).to.eql(1);",
              "});",
              "",
              "pm.test('TC-M02-001 especie del catalogo es_activo === true', function () {",
              "    pm.expect(encontrados[0].es_activo).to.eql(true);",
              "});",
              "",
              "pm.test('TC-M02-001 id_especie coincide con el alta', function () {",
              "    pm.expect(String(encontrados[0].id_especie)).to.eql(pm.collectionVariables.get('especieCreadaId'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/configuracion/especies"
      }
