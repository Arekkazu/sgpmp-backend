              "pm.test('TC-M02-002 exacto error_code ESPECIE_DUPLICADA', function () {",
              "    pm.expect(json.error_code).to.eql('ESPECIE_DUPLICADA');",
              "});",
              "",
              "if (Array.isArray(json.fields) && json.fields.length > 0) {",
              "    pm.test('TC-M02-002 exacto fields.field = nombre', function () {",
              "        const campos = json.fields.map(function (f) { return f && f.field; });",
              "        pm.expect(campos).to.include('nombre');",
              "    });",
              "}"
            ]
          }
        }
      ],
