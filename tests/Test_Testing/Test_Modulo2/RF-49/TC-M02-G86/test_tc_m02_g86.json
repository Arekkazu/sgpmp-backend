{
  "info": {
    "_postman_id": "tc-m02-g86-exclusividad-sensor-directa",
    "name": "TC-M02-G86 - Restricciones de exclusividad del sensor tipo DIRECTA y reversión por fallo de auditoría (RF-49)",
    "description": "Caso agrupado TC-M02-G86 (RF-49, CU11): Validación de exclusividad de cardinalidad DIRECTA (TC-M02-149) vía Newman API, complementado por prueba de integración Pytest para reversión por fallo de auditoría (TC-M02-151).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://sigab-backendtest-389pcb-a48238-158-69-200-27.sslip.io/api-sgpmp-test",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "TC-M02-149",
      "description": "Subcaso TC-M02-149: Rechazar sensor DIRECTA ya vinculado a otro activo (HTTP 409)",
      "item": [
        {
          "name": "00 - Autenticación Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo_electronico\": \"admin@pecuaria.co\",\n  \"contrasena\": \"Test1234!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sesiones/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sesiones",
                ""
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[TC-M02-149] [Auth] Autenticación exitosa (200 OK)', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var data = pm.response.json();",
                  "    pm.expect(data).to.have.property('token');",
                  "    pm.collectionVariables.set('jwt_token', data.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "01 - Setup Precondición: Asociar sensor 22 a Activo 108",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo_activo\": \"INDIVIDUAL\",\n  \"tipo_asociacion\": \"DIRECTA\",\n  \"dispositivo_iot_id\": 38,\n  \"sensor_id\": 22,\n  \"id_infraestructura\": 3,\n  \"motivo\": \"Setup precondicion vinculacion activa previa TC-M02-149\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/activos-biologicos/108/sensores",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "activos-biologicos",
                "108",
                "sensores"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[TC-M02-149] [Setup] Código HTTP es 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('[TC-M02-149] [Setup] Asociación inicial registrada como ACTIVA', function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data.estado_asociacion).to.eql('ACTIVA');",
                  "    pm.expect(data.id_activo_biologico).to.eql(108);",
                  "    pm.expect(data.sensor_id).to.eql(22);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "02 - Intento Rechazado: Asociar el mismo sensor 22 a Activo 109",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo_activo\": \"INDIVIDUAL\",\n  \"tipo_asociacion\": \"DIRECTA\",\n  \"dispositivo_iot_id\": 38,\n  \"sensor_id\": 22,\n  \"id_infraestructura\": 3,\n  \"motivo\": \"Intento asociacion sensor ya vinculado TC-M02-149\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/activos-biologicos/109/sensores",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "activos-biologicos",
                "109",
                "sensores"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[TC-M02-149] Código HTTP es 409 Conflict', function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "",
                  "pm.test('[TC-M02-149] Código de error es SENSOR_YA_VINCULADO', function () {",
                  "    var data = pm.response.json();",
                  "    var code = data.error_code || data.codigo || (data.detail && data.detail.code);",
                  "    pm.expect(code).to.eql('SENSOR_YA_VINCULADO');",
                  "});",
                  "",
                  "pm.test('[TC-M02-149] Mensaje menciona colisión con activo 108 y exige desvinculación previa', function () {",
                  "    var data = pm.response.json();",
                  "    var msg = data.message || data.mensaje || (data.detail && data.detail.message) || JSON.stringify(data);",
                  "    pm.expect(msg).to.include('108');",
                  "    pm.expect(msg.toLowerCase()).to.include('desvincularlo primero');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
