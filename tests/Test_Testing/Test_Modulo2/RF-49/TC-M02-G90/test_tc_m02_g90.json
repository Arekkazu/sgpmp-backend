              "raw": "{\n  \"correo_electronico\": \"{{admin_email}}\",\n  \"contrasena\": \"{{admin_password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sesiones/",
              "host": ["{{baseUrl}}"],
              "path": ["sesiones", ""]
            }
          }
        },
        {
          "name": "01 - Crear Asociación AMBIENTAL en Endpoint de Infraestructura",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-M02-220: Código HTTP es 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var data = pm.response.json();",
                  "pm.test('TC-M02-220: id_activo_biologico es null (Asociación Ambiental Pura Tipo B)', function () {",
                  "    pm.expect(data.id_activo_biologico).to.be.null;",
                  "});",
                  "pm.test('TC-M02-220: Tipo de asociación es AMBIENTAL', function () {",
                  "    pm.expect(data.tipo_asociacion.toLowerCase()).to.eql('ambiental');",
                  "});",
                  "pm.test('TC-M02-220: Estado inicial es ACTIVA', function () {",
                  "    pm.expect(data.estado_asociacion).to.eql('ACTIVA');",
                  "});",
                  "if (data.id_asociacion_activo_sensor) {",
                  "    pm.collectionVariables.set('asoc_id_220', data.id_asociacion_activo_sensor);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dispositivo_iot_id\": 42,\n  \"sensor_id\": 25,\n  \"motivo\": \"Asociación AMBIENTAL tipo B RF-49\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/infraestructuras/1/sensores",
              "host": ["{{baseUrl}}"],
              "path": ["infraestructuras", "1", "sensores"]
            }
          }
        },
        {
          "name": "02 - Teardown Defensivo TC-M02-220",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "try {",
                  "    if (pm.response.code === 403) {",
                  "        console.log('Teardown defensivo bloqueado por RBAC (403 Forbidden)');",
                  "    } else if (pm.response.code === 200) {",
                  "        console.log('Teardown defensivo exitoso (200 OK)');",
                  "    } else {",
                  "        console.log('Teardown defensivo respuesta: ' + pm.response.code);",
                  "    }",
                  "} catch (e) {",
                  "    console.log('Error en teardown defensivo: ' + e);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
