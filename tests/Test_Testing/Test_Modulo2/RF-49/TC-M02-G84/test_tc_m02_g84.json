    {
      "name": "98 - Verificación Fix #398: Admin puede desactivar asociación ambiental vía PATCH",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"estado_nuevo\": \"INACTIVA\",\n  \"motivo\": \"Desactivación ambiental vía PATCH Fix 398\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/infraestructuras/{{id_infraestructura_144}}/sensores/{{id_asoc_ambiental_144}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "infraestructuras",
            "{{id_infraestructura_144}}",
            "sensores",
            "{{id_asoc_ambiental_144}}"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// C3: Autocontenido - Garantizar que id_asoc_ambiental_144 este definida",
              "var currentId = pm.collectionVariables.get(\"id_asoc_ambiental_144\");",
              "if (!currentId) {",
              "    var baseUrl = pm.collectionVariables.get(\"baseUrl\");",
              "    var token = pm.collectionVariables.get(\"jwt_token\");",
              "    var infraId = pm.collectionVariables.get(\"id_infraestructura_144\") || \"3\";",
              "    pm.sendRequest({",
              "        url: baseUrl + \"/infraestructuras/\" + infraId + \"/sensores\",",
              "        method: \"POST\",",
              "        header: {",
              "            \"Authorization\": \"Bearer \" + token,",
              "            \"Content-Type\": \"application/json\",",
              "            \"Accept\": \"application/json\"",
              "        },",
              "        body: {",
              "            mode: \"raw\",",
              "            raw: JSON.stringify({",
              "                dispositivo_iot_id: 39,",
              "                sensor_id: 23,",
              "                motivo: \"Pre-req 98 autocontenido Fix 398\"",
              "            })",
              "        }",
              "    }, function (err, res) {",
              "        if (res && (res.code === 201 || res.code === 200)) {",
              "            pm.collectionVariables.set(\"id_asoc_ambiental_144\", res.json().id_asociacion_activo_sensor);",
              "        } else if (res && res.code === 409) {",
              "            pm.sendRequest({",
              "                url: baseUrl + \"/activos-biologicos/83/sensores?tipo_consulta=ACTIVA\",",
              "                method: \"GET\",",
              "                header: { \"Authorization\": \"Bearer \" + token, \"Accept\": \"application/json\" }",
              "            }, function (gErr, gRes) {",
              "                if (!gErr && gRes && gRes.code === 200) {",
              "                    var asocs = gRes.json().asociaciones || [];",
              "                    var m = asocs.find(function(a) { return (a.sensor_id === 23 || a.id_sensor === 23) && a.estado_asociacion === \"ACTIVA\"; });",
              "                    if (m && m.id_asociacion_activo_sensor) {",
              "                        pm.collectionVariables.set(\"id_asoc_ambiental_144\", m.id_asociacion_activo_sensor);",
              "                    }",
              "                }",
              "            });",
              "        }",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        },
        {
