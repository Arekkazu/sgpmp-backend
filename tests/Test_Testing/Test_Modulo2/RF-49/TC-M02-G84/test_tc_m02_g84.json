        {
          "name": "01 - Asociar sensor AMBIENTAL a activo en infraestructura",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dispositivo_iot_id\": 39,\n  \"sensor_id\": 23,\n  \"motivo\": \"Monitoreo ambiental compartido infraestructura TC-M02-144\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/infraestructuras/{{id_infraestructura_144}}/sensores",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "infraestructuras",
                "{{id_infraestructura_144}}",
                "sensores"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// C1: Pre-cleanup: inactivar cualquier asociacion ambiental previa del sensor 23 en infra 3",
                  "const baseUrl = pm.collectionVariables.get(\"baseUrl\");",
                  "const token = pm.collectionVariables.get(\"jwt_token\");",
                  "const infraId = pm.collectionVariables.get(\"id_infraestructura_144\") || \"3\";",
                  "",
                  "pm.sendRequest({",
                  "    url: baseUrl + \"/activos-biologicos/83/sensores?tipo_consulta=ACTIVA\",",
                  "    method: \"GET\",",
                  "    header: {",
                  "        \"Authorization\": \"Bearer \" + token,",
                  "        \"Accept\": \"application/json\"",
                  "    }",
                  "}, function (err, res) {",
                  "    if (!err && res && res.code === 200) {",
                  "        try {",
                  "            const d = res.json();",
                  "            const asocs = d.asociaciones || [];",
                  "            const previa = asocs.find(function(a) {",
                  "                return (a.sensor_id === 23 || a.id_sensor === 23) && String(a.id_infraestructura) === String(infraId) && a.estado_asociacion === \"ACTIVA\";",
                  "            });",
                  "            if (previa && previa.id_asociacion_activo_sensor) {",
                  "                pm.sendRequest({",
                  "                    url: baseUrl + \"/infraestructuras/\" + infraId + \"/sensores/\" + previa.id_asociacion_activo_sensor,",
                  "                    method: \"PATCH\",",
                  "                    header: {",
                  "                        \"Authorization\": \"Bearer \" + token,",
                  "                        \"Content-Type\": \"application/json\",",
                  "                        \"Accept\": \"application/json\"",
                  "                    },",
                  "                    body: {",
                  "                        mode: \"raw\",",
                  "                        raw: JSON.stringify({",
                  "                            estado_nuevo: \"INACTIVA\",",
                  "                            motivo: \"Pre-cleanup automatico TC-M02-144\"",
                  "                        })",
                  "                    }",
                  "                }, function (patchErr, patchRes) {});",
                  "            }",
                  "        } catch (e) {}",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// C2: Assertion tolerante e idempotente (200, 201, 409)",
                  "pm.test(\"[TC-M02-144] POST crea o encuentra asociacion ambiental existente\", function () {",
                  "    pm.expect([200, 201, 409]).to.include(pm.response.code);",
                  "});",
                  "",
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "    pm.test(\"[TC-M02-144] Asociacion ambiental vinculada a infraestructura correctamente (Tipo B)\", function () {",
                  "        var data = pm.response.json();",
                  "        pm.expect(data).to.have.property(\"id_asociacion_activo_sensor\");",
                  "        pm.expect(data.id_asociacion_activo_sensor).to.be.a(\"number\");",
                  "        pm.expect(data.id_activo_biologico).to.be.null;",
                  "        pm.expect(data.sensor_id).to.eql(23);",
                  "        pm.expect(data.id_infraestructura).to.eql(3);",
                  "        pm.expect(data.tipo_asociacion.toLowerCase()).to.eql(\"ambiental\");",
                  "        pm.expect(data.estado_asociacion).to.eql(\"ACTIVA\");",
                  "        pm.collectionVariables.set(\"id_asoc_ambiental_144\", data.id_asociacion_activo_sensor);",
                  "    });",
                  "} else if (pm.response.code === 409) {",
                  "    const baseUrl = pm.collectionVariables.get(\"baseUrl\");",
                  "    const token = pm.collectionVariables.get(\"jwt_token\");",
                  "    const infraId = pm.collectionVariables.get(\"id_infraestructura_144\") || \"3\";",
                  "    pm.sendRequest({",
                  "        url: baseUrl + \"/activos-biologicos/83/sensores?tipo_consulta=ACTIVA\",",
                  "        method: \"GET\",",
                  "        header: {",
                  "            \"Authorization\": \"Bearer \" + token,",
                  "            \"Accept\": \"application/json\"",
                  "        }",
                  "    }, function (err, res) {",
                  "        var idRecuperado = null;",
                  "        if (!err && res && res.code === 200) {",
                  "            try {",
                  "                var d = res.json();",
                  "                var asocs = d.asociaciones || [];",
                  "                var match = asocs.find(function(a) {",
                  "                    return (a.sensor_id === 23 || a.id_sensor === 23) && String(a.id_infraestructura) === String(infraId) && a.estado_asociacion === \"ACTIVA\";",
                  "                });",
                  "                if (match && match.id_asociacion_activo_sensor) {",
                  "                    idRecuperado = match.id_asociacion_activo_sensor;",
                  "                    pm.collectionVariables.set(\"id_asoc_ambiental_144\", idRecuperado);",
                  "                }",
                  "            } catch (e) {}",
                  "        }",
                  "        pm.test(\"[TC-M02-144] Recuperacion de id_asoc_ambiental_144 tras 409 existente\", function () {",
                  "            pm.expect(idRecuperado, \"No se pudo recuperar id_asoc_ambiental_144 (estado inconsistente)\").to.not.be.null;",
                  "        });",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
