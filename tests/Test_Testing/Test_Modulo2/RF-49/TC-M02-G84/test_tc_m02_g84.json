                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo_activo\": \"INDIVIDUAL\",\n  \"tipo_asociacion\": \"DIRECTA\",\n  \"dispositivo_iot_id\": 38,\n  \"sensor_id\": 22,\n  \"id_infraestructura\": 3,\n  \"motivo\": \"Monitoreo biometrico individual TC-M02-143\"\n}"
            },
