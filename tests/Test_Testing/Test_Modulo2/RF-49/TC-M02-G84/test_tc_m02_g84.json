          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[TC-M02-143] Código HTTP es 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('[TC-M02-143] Estructura de respuesta contiene identificadores correctos', function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data).to.have.property('id_asociacion_activo_sensor');",
                  "    pm.expect(data.id_asociacion_activo_sensor).to.be.a('number');",
                  "    pm.expect(data.id_activo_biologico).to.eql(108);",
                  "    pm.expect(data.sensor_id).to.eql(22);",
                  "    pm.expect(data.dispositivo_iot_id).to.eql(38);",
                  "    pm.expect(data.id_infraestructura).to.eql(3);",
                  "});",
                  "",
                  "pm.test('[TC-M02-143] Estado de asociación es ACTIVA y tipo es directa', function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data.estado_asociacion).to.eql('ACTIVA');",
                  "    pm.expect(data.tipo_asociacion.toLowerCase()).to.eql('directa');",
                  "    pm.expect(data.tipo_activo).to.eql('INDIVIDUAL');",
                  "});"
