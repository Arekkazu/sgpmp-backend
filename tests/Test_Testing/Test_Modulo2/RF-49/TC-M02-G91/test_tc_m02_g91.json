        {
          "name": "TC-M02-223_POST_Crear_Asociacion",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Respuesta contiene asociacion activa con campos completos\", function () {",
                  "    var idAsoc = jsonData.id_asociacion_activo_sensor || jsonData.asociacion_id;",
                  "    pm.expect(idAsoc).to.be.a('number');",
                  "    pm.expect(jsonData.estado_asociacion).to.equal('ACTIVA');",
                  "    pm.expect(jsonData.tipo_asociacion).to.equal('directa');",
                  "    pm.expect(jsonData.sensor_id).to.equal(2);",
                  "    pm.expect(jsonData.id_activo_biologico).to.equal(19);",
                  "    pm.expect(jsonData.fecha_inicio).to.be.a('string');",
                  "});",
                  "if (jsonData.id_asociacion_activo_sensor) {",
                  "    pm.collectionVariables.set(\"nuevaAsociacionId\", jsonData.id_asociacion_activo_sensor.toString());",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo_activo\": \"INDIVIDUAL\",\n  \"tipo_asociacion\": \"DIRECTA\",\n  \"dispositivo_iot_id\": 1,\n  \"sensor_id\": 2,\n  \"id_infraestructura\": 1,\n  \"motivo\": \"Verificacion funcional visibilidad post-creacion TC-M02-223\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/activos-biologicos/19/sensores",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "activos-biologicos",
                "19",
                "sensores"
              ]
            }
          }
        },
        {
          "name": "TC-M02-223_GET_Consultar_Sensores_Activo",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"RF-49 Criterio de Aceptacion: El sistema refleja la asociacion en consultas posteriores (HTTP 200)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"El contrato de respuesta es un objeto envolvente con metadata y array 'asociaciones'\", function () {",
                  "    pm.expect(jsonData).to.be.an('object');",
                  "    pm.expect(jsonData.id_activo_biologico).to.equal(19);",
                  "    pm.expect(jsonData.tipo_consulta).to.equal('ACTIVA');",
                  "    pm.expect(jsonData.asociaciones).to.be.an('array');",
                  "});",
                  "pm.test(\"La asociacion recien creada (ID capturado) es visible con sus campos completos\", function () {",
                  "    var targetId = parseInt(pm.collectionVariables.get(\"nuevaAsociacionId\"));",
                  "    var encontrada = jsonData.asociaciones.find(function(item) {",
                  "        return item.id_asociacion_activo_sensor === targetId;",
                  "    });",
                  "    pm.expect(encontrada, \"La asociacion creada (ID: \" + targetId + \") debe estar presente en la lista\").to.not.be.undefined;",
                  "    pm.expect(encontrada.estado_asociacion).to.equal('ACTIVA');",
                  "    pm.expect(encontrada.tipo_asociacion).to.equal('directa');",
                  "    pm.expect(encontrada.sensor_id).to.equal(2);",
                  "    pm.expect(encontrada.id_activo_biologico).to.equal(19);",
                  "    pm.expect(encontrada.fecha_inicio).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/activos-biologicos/19/sensores",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "activos-biologicos",
                "19",
                "sensores"
              ]
            }
          }
        },
        {
          "name": "TC-M02-G91_ADVERTENCIA_TEARDOWN_API_BLOQUEADO",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// ==========================================================================",
                  "// NOTA OPERATIVA QA / ADVERTENCIA DE TEARDOWN:",
                  "// No existe endpoint de desactivación/cleanup viable vía API para la asociación creada.",
                  "// El endpoint PATCH /activos-biologicos/{id_activo}/sensores/{id_asociacion} permanece",
                  "// bloqueado con HTTP 403 Forbidden por ausencia del permiso de actualización",
                  "// (id_accion=3 sobre id_recurso=30) en modulo1.permisos en el entorno TEST (INC-M02-40-G89).",
                  "// Por protocolo estricto de QA, la asociación remanente (creada por TC-M02-223)",
                  "// debe documentarse como condición de entorno remanente y NUNCA limpiarse",
                  "// mediante sentencias SQL directas (INSERT/UPDATE/DELETE) en base de datos.",
                  "// ==========================================================================",
                  "pm.test(\"Advertencia de Teardown API documentada (Informativo)\", function () {",
                  "    pm.expect(true).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        }
      ]
    }
  ]
