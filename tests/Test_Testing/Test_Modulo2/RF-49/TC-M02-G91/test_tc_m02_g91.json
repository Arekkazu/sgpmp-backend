    {
      "name": "TC-M02-223",
      "description": "Subcaso TC-M02-223: Verificar que la asociación creada es visible en consultas posteriores (RF-49 Criterio de aceptación).",
      "item": [
        {
          "name": "TC-M02-223_Login_Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Token presente en respuesta\", function () {",
                  "    pm.expect(jsonData.token).to.be.a('string');",
                  "});",
                  "pm.collectionVariables.set(\"bearerToken\", jsonData.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo_electronico\": \"{{admin_email}}\",\n  \"contrasena\": \"{{admin_password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sesiones/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sesiones",
                ""
              ]
            }
          }
        },
        {
          "name": "TC-M02-223_POST_Crear_Asociacion",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Respuesta contiene asociacion activa\", function () {",
                  "    var idAsoc = jsonData.id_asociacion_activo_sensor || jsonData.asociacion_id;",
                  "    pm.expect(idAsoc).to.be.a('number');",
                  "    pm.expect(jsonData.estado_asociacion).to.equal('ACTIVA');",
                  "    pm.expect(jsonData.sensor_id).to.equal(2);",
                  "});",
                  "if (jsonData.id_asociacion_activo_sensor) {",
                  "    pm.collectionVariables.set(\"nuevaAsociacionId\", jsonData.id_asociacion_activo_sensor.toString());",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo_activo\": \"INDIVIDUAL\",\n  \"tipo_asociacion\": \"DIRECTA\",\n  \"dispositivo_iot_id\": 1,\n  \"sensor_id\": 2,\n  \"id_infraestructura\": 1,\n  \"motivo\": \"Verificacion funcional visibilidad post-creacion TC-M02-223\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/activos-biologicos/19/sensores",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "activos-biologicos",
                "19",
                "sensores"
              ]
            }
          }
        },
        {
          "name": "TC-M02-223_GET_Consultar_Sensores_Activo",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"RF-49 Criterio de Aceptacion: El sistema refleja la asociacion en consultas posteriores (HTTP 200)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"La asociacion recien creada es visible en la consulta de sensores del activo\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "    var encontrada = jsonData.some(function(item) {",
                  "        return item.sensor_id === 2 && item.estado_asociacion === 'ACTIVA';",
                  "    });",
                  "    pm.expect(encontrada).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/activos-biologicos/19/sensores",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "activos-biologicos",
                "19",
                "sensores"
              ]
            }
          }
        }
      ]
    }
