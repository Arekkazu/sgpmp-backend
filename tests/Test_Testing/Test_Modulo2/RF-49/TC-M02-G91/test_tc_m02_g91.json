              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Rechazo de eliminacion en ruta base (HTTP 405 Method Not Allowed)\", function () {",
                  "    pm.expect(pm.response.code).to.equal(405);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
