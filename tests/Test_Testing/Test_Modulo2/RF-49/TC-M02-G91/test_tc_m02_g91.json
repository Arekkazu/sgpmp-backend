    {
      "name": "TC-M02-222",
      "description": "Subcaso TC-M02-222: Rechazar eliminación (DELETE) de una asociación existente (Restricción 8 append-only).",
      "item": [
        {
          "name": "TC-M02-222_Login_Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Token presente en respuesta\", function () {",
                  "    pm.expect(jsonData.token).to.be.a('string');",
                  "});",
                  "pm.collectionVariables.set(\"bearerToken\", jsonData.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo_electronico\": \"{{admin_email}}\",\n  \"contrasena\": \"{{admin_password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sesiones/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sesiones",
                ""
              ]
            }
          }
        },
        {
          "name": "TC-M02-222_DELETE_Asociacion_Existente",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Rechazo de eliminacion (DELETE no permitido / append-only)\", function () {",
                  "    pm.expect([404, 405]).to.include(pm.response.code);",
                  "});",
                  "pm.test(\"Verificar que la respuesta confirma la no eliminacion fisica (No 200 ni 204)\", function () {",
                  "    pm.expect(pm.response.code).to.not.equal(200);",
                  "    pm.expect(pm.response.code).to.not.equal(204);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/activos-biologicos/19/sensores/17",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "activos-biologicos",
                "19",
                "sensores",
                "17"
              ]
            }
          }
        },
        {
