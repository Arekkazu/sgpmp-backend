  "item": [
    {
      "name": "TC-M02-222",
      "description": "Subcaso TC-M02-222: Rechazar eliminación (DELETE) de una asociación existente (Restricción 8 append-only).",
      "item": [
        {
          "name": "TC-M02-222_Login_Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Token presente en respuesta\", function () {",
                  "    pm.expect(jsonData.token).to.be.a('string');",
                  "});",
                  "pm.collectionVariables.set(\"bearerToken\", jsonData.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo_electronico\": \"{{admin_email}}\",\n  \"contrasena\": \"{{admin_password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sesiones/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sesiones",
                ""
              ]
            }
          }
        },
        {
          "name": "TC-M02-222_GET_Capturar_Asociacion_Activa",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Consulta previa de sensores para capturar ID activo (HTTP 200)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Respuesta contiene array de asociaciones\", function () {",
                  "    pm.expect(jsonData.asociaciones).to.be.an('array');",
                  "    pm.expect(jsonData.asociaciones.length).to.be.greaterThan(0);",
                  "});",
                  "if (jsonData.asociaciones && jsonData.asociaciones.length > 0) {",
                  "    var activa = jsonData.asociaciones[0];",
                  "    pm.collectionVariables.set(\"asociacionExistenteId\", activa.id_asociacion_activo_sensor.toString());",
                  "    pm.collectionVariables.set(\"estadoPrevio\", activa.estado_asociacion);",
                  "    pm.collectionVariables.set(\"fechaFinPrevia\", activa.fecha_fin ? activa.fecha_fin.toString() : \"null\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/activos-biologicos/19/sensores",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "activos-biologicos",
                "19",
                "sensores"
              ]
            }
          }
        },
        {
          "name": "TC-M02-222_DELETE_Asociacion_Existente",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Rechazo de eliminacion sobre asociacion activa dinamica (DELETE no permitido / append-only)\", function () {",
                  "    pm.expect([404, 405]).to.include(pm.response.code);",
                  "});",
                  "pm.test(\"Verificar que la respuesta confirma la no eliminacion fisica (No 200 ni 204)\", function () {",
                  "    pm.expect(pm.response.code).to.not.equal(200);",
                  "    pm.expect(pm.response.code).to.not.equal(204);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/activos-biologicos/19/sensores/{{asociacionExistenteId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "activos-biologicos",
                "19",
                "sensores",
                "{{asociacionExistenteId}}"
              ]
            }
          }
        },
        {
          "name": "TC-M02-222_DELETE_Ruta_Base_Sensores",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Rechazo de eliminacion en ruta base (HTTP 405 Method Not Allowed)\", function () {",
                  "    pm.expect(pm.response.code).to.equal(405);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/activos-biologicos/19/sensores",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "activos-biologicos",
                "19",
                "sensores"
              ]
            }
          }
        },
        {
          "name": "TC-M02-222_GET_Verificar_Inmutabilidad_Post_DELETE",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Verificacion de inmutabilidad: GET posterior responde HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"El registro permanece intacto tras intento de DELETE (mismo estado y fecha_fin)\", function () {",
                  "    pm.expect(jsonData.asociaciones).to.be.an('array');",
                  "    var targetId = parseInt(pm.collectionVariables.get(\"asociacionExistenteId\"));",
                  "    var item = jsonData.asociaciones.find(function(a) {",
                  "        return a.id_asociacion_activo_sensor === targetId;",
                  "    });",
                  "    pm.expect(item, \"La asociacion debe seguir existiendo\").to.not.be.undefined;",
                  "    pm.expect(item.estado_asociacion).to.equal(pm.collectionVariables.get(\"estadoPrevio\"));",
                  "    var fechaFinEsperada = pm.collectionVariables.get(\"fechaFinPrevia\");",
                  "    if (fechaFinEsperada === \"null\") {",
                  "        pm.expect(item.fecha_fin).to.be.null;",
                  "    } else {",
                  "        pm.expect(item.fecha_fin.toString()).to.equal(fechaFinEsperada);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/activos-biologicos/19/sensores",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "activos-biologicos",
                "19",
                "sensores"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "TC-M02-223",
      "description": "Subcaso TC-M02-223: Verificar que la asociación creada es visible en consultas posteriores (RF-49 Criterio de aceptación).",
      "item": [
        {
          "name": "TC-M02-223_Login_Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Token presente en respuesta\", function () {",
                  "    pm.expect(jsonData.token).to.be.a('string');",
                  "});",
                  "pm.collectionVariables.set(\"bearerToken\", jsonData.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo_electronico\": \"{{admin_email}}\",\n  \"contrasena\": \"{{admin_password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sesiones/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sesiones",
