            "exec": [
              "",
              "console.log('TC-062b fecha anterior a ultimo evento: ' + pm.response.code + ' body=' + pm.response.text());",
              "// NOTA: esta validacion (FA-04, fecha vs ultimo evento) se evalua DESPUES de comprobar",
              "// que el activo tiene una fase productiva activa (FA-05). Como TC-M02-G35 encontro que",
              "// el endpoint que asigna fase productiva esta roto (bug documentado), ningun activo",
              "// puede tener hoy una fase activa, y esta peticion queda bloqueada antes de llegar a",
              "// validar la fecha. Se documenta el resultado real obtenido, no se fuerza un valor.",
              "pm.test('TC-062b - la peticion es rechazada (400 esperado por fecha, o 422 si esta bloqueada por la falta de fase activa - ver TC-M02-G35)', function () {",
              "    pm.expect([400, 422]).to.include(pm.response.code);",
              "});",
