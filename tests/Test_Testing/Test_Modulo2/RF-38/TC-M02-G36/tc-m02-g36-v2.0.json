      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var enBaja = pm.collectionVariables.get('activo_a_en_baja') === 'true';",
              "if (pm.response.code !== 409) {",
              "    console.log('TC-060 - Rechazar cierre de activo ya BAJA - RESPUESTA: ' + pm.response.text());",
              "}",
              "if (!enBaja) {",
              "    pm.test('TC-060 - No ejecutable: el activo A nunca llego a un estado terminal (BAJA) en SETUP-5/SETUP-6', function () {",
              "        pm.expect.fail('El activo A no quedo en BAJA (ver SETUP-5/SETUP-6). No se pudo verificar el escenario real de TC-060 (rechazo de un segundo cierre sobre un activo terminal). Respuesta obtenida: ' + pm.response.code + ' ' + pm.response.text());",
              "    });",
              "} else {",
              "    pm.test('TC-060 - Un segundo cierre sobre un activo ya en BAJA se rechaza con 409 ESTADO_INVALIDO_PARA_CIERRE', function () {",
              "        pm.response.to.have.status(409);",
              "        var body = pm.response.json();",
              "        pm.expect(body.error_code).to.eql('ESTADO_INVALIDO_PARA_CIERRE');",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "TC-061a - Rechazar cierre con motivo de cierre vacio",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token_admin}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{base_url}}/activos-biologicos/{{id_activo_b}}/cierre",
        "body": { "mode": "raw", "raw": "{\n  \"fecha_cierre\": \"{{fecha_hoy}}\",\n  \"motivo_cierre\": \"\"\n}" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
