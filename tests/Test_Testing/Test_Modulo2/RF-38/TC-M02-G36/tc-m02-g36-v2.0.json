    {
      "name": "TC-060 - Rechazar cierre de un activo ya en estado terminal (BAJA)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token_admin}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{base_url}}/activos-biologicos/{{id_activo_a}}/cierre",
