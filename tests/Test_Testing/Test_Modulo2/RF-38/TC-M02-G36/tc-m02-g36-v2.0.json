      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code !== 201) {",
              "    console.log('SETUP-4 - Registrar activo A - RESPUESTA: ' + pm.response.text());",
              "    pm.collectionVariables.set('id_activo_a', '');",
              "} else {",
              "    var body = pm.response.json();",
              "    pm.collectionVariables.set('id_activo_a', String(body.id_activo_biologico));",
              "}",
              "pm.test('SETUP-4 - Registro directo de activo A (informativo: si falla, se documenta como defecto separado y se usa workaround)', function () {",
              "    pm.expect(true).to.be.true;",
