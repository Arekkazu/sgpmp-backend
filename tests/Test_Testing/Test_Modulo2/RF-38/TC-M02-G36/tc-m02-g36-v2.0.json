        "url": "{{base_url}}/configuracion/infraestructuras",
        "body": { "mode": "raw", "raw": "{\n  \"nombre_infraestructura\": \"Area TC-M02-G36 v2.0\",\n  \"tipo_area\": \"Estanque\",\n  \"superficie\": 200,\n  \"finca_id\": {{id_finca}}\n}" }
