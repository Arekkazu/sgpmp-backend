    {
      "name": "SETUP-3 - Consultar catalogo de especies y ubicar una compatible con Estanque (Cachama Blanca)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
        "url": "{{base_url}}/configuracion/especies"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code !== 200) {",
              "    console.log('SETUP-3 - Consultar catalogo de especies - RESPUESTA: ' + pm.response.text());",
              "}",
              "pm.test('SETUP-3 - Existe la especie Cachama Blanca en el catalogo (compatible con Estanque, RF-48)', function () {",
              "    pm.response.to.have.status(200);",
              "    var body = pm.response.json();",
              "    var lista = Array.isArray(body) ? body : (body.items || []);",
              "    var especie = lista.find(function (e) { return e.nombre === 'Cachama Blanca' && e.es_activo !== false; });",
              "    pm.expect(especie, 'debe existir la especie Cachama Blanca activa en el catalogo').to.not.be.undefined;",
              "    pm.collectionVariables.set('id_especie', String(especie.id_especie));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
