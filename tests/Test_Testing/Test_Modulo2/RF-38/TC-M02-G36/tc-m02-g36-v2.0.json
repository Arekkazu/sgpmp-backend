    {
      "name": "SETUP-4B - Workaround: buscar activo INDIVIDUAL ACTIVO existente para el rol de activo A (si SETUP-4 fallo)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
        "url": "{{base_url}}/activos-biologicos?tipo=INDIVIDUAL&page_size=100&pagina=1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var idA = pm.collectionVariables.get('id_activo_a');",
              "if (idA) {",
              "    console.log('SETUP-4B - OMITIDO: SETUP-4 ya registro un activo A nuevo (id=' + idA + ').');",
              "    pm.test('SETUP-4B - Paso informativo (omitido, SETUP-4 ya proveyo un activo nuevo)', function () { pm.expect(true).to.be.true; });",
              "} else if (pm.response.code !== 200) {",
              "    console.log('SETUP-4B - Buscar activo INDIVIDUAL existente - RESPUESTA: ' + pm.response.text());",
              "    pm.collectionVariables.set('activo_a_disponible', 'false');",
              "    pm.test('SETUP-4B - El catalogo de activos biologicos es consultable (workaround)', function () { pm.response.to.have.status(200); });",
              "} else {",
              "    var body = pm.response.json();",
              "    var candidatos = (body.registros || []).filter(function (a) { return a.tipo === 'INDIVIDUAL' && a.nombre_estado === 'ACTIVO'; });",
              "    console.log('SETUP-4B - candidatos INDIVIDUAL ACTIVO: ' + JSON.stringify(candidatos.map(function (a) { return a.id_activo_biologico; })));",
              "    if (candidatos.length === 0) {",
              "        pm.collectionVariables.set('activo_a_disponible', 'false');",
              "        pm.test('SETUP-4B - No se encontro un activo INDIVIDUAL ACTIVO disponible para el rol de activo A', function () {",
              "            pm.expect.fail('No hay activos INDIVIDUAL en estado ACTIVO en TEST y la creacion directa (SETUP-4) fallo. TC-060/SETUP-5 quedan bloqueados por el defecto de creacion (ver TC-M02-G52).');",
              "        });",
              "    } else {",
              "        pm.collectionVariables.set('id_activo_a', String(candidatos[0].id_activo_biologico));",
              "        pm.collectionVariables.set('activo_a_disponible', 'true');",
              "        console.log('SETUP-4B - se usara el activo existente ' + candidatos[0].id_activo_biologico + ' como activo A (sera llevado a BAJA de forma permanente).');",
              "        pm.test('SETUP-4B - Se encuentra un activo INDIVIDUAL ACTIVO existente para el rol de activo A (workaround por el defecto de creacion)', function () {",
              "            pm.expect(candidatos[0].id_activo_biologico).to.be.a('number');",
              "        });",
              "    }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
