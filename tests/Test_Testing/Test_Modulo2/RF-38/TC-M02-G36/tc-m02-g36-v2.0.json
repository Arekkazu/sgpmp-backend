      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
        "url": "{{base_url}}/activos-biologicos?tipo=INDIVIDUAL&page_size=100&pagina=1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var idB = pm.collectionVariables.get('id_activo_b');",
              "if (idB) {",
              "    console.log('SETUP-4D - OMITIDO: SETUP-4C ya registro un activo B nuevo (id=' + idB + ').');",
              "    pm.test('SETUP-4D - Paso informativo (omitido, SETUP-4C ya proveyo un activo nuevo)', function () { pm.expect(true).to.be.true; });",
              "} else if (pm.response.code !== 200) {",
              "    console.log('SETUP-4D - Buscar activo INDIVIDUAL existente - RESPUESTA: ' + pm.response.text());",
              "    pm.test('SETUP-4D - El catalogo de activos biologicos es consultable (workaround)', function () { pm.response.to.have.status(200); });",
              "} else {",
              "    var idA = pm.collectionVariables.get('id_activo_a');",
              "    var body = pm.response.json();",
              "    var candidatos = (body.registros || []).filter(function (a) {",
              "        return a.tipo === 'INDIVIDUAL' && a.nombre_estado === 'ACTIVO' && String(a.id_activo_biologico) !== String(idA);",
              "    });",
              "    console.log('SETUP-4D - candidatos INDIVIDUAL ACTIVO (excluyendo A): ' + JSON.stringify(candidatos.map(function (a) { return a.id_activo_biologico; })));",
              "    if (candidatos.length === 0) {",
