              "}",
              "if (!cerrado) {",
              "    pm.test('TC-064c - No ejecutable: el activo nunca llego a CERRADO en esta ronda (ver TC-059a)', function () {",
              "        pm.expect.fail('El activo no quedo CERRADO, por lo que la verificacion de inmutabilidad no aplica en esta ronda.');",
              "    });",
              "} else {",
              "    pm.test('TC-064c - El numero de eventos del activo no cambio tras los intentos bloqueados (TC-064a/b)', function () {",
              "        pm.response.to.have.status(200);",
              "        var body = pm.response.json();",
              "        var eventos = body.eventos || body.historial_eventos || [];",
