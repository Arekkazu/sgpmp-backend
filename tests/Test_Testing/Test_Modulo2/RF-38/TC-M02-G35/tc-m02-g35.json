      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "var hoy = new Date().toISOString().slice(0,10);",
              "pm.collectionVariables.set('fecha_cierre_g35', hoy);",
              ""
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "console.log('TC-059a cierre: ' + pm.response.code + ' body=' + pm.response.text());",
              "pm.test('TC-059a - el cierre del ciclo responde 200', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "    var json = pm.response.json();",
              "    pm.test('TC-059a - el activo queda en estado CERRADO', function () {",
              "        pm.expect(json.estado).to.eql('CERRADO');",
              "    });",
              "    pm.test('TC-059a - la respuesta confirma que la fase quedo finalizada', function () {",
              "        pm.expect(json.fase_finalizada).to.eql(true);",
              "    });",
              "    pm.test('TC-059a - la respuesta refleja el motivo de cierre enviado', function () {",
              "        pm.expect(json.motivo_cierre).to.eql('VENTA');",
              "    });",
              "}",
              ""
            ]
          }
        }
      ]
