          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "var MAPA_ROL_A_ID = {",
              "    'Administrador': 1, 'Productor': 2, 'Veterinario': 3, 'Ingeniero de Campo': 4,",
              "    'Contador': 5, 'Supervisor': 6, 'Gestor de Granja': 7, 'Revisor Fiscal': 8, 'Externo AgroFusion': 9",
              "};",
              "console.log('SETUP-4 detalle cuenta de prueba: ' + pm.response.code + ' body=' + pm.response.text());",
              "pm.test('SETUP-4 - se puede consultar el detalle (200)', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "    var b = pm.response.json();",
              "    pm.collectionVariables.set('version_operario', b.version);",
              "    pm.collectionVariables.set('nombre_operario', b.nombre);",
              "    pm.collectionVariables.set('apellidos_operario', b.apellidos);",
              "    var idRolOriginal = MAPA_ROL_A_ID[b.nombre_rol];",
              "    pm.test('SETUP-4 - se reconoce el nombre del rol actual (' + b.nombre_rol + ')', function () {",
              "        pm.expect(idRolOriginal).to.not.eql(undefined);",
              "    });",
              "    pm.collectionVariables.set('id_rol_original_operario', idRolOriginal);",
              "    console.log('SETUP-4 - rol actual: ' + b.nombre_rol + ' (id ' + idRolOriginal + '), estado_cuenta: ' + b.estado_cuenta);",
              "}",
              ""
            ]
          }
