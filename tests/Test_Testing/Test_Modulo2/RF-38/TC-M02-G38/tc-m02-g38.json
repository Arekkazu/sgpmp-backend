              "console.log('SETUP-1 finca: ' + pm.response.code + ' body=' + pm.response.text());",
              "pm.test('SETUP-1 - finca creada (201)', function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) { pm.collectionVariables.set('id_finca_creada_g38', pm.response.json().id_finca); }",
              ""
            ]
          }
        }
      ]
