    {
      "name": "SETUP-4. Admin consulta el detalle de la cuenta de prueba (id 68) para obtener version/nombre/apellidos/rol actual",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token_admin}}"
