    {
      "name": "TC-065a. Cambiar estado del activo A de ACTIVO a EN_TRATAMIENTO (PATCH /estado, RF-44)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_admin}}" }
        ],
        "url": {
          "raw": "{{base_url}}/activos-biologicos/{{id_activo_g37}}/estado",
