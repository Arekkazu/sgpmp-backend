        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "console.log('TC-069a bitacora RF44: ' + pm.response.code + ' body=' + pm.response.text());",
              "pm.test('TC-069a - la consulta de bitacora responde 200', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "    var b = pm.response.json();",
              "    var registros = b.registros || b.items || b.resultados || [];",
              "    pm.test('TC-069a - existe al menos un registro RF44/ESTADO_CAMBIADO exitoso para este activo', function () {",
              "        var encontrado = registros.some(function (r) {",
              "            return r.tipo_evento === 'ESTADO_CAMBIADO' && r.resultado === 'EXITOSO';",
              "        });",
              "        pm.expect(encontrado).to.eql(true);",
              "    });",
              "}",
              ""
            ]
          }
        }
      ]
