    {
      "name": "TC-069a. Consultar la bitacora de auditoria filtrando por rf_origen=RF44 y el activo de prueba",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token_admin}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/activos-biologicos/auditoria?rf_origen=RF44&id_activo_biologico={{id_activo_g37}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "activos-biologicos",
            "auditoria"
          ],
          "query": [
            {
              "key": "rf_origen",
              "value": "RF44"
            },
            {
              "key": "id_activo_biologico",
              "value": "{{id_activo_g37}}"
            }
          ]
        }
      },
      "response": [],
