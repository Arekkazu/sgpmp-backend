    {
      "name": "SETUP-1. Admin crea una finca de prueba",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token_admin}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/configuracion/fincas",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "configuracion",
            "fincas"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Finca Prueba QA {{sufijo_finca_g37}}\",\n  \"ubicacion\": {\n    \"departamento\": \"Huila\",\n    \"municipio\": \"Neiva\",\n    \"vereda\": \"La Ceiba\",\n    \"latitud\": 2.9273,\n    \"longitud\": -75.2819\n  },\n  \"tamano_h\": 10.5\n}"
        }
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "var letras = 'abcdefghijklmnopqrstuvwxyz';",
              "var suf = '';",
              "for (var i = 0; i < 8; i++) { suf += letras.charAt(Math.floor(Math.random() * letras.length)); }",
              "pm.collectionVariables.set('sufijo_finca_g37', suf);",
              ""
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "console.log('SETUP-1 finca: ' + pm.response.code + ' body=' + pm.response.text());",
              "pm.test('SETUP-1 - finca creada (201)', function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) { pm.collectionVariables.set('id_finca_creada_g37', pm.response.json().id_finca); }",
              ""
            ]
          }
        }
      ]
    },
