              "pm.test('TC-065b - se puede consultar el activo (200)', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "    pm.test('TC-065b - el activo quedo en estado EN_TRATAMIENTO (sincronizado por el trigger)', function () {",
              "        pm.expect(pm.response.json().nombre_estado).to.eql('EN_TRATAMIENTO');",
              "    });",
              "}",
              ""
            ]
          }
        }
      ]
