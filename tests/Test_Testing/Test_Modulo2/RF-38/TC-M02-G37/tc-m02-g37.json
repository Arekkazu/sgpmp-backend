    {
      "name": "TC-065a. Cambiar estado del activo de ACTIVO a EN_TRATAMIENTO (PATCH /estado, RF-44)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token_admin}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/activos-biologicos/{{id_activo_g37}}/estado",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "activos-biologicos",
            "{{id_activo_g37}}",
            "estado"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"estado_nuevo\": \"EN_TRATAMIENTO\",\n  \"fecha_cambio_estado\": \"{{fecha_hoy_g37}}\",\n  \"motivo_cambio\": \"Ingreso a tratamiento veterinario - QA G37\"\n}"
        }
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "var hoy = new Date().toISOString().slice(0,10);",
              "pm.collectionVariables.set('fecha_hoy_g37', hoy);",
              ""
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "console.log('TC-065a cambio de estado: ' + pm.response.code + ' body=' + pm.response.text());",
              "pm.test('TC-065a - el cambio de estado responde 200', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "    var b = pm.response.json();",
              "    pm.test('TC-065a - estado_anterior es ACTIVO (1)', function () { pm.expect(b.estado_anterior).to.eql(1); });",
              "    pm.test('TC-065a - estado_nuevo es EN_TRATAMIENTO (3)', function () { pm.expect(b.estado_nuevo).to.eql(3); });",
              "    pm.test('TC-065a - el historial registra modulo_origen=\\'modulo2\\' (valor fijo de esquema, ver nota tecnica)', function () {",
              "        pm.expect(b.historial.modulo_origen).to.eql('modulo2');",
              "    });",
              "}",
              ""
            ]
          }
        }
      ]
    },
