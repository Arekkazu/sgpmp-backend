{
  "info": {
    "name": "TC-M02-G34 - Validacion de fechas, secuencia y solapamiento en cambios de fase",
    "description": "CU02 - Gestion de Fases del Ciclo Productivo - RF-37. Agrupa TC-M02-040 (fecha invalida), TC-M02-041 (salto sin confirmacion), TC-M02-043 (solapamiento) y TC-M02-044 (activo CERRADO). INC-M02-37-01 (crash de cambiar_fase) ya esta resuelto, asi que los 4 sub-casos ahora llegan a probar su logica de negocio real. Las assertions codifican el comportamiento QUE EXIGE el RF, no el observado; ver README.md/NOTA_BLOQUEO.md para el detalle de que gaps siguen vigentes hoy. Reevaluado 2026-09-26: fase_destino_id es el id de la fase dentro del ciclo (id_ciclos_productivo_biologico), no el numero de paso: en TEST el ciclo 2 tiene las fases 4 (paso 1), 5 (paso 2) y 6 (paso 3), por eso id_fase_destino=6.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "https://sigab-backendtest-389pcb-a48238-158-69-200-27.sslip.io/api-sgpmp-test" },
    { "key": "correo_admin", "value": "admin.test@sgpmp.com.co" },
    { "key": "contrasena_admin", "value": "Administrador123#" },
    { "key": "token_admin", "value": "" },
    { "key": "id_especie", "value": "2" },
    { "key": "id_infraestructura", "value": "6" },
    { "key": "id_ciclo_productiva", "value": "2" },
    { "key": "id_fase_destino", "value": "6" },
    { "key": "id_activo_040", "value": "" },
    { "key": "id_activo_041", "value": "" },
    { "key": "id_activo_043", "value": "" },
    { "key": "id_activo_044", "value": "" }
  ],
  "item": [
    {
      "name": "0A. Login admin.test",
      "request": {
        "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/sesiones/",
        "body": { "mode": "raw", "raw": "{\n  \"correo_electronico\": \"{{correo_admin}}\",\n  \"contrasena\": \"{{contrasena_admin}}\"\n}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Login exitoso (200)', function () { pm.response.to.have.status(200); });",
        "if (pm.response.code === 200) { pm.collectionVariables.set('token_admin', pm.response.json().token); }"
      ] } }]
    },
    {
      "name": "1a. TC-M02-040 - Setup: crear activo propio",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token_admin}}" }],
        "url": "{{base_url}}/activos-biologicos",
        "body": { "mode": "raw", "raw": "{\n  \"tipo_activo\": \"INDIVIDUAL\",\n  \"id_especie\": {{id_especie}},\n  \"fecha_inicio_ciclo\": \"{{fecha_hoy}}\",\n  \"origen_financiero\": \"nacimiento\",\n  \"id_infraestructura\": {{id_infraestructura}},\n  \"identificador\": \"{{identificador_040}}\",\n  \"raza\": \"Trucha QA-G34-040\",\n  \"sexo\": \"Macho\",\n  \"fecha_nacimiento\": \"2025-01-15T00:00:00Z\",\n  \"peso_inicial\": 0.25\n}" }
      },
      "event": [
        { "listen": "prerequest", "script": { "exec": [
          "pm.collectionVariables.set('identificador_040', 'G34-040-' + Date.now());",
          "pm.variables.set('fecha_hoy', new Date().toISOString().slice(0,10));"
        ] } },
        { "listen": "test", "script": { "exec": [
          "pm.test('Activo creado (201)', function () { pm.response.to.have.status(201); });",
          "if (pm.response.code === 201) { pm.collectionVariables.set('id_activo_040', pm.response.json().id_activo_biologico); }"
        ] } }
      ]
    },
    {
      "name": "1b. TC-M02-040 - Rechazar fecha de cambio de fase invalida (futura)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token_admin}}" }],
        "url": "{{base_url}}/activos-biologicos/{{id_activo_040}}/fases",
        "body": { "mode": "raw", "raw": "{\n  \"id_ciclo_productiva\": {{id_ciclo_productiva}},\n  \"motivo_cambio\": \"QA-G34 fecha futura\",\n  \"fecha_inicio\": \"2027-01-01T00:00:00Z\"\n}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "console.log('[TC-M02-040] status=' + pm.response.code + ' body=' + pm.response.text());",
        "pm.test('RF-37: fecha futura debe rechazarse (400)', function () { pm.response.to.have.status(400); });"
      ] } }]
    },
