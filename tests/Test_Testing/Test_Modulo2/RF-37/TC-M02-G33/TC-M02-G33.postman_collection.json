{
  "info": {
    "name": "TC-M02-G33 - Transiciones de fase validas: secuencia estandar y no estandar con confirmacion",
    "description": "CU02 - Gestion de Fases del Ciclo Productivo - RF-37. Agrupa TC-M02-039 (cambio de fase estandar valido) y TC-M02-042 (transicion no estandar con confirmacion_no_estandar=true). Las assertions codifican el comportamiento QUE EXIGE el RF, no el observado. Ambos sub-casos estan bloqueados por el mismo defecto (INC-M02-37-01, ver NOTA_BLOQUEO.md); TC-M02-042 tiene ademas un gap estructural independiente (el DTO no declara confirmacion_no_estandar ni fase_destino_id).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "https://sigab-backendtest-389pcb-a48238-158-69-200-27.sslip.io/api-sgpmp-test" },
    { "key": "correo_admin", "value": "admin.test@sgpmp.com.co" },
    { "key": "contrasena_admin", "value": "Administrador123#" },
    { "key": "token_admin", "value": "" },
    { "key": "id_especie", "value": "2" },
    { "key": "id_infraestructura", "value": "1" },
    { "key": "identificador_activo", "value": "" },
    { "key": "id_activo", "value": "" },
    { "key": "id_ciclo_productiva", "value": "2" }
  ],
  "item": [
    {
      "name": "0A. Login admin.test",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/sesiones/",
        "body": { "mode": "raw", "raw": "{\n  \"correo_electronico\": \"{{correo_admin}}\",\n  \"contrasena\": \"{{contrasena_admin}}\"\n}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Login exitoso (200)', function () { pm.response.to.have.status(200); });",
        "if (pm.response.code === 200) { pm.collectionVariables.set('token_admin', pm.response.json().token); }"
      ] } }]
    },
    {
      "name": "0B. Setup - Registrar activo INDIVIDUAL de prueba (especie 2, Trucha - misma que el ciclo productivo 2)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_admin}}" }
        ],
        "url": "{{base_url}}/activos-biologicos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tipo_activo\": \"INDIVIDUAL\",\n  \"id_especie\": {{id_especie}},\n  \"fecha_inicio_ciclo\": \"{{fecha_hoy}}\",\n  \"origen_financiero\": \"nacimiento\",\n  \"id_infraestructura\": {{id_infraestructura}},\n  \"identificador\": \"{{identificador_activo}}\",\n  \"raza\": \"Trucha QA-G33\",\n  \"sexo\": \"Hembra\",\n  \"fecha_nacimiento\": \"2025-01-15T00:00:00Z\",\n  \"peso_inicial\": 0.25\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": { "exec": [
            "pm.collectionVariables.set('identificador_activo', 'G33-' + Date.now());",
            "pm.variables.set('fecha_hoy', new Date().toISOString().slice(0,10));"
          ] }
        },
        { "listen": "test", "script": { "exec": [
          "console.log('[SETUP] status=' + pm.response.code + ' body=' + pm.response.text());",
          "pm.test('Se crea el activo INDIVIDUAL de prueba (201)', function () { pm.response.to.have.status(201); });",
          "if (pm.response.code === 201) { pm.collectionVariables.set('id_activo', pm.response.json().id_activo_biologico); }"
        ] } }
      ]
    },
    {
      "name": "1. TC-M02-039 - Registrar cambio de fase estandar valido",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_admin}}" }
        ],
        "url": "{{base_url}}/activos-biologicos/{{id_activo}}/fases",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_ciclo_productiva\": {{id_ciclo_productiva}},\n  \"motivo_cambio\": \"Inicio de ciclo estandar - QA-G33\"\n}"
        }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "console.log('[TC-M02-039] status=' + pm.response.code + ' body=' + pm.response.text());",
        "pm.test('RF-37: la transicion estandar se registra (201)', function () { pm.response.to.have.status(201); });",
        "if (pm.response.code === 201) {",
        "  const body = pm.response.json();",
        "  pm.test('Queda como fase activa, paso 1 de N', function () {",
        "    pm.expect(body.es_activa).to.eql(true);",
        "    pm.expect(body.paso_actual).to.eql(1);",
        "    pm.expect(body.fecha_finalizacion).to.be.null;",
        "  });",
        "}"
      ] } }]
    },
    {
      "name": "2. TC-M02-039 - Verificar historial de fases (GET)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
        "url": "{{base_url}}/activos-biologicos/{{id_activo}}/fases"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "console.log('[HISTORIAL FASES] status=' + pm.response.code + ' body=' + pm.response.text());",
        "pm.test('El historial de fases responde 200', function () { pm.response.to.have.status(200); });",
        "const body = pm.response.json();",
        "pm.test('El historial refleja la fase creada en el paso anterior', function () {",
        "  pm.expect(body.fases).to.be.an('array');",
        "  pm.expect(body.fases.length).to.be.greaterThan(0);",
        "});"
      ] } }]
    },
    {
      "name": "3. TC-M02-042 - Aceptar transicion NO estandar con confirmacion_no_estandar=true",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_admin}}" }
        ],
        "url": "{{base_url}}/activos-biologicos/{{id_activo}}/fases",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_ciclo_productiva\": {{id_ciclo_productiva}},\n  \"motivo_cambio\": \"Salto no estandar - QA-G33\",\n  \"confirmacion_no_estandar\": true,\n  \"fase_destino_id\": 9999\n}"
        }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "console.log('[TC-M02-042] status=' + pm.response.code + ' body=' + pm.response.text());",
        "pm.test('RF-37: la transicion no estandar confirmada se acepta (201)', function () { pm.response.to.have.status(201); });",
        "if (pm.response.code === 201) {",
        "  const body = pm.response.json();",
        "  pm.test('El historial deja evidencia de que fue una confirmacion no estandar', function () {",
        "    pm.expect(JSON.stringify(body).toLowerCase()).to.match(/no.?estandar|confirmacion/);",
        "  });",
        "}"
      ] } }]
    }
  ]
}
