    {
      "name": "Sub-caso 1 (TC-M02-171) - Contador consulta bitacora filtrada por activo y clasificacion",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "console.log('--- Sub-caso 1: rol Contador, filtro id_activo_biologico + clasificacion_biologica=TRANSFORMACION_BIOLOGICA ---');",
              "console.log(pm.response.text());",
              "pm.test('Sub-caso 1: la consulta responde HTTP 200 (Contador SI tiene permiso de lectura sobre el recurso bitacora, aunque no tenga permisos sobre activos_biologicos)', function () { pm.response.to.have.status(200); });",
              "let respuesta; try { respuesta = pm.response.json(); } catch (e) { respuesta = null; }",
              "pm.test('Sub-caso 1: se retornan EXACTAMENTE los 2 eventos reproductivos (nunca el de la baja)', function () {",
              "    pm.expect(respuesta).to.not.equal(null);",
              "    pm.expect(respuesta.registros.length).to.equal(2);",
              "    respuesta.registros.forEach(function (r) {",
              "        pm.expect(r.clasificacion_biologica).to.equal('TRANSFORMACION_BIOLOGICA');",
              "        pm.expect(r.rf_origen).to.equal('RF42');",
              "    });",
              "});",
              "pm.test('Sub-caso 1: cada registro trae usuario y modulo responsable', function () {",
              "    respuesta.registros.forEach(function (r) {",
              "        pm.expect(r.id_usuario_responsable).to.not.equal(null);",
              "        pm.expect(r.modulo_consumidor).to.equal('modulo2');",
              "    });",
              "});",
              "pm.test('Sub-caso 1: los registros vienen en orden cronologico (timestamp_evento ascendente o descendente consistente)', function () {",
              "    const t0 = new Date(respuesta.registros[0].timestamp_evento).getTime();",
              "    const t1 = new Date(respuesta.registros[1].timestamp_evento).getTime();",
              "    pm.expect(t0).to.not.equal(t1);",
              "    console.log('Orden devuelto: ' + respuesta.registros.map(r => r.timestamp_evento).join(' , '));",
              "});"
            ]
          }
        }
