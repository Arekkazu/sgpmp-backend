    {
      "name": "172, paso 2 - Productor consulta ACCESO_DATOS de un activo ajeno (403 esperado)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "console.log(pm.response.text().slice(0,600));",
              "let r; try { r = pm.response.json(); } catch(e) { r = null; }",
              "pm.test('rechazado con HTTP 403', function(){ pm.response.to.have.status(403); });",
              "pm.test('error_code ALCANCE_BITACORA_DENEGADO', function(){ pm.expect(r.error_code).to.equal('ALCANCE_BITACORA_DENEGADO'); });"
            ]
          }
        }
      ],
