    {
      "name": "172, paso 3 - El intento quedo registrado como ACCESO_NO_AUTORIZADO",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "console.log(pm.response.text().slice(0,600));",
              "let r; try { r = pm.response.json(); } catch(e) { r = null; }",
              "pm.test('consulta 200', function(){ pm.response.to.have.status(200); });",
              "pm.test('el conteo de ACCESO_NO_AUTORIZADO aumento', function(){ pm.expect(r.total_registros).to.be.above(parseInt(pm.collectionVariables.get('total_antes'),10)); });",
              "pm.test('el registro nuevo documenta rol Productor y clasificacion ACCESO_DATOS', function(){ const d = r.registros[0].detalle_tecnico; pm.expect(d.rol).to.equal('Productor'); pm.expect(d.clasificacion_solicitada).to.equal('ACCESO_DATOS'); pm.expect(r.registros[0].resultado).to.equal('RECHAZADO'); });"
            ]
          }
        }
