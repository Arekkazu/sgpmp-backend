    {
      "name": "173, paso 2 - RF-63 (GET /iot/auditoria) expone la correlacion de vuelta",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "console.log(pm.response.text().slice(0,600));",
              "let r; try { r = pm.response.json(); } catch(e) { r = null; }",
              "pm.test('consulta 200', function(){ pm.response.to.have.status(200); });",
              "pm.test('DEFECTO: los registros de RF-63 exponen un campo de correlacion', function(){ const campos = new Set(); r.items.forEach(function(i){ Object.keys(i).forEach(function(k){ campos.add(k); }); }); pm.expect(Array.from(campos).some(function(c){ return c.indexOf('correl') >= 0; }), 'campos RF-63: ' + Array.from(campos).join(',')).to.equal(true); });"
            ]
          }
        }
      ],
