    {
      "name": "173, paso 1 - Registros ASOCIACION_IOT_CREADA de RF-52 (generados por RF-49)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "console.log(pm.response.text().slice(0,600));",
              "let r; try { r = pm.response.json(); } catch(e) { r = null; }",
              "pm.test('consulta 200 y hay registros', function(){ pm.response.to.have.status(200); pm.expect(r.registros.length).to.be.above(0); });",
              "pm.test('DEFECTO: todos llevan id_evento_correlacionado (enlace a RF-63)', function(){ const sin = r.registros.filter(function(x){ return !x.id_evento_correlacionado; }).length; pm.expect(sin, sin + ' de ' + r.registros.length + ' registros con id_evento_correlacionado nulo').to.equal(0); });"
            ]
          }
        }
      ],
