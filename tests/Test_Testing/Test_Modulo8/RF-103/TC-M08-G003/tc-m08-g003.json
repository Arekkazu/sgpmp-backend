        {
          "name": "TC-M08-005 - Productor widget semaforo_areas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json() || {}; const datos = d.datos || {};",
                  "console.log(JSON.stringify(d).slice(0, 1500));",
                  "pm.test('TC-M08-005 - semaforo_areas responde 200 con estado OK o SIN_DATOS (no ERROR)', () => { pm.response.to.have.status(200); pm.expect(d.estado).to.be.oneOf(['OK', 'SIN_DATOS']); });",
                  "pm.test('TC-M08-005 - semaforo_areas trae la hora de su última actualización', () => pm.expect(Date.parse(d.actualizado_en)).to.be.a('number').and.not.NaN);",
                  "const sev = a => JSON.parse(pm.collectionVariables.get('alertas_' + a) || '[]');",
                  "const a1 = (datos.areas || []).find(a => a.id_infraestructura === 1468) || {}, a2 = (datos.areas || []).find(a => a.id_infraestructura === 1494) || {}, a3 = (datos.areas || []).find(a => a.id_infraestructura === 1495) || {};",
                  "console.log(JSON.stringify([a1, a2, a3]));",
                  "pm.test('TC-M08-005 - área 1468 con alerta CRÍTICA activa → ROJO', () => { pm.expect(sev(1468)).to.include('CRITICO'); pm.expect(a1.estado).to.equal('ROJO'); });",
                  "pm.test('TC-M08-005 - área 1494 solo con alertas moderadas → AMARILLO', () => { pm.expect(sev(1494)).to.not.include('CRITICO'); pm.expect(sev(1494).length).to.be.above(0); pm.expect(a2.estado).to.equal('AMARILLO'); });",
                  "pm.test('TC-M08-005 - los conteos del semáforo coinciden con /iot/alertas (críticas y advertencias)', () => { pm.expect(a1.criticas).to.equal(sev(1468).filter(s => s === 'CRITICO').length); pm.expect(a2.advertencias).to.equal(sev(1494).filter(s => s !== 'CRITICO').length); });",
                  "pm.test('TC-M08-005 - área 1495 sin alertas: no pinta ROJO ni AMARILLO', () => { pm.expect(sev(1495)).to.eql([]); pm.expect(a3.estado).to.be.oneOf(['VERDE', 'SIN_DATOS']); });",
                  "const caidos = JSON.parse(pm.collectionVariables.get('disp_1495') || '[]');",
                  "pm.test('TC-M08-005 - área 1495: VERDE, o «datos no disponibles» (SIN_DATOS) solo si todos sus dispositivos están caídos (R5)', () => { if (a3.estado === 'SIN_DATOS') caidos.forEach(e => pm.expect(e).to.be.oneOf(['SIN_SEÑAL', 'EN_MANTENIMIENTO', 'INACTIVO'])); else pm.expect(a3.estado).to.equal('VERDE'); });",
                  "if (a3.estado === 'SIN_DATOS') console.warn('DATO: los dispositivos del área 1495 están caídos (' + caidos.join(', ') + '); para ver VERDE hay que refrescar un heartbeat.');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
