{
  "info": {
    "name": "TC-M08-G017 Trazabilidad de las notificaciones (RF-105)",
    "description": "TC-M08-023. Consultas de solo lectura dentro del run con la identidad del Administrador (dueño de las filas).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Sandbox transaccional de TEST (DBA): toda la corrida va en una transaccion que NUNCA se confirma y el",
          "// ultimo paso la revierte (DELETE /test-control/runs/{run_id}). El secreto no se guarda en este archivo.",
          "const secreto = pm.variables.get('sandbox_secret');",
          "if (pm.request.headers.has('X-Fuera-Sandbox')) {",
          "  pm.request.headers.remove('X-Fuera-Sandbox');  // TC-001: solo login y lecturas, fuera del sandbox",
          "} else if (!secreto) {",
          "  console.error('Falta sandbox_secret: peticion desviada, no se envia a TEST.');",
          "  pm.request.url.update('http://127.0.0.1:9/falta-sandbox_secret');",
          "} else {",
          "  if (!pm.collectionVariables.get('run_id')) { pm.collectionVariables.set('run_id', 'test-' + pm.variables.replaceIn('{{$guid}}')); }",
          "  pm.request.headers.upsert({ key: 'X-Test-Run-Id', value: pm.collectionVariables.get('run_id') });",
          "  pm.request.headers.upsert({ key: 'X-Sandbox-Secret', value: secreto });",
          "}",
          "pm.request.headers.upsert({ key: 'X-Zona-Horaria', value: 'America/Bogota' });",
          "// Si el login de ese rol fallo, la peticion no se envia (el fallo queda en el test del login).",
          "const auth = (pm.request.headers.get('Authorization') || '').match(/\\{\\{(tok_\\w+)\\}\\}/);",
          "if (auth && !pm.collectionVariables.get(auth[1])) { console.warn('Sin ' + auth[1] + ': se omite ' + pm.info.requestName); pm.execution.skipRequest(); }"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "https://api.inmero.co/api-sgpmp-test"
    },
    {
      "key": "id_finca",
      "value": "494"
    },
    {
      "key": "id_finca_ajena",
      "value": "495"
    },
    {
      "key": "run_id",
      "value": ""
    },
    {
      "key": "catalogo",
      "value": ""
    },
    {
      "key": "patch_body",
      "value": ""
    },
    {
      "key": "tok_admin",
      "value": ""
    },
    {
      "key": "tok_prod",
      "value": ""
    },
    {
      "key": "tok_prod_real",
      "value": ""
    },
    {
      "key": "tok_admin_real",
      "value": ""
    },
    {
      "key": "tok_vet",
      "value": ""
    },
    {
      "key": "tok_cont",
      "value": ""
    },
    {
      "key": "tok_ing",
      "value": ""
    },
    {
      "key": "tok_gestor",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Precondiciones (logins dentro del sandbox)",
      "item": [
        {
          "name": "PRE - Login Administrador",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('PRE - Login Administrador (200)', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('tok_admin', '');",
                  "if (pm.response.code === 200) { const t = pm.response.json().token; pm.collectionVariables.set('tok_admin', t); pm.collectionVariables.set('id_admin', JSON.parse(atob(t.split('.')[1].replace(/-/g, '+').replace(/_/g, '/'))).sub); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/sesiones/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo_electronico\": \"{{correo_admin}}\",\n  \"contrasena\": \"{{contrasena_admin}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "1. TC-M08-023 Trazabilidad de una notificación hasta su evento, canal y estado",
      "item": [
        {
          "name": "TC-M08-023 - Administrador GET una alerta sin leer de su bandeja",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json() || {}; const it = b.items || [];",
                  "console.log(JSON.stringify({ total: b.total, no_leidas: b.no_leidas, criticas_pendientes: b.criticas_pendientes, pagina: b.pagina, tamano: b.tamano, n: it.length }));",
                  "pm.test('TC-M08-023 - hay una alerta sin leer', () => pm.expect(it.length).to.equal(1));",
                  "pm.collectionVariables.set('id_n', String(it[0].id_notificacion)); pm.collectionVariables.set('id_evento', String(it[0].id_evento));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tok_admin}}"
              }
            ],
            "url": "{{base_url}}/notificaciones?nivel=CRITICA&estado=NUEVA&tamano=1"
          }
        },
        {
          "name": "TC-M08-023 - SQL notificaciones del evento (antes)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.variables.get('sandbox_secret') && pm.collectionVariables.get('run_id')) {",
                  "  pm.sendRequest({ url: pm.variables.replaceIn('{{base_url}}/sesiones/'), method: 'POST',",
                  "    header: [{ key: 'Content-Type', value: 'application/json' },",
                  "             { key: 'X-Test-Run-Id', value: pm.collectionVariables.get('run_id') },",
                  "             { key: 'X-Sandbox-Secret', value: pm.variables.get('sandbox_secret') }],",
                  "    body: { mode: 'raw', raw: JSON.stringify({ correo_electronico: pm.variables.get('correo_admin'),",
                  "                                               contrasena: pm.variables.get('contrasena_admin') }) } },",
                  "    (e, r) => { if (e || !r || r.code !== 200) { console.warn('Identidad para la consulta: login fallo'); return; }",
                  "      pm.collectionVariables.set('tok_admin', r.json().token); });",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('TC-M08-023 - consulta respondida (200)', () => pm.response.to.have.status(200));",
                  "const filas = (pm.response.json() || {}).data || []; console.log(JSON.stringify(filas));",
                  "const mia = filas.filter(f => String(f.id_notificacion) === pm.collectionVariables.get('id_n'));",
                  "pm.test('TC-M08-023 - la notificación apunta a su evento de origen, con usuario y módulo', () => { pm.expect(mia.length).to.equal(1); pm.expect(mia[0].id_evento).to.be.a('number'); pm.expect(mia[0].modulo).to.be.a('string').and.not.empty; pm.expect(mia[0].id_usuario).to.be.a('number'); });",
                  "pm.test('TC-M08-023 - cada envío por correo o push tiene su registro en la bandeja (canal 2) del mismo usuario', () => filas.filter(f => f.canal !== 2).forEach(f => pm.expect(filas.some(g => g.canal === 2 && g.id_usuario === f.id_usuario), 'notificación ' + f.id_notificacion).to.be.true));",
                  "pm.test('TC-M08-023 - el estado de envío es en_cola, enviado o fallido', () => filas.forEach(f => pm.expect(f.estado_envio).to.be.oneOf(['en_cola', 'enviado', 'fallido'])));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/test-control/query",
            "body": {
              "mode": "raw",
              "raw": "{\"query\": \"SELECT n.id_notificacion, n.id_notificacion_canal AS canal, n.estado_envio::text AS estado_envio, n.estado, n.es_leido, n.fecha_envio, n.fecha_lectura, n.id_usuario, e.id_evento, e.tipo_evento, e.modulo, e.id_usuario AS usuario_evento FROM modulo1.notificaciones n JOIN modulo1.eventos e ON e.id_evento = n.id_evento WHERE n.id_evento = {{id_evento}} ORDER BY n.id_notificacion\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "TC-M08-023 - Administrador marca la notificación como leída",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "console.log(pm.response.text().slice(0, 600));",
                  "pm.test('TC-M08-023 - marcada como leída (200)', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tok_admin}}"
              }
            ],
            "url": "{{base_url}}/notificaciones/{{id_n}}/leida"
          }
        },
        {
          "name": "TC-M08-023 - SQL la notificación después de leerla",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.variables.get('sandbox_secret') && pm.collectionVariables.get('run_id')) {",
                  "  pm.sendRequest({ url: pm.variables.replaceIn('{{base_url}}/sesiones/'), method: 'POST',",
                  "    header: [{ key: 'Content-Type', value: 'application/json' },",
                  "             { key: 'X-Test-Run-Id', value: pm.collectionVariables.get('run_id') },",
                  "             { key: 'X-Sandbox-Secret', value: pm.variables.get('sandbox_secret') }],",
                  "    body: { mode: 'raw', raw: JSON.stringify({ correo_electronico: pm.variables.get('correo_admin'),",
                  "                                               contrasena: pm.variables.get('contrasena_admin') }) } },",
                  "    (e, r) => { if (e || !r || r.code !== 200) { console.warn('Identidad para la consulta: login fallo'); return; }",
                  "      pm.collectionVariables.set('tok_admin', r.json().token); });",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('TC-M08-023 - consulta respondida (200)', () => pm.response.to.have.status(200));",
                  "const filas = (pm.response.json() || {}).data || []; console.log(JSON.stringify(filas));",
                  "const mia = filas.find(f => String(f.id_notificacion) === pm.collectionVariables.get('id_n')) || {};",
                  "pm.test('TC-M08-023 - queda LEIDA con su fecha de lectura', () => { pm.expect(mia.estado).to.equal('LEIDA'); pm.expect(mia.fecha_lectura).to.not.be.null; });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/test-control/query",
            "body": {
              "mode": "raw",
              "raw": "{\"query\": \"SELECT n.id_notificacion, n.id_notificacion_canal AS canal, n.estado_envio::text AS estado_envio, n.estado, n.es_leido, n.fecha_envio, n.fecha_lectura, n.id_usuario, e.id_evento, e.tipo_evento, e.modulo, e.id_usuario AS usuario_evento FROM modulo1.notificaciones n JOIN modulo1.eventos e ON e.id_evento = n.id_evento WHERE n.id_evento = {{id_evento}} ORDER BY n.id_notificacion\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "TC-M08-023 - SQL evento de auditoría del cambio a leída (tipo 46)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.variables.get('sandbox_secret') && pm.collectionVariables.get('run_id')) {",
                  "  pm.sendRequest({ url: pm.variables.replaceIn('{{base_url}}/sesiones/'), method: 'POST',",
                  "    header: [{ key: 'Content-Type', value: 'application/json' },",
                  "             { key: 'X-Test-Run-Id', value: pm.collectionVariables.get('run_id') },",
                  "             { key: 'X-Sandbox-Secret', value: pm.variables.get('sandbox_secret') }],",
                  "    body: { mode: 'raw', raw: JSON.stringify({ correo_electronico: pm.variables.get('correo_admin'),",
                  "                                               contrasena: pm.variables.get('contrasena_admin') }) } },",
                  "    (e, r) => { if (e || !r || r.code !== 200) { console.warn('Identidad para la consulta: login fallo'); return; }",
                  "      pm.collectionVariables.set('tok_admin', r.json().token); });",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('TC-M08-023 - consulta respondida (200)', () => pm.response.to.have.status(200));",
                  "const filas = (pm.response.json() || {}).data || []; console.log(JSON.stringify(filas));",
                  "pm.test('TC-M08-023 - el cambio a leída deja su propio registro con fecha (evento 46)', () => { pm.expect(filas.length).to.be.at.least(1); pm.expect(filas[0].detalle.accion).to.equal('LEIDA'); pm.expect(filas[0].fecha_evento).to.be.a('string'); });",
                  "pm.test('TC-M08-023 - el registro tiene hash de integridad', () => pm.expect(filas[0] && filas[0].hash_integridad).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/test-control/query",
            "body": {
              "mode": "raw",
              "raw": "{\"query\": \"SELECT id_evento, tipo_evento, modulo, fecha_evento, detalle, hash_integridad FROM modulo1.eventos WHERE tipo_evento = 46 AND detalle->>'id_notificacion' = '{{id_n}}' ORDER BY id_evento DESC\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "9. Rollback del sandbox (la BD queda como estaba)",
      "item": [
        {
          "name": "ROLLBACK - Revertir la transacción de la corrida",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ROLLBACK - sandbox revertido (200)', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.unset('run_id');"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{base_url}}/test-control/runs/{{run_id}}"
          }
        }
      ]
    }
  ]
}