{
  "info": {
    "name": "TC-M08-G015 Canales, destinatarios y duplicados (RF-105)",
    "description": "TC-M08-018, 019 y 024. Bloqueados por el token del broker, push, correo y logs; solo la preparación posible. Sandbox.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Sandbox transaccional de TEST (DBA): toda la corrida va en una transaccion que NUNCA se confirma y el",
          "// ultimo paso la revierte (DELETE /test-control/runs/{run_id}). El secreto no se guarda en este archivo.",
          "const secreto = pm.variables.get('sandbox_secret');",
          "if (pm.request.headers.has('X-Fuera-Sandbox')) {",
          "  pm.request.headers.remove('X-Fuera-Sandbox');  // TC-001: solo login y lecturas, fuera del sandbox",
          "} else if (!secreto) {",
          "  console.error('Falta sandbox_secret: peticion desviada, no se envia a TEST.');",
          "  pm.request.url.update('http://127.0.0.1:9/falta-sandbox_secret');",
          "} else {",
          "  if (!pm.collectionVariables.get('run_id')) { pm.collectionVariables.set('run_id', 'test-' + pm.variables.replaceIn('{{$guid}}')); }",
          "  pm.request.headers.upsert({ key: 'X-Test-Run-Id', value: pm.collectionVariables.get('run_id') });",
          "  pm.request.headers.upsert({ key: 'X-Sandbox-Secret', value: secreto });",
          "}",
          "pm.request.headers.upsert({ key: 'X-Zona-Horaria', value: 'America/Bogota' });",
          "// Si el login de ese rol fallo, la peticion no se envia (el fallo queda en el test del login).",
          "const auth = (pm.request.headers.get('Authorization') || '').match(/\\{\\{(tok_\\w+)\\}\\}/);",
          "if (auth && !pm.collectionVariables.get(auth[1])) { console.warn('Sin ' + auth[1] + ': se omite ' + pm.info.requestName); pm.execution.skipRequest(); }"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "https://api.inmero.co/api-sgpmp-test"
    },
    {
      "key": "id_finca",
      "value": "494"
    },
    {
      "key": "id_finca_ajena",
      "value": "495"
    },
    {
      "key": "run_id",
      "value": ""
    },
    {
      "key": "catalogo",
      "value": ""
    },
    {
      "key": "patch_body",
      "value": ""
    },
    {
      "key": "tok_admin",
      "value": ""
    },
    {
      "key": "tok_prod",
      "value": ""
    },
    {
      "key": "tok_prod_real",
      "value": ""
    },
    {
      "key": "tok_admin_real",
      "value": ""
    },
    {
      "key": "tok_vet",
      "value": ""
    },
    {
      "key": "tok_cont",
      "value": ""
    },
    {
      "key": "tok_ing",
      "value": ""
    },
    {
      "key": "tok_gestor",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Precondiciones (logins dentro del sandbox)",
      "item": [
        {
          "name": "PRE - Login Administrador",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('PRE - Login Administrador (200)', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('tok_admin', '');",
                  "if (pm.response.code === 200) { const t = pm.response.json().token; pm.collectionVariables.set('tok_admin', t); pm.collectionVariables.set('id_admin', JSON.parse(atob(t.split('.')[1].replace(/-/g, '+').replace(/_/g, '/'))).sub); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/sesiones/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo_electronico\": \"{{correo_admin}}\",\n  \"contrasena\": \"{{contrasena_admin}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "PRE - Login Productor",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('PRE - Login Productor (200)', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('tok_prod', '');",
                  "if (pm.response.code === 200) { const t = pm.response.json().token; pm.collectionVariables.set('tok_prod', t); pm.collectionVariables.set('id_productor', JSON.parse(atob(t.split('.')[1].replace(/-/g, '+').replace(/_/g, '/'))).sub); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/sesiones/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo_electronico\": \"{{correo_productor}}\",\n  \"contrasena\": \"{{contrasena_productor}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "1. TC-M08-018/019 Generar la alerta crítica (necesita el token del broker)",
      "item": [
        {
          "name": "TC-M08-018 - POST /iot/telemetria sin el token del broker",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('TC-M08-018 - la ingesta exige el token de servicio del broker (401/403): sin él no se puede generar la alerta', () => pm.expect(pm.response.code).to.be.oneOf([401, 403]));",
                  "console.warn('BLOQUEADO: TC-018, 019 y 024 necesitan el token del broker de TEST, push activado en el navegador, un buzón real y los logs del backend.');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/iot/telemetria",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serial\": \"QA-M08-SENSOR-02\",\n  \"lecturas\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "2. TC-M08-024 Token de push inválido (preparación)",
      "item": [
        {
          "name": "TC-M08-024 - Productor registra un token de push inválido",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "console.log(pm.response.text().slice(0, 400));",
                  "pm.test('TC-M08-024 - el token se registra sin error para el usuario (200/201/204)', () => pm.expect(pm.response.code).to.be.oneOf([200, 201, 204]));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tok_prod}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/usuarios/me/fcm-token",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"token-invalido-qa\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "9. Rollback del sandbox (la BD queda como estaba)",
      "item": [
        {
          "name": "ROLLBACK - Revertir la transacción de la corrida",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ROLLBACK - sandbox revertido (200)', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.unset('run_id');"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{base_url}}/test-control/runs/{{run_id}}"
          }
        }
      ]
    }
  ]
}