              "const san = ev.filter(e => e.sanitario);",
              "s('A_EVENTOS_M02', 'HTTP ' + pm.response.code + ' total=' + b.total + ' sanitarios=' + san.length +",
              "  ' detalle=' + JSON.stringify(san.slice(0, 10).map(e => e.id_eventos + '@' + e.fecha)));"
            ]
          }
