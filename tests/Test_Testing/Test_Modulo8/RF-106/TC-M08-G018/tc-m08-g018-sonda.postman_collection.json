      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const rid = pm.response.headers.get('X-Request-Id') || '-';",
              "let b = {}; try { b = pm.response.json(); } catch (e) { b = {}; }",
              "const ec = (b && b.error_code) ? b.error_code : '-';",
              "function s(clave, texto) { console.log('SONDA|' + clave + '|' + texto + '|req=' + rid); }",
              "const PROHIBIDOS = [930, 900, 901, 825];",
              "const VIGENTES = ['ACTIVO', 'EN_TRATAMIENTO'];",
              "s('PERFIL_VET', 'HTTP ' + pm.response.code + ' id_usuario=' + b.id_usuario + ' nombre_rol=' + b.nombre_rol);",
              "if (pm.response.code !== 200 || b.nombre_rol !== 'Veterinario') { console.log('ABORT|S01|rol=' + (b.nombre_rol || '-') + '|req=' + rid); postman.setNextRequest('S99 Cierre del sandbox'); }"
            ]
          }
        }
      ]
    },
    {
      "name": "S02 Fincas del Veterinario",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token_vet}}"
          }
        ],
        "url": "{{base_url}}/reportes/opciones/finca"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const rid = pm.response.headers.get('X-Request-Id') || '-';",
              "let b = {}; try { b = pm.response.json(); } catch (e) { b = {}; }",
              "const ec = (b && b.error_code) ? b.error_code : '-';",
              "function s(clave, texto) { console.log('SONDA|' + clave + '|' + texto + '|req=' + rid); }",
              "const PROHIBIDOS = [930, 900, 901, 825];",
              "const VIGENTES = ['ACTIVO', 'EN_TRATAMIENTO'];",
              "const fincas = Array.isArray(b) ? b.map(x => Number(x.valor)) : [];",
              "pm.collectionVariables.set('fincas_vet', JSON.stringify(fincas));",
              "s('FINCAS_VET', 'HTTP ' + pm.response.code + ' fincas=' + JSON.stringify(Array.isArray(b) ? b.map(x => x.valor + ':' + x.etiqueta) : b));",
              "if (fincas.length === 0) { console.log('ABORT|S02|el Veterinario no tiene fincas visibles|req=' + rid); postman.setNextRequest('S99 Cierre del sandbox'); }"
            ]
          }
        }
      ]
    },
