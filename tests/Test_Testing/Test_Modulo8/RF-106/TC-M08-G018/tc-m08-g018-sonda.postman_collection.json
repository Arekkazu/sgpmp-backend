              "s('A_HISTORIAL_RF67', 'HTTP ' + pm.response.code + ' error_code=' + ec + ' total_pagina=' + b.total_pagina +",
              "  ' hay_mas=' + !!b.cursor_siguiente + ' por_tipo=' + JSON.stringify(tipos));"
            ]
          }
        }
