              "  ' retroalimentaciones=' + (b.retroalimentaciones || []).length + ' pendientes=' + (b.pendientes ? b.pendientes.total : '-') +",
              "  ' estado=' + (b.activo ? b.activo.estado : '-') + ' fuentes_no_disponibles=' + JSON.stringify(b.fuentes_no_disponibles || null));"
