    {
      "name": "S00 Login Veterinario",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/sesiones/",
        "body": {
          "mode": "raw",
          "raw": "{\"correo_electronico\": \"{{correo_vet}}\", \"contrasena\": \"{{contrasena_vet}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const n = new Date(Date.now() - 5 * 3600 * 1000);",
              "const y = n.getUTCFullYear(), m = n.getUTCMonth(), d = n.getUTCDate();",
              "const f = (yy, mm, dd) => new Date(Date.UTC(yy, mm, dd)).toISOString().slice(0, 10);",
              "pm.collectionVariables.set('hoy', f(y, m, d));",
              "pm.collectionVariables.set('hace12m', f(y - 1, m, d));",
              "pm.collectionVariables.set('desde_iso', f(y - 1, m, d) + 'T05:00:00Z');",
              "pm.collectionVariables.set('idx_finca', '0');",
              "pm.collectionVariables.set('bajas', '[]');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const rid = pm.response.headers.get('X-Request-Id') || '-';",
              "let b = {}; try { b = pm.response.json(); } catch (e) { b = {}; }",
              "const ec = (b && b.error_code) ? b.error_code : '-';",
              "function s(clave, texto) { console.log('SONDA|' + clave + '|' + texto + '|req=' + rid); }",
              "const PROHIBIDOS = [930, 900, 901, 825];",
              "const VIGENTES = ['ACTIVO', 'EN_TRATAMIENTO'];",
              "if (pm.response.code === 200 && b.token) { pm.collectionVariables.set('token_vet', b.token); s('LOGIN_VET', 'HTTP 200'); }",
              "else { console.log('ABORT|S00|login Veterinario HTTP ' + pm.response.code + ' error_code=' + ec + '|req=' + rid); postman.setNextRequest('S99 Cierre del sandbox'); }"
            ]
          }
        }
      ]
    },
    {
      "name": "S01 Perfil Veterinario",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token_vet}}"
