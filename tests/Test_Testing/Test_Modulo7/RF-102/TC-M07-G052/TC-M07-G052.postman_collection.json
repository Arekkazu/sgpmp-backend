{
  "info": {
    "name": "TC-M07-G052 RF-102 Eventos de integración",
    "description": "Consulta autorizada de /integracion/auditoria y generadores seguros. No usar Contador para GET auditoría. Credenciales vía environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "https://api.inmero.co/api-sgpmp-test"},
    {"key": "admin_token", "value": ""}
  ],
  "item": [
    {
      "name": "01 Login Administrador",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200/201 login admin', function () { pm.expect([200,201]).to.include(pm.response.code); });",
              "const j = pm.response.json();",
              "if (j.token) { pm.collectionVariables.set('admin_token', j.token); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "X-Zona-Horaria", "value": "America/Bogota"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"{{QA_ADMIN_CORREO}}\",\n  \"contrasena\": \"{{QA_ADMIN_CONTRASENA}}\"\n}"
        },
        "url": "{{baseUrl}}/sesiones/"
      }
    },
    {
      "name": "02 Permisos admin",
      "request": {
        "method": "GET",
        "header": [
          {"key": "Authorization", "value": "Bearer {{admin_token}}"},
          {"key": "X-Zona-Horaria", "value": "America/Bogota"}
        ],
        "url": "{{baseUrl}}/sesiones/me/permisos"
      }
    },
    {
      "name": "03 GET auditoria (solo si permiso)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200 auditoría', function () { pm.expect(pm.response.code).to.eql(200); });",
              "const j = pm.response.json();",
              "pm.test('items y total', function () { pm.expect(j).to.have.property('items'); pm.expect(j).to.have.property('total'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {"key": "Authorization", "value": "Bearer {{admin_token}}"},
          {"key": "X-Zona-Horaria", "value": "America/Bogota"}
        ],
        "url": "{{baseUrl}}/integracion/auditoria?pagina=1&tamano=50"
      }
    },
    {
      "name": "04 PUT auditoria inmutable",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 405 inmutable', function () { pm.expect(pm.response.code).to.eql(405); });"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {"key": "Authorization", "value": "Bearer {{admin_token}}"},
          {"key": "Content-Type", "value": "application/json"},
          {"key": "X-Zona-Horaria", "value": "America/Bogota"}
        ],
        "body": {"mode": "raw", "raw": "{\"intento\": true}"},
        "url": "{{baseUrl}}/integracion/auditoria"
      }
    },
    {
      "name": "05 Token canal inválido",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "X-Zona-Horaria", "value": "America/Bogota"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"client_id\": \"qa-g52-no-existe\",\n  \"client_secret\": \"secreto-invalido-no-usar\",\n  \"email\": \"qa.g52.inexistente@example.com\"\n}"
        },
        "url": "{{baseUrl}}/integraciones/agrofusion/token"
      }
    }
  ]
}
