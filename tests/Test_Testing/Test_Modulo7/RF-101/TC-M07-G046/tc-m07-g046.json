        {
          "name": "GET_ROLES es público por contrato de AgroFusion (limitado por IP): solo id y nombre del rol",
          "description": "El código documenta que AgroFusion llama a GET_ROLES sin autenticación (se limita por IP, 30 por minuto). Es decisión de diseño, no defecto; queda como observación frente a RF-101 (los demás endpoints sí exigen token de canal).",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const J = (() => { try { return pm.response.json(); } catch (e) { return {}; } })();",
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('solo expone id y nombre de cada rol', () => pm.expect(J.every(r => Object.keys(r).every(k => ['id_rol', 'nombre_rol', 'role_id', 'role_name'].includes(k)))).to.be.true);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/integraciones/agrofusion/roles?client_id=qa-m07-aaef&client_secret=x",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "integraciones",
                "agrofusion",
                "roles"
              ],
              "query": [
                {
                  "key": "client_id",
                  "value": "qa-m07-aaef"
                },
                {
                  "key": "client_secret",
                  "value": "x"
                }
              ]
            }
          }
        }
      ]
