          "name": "Iniciar sesión web (correo_admin)",
          "description": "",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const J = (() => { try { return pm.response.json(); } catch (e) { return {}; } })();",
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('trae token', () => pm.expect(J.token).to.be.a('string'));",
                  "pm.collectionVariables.set('tok_admin', J.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
