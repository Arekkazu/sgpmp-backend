        {
          "name": "leer la auditoría del cliente",
          "description": "",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const J = (() => { try { return pm.response.json(); } catch (e) { return {}; } })();",
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const filas = J.items || [];",
                  "pm.test('evento CLIENTE_REGISTRADO con usuario y cliente', () => { const e = filas.find(x => x.tipo_evento === 'CLIENTE_REGISTRADO'); pm.expect(e).to.exist; pm.expect(e.id_usuario).to.not.be.null; pm.expect(String(e.id_cliente_externo)).to.eql(pm.collectionVariables.get('id_aud')); });",
                  "pm.test('evento CLIENTE_EDITADO con usuario y cliente', () => { const e = filas.find(x => x.tipo_evento === 'CLIENTE_EDITADO'); pm.expect(e).to.exist; pm.expect(e.id_usuario).to.not.be.null; pm.expect(String(e.id_cliente_externo)).to.eql(pm.collectionVariables.get('id_aud')); });",
                  "pm.test('evento CLIENTE_SUSPENDIDO con usuario y cliente', () => { const e = filas.find(x => x.tipo_evento === 'CLIENTE_SUSPENDIDO'); pm.expect(e).to.exist; pm.expect(e.id_usuario).to.not.be.null; pm.expect(String(e.id_cliente_externo)).to.eql(pm.collectionVariables.get('id_aud')); });",
                  "pm.test('evento CLIENTE_REACTIVADO con usuario y cliente', () => { const e = filas.find(x => x.tipo_evento === 'CLIENTE_REACTIVADO'); pm.expect(e).to.exist; pm.expect(e.id_usuario).to.not.be.null; pm.expect(String(e.id_cliente_externo)).to.eql(pm.collectionVariables.get('id_aud')); });",
                  "pm.test('evento SECRETO_ROTADO con usuario y cliente', () => { const e = filas.find(x => x.tipo_evento === 'SECRETO_ROTADO'); pm.expect(e).to.exist; pm.expect(e.id_usuario).to.not.be.null; pm.expect(String(e.id_cliente_externo)).to.eql(pm.collectionVariables.get('id_aud')); });",
                  "pm.test('evento CLIENTE_REVOCADO con usuario y cliente', () => { const e = filas.find(x => x.tipo_evento === 'CLIENTE_REVOCADO'); pm.expect(e).to.exist; pm.expect(e.id_usuario).to.not.be.null; pm.expect(String(e.id_cliente_externo)).to.eql(pm.collectionVariables.get('id_aud')); });",
                  "pm.test('suspender y revocar guardan el motivo', () => { ['CLIENTE_SUSPENDIDO', 'CLIENTE_REVOCADO', 'SECRETO_ROTADO'].forEach(t => { const e = filas.find(x => x.tipo_evento === t); pm.expect(JSON.stringify((e || {}).json_detalle || {})).to.match(/QA auditor/); }); });",
                  "pm.test('el estado anterior y el nuevo constan', () => { const e = filas.find(x => x.tipo_evento === 'CLIENTE_SUSPENDIDO'); const d = JSON.stringify((e || {}).json_detalle || {}); pm.expect(d).to.include('ACTIVO'); pm.expect(d).to.include('SUSPENDIDO'); });",
                  "pm.test('ningún evento contiene el secreto', () => pm.expect(JSON.stringify(filas).indexOf(pm.collectionVariables.get('secret_aud'))).to.eql(-1));"
                ]
              }
            }
