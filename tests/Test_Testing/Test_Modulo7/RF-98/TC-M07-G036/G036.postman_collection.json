    {"name":"G036-N-02 Contratos","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{admin_token}}"},{"key":"X-Test-Run-Id","value":"{{run_id}}"},{"key":"X-Sandbox-Secret","value":"{{sandbox_secret}}"}],"url":"{{base_url}}/integracion/contratos"},"event":[{"listen":"test","script":{"exec":["pm.test('Contratos HTTP 200',()=>pm.response.to.have.status(200));","pm.test('Contratos lista',()=>pm.expect(pm.response.json()).to.be.an('array'));","pm.test('Sandbox eco',()=>pm.expect(pm.response.headers.get('X-Test-Run-Id')).to.eql(pm.environment.get('run_id')));"]}}]},
    {"name":"G036-N-03 Auditoria","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{admin_token}}"},{"key":"X-Test-Run-Id","value":"{{run_id}}"},{"key":"X-Sandbox-Secret","value":"{{sandbox_secret}}"}],"url":"{{base_url}}/integracion/auditoria?tipo_evento=CONTRATO_REGISTRADO&pagina=1&tamano=100"},"event":[{"listen":"test","script":{"exec":["pm.test('Auditoria HTTP 200',()=>pm.response.to.have.status(200));","pm.test('Auditoria paginada',()=>pm.expect(pm.response.json().items).to.be.an('array'));","pm.test('Sandbox eco',()=>pm.expect(pm.response.headers.get('X-Test-Run-Id')).to.eql(pm.environment.get('run_id')));"]}}]}
