{
  "info":{"name":"G037 RF-98 lecturas de contraste","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "item":[
    {"name":"G037-N-01 Contratos","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{admin_token}}"},{"key":"X-Test-Run-Id","value":"{{run_id}}"},{"key":"X-Sandbox-Secret","value":"{{sandbox_secret}}"}],"url":"{{base_url}}/integracion/contratos"},"event":[{"listen":"test","script":{"exec":["pm.test('Contratos HTTP 200',()=>pm.response.to.have.status(200));","pm.test('Contratos lista',()=>pm.expect(pm.response.json()).to.be.an('array'));","pm.test('Sandbox eco',()=>pm.expect(pm.response.headers.get('X-Test-Run-Id')).to.eql(pm.environment.get('run_id')));"]}}]},
    {"name":"G037-N-02 Gracia M09","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{admin_token}}"},{"key":"X-Test-Run-Id","value":"{{run_id}}"},{"key":"X-Sandbox-Secret","value":"{{sandbox_secret}}"}],"url":"{{base_url}}/configuracion/parametros-integracion-contable"},"event":[{"listen":"test","script":{"exec":["pm.test('Gracia HTTP 200',()=>pm.response.to.have.status(200));","pm.test('Mínimo y defecto',()=>{const b=pm.response.json();pm.expect(b).to.be.an('array');for(const n of ['aaef_gracia_minima_dias','aaef_gracia_defecto_dias']){const p=b.find(x=>x.nombre===n);pm.expect(p).to.be.an('object');pm.expect(/^[0-9]+$/.test(String(p.valor))&&Number.isSafeInteger(Number(p.valor))).to.eql(true);pm.expect(['VALOR_BASE','CONFIGURADO']).to.include(p.fuente)}});","pm.test('Sandbox eco',()=>pm.expect(pm.response.headers.get('X-Test-Run-Id')).to.eql(pm.environment.get('run_id')));"]}}]}
  ]
}
