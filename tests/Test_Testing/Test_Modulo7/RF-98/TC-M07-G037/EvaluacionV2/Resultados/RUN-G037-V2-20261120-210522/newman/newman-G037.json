              "exec": [
                "pm.test('Gracia HTTP 200',()=>pm.response.to.have.status(200));",
                "pm.test('Mínimo y defecto',()=>{const b=pm.response.json();pm.expect(b).to.be.an('array');for(const n of ['aaef_gracia_minima_dias','aaef_gracia_defecto_dias']){const p=b.find(x=>x.nombre===n);pm.expect(p).to.be.an('object');pm.expect(/^[0-9]+$/.test(String(p.valor))&&Number.isSafeInteger(Number(p.valor))).to.eql(true);pm.expect(['VALOR_BASE','CONFIGURADO']).to.include(p.fuente)}});",
                "pm.test('Sandbox eco',()=>pm.expect(pm.response.headers.get('X-Test-Run-Id')).to.eql(pm.environment.get('run_id')));"
              ],
