              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
                  "pm.test('error_code = PARAMETROS_INVALIDOS', () => { const j = pm.response.json(); pm.expect(j.error_code).to.eql('PARAMETROS_INVALIDOS'); });",
                  "pm.test('indica el parámetro desde', () => { const j = pm.response.json(); const f = j.field || ((j.fields||[])[0]||{}).field; pm.expect(f).to.eql('desde'); });",
                  "pm.test('Contrato de error: el cuerpo trae field (RF-95 Salida)', () => pm.expect(pm.response.json()).to.have.property('field'));",
                  "pm.test('mensaje legible (no vacío, sin trazas)', () => { const m = pm.response.json().message || ''; pm.expect(m.length).to.be.above(10); pm.expect(m).to.not.match(/Traceback|File \"|\\.py|SELECT /i); });",
                  "pm.test('trae X-Request-Id', () => pm.expect(pm.response.headers.has('X-Request-Id')).to.be.true);"
                ]
              }
            }
