        {
          "name": "consultar la auditoría del día",
          "description": "Si hubiera más de 100 eventos del día de otros equipos, los de esta prueba podrían quedar en otra página.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const J = (() => { try { return pm.response.json(); } catch (e) { return {}; } })();",
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
