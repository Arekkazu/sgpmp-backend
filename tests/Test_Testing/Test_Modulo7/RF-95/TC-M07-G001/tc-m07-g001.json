    {
      "name": "TC-95-001 · Dos períodos cerrados (CA-1)",
      "item": [
        {
          "name": "sep–oct: 5 facturas $1.420.000",
          "description": "",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const J = (() => { try { return pm.response.json(); } catch (e) { return {}; } })();",
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Content-Type application/json', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
                  "['X-Request-Id', 'X-Version-Contrato-AAEF', 'X-Content-SHA256'].forEach(h => pm.test('header ' + h, () => pm.expect(pm.response.headers.has(h)).to.be.true));",
                  "pm.test('X-Content-SHA256 es SHA-256 hexadecimal', () => pm.expect(pm.response.headers.get('X-Content-SHA256')).to.match(/^[0-9a-f]{64}$/i));",
                  "pm.test('versión de contrato = la ACTIVA', () => pm.expect(pm.response.headers.get('X-Version-Contrato-AAEF')).to.eql(pm.collectionVariables.get('version_activa')));",
                  "pm.test('5 facturas' , () => { pm.expect((J.invoices || []).length).to.eql(5); pm.expect((J.summary || {}).TotalInvoices).to.eql(5); });",
                  "pm.test('total $1.420.000', () => pm.expect(Number((J.summary || {}).TotalGrossAmount)).to.eql(1420000));",
                  "pm.test('sin paginación (una sola respuesta completa)', () => pm.expect(Object.keys(J).join(',')).to.not.match(/next|page|offset|pagina/i));",
                  "pm.test('ExchangeId = AF-SIGAB-AAAA-MM-NNNNNNN (guía QA-AAEF-02)', () => pm.expect(J.metadata.ExchangeId).to.match(/^AF-SIGAB-2026-09-\\d{7}$/));",
                  "pm.collectionVariables.set('sha_001', pm.response.headers.get('X-Content-SHA256'));",
                  "pm.collectionVariables.set('exch_001', J.metadata.ExchangeId);",
                  "pm.collectionVariables.set('inv_001', JSON.stringify(J.invoices));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tok_c}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/integracion/aaef/productores/{{nit}}?desde=2026-09-01&hasta=2026-10-31",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "integracion",
                "aaef",
                "productores",
                "{{nit}}"
              ],
              "query": [
                {
                  "key": "desde",
                  "value": "2026-09-01"
                },
                {
                  "key": "hasta",
                  "value": "2026-10-31"
                }
              ]
            }
          }
        }
      ]
