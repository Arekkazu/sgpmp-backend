      "name": "Preparación",
      "item": [
        {
          "name": "Token de canal cid_aaef para correo_contador",
          "description": "",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const J = (() => { try { return pm.response.json(); } catch (e) { return {}; } })();",
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('trae access_token y expires_in', () => { pm.expect(J.access_token).to.be.a('string'); pm.expect(J.expires_in).to.be.a('number'); });",
                  "pm.collectionVariables.set('tok_c', J.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/integraciones/agrofusion/token",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "integraciones",
                "agrofusion",
                "token"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
