        {
          "name": "resolver la versión ACTIVA y una INACTIVA del contrato (cambian con las pruebas de RF-98)",
          "description": "",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const J = (() => { try { return pm.response.json(); } catch (e) { return {}; } })();",
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const l = Array.isArray(J) ? J : (Object.values(J).find(v => Array.isArray(v)) || []);",
                  "const act = l.find(x => x.estado === 'ACTIVO');",
                  "pm.test('hay una versión ACTIVA', () => pm.expect(act).to.exist);",
                  "pm.collectionVariables.set('version_activa', act ? act.contrato_version : '3.0');",
                  "const ina = l.filter(x => x.estado === 'INACTIVO').map(x => x.contrato_version);",
                  "pm.collectionVariables.set('version_inactiva', ina.indexOf('1.0') >= 0 ? '1.0' : (ina[0] || '1.0'));"
                ]
              }
            }
          ],
