  "item": [
    {
      "name": "Preparación",
      "item": [
        {
          "name": "Token de canal cid_aaef para correo_contador",
          "description": "",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const J = (() => { try { return pm.response.json(); } catch (e) { return {}; } })();",
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('trae access_token y expires_in', () => { pm.expect(J.access_token).to.be.a('string'); pm.expect(J.expires_in).to.be.a('number'); });",
                  "pm.collectionVariables.set('tok_c', J.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/integraciones/agrofusion/token",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "integraciones",
                "agrofusion",
                "token"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\"client_id\": \"{{cid_aaef}}\", \"client_secret\": \"{{secret_aaef}}\", \"email\": \"{{correo_contador}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Iniciar sesión web (correo_contador)",
          "description": "",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const J = (() => { try { return pm.response.json(); } catch (e) { return {}; } })();",
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('trae token', () => pm.expect(J.token).to.be.a('string'));",
                  "pm.collectionVariables.set('tok_web_c', J.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/sesiones/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "sesiones",
                ""
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\"correo_electronico\": \"{{correo_contador}}\", \"contrasena\": \"{{contrasena_contador}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "resolver la versión ACTIVA y una INACTIVA del contrato (cambian con las pruebas de RF-98)",
          "description": "",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const J = (() => { try { return pm.response.json(); } catch (e) { return {}; } })();",
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const l = Array.isArray(J) ? J : (Object.values(J).find(v => Array.isArray(v)) || []);",
                  "const act = l.find(x => x.estado === 'ACTIVO');",
                  "pm.test('hay una versión ACTIVA', () => pm.expect(act).to.exist);",
                  "pm.collectionVariables.set('version_activa', act ? act.contrato_version : '3.0');",
                  "const ina = l.filter(x => x.estado === 'INACTIVO').map(x => x.contrato_version);",
                  "pm.collectionVariables.set('version_inactiva', ina.indexOf('1.0') >= 0 ? '1.0' : (ina[0] || '1.0'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tok_web_c}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/integracion/contratos",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "integracion",
                "contratos"
              ],
              "query": []
            }
          }
        }
      ]
    },
