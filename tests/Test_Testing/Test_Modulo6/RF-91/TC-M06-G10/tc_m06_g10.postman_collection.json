          }
        ],
        "url": {
          "raw": "{{base_url}}/finanzas/periodos",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "finanzas",
            "periodos"
          ]
        }
      }
    },
    {
      "name": "TC-91-049/050 Prevalidacion del cierre del periodo ABIERTO",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('id_abierto')) { console.log('PRECONDICION NO DISPONIBLE: no hay periodo ABIERTO'); pm.execution.skipRequest(); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test(\"HTTP 200\", () => { pm.response.to.have.status(200); });",
              "pm.test(\"informa lineas sin trazabilidad y si requiere autorizacion\", () => { pm.expect(j.lineas_sin_trazabilidad).to.be.an('array'); pm.expect(j.requiere_autorizacion).to.be.a('boolean'); });",
              "pm.test(\"TC-91-050 lineas pendientes exigen autorizacion\", () => { if ((j.lineas_sin_trazabilidad || []).length) pm.expect(j.requiere_autorizacion).to.eql(true); });",
              "pm.collectionVariables.set('cierre_seguro', ((j.lineas_sin_trazabilidad || []).length && !(j.bloqueos || []).length) ? 'SI' : '');",
              "pm.test('sin error 5xx', () => pm.expect(pm.response.code).to.be.below(500));",
              "pm.test('sin stack trace', () => pm.expect(pm.response.text()).to.not.match(/Traceback|sqlalchemy|psycopg|File \\\"\\//i));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
