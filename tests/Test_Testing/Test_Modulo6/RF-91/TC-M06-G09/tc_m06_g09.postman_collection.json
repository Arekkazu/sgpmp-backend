      "name": "TC-91-043 Re-verificar lineas VERIFICADO no las altera (estado ya verificado se conserva)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('id_periodo_lineas')) { console.log('PRECONDICION NO DISPONIBLE: no hay periodos con lineas'); pm.execution.skipRequest(); }"
            ]
