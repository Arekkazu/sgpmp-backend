        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test(\"HTTP 200\", () => { pm.response.to.have.status(200); });",
              "pm.test(\"el filtro devuelve solo lineas verificadas\", () => { (Array.isArray(j) ? j : []).forEach(l => pm.expect([l.estado, l.estado_trazabilidad]).to.include('VERIFICADO')); });",
