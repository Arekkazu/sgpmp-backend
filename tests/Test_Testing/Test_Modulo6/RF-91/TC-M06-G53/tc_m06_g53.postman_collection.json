{
  "info": {
    "name": "TC-M06-G53 - RF-91 Re-verificación de asientos PENDIENTE_TRAZABILIDAD (CA-5, FA-4)",
    "description": "RF-91 TCG-07 (TC-91-035 a TC-91-038), adaptado a la API real /finanzas de origin/test. Ver ficha.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('run')) pm.collectionVariables.set('run', String(Date.now()).slice(-6));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Login cont",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test('login 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('tok_cont', j.token || '');",
              "pm.test('sin error 5xx', () => pm.expect(pm.response.code).to.be.below(500));",
              "pm.test('sin stack trace', () => pm.expect(pm.response.text()).to.not.match(/Traceback|sqlalchemy|psycopg|File \\\"\\//i));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/sesiones/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "sesiones",
            ""
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"{{correo_cont}}\",\n  \"contrasena\": \"{{clave_cont}}\"\n}"
        }
      }
    },
    {
      "name": "Descubrir periodos contables (Contador)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test(\"HTTP 200\", () => { pm.response.to.have.status(200); });",
              "const arr = Array.isArray(j) ? j : [];",
              "const de = (e) => arr.filter(x => x.estado === e).map(x => String(x.id_periodo_contable));",
              "// Si QA indica el período con --env-var periodo_abierto_qa / periodo_cerrado_qa / periodo_en_cierre_qa, se usa ese en vez del primero que aparezca.",
              "const qa = (k) => String(pm.environment.get(k) || '');",
              "pm.collectionVariables.set('id_abierto', qa('periodo_abierto_qa') || de('ABIERTO')[0] || '');",
              "pm.collectionVariables.set('id_en_cierre', qa('periodo_en_cierre_qa') || de('EN_CIERRE')[0] || '');",
              "pm.collectionVariables.set('id_cerrado', qa('periodo_cerrado_qa') || de('CERRADO')[0] || '');",
              "pm.collectionVariables.set('cerrados', JSON.stringify(de('CERRADO')));",
              "pm.collectionVariables.set('id_periodo_lineas', pm.collectionVariables.get('id_abierto') || pm.collectionVariables.get('id_cerrado') || '');",
              "console.log('PERIODOS', JSON.stringify({ total: arr.length, abiertos: de('ABIERTO'), en_cierre: de('EN_CIERRE'), cerrados: de('CERRADO') }));",
              "pm.test('sin error 5xx', () => pm.expect(pm.response.code).to.be.below(500));",
              "pm.test('sin stack trace', () => pm.expect(pm.response.text()).to.not.match(/Traceback|sqlalchemy|psycopg|File \\\"\\//i));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tok_cont}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/finanzas/periodos",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "finanzas",
            "periodos"
          ]
        }
      }
    },
    {
      "name": "Conteo inicial de verificaciones en la auditoria",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('id_abierto')) { console.log('PRECONDICION NO DISPONIBLE: no se encontro el dato id_abierto en TEST'); pm.execution.skipRequest(); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test(\"HTTP 200\", () => { pm.response.to.have.status(200); });",
              "const ev = Array.isArray(j.eventos) ? j.eventos : [];",
              "console.log('AUDITORIA', 'CADENA_TRAZABILIDAD_VERIFICADA', j.total_registros);",
              "pm.collectionVariables.set('n_audit_antes', String(j.total_registros || 0));",
              "pm.test('sin error 5xx', () => pm.expect(pm.response.code).to.be.below(500));",
              "pm.test('sin stack trace', () => pm.expect(pm.response.text()).to.not.match(/Traceback|sqlalchemy|psycopg|File \\\"\\//i));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tok_cont}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/finanzas/auditoria?tipo_evento=CADENA_TRAZABILIDAD_VERIFICADA&id_periodo_contable={{id_abierto}}&formato=TECNICO&orden=DESC&tamano=100",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "finanzas",
            "auditoria"
          ],
          "query": [
            {
              "key": "tipo_evento",
              "value": "CADENA_TRAZABILIDAD_VERIFICADA"
            },
            {
              "key": "id_periodo_contable",
              "value": "{{id_abierto}}"
            },
            {
              "key": "formato",
              "value": "TECNICO"
            },
            {
              "key": "orden",
              "value": "DESC"
            },
            {
              "key": "tamano",
              "value": "100"
            }
          ]
        }
      }
    },
    {
      "name": "TC-91-035..037 Primera verificacion del periodo ABIERTO [escritura]",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('id_abierto')) { console.log('PRECONDICION NO DISPONIBLE: no hay periodo ABIERTO'); pm.execution.skipRequest(); }",
              "if (pm.variables.get('permitir_escritura') !== 'SI') { console.log('ESCRITURA NO AUTORIZADA: ejecutar con --env-var permitir_escritura=SI'); pm.execution.skipRequest(); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test(\"HTTP 200\", () => { pm.response.to.have.status(200); });",
              "pm.collectionVariables.set('pend_1', JSON.stringify((j.pendientes || []).map(p => p.id_linea)));",
              "pm.collectionVariables.set('verif_1', String(j.verificadas));",
              "pm.test('sin error 5xx', () => pm.expect(pm.response.code).to.be.below(500));",
              "pm.test('sin stack trace', () => pm.expect(pm.response.text()).to.not.match(/Traceback|sqlalchemy|psycopg|File \\\"\\//i));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tok_cont}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/finanzas/periodos/{{id_abierto}}/trazabilidad",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "finanzas",
            "periodos",
            "{{id_abierto}}",
            "trazabilidad"
          ]
        }
      }
    },
    {
      "name": "TC-91-035..037 Re-verificacion sin cambios: las pendientes siguen pendientes [escritura]",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('id_abierto')) { console.log('PRECONDICION NO DISPONIBLE: no hay periodo ABIERTO'); pm.execution.skipRequest(); }",
              "if (pm.variables.get('permitir_escritura') !== 'SI') { console.log('ESCRITURA NO AUTORIZADA: ejecutar con --env-var permitir_escritura=SI'); pm.execution.skipRequest(); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test(\"HTTP 200\", () => { pm.response.to.have.status(200); });",
              "const antes = JSON.parse(pm.collectionVariables.get('pend_1') || '[]'); const ahora = (j.pendientes || []).map(p => p.id_linea);",
              "pm.test(\"TC-91-037 sin corregir el eslabon la linea sigue pendiente\", () => { antes.forEach(id => pm.expect(ahora, 'linea ' + id).to.include(id)); });",
              "pm.test(\"ninguna linea VERIFICADA retrocede\", () => { pm.expect(j.verificadas).to.be.at.least(Number(pm.collectionVariables.get('verif_1') || 0)); });",
              "pm.collectionVariables.set('n_reintentos', String(antes.length));",
              "pm.test('sin error 5xx', () => pm.expect(pm.response.code).to.be.below(500));",
              "pm.test('sin stack trace', () => pm.expect(pm.response.text()).to.not.match(/Traceback|sqlalchemy|psycopg|File \\\"\\//i));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tok_cont}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/finanzas/periodos/{{id_abierto}}/trazabilidad",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "finanzas",
            "periodos",
            "{{id_abierto}}",
            "trazabilidad"
          ]
        }
      }
    },
    {
      "name": "TC-91-038 Cada intento queda en la auditoria, tambien los que no cambian el estado",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('id_abierto')) { console.log('PRECONDICION NO DISPONIBLE: no se encontro el dato id_abierto en TEST'); pm.execution.skipRequest(); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test(\"HTTP 200\", () => { pm.response.to.have.status(200); });",
              "const ev = Array.isArray(j.eventos) ? j.eventos : [];",
              "console.log('AUDITORIA', 'CADENA_TRAZABILIDAD_VERIFICADA', j.total_registros);",
              "if (pm.variables.get('permitir_escritura') !== 'SI') pm.test.skip(\"intentos registrados (ESCRITURA NO AUTORIZADA)\", () => {});",
              "else pm.test(\"hay un evento por cada linea re-verificada\", () => { pm.expect(Number(j.total_registros)).to.be.at.least(Number(pm.collectionVariables.get('n_audit_antes')) + Number(pm.collectionVariables.get('n_reintentos') || 0)); });",
              "pm.test('sin error 5xx', () => pm.expect(pm.response.code).to.be.below(500));",
              "pm.test('sin stack trace', () => pm.expect(pm.response.text()).to.not.match(/Traceback|sqlalchemy|psycopg|File \\\"\\//i));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tok_cont}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/finanzas/auditoria?tipo_evento=CADENA_TRAZABILIDAD_VERIFICADA&id_periodo_contable={{id_abierto}}&formato=TECNICO&orden=DESC&tamano=100",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "finanzas",
            "auditoria"
          ],
          "query": [
            {
              "key": "tipo_evento",
              "value": "CADENA_TRAZABILIDAD_VERIFICADA"
            },
            {
              "key": "id_periodo_contable",
              "value": "{{id_abierto}}"
            },
            {
              "key": "formato",
              "value": "TECNICO"
            },
            {
              "key": "orden",
              "value": "DESC"
            },
            {
              "key": "tamano",
              "value": "100"
            }
          ]
        }
      }
    }
