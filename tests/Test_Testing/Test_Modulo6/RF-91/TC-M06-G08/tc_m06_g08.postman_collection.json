{
  "info": {
    "name": "TC-M06-G08 - RF-91 Distinción entre eslabón ausente e indisponibilidad del módulo fuente (Restricción 7)",
    "description": "RF-91 TCG-08 (TC-91-039 a TC-91-042, TC-91-072), adaptado a la API real /finanzas de origin/test. Ver ficha.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('run')) pm.collectionVariables.set('run', String(Date.now()).slice(-6));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Login cont",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test('login 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('tok_cont', j.token || '');",
              "pm.test('sin error 5xx', () => pm.expect(pm.response.code).to.be.below(500));",
              "pm.test('sin stack trace', () => pm.expect(pm.response.text()).to.not.match(/Traceback|sqlalchemy|psycopg|File \\\"\\//i));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/sesiones/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "sesiones",
            ""
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"{{correo_cont}}\",\n  \"contrasena\": \"{{clave_cont}}\"\n}"
        }
      }
    },
    {
      "name": "Descubrir periodos contables (Contador)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test(\"HTTP 200\", () => { pm.response.to.have.status(200); });",
              "const arr = Array.isArray(j) ? j : [];",
              "const de = (e) => arr.filter(x => x.estado === e);",
              "const ids = (e) => de(e).map(x => String(x.id_periodo_contable));",
              "const qa = (k) => String(pm.environment.get(k) || '');",
              "pm.collectionVariables.set('cerrados', JSON.stringify(ids('CERRADO')));",
              "pm.collectionVariables.set('id_en_cierre', qa('periodo_en_cierre_qa') || ids('EN_CIERRE')[0] || '');",
              "// CERRADO con y sin fecha_cierre: el segundo reproduce INC-M06-054-G10.",
              "pm.collectionVariables.set('id_cerrado_sin_fecha', de('CERRADO').filter(x => !x.fecha_cierre).map(x => String(x.id_periodo_contable))[0] || '');",
              "pm.collectionVariables.set('id_cerrado_con_fecha', de('CERRADO').filter(x => x.fecha_cierre).map(x => String(x.id_periodo_contable))[0] || '');",
              "// Cuenta las lineas de asiento de cada periodo ABIERTO o CERRADO y usa el que tenga mas (o el que indique QA con --env-var).",
              "const cand = arr.filter(x => ['ABIERTO', 'CERRADO'].includes(x.estado)).map(x => String(x.id_periodo_contable));",
              "const cuenta = {}; let pend = cand.length;",
              "const fin = () => {",
              "  const mas = (lista) => lista.slice().sort((a, b) => (cuenta[b] || 0) - (cuenta[a] || 0) || Number(b) - Number(a))[0] || '';",
              "  const ab = qa('periodo_abierto_qa') || mas(ids('ABIERTO'));",
              "  const ce = qa('periodo_cerrado_qa') || mas(ids('CERRADO'));",
              "  pm.collectionVariables.set('id_abierto', ab);",
              "  pm.collectionVariables.set('id_cerrado', ce);",
              "  pm.collectionVariables.set('abiertos_con_lineas', JSON.stringify(ids('ABIERTO').filter(id => id !== ab && (cuenta[id] || 0) > 0)));",
              "  pm.collectionVariables.set('periodos_lineas', JSON.stringify(cand.filter(id => (cuenta[id] || 0) > 0).sort((a, b) => (cuenta[b] || 0) - (cuenta[a] || 0))));",
              "  pm.collectionVariables.set('id_periodo_lineas', mas(cand) && (cuenta[mas(cand)] || 0) > 0 ? mas(cand) : (ab || ce));",
              "  pm.test('Descubrimiento: lineas por periodo ' + JSON.stringify(cuenta) + ' | ms por consulta ' + JSON.stringify(tiempos) + ' | tipo:estado ' + JSON.stringify(tipos) + ' | POR PERIODO ' + JSON.stringify(porPeriodo) + ' | abierto=' + ab + ' cerrado=' + ce + ' en_cierre=' + (pm.collectionVariables.get('id_en_cierre') || '-') + ' | CERRADO sin fecha_cierre=' + (pm.collectionVariables.get('id_cerrado_sin_fecha') || '-'), () => {});",
              "};",
              "if (!pend) fin();",
              "// Secuencial (una consulta a la vez) y con el tiempo de cada una: evita saturar el servidor y deja evidencia si alguna tarda.",
              "const tiempos = {}; const tipos = {}; const porPeriodo = {};",
              "const siguiente = (k) => {",
              "  if (k >= cand.length) { return fin(); }",
              "  const id = cand[k];",
              "  pm.sendRequest({ url: pm.variables.get('base_url') + '/finanzas/lineas?id_periodo_contable=' + id, method: 'GET',",
              "    header: { Authorization: 'Bearer ' + pm.collectionVariables.get('tok_cont') } }, (e, r) => {",
              "    let l = []; try { l = r.json(); } catch (x) {}",
              "    cuenta[id] = Array.isArray(l) ? l.length : 0; tiempos[id] = r ? r.responseTime : -1; (Array.isArray(l) ? l : []).forEach(x => { const kt = x.tipo_evidencia + ':' + x.estado_trazabilidad; tipos[kt] = (tipos[kt] || 0) + 1; porPeriodo[id] = porPeriodo[id] || {}; porPeriodo[id][kt] = (porPeriodo[id][kt] || 0) + 1; });",
              "    siguiente(k + 1); });",
              "};",
              "if (!cand.length) { fin(); } else { siguiente(0); }",
              "pm.test('sin error 5xx', () => pm.expect(pm.response.code).to.be.below(500));",
              "pm.test('sin stack trace', () => pm.expect(pm.response.text()).to.not.match(/Traceback|sqlalchemy|psycopg|File \\\"\\//i));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tok_cont}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/finanzas/periodos",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "finanzas",
            "periodos"
          ]
        }
      }
    },
