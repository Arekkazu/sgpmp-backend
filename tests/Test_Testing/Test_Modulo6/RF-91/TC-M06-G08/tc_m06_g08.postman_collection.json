{
  "info": {
    "name": "TC-M06-G08 - RF-91 Distinción entre eslabón ausente e indisponibilidad del módulo fuente (Restricción 7)",
    "description": "RF-91 TCG-08 (TC-91-039 a TC-91-042, TC-91-072), adaptado a la API real /finanzas de origin/test. Ver ficha.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('run')) pm.collectionVariables.set('run', String(Date.now()).slice(-6));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Login cont",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test('login 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('tok_cont', j.token || '');",
              "pm.test('sin error 5xx', () => pm.expect(pm.response.code).to.be.below(500));",
              "pm.test('sin stack trace', () => pm.expect(pm.response.text()).to.not.match(/Traceback|sqlalchemy|psycopg|File \\\"\\//i));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/sesiones/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "sesiones",
            ""
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"{{correo_cont}}\",\n  \"contrasena\": \"{{clave_cont}}\"\n}"
        }
      }
    },
    {
      "name": "Descubrir periodos contables (Contador)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test(\"HTTP 200\", () => { pm.response.to.have.status(200); });",
              "const arr = Array.isArray(j) ? j : [];",
              "const de = (e) => arr.filter(x => x.estado === e).map(x => String(x.id_periodo_contable));",
              "// Si QA indica el período con --env-var periodo_abierto_qa / periodo_cerrado_qa / periodo_en_cierre_qa, se usa ese en vez del primero que aparezca.",
              "const qa = (k) => String(pm.environment.get(k) || '');",
              "pm.collectionVariables.set('id_abierto', qa('periodo_abierto_qa') || de('ABIERTO')[0] || '');",
              "pm.collectionVariables.set('id_en_cierre', qa('periodo_en_cierre_qa') || de('EN_CIERRE')[0] || '');",
              "pm.collectionVariables.set('id_cerrado', qa('periodo_cerrado_qa') || de('CERRADO')[0] || '');",
              "pm.collectionVariables.set('cerrados', JSON.stringify(de('CERRADO')));",
              "pm.collectionVariables.set('id_periodo_lineas', pm.collectionVariables.get('id_abierto') || pm.collectionVariables.get('id_cerrado') || '');",
              "console.log('PERIODOS', JSON.stringify({ total: arr.length, abiertos: de('ABIERTO'), en_cierre: de('EN_CIERRE'), cerrados: de('CERRADO') }));",
              "pm.test('sin error 5xx', () => pm.expect(pm.response.code).to.be.below(500));",
              "pm.test('sin stack trace', () => pm.expect(pm.response.text()).to.not.match(/Traceback|sqlalchemy|psycopg|File \\\"\\//i));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tok_cont}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/finanzas/periodos",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "finanzas",
            "periodos"
          ]
        }
      }
    },
    {
      "name": "TC-91-039..041 El estado VERIFICACION_PENDIENTE existe en el contrato",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test(\"HTTP 200\", () => { pm.response.to.have.status(200); });",
              "pm.test('sin error 5xx', () => pm.expect(pm.response.code).to.be.below(500));",
              "pm.test('sin stack trace', () => pm.expect(pm.response.text()).to.not.match(/Traceback|sqlalchemy|psycopg|File \\\"\\//i));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tok_cont}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/finanzas/lineas?id_periodo_contable=999999999&estado=VERIFICACION_PENDIENTE",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "finanzas",
            "lineas"
          ],
          "query": [
            {
              "key": "id_periodo_contable",
              "value": "999999999"
            },
            {
              "key": "estado",
              "value": "VERIFICACION_PENDIENTE"
            }
          ]
        }
      }
    },
    {
      "name": "TC-91-042 Intentos fallidos por infraestructura en la auditoria",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('id_periodo_lineas')) { console.log('PRECONDICION NO DISPONIBLE: no se encontro el dato id_periodo_lineas en TEST'); pm.execution.skipRequest(); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test(\"HTTP 200\", () => { pm.response.to.have.status(200); });",
              "const ev = Array.isArray(j.eventos) ? j.eventos : [];",
              "console.log('AUDITORIA', 'ERROR_TECNICO', j.total_registros);",
              "pm.test(\"consulta disponible\", () => pm.expect(j.eventos).to.be.an('array'));",
              "pm.test('sin error 5xx', () => pm.expect(pm.response.code).to.be.below(500));",
              "pm.test('sin stack trace', () => pm.expect(pm.response.text()).to.not.match(/Traceback|sqlalchemy|psycopg|File \\\"\\//i));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tok_cont}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/finanzas/auditoria?tipo_evento=ERROR_TECNICO&id_periodo_contable={{id_periodo_lineas}}&formato=TECNICO&orden=DESC&tamano=100",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "finanzas",
            "auditoria"
          ],
          "query": [
            {
              "key": "tipo_evento",
              "value": "ERROR_TECNICO"
            },
            {
              "key": "id_periodo_contable",
              "value": "{{id_periodo_lineas}}"
            },
            {
              "key": "formato",
              "value": "TECNICO"
            },
            {
              "key": "orden",
              "value": "DESC"
            },
            {
              "key": "tamano",
              "value": "100"
            }
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "https://api.inmero.co/api-sgpmp-test"
    },
    {
      "key": "permitir_escritura",
      "value": "NO"
    },
    {
      "key": "tok_cont",
      "value": ""
    },
    {
      "key": "correo_cont",
      "value": ""
    },
    {
      "key": "clave_cont",
      "value": ""
    }
  ]
}
