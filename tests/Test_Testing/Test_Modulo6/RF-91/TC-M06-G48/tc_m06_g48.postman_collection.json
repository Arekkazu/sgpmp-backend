{
  "info": {
    "name": "TC-M06-G48 - RF-91 Cardinalidad de lecturas IoT por evento (CA-3, CA-4, FA-1)",
    "description": "RF-91 TCG-02 (TC-91-005 a TC-91-010), adaptado a la API real /finanzas de origin/test. Ver ficha.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('run')) pm.collectionVariables.set('run', String(Date.now()).slice(-6));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Login cont",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test('login 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('tok_cont', j.token || '');",
              "pm.test('sin error 5xx', () => pm.expect(pm.response.code).to.be.below(500));",
              "pm.test('sin stack trace', () => pm.expect(pm.response.text()).to.not.match(/Traceback|sqlalchemy|psycopg|File \\\"\\//i));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/sesiones/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "sesiones",
            ""
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"{{correo_cont}}\",\n  \"contrasena\": \"{{clave_cont}}\"\n}"
        }
      }
    },
    {
      "name": "Descubrir periodos contables (Contador)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test(\"HTTP 200\", () => { pm.response.to.have.status(200); });",
              "const arr = Array.isArray(j) ? j : [];",
              "const de = (e) => arr.filter(x => x.estado === e).map(x => String(x.id_periodo_contable));",
              "// Si QA indica el período con --env-var periodo_abierto_qa / periodo_cerrado_qa / periodo_en_cierre_qa, se usa ese en vez del primero que aparezca.",
              "const qa = (k) => String(pm.environment.get(k) || '');",
              "pm.collectionVariables.set('id_abierto', qa('periodo_abierto_qa') || de('ABIERTO')[0] || '');",
              "pm.collectionVariables.set('id_en_cierre', qa('periodo_en_cierre_qa') || de('EN_CIERRE')[0] || '');",
              "pm.collectionVariables.set('id_cerrado', qa('periodo_cerrado_qa') || de('CERRADO')[0] || '');",
              "pm.collectionVariables.set('cerrados', JSON.stringify(de('CERRADO')));",
              "pm.collectionVariables.set('id_periodo_lineas', pm.collectionVariables.get('id_abierto') || pm.collectionVariables.get('id_cerrado') || '');",
              "console.log('PERIODOS', JSON.stringify({ total: arr.length, abiertos: de('ABIERTO'), en_cierre: de('EN_CIERRE'), cerrados: de('CERRADO') }));",
              "pm.test('sin error 5xx', () => pm.expect(pm.response.code).to.be.below(500));",
              "pm.test('sin stack trace', () => pm.expect(pm.response.text()).to.not.match(/Traceback|sqlalchemy|psycopg|File \\\"\\//i));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tok_cont}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/finanzas/periodos",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "finanzas",
            "periodos"
          ]
        }
      }
    },
    {
      "name": "TC-91-005/006/007 Basta una lectura apta para el nivel 1",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('id_periodo_lineas')) { console.log('PRECONDICION NO DISPONIBLE: no hay periodos contables con lineas en TEST'); pm.execution.skipRequest(); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test(\"HTTP 200\", () => { pm.response.to.have.status(200); });",
              "const todas = Array.isArray(j) ? j : [];",
              "const sel = todas.filter(l => l.tipo_evidencia === 'IOT_DIRECTO' && ['VERIFICADO','PENDIENTE_TRAZABILIDAD'].includes(l.estado_trazabilidad)).slice(0, 25);",
              "console.log('LINEAS', JSON.stringify({ periodo: pm.collectionVariables.get('id_periodo_lineas'), total: todas.length, seleccionadas: sel.length }));",
              "if (!sel.length) { pm.test.skip(\"al menos una lectura apta basta para el nivel 1 (PRECONDICION NO DISPONIBLE: ninguna linea cumple el filtro)\", () => {}); }",
              "else {",
              "  const errores = []; let pend = sel.length;",
              "  sel.forEach(l => pm.sendRequest({ url: pm.variables.get('base_url') + '/finanzas/lineas/' + l.id_linea_asiento_nic41 + '/cadena', method: 'GET',",
              "    header: { Authorization: 'Bearer ' + pm.collectionVariables.get('tok_cont') } }, (e, r) => {",
              "    let c = {}; try { c = r.json(); } catch (x) {}",
              "    const falla = (m) => errores.push('linea ' + l.id_linea_asiento_nic41 + ' (' + l.tipo_evidencia + '): ' + m);",
              "    const es = (c && c.eslabones) || {};",
              "    try { const n = ((es.ids || {}).ids_lectura_iot || []).length;",
              "if (n > 0 && es.lecturas_nic41 !== true) falla(n + ' lecturas aptas pero nivel 1 = ' + es.lecturas_nic41);",
              "if (n > 0 && es.lecturas_nic41 === true && (es.faltantes || []).includes('lecturas_nic41')) falla('nivel 1 marcado faltante con lecturas aptas'); } catch (x) { falla('error en el chequeo: ' + x.message); }",
              "    if (--pend === 0) { console.log('DETALLE', JSON.stringify(errores.slice(0, 20))); pm.test(\"al menos una lectura apta basta para el nivel 1\", () => { pm.expect(errores.length, errores.slice(0, 5).join(' | ')).to.eql(0); }); }",
              "  }));",
              "}",
              "pm.test('sin error 5xx', () => pm.expect(pm.response.code).to.be.below(500));",
              "pm.test('sin stack trace', () => pm.expect(pm.response.text()).to.not.match(/Traceback|sqlalchemy|psycopg|File \\\"\\//i));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tok_cont}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/finanzas/lineas?id_periodo_contable={{id_periodo_lineas}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "finanzas",
            "lineas"
          ],
          "query": [
            {
              "key": "id_periodo_contable",
              "value": "{{id_periodo_lineas}}"
            }
          ]
        }
      }
    },
    {
      "name": "TC-91-008/009 Sin lecturas aptas: CADENA_INCOMPLETA, PENDIENTE_TRAZABILIDAD y nivel 1 como eslabon fallido",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('id_periodo_lineas')) { console.log('PRECONDICION NO DISPONIBLE: no hay periodos contables con lineas en TEST'); pm.execution.skipRequest(); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test(\"HTTP 200\", () => { pm.response.to.have.status(200); });",
              "const todas = Array.isArray(j) ? j : [];",
              "const sel = todas.filter(l => l.tipo_evidencia === 'IOT_DIRECTO' && l.estado_trazabilidad === 'PENDIENTE_TRAZABILIDAD').slice(0, 25);",
              "console.log('LINEAS', JSON.stringify({ periodo: pm.collectionVariables.get('id_periodo_lineas'), total: todas.length, seleccionadas: sel.length }));",
              "if (!sel.length) { pm.test.skip(\"el eslabon fallido se identifica (PRECONDICION NO DISPONIBLE: ninguna linea cumple el filtro)\", () => {}); }",
              "else {",
              "  const errores = []; let pend = sel.length;",
              "  sel.forEach(l => pm.sendRequest({ url: pm.variables.get('base_url') + '/finanzas/lineas/' + l.id_linea_asiento_nic41 + '/cadena', method: 'GET',",
              "    header: { Authorization: 'Bearer ' + pm.collectionVariables.get('tok_cont') } }, (e, r) => {",
              "    let c = {}; try { c = r.json(); } catch (x) {}",
              "    const falla = (m) => errores.push('linea ' + l.id_linea_asiento_nic41 + ' (' + l.tipo_evidencia + '): ' + m);",
              "    const es = (c && c.eslabones) || {};",
              "    try { if (es.lecturas_nic41 === false) { if (!(es.faltantes || []).includes('lecturas_nic41')) falla('no nombra el eslabon lecturas_nic41'); if (es.nivel_fallo !== 1) falla('nivel_fallo = ' + es.nivel_fallo); if (c.estado_verificacion !== 'FALLO_NIVEL_1') falla('estado_verificacion = ' + c.estado_verificacion); } } catch (x) { falla('error en el chequeo: ' + x.message); }",
              "    if (--pend === 0) { console.log('DETALLE', JSON.stringify(errores.slice(0, 20))); pm.test(\"el eslabon fallido se identifica\", () => { pm.expect(errores.length, errores.slice(0, 5).join(' | ')).to.eql(0); }); }",
              "  }));",
              "}",
              "pm.test('sin error 5xx', () => pm.expect(pm.response.code).to.be.below(500));",
              "pm.test('sin stack trace', () => pm.expect(pm.response.text()).to.not.match(/Traceback|sqlalchemy|psycopg|File \\\"\\//i));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tok_cont}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/finanzas/lineas?id_periodo_contable={{id_periodo_lineas}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "finanzas",
            "lineas"
          ],
          "query": [
            {
              "key": "id_periodo_contable",
              "value": "{{id_periodo_lineas}}"
            }
          ]
        }
      }
    },
    {
      "name": "TC-91-008 Alerta al Contador con el eslabon fallido (evento WARNING)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('id_periodo_lineas')) { console.log('PRECONDICION NO DISPONIBLE: no se encontro el dato id_periodo_lineas en TEST'); pm.execution.skipRequest(); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test(\"HTTP 200\", () => { pm.response.to.have.status(200); });",
              "const ev = Array.isArray(j.eventos) ? j.eventos : [];",
              "console.log('AUDITORIA', 'CADENA_TRAZABILIDAD_VERIFICADA', j.total_registros);",
              "const inc = ev.filter(e => (e.payload_evento || {}).resultado === 'CADENA_INCOMPLETA');",
              "if (!inc.length) pm.test.skip(\"alerta de cadena incompleta (PRECONDICION: no hay cadenas incompletas)\", () => {});",
              "else pm.test(\"la alerta nombra los eslabones faltantes y el nivel\", () => { inc.forEach(e => { pm.expect(e.payload_evento.faltantes).to.be.an('array').that.is.not.empty; pm.expect(e.payload_evento.nivel_fallo).to.be.a('number'); }); });",
              "pm.test('sin error 5xx', () => pm.expect(pm.response.code).to.be.below(500));",
              "pm.test('sin stack trace', () => pm.expect(pm.response.text()).to.not.match(/Traceback|sqlalchemy|psycopg|File \\\"\\//i));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tok_cont}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/finanzas/auditoria?tipo_evento=CADENA_TRAZABILIDAD_VERIFICADA&id_periodo_contable={{id_periodo_lineas}}&severidad=WARNING&formato=TECNICO&orden=DESC&tamano=100",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "finanzas",
            "auditoria"
          ],
          "query": [
            {
              "key": "tipo_evento",
              "value": "CADENA_TRAZABILIDAD_VERIFICADA"
            },
            {
              "key": "id_periodo_contable",
              "value": "{{id_periodo_lineas}}"
            },
            {
              "key": "severidad",
              "value": "WARNING"
            },
            {
              "key": "formato",
              "value": "TECNICO"
            },
            {
              "key": "orden",
              "value": "DESC"
            },
            {
              "key": "tamano",
              "value": "100"
            }
          ]
        }
      }
    }
  ],
