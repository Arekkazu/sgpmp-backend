{
  "info": {
    "name": "TC-M06-G03 - RF-91 Matriz de niveles obligatorios por tipo_evidencia_origen (CA-2, FA-3, Proceso 2)",
    "description": "RF-91 TCG-03 (TC-91-011 a TC-91-018, TC-91-071), adaptado a la API real /finanzas de origin/test. Ver ficha.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('run')) pm.collectionVariables.set('run', String(Date.now()).slice(-6));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Login cont",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test('login 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('tok_cont', j.token || '');",
              "pm.test('sin error 5xx', () => pm.expect(pm.response.code).to.be.below(500));",
              "pm.test('sin stack trace', () => pm.expect(pm.response.text()).to.not.match(/Traceback|sqlalchemy|psycopg|File \\\"\\//i));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/sesiones/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "sesiones",
            ""
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"{{correo_cont}}\",\n  \"contrasena\": \"{{clave_cont}}\"\n}"
        }
      }
    },
    {
      "name": "Descubrir periodos contables (Contador)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test(\"HTTP 200\", () => { pm.response.to.have.status(200); });",
              "const arr = Array.isArray(j) ? j : [];",
              "const de = (e) => arr.filter(x => x.estado === e).map(x => String(x.id_periodo_contable));",
              "// Si QA indica el período con --env-var periodo_abierto_qa / periodo_cerrado_qa / periodo_en_cierre_qa, se usa ese en vez del primero que aparezca.",
              "const qa = (k) => String(pm.environment.get(k) || '');",
              "pm.collectionVariables.set('id_abierto', qa('periodo_abierto_qa') || de('ABIERTO')[0] || '');",
              "pm.collectionVariables.set('id_en_cierre', qa('periodo_en_cierre_qa') || de('EN_CIERRE')[0] || '');",
              "pm.collectionVariables.set('id_cerrado', qa('periodo_cerrado_qa') || de('CERRADO')[0] || '');",
              "pm.collectionVariables.set('cerrados', JSON.stringify(de('CERRADO')));",
              "pm.collectionVariables.set('id_periodo_lineas', pm.collectionVariables.get('id_abierto') || pm.collectionVariables.get('id_cerrado') || '');",
              "console.log('PERIODOS', JSON.stringify({ total: arr.length, abiertos: de('ABIERTO'), en_cierre: de('EN_CIERRE'), cerrados: de('CERRADO') }));",
              "pm.test('sin error 5xx', () => pm.expect(pm.response.code).to.be.below(500));",
              "pm.test('sin stack trace', () => pm.expect(pm.response.text()).to.not.match(/Traceback|sqlalchemy|psycopg|File \\\"\\//i));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tok_cont}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/finanzas/periodos",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "finanzas",
            "periodos"
          ]
        }
      }
    },
    {
      "name": "TC-91-011..018 Niveles obligatorios por tipo de evidencia (oraculo de la matriz)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('id_periodo_lineas')) { console.log('PRECONDICION NO DISPONIBLE: no hay periodos contables con lineas en TEST'); pm.execution.skipRequest(); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test(\"HTTP 200\", () => { pm.response.to.have.status(200); });",
              "const todas = Array.isArray(j) ? j : [];",
              "const sel = todas.filter(l => ['VERIFICADO','PENDIENTE_TRAZABILIDAD'].includes(l.estado_trazabilidad)).slice(0, 40);",
              "console.log('LINEAS', JSON.stringify({ periodo: pm.collectionVariables.get('id_periodo_lineas'), total: todas.length, seleccionadas: sel.length }));",
              "if (!sel.length) { pm.test.skip(\"el estado respeta los niveles obligatorios de la matriz (PRECONDICION NO DISPONIBLE: ninguna linea cumple el filtro)\", () => {}); }",
              "else {",
              "  const errores = []; let pend = sel.length;",
              "  sel.forEach(l => pm.sendRequest({ url: pm.variables.get('base_url') + '/finanzas/lineas/' + l.id_linea_asiento_nic41 + '/cadena', method: 'GET',",
              "    header: { Authorization: 'Bearer ' + pm.collectionVariables.get('tok_cont') } }, (e, r) => {",
              "    let c = {}; try { c = r.json(); } catch (x) {}",
              "    const falla = (m) => errores.push('linea ' + l.id_linea_asiento_nic41 + ' (' + l.tipo_evidencia + '): ' + m);",
              "    const es = (c && c.eslabones) || {};",
              "    try { const REQ = { IOT_DIRECTO: ['origen','evento_m02','lecturas_nic41','precio_documentado'], REGISTRO_MANUAL: ['origen','evento_m02','precio_documentado'], VARIACION_PRECIO: ['origen','precio_documentado'], EVENTO_SANITARIO: ['origen','evento_sanitario','precio_documentado'], CIERRE_PERIODO: ['origen','cierre','precio_documentado'] };",
              "const req = REQ[l.tipo_evidencia];",
              "if (!req) falla('tipo de evidencia fuera del enumerado: ' + l.tipo_evidencia);",
              "else { const completo = req.every(n => es[n] === true); const esperado = completo ? 'VERIFICADO' : 'PENDIENTE_TRAZABILIDAD';",
              "  if (l.estado_trazabilidad !== esperado) falla('estado ' + l.estado_trazabilidad + ', la matriz espera ' + esperado + ' con ' + JSON.stringify(req.reduce((a, n) => (a[n] = es[n], a), {}))); } } catch (x) { falla('error en el chequeo: ' + x.message); }",
              "    if (--pend === 0) { console.log('DETALLE', JSON.stringify(errores.slice(0, 20))); pm.test(\"el estado respeta los niveles obligatorios de la matriz\", () => { pm.expect(errores.length, errores.slice(0, 5).join(' | ')).to.eql(0); }); }",
              "  }));",
              "}",
              "pm.test('sin error 5xx', () => pm.expect(pm.response.code).to.be.below(500));",
              "pm.test('sin stack trace', () => pm.expect(pm.response.text()).to.not.match(/Traceback|sqlalchemy|psycopg|File \\\"\\//i));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tok_cont}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/finanzas/lineas?id_periodo_contable={{id_periodo_lineas}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "finanzas",
            "lineas"
          ],
          "query": [
            {
              "key": "id_periodo_contable",
              "value": "{{id_periodo_lineas}}"
            }
          ]
        }
      }
    },
    {
      "name": "TC-91-071 Servicio veterinario e inseminacion no generan lineas de trazabilidad",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('id_periodo_lineas')) { console.log('PRECONDICION NO DISPONIBLE: no hay periodos con lineas'); pm.execution.skipRequest(); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test(\"HTTP 200\", () => { pm.response.to.have.status(200); });",
              "pm.test(\"ninguna linea de servicio veterinario o inseminacion\", () => { (Array.isArray(j) ? j : []).forEach(l => pm.expect(String(l.subtipo_costo || ''), 'linea ' + l.id_linea_asiento_nic41).to.not.match(/VETERINARIO|INSEMINACION/)); });",
              "pm.test('sin error 5xx', () => pm.expect(pm.response.code).to.be.below(500));",
              "pm.test('sin stack trace', () => pm.expect(pm.response.text()).to.not.match(/Traceback|sqlalchemy|psycopg|File \\\"\\//i));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tok_cont}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/finanzas/lineas?id_periodo_contable={{id_periodo_lineas}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "finanzas",
            "lineas"
          ],
          "query": [
            {
              "key": "id_periodo_contable",
              "value": "{{id_periodo_lineas}}"
            }
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "https://api.inmero.co/api-sgpmp-test"
    },
    {
      "key": "permitir_escritura",
      "value": "NO"
    },
    {
      "key": "tok_cont",
      "value": ""
    },
    {
      "key": "correo_cont",
      "value": ""
    },
    {
      "key": "clave_cont",
      "value": ""
    }
  ]
}
