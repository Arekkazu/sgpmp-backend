{
  "info": {
    "name": "TC-M06-G58 - RF-91 Rendimiento y retención (RNF-91-01 a RNF-91-04)",
    "description": "RF-91 TC-M06-G58 (TC-91-064 a TC-91-068), adaptado a la API real /finanzas de origin/test. Ver ficha.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('run')) pm.collectionVariables.set('run', String(Date.now()).slice(-6));",
          "if (!pm.collectionVariables.get('run_sandbox')) pm.collectionVariables.set('run_sandbox', 'qa-m06-rf91g58-' + Date.now());",
          "if (pm.variables.get('permitir_escritura') === 'SI' && pm.variables.get('sandbox_secret') && !/^(Login|Descubrir periodos|Cerrar sandbox)/.test(pm.info.requestName)) { pm.request.headers.upsert({ key: 'X-Test-Run-Id', value: pm.collectionVariables.get('run_sandbox') }); pm.request.headers.upsert({ key: 'X-Sandbox-Secret', value: pm.variables.get('sandbox_secret') }); }"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Login cont",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test('login 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('tok_cont', j.token || '');",
              "pm.test('sin error 5xx', () => pm.expect(pm.response.code).to.be.below(500));",
              "pm.test('sin stack trace', () => pm.expect(pm.response.text()).to.not.match(/Traceback|sqlalchemy|psycopg|File \\\"\\//i));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/sesiones/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "sesiones",
            ""
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"{{correo_cont}}\",\n  \"contrasena\": \"{{clave_cont}}\"\n}"
        }
      }
    },
    {
      "name": "Descubrir periodos contables (Contador)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test(\"HTTP 200\", () => { pm.response.to.have.status(200); });",
              "const arr = Array.isArray(j) ? j : [];",
              "const de = (e) => arr.filter(x => x.estado === e);",
              "const ids = (e) => de(e).map(x => String(x.id_periodo_contable));",
              "const qa = (k) => String(pm.environment.get(k) || '');",
              "pm.collectionVariables.set('cerrados', JSON.stringify(ids('CERRADO')));",
              "pm.collectionVariables.set('id_en_cierre', qa('periodo_en_cierre_qa') || ids('EN_CIERRE')[0] || '');",
              "// CERRADO con y sin fecha_cierre: el segundo reproduce INC-M06-054-G56.",
              "pm.collectionVariables.set('id_cerrado_sin_fecha', de('CERRADO').filter(x => !x.fecha_cierre).map(x => String(x.id_periodo_contable))[0] || '');",
              "pm.collectionVariables.set('id_cerrado_con_fecha', de('CERRADO').filter(x => x.fecha_cierre).map(x => String(x.id_periodo_contable))[0] || '');",
              "// Cuenta las lineas de asiento de cada periodo ABIERTO o CERRADO y usa el que tenga mas (o el que indique QA con --env-var).",
              "const cand = arr.filter(x => ['ABIERTO', 'CERRADO'].includes(x.estado)).map(x => String(x.id_periodo_contable));",
              "const cuenta = {}; let pend = cand.length;",
              "const fin = () => {",
              "  const mas = (lista) => lista.slice().sort((a, b) => (cuenta[b] || 0) - (cuenta[a] || 0) || Number(b) - Number(a))[0] || '';",
              "  const ab = qa('periodo_abierto_qa') || mas(ids('ABIERTO'));",
              "  const ce = qa('periodo_cerrado_qa') || mas(ids('CERRADO'));",
              "  pm.collectionVariables.set('id_abierto', ab);",
              "  pm.collectionVariables.set('id_cerrado', ce);",
              "  pm.collectionVariables.set('abiertos_con_lineas', JSON.stringify(ids('ABIERTO').filter(id => id !== ab && (cuenta[id] || 0) > 0)));",
              "  pm.collectionVariables.set('periodos_lineas', JSON.stringify(cand.filter(id => (cuenta[id] || 0) > 0).sort((a, b) => (cuenta[b] || 0) - (cuenta[a] || 0))));",
              "  pm.collectionVariables.set('id_periodo_lineas', mas(cand) && (cuenta[mas(cand)] || 0) > 0 ? mas(cand) : (ab || ce));",
              "  pm.test('Descubrimiento: lineas por periodo ' + JSON.stringify(cuenta) + ' | ms por consulta ' + JSON.stringify(tiempos) + ' | tipo:estado ' + JSON.stringify(tipos) + ' | POR PERIODO ' + JSON.stringify(porPeriodo) + ' | abierto=' + ab + ' cerrado=' + ce + ' en_cierre=' + (pm.collectionVariables.get('id_en_cierre') || '-') + ' | CERRADO sin fecha_cierre=' + (pm.collectionVariables.get('id_cerrado_sin_fecha') || '-'), () => {});",
              "};",
              "if (!pend) fin();",
              "// Secuencial (una consulta a la vez) y con el tiempo de cada una: evita saturar el servidor y deja evidencia si alguna tarda.",
              "const tiempos = {}; const tipos = {}; const porPeriodo = {};",
              "const siguiente = (k) => {",
              "  if (k >= cand.length) { return fin(); }",
              "  const id = cand[k];",
              "  pm.sendRequest({ url: pm.variables.get('base_url') + '/finanzas/lineas?id_periodo_contable=' + id, method: 'GET',",
              "    header: { Authorization: 'Bearer ' + pm.collectionVariables.get('tok_cont') } }, (e, r) => {",
              "    let l = []; try { l = r.json(); } catch (x) {}",
              "    cuenta[id] = Array.isArray(l) ? l.length : 0; tiempos[id] = r ? r.responseTime : -1; (Array.isArray(l) ? l : []).forEach(x => { const kt = x.tipo_evidencia + ':' + x.estado_trazabilidad; tipos[kt] = (tipos[kt] || 0) + 1; porPeriodo[id] = porPeriodo[id] || {}; porPeriodo[id][kt] = (porPeriodo[id][kt] || 0) + 1; });",
              "    siguiente(k + 1); });",
              "};",
              "if (!cand.length) { fin(); } else { siguiente(0); }",
              "pm.test('sin error 5xx', () => pm.expect(pm.response.code).to.be.below(500));",
              "pm.test('sin stack trace', () => pm.expect(pm.response.text()).to.not.match(/Traceback|sqlalchemy|psycopg|File \\\"\\//i));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tok_cont}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/finanzas/periodos",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "finanzas",
            "periodos"
          ]
        }
      }
    },
    {
      "name": "Comprobar sandbox con rollback (X-Test-Run-Id)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test(\"HTTP 200\", () => { pm.response.to.have.status(200); });",
              "const eco = pm.response.headers.get('X-Test-Run-Id');",
              "const ok = pm.variables.get('permitir_escritura') === 'SI' && !!pm.variables.get('sandbox_secret') && !!eco && eco === pm.collectionVariables.get('run_sandbox');",
              "pm.collectionVariables.set('sandbox_activo', ok ? 'SI' : '');",
              "pm.test('Sandbox con rollback: ' + (ok ? 'ACTIVO (las peticiones [escritura] corren en una transaccion que se revierte)' : 'NO ACTIVO (las peticiones [escritura] se omiten)'), () => {});",
              "pm.test('sin error 5xx', () => pm.expect(pm.response.code).to.be.below(500));",
              "pm.test('sin stack trace', () => pm.expect(pm.response.text()).to.not.match(/Traceback|sqlalchemy|psycopg|File \\\"\\//i));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tok_cont}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/finanzas/periodos",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "finanzas",
            "periodos"
          ]
        }
      }
    },
    {
      "name": "Linea para medir tiempos",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('id_periodo_lineas')) { console.log('PRECONDICION NO DISPONIBLE: no hay periodos con lineas'); pm.execution.skipRequest(); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test(\"HTTP 200\", () => { pm.response.to.have.status(200); });",
              "const l = (Array.isArray(j) ? j : [])[0]; pm.collectionVariables.set('linea_medir', l ? String(l.id_linea_asiento_nic41) : '');",
              "pm.test('sin error 5xx', () => pm.expect(pm.response.code).to.be.below(500));",
              "pm.test('sin stack trace', () => pm.expect(pm.response.text()).to.not.match(/Traceback|sqlalchemy|psycopg|File \\\"\\//i));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tok_cont}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/finanzas/lineas?id_periodo_contable={{id_periodo_lineas}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "finanzas",
            "lineas"
          ],
          "query": [
            {
              "key": "id_periodo_contable",
              "value": "{{id_periodo_lineas}}"
            }
          ]
        }
      }
    },
    {
      "name": "TC-91-064 Consulta de la cadena de una linea en <= 2 s (10 mediciones)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('linea_medir')) { console.log('PRECONDICION NO DISPONIBLE: no hay lineas'); pm.execution.skipRequest(); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test(\"HTTP 200\", () => { pm.response.to.have.status(200); });",
              "const t = [pm.response.responseTime]; let pend = 9;",
              "for (let i = 0; i < 9; i++) pm.sendRequest({ url: pm.variables.get('base_url') + '/finanzas/lineas/' + pm.collectionVariables.get('linea_medir') + '/cadena', method: 'GET',",
              "  header: (function () { var h = { Authorization: 'Bearer ' + pm.collectionVariables.get('tok_cont') }; if (pm.collectionVariables.get('sandbox_activo') === 'SI') { h['X-Test-Run-Id'] = pm.collectionVariables.get('run_sandbox'); h['X-Sandbox-Secret'] = pm.variables.get('sandbox_secret'); } return h; })() }, (e, r) => { t.push(r ? r.responseTime : 99999);",
              "  if (--pend === 0) { t.sort((a, b) => a - b); console.log('TIEMPOS_MS', JSON.stringify(t)); pm.test(\"percentil 90 <= 2000 ms (\" + t[8] + \" ms)\", () => pm.expect(t[8]).to.be.at.most(2000)); } });",
              "pm.test('sin error 5xx', () => pm.expect(pm.response.code).to.be.below(500));",
              "pm.test('sin stack trace', () => pm.expect(pm.response.text()).to.not.match(/Traceback|sqlalchemy|psycopg|File \\\"\\//i));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tok_cont}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/finanzas/lineas/{{linea_medir}}/cadena",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "finanzas",
            "lineas",
            "{{linea_medir}}",
            "cadena"
          ]
        }
      }
    },
    {
      "name": "TC-91-065/068 Verificacion masiva del periodo ABIERTO en <= 5 min [escritura]",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('id_abierto')) { console.log('PRECONDICION NO DISPONIBLE: no hay periodo ABIERTO'); pm.execution.skipRequest(); }",
              "if (pm.collectionVariables.get('sandbox_activo') !== 'SI') { console.log('ESCRITURA OMITIDA: requiere --env-var permitir_escritura=SI, --env-var sandbox_secret=... y el sandbox activo en TEST'); pm.execution.skipRequest(); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test(\"HTTP 200\", () => { pm.response.to.have.status(200); });",
              "console.log('LINEAS_VERIFICADAS', j.verificadas + (j.pendientes || []).length);",
              "pm.test(\"<= 300000 ms (\" + pm.response.responseTime + \" ms)\", () => pm.expect(pm.response.responseTime).to.be.at.most(300000));",
              "pm.test('sin error 5xx', () => pm.expect(pm.response.code).to.be.below(500));",
              "pm.test('sin stack trace', () => pm.expect(pm.response.text()).to.not.match(/Traceback|sqlalchemy|psycopg|File \\\"\\//i));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tok_cont}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/finanzas/periodos/{{id_abierto}}/trazabilidad",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "finanzas",
            "periodos",
            "{{id_abierto}}",
            "trazabilidad"
          ]
        }
      }
    },
    {
      "name": "Cerrar sandbox (rollback)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.collectionVariables.get('sandbox_activo') !== 'SI') { console.log('SANDBOX NO ACTIVO: nada que revertir'); pm.execution.skipRequest(); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test(\"HTTP 200\", () => { pm.response.to.have.status(200); });",
              "pm.test(\"Rollback exitoso\", () => { pm.expect(j.status).to.eql('Rollback exitoso'); });",
              "pm.test('sin error 5xx', () => pm.expect(pm.response.code).to.be.below(500));",
              "pm.test('sin stack trace', () => pm.expect(pm.response.text()).to.not.match(/Traceback|sqlalchemy|psycopg|File \\\"\\//i));"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tok_cont}}"
          },
          {
            "key": "X-Sandbox-Secret",
            "value": "{{sandbox_secret}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/test-control/runs/{{run_sandbox}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "test-control",
            "runs",
            "{{run_sandbox}}"
          ]
        }
      }
    }
