{
  "info": {
    "name": "TC-M06-G05 - RF-91 Verificación del precio de referencia y su fuente (Proceso 8, FA-2)",
    "description": "RF-91 TCG-05 (TC-91-027 a TC-91-030), adaptado a la API real /finanzas de origin/test. Ver ficha.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('run')) pm.collectionVariables.set('run', String(Date.now()).slice(-6));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Login cont",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test('login 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('tok_cont', j.token || '');",
              "pm.test('sin error 5xx', () => pm.expect(pm.response.code).to.be.below(500));",
              "pm.test('sin stack trace', () => pm.expect(pm.response.text()).to.not.match(/Traceback|sqlalchemy|psycopg|File \\\"\\//i));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/sesiones/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "sesiones",
            ""
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"{{correo_cont}}\",\n  \"contrasena\": \"{{clave_cont}}\"\n}"
        }
      }
    },
    {
      "name": "Descubrir periodos contables (Contador)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test(\"HTTP 200\", () => { pm.response.to.have.status(200); });",
              "const arr = Array.isArray(j) ? j : [];",
              "const de = (e) => arr.filter(x => x.estado === e).map(x => String(x.id_periodo_contable));",
              "// Si QA indica el período con --env-var periodo_abierto_qa / periodo_cerrado_qa / periodo_en_cierre_qa, se usa ese en vez del primero que aparezca.",
              "const qa = (k) => String(pm.environment.get(k) || '');",
              "pm.collectionVariables.set('id_abierto', qa('periodo_abierto_qa') || de('ABIERTO')[0] || '');",
              "pm.collectionVariables.set('id_en_cierre', qa('periodo_en_cierre_qa') || de('EN_CIERRE')[0] || '');",
              "pm.collectionVariables.set('id_cerrado', qa('periodo_cerrado_qa') || de('CERRADO')[0] || '');",
              "pm.collectionVariables.set('cerrados', JSON.stringify(de('CERRADO')));",
              "pm.collectionVariables.set('id_periodo_lineas', pm.collectionVariables.get('id_abierto') || pm.collectionVariables.get('id_cerrado') || '');",
              "console.log('PERIODOS', JSON.stringify({ total: arr.length, abiertos: de('ABIERTO'), en_cierre: de('EN_CIERRE'), cerrados: de('CERRADO') }));",
              "pm.test('sin error 5xx', () => pm.expect(pm.response.code).to.be.below(500));",
              "pm.test('sin stack trace', () => pm.expect(pm.response.text()).to.not.match(/Traceback|sqlalchemy|psycopg|File \\\"\\//i));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tok_cont}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/finanzas/periodos",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "finanzas",
            "periodos"
          ]
        }
      }
    },
    {
      "name": "Catalogo de precios de mercado (Contador)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test(\"HTTP 200\", () => { pm.response.to.have.status(200); });",
              "const m = {}; (Array.isArray(j) ? j : []).forEach(p => m[p.id_precio_mercado] = { fuente: p.fuente, evidencia: p.evidencia, justificacion: p.justificacion });",
              "pm.collectionVariables.set('precios', JSON.stringify(m));",
              "pm.test('sin error 5xx', () => pm.expect(pm.response.code).to.be.below(500));",
              "pm.test('sin stack trace', () => pm.expect(pm.response.text()).to.not.match(/Traceback|sqlalchemy|psycopg|File \\\"\\//i));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tok_cont}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/finanzas/precios",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "finanzas",
            "precios"
          ]
        }
      }
    },
    {
      "name": "TC-91-027..030 Nivel 3: precio documentado y fuente ESTIMADA con aprobacion",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('id_periodo_lineas')) { console.log('PRECONDICION NO DISPONIBLE: no hay periodos contables con lineas en TEST'); pm.execution.skipRequest(); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test(\"HTTP 200\", () => { pm.response.to.have.status(200); });",
              "const todas = Array.isArray(j) ? j : [];",
              "const sel = todas.filter(l => ['VERIFICADO','PENDIENTE_TRAZABILIDAD'].includes(l.estado_trazabilidad) && ['IOT_DIRECTO','REGISTRO_MANUAL','VARIACION_PRECIO'].includes(l.tipo_evidencia)).slice(0, 25);",
              "console.log('LINEAS', JSON.stringify({ periodo: pm.collectionVariables.get('id_periodo_lineas'), total: todas.length, seleccionadas: sel.length }));",
              "if (!sel.length) { pm.test.skip(\"el nivel 3 respeta fuente y evidencia (PRECONDICION NO DISPONIBLE: ninguna linea cumple el filtro)\", () => {}); }",
              "else {",
              "  const errores = []; let pend = sel.length;",
              "  sel.forEach(l => pm.sendRequest({ url: pm.variables.get('base_url') + '/finanzas/lineas/' + l.id_linea_asiento_nic41 + '/cadena', method: 'GET',",
              "    header: { Authorization: 'Bearer ' + pm.collectionVariables.get('tok_cont') } }, (e, r) => {",
              "    let c = {}; try { c = r.json(); } catch (x) {}",
              "    const falla = (m) => errores.push('linea ' + l.id_linea_asiento_nic41 + ' (' + l.tipo_evidencia + '): ' + m);",
              "    const es = (c && c.eslabones) || {};",
              "    try { const id = (es.ids || {}).id_precio_mercado; if (id) { const p = JSON.parse(pm.collectionVariables.get('precios') || '{}')[id];",
              "  if (!p) falla('precio ' + id + ' no aparece en el catalogo');",
              "  else { const doc = !!String(p.evidencia || '').trim();",
              "    if (es.precio_documentado === true && !doc) falla('precio sin evidencia dado por documentado');",
              "    if (p.fuente === 'ESTIMADA' && es.precio_documentado === true) falla('precio ESTIMADA aceptado: la matriz exige aprobacion registrada del Contador y el API no la expone'); } } } catch (x) { falla('error en el chequeo: ' + x.message); }",
              "    if (--pend === 0) { console.log('DETALLE', JSON.stringify(errores.slice(0, 20))); pm.test(\"el nivel 3 respeta fuente y evidencia\", () => { pm.expect(errores.length, errores.slice(0, 5).join(' | ')).to.eql(0); }); }",
              "  }));",
              "}",
              "pm.test('sin error 5xx', () => pm.expect(pm.response.code).to.be.below(500));",
              "pm.test('sin stack trace', () => pm.expect(pm.response.text()).to.not.match(/Traceback|sqlalchemy|psycopg|File \\\"\\//i));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tok_cont}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/finanzas/lineas?id_periodo_contable={{id_periodo_lineas}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "finanzas",
            "lineas"
          ],
          "query": [
            {
              "key": "id_periodo_contable",
              "value": "{{id_periodo_lineas}}"
            }
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "https://api.inmero.co/api-sgpmp-test"
    },
    {
      "key": "permitir_escritura",
      "value": "NO"
    },
    {
      "key": "tok_cont",
      "value": ""
    },
    {
      "key": "correo_cont",
      "value": ""
    },
    {
      "key": "clave_cont",
      "value": ""
    }
  ]
}
