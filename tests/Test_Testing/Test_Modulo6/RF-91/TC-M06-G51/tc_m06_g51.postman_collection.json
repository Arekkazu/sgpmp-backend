    {
      "name": "TC-91-027..030 Nivel 3: precio documentado y fuente ESTIMADA con aprobacion",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('id_periodo_lineas')) { console.log('PRECONDICION NO DISPONIBLE: no hay periodos contables con lineas en TEST'); pm.execution.skipRequest(); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test(\"HTTP 200\", () => { pm.response.to.have.status(200); });",
              "const hdr = (function () { var h = { Authorization: 'Bearer ' + pm.collectionVariables.get('tok_cont') }; if (pm.collectionVariables.get('sandbox_activo') === 'SI') { h['X-Test-Run-Id'] = pm.collectionVariables.get('run_sandbox'); h['X-Sandbox-Secret'] = pm.variables.get('sandbox_secret'); } return h; })();",
              "const base = pm.variables.get('base_url');",
              "const todas = Array.isArray(j) ? j.slice() : [];",
              "const otros = JSON.parse(pm.collectionVariables.get('periodos_lineas') || '[]').filter(p => p !== pm.collectionVariables.get('id_periodo_lineas'));",
              "const cargarOtros = (k, fin) => {",
              "  if (k >= otros.length) { return fin(); }",
              "  pm.sendRequest({ url: base + '/finanzas/lineas?id_periodo_contable=' + otros[k], method: 'GET', header: hdr }, (e, r) => {",
              "    let l = []; try { l = r.json(); } catch (x) {}",
              "    (Array.isArray(l) ? l : []).forEach(x => todas.push(x));",
              "    cargarOtros(k + 1, fin); });",
              "};",
              "cargarOtros(0, () => {",
              "  const sel = todas.filter(l => ['VERIFICADO','PENDIENTE_TRAZABILIDAD'].includes(l.estado_trazabilidad) && ['IOT_DIRECTO','REGISTRO_MANUAL','VARIACION_PRECIO'].includes(l.tipo_evidencia)).slice(0, 25);",
              "  console.log('LINEAS', JSON.stringify({ periodos: [pm.collectionVariables.get('id_periodo_lineas')].concat(otros), total: todas.length, seleccionadas: sel.length }));",
              "  if (!sel.length) { pm.test.skip(\"el nivel 3 respeta fuente y evidencia (PRECONDICION NO DISPONIBLE: ninguna linea cumple el filtro; total revisadas \" + todas.length + \")\", () => {}); return; }",
              "  const errores = [];",
              "  const siguiente = (k) => {",
              "    if (k >= sel.length) { console.log('DETALLE', JSON.stringify(errores.slice(0, 20))); pm.test(\"el nivel 3 respeta fuente y evidencia (\" + sel.length + \" lineas)\", () => { pm.expect(errores.length, errores.slice(0, 5).join(' | ')).to.eql(0); }); return; }",
              "    const l = sel[k];",
              "    pm.sendRequest({ url: base + '/finanzas/lineas/' + l.id_linea_asiento_nic41 + '/cadena', method: 'GET', header: hdr }, (e, r) => {",
              "      let c = {}; try { c = r.json(); } catch (x) {}",
              "      const falla = (m) => errores.push('linea ' + l.id_linea_asiento_nic41 + ' (' + l.tipo_evidencia + '): ' + m);",
              "      const es = (c && c.eslabones) || {};",
              "      try { const id = (es.ids || {}).id_precio_mercado; if (id) { const p = JSON.parse(pm.collectionVariables.get('precios') || '{}')[id];",
              "  if (!p) falla('precio ' + id + ' no aparece en el catalogo');",
              "  else { const doc = !!String(p.evidencia || '').trim();",
              "    if (es.precio_documentado === true && !doc) falla('precio sin evidencia dado por documentado');",
              "    if (p.fuente === 'ESTIMADA' && es.precio_documentado === true) falla('precio ESTIMADA aceptado: la matriz exige aprobacion registrada del Contador y el API no la expone'); } } } catch (x) { falla('error en el chequeo: ' + x.message); }",
              "      siguiente(k + 1); });",
              "  };",
              "  siguiente(0);",
              "});",
              "pm.test('sin error 5xx', () => pm.expect(pm.response.code).to.be.below(500));",
              "pm.test('sin stack trace', () => pm.expect(pm.response.text()).to.not.match(/Traceback|sqlalchemy|psycopg|File \\\"\\//i));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tok_cont}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/finanzas/lineas?id_periodo_contable={{id_periodo_lineas}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "finanzas",
            "lineas"
          ],
          "query": [
            {
              "key": "id_periodo_contable",
              "value": "{{id_periodo_lineas}}"
            }
          ]
        }
      }
    },
