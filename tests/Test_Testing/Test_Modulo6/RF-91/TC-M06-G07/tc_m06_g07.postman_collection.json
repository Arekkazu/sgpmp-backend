              "const eco = pm.response.headers.get('X-Test-Run-Id');",
              "const ok = pm.variables.get('permitir_escritura') === 'SI' && !!pm.variables.get('sandbox_secret') && !!eco && eco === pm.collectionVariables.get('run_sandbox');",
              "pm.collectionVariables.set('sandbox_activo', ok ? 'SI' : '');",
              "pm.test('Sandbox con rollback: ' + (ok ? 'ACTIVO (las peticiones [escritura] corren en una transaccion que se revierte)' : 'NO ACTIVO (las peticiones [escritura] se omiten)'), () => {});",
              "pm.test('sin error 5xx', () => pm.expect(pm.response.code).to.be.below(500));",
              "pm.test('sin stack trace', () => pm.expect(pm.response.text()).to.not.match(/Traceback|sqlalchemy|psycopg|File \\\"\\//i));"
            ]
          }
