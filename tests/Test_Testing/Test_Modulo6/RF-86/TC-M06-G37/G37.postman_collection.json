{
  "info": {
    "name": "TC-M06-G37 RF-86",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "acumulado",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{contador_token}}"
          },
          {
            "key": "X-Test-Run-Id",
            "value": "{{run_id}}"
          },
          {
            "key": "X-Sandbox-Secret",
            "value": "{{sandbox_secret}}"
          }
        ],
        "url": "{{base_url}}/finanzas/periodos/{{periodo}}/estado-resultados/acumulado"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 o defecto conocido 422', () => pm.expect(pm.response.code === 200 || (pm.response.code === 422 && pm.response.json().error_code === 'PERIODO_NO_CERRADO')).to.equal(true));",
              "pm.test('Eco del RUN', () => pm.expect(pm.response.headers.get('X-Test-Run-Id')).to.equal(pm.environment.get('run_id')));",
              "if (pm.response.code === 200) pm.test('Acumulado RF-86', () => pm.expect(pm.response.json()).to.have.property('componentes'));"
            ]
          }
        }
      ]
    },
    {
      "name": "cadena",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{contador_token}}"
          },
          {
            "key": "X-Test-Run-Id",
            "value": "{{run_id}}"
          },
          {
            "key": "X-Sandbox-Secret",
            "value": "{{sandbox_secret}}"
          }
        ],
        "url": "{{base_url}}/finanzas/lineas/{{linea}}/cadena"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.expect(pm.response.code).to.equal(200));",
              "pm.test('Eco del RUN', () => pm.expect(pm.response.headers.get('X-Test-Run-Id')).to.equal(pm.environment.get('run_id')));",
              "pm.test('Cadena navegable', () => pm.expect(pm.response.json()).to.have.property('eslabones'));"
            ]
          }
        }
      ]
    }
  ]
}
