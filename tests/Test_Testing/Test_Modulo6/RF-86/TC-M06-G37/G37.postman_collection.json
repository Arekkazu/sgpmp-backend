    ], "url": "{{base_url}}/finanzas/auditoria?id_periodo_contable={{periodo}}&tipo_evento=VARIACION_REGISTRADA&formato=TECNICO&pagina=1&tamano=500" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
