  "info": { "name": "TC-M06-G37 RF-86", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "item": [
    { "name": "estados_get", "request": { "method": "GET", "header": [
      { "key": "Authorization", "value": "Bearer {{contador_token}}" },
      { "key": "X-Test-Run-Id", "value": "{{run_id}}" },
      { "key": "X-Sandbox-Secret", "value": "{{sandbox_secret}}" }
    ], "url": "{{base_url}}/finanzas/periodos/{{periodo}}/estados-resultados" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
      "pm.test('HTTP 200', () => pm.expect(pm.response.code).to.equal(200));",
