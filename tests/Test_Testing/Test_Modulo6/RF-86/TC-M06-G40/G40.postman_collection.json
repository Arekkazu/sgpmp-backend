{
  "info": {"name":"TC-M06-G40 — lecturas posteriores","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "item": [
    {"name":"configuracion","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{contador_token}}"},{"key":"X-Test-Run-Id","value":"{{run_id}}"},{"key":"X-Sandbox-Secret","value":"{{sandbox_secret}}"}],"url":"{{base_url}}/finanzas/configuracion"},"event":[{"listen":"test","script":{"exec":["pm.test('HTTP 200 y conteo',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().lineas_pendientes_cuenta).to.be.a('number')})","pm.test('eco RUN',()=>pm.expect(pm.response.headers.get('x-test-run-id')).to.eql(pm.environment.get('run_id')))"]}}]},
    {"name":"lineas_pendientes","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{contador_token}}"},{"key":"X-Test-Run-Id","value":"{{run_id}}"},{"key":"X-Sandbox-Secret","value":"{{sandbox_secret}}"}],"url":"{{base_url}}/finanzas/lineas?id_periodo_contable={{periodo}}&estado=PENDIENTE_CUENTA"},"event":[{"listen":"test","script":{"exec":["pm.test('HTTP 200 y lista pendiente',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json()).to.be.an('array');pm.response.json().forEach(x=>pm.expect(x.estado).to.eql('PENDIENTE_CUENTA'))})","pm.test('eco RUN',()=>pm.expect(pm.response.headers.get('x-test-run-id')).to.eql(pm.environment.get('run_id')))"]}}]},
    {"name":"bandeja","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{contador_token}}"},{"key":"X-Test-Run-Id","value":"{{run_id}}"},{"key":"X-Sandbox-Secret","value":"{{sandbox_secret}}"}],"url":"{{base_url}}/notificaciones?pagina=1&tamano=50"},"event":[{"listen":"test","script":{"exec":["pm.test('HTTP 200 y bandeja',()=>{pm.response.to.have.status(200);let x=pm.response.json();pm.expect(x.items).to.be.an('array');pm.expect(x.total).to.be.a('number')})","pm.test('eco RUN',()=>pm.expect(pm.response.headers.get('x-test-run-id')).to.eql(pm.environment.get('run_id')))"]}}]}
  ]
}
