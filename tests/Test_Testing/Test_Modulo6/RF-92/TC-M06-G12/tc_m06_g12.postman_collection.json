    {
      "name": "TC-92-081 El informe no muestra terminologia interna",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('inf_APROBADO')) { console.log('PRECONDICION NO DISPONIBLE: no hay informe APROBADO en TEST'); pm.execution.skipRequest(); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test(\"HTTP 200\", () => { pm.response.to.have.status(200); });",
              "const k = j.contenido || {};",
              "const textos = []; const rec = (v) => { if (typeof v === 'string') textos.push(v); else if (v && typeof v === 'object') Object.values(v).forEach(rec); }; rec(k);",
              "pm.test(\"los textos del informe no contienen RF-xx, M0x, Modulo N, undefined ni #id\", () => { textos.forEach(t => pm.expect(t).to.not.match(/\\bRF-\\d|\\bM0\\d\\b|M[oó]dulo \\d|undefined|#\\d+/)); });",
              "pm.test(\"los nombres de seccion que se imprimen no son claves internas\", () => { Object.keys(k).forEach(s => pm.expect(s, 'seccion ' + s).to.not.match(/^(parr|niif)\\d*_/)); });",
              "pm.test('sin error 5xx', () => pm.expect(pm.response.code).to.be.below(500));",
              "pm.test('sin stack trace', () => pm.expect(pm.response.text()).to.not.match(/Traceback|sqlalchemy|psycopg|File \\\"\\//i));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tok_cont}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/finanzas/revelaciones/{{inf_APROBADO}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "finanzas",
            "revelaciones",
            "{{inf_APROBADO}}"
          ]
        }
      }
    },
    {
      "name": "TC-92-076 Generacion del BORRADOR en <= 30 s [escritura]",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('id_cerrado')) { console.log('PRECONDICION NO DISPONIBLE: no hay periodo CERRADO'); pm.execution.skipRequest(); }",
              "if (pm.variables.get('permitir_escritura') !== 'SI') { console.log('ESCRITURA NO AUTORIZADA: ejecutar con --env-var permitir_escritura=SI'); pm.execution.skipRequest(); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test(\"HTTP 201\", () => { pm.response.to.have.status(201); });",
              "pm.test(\"<= 30000 ms (\" + pm.response.responseTime + \" ms)\", () => pm.expect(pm.response.responseTime).to.be.at.most(30000));",
              "pm.test('sin error 5xx', () => pm.expect(pm.response.code).to.be.below(500));",
              "pm.test('sin stack trace', () => pm.expect(pm.response.text()).to.not.match(/Traceback|sqlalchemy|psycopg|File \\\"\\//i));"
            ]
          }
        }
