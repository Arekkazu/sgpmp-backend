{
  "info": {
    "name": "TC-M06-G66 - RF-92 Validación de consistencia entre fuentes y continuidad con justificación (CA-8, FA-2, Proc",
    "description": "RF-92 TCG-08 (TC-92-044 a TC-92-051), adaptado a la API real /finanzas de origin/test. Ver ficha.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('run')) pm.collectionVariables.set('run', String(Date.now()).slice(-6));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Login cont",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test('login 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('tok_cont', j.token || '');",
              "pm.test('sin error 5xx', () => pm.expect(pm.response.code).to.be.below(500));",
              "pm.test('sin stack trace', () => pm.expect(pm.response.text()).to.not.match(/Traceback|sqlalchemy|psycopg|File \\\"\\//i));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/sesiones/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "sesiones",
            ""
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"{{correo_cont}}\",\n  \"contrasena\": \"{{clave_cont}}\"\n}"
        }
      }
    },
    {
      "name": "Descubrir periodos contables (Contador)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test(\"HTTP 200\", () => { pm.response.to.have.status(200); });",
              "const arr = Array.isArray(j) ? j : [];",
              "const de = (e) => arr.filter(x => x.estado === e).map(x => String(x.id_periodo_contable));",
              "// Si QA indica el período con --env-var periodo_abierto_qa / periodo_cerrado_qa / periodo_en_cierre_qa, se usa ese en vez del primero que aparezca.",
              "const qa = (k) => String(pm.environment.get(k) || '');",
              "pm.collectionVariables.set('id_abierto', qa('periodo_abierto_qa') || de('ABIERTO')[0] || '');",
              "pm.collectionVariables.set('id_en_cierre', qa('periodo_en_cierre_qa') || de('EN_CIERRE')[0] || '');",
              "pm.collectionVariables.set('id_cerrado', qa('periodo_cerrado_qa') || de('CERRADO')[0] || '');",
              "pm.collectionVariables.set('cerrados', JSON.stringify(de('CERRADO')));",
              "pm.collectionVariables.set('id_periodo_lineas', pm.collectionVariables.get('id_abierto') || pm.collectionVariables.get('id_cerrado') || '');",
              "console.log('PERIODOS', JSON.stringify({ total: arr.length, abiertos: de('ABIERTO'), en_cierre: de('EN_CIERRE'), cerrados: de('CERRADO') }));",
              "pm.test('sin error 5xx', () => pm.expect(pm.response.code).to.be.below(500));",
              "pm.test('sin stack trace', () => pm.expect(pm.response.text()).to.not.match(/Traceback|sqlalchemy|psycopg|File \\\"\\//i));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tok_cont}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/finanzas/periodos",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "finanzas",
            "periodos"
          ]
        }
      }
    },
    {
      "name": "Descubrir informes de revelaciones (Contador)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('id_cerrado')) { console.log('PRECONDICION NO DISPONIBLE: no hay periodo CERRADO en TEST'); pm.execution.skipRequest(); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test(\"HTTP 200\", () => { pm.response.to.have.status(200); });",
              "const cerrados = JSON.parse(pm.collectionVariables.get('cerrados') || '[]');",
              "const hallados = {};",
              "let pend = cerrados.length;",
              "const fin = () => { ['BORRADOR','APROBADO','ARCHIVADO','RECHAZADO'].forEach(e => pm.collectionVariables.set('inf_' + e, hallados[e] ? String(hallados[e].id_informe) : ''));",
              "  pm.collectionVariables.set('inf_periodo_aprobado', hallados.APROBADO ? String(hallados.APROBADO.p) : '');",
              "  console.log('INFORMES', JSON.stringify(hallados)); };",
              "if (!pend) fin();",
              "cerrados.forEach(p => pm.sendRequest({ url: pm.variables.get('base_url') + '/finanzas/periodos/' + p + '/revelaciones', method: 'GET',",
              "  header: { Authorization: 'Bearer ' + pm.collectionVariables.get('tok_cont') } }, (e, r) => {",
              "  let l = []; try { l = r.json(); } catch (x) {}",
              "  (Array.isArray(l) ? l : []).forEach(i => { if (!hallados[i.estado] || i.id_informe > hallados[i.estado].id_informe) hallados[i.estado] = { id_informe: i.id_informe, p: p, version: i.version_informe }; });",
              "  if (--pend === 0) fin(); }));",
              "pm.test('sin error 5xx', () => pm.expect(pm.response.code).to.be.below(500));",
              "pm.test('sin stack trace', () => pm.expect(pm.response.text()).to.not.match(/Traceback|sqlalchemy|psycopg|File \\\"\\//i));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tok_cont}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/finanzas/periodos/{{id_cerrado}}/revelaciones",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "finanzas",
            "periodos",
            "{{id_cerrado}}",
            "revelaciones"
          ]
        }
      }
    },
    {
      "name": "TC-92-044..049/050 Alertas de consistencia y justificacion en el informe",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('inf_APROBADO')) { console.log('PRECONDICION NO DISPONIBLE: no hay informe APROBADO en TEST'); pm.execution.skipRequest(); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test(\"HTTP 200\", () => { pm.response.to.have.status(200); });",
              "const k = j.contenido || {};",
              "const al = (k.alertas_consistencia || []);",
              "pm.collectionVariables.set('periodo_alertas', al.length ? String(j.id_periodo_contable) : '');",
              "pm.test(\"TC-92-050 si hay alertas, el informe guarda una justificacion de al menos 20 caracteres\", () => { if (al.length) pm.expect(String(k.justificacion_inconsistencias || '').trim().length).to.be.at.least(20); });",
              "pm.test(\"TC-92-044 cuadre con el estado de resultados (sin alerta de estado no generado)\", () => pm.expect(al.map(a => a.campo)).to.not.include('estado_resultados'));",
              "pm.test('sin error 5xx', () => pm.expect(pm.response.code).to.be.below(500));",
              "pm.test('sin stack trace', () => pm.expect(pm.response.text()).to.not.match(/Traceback|sqlalchemy|psycopg|File \\\"\\//i));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tok_cont}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/finanzas/revelaciones/{{inf_APROBADO}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "finanzas",
            "revelaciones",
            "{{inf_APROBADO}}"
          ]
        }
      }
    },
    {
      "name": "TC-92-046 Continuar con alertas deja ERROR_CONSISTENCIA en la auditoria",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('periodo_alertas')) { console.log('PRECONDICION NO DISPONIBLE: no se encontro el dato periodo_alertas en TEST'); pm.execution.skipRequest(); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test(\"HTTP 200\", () => { pm.response.to.have.status(200); });",
              "const ev = Array.isArray(j.eventos) ? j.eventos : [];",
              "console.log('AUDITORIA', 'ERROR_CONSISTENCIA', j.total_registros);",
              "if (!pm.collectionVariables.get('periodo_alertas')) pm.test.skip(\"ERROR_CONSISTENCIA (PRECONDICION: el informe no tiene alertas)\", () => {});",
              "else pm.test(\"hay al menos un ERROR_CONSISTENCIA con su justificacion\", () => { pm.expect(ev.length).to.be.at.least(1); pm.expect(ev[0].payload_evento.justificacion).to.be.a('string'); });",
              "pm.test('sin error 5xx', () => pm.expect(pm.response.code).to.be.below(500));",
              "pm.test('sin stack trace', () => pm.expect(pm.response.text()).to.not.match(/Traceback|sqlalchemy|psycopg|File \\\"\\//i));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tok_cont}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/finanzas/auditoria?tipo_evento=ERROR_CONSISTENCIA&id_periodo_contable={{periodo_alertas}}&formato=TECNICO&orden=DESC&tamano=100",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "finanzas",
            "auditoria"
          ],
          "query": [
            {
              "key": "tipo_evento",
              "value": "ERROR_CONSISTENCIA"
            },
            {
              "key": "id_periodo_contable",
              "value": "{{periodo_alertas}}"
            },
            {
              "key": "formato",
              "value": "TECNICO"
            },
            {
              "key": "orden",
              "value": "DESC"
            },
            {
              "key": "tamano",
              "value": "100"
            }
          ]
        }
      }
    },
    {
      "name": "TC-92-051 Continuar con justificacion de 1 caracter -> 409 [escritura si no hay alertas]",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('periodo_alertas')) { console.log('PRECONDICION NO DISPONIBLE: el informe no tiene alertas'); pm.execution.skipRequest(); }",
              "if (pm.variables.get('permitir_escritura') !== 'SI') { console.log('ESCRITURA NO AUTORIZADA: ejecutar con --env-var permitir_escritura=SI'); pm.execution.skipRequest(); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test(\"HTTP 409\", () => { pm.response.to.have.status(409); });",
              "pm.test(\"error_code ALERTA_CONSISTENCIA\", () => { pm.expect(j.error_code).to.eql('ALERTA_CONSISTENCIA'); });",
              "pm.test('sin error 5xx', () => pm.expect(pm.response.code).to.be.below(500));",
              "pm.test('sin stack trace', () => pm.expect(pm.response.text()).to.not.match(/Traceback|sqlalchemy|psycopg|File \\\"\\//i));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tok_cont}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/finanzas/periodos/{{periodo_alertas}}/revelaciones",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "finanzas",
            "periodos",
            "{{periodo_alertas}}",
            "revelaciones"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"declaracion_sin_novedad\":true,\"justificacion_inconsistencias\":\"x\"}"
        }
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "https://api.inmero.co/api-sgpmp-test"
    },
    {
      "key": "permitir_escritura",
      "value": "NO"
    },
    {
      "key": "tok_cont",
      "value": ""
    },
    {
      "key": "correo_cont",
      "value": ""
    },
    {
      "key": "clave_cont",
      "value": ""
    }
  ]
}
