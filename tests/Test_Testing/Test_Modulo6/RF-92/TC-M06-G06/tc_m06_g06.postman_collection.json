              "pm.test(\"HTTP 200\", () => { pm.response.to.have.status(200); });",
              "const k = j.contenido || {};",
              "const r = k.parr_53_riesgos || []; const cats = r.map(x => x.categoria);",
              "pm.test(\"TC-92-032 la seccion de compromisos existe con su declaracion\", () => pm.expect(k.parr_49_restricciones_compromisos).to.have.property('declaracion_sin_novedad'));",
