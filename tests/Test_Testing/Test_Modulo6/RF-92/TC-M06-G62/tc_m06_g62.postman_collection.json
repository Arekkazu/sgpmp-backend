    {
      "name": "TC-92-018..024 Cuadre del rollforward (informe nuevo, BORRADOR)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('inf_G62')) { console.log('PRECONDICION NO DISPONIBLE: no se genero el informe (escritura no autorizada)'); pm.execution.skipRequest(); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test(\"HTTP 200\", () => { pm.response.to.have.status(200); });",
              "const k = j.contenido || {};",
              "const n = (v) => Number(v || 0);",
              "const rf = k.parr_50_conciliacion || [];",
              "pm.test(\"TC-92-018..021 cada activo cuadra: inicio + entradas +/- variaciones - salidas = cierre\", () => { rf.forEach(r => { const c = n(r.valor_inicio) + n(r.compras) + n(r.nacimientos_y_otros_ingresos) + n(r.transformacion_biologica) + n(r.precio_mercado) - n(r.cosechas) - n(r.bajas) - n(r.depreciacion_y_deterioro) + n(r.asientos_trasladados_por_cierre);",
              "  pm.expect(Math.abs(c - n(r.valor_cierre)), 'activo ' + r.identificador + ': ' + c.toFixed(2) + ' vs ' + n(r.valor_cierre)).to.be.at.most(0.01); }); });",
              "const porEsp = {}; rf.forEach(r => { porEsp[r.especie] = porEsp[r.especie] || { n: 0, v: 0 }; porEsp[r.especie].n++; porEsp[r.especie].v += n(r.valor_cierre); });",
              "pm.test(\"TC-92-022/023 la suma individual coincide con la agregacion por especie\", () => { (k.parr_41_43_descripcion || []).forEach(d => { const p = porEsp[d.especie] || { n: 0, v: 0 }; pm.expect(d.cantidad_activos, d.especie).to.eql(p.n); pm.expect(Math.abs(n(d.valor_cierre) - p.v), d.especie).to.be.at.most(0.01); }); });",
              "pm.test(\"TC-92-024 agregacion por especie o categoria (RF-92: «especie o categoría»)\", () => { (k.parr_41_43_descripcion || []).forEach(d => pm.expect(d.categoria || d.especie, \"agrupacion de \" + JSON.stringify(d.especie)).to.be.ok); });",
              "pm.test('sin error 5xx', () => pm.expect(pm.response.code).to.be.below(500));",
              "pm.test('sin stack trace', () => pm.expect(pm.response.text()).to.not.match(/Traceback|sqlalchemy|psycopg|File \\\"\\//i));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
