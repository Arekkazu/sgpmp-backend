              "  pm.expect(Math.abs(c - n(r.valor_cierre)), 'activo ' + r.identificador + ': ' + c.toFixed(2) + ' vs ' + n(r.valor_cierre)).to.be.at.most(0.01); }); });",
              "const porEsp = {}; rf.forEach(r => { porEsp[r.especie] = porEsp[r.especie] || { n: 0, v: 0 }; porEsp[r.especie].n++; porEsp[r.especie].v += n(r.valor_cierre); });",
