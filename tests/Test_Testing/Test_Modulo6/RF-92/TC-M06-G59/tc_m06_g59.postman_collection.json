        "url": {
          "raw": "{{base_url}}/finanzas/revelaciones/{{inf_BORRADOR}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "finanzas",
            "revelaciones",
            "{{inf_BORRADOR}}"
          ]
        }
      }
    },
