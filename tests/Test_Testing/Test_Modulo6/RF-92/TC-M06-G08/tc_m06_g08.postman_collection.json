{
  "info": {
    "name": "TC-M06-G08 - RF-92 Validación de consistencia entre fuentes y continuidad con justificación (CA-8, FA-2, Proc",
    "description": "RF-92 TCG-08 (TC-92-044 a TC-92-051), adaptado a la API real /finanzas de origin/test. Ver ficha.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('run')) pm.collectionVariables.set('run', String(Date.now()).slice(-6));",
          "if (!pm.collectionVariables.get('run_sandbox')) pm.collectionVariables.set('run_sandbox', 'qa-m06-rf92g08-' + Date.now());",
          "if (pm.variables.get('permitir_escritura') === 'SI' && pm.variables.get('sandbox_secret') && !/^(Login|Descubrir periodos|Cerrar sandbox)/.test(pm.info.requestName)) { pm.request.headers.upsert({ key: 'X-Test-Run-Id', value: pm.collectionVariables.get('run_sandbox') }); pm.request.headers.upsert({ key: 'X-Sandbox-Secret', value: pm.variables.get('sandbox_secret') }); }"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Login cont",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j=(()=>{try{return pm.response.json()}catch(e){return {}}})();",
              "pm.test('login 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('tok_cont', j.token || '');",
              "pm.test('sin error 5xx', () => pm.expect(pm.response.code).to.be.below(500));",
              "pm.test('sin stack trace', () => pm.expect(pm.response.text()).to.not.match(/Traceback|sqlalchemy|psycopg|File \\\"\\//i));"
            ]
          }
        }
      ],
