    {
      "name": "periodos",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{contador_token}}"
          },
          {
            "key": "X-Test-Run-Id",
            "value": "{{run_id}}"
          },
          {
            "key": "X-Sandbox-Secret",
            "value": "{{sandbox_secret}}"
          }
        ],
        "url": "{{base_url}}/finanzas/periodos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.expect(pm.response.code).to.equal(200));",
              "pm.test('respuesta array',()=>pm.expect(pm.response.json()).to.be.an('array'));",
              "pm.test('sin secretos en URL',()=>pm.expect(pm.request.url.toString()).not.to.match(/Bearer|secret/i));"
            ]
          }
        }
      ]
    },
