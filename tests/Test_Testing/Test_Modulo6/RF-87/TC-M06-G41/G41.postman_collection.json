{
  "info":{"name":"TC-M06-G41 RF-87","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "item":[
    {"name":"periodos","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{contador_token}}"},{"key":"X-Test-Run-Id","value":"{{run_id}}"},{"key":"X-Sandbox-Secret","value":"{{sandbox_secret}}"}],"url":"{{base_url}}/finanzas/periodos"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('HTTP 200',()=>pm.expect(pm.response.code).to.equal(200));","pm.test('periodos array',()=>pm.expect(pm.response.json()).to.be.an('array'));","pm.test('RUN',()=>pm.expect(pm.response.headers.get('X-Test-Run-Id')).to.equal(pm.environment.get('run_id')));"]}}]},
    {"name":"mediciones","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{contador_token}}"},{"key":"X-Test-Run-Id","value":"{{run_id}}"},{"key":"X-Sandbox-Secret","value":"{{sandbox_secret}}"}],"url":"{{base_url}}/finanzas/periodos/{{periodo}}/mediciones"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('HTTP 200',()=>pm.expect(pm.response.code).to.equal(200));","pm.test('mediciones array y decimales',()=>{const x=pm.response.json();pm.expect(x).to.be.an('array');x.forEach(m=>{pm.expect(m.id_activo_biologico).to.be.a('number');['valor_razonable_anterior','valor_razonable_actual','variacion_total'].forEach(k=>pm.expect(String(m[k])).to.match(/^-?\\d+(\\.\\d+)?$/));});});"]}}]},
    {"name":"estados_resultados","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{contador_token}}"},{"key":"X-Test-Run-Id","value":"{{run_id}}"},{"key":"X-Sandbox-Secret","value":"{{sandbox_secret}}"}],"url":"{{base_url}}/finanzas/periodos/{{periodo}}/estados-resultados"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('HTTP 200',()=>pm.expect(pm.response.code).to.equal(200));","pm.test('estado con resultado neto',()=>{const x=pm.response.json();pm.expect(x).to.be.an('array');pm.expect(x.length).above(0);pm.expect(String(x[0].resultado_neto)).to.match(/^-?\\d+(\\.\\d+)?$/);});"]}}]},
    {"name":"revelaciones","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{contador_token}}"},{"key":"X-Test-Run-Id","value":"{{run_id}}"},{"key":"X-Sandbox-Secret","value":"{{sandbox_secret}}"}],"url":"{{base_url}}/finanzas/periodos/{{periodo}}/revelaciones"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('HTTP 200',()=>pm.expect(pm.response.code).to.equal(200));","pm.test('revelaciones array',()=>{const x=pm.response.json();pm.expect(x).to.be.an('array');pm.expect(x.length).above(0);});"]}}]}
  ]
