{
  "info": {
    "name": "TC-M06-G115",
    "description": "Consultas de permisos y el POST del Productor. No incluye el alta válida: esa operación persiste una cotización en el período compartido.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "base", "value": "https://api.inmero.co/api-sgpmp-test"},
    {"key": "token_productor", "value": ""}
  ],
  "item": [
    {
      "name": "Login Productor",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "X-Zona-Horaria", "value": "America/Bogota"}],
        "url": "{{base}}/sesiones/",
        "body": {"mode": "raw", "raw": "{\n  \"correo_electronico\": \"{{correo_productor}}\",\n  \"contrasena\": \"{{contrasena}}\"\n}"}
      }
    },
    {
      "name": "Permisos del Productor",
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{token_productor}}"}, {"key": "X-Zona-Horaria", "value": "America/Bogota"}],
        "url": "{{base}}/sesiones/me/permisos"
      }
    },
    {
      "name": "POST cotización denegado al Productor",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Authorization", "value": "Bearer {{token_productor}}"},
          {"key": "Content-Type", "value": "application/json"},
          {"key": "X-Zona-Horaria", "value": "America/Bogota"}
        ],
        "url": "{{base}}/finanzas/cotizaciones",
        "body": {"mode": "raw", "raw": "{\n  \"activos_cotizados\": [{{id_activo}}],\n  \"valor_cotizacion_propuesto\": \"1000.0000\"\n}"}
      }
    }
  ]
}
