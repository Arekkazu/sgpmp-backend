{
  "info": {
    "name": "RF-11 - TC-M01-075 Consultar listado de usuarios (Administrador)",
    "description": "Login con cuenta Administrador real (admin@pecuaria.co) y consulta GET /usuarios/admin. Se espera 200 con el listado de usuarios, confirmando que el backend permite el acceso cuando el rol SI tiene el permiso.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Paso 1 - Login Administrador",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login exitoso (200)', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('token_admin', json.token);",
              "",
              "const partes = json.token.split('.');",
              "const payload = JSON.parse(atob(partes[1].replace(/-/g, '+').replace(/_/g, '/')));",
              "console.log('Login OK. rol en el JWT: ' + payload.rol);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"correo_electronico\": \"admin@pecuaria.co\",\n  \"contrasena\": \"Test1234!\"\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{base_url}}/sesiones/", "host": ["{{base_url}}"], "path": ["sesiones", ""] }
      },
      "response": []
    },
    {
      "name": "Paso 2 - TC-M01-075 - GET /usuarios/admin con permiso valido (debe aceptar, 200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('TC-M01-075: acceso permitido (200)', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "let json; try { json = pm.response.json(); } catch (e) { json = null; }",
              "pm.test('TC-M01-075: la respuesta contiene un listado (array)', function () {",
              "    const esArray = Array.isArray(json);",
              "    const tieneArrayAdentro = json && (Array.isArray(json.items) || Array.isArray(json.usuarios) || Array.isArray(json.data) || Array.isArray(json.results));",
              "    pm.expect(esArray || tieneArrayAdentro).to.be.true;",
              "});",
              "",
              "console.log('Paso 2 (listado): ' + pm.response.code);",
              "console.log('Body (primeros 500 caracteres): ' + pm.response.text().substring(0, 500));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
        "url": { "raw": "{{base_url}}/usuarios/admin", "host": ["{{base_url}}"], "path": ["usuarios", "admin"] }
      },
      "response": []
    }
  ],
  "variable": [
    { "key": "base_url", "value": "https://sigab-backendtest-389pcb-a48238-158-69-200-27.sslip.io/api-sgpmp-test" },
    { "key": "token_admin", "value": "" }
  ]
}