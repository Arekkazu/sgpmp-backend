    {
      "name": "TC-M01-080 - Consultar listado de usuarios y verificar orden descendente",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const runId = pm.collectionVariables.get('run_id');",
              "const correoAntiguo = 'tc080.antiguo.' + runId + '@sgpmp-test.com';",
              "const correoIntermedio = 'tc080.intermedio.' + runId + '@sgpmp-test.com';",
              "const correoReciente = 'tc080.reciente.' + runId + '@sgpmp-test.com';",
              "",
              "console.log('--- Usuarios de prueba esperados (de mas reciente a mas antiguo) ---');",
              "console.log('1. ' + correoReciente);",
              "console.log('2. ' + correoIntermedio);",
              "console.log('3. ' + correoAntiguo);",
              "",
              "pm.test('TC-M01-080: la consulta del listado de usuarios responde HTTP 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "let respuesta;",
              "try {",
              "    respuesta = pm.response.json();",
              "} catch (error) {",
              "    respuesta = null;",
              "}",
              "",
              "console.log('--- Respuesta completa del listado de usuarios (evidencia) ---');",
              "console.log(pm.response.text());",
              "",
              "if (pm.response.code === 200 && respuesta) {",
              "",
              "    pm.test('TC-M01-080: la respuesta contiene la estructura esperada (total, pagina, tamano, items)', function () {",
              "        pm.expect(respuesta).to.have.property('total');",
              "        pm.expect(respuesta).to.have.property('items');",
              "        pm.expect(respuesta.items).to.be.an('array');",
              "    });",
              "",
              "    const items = respuesta.items;",
              "",
              "    const indiceReciente = items.findIndex(function (u) { return u.correo_electronico === correoReciente; });",
              "    const indiceIntermedio = items.findIndex(function (u) { return u.correo_electronico === correoIntermedio; });",
              "    const indiceAntiguo = items.findIndex(function (u) { return u.correo_electronico === correoAntiguo; });",
              "",
              "    console.log('Posicion en el listado -> reciente: ' + indiceReciente + ', intermedio: ' + indiceIntermedio + ', antiguo: ' + indiceAntiguo);",
              "",
              "    pm.test('TC-M01-080: los 3 usuarios de prueba registrados en esta corrida aparecen en la primera pagina del listado', function () {",
              "        pm.expect(indiceReciente, 'usuario mas reciente no encontrado en el listado').to.be.at.least(0);",
              "        pm.expect(indiceIntermedio, 'usuario intermedio no encontrado en el listado').to.be.at.least(0);",
              "        pm.expect(indiceAntiguo, 'usuario mas antiguo no encontrado en el listado').to.be.at.least(0);",
              "    });",
              "",
              "    if (indiceReciente >= 0 && indiceIntermedio >= 0 && indiceAntiguo >= 0) {",
              "        pm.test('TC-M01-080: el listado respeta el orden descendente por fecha de registro (reciente -> intermedio -> antiguo)', function () {",
              "            pm.expect(indiceReciente).to.be.below(indiceIntermedio);",
              "            pm.expect(indiceIntermedio).to.be.below(indiceAntiguo);",
              "        });",
              "        console.log('CONCLUSION: orden descendente por fecha de registro confirmado (el mas reciente aparece primero).');",
              "    } else {",
              "        console.log('ADVERTENCIA: no se pudo validar el orden porque no se encontraron los 3 usuarios de prueba dentro del tamano de pagina consultado.');",
              "    }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/usuarios/admin?pagina=1&tamano=50",
          "host": [ "{{base_url}}" ],
          "path": [ "usuarios", "admin" ],
          "query": [
