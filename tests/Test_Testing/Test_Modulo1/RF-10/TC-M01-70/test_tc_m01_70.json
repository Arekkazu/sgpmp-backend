{
  "info": {
    "name": "TC-M01-070 - Intentar consultar auditoria con un rango superior a 12 meses",
    "description": "TC-M01-070 (RF-10, CU07): Se intenta consultar la auditoria utilizando un rango de fechas superior a 12 meses. La prueba valida el comportamiento del sistema ante una consulta que excede el limite definido para la auditoria activa y registra evidencia de la respuesta obtenida.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Precondicion - Iniciar sesion como Administrador",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Precondicion cumplida: inicio de sesion exitoso (HTTP 200)', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "let respuesta;",
              "",
              "try {",
              "    respuesta = pm.response.json();",
              "} catch (error) {",
              "    respuesta = null;",
              "}",
              "",
              "pm.test('La respuesta del login contiene un token', function () {",
              "    pm.expect(respuesta).to.not.equal(null);",
              "    pm.expect(respuesta).to.have.property('token');",
              "    pm.expect(respuesta.token).to.be.a('string').and.not.empty;",
              "});",
              "",
              "console.log('--- Respuesta del login Administrador ---');",
              "console.log(pm.response.text());",
              "",
              "if (pm.response.code === 200 && respuesta && respuesta.token) {",
              "    pm.collectionVariables.set('token', respuesta.token);",
              "    console.log('Token del Administrador almacenado correctamente.');",
              "} else {",
              "    console.log('El login fallo. Se detiene la ejecucion de la prueba.');",
              "    postman.setNextRequest(null);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"admin@pecuaria.co\",\n  \"contrasena\": \"Test1234!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/sesiones/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "sesiones",
            ""
          ]
        }
      },
      "response": []
    },
    {
      "name": "TC-M01-070 - Consultar auditoria con rango superior a 12 meses",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "console.log('--- TC-M01-070: consulta con rango superior a 12 meses ---');",
              "console.log('Fecha desde:', pm.collectionVariables.get('fecha_desde'));",
              "console.log('Fecha hasta:', pm.collectionVariables.get('fecha_hasta'));",
              "console.log('HTTP Status:', pm.response.code);",
              "console.log('Respuesta:', pm.response.text());",
              "",
              "pm.collectionVariables.set('respuesta_rango_extenso', pm.response.text());",
              "pm.collectionVariables.set('status_rango_extenso', pm.response.code.toString());",
              "",
              "pm.test('TC-M01-070: el sistema procesa la solicitud de rango superior a 12 meses', function () {",
              "    pm.expect([200, 206, 400, 422]).to.include(pm.response.code);",
              "});",
              "",
              "if (pm.response.code === 400 || pm.response.code === 422) {",
              "    pm.test('TC-M01-070: la consulta superior al limite es rechazada', function () {",
              "        pm.expect(pm.response.code).to.be.oneOf([400, 422]);",
              "    });",
              "",
              "    console.log('Resultado: el sistema rechazo la consulta con un rango superior a 12 meses.');",
              "} else {",
              "    console.log('Resultado: la API permitio o proceso la consulta. Se registra el comportamiento para evidencia del caso.');",
              "",
              "    let respuesta;",
              "",
              "    try {",
              "        respuesta = pm.response.json();",
              "    } catch (error) {",
              "        respuesta = null;",
              "    }",
              "",
              "    pm.test('TC-M01-070: la respuesta exitosa tiene formato JSON valido', function () {",
              "        pm.expect(respuesta).to.not.equal(null);",
              "    });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/auditoria/?fecha_desde={{fecha_desde}}&fecha_hasta={{fecha_hasta}}&pagina=1&tamano=20",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auditoria",
            ""
          ],
          "query": [
            {
              "key": "fecha_desde",
              "value": "{{fecha_desde}}"
            },
            {
              "key": "fecha_hasta",
              "value": "{{fecha_hasta}}"
            },
            {
              "key": "pagina",
              "value": "1"
            },
            {
              "key": "tamano",
              "value": "20"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Evidencia - Consultar archivo historico de auditoria",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "console.log('--- Evidencia TC-M01-070: consulta del archivo historico ---');",
              "console.log('HTTP Status:', pm.response.code);",
              "console.log('Respuesta:', pm.response.text());",
              "",
              "pm.collectionVariables.set('respuesta_archivo_historico', pm.response.text());",
              "pm.collectionVariables.set('status_archivo_historico', pm.response.code.toString());",
              "",
              "pm.test('La consulta al archivo historico obtiene una respuesta valida del sistema', function () {",
              "    pm.expect([200, 206, 400, 403, 422]).to.include(pm.response.code);",
              "});",
              "",
              "if (pm.response.code === 200 || pm.response.code === 206) {",
              "    let respuesta;",
              "",
              "    try {",
              "        respuesta = pm.response.json();",
              "    } catch (error) {",
              "        respuesta = null;",
              "    }",
              "",
              "    pm.test('La respuesta del archivo historico tiene formato JSON valido', function () {",
              "        pm.expect(respuesta).to.not.equal(null);",
              "    });",
              "",
              "    pm.test('La respuesta del archivo historico contiene la estructura esperada', function () {",
              "        pm.expect(respuesta).to.have.property('items');",
              "        pm.expect(respuesta.items).to.be.an('array');",
              "    });",
              "",
              "    console.log('El sistema permite registrar evidencia mediante el archivo historico de auditoria.');",
              "} else {",
              "    console.log('El archivo historico devolvio un comportamiento controlado. La respuesta queda registrada como evidencia.');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/auditoria/archivado/?fecha_desde={{fecha_desde}}&fecha_hasta={{fecha_hasta}}&pagina=1&tamano=20",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auditoria",
            "archivado",
            ""
          ],
          "query": [
            {
              "key": "fecha_desde",
              "value": "{{fecha_desde}}"
            },
            {
              "key": "fecha_hasta",
              "value": "{{fecha_hasta}}"
            },
            {
              "key": "pagina",
              "value": "1"
            },
            {
              "key": "tamano",
              "value": "20"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Resultado final - Registrar comportamiento del limite de 12 meses",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const statusConsulta = Number(pm.collectionVariables.get('status_rango_extenso'));",
              "const statusHistorico = Number(pm.collectionVariables.get('status_archivo_historico'));",
              "",
              "console.log('--- Resultado final TC-M01-070 ---');",
              "console.log('Status consulta auditoria activa:', statusConsulta);",
              "console.log('Status consulta archivo historico:', statusHistorico);",
              "",
              "pm.test('TC-M01-070: se registro evidencia del comportamiento ante un rango superior a 12 meses', function () {",
              "    pm.expect(statusConsulta).to.not.equal(undefined);",
              "});",
              "",
              "if (statusConsulta === 400 || statusConsulta === 422) {",
              "    console.log('CONCLUSION: La API rechazo la consulta que supera el limite establecido.');",
              "} else if (statusConsulta === 200 || statusConsulta === 206) {",
              "    console.log('CONCLUSION: La API proceso la consulta superior a 12 meses. Este comportamiento queda registrado para validacion contra el requisito RF-10.');",
              "}",
              "",
              "console.log('TC-M01-070 finalizado. Se registraron las respuestas de la auditoria activa y del archivo historico.');"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/auditoria/?pagina=1&tamano=1",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auditoria",
