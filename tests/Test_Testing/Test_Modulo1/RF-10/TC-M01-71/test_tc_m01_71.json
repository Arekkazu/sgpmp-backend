    {
      "name": "Resultado final - Verificar paginacion del historial",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const total = Number(pm.collectionVariables.get('total_registros'));",
              "const pagina1 = Number(pm.collectionVariables.get('cantidad_pagina_1'));",
              "const pagina2 = Number(pm.collectionVariables.get('cantidad_pagina_2'));",
              "const pagina3 = Number(pm.collectionVariables.get('cantidad_pagina_3'));",
              "",
              "pm.test('TC-M01-071: la base contiene al menos 120 registros', function () {",
              "    pm.expect(total).to.be.at.least(120);",
              "});",
              "",
              "pm.test('TC-M01-071: pagina 1 contiene exactamente 50 registros', function () {",
              "    pm.expect(pagina1).to.equal(50);",
              "});",
              "",
              "pm.test('TC-M01-071: pagina 2 contiene exactamente 50 registros', function () {",
              "    pm.expect(pagina2).to.equal(50);",
              "});",
              "",
              "pm.test('TC-M01-071: pagina 3 contiene los registros restantes', function () {",
              "    pm.expect(pagina3).to.be.at.least(1);",
              "    pm.expect(pagina3).to.be.at.most(50);",
              "});",
              "",
              "console.log('--- Resultado TC-M01-071 ---');",
              "console.log('Total de registros:', total);",
              "console.log('Pagina 1:', pagina1);",
              "console.log('Pagina 2:', pagina2);",
              "console.log('Pagina 3:', pagina3);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
