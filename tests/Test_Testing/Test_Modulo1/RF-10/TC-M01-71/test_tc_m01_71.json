{
  "info": {
    "name": "TC-M01-071 - Verificar paginacion del historial de auditoria - Segunda revision",
    "description": "Prueba API del historial de auditoria: pagina 1 y 2 con 50 registros, pagina 3 con restantes, sin repetidos y con una base de al menos 120 registros. La navegacion visual anterior/siguiente y numeros de pagina corresponde a la parte Frontend/Cypress.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Precondicion - Iniciar sesion como Administrador",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Precondicion: login del Administrador responde HTTP 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "let respuesta = null;",
              "try {",
              "    respuesta = pm.response.json();",
              "} catch (e) {}",
              "",
              "pm.test('Precondicion: la respuesta contiene un token', function () {",
              "    pm.expect(respuesta).to.not.equal(null);",
              "    pm.expect(respuesta).to.have.property('token');",
              "    pm.expect(respuesta.token).to.be.a('string').and.not.empty;",
              "});",
              "",
              "if (pm.response.code === 200 && respuesta && respuesta.token) {",
              "    pm.collectionVariables.set('token', respuesta.token);",
              "} else {",
              "    pm.execution.setNextRequest(null);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"admin@pecuaria.co\",\n  \"contrasena\": \"Test1234!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://sigab-backendtest-389pcb-a48238-158-69-200-27.sslip.io/api-sgpmp-test/sesiones/",
          "host": [
            "https://sigab-backendtest-389pcb-a48238-158-69-200-27.sslip.io/api-sgpmp-test"
          ],
          "path": [
            "sesiones",
            ""
          ]
        }
      },
      "response": []
    },
    {
      "name": "TC-M01-071 - Consultar pagina 1 con 50 registros",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const respuesta = pm.response.json();",
              "",
              "pm.collectionVariables.set('total_registros', String(respuesta.total));",
              "pm.collectionVariables.set('cantidad_pagina_1', String(respuesta.items.length));",
              "pm.collectionVariables.set('ids_pagina_1', JSON.stringify(respuesta.items.map(item => item.id_evento)));",
              "",
              "pm.test('Pagina 1: respuesta HTTP 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Pagina 1: contiene la estructura esperada', function () {",
              "    pm.expect(respuesta).to.have.property('total');",
              "    pm.expect(respuesta).to.have.property('pagina');",
              "    pm.expect(respuesta).to.have.property('tamano');",
              "    pm.expect(respuesta).to.have.property('items');",
              "    pm.expect(respuesta.items).to.be.an('array');",
              "});",
              "",
              "pm.test('Pagina 1: numero de pagina correcto', function () {",
              "    pm.expect(respuesta.pagina).to.equal(1);",
              "});",
              "",
              "pm.test('Pagina 1: tamano solicitado de 50', function () {",
              "    pm.expect(respuesta.tamano).to.equal(50);",
              "});",
              "",
              "pm.test('Pagina 1: no supera 50 registros', function () {",
              "    pm.expect(respuesta.items.length).to.be.at.most(50);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "https://sigab-backendtest-389pcb-a48238-158-69-200-27.sslip.io/api-sgpmp-test/auditoria/?pagina=1&tamano=50",
          "host": [
            "https://sigab-backendtest-389pcb-a48238-158-69-200-27.sslip.io/api-sgpmp-test"
          ],
          "path": [
            "auditoria",
            ""
          ],
          "query": [
            {
              "key": "pagina",
              "value": "1"
            },
            {
              "key": "tamano",
              "value": "50"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "TC-M01-071 - Consultar pagina 2 con 50 registros",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const respuesta = pm.response.json();",
              "const idsPagina1 = JSON.parse(pm.collectionVariables.get('ids_pagina_1') || '[]');",
              "const idsPagina2 = respuesta.items.map(item => item.id_evento);",
              "const repetidos = idsPagina2.filter(id => idsPagina1.includes(id));",
              "",
              "pm.collectionVariables.set('cantidad_pagina_2', String(respuesta.items.length));",
              "pm.collectionVariables.set('ids_pagina_2', JSON.stringify(idsPagina2));",
              "",
              "pm.test('Pagina 2: respuesta HTTP 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Pagina 2: contiene la estructura esperada', function () {",
              "    pm.expect(respuesta).to.have.property('total');",
              "    pm.expect(respuesta).to.have.property('pagina');",
              "    pm.expect(respuesta).to.have.property('tamano');",
              "    pm.expect(respuesta).to.have.property('items');",
              "    pm.expect(respuesta.items).to.be.an('array');",
              "});",
              "",
              "pm.test('Pagina 2: numero de pagina correcto', function () {",
              "    pm.expect(respuesta.pagina).to.equal(2);",
              "});",
              "",
              "pm.test('Pagina 2: tamano solicitado de 50', function () {",
              "    pm.expect(respuesta.tamano).to.equal(50);",
              "});",
              "",
              "pm.test('Pagina 2: no supera 50 registros', function () {",
              "    pm.expect(respuesta.items.length).to.be.at.most(50);",
              "});",
              "",
              "pm.test('Pagina 2: no repite eventos de pagina 1', function () {",
              "    pm.expect(repetidos.length).to.equal(0);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "https://sigab-backendtest-389pcb-a48238-158-69-200-27.sslip.io/api-sgpmp-test/auditoria/?pagina=2&tamano=50",
          "host": [
            "https://sigab-backendtest-389pcb-a48238-158-69-200-27.sslip.io/api-sgpmp-test"
          ],
          "path": [
            "auditoria",
            ""
          ],
          "query": [
            {
              "key": "pagina",
              "value": "2"
            },
            {
              "key": "tamano",
              "value": "50"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "TC-M01-071 - Consultar pagina 3 con registros restantes",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const respuesta = pm.response.json();",
              "const idsPagina1 = JSON.parse(pm.collectionVariables.get('ids_pagina_1') || '[]');",
              "const idsPagina2 = JSON.parse(pm.collectionVariables.get('ids_pagina_2') || '[]');",
              "const idsAnteriores = idsPagina1.concat(idsPagina2);",
              "const idsPagina3 = respuesta.items.map(item => item.id_evento);",
              "const repetidos = idsPagina3.filter(id => idsAnteriores.includes(id));",
              "",
              "pm.collectionVariables.set('cantidad_pagina_3', String(respuesta.items.length));",
              "",
              "pm.test('Pagina 3: respuesta HTTP 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Pagina 3: contiene la estructura esperada', function () {",
              "    pm.expect(respuesta).to.have.property('total');",
              "    pm.expect(respuesta).to.have.property('pagina');",
              "    pm.expect(respuesta).to.have.property('tamano');",
              "    pm.expect(respuesta).to.have.property('items');",
              "    pm.expect(respuesta.items).to.be.an('array');",
              "});",
              "",
              "pm.test('Pagina 3: numero de pagina correcto', function () {",
              "    pm.expect(respuesta.pagina).to.equal(3);",
              "});",
              "",
              "pm.test('Pagina 3: tamano solicitado de 50', function () {",
              "    pm.expect(respuesta.tamano).to.equal(50);",
              "});",
              "",
              "pm.test('Pagina 3: no supera 50 registros', function () {",
              "    pm.expect(respuesta.items.length).to.be.at.most(50);",
              "});",
              "",
              "pm.test('Pagina 3: no repite eventos de paginas anteriores', function () {",
              "    pm.expect(repetidos.length).to.equal(0);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "https://sigab-backendtest-389pcb-a48238-158-69-200-27.sslip.io/api-sgpmp-test/auditoria/?pagina=3&tamano=50",
          "host": [
            "https://sigab-backendtest-389pcb-a48238-158-69-200-27.sslip.io/api-sgpmp-test"
          ],
          "path": [
