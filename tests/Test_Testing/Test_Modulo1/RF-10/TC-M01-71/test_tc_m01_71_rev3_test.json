{
  "info": {
    "_postman_id": "tc-m01-71-rev3-test",
    "name": "TC-M01-071 - Paginación historial de auditoría - rev3 TEST",
    "description": "Reevaluación TEST TC-M01-071 / RF-10. Actor TEST: admin@pecuaria.co (no DEV admin.dev). Contrato: GET /auditoria/?pagina&tamano y reenvío de fecha_hasta de página 1. IDs numéricos. Sin duplicados entre páginas. Contraseña vía env.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Iniciar sesión como Administrador",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"{{correo}}\",\n  \"contrasena\": \"{{contrasena}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/sesiones/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let respuesta = null;",
              "try { respuesta = pm.response.json(); } catch (e) { respuesta = null; }",
              "pm.test('Login del Administrador: respuesta HTTP 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Login del Administrador: contiene token válido', function () {",
              "    pm.expect(respuesta).to.not.equal(null);",
              "    pm.expect(respuesta).to.have.property('token');",
              "    pm.expect(respuesta.token).to.be.a('string').and.not.empty;",
              "});",
              "if (pm.response.code === 200 && respuesta && respuesta.token) {",
              "    pm.collectionVariables.set('token', respuesta.token);",
              "} else {",
              "    pm.execution.setNextRequest(null);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Consultar página 1 con tamano 50",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/auditoria/?pagina=1&tamano=50",
          "host": ["{{baseUrl}}"],
          "path": ["auditoria", ""],
          "query": [
            { "key": "pagina", "value": "1" },
            { "key": "tamano", "value": "50" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const respuesta = pm.response.json();",
              "pm.test('Página 1: respuesta HTTP 200 o 206', function () {",
              "    pm.expect([200, 206]).to.include(pm.response.code);",
              "});",
              "pm.test('Página 1: contiene la estructura esperada', function () {",
              "    pm.expect(respuesta).to.have.property('total');",
              "    pm.expect(respuesta).to.have.property('pagina');",
              "    pm.expect(respuesta).to.have.property('tamano');",
              "    pm.expect(respuesta).to.have.property('items');",
              "    pm.expect(respuesta.items).to.be.an('array');",
              "});",
              "pm.test('Página 1: número de página correcto', function () {",
              "    pm.expect(respuesta.pagina).to.equal(1);",
              "});",
              "pm.test('Página 1: tamaño solicitado de 50 y no supera el máximo', function () {",
              "    pm.expect(respuesta.tamano).to.equal(50);",
              "    pm.expect(respuesta.items.length).to.be.at.most(50);",
              "});",
              "pm.test('Página 1: contiene exactamente 50 registros', function () {",
              "    pm.expect(respuesta.items.length).to.equal(50);",
              "});",
              "pm.test('Historial: contiene al menos 120 registros', function () {",
              "    pm.expect(respuesta.total).to.be.at.least(120);",
              "});",
              "pm.test('Página 1: ids únicos dentro de la página', function () {",
              "    const ids = respuesta.items.map(item => item.id_evento);",
              "    pm.expect(new Set(ids).size).to.equal(ids.length);",
              "});",
              "pm.test('Página 1: expone ancla fecha_hasta para páginas siguientes', function () {",
              "    pm.expect(respuesta).to.have.property('fecha_hasta');",
              "    pm.expect(respuesta.fecha_hasta).to.be.a('string').and.not.empty;",
              "});",
              "const idsPagina1 = respuesta.items.map(item => Number(item.id_evento));",
              "const first = respuesta.items[0] || {};",
              "const last = respuesta.items[respuesta.items.length - 1] || {};",
              "pm.collectionVariables.set('totalRegistros', String(respuesta.total));",
              "pm.collectionVariables.set('idsPagina1', JSON.stringify(idsPagina1));",
              "pm.collectionVariables.set('fecha_hasta_ancla', String(respuesta.fecha_hasta));",
              "pm.collectionVariables.set('cantidadPagina1', String(respuesta.items.length));",
              "console.log('PAGINA 1 total=' + respuesta.total + ' items=' + respuesta.items.length + ' ancla=' + respuesta.fecha_hasta + ' first=' + idsPagina1[0] + ' fecha_first=' + first.fecha_evento + ' last=' + idsPagina1[idsPagina1.length-1] + ' fecha_last=' + last.fecha_evento);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Consultar página 2 con ancla fecha_hasta",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/auditoria/?pagina=2&tamano=50&fecha_hasta={{fecha_hasta_ancla}}",
          "host": ["{{baseUrl}}"],
          "path": ["auditoria", ""],
          "query": [
            { "key": "pagina", "value": "2" },
            { "key": "tamano", "value": "50" },
            { "key": "fecha_hasta", "value": "{{fecha_hasta_ancla}}" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const respuesta = pm.response.json();",
              "const idsPagina1 = JSON.parse(pm.collectionVariables.get('idsPagina1') || '[]').map(Number);",
              "const idsPagina2 = (respuesta.items || []).map(item => Number(item.id_evento));",
              "const repetidos = idsPagina2.filter(id => idsPagina1.includes(id));",
              "const ancla = pm.collectionVariables.get('fecha_hasta_ancla');",
              "const totalEsperado = Number(pm.collectionVariables.get('totalRegistros'));",
              "pm.test('Página 2: respuesta HTTP 200 o 206', function () {",
              "    pm.expect([200, 206]).to.include(pm.response.code);",
              "});",
              "pm.test('Página 2: contiene la estructura esperada', function () {",
              "    pm.expect(respuesta).to.have.property('total');",
              "    pm.expect(respuesta).to.have.property('pagina');",
              "    pm.expect(respuesta).to.have.property('tamano');",
              "    pm.expect(respuesta).to.have.property('items');",
              "    pm.expect(respuesta.items).to.be.an('array');",
              "});",
              "pm.test('Página 2: número de página correcto', function () {",
              "    pm.expect(respuesta.pagina).to.equal(2);",
              "});",
              "pm.test('Página 2: tamaño solicitado de 50 y no supera el máximo', function () {",
              "    pm.expect(respuesta.tamano).to.equal(50);",
              "    pm.expect(respuesta.items.length).to.be.at.most(50);",
              "});",
              "pm.test('Página 2: contiene exactamente 50 registros', function () {",
              "    pm.expect(respuesta.items.length).to.equal(50);",
              "});",
              "pm.test('Página 2: total estable respecto de página 1 (mismo ancla)', function () {",
              "    pm.expect(respuesta.total).to.equal(totalEsperado);",
              "});",
              "pm.test('Página 2: ids únicos dentro de la página', function () {",
              "    pm.expect(new Set(idsPagina2).size).to.equal(idsPagina2.length);",
              "});",
              "pm.test('Página 2: misma ancla fecha_hasta que página 1', function () {",
              "    pm.expect(String(respuesta.fecha_hasta)).to.equal(String(ancla));",
              "});",
              "pm.test('Página 2: no repite eventos de página 1', function () {",
              "    pm.expect(repetidos, 'ids repetidos=' + JSON.stringify(repetidos)).to.have.lengthOf(0);",
              "});",
              "pm.collectionVariables.set('idsPagina2', JSON.stringify(idsPagina2));",
              "pm.collectionVariables.set('cantidadPagina2', String(respuesta.items.length));",
              "const first2 = respuesta.items[0] || {};",
              "const last2 = respuesta.items[idsPagina2.length - 1] || {};",
              "console.log('PAGINA 2 items=' + idsPagina2.length + ' ancla=' + respuesta.fecha_hasta + ' repetidos_p1=' + JSON.stringify(repetidos) + ' first=' + idsPagina2[0] + ' fecha_first=' + first2.fecha_evento + ' last=' + idsPagina2[idsPagina2.length-1] + ' fecha_last=' + last2.fecha_evento);"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Consultar página 3 con ancla fecha_hasta",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/auditoria/?pagina=3&tamano=50&fecha_hasta={{fecha_hasta_ancla}}",
          "host": ["{{baseUrl}}"],
          "path": ["auditoria", ""],
          "query": [
            { "key": "pagina", "value": "3" },
            { "key": "tamano", "value": "50" },
            { "key": "fecha_hasta", "value": "{{fecha_hasta_ancla}}" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const respuesta = pm.response.json();",
              "const idsPagina1 = JSON.parse(pm.collectionVariables.get('idsPagina1') || '[]').map(Number);",
              "const idsPagina2 = JSON.parse(pm.collectionVariables.get('idsPagina2') || '[]').map(Number);",
              "const idsPagina3 = (respuesta.items || []).map(item => Number(item.id_evento));",
              "const repetidosP1 = idsPagina3.filter(id => idsPagina1.includes(id));",
              "const repetidosP2 = idsPagina3.filter(id => idsPagina2.includes(id));",
              "const repetidos = repetidosP1.concat(repetidosP2);",
              "const ancla = pm.collectionVariables.get('fecha_hasta_ancla');",
              "const total = Number(pm.collectionVariables.get('totalRegistros'));",
              "const cantidadEsperadaPagina3 = Math.min(50, total - 100);",
              "pm.test('Página 3: respuesta HTTP 200 o 206', function () {",
              "    pm.expect([200, 206]).to.include(pm.response.code);",
              "});",
              "pm.test('Página 3: contiene la estructura esperada', function () {",
              "    pm.expect(respuesta).to.have.property('total');",
              "    pm.expect(respuesta).to.have.property('pagina');",
              "    pm.expect(respuesta).to.have.property('tamano');",
              "    pm.expect(respuesta).to.have.property('items');",
              "    pm.expect(respuesta.items).to.be.an('array');",
              "});",
              "pm.test('Página 3: número de página correcto', function () {",
              "    pm.expect(respuesta.pagina).to.equal(3);",
              "});",
              "pm.test('Página 3: tamaño solicitado de 50 y no supera el máximo', function () {",
              "    pm.expect(respuesta.tamano).to.equal(50);",
              "    pm.expect(respuesta.items.length).to.be.at.most(50);",
              "});",
              "pm.test('Página 3: contiene los registros restantes esperados', function () {",
              "    pm.expect(respuesta.items.length).to.equal(cantidadEsperadaPagina3);",
              "});",
              "pm.test('Página 3: total estable respecto de página 1 (mismo ancla)', function () {",
              "    pm.expect(respuesta.total).to.equal(total);",
              "});",
              "pm.test('Página 3: ids únicos dentro de la página', function () {",
              "    pm.expect(new Set(idsPagina3).size).to.equal(idsPagina3.length);",
              "});",
              "pm.test('Página 3: misma ancla fecha_hasta que página 1', function () {",
              "    pm.expect(String(respuesta.fecha_hasta)).to.equal(String(ancla));",
              "});",
              "pm.test('Página 3: no repite eventos de página 1', function () {",
              "    pm.expect(repetidosP1, 'P1∩P3=' + JSON.stringify(repetidosP1)).to.have.lengthOf(0);",
              "});",
              "pm.test('Página 3: no repite eventos de página 2', function () {",
              "    pm.expect(repetidosP2, 'P2∩P3=' + JSON.stringify(repetidosP2)).to.have.lengthOf(0);",
              "});",
              "pm.collectionVariables.set('cantidadPagina3', String(respuesta.items.length));",
              "const first3 = respuesta.items[0] || {};",
              "const last3 = respuesta.items[idsPagina3.length - 1] || {};",
              "console.log('PAGINA 3 items=' + idsPagina3.length + ' esperados=' + cantidadEsperadaPagina3 + ' ancla=' + respuesta.fecha_hasta + ' P1∩P3=' + JSON.stringify(repetidosP1) + ' P2∩P3=' + JSON.stringify(repetidosP2) + ' first=' + idsPagina3[0] + ' fecha_first=' + first3.fecha_evento + ' last=' + idsPagina3[idsPagina3.length-1] + ' fecha_last=' + last3.fecha_evento);"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Rechazar tamano mayor al máximo 50",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/auditoria/?pagina=1&tamano=51",
          "host": ["{{baseUrl}}"],
          "path": ["auditoria", ""],
          "query": [
            { "key": "pagina", "value": "1" },
            { "key": "tamano", "value": "51" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Límite: tamano=51 es rechazado (HTTP 400 VAL_ENTRADA, campo tamano <= 50)', function () {",
              "    pm.response.to.have.status(400);",
              "    const body = pm.response.json();",
              "    pm.expect(body.error_code).to.equal('VAL_ENTRADA');",
              "    const fields = body.fields || [];",
              "    const tamano = fields.find(f => f.field === 'tamano');",
              "    pm.expect(tamano, 'campo tamano en fields').to.exist;",
              "    pm.expect(String(tamano.message)).to.match(/50/);",
              "});"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "https://sigab-backendtest-389pcb-a48238-158-69-200-27.sslip.io/api-sgpmp-test" },
