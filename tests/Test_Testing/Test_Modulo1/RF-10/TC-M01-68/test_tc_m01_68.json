    {
      "name": "Evidencia - Consultar eventos de autenticacion",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "console.log('--- Consulta de auditoria categoria AUTENTICACION ---');",
              "console.log('HTTP Status:', pm.response.code);",
              "console.log('Respuesta:', pm.response.text());",
              "",
              "pm.test('La consulta de auditoria es exitosa', function () {",
              "    pm.expect([200, 206]).to.include(pm.response.code);",
              "});",
              "",
              "let respuesta;",
              "",
              "try {",
              "    respuesta = pm.response.json();",
              "} catch (error) {",
              "    respuesta = null;",
              "}",
              "",
              "pm.test('La respuesta contiene la lista de eventos de auditoria', function () {",
              "    pm.expect(respuesta).to.not.equal(null);",
              "    pm.expect(respuesta).to.have.property('items');",
              "    pm.expect(respuesta.items).to.be.an('array');",
              "});",
              "",
              "const items = respuesta && Array.isArray(respuesta.items) ? respuesta.items : [];",
              "",
              "console.log('Cantidad de eventos recuperados:', items.length);",
              "",
              "let eventoFallido = null;",
              "",
              "for (let i = 0; i < items.length; i++) {",
              "    const evento = items[i];",
              "",
              "    const textoEvento = [",
              "        evento.resultado,",
              "        evento.detalle,",
              "        evento.descripcion,",
              "        evento.estado,",
              "        evento.modulo",
              "    ]",
              "        .filter(function (valor) { return valor !== null && valor !== undefined; })",
              "        .join(' ')",
              "        .toLowerCase();",
              "",
              "    if (textoEvento.includes('login_fallido') ||",
              "        textoEvento.includes('login fallido') ||",
              "        textoEvento.includes('inicio de sesion fallido') ||",
              "        textoEvento.includes('inicio sesión fallido') ||",
              "        textoEvento.includes('autenticacion fallida') ||",
              "        textoEvento.includes('autenticación fallida') ||",
              "        textoEvento.includes('fallid')) {",
              "",
              "        eventoFallido = evento;",
              "        break;",
              "    }",
              "}",
              "",
              "pm.test('Se encontro un evento correspondiente a autenticacion fallida', function () {",
              "    pm.expect(eventoFallido).to.not.equal(null);",
              "});",
              "",
              "if (eventoFallido) {",
              "    pm.test('El evento encontrado contiene un tipo_evento numerico', function () {",
              "        pm.expect(eventoFallido).to.have.property('tipo_evento');",
              "        pm.expect(eventoFallido.tipo_evento).to.not.equal(null);",
              "        pm.expect(Number.isFinite(Number(eventoFallido.tipo_evento))).to.equal(true);",
              "    });",
              "",
              "    pm.collectionVariables.set('tipo_evento_login_fallido', String(eventoFallido.tipo_evento));",
              "    pm.collectionVariables.set('evento_referencia', JSON.stringify(eventoFallido));",
              "",
              "    console.log('--- Evento de autenticacion fallida encontrado ---');",
              "    console.log(JSON.stringify(eventoFallido));",
              "    console.log('tipo_evento identificado:', eventoFallido.tipo_evento);",
              "} else {",
              "    console.log('No se encontro un evento de autenticacion fallida en los resultados disponibles.');",
              "    postman.setNextRequest(null);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_admin}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/auditoria/?categoria=AUTENTICACION&pagina=1&tamano=50",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auditoria",
            ""
          ],
          "query": [
            {
              "key": "categoria",
              "value": "AUTENTICACION"
            },
            {
              "key": "pagina",
              "value": "1"
            },
            {
              "key": "tamano",
              "value": "50"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "TC-M01-068 - Consultar auditoria filtrando por tipo_evento",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "console.log('--- TC-M01-068: consulta filtrada por tipo de evento ---');",
              "console.log('tipo_evento utilizado:', pm.collectionVariables.get('tipo_evento_login_fallido'));",
              "console.log('HTTP Status:', pm.response.code);",
              "console.log('Respuesta:', pm.response.text());",
              "",
              "pm.test('TC-M01-068: la consulta filtrada responde exitosamente', function () {",
              "    pm.expect([200, 206]).to.include(pm.response.code);",
              "});",
              "",
              "let respuesta;",
              "",
              "try {",
              "    respuesta = pm.response.json();",
              "} catch (error) {",
              "    respuesta = null;",
              "}",
              "",
              "pm.test('TC-M01-068: la respuesta contiene la estructura esperada', function () {",
              "    pm.expect(respuesta).to.not.equal(null);",
              "    pm.expect(respuesta).to.have.property('items');",
              "    pm.expect(respuesta.items).to.be.an('array');",
              "});",
              "",
              "const tipoEventoEsperado = Number(pm.collectionVariables.get('tipo_evento_login_fallido'));",
              "const items = respuesta && Array.isArray(respuesta.items) ? respuesta.items : [];",
              "",
              "pm.test('TC-M01-068: se obtienen registros para el tipo de evento filtrado', function () {",
              "    pm.expect(items.length).to.be.greaterThan(0);",
              "});",
              "",
              "pm.test('TC-M01-068: todos los registros corresponden al tipo_evento solicitado', function () {",
              "    items.forEach(function (evento) {",
              "        pm.expect(Number(evento.tipo_evento)).to.equal(tipoEventoEsperado);",
              "    });",
              "});",
              "",
              "pm.test('TC-M01-068: los registros filtrados pertenecen a la categoria AUTENTICACION', function () {",
              "    items.forEach(function (evento) {",
              "        pm.expect(String(evento.categoria).toUpperCase()).to.equal('AUTENTICACION');",
              "    });",
              "});",
              "",
              "pm.collectionVariables.set('resultado_filtro_tipo_evento', pm.response.text());",
              "",
              "console.log('Cantidad de registros obtenidos con el filtro:', items.length);",
              "console.log('TC-M01-068 ejecutado correctamente.');"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_admin}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/auditoria/?tipo_evento={{tipo_evento_login_fallido}}&categoria=AUTENTICACION&pagina=1&tamano=50",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auditoria",
            ""
          ],
          "query": [
            {
              "key": "tipo_evento",
              "value": "{{tipo_evento_login_fallido}}"
            },
            {
              "key": "categoria",
              "value": "AUTENTICACION"
            },
            {
              "key": "pagina",
              "value": "1"
            },
            {
              "key": "tamano",
              "value": "50"
            }
          ]
        }
      },
