  },
  "item": [
    {
      "name": "Escenario 1 - 17 anios 364 dias (debe rechazar, 403)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Escenario 1: HTTP 403 por edad menor a 18', function () {",
              "    pm.response.to.have.status(403);",
              "});",
              "",
              "pm.test('Escenario 1: el campo reportado es fecha_nacimiento', function () {",
              "    let json; try { json = pm.response.json(); } catch (e) { json = null; }",
              "    if (json && json.field) {",
              "        pm.expect(json.field).to.eql('fecha_nacimiento');",
              "    } else { pm.expect(true).to.be.true; }",
              "});",
              "",
              "pm.test('Escenario 1: el mensaje menciona la edad minima', function () {",
              "    const body = pm.response.text().toLowerCase();",
              "    pm.expect(body).to.satisfy(function (b) {",
              "        return b.includes('edad') || b.includes('18') || b.includes('mayor');",
              "    });",
              "});",
              "",
              "console.log('Escenario 1 (17a364d): ' + pm.response.code + ' - ' + pm.response.text());"
            ]
          }
        }
      ],
