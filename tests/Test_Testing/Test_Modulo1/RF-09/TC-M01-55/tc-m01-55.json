{
  "info": {
    "name": "TC-M01-055",
    "description": "Verifica que POST /contrasena/restablecer rechace con 400 VAL_ENTRADA una nueva contrasena que no cumple los 4 criterios de seguridad (min 8 caracteres, mayuscula, numero, caracter especial). No requiere un token real - el sistema valida el cuerpo de la peticion antes de verificar el token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Sin mayuscula, sin especial (clave123)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Responde 400 VAL_ENTRADA', function () {",
        "    pm.response.to.have.status(400);",
        "    pm.expect(pm.response.json().error_code).to.eql('VAL_ENTRADA');",
        "});"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"token\": \"token-cualquiera-para-probar-validacion\",\n  \"nueva_contrasena\": \"clave123\",\n  \"confirmar_contrasena\": \"clave123\"\n}" },
        "url": "http://sigab-backendtest-389pcb-a48238-158-69-200-27.sslip.io/api-sgpmp-test/contrasena/restablecer"
      }
    },
