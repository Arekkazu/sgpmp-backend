            "type": "text/javascript",
            "exec": [
              "",
              "console.log('6: ' + pm.response.code + ' ' + pm.response.text());",
              "pm.test('6 - el bloqueo sigue activo (423) en un intento posterior', function () {",
              "    pm.response.to.have.status(423);",
              "});",
              "if (pm.response.code === 423) {",
              "    var m1 = pm.collectionVariables.get('mensaje_bloqueo_1');",
              "    var m2 = pm.response.json().message;",
              "    console.log('Comparando hora de desbloqueo -> intento 5: \"' + m1 + '\" | intento 6: \"' + m2 + '\"');",
              "    pm.test('6 - la hora de desbloqueo mostrada es estable (hora real de liberacion, no la hora actual de cada consulta)', function () {",
              "        pm.expect(m2).to.eql(m1);",
              "    });",
              "}",
