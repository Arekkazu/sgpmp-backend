          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "console.log('5: ' + pm.response.code + ' ' + pm.response.text());",
              "pm.test('5 - TC-M01-058: al 5to intento con token invalido, responde 423 (bloqueo activado)', function () {",
              "    pm.response.to.have.status(423);",
              "});",
              "if (pm.response.code === 423) {",
              "    pm.test('5 - el codigo de error es RESTABLECIMIENTO_BLOQUEADO', function () {",
              "        pm.expect(pm.response.json().error_code).to.eql('RESTABLECIMIENTO_BLOQUEADO');",
              "    });",
              "    pm.collectionVariables.set('mensaje_bloqueo_1', pm.response.json().message);",
              "}",
              ""
            ]
          }
        }
