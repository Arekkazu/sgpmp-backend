{
  "info": {
    "_postman_id": "tc-m01-130-rbac-denegar-edicion-perfil-otro-usuario",
    "name": "TC-M01-130 - Denegar modificación no autorizada de perfil de otro usuario a rol Veterinario",
    "description": "Validar mediante prueba de contrato API que un usuario con rol Veterinario (juan.carlos.qa133@sgpmp-test.com, id_usuario=3, id_rol=3) sin privilegios administrativos (requiere permiso 1, 3 en require_permission) recibe una denegación de acceso HTTP 403 ACCESO_DENEGADO al solicitar PATCH /usuarios/57.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://sigab-backendtest-389pcb-a48238-158-69-200-27.sslip.io/api-sgpmp-test"
    },
    {
      "key": "tokenUsuario",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Iniciar sesión con usuario Veterinario (sin permiso 1, 3)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"juan.carlos.qa133@sgpmp-test.com\",\n  \"contrasena\": \"Test1234!\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/sesiones/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "sesiones",
            ""
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('TC-M01-130: Iniciar sesión correctamente con usuario Veterinario', function () {",
              "    pm.response.to.have.status(200);",
              "    const response = pm.response.json();",
              "    pm.expect(response.token).to.exist;",
              "    pm.expect(response.token).to.be.a('string');",
              "    pm.collectionVariables.set('tokenUsuario', response.token);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Solicitar modificación de perfil de otro usuario sin permiso administrativo (RBAC Denegado)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenUsuario}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"JUANES\",\n  \"apellidos\": \"MENDEZES\",\n  \"telefono\": \"3009998877\",\n  \"version\": 1\n}"
        },
        "url": {
          "raw": "{{base_url}}/usuarios/57",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "usuarios",
            "57"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('TC-M01-130: Respuesta debe ser HTTP 403 Forbidden', function () {",
              "    pm.response.to.have.status(403);",
              "});",
              "",
              "pm.test('TC-M01-130: Estructura del cuerpo JSON corresponde a error de autorización ACCESO_DENEGADO', function () {",
              "    const response = pm.response.json();",
              "    pm.expect(response.error_code).to.equal('ACCESO_DENEGADO');",
              "    pm.expect(response.message).to.include('Acceso denegado');",
              "    pm.expect(response.fields).to.be.an('array').that.is.empty;",
              "    pm.expect(response.timestamp).to.exist;",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
