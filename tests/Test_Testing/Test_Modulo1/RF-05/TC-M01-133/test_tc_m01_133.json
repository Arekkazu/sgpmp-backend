{
  "info": {
    "_postman_id": "tc-m01-133-cambiar-correo",
    "name": "TC-M01-133 - Cambiar el correo electrónico de un usuario",
    "description": "Validar que un administrador pueda cambiar correctamente el correo electrónico de un usuario.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://sigab-backendtest-389pcb-a48238-158-69-200-27.sslip.io/api-sgpmp-test"
    },
    {
      "key": "token_usuario",
      "value": ""
    },
    {
      "key": "token_admin",
      "value": ""
    },
    {
      "key": "id_usuario",
      "value": ""
    },
    {
      "key": "version_usuario",
      "value": ""
    },
    {
      "key": "correo_original",
      "value": "juan.carlos@email.com"
    },
    {
      "key": "correo_nuevo",
      "value": "juan.carlos.qa133@sgpmp-test.com"
    }
  ],
  "item": [
    {
      "name": "01 - Iniciar sesión como usuario objetivo",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"juan.carlos@email.com\",\n  \"contrasena\": \"Test1234!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/sesiones/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "sesiones",
            ""
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login del usuario objetivo exitoso', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const response = pm.response.json();",
              "",
              "pm.test('Token del usuario obtenido correctamente', function () {",
              "    pm.expect(response.token).to.exist;",
              "});",
              "",
              "pm.collectionVariables.set('token_usuario', response.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Consultar perfil del usuario objetivo",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_usuario}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/usuarios/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "usuarios",
            "me"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Consulta del perfil exitosa', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const response = pm.response.json();",
              "",
              "pm.test('El perfil corresponde al usuario objetivo', function () {",
              "    pm.expect(response.correo_electronico).to.eql(pm.collectionVariables.get('correo_original'));",
              "});",
              "",
              "pm.test('Se obtuvo el ID del usuario', function () {",
              "    pm.expect(response.id_usuario).to.exist;",
              "});",
              "",
              "pm.test('Se obtuvo la versión del usuario', function () {",
              "    pm.expect(response.version).to.exist;",
              "});",
              "",
              "pm.collectionVariables.set('id_usuario', response.id_usuario);",
              "pm.collectionVariables.set('version_usuario', response.version);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Iniciar sesión como administrador",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"admin@pecuaria.co\",\n  \"contrasena\": \"Test1234!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/sesiones/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "sesiones",
            ""
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login como administrador exitoso', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const response = pm.response.json();",
              "",
              "pm.test('Token del administrador obtenido correctamente', function () {",
              "    pm.expect(response.token).to.exist;",
              "});",
              "",
              "pm.collectionVariables.set('token_admin', response.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Cambiar correo electrónico del usuario",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_admin}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Juan Carlos\",\n  \"apellidos\": \"Pérez García\",\n  \"correo_electronico\": \"{{correo_nuevo}}\",\n  \"version\": {{version_usuario}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/usuarios/{{id_usuario}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "usuarios",
            "{{id_usuario}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Cambio de correo realizado exitosamente', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "",
              "const response = pm.response.json();",
              "",
              "pm.test('La respuesta contiene el nuevo correo electrónico', function () {",
              "    pm.expect(response.correo_electronico).to.eql(pm.collectionVariables.get('correo_nuevo'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Iniciar sesión nuevamente como administrador",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"admin@pecuaria.co\",\n  \"contrasena\": \"Test1234!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/sesiones/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "sesiones",
            ""
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Nuevo login del administrador exitoso', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const response = pm.response.json();",
              "",
              "pm.expect(response.token).to.exist;",
              "",
              "pm.collectionVariables.set('token_admin', response.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Verificar usuario con el nuevo correo",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_admin}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/usuarios/admin?correo={{correo_nuevo}}&pagina=1&tamano=20",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "usuarios",
            "admin"
          ],
          "query": [
            {
              "key": "correo",
              "value": "{{correo_nuevo}}"
            },
            {
              "key": "pagina",
              "value": "1"
            },
            {
              "key": "tamano",
              "value": "20"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Consulta con el nuevo correo exitosa', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const response = pm.response.json();",
              "",
              "pm.test('Existe exactamente un usuario con el nuevo correo', function () {",
              "    pm.expect(response.total).to.eql(1);",
              "});",
              "",
              "pm.test('El correo fue actualizado correctamente', function () {",
              "    pm.expect(response.items).to.have.lengthOf(1);",
              "    pm.expect(response.items[0].correo_electronico).to.eql(pm.collectionVariables.get('correo_nuevo'));",
              "});"
            ]
          }
        }
      ]
    }
  ]
}