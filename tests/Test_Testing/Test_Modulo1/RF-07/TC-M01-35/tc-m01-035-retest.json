    {
      "name": "TC-M01-035 (retest). Intentar reutilizar la contrasena actual como nueva contrasena",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token_prueba}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/contrasena/usuarios/{{id_usuario_prueba}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "contrasena",
            "usuarios",
            "{{id_usuario_prueba}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"contrasena_actual\": \"{{contrasena_prueba_vigente}}\",\n  \"nueva_contrasena\": \"{{contrasena_prueba_vigente}}\",\n  \"confirmar_nueva_contrasena\": \"{{contrasena_prueba_vigente}}\"\n}"
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "console.log('TC-M01-035 retest (nueva = actual): ' + pm.response.code + ' body=' + pm.response.text());",
              "if (pm.response.code === 409) {",
              "    pm.test('TC-M01-035 - CORREGIDO: ahora rechaza con 409 cuando la nueva contrasena es igual a la actual', function () {",
              "        pm.response.to.have.status(409);",
              "    });",
              "    pm.collectionVariables.set('defecto_corregido_035', 'true');",
              "} else {",
              "    console.log('TC-M01-035 - el defecto original (200 en vez de 409) parece seguir presente. Revisar el cuerpo de la respuesta arriba.');",
              "    pm.test('TC-M01-035 - se documenta la respuesta obtenida (no se fuerza el resultado, para no ocultar una regresion si el defecto sigue presente)', function () {",
              "        pm.expect(pm.response.code).to.be.above(0);",
              "    });",
              "    pm.collectionVariables.set('defecto_corregido_035', 'false');",
              "}",
              ""
            ]
          }
        }
      ]
    },
