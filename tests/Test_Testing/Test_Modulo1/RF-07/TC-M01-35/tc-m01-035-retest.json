          "raw": "{\n  \"correo_electronico\": \"{{correo_prueba}}\",\n  \"contrasena\": \"{{contrasena_prueba_vigente}}\"\n}"
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "console.log('0A login cuenta de prueba: ' + pm.response.code + ' body=' + pm.response.text());",
              "pm.test('0A - login responde 200 (confirma que la contrasena vigente conocida sigue siendo correcta y la cuenta no esta bloqueada)', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "if (pm.response.code === 200) { pm.collectionVariables.set('token_prueba', pm.response.json().token); }",
              ""
            ]
          }
        }
      ]
