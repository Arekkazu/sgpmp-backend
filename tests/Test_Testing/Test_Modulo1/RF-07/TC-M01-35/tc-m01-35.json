          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"contrasena_actual\": \"Nueva#2027\",\n  \"nueva_contrasena\": \"Nueva#2027\",\n  \"confirmar_nueva_contrasena\": \"Nueva#2027\"\n}"
        },
        "url": "http://sigab-backendtest-389pcb-a48238-158-69-200-27.sslip.io/api-sgpmp-test/contrasena/usuarios/45"
      }
    }
