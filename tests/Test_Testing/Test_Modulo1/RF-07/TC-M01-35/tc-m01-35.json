{
  "info": {
    "name": "TC-M01-035",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "access_token", "value": "" }
  ],
  "item": [
    {
      "name": "0. Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login responde 200', function () { pm.response.to.have.status(200); });",
              "const jsonData = pm.response.json();",
              "if (jsonData.token) { pm.collectionVariables.set('access_token', jsonData.token); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"u20212200102@usco.edu.co\",\n  \"contrasena\": \"Nueva#2027\"\n}"
        },
        "url": "http://sigab-backendtest-389pcb-a48238-158-69-200-27.sslip.io/api-sgpmp-test/sesiones/"
      }
    },
    {
      "name": "1. TC-M01-035 - Nueva contrasena igual a la actual (esperado 409)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('TC-M01-035: responde 409 Conflict', function () {",
              "    pm.response.to.have.status(409);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
