          "pm.test('Responde 401', function () { pm.response.to.have.status(401); });",
          "const b = pm.response.json();",
          "const normalizado = b.message.replace('Intento 2 de 5', 'Intento N de 5');",
          "pm.test('TC-M01-111: mensaje consistente con intento 1', function () {",
          "    pm.expect(normalizado).to.eql(pm.collectionVariables.get('msg1'));",
