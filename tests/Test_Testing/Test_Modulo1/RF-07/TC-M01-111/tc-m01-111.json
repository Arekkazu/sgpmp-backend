  "item": [
    {
      "name": "0. Login",
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "pm.test('Login responde 200', function () { pm.response.to.have.status(200); });",
          "const jsonData = pm.response.json();",
          "if (jsonData.token) { pm.collectionVariables.set('access_token', jsonData.token); }"
        ] } }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"correo_electronico\": \"u20212200102@usco.edu.co\",\n  \"contrasena\": \"Recuperada#30\"\n}" },
        "url": "http://sigab-backendtest-389pcb-a48238-158-69-200-27.sslip.io/api-sgpmp-test/sesiones/"
      }
    },
    {
      "name": "1. Intento fallido 1 (guardar mensaje)",
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "pm.test('Responde 401', function () { pm.response.to.have.status(401); });",
          "const b = pm.response.json();",
          "pm.collectionVariables.set('msg1', b.message.replace('Intento 1 de 5', 'Intento N de 5'));"
        ] } }
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"contrasena_actual\": \"ClaveErronea1#\",\n  \"nueva_contrasena\": \"OtraClave#99\",\n  \"confirmar_nueva_contrasena\": \"OtraClave#99\"\n}" },
        "url": "http://sigab-backendtest-389pcb-a48238-158-69-200-27.sslip.io/api-sgpmp-test/contrasena/usuarios/45"
      }
    },
    {
      "name": "2. Intento fallido 2 (comparar mensaje)",
