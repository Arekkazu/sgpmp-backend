{
  "info": {
    "name": "TC-M01-031",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "access_token", "value": "" }
  ],
  "item": [
    {
      "name": "1. Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login responde 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const jsonData = pm.response.json();",
              "if (jsonData.token) {",
              "    pm.collectionVariables.set('access_token', jsonData.token);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"u20212200102@usco.edu.co\",\n  \"contrasena\": \"Nueva#2027\"\n}"
        },
        "url": "http://sigab-backendtest-389pcb-a48238-158-69-200-27.sslip.io/api-sgpmp-test/sesiones/"
      }
    },
    {
      "name": "2. TC-M01-031 - Cambiar contrasena incorrecta",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('TC-M01-031: responde 401', function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "const jsonData = pm.response.json();",
              "pm.test('TC-M01-031: error_code correcto', function () {",
              "    pm.expect(jsonData.error_code).to.eql('CONTRASENA_ACTUAL_INCORRECTA');",
              "});",
              "pm.test('TC-M01-031: menciona Intento 1 de 5', function () {",
              "    pm.expect(jsonData.message).to.include('Intento 1 de 5');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"contrasena_actual\": \"ClaveErronea1#\",\n  \"nueva_contrasena\": \"OtraClave#99\",\n  \"confirmar_nueva_contrasena\": \"OtraClave#99\"\n}"
        },
        "url": "http://sigab-backendtest-389pcb-a48238-158-69-200-27.sslip.io/api-sgpmp-test/contrasena/usuarios/45"
      }
    }
  ]
}