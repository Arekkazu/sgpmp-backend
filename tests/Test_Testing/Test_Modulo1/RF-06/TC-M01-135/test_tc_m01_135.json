{
  "info": {
    "_postman_id": "tc-m01-135-activar-cuenta",
    "name": "TC-M01-135 - Activar una cuenta mediante una operación administrativa válida",
    "description": "Validar que un Administrador pueda activar una cuenta que se encuentra Inactiva mediante el endpoint administrativo de gestión de cuentas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://sigab-backendtest-389pcb-a48238-158-69-200-27.sslip.io/api-sgpmp-test"
    },
    {
      "key": "tokenAdmin",
      "value": ""
    },
    {
      "key": "idUsuario",
      "value": ""
    },
    {
      "key": "estadoAnterior",
      "value": "Inactivo"
    },
    {
      "key": "correoObjetivo",
      "value": "m2m.nuevo@ejemplo.com"
    }
  ],
  "item": [
    {
      "name": "01 - Iniciar sesión como administrador",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"admin@pecuaria.co\",\n  \"contrasena\": \"Test1234!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/sesiones/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "sesiones",
            ""
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const response = pm.response.json();",
              "",
              "pm.test(\"Administrador inicia sesión correctamente\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Se obtiene el token del administrador\", function () {",
              "    pm.expect(response.token).to.exist;",
              "});",
              "",
              "pm.collectionVariables.set(\"tokenAdmin\", response.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Consultar usuario inactivo",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenAdmin}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/usuarios/admin?correo={{correoObjetivo}}&pagina=1&tamano=20",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "usuarios",
            "admin"
          ],
          "query": [
            {
              "key": "correo",
              "value": "{{correoObjetivo}}"
            },
            {
              "key": "pagina",
              "value": "1"
            },
            {
              "key": "tamano",
              "value": "20"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const response = pm.response.json();",
              "",
              "pm.test(\"Consulta del usuario exitosa\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Existe exactamente un usuario objetivo\", function () {",
              "    pm.expect(response.total).to.eql(1);",
              "    pm.expect(response.items).to.have.lengthOf(1);",
              "});",
              "",
              "pm.test(\"El correo corresponde al usuario objetivo\", function () {",
              "    pm.expect(response.items[0].correo_electronico).to.eql(\"m2m.nuevo@ejemplo.com\");",
              "});",
              "",
              "pm.test(\"El estado inicial es Inactivo\", function () {",
              "    pm.expect(response.items[0].estado_cuenta).to.eql(\"Inactivo\");",
              "});",
              "",
              "console.log(\"Usuario objetivo:\", response.items[0]);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Obtener detalle del usuario para identificar su ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenAdmin}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/usuarios/admin?correo={{correoObjetivo}}&pagina=1&tamano=20",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "usuarios",
            "admin"
          ],
          "query": [
            {
              "key": "correo",
              "value": "{{correoObjetivo}}"
            },
            {
              "key": "pagina",
              "value": "1"
            },
            {
              "key": "tamano",
              "value": "20"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const response = pm.response.json();",
              "",
              "pm.test(\"El listado contiene el usuario objetivo\", function () {",
              "    pm.expect(response.total).to.eql(1);",
              "});",
              "",
              "pm.collectionVariables.set(\"usuarioEncontrado\", JSON.stringify(response.items[0]));",
              "",
              "console.log(\"El endpoint /usuarios/admin no expone id_usuario directamente.\");",
              "console.log(\"Usuario encontrado:\", response.items[0]);"
            ]
          }
        }
      ]
    }
  ]
}