  "info": {
    "_postman_id": "tc-m01-127-tiempo-respuesta-rbac",
    "name": "TC-M01-127 - Validar el tiempo de respuesta de la autorización RBAC",
    "description": "RF-04. Mide el tiempo de respuesta de 10 solicitudes autorizadas consecutivas a un endpoint protegido por require_permission (GET /roles/, el mismo verificado y ya aprobado en TC-M01-116), usando pm.response.responseTime nativo de Newman -- igual criterio que TC-M01-039/049: es tiempo de UNA sola petición, no carga concurrente, así que no hace falta k6.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://sigab-backendtest-389pcb-a48238-158-69-200-27.sslip.io/api-sgpmp-test"
    },
    {
      "key": "tiempos",
      "value": "[]"
    }
  ],
  "item": [
    {
      "name": "1. Iniciar sesión como Administrador",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"admin@pecuaria.co\",\n  \"contrasena\": \"Test1234!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/sesiones/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "sesiones",
            ""
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Inicio de sesión exitoso\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "var respuesta = pm.response.json();",
              "pm.test(\"El token existe\", function () {",
              "    pm.expect(respuesta.token).to.exist;",
              "});",
              "",
              "pm.environment.set(\"token\", respuesta.token);",
              "pm.collectionVariables.set(\"tiempos\", JSON.stringify([]));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. GET /roles/ - repetición 1/10",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/roles/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "roles",
            ""
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Repetición 1/10: responde 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Repetición 1/10: tiempo de respuesta <= 200 ms (RF-04)\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.at.most(200);",
              "});",
              "",
              "var tiempos = JSON.parse(pm.collectionVariables.get(\"tiempos\") || \"[]\");",
              "tiempos.push(pm.response.responseTime);",
              "pm.collectionVariables.set(\"tiempos\", JSON.stringify(tiempos));",
              "console.log(\"Repetición 1/10: \" + pm.response.responseTime + \" ms\");"
            ]
          }
        }
