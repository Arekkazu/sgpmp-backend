          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "roles",
            ""
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Calentamiento 1/2: responde 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "console.log(\"Calentamiento 1/2: \" + pm.response.responseTime + \" ms (descartado)\");"
            ]
          }
        }
      ]
    },
