          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Repetición 10/10: responde 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Repetición 10/10: tiempo de respuesta <= 200 ms (RF-04)\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.at.most(200);",
              "});",
              "",
              "var tiempos = JSON.parse(pm.collectionVariables.get(\"tiempos\") || \"[]\");",
              "tiempos.push(pm.response.responseTime);",
              "pm.collectionVariables.set(\"tiempos\", JSON.stringify(tiempos));",
              "console.log(\"Repetición 10/10: \" + pm.response.responseTime + \" ms\");",
              "",
              "// Resumen de las 10 repeticiones (mismo criterio que TC-M01-039/049:",
              "// promedio + minimo + maximo, no solo una muestra suelta).",
              "var suma = tiempos.reduce(function (a, b) { return a + b; }, 0);",
              "var promedio = suma / tiempos.length;",
              "var minimo = Math.min.apply(null, tiempos);",
              "var maximo = Math.max.apply(null, tiempos);",
              "",
              "console.log(\"=== TC-M01-127: resumen de 10 repeticiones ===\");",
              "console.log(\"Tiempos (ms): \" + tiempos.join(\", \"));",
              "console.log(\"Promedio: \" + promedio.toFixed(1) + \" ms\");",
              "console.log(\"Mínimo: \" + minimo + \" ms | Máximo: \" + maximo + \" ms\");",
              "",
              "pm.test(\"TC-M01-127: las 10 repeticiones se completaron\", function () {",
              "    pm.expect(tiempos.length).to.eql(10);",
              "});",
              "",
              "pm.test(\"TC-M01-127: el promedio de las 10 repeticiones es <= 200 ms\", function () {",
              "    pm.expect(promedio).to.be.at.most(200);",
              "});"
            ]
          }
        }
      ]
