    {
      "name": "32. GET /roles/ - repetición 30/30",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/roles/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "roles",
            ""
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Repetición 30/30: responde 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var tiempos = JSON.parse(pm.collectionVariables.get(\"tiempos\") || \"[]\");",
              "tiempos.push(pm.response.responseTime);",
              "pm.collectionVariables.set(\"tiempos\", JSON.stringify(tiempos));",
              "console.log(\"Repetición 30/30: \" + pm.response.responseTime + \" ms\");",
              "// Criterio acordado (RF-04, RNF \"validacion de permisos en menos de 200 ms\"):",
              "// promedio <= 200 ms sobre las repeticiones medidas (el p95 se informa por consola, no se exige),",
              "// descartando las peticiones de calentamiento (arranque en frio / conexion TLS).",
              "var orden = tiempos.slice().sort(function (a, b) { return a - b; });",
              "var promedio = tiempos.reduce(function (a, b) { return a + b; }, 0) / tiempos.length;",
              "var p95 = orden[Math.ceil(0.95 * orden.length) - 1];",
              "var minimo = orden[0];",
              "var maximo = orden[orden.length - 1];",
              "var sobre = tiempos.filter(function (t) { return t > 200; }).length;",
              "",
              "console.log(\"=== TC-M01-127: resumen de \" + tiempos.length + \" repeticiones (sin calentamiento) ===\");",
              "console.log(\"Tiempos (ms): \" + tiempos.join(\", \"));",
              "console.log(\"Promedio: \" + promedio.toFixed(1) + \" ms | P95: \" + p95 + \" ms\");",
              "console.log(\"Mínimo: \" + minimo + \" ms | Máximo: \" + maximo + \" ms | Peticiones > 200 ms: \" + sobre + \" de \" + tiempos.length);",
              "",
              "pm.test(\"TC-M01-127: las 30 repeticiones se completaron\", function () {",
              "    pm.expect(tiempos.length).to.eql(30);",
              "});",
              "",
              "pm.test(\"TC-M01-127: el promedio es <= 200 ms\", function () {",
              "    pm.expect(promedio).to.be.at.most(200);",
              "});"
            ]
          }
        }
      ]
    }
