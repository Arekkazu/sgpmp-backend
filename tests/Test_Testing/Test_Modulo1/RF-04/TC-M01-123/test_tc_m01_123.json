              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/roles/{{id_rol}}/permisos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "roles",
            "{{id_rol}}",
            "permisos"
          ]
        }
      },
      "response": []
    },
    {
      "name": "5. Verificar que no existen permisos duplicados",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "console.log('Respuesta permisos finales:', pm.response.text());",
              "",
              "pm.test('Debe consultar correctamente los permisos del rol', function () {",
              "    pm.expect(pm.response.code).to.equal(200);",
              "});",
              "",
              "var permisos = pm.response.json();",
              "console.log('Permisos finales:', permisos);",
              "",
              "pm.test('La respuesta debe contener una lista de permisos', function () {",
              "    pm.expect(permisos).to.be.an('array');",
              "});",
              "",
              "var permisosDuplicados = permisos.filter(function (permiso) {",
              "    return permiso.id_recurso === 29 && permiso.id_accion === 3;",
              "});",
              "",
              "console.log('Cantidad de permisos duplicados encontrados:', permisosDuplicados.length);",
              "",
              "pm.test('El permiso debe existir exactamente una sola vez', function () {",
              "    pm.expect(permisosDuplicados.length).to.equal(1);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
