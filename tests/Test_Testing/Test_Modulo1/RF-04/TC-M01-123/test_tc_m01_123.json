          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/sesiones/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "sesiones",
            ""
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "console.log('Respuesta login:', pm.response.text());",
              "",
              "pm.test('Debe iniciar sesión correctamente como administrador', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "",
              "var respuesta = pm.response.json();",
              "console.log('Respuesta JSON login:', respuesta);",
              "",
              "pm.test('La respuesta debe contener un token de autenticación', function () {",
              "    pm.expect(respuesta.token, 'No se encontró token en la respuesta').to.exist;",
              "});",
              "",
              "if (respuesta.token) {",
              "    pm.collectionVariables.set('token', respuesta.token);",
              "    console.log('Token guardado correctamente');",
              "} else {",
              "    console.log('No se pudo guardar el token');",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2. Crear rol temporal para la prueba",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "var timestamp = Date.now();",
              "var nombreRol = 'Auxiliar de Campo TC123 ' + timestamp;",
              "pm.collectionVariables.set('nombre_rol', nombreRol);",
              "console.log('Nombre del rol temporal:', nombreRol);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "console.log('Respuesta creación rol:', pm.response.text());",
              "",
              "pm.test('Debe crear correctamente el rol temporal', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "",
              "var respuesta = pm.response.json();",
              "console.log('Respuesta JSON creación rol:', respuesta);",
              "",
              "pm.test('La respuesta debe contener el identificador del rol creado', function () {",
              "    pm.expect(respuesta.id_rol, 'No se encontró id_rol en la respuesta').to.exist;",
              "});",
              "",
              "if (respuesta.id_rol) {",
              "    pm.collectionVariables.set('id_rol', respuesta.id_rol);",
              "    console.log('ID del rol creado:', respuesta.id_rol);",
              "} else {",
              "    console.log('No se pudo guardar el ID del rol');",
              "}"
            ],
            "type": "text/javascript"
          }
        }
