          ]
        }
      },
      "response": []
    },
    {
      "name": "3. Asignar permiso válido por primera vez",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "console.log('Respuesta primera asignación:', pm.response.text());",
              "",
              "pm.test('Debe asignar correctamente el permiso por primera vez', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "",
              "var respuesta = pm.response.json();",
              "console.log('Permiso creado:', respuesta);",
              "",
              "pm.test('La primera asignación debe devolver el permiso creado', function () {",
              "    pm.expect(respuesta.id_permiso).to.exist;",
              "    pm.expect(respuesta.id_recurso).to.equal(29);",
              "    pm.expect(respuesta.id_accion).to.equal(3);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
