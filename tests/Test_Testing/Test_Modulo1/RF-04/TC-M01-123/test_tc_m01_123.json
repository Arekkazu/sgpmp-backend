    {
      "name": "4. Intentar asignar el mismo permiso nuevamente",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "console.log('Respuesta asignación duplicada:', pm.response.text());",
              "",
              "var respuesta = pm.response.json();",
              "console.log('Respuesta JSON duplicado:', respuesta);",
              "",
              "pm.test('Debe rechazar la asignación de un permiso duplicado', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([400, 409, 422]);",
              "});",
              "",
              "pm.test('La respuesta debe indicar que la operación no fue exitosa', function () {",
              "    pm.expect(respuesta).to.be.an('object');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
