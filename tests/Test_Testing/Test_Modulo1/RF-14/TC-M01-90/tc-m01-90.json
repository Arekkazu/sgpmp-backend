      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Responde 401 o 423 (bloqueo)', function () {",
        "    pm.expect(pm.response.code).to.be.oneOf([401, 423]);",
        "});"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
