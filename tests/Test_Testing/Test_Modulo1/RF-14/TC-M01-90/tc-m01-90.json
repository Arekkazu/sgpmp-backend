      }
    },
    {
      "name": "6. Verificar que el 5to intento SI genero notificacion interna (tipo_evento 4)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Responde 200', function () { pm.response.to.have.status(200); });",
        "const b = pm.response.json();",
        "const generadas = b.total - parseInt(pm.collectionVariables.get('baseline_total'));",
        "pm.test('TC-M01-090: se genero al menos 1 notificacion nueva tras el 5to intento fallido', function () {",
        "    pm.expect(generadas).to.be.at.least(1);",
        "});",
        "pm.test('TC-M01-090: existe una notificacion de tipo_evento 4 (login fallido)', function () {",
        "    pm.expect(b.items.some(n => n.tipo_evento === 4)).to.be.true;",
        "});"
      ] } }],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_valido}}" }],
        "url": "http://sigab-backendtest-389pcb-a48238-158-69-200-27.sslip.io/api-sgpmp-test/notificaciones?pagina=1&tamano=5"
