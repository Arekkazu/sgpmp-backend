    {
      "name": "6. Verificar que NO se generaron notificaciones duplicadas",
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "pm.test('Responde 200', function () { pm.response.to.have.status(200); });",
          "const b = pm.response.json();",
          "const generadas = b.total - parseInt(pm.collectionVariables.get('baseline_total'));",
          "pm.test('TC-M01-095: los 5 eventos del mismo tipo+usuario+canal generaron como maximo 1 notificacion (sin duplicados)', function () {",
          "    pm.expect(generadas).to.be.at.most(1);",
          "});"
        ] } }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
        "url": "http://sigab-backendtest-389pcb-a48238-158-69-200-27.sslip.io/api-sgpmp-test/notificaciones?pagina=1&tamano=5"
