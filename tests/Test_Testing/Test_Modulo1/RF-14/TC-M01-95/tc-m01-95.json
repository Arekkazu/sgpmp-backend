{
  "info": {
    "name": "TC-M01-095 (politica anti-spam: no duplicar notificaciones en la ventana de 5 min)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "access_token", "value": "" },
    { "key": "contrasena_actual", "value": "Vigilada#42" },
    { "key": "baseline_total", "value": "" }
  ],
  "item": [
    {
      "name": "0. Login (para poder leer el buzon de notificaciones propio)",
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "pm.test('Login responde 200', function () { pm.response.to.have.status(200); });",
          "const b = pm.response.json();",
          "if (b.token) { pm.collectionVariables.set('access_token', b.token); }"
        ] } }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"correo_electronico\": \"danielacastillovargas09@gmail.com\",\n  \"contrasena\": \"{{contrasena_actual}}\"\n}" },
        "url": "http://sigab-backendtest-389pcb-a48238-158-69-200-27.sslip.io/api-sgpmp-test/sesiones/"
      }
    },
    {
      "name": "0b. Notificaciones - linea base",
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "pm.test('Responde 200', function () { pm.response.to.have.status(200); });",
          "const b = pm.response.json();",
          "pm.collectionVariables.set('baseline_total', b.total);"
        ] } }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
        "url": "http://sigab-backendtest-389pcb-a48238-158-69-200-27.sslip.io/api-sgpmp-test/notificaciones?pagina=1&tamano=5"
      }
    },
