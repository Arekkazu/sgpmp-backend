      "value": "sondeo-tc043-retest-a@sgpmp-test.com"
    },
    {
      "key": "correo_sondeo_2",
      "value": "sondeo-tc043-retest-b@sgpmp-test.com"
    },
    {
      "key": "cupo_agotado_043",
      "value": ""
    }
  ]
}