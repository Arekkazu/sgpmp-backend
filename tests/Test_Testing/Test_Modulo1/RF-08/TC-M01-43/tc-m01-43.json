    {
      "name": "4. Solicitud numero 4 - debe rechazarse (ficha espera 429; DEFECTO: responde 422)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('TC-M01-043: el sistema rechaza la 4ta solicitud (bloqueo funciona)', function () {",
        "    pm.expect(pm.response.code).to.be.oneOf([422, 429]);",
        "});",
        "pm.test('TC-M01-043: el codigo deberia ser 429 Too Many Requests segun la ficha (DEFECTO: hoy responde 422)', function () {",
        "    pm.response.to.have.status(429);",
        "});",
        "pm.test('El error_code es LIMITE_SOLICITUDES_EXCEDIDO', function () {",
        "    pm.expect(pm.response.json().error_code).to.eql('LIMITE_SOLICITUDES_EXCEDIDO');",
        "});"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"correo_electronico\": \"tc043-intento4@sgpmp-test.com\"\n}" },
