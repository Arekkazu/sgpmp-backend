              "const texto = pm.response.text() || \"\";",
              "const cuerpo = (() => { try { return pm.response.json(); } catch (e) { return null; } })();",
              "pm.test(\"[TC-M03-257][ASSERT][API-257-01][V:EXPORTAR_FIRMA] responde HTTP 401\", () => pm.expect(pm.response.code).to.eql(401));",
              "pm.test(\"[TC-M03-257][ASSERT][API-257-02][V:EXPORTAR_FIRMA] no devuelve lecturas, estadísticas, alertas, metadatos ni archivos\", () => {",
              "  const claves = [];",
              "  (function recorrer(o) { if (o && typeof o === \"object\") for (const [k, x] of Object.entries(o)) { claves.push(k); recorrer(x); } })(cuerpo);",
              "  const prohibidas = [\"items\", \"estadisticas\", \"total\", \"filtros_aplicados\", \"rango_real_datos\", \"paginas_totales\", \"sensores\", \"alertas\", \"resumen_unidades\"].filter(k => claves.includes(k));",
              "  const nombres = [pm.environment.get(\"nombre_sensor\"), pm.environment.get(\"nombre_unidad\")].filter(n => n && texto.includes(n));",
              "  const disposicion = pm.response.headers.get(\"Content-Disposition\") || \"\";",
              "  const tipo = pm.response.headers.get(\"Content-Type\") || \"\";",
              "  const archivo = /attachment|filename/i.test(disposicion) || /pdf|spreadsheet|excel|octet-stream|csv/i.test(tipo) ? [\"archivo\"] : [];",
              "  pm.expect(prohibidas.concat(nombres.map(n => `nombre «${n}»`), archivo), \"información expuesta\").to.eql([]);",
              "});",
              "pm.test(`[TC-M03-257][INFO][V:EXPORTAR_FIRMA] respuesta registrada: HTTP ${pm.response.code} ${(cuerpo && cuerpo.error_code) || \"\"}`, () => {});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Test-Run-Id",
            "value": "{{run_id}}"
          },
          {
            "key": "X-Sandbox-Secret",
            "value": "{{sandbox_secret}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token_firma}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/iot/monitoreo/historial/exportar?formato=EXCEL&fecha_inicio={{fecha_inicio}}&fecha_fin={{fecha_fin}}&sensor_id={{id_sensor}}&id_infraestructura={{id_area}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "iot",
            "monitoreo",
            "historial",
            "exportar"
          ],
          "query": [
            {
              "key": "formato",
              "value": "EXCEL"
            },
            {
              "key": "fecha_inicio",
              "value": "{{fecha_inicio}}"
            },
            {
              "key": "fecha_fin",
              "value": "{{fecha_fin}}"
            },
            {
              "key": "sensor_id",
              "value": "{{id_sensor}}"
            },
            {
              "key": "id_infraestructura",
              "value": "{{id_area}}"
            }
          ]
        }
      }
    }
  ]
}
