{
  "info": {
    "name": "TC-M03-G128 — Autenticación del historial y la exportación (RF-59)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "TC-M03-257. Seis combinaciones (sin token, token expirado emitido por el sistema, firma manipulada) sobre historial y exportación. Solo se ejecuta desde ejecutar_tc_m03_g128.mjs con autorización vigente, dentro del sandbox del RUN."
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Barrera: la colección solo se ejecuta desde ejecutar_tc_m03_g128.mjs con autorización vigente.",
          "const autorizado = pm.environment.get(\"autorizado_run\") === \"SI\" && !!pm.environment.get(\"run_id\") && /^https:\\/\\//.test(pm.environment.get(\"base_url\") || \"\");",
          "if (!autorizado) { if (pm.execution && typeof pm.execution.skipRequest === \"function\") pm.execution.skipRequest(); throw Error(\"BLOQUEO_G128\"); }"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"[PRE] respuesta dentro del sandbox del RUN\", () => pm.expect(pm.response.headers.get(\"X-Test-Run-Id\")).to.eql(pm.environment.get(\"run_id\")));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "[TC-M03-257] control: el historial con token válido devuelve lecturas del escenario",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const texto = pm.response.text() || \"\";",
              "const cuerpo = (() => { try { return pm.response.json(); } catch (e) { return null; } })();",
              "pm.test(\"[TC-M03-257][PRE] con token válido el historial responde 200 con lecturas del escenario\", () => { pm.expect(pm.response.code).to.eql(200); pm.expect(((cuerpo && cuerpo.items) || []).some(i => String(i.id_sensor) === String(pm.environment.get(\"id_sensor\"))), \"lecturas del escenario\").to.eql(true); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Test-Run-Id",
            "value": "{{run_id}}"
          },
          {
            "key": "X-Sandbox-Secret",
            "value": "{{sandbox_secret}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token_valido}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/iot/monitoreo/historial?fecha_inicio={{fecha_inicio}}&fecha_fin={{fecha_fin}}&sensor_id={{id_sensor}}&id_infraestructura={{id_area}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "iot",
            "monitoreo",
            "historial"
          ],
          "query": [
            {
              "key": "fecha_inicio",
              "value": "{{fecha_inicio}}"
            },
            {
              "key": "fecha_fin",
              "value": "{{fecha_fin}}"
            },
            {
              "key": "sensor_id",
              "value": "{{id_sensor}}"
            },
            {
              "key": "id_infraestructura",
              "value": "{{id_area}}"
            }
          ]
        }
      }
    },
