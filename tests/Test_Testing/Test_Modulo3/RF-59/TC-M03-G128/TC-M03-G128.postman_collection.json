    {
      "name": "[TC-M03-257][V:HISTORIAL_SIN_TOKEN] historial sin token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const texto = pm.response.text() || \"\";",
              "const cuerpo = (() => { try { return pm.response.json(); } catch (e) { return null; } })();",
              "pm.test(\"[TC-M03-257][ASSERT][API-257-01][V:HISTORIAL_SIN_TOKEN] responde HTTP 401\", () => pm.expect(pm.response.code).to.eql(401));",
              "pm.test(\"[TC-M03-257][ASSERT][API-257-02][V:HISTORIAL_SIN_TOKEN] no devuelve lecturas, estadísticas, alertas, metadatos ni archivos\", () => {",
              "  const claves = [];",
              "  (function recorrer(o) { if (o && typeof o === \"object\") for (const [k, x] of Object.entries(o)) { claves.push(k); recorrer(x); } })(cuerpo);",
              "  const prohibidas = [\"items\", \"estadisticas\", \"total\", \"filtros_aplicados\", \"rango_real_datos\", \"paginas_totales\", \"sensores\", \"alertas\", \"resumen_unidades\"].filter(k => claves.includes(k));",
              "  const nombres = [pm.environment.get(\"nombre_sensor\"), pm.environment.get(\"nombre_unidad\")].filter(n => n && texto.includes(n));",
              "  const disposicion = pm.response.headers.get(\"Content-Disposition\") || \"\";",
              "  const tipo = pm.response.headers.get(\"Content-Type\") || \"\";",
              "  const archivo = /attachment|filename/i.test(disposicion) || /pdf|spreadsheet|excel|octet-stream|csv/i.test(tipo) ? [\"archivo\"] : [];",
              "  pm.expect(prohibidas.concat(nombres.map(n => `nombre «${n}»`), archivo), \"información expuesta\").to.eql([]);",
              "});",
              "pm.test(`[TC-M03-257][INFO][V:HISTORIAL_SIN_TOKEN] respuesta registrada: HTTP ${pm.response.code} ${(cuerpo && cuerpo.error_code) || \"\"}`, () => {});"
            ]
          }
        }
      ],
