    },
    {
      "key": "contrasena_admin",
      "value": "Administrador123#"
    },
    {
      "key": "token_admin",
      "value": ""
    },
    {
      "key": "ids_alertas",
      "value": "[]"
    },
    {
      "key": "periodo_ini",
      "value": ""
    },
    {
      "key": "periodo_fin",
      "value": ""
    },
    {
      "key": "sensor_temperatura_ambiental",
      "value": "1"
    },
    {
      "key": "id_infraestructura",
      "value": "1"
    },
    {
      "key": "especie",
