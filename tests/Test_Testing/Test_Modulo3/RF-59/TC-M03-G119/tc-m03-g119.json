  "item": [
    {
      "name": "0A. Login admin.test (Administrador)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('ids_alertas', '[]');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login admin.test (Administrador) exitoso (200)', function () { pm.response.to.have.status(200); });",
              "try { pm.collectionVariables.set('token_admin', pm.response.json().token); } catch (e) {}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/sesiones/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo_electronico\": \"{{correo_admin}}\",\n  \"contrasena\": \"{{contrasena_admin}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "1. Exactitud del resumen con lecturas 10, 20, 30 (TC-M03-239)",
      "item": [
        {
          "name": "1.1 Verificar que las lecturas consideradas por los filtros son 10, 20 y 30",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/iot/monitoreo/historial?fecha_inicio={{periodo_est_ini}}&fecha_fin={{periodo_est_fin}}&sensor_id={{sensor_estadistica}}&tipo_variable={{tipo_variable_estadistica}}&por_pagina=500",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "iot",
                "monitoreo",
                "historial"
              ],
              "query": [
                {
                  "key": "fecha_inicio",
                  "value": "{{periodo_est_ini}}"
                },
                {
                  "key": "fecha_fin",
                  "value": "{{periodo_est_fin}}"
                },
                {
                  "key": "sensor_id",
                  "value": "{{sensor_estadistica}}"
                },
                {
                  "key": "tipo_variable",
                  "value": "{{tipo_variable_estadistica}}"
                },
                {
                  "key": "por_pagina",
                  "value": "500"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const _d = (n) => new Date(Date.now() - n*864e5).toISOString().slice(0,10);",
                  "pm.variables.set('hoy', _d(0)); pm.variables.set('ayer', _d(1)); pm.variables.set('manana', _d(-1));",
                  "pm.variables.set('hoy_m30', _d(30)); pm.variables.set('hoy_m89', _d(89)); pm.variables.set('hoy_m90', _d(90)); pm.variables.set('hoy_m91', _d(91)); pm.variables.set('hoy_m60', _d(60));",
                  "if (!pm.collectionVariables.get('periodo_ini')) pm.variables.set('periodo_ini', _d(30)); else pm.variables.set('periodo_ini', pm.collectionVariables.get('periodo_ini'));",
                  "if (!pm.collectionVariables.get('periodo_fin')) pm.variables.set('periodo_fin', _d(0)); else pm.variables.set('periodo_fin', pm.collectionVariables.get('periodo_fin'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "console.log('[TC-M03-G119 1.1] status=' + pm.response.code + ' t=' + pm.response.responseTime + 'ms body=' + pm.response.text().slice(0, 600));",
                  "let J; try { J = pm.response.json(); } catch (e) { J = {}; }",
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Las lecturas del periodo son exactamente 10, 20 y 30', function () { const v = (J.items || []).map(function (i) { return Number(i.valor); }).sort(function (a, b) { return a - b; }); pm.expect(v).to.eql([10, 20, 30]); });"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Resumen: minimo=10, maximo=30, promedio=20",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/iot/monitoreo/historial?fecha_inicio={{periodo_est_ini}}&fecha_fin={{periodo_est_fin}}&sensor_id={{sensor_estadistica}}&tipo_variable={{tipo_variable_estadistica}}&por_pagina=500",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "iot",
                "monitoreo",
                "historial"
              ],
              "query": [
                {
                  "key": "fecha_inicio",
                  "value": "{{periodo_est_ini}}"
                },
                {
                  "key": "fecha_fin",
                  "value": "{{periodo_est_fin}}"
                },
                {
                  "key": "sensor_id",
                  "value": "{{sensor_estadistica}}"
                },
                {
                  "key": "tipo_variable",
                  "value": "{{tipo_variable_estadistica}}"
                },
                {
                  "key": "por_pagina",
                  "value": "500"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const _d = (n) => new Date(Date.now() - n*864e5).toISOString().slice(0,10);",
                  "pm.variables.set('hoy', _d(0)); pm.variables.set('ayer', _d(1)); pm.variables.set('manana', _d(-1));",
                  "pm.variables.set('hoy_m30', _d(30)); pm.variables.set('hoy_m89', _d(89)); pm.variables.set('hoy_m90', _d(90)); pm.variables.set('hoy_m91', _d(91)); pm.variables.set('hoy_m60', _d(60));",
                  "if (!pm.collectionVariables.get('periodo_ini')) pm.variables.set('periodo_ini', _d(30)); else pm.variables.set('periodo_ini', pm.collectionVariables.get('periodo_ini'));",
                  "if (!pm.collectionVariables.get('periodo_fin')) pm.variables.set('periodo_fin', _d(0)); else pm.variables.set('periodo_fin', pm.collectionVariables.get('periodo_fin'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "console.log('[TC-M03-G119 1.2] status=' + pm.response.code + ' t=' + pm.response.responseTime + 'ms body=' + pm.response.text().slice(0, 600));",
                  "let J; try { J = pm.response.json(); } catch (e) { J = {}; }",
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const e = (J.estadisticas || [])[0] || {};",
                  "pm.test('valor_minimo = 10', function () { pm.expect(Number(e.valor_minimo)).to.eql(10); });",
                  "pm.test('valor_maximo = 30', function () { pm.expect(Number(e.valor_maximo)).to.eql(30); });",
                  "pm.test('valor_promedio = 20', function () { pm.expect(Number(e.valor_promedio)).to.eql(20); });"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 Verificacion contra BD de solo lectura del conjunto de lecturas",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/iot/alertas?pagina=1&por_pagina=1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "iot",
                "alertas"
              ],
              "query": [
                {
                  "key": "pagina",
                  "value": "1"
                },
                {
                  "key": "por_pagina",
                  "value": "1"
                }
              ]
            },
            "description": "Marcador de subcaso no automatizable con Postman/Newman. Motivo: requiere acceso a BD en modo lectura (ficha: API + BD)"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let J; try { J = pm.response.json(); } catch (e) { J = {}; }",
                  "pm.test.skip(\"NO AUTOMATIZABLE POR API - requiere acceso a BD en modo lectura (ficha: API + BD)\");"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Completitud del resumen (TC-M03-240)",
      "item": [
        {
          "name": "2.1 Periodo con alertas y con un intervalo sin lecturas, incluir_alertas=true",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/iot/monitoreo/historial?fecha_inicio={{periodo_ini}}&fecha_fin={{periodo_fin}}&incluir_alertas=true&por_pagina=500",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "iot",
                "monitoreo",
                "historial"
              ],
              "query": [
                {
                  "key": "fecha_inicio",
                  "value": "{{periodo_ini}}"
                },
                {
                  "key": "fecha_fin",
                  "value": "{{periodo_fin}}"
                },
                {
                  "key": "incluir_alertas",
                  "value": "true"
                },
                {
                  "key": "por_pagina",
                  "value": "500"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const _d = (n) => new Date(Date.now() - n*864e5).toISOString().slice(0,10);",
                  "pm.variables.set('hoy', _d(0)); pm.variables.set('ayer', _d(1)); pm.variables.set('manana', _d(-1));",
                  "pm.variables.set('hoy_m30', _d(30)); pm.variables.set('hoy_m89', _d(89)); pm.variables.set('hoy_m90', _d(90)); pm.variables.set('hoy_m91', _d(91)); pm.variables.set('hoy_m60', _d(60));",
                  "if (!pm.collectionVariables.get('periodo_ini')) pm.variables.set('periodo_ini', _d(30)); else pm.variables.set('periodo_ini', pm.collectionVariables.get('periodo_ini'));",
                  "if (!pm.collectionVariables.get('periodo_fin')) pm.variables.set('periodo_fin', _d(0)); else pm.variables.set('periodo_fin', pm.collectionVariables.get('periodo_fin'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "console.log('[TC-M03-G119 2.1] status=' + pm.response.code + ' t=' + pm.response.responseTime + 'ms body=' + pm.response.text().slice(0, 600));",
                  "let J; try { J = pm.response.json(); } catch (e) { J = {}; }",
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const e = (J.estadisticas || [])[0] || {};",
                  "pm.test('El resumen trae desviacion_estandar', function () { pm.expect(e).to.have.property('desviacion_estandar'); });",
                  "pm.test('El resumen trae porcentajes de lecturas dentro y fuera de rango', function () { pm.expect(e).to.have.property('porcentaje_dentro_rango'); pm.expect(e).to.have.property('porcentaje_fuera_rango'); });",
                  "pm.test('El resumen trae total_alertas_en_periodo y es coherente (> 0 si hay alertas)', function () { pm.expect(e).to.have.property('total_alertas_en_periodo'); pm.expect(e.total_alertas_en_periodo).to.be.above(0); });",
                  "pm.test('El resumen trae periodos_sin_datos', function () { pm.expect(e).to.have.property('periodos_sin_datos'); });",
                  "console.log('[G119-2.1][OBSERVADO] campos del resumen = ' + JSON.stringify(Object.keys((J.estadisticas || [])[0] || {})));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Z. Limpieza - cerrar alertas de prueba creadas",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "  let ids = []; try { ids = JSON.parse(pm.collectionVariables.get('ids_alertas') || '[]'); } catch (e) {}",
              "  const base = pm.variables.replaceIn('{{base_url}}'); const tk = pm.collectionVariables.get('token_admin');",
              "  const hdr = {'Content-Type': 'application/json', 'Authorization': 'Bearer ' + tk};",
              "  const patch = (id, estado, cb) => pm.sendRequest({url: base + '/iot/alertas/' + id + '/estado', method: 'PATCH', header: hdr, body: {mode: 'raw', raw: JSON.stringify({nuevo_estado: estado, motivo: 'QA limpieza final TC-M03'})}}, (e, r) => { if (cb) { cb(e, r); } });",
              "  ids.forEach(function (id) { patch(id, 'DESCARTADA', function (e, r) { if (r && r.code === 200) { return; } patch(id, 'RESUELTA', function (e2, r2) { if (r2 && r2.code === 200) { return; } patch(id, 'EN_ATENCION', function () { patch(id, 'RESUELTA'); }); }); }); });",
              "  console.log('[TC-M03-G119] limpieza final: ' + ids.length + ' alerta(s) de prueba cerradas (DESCARTADA/RESUELTA)');",
              "  pm.collectionVariables.set('ids_alertas', '[]');",
              "})();",
              "pm.test('Limpieza final ejecutada', function () { pm.expect(true).to.be.true; });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_admin}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/iot/alertas?pagina=1&por_pagina=1",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "iot",
            "alertas"
          ],
          "query": [
            {
              "key": "pagina",
              "value": "1"
            },
            {
              "key": "por_pagina",
              "value": "1"
            }
          ]
        }
      }
    }
  ]
}