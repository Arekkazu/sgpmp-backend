                  "console.log('[TC-M03-G117 1.2] status=' + pm.response.code + ' t=' + pm.response.responseTime + 'ms body=' + pm.response.text().slice(0, 600));",
                  "let J; try { J = pm.response.json(); } catch (e) { J = {}; }",
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('id_alerta nulo (por defecto false)', function () { (J.items || []).forEach(function (i) { pm.expect(i.id_alerta === null || i.id_alerta === undefined).to.be.true; }); });"
                ]
              }
            }
          ]
