                  "const _d = (n) => new Date(Date.now() - n*864e5).toISOString().slice(0,10);",
                  "pm.variables.set('hoy', _d(0)); pm.variables.set('ayer', _d(1)); pm.variables.set('manana', _d(-1));",
                  "pm.variables.set('hoy_m30', _d(30)); pm.variables.set('hoy_m89', _d(89)); pm.variables.set('hoy_m90', _d(90)); pm.variables.set('hoy_m91', _d(91)); pm.variables.set('hoy_m60', _d(60));",
                  "if (!pm.collectionVariables.get('periodo_ini')) pm.variables.set('periodo_ini', _d(30)); else pm.variables.set('periodo_ini', pm.collectionVariables.get('periodo_ini'));",
                  "if (!pm.collectionVariables.get('periodo_fin')) pm.variables.set('periodo_fin', _d(0)); else pm.variables.set('periodo_fin', pm.collectionVariables.get('periodo_fin'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "console.log('[TC-M03-G117 1.3] status=' + pm.response.code + ' t=' + pm.response.responseTime + 'ms body=' + pm.response.text().slice(0, 600));",
                  "let J; try { J = pm.response.json(); } catch (e) { J = {}; }",
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Al menos una lectura del periodo trae id_alerta', function () { pm.expect((J.items || []).some(function (i) { return i.id_alerta !== null && i.id_alerta !== undefined; })).to.be.true; });",
                  "console.log('[G117-1.3][OBSERVADO] lecturas con alerta = ' + JSON.stringify((J.items || []).filter(function (i) { return i.id_alerta; }).slice(0, 5).map(function (i) { return {id_telemetria: i.id_telemetria, id_alerta: i.id_alerta}; })));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Lista completa de alertas del periodo con los seis campos de la Salida 5 (TC-M03-235)",
      "item": [
        {
          "name": "2.1 incluir_alertas=true con alertas RESUELTA, DESCARTADA y VENCIDA en el periodo",
          "request": {
            "method": "GET",
            "header": [
              {
