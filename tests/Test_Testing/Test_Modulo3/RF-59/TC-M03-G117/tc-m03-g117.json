                  "console.log('[G117-1.3][OBSERVADO] lecturas con alerta = ' + JSON.stringify((J.items || []).filter(function (i) { return i.id_alerta; }).slice(0, 5).map(function (i) { return {id_telemetria: i.id_telemetria, id_alerta: i.id_alerta}; })));"
                ]
              }
            }
          ]
        }
      ]
    },
