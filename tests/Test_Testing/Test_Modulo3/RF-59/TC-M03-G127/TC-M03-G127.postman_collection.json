{
  "info": {
    "name": "TC-M03-G127 — Operaciones auditadas del historial (RF-59)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "TC-M03-256. Genera la consulta y la exportación cuyos registros de auditoría revisa el ejecutor. Solo se ejecuta desde ejecutar_tc_m03_g127.mjs con autorización vigente, dentro del sandbox del RUN."
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Barrera: la colección solo se ejecuta desde ejecutar_tc_m03_g127.mjs con autorización vigente.",
          "const autorizado = pm.environment.get(\"autorizado_run\") === \"SI\" && !!pm.environment.get(\"run_id\") && /^https:\\/\\//.test(pm.environment.get(\"base_url\") || \"\");",
          "if (!autorizado) { if (pm.execution && typeof pm.execution.skipRequest === \"function\") pm.execution.skipRequest(); throw Error(\"BLOQUEO_G127\"); }"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"[PRE] respuesta dentro del sandbox del RUN\", () => pm.expect(pm.response.headers.get(\"X-Test-Run-Id\")).to.eql(pm.environment.get(\"run_id\")));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "[TC-M03-256][V:CONSULTA] consulta del historial con filtros y periodo conocidos",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const cuerpo = (() => { try { return pm.response.json(); } catch (e) { return null; } })();",
              "pm.test(\"[TC-M03-256][PRE][V:CONSULTA] la consulta auditada se ejecuta (HTTP 200) y devuelve lecturas\", () => { pm.expect(pm.response.code).to.eql(200); pm.expect(Array.isArray(cuerpo && cuerpo.items) && cuerpo.items.length > 0, \"lecturas\").to.eql(true); });",
              "pm.test(`[TC-M03-256][INFO][V:CONSULTA] total=${cuerpo && Number.isFinite(cuerpo.total) ? cuerpo.total : \"?\"}`, () => {});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Test-Run-Id",
            "value": "{{run_id}}"
          },
          {
            "key": "X-Sandbox-Secret",
            "value": "{{sandbox_secret}}"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/iot/monitoreo/historial?fecha_inicio={{fecha_inicio}}&fecha_fin={{fecha_fin}}&sensor_id={{id_sensor}}&id_infraestructura={{id_area}}&estado_dato=LECTURA_VALIDA",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "iot",
            "monitoreo",
            "historial"
          ],
          "query": [
            {
              "key": "fecha_inicio",
              "value": "{{fecha_inicio}}"
            },
            {
              "key": "fecha_fin",
              "value": "{{fecha_fin}}"
            },
            {
              "key": "sensor_id",
              "value": "{{id_sensor}}"
            },
            {
              "key": "id_infraestructura",
              "value": "{{id_area}}"
            },
            {
              "key": "estado_dato",
              "value": "LECTURA_VALIDA"
            }
          ]
        }
      }
    },
    {
      "name": "[TC-M03-256][V:EXPORTACION] exportación filtrada del historial",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const cuerpo = (() => { try { return pm.response.json(); } catch (e) { return null; } })();",
              "// El estado (aplica / no disponible por M08 / indeterminado) lo decide el ejecutor a partir de este registro.",
              "pm.test(`[TC-M03-256][INFO][V:EXPORTACION] HTTP ${pm.response.code} ${(cuerpo && cuerpo.error_code) || \"\"}`, () => {});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Test-Run-Id",
            "value": "{{run_id}}"
          },
          {
            "key": "X-Sandbox-Secret",
            "value": "{{sandbox_secret}}"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/iot/monitoreo/historial/exportar?formato=EXCEL&fecha_inicio={{fecha_inicio}}&fecha_fin={{fecha_fin}}&sensor_id={{id_sensor}}&id_infraestructura={{id_area}}&estado_dato=LECTURA_VALIDA",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "iot",
            "monitoreo",
            "historial",
            "exportar"
          ],
          "query": [
            {
              "key": "formato",
              "value": "EXCEL"
            },
            {
              "key": "fecha_inicio",
              "value": "{{fecha_inicio}}"
            },
            {
              "key": "fecha_fin",
              "value": "{{fecha_fin}}"
            },
            {
              "key": "sensor_id",
              "value": "{{id_sensor}}"
            },
            {
              "key": "id_infraestructura",
              "value": "{{id_area}}"
            },
            {
              "key": "estado_dato",
              "value": "LECTURA_VALIDA"
            }
          ]
        }
      }
    }
  ]
}
