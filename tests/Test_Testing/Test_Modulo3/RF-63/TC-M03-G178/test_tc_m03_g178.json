    {
      "name": "05-TC-M03-343-Entidad-Resultado-Custodia",
      "item": [
        {
          "name": "14-TC-M03-343-Filtro-Entidad-Telemetria",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/iot/auditoria?entidad_afectada_id={{id_telemetria_eval}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "iot",
                "auditoria"
              ],
              "query": [
                {
                  "key": "entidad_afectada_id",
                  "value": "{{id_telemetria_eval}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 - Filtro por entidad_afectada_id (lectura) exitoso\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const res = pm.response.json();",
                  "const telId = pm.collectionVariables.get(\"id_telemetria_eval\");",
                  "if (telId && res.items.length > 0) {",
                  "    pm.test(\"Todos los eventos devueltos corresponden a la entidad_afectada_id filtrada\", function () {",
                  "        res.items.forEach(item => {",
                  "            pm.expect(String(item.entidad_afectada_id)).to.eql(telId);",
                  "        });",
                  "    });",
                  "}",
                  "",
                  "pm.test(\"TC-M03-343: cadena de custodia con orden coherente\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.items.length).to.be.at.least(2,",
                  "        \"una cadena de custodia completa requiere al menos 2 eventos\");",
                  "",
                  "    const timestamps = body.items.map(it => new Date(it.fecha_hora).getTime());",
                  "    const esASC  = timestamps.every((t, i) => i === 0 || t >= timestamps[i-1]);",
                  "    const esDESC = timestamps.every((t, i) => i === 0 || t <= timestamps[i-1]);",
                  "    pm.expect(esASC || esDESC,",
                  "        `eventos no ordenados coherentemente: ${timestamps.join(\", \")}`);",
                  "});",
                  "",
                  "pm.test(\"TC-M03-343: secuencia logica captura -> validacion -> calidad -> vinculacion\", function () {",
                  "    const body = pm.response.json();",
                  "    const tipos = body.items.map(it => it.tipo_evento);",
                  "    const ordenEsperado = [",
                  "        \"TELEMETRIA_VALIDADA\", \"POSTCOMMIT_RF53_LECTURAS_COMPLETADO\",",
                  "        \"EVALUACION_CALIDAD_COMPLETADA\"",
                  "    ];",
                  "    const presentes = ordenEsperado.filter(t => tipos.includes(t));",
                  "    pm.expect(presentes.length).to.be.at.least(2,",
                  "        `se esperaban >=2 eventos de la cadena, encontrados: ${presentes.join(\", \")}`);",
                  "});"
                ]
              }
            }
          ]
        },
