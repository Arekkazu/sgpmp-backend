        {
          "name": "21-Verificar-Integridad-Rango-Invertido",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const now = Date.now();",
                  "pm.collectionVariables.set('fecha_futura_iso', new Date(now + 3600000).toISOString());",
                  "pm.collectionVariables.set('fecha_pasada_iso', new Date(now - 3600000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('21 - Rango invertido: 400 RANGO_FECHAS_INVALIDO', () => {",
                  "    pm.response.to.have.status(400);",
                  "    pm.expect(pm.response.json().error_code).to.eql('RANGO_FECHAS_INVALIDO');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
