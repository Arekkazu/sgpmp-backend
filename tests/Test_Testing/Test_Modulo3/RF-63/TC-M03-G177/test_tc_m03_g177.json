            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado_nuevo\": \"MANTENIMIENTO\",\n  \"motivo\": \"Inspeccion tecnica semestral QA G177\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 - Transición manual a mantenimiento aplicada\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.estado_actual).to.eql(\"MANTENIMIENTO\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "07-Solicitar-Reevaluacion-Calidad",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              },
              {
                "key": "Content-Type",
