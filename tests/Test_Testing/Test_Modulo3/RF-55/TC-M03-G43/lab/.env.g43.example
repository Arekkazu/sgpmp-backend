# Plantilla del laboratorio G43. Copiar a .env.g43 (gitignorado).
# No usar valores de producción, G38, G41 ni Raspberry.

# --- PostgreSQL exclusivo (host 127.0.0.1:5439) ---
POSTGRES_USER=g43_admin
POSTGRES_PASSWORD=cambiar_esta_clave_g43_admin
POSTGRES_DB=sgpmp_g43_test
G43_PG_HOST_PORT=5439

# Usuario de aplicación del lab (se crea DESPUÉS de restaurar; no ahora).
G43_APP_USER=g43_app
G43_APP_PASSWORD=cambiar_esta_clave_g43_app

# --- Mosquitto exclusivo (host 127.0.0.1:1884) ---
G43_MQTT_HOST_PORT=1884
MQTT_USERNAME=g43_gateway
MQTT_PASSWORD=cambiar_esta_clave_mqtt_gw
MQTT_DEVICE_USERNAME=g43_edge
MQTT_DEVICE_PASSWORD=cambiar_esta_clave_mqtt_edge

# --- Backend local (no iniciar en esta fase) ---
# DATABASE_URL debe usar SOLO sgpmp_g43_test en 127.0.0.1:5439.
# Prohibido: .../sgpmp  y  .../sgpmp_pr14_test
DATABASE_URL=postgresql+psycopg2://g43_app:cambiar_esta_clave_g43_app@127.0.0.1:5439/sgpmp_g43_test
BACKEND_BIND=127.0.0.1
BACKEND_PORT=18043

# Token de laboratorio (mismo valor en gateway y backend). No copiar el de TEST/prod.
BROKER_SERVICE_TOKEN=cambiar_token_laboratorio_g43

# --- Gateway MQTT→HTTP (proceso local, no Dokploy) ---
MQTT_HOST=127.0.0.1
MQTT_PORT=1884
BACKEND_URL=http://127.0.0.1:18043
# El gateway también lee modulo9: misma base G43, nunca sgpmp.
# DATABASE_URL del gateway = la misma sgpmp_g43_test (driver async según el clone).

# --- Firmware (worktree rf55-validation, EDGE_SOURCE=fake) ---
EDGE_MQTT_HOST=127.0.0.1
EDGE_MQTT_PORT=1884
EDGE_SERIALS=G43-LAB-001
EDGE_SOURCE=fake
EDGE_FAKE_VARIABLES=temperatura_ambiente:C:21:21
EDGE_FRECUENCIA_CAPTURA_MIN=60
EDGE_MQTT_USERNAME=g43_edge

# Dump de referencia (solo lectura). No restaurar en esta fase.
G43_DUMP_PATH=../../../../../../../DBIntegrador/backups/backup_sgpmp_dev_2026-10-30.dump
