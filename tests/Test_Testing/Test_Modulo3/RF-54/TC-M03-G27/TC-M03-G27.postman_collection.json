        {
          "name": "TC-M03-054 - Historial RF-60: cada transición se registra una sola vez",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Historial responde 200', function () { pm.response.to.have.status(200); });",
                  "let h = []; try { h = pm.response.json(); } catch (e) {}",
                  "console.log('TC-M03-054 historial:', JSON.stringify(h.map(t => [t.id_transaccion, t.estado_anterior, t.estado_nuevo, t.fecha_transicion])));",
                  "pm.test('El historial registra BUFFER_ACTIVO -> ACTIVO', function () {",
                  "  pm.expect(h.some(t => t.estado_anterior === 'BUFFER_ACTIVO' && t.estado_nuevo === 'ACTIVO')).to.eql(true);",
                  "});",
                  "const ordenado = h.slice().sort((a, b) => a.id_transaccion - b.id_transaccion);",
                  "const repetidas = ordenado.filter((t, i) => i > 0 && t.estado_anterior === ordenado[i - 1].estado_anterior && t.estado_nuevo === ordenado[i - 1].estado_nuevo);",
                  "pm.test('Ninguna transición aparece duplicada (misma transición dos veces seguidas)', function () {",
                  "  pm.expect(repetidas.map(t => t.id_transaccion + ': ' + t.estado_anterior + ' -> ' + t.estado_nuevo)).to.eql([]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": {
