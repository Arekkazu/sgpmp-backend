            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": {{device_id}},\n  \"serial\": \"{{access_key}}\",\n  \"tipo_mensaje\": \"HEARTBEAT\",\n  \"estado_local_buffer\": \"I\",\n  \"datos_pendientes_buffer\": 0,\n  \"metricas_buffer\": {\n    \"capacidad_total\": 100,\n    \"capacidad_utilizada\": 0,\n    \"ultimo_timestamp_pendiente\": null,\n    \"politica_buffer_activa\": \"POLITICA_RECHAZO\"\n  },\n  \"fecha_registro\": \"{{ahora}}\"\n}",
              "options": {
