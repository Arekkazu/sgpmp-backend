    {
      "name": "2. TC-M03-054 Estado del buffer por API",
      "item": [
        {
          "name": "TC-M03-054 - GET /dispositivos/{id}/buffer (ruta de la ficha)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('TC-M03-054: el estado del buffer se puede consultar (200)', function () { pm.response.to.have.status(200); });",
                  "let j = {}; try { j = pm.response.json(); } catch (e) {}",
                  "const b = j.buffer || j;",
                  "const campos = ['capacidad_total', 'capacidad_utilizada', 'porcentaje_ocupacion', 'datos_pendientes', 'ultimo_timestamp_pendiente', 'estado_buffer', 'politica_buffer_activa'];",
                  "pm.test('TC-M03-054: la respuesta incluye los 7 campos del buffer', function () {",
                  "  pm.expect(campos.filter(c => !(c in b)), 'faltan').to.eql([]);",
                  "});",
                  "pm.test('TC-M03-054: datos_pendientes = 37 y estado_buffer en NORMAL/WARNING/CRITICO', function () {",
                  "  pm.expect(Number(b.datos_pendientes)).to.eql(37);",
                  "  pm.expect(['NORMAL', 'WARNING', 'CRITICO', 'CRÍTICO']).to.include(b.estado_buffer);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/dispositivos/{{device_id}}/buffer",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "dispositivos",
                "{{device_id}}",
                "buffer"
              ]
            }
          },
          "response": []
        },
        {
          "name": "TC-M03-054 - GET /iot/dispositivos/{id}/buffer (ruta del módulo de telemetría)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('TC-M03-054: el estado del buffer se puede consultar (200)', function () { pm.response.to.have.status(200); });",
                  "let j = {}; try { j = pm.response.json(); } catch (e) {}",
                  "const b = j.buffer || j;",
                  "const campos = ['capacidad_total', 'capacidad_utilizada', 'porcentaje_ocupacion', 'datos_pendientes', 'ultimo_timestamp_pendiente', 'estado_buffer', 'politica_buffer_activa'];",
                  "pm.test('TC-M03-054: la respuesta incluye los 7 campos del buffer', function () {",
                  "  pm.expect(campos.filter(c => !(c in b)), 'faltan').to.eql([]);",
                  "});",
                  "pm.test('TC-M03-054: datos_pendientes = 37 y estado_buffer en NORMAL/WARNING/CRITICO', function () {",
                  "  pm.expect(Number(b.datos_pendientes)).to.eql(37);",
                  "  pm.expect(['NORMAL', 'WARNING', 'CRITICO', 'CRÍTICO']).to.include(b.estado_buffer);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/iot/dispositivos/{{device_id}}/buffer",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "iot",
                "dispositivos",
                "{{device_id}}",
                "buffer"
              ]
            }
          },
          "response": []
        },
        {
          "name": "TC-M03-054 - Referencia: lo que expone hoy el estado del dispositivo (RF-60)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado del dispositivo responde 200', function () { pm.response.to.have.status(200); });",
                  "const e = pm.response.json().estado || {};",
                  "console.log('TC-M03-054 estado del dispositivo:', JSON.stringify(e));",
                  "pm.test('El estado del dispositivo refleja el buffer activo (BUFFER_ACTIVO)', function () { pm.expect(e.estado_actual).to.eql('BUFFER_ACTIVO'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/iot/dispositivos/{{device_id}}/estado",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "iot",
                "dispositivos",
                "{{device_id}}",
                "estado"
              ]
            }
