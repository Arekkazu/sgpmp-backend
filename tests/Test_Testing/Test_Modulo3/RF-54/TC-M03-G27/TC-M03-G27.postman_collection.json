    {
      "name": "2. TC-M03-054 Estado del buffer por API",
      "item": [
        {
          "name": "TC-M03-054 - GET /iot/dispositivos/{id}/buffer: estado del buffer del dispositivo (INC-M03-126)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// La ficha nombra GET /dispositivos/{id}/buffer; el sistema lo expone en el módulo de telemetría (INC-M03-126).",
                  "pm.test('TC-M03-054: el estado del buffer se puede consultar (200)', function () { pm.response.to.have.status(200); });",
                  "let b = {}; try { b = pm.response.json(); } catch (e) {}",
                  "console.log('TC-M03-054 buffer:', JSON.stringify(b));",
                  "const campos = ['capacidad_total', 'capacidad_utilizada', 'porcentaje_ocupacion', 'datos_pendientes', 'ultimo_timestamp_pendiente', 'estado_buffer', 'politica_buffer_activa'];",
                  "pm.test('TC-M03-054: la respuesta incluye los 7 campos del buffer', function () { pm.expect(campos.filter(c => !(c in b)), 'faltan').to.eql([]); });",
                  "pm.test('TC-M03-054: refleja lo reportado por el Edge (100 / 37, 37 pendientes)', function () {",
                  "  pm.expect(Number(b.capacidad_total)).to.eql(100);",
                  "  pm.expect(Number(b.capacidad_utilizada)).to.eql(37);",
                  "  pm.expect(Number(b.datos_pendientes)).to.eql(37);",
                  "  pm.expect(b.metricas_disponibles).to.eql(true);",
                  "});",
                  "pm.test('TC-M03-054: porcentaje_ocupacion = 37 y estado_buffer NORMAL (< 80 %)', function () {",
                  "  pm.expect(Number(b.porcentaje_ocupacion)).to.eql(37);",
                  "  pm.expect(b.estado_buffer).to.eql('NORMAL');",
                  "});",
                  "pm.test('TC-M03-054: política activa y último timestamp pendiente informados', function () {",
                  "  pm.expect(b.politica_buffer_activa).to.eql('POLITICA_RECHAZO');",
                  "  pm.expect(b.ultimo_timestamp_pendiente).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/iot/dispositivos/{{device_id}}/buffer",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "iot",
                "dispositivos",
                "{{device_id}}",
                "buffer"
              ]
            }
          },
          "response": []
        },
        {
          "name": "TC-M03-054 - GET /iot/buffer: el dispositivo aparece en el panel del buffer Edge",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Panel del buffer responde 200', function () { pm.response.to.have.status(200); });",
                  "let j = []; try { j = pm.response.json(); } catch (e) {}",
                  "const lista = Array.isArray(j) ? j : (j.items || []);",
                  "const d = lista.find(x => x.id_dispositivo_iot === Number(pm.collectionVariables.get('device_id'))) || {};",
                  "console.log('TC-M03-054 panel:', JSON.stringify(d));",
                  "pm.test('TC-M03-054: el dispositivo está en el panel con su serial y 37 % NORMAL', function () {",
                  "  pm.expect(d.serial).to.eql(pm.collectionVariables.get('access_key'));",
                  "  pm.expect(Number(d.porcentaje_ocupacion)).to.eql(37);",
                  "  pm.expect(d.estado_buffer).to.eql('NORMAL');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/iot/buffer",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "iot",
                "buffer"
              ]
            }
          },
          "response": []
        },
        {
          "name": "TC-M03-054 - Estado del dispositivo (RF-60) pasa a BUFFER_ACTIVO con datos pendientes",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// El estado RF-60 lo actualiza el procesamiento posterior al heartbeat (asíncrono): se reintenta cada 5 s,",
                  "// hasta 12 veces, mientras no llegue a BUFFER_ACTIVO; las aserciones van solo con la respuesta final.",
                  "const _clave = 'reintentos_' + pm.info.requestName;",
                  "const _n = Number(pm.collectionVariables.get(_clave) || 0);",
                  "if (pm.response.code === 200 && (pm.response.json().estado || {}).estado_actual !== 'BUFFER_ACTIVO' && _n < 12) {",
                  "  pm.collectionVariables.set(_clave, _n + 1);",
                  "  setTimeout(function () {}, 5000);",
                  "  pm.execution.setNextRequest(pm.info.requestName);",
                  "  return;",
                  "}",
                  "pm.collectionVariables.unset(_clave);",
                  "pm.test('Estado del dispositivo responde 200', function () { pm.response.to.have.status(200); });",
                  "const e = pm.response.json().estado || {};",
                  "console.log('TC-M03-054 estado:', JSON.stringify(e));",
                  "pm.test('El estado del dispositivo refleja el buffer activo (BUFFER_ACTIVO)', function () { pm.expect(e.estado_actual).to.eql('BUFFER_ACTIVO'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/iot/dispositivos/{{device_id}}/estado",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "iot",
                "dispositivos",
                "{{device_id}}",
                "estado"
              ]
            }
          },
          "response": []
        },
        {
          "name": "TC-M03-054 - BUFFER_ACTIVO se sostiene sin un reporte nuevo (INC-M03-127, 60 s después)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Ventana para que corra la evaluación periódica de estados (antes devolvía ACTIVO a los pocos segundos).",
                  "// Después se renueva la sesión: la cuenta admin de TEST es compartida y un login ajeno revoca el token (TOKEN_REVOCADO).",
                  "setTimeout(function () {",
                  "  pm.sendRequest({",
                  "    url: pm.collectionVariables.get('base_url') + '/sesiones/',",
                  "    method: 'POST',",
                  "    header: { 'Content-Type': 'application/json' },",
                  "    body: { mode: 'raw', raw: JSON.stringify({ correo_electronico: 'admin@pecuaria.co', contrasena: 'Test1234!' }) }",
                  "  }, function (err, res) {",
                  "    if (!err && res.code === 200) { pm.collectionVariables.set('token_admin', res.json().token); }",
                  "  });",
                  "}, 60000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado del dispositivo responde 200', function () { pm.response.to.have.status(200); });",
                  "const e = pm.response.json().estado || {};",
                  "console.log('TC-M03-054 estado tras 60 s:', JSON.stringify(e));",
                  "pm.test('Sin un heartbeat que confirme el vaciado, sigue en BUFFER_ACTIVO', function () { pm.expect(e.estado_actual).to.eql('BUFFER_ACTIVO'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/iot/dispositivos/{{device_id}}/estado",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "iot",
                "dispositivos",
                "{{device_id}}",
                "estado"
              ]
            }
          },
          "response": []
        },
        {
          "name": "TC-M03-054 - El Edge confirma el buffer vacío (heartbeat 0 pendientes, 0/100)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
