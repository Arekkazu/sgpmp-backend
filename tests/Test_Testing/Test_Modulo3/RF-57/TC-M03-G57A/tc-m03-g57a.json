    {
      "name": "1. Modificar un umbral como Administrador e Ingeniero de Campo (TC-M03-N33)",
      "item": [
        {
          "name": "1.1 GET umbrales de la especie: ubicar el umbral de TEMPERATURA_AMBIENTAL y guardar su estado original",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/configuracion/umbrales?id_especie={{id_especie}}&solo_activas=true",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "configuracion",
                "umbrales"
              ],
              "query": [
                {
                  "key": "id_especie",
                  "value": "{{id_especie}}"
                },
                {
                  "key": "solo_activas",
                  "value": "true"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "console.log('[TC-M03-G57A 1.1] status=' + pm.response.code + ' t=' + pm.response.responseTime + 'ms body=' + pm.response.text().slice(0, 600));",
                  "let J; try { J = pm.response.json(); } catch (e) { J = {}; }",
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const u = (J.items || []).find(function (x) { return String(x.id_variable_ambiental) === pm.collectionVariables.get('id_variable_temp_ambiental'); });",
                  "pm.test('Existe el umbral de TEMPERATURA_AMBIENTAL para la especie', function () { pm.expect(u).to.exist; });",
                  "if (u) { pm.collectionVariables.set('id_umbral_temp', String(u.id_umbral_ambiental)); pm.collectionVariables.set('umbral_original', JSON.stringify(u)); }"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Administrador: modificar el limite del nivel LEVE (de >30 a >28)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": "{{base_url}}/configuracion/umbrales/{{id_umbral_temp}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"valor_min\": 0,\n  \"valor_max\": 0,\n  \"niveles\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "El body se reconstruye en el pre-request a partir del umbral original (variable umbral_original)."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const o = JSON.parse(pm.collectionVariables.get('umbral_original') || '{}');",
                  "const niv = (o.niveles || []).map(function (n) { const m = Object.assign({}, n); if (String(n.nivel).toUpperCase().indexOf('LEVE') >= 0) { m.limite_inferior = 28; } return m; });",
                  "pm.request.body.update(JSON.stringify({valor_min: o.valor_min, valor_max: o.valor_max, niveles: niv, fecha_actualizacion: o.fecha_actualizacion}));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "console.log('[TC-M03-G57A 1.2] status=' + pm.response.code + ' t=' + pm.response.responseTime + 'ms body=' + pm.response.text().slice(0, 600));",
                  "let J; try { J = pm.response.json(); } catch (e) { J = {}; }",
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 La nueva configuracion persiste (rige sin despliegue)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/configuracion/umbrales?id_especie={{id_especie}}&solo_activas=true",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "configuracion",
                "umbrales"
              ],
              "query": [
                {
                  "key": "id_especie",
                  "value": "{{id_especie}}"
                },
                {
                  "key": "solo_activas",
                  "value": "true"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "console.log('[TC-M03-G57A 1.3] status=' + pm.response.code + ' t=' + pm.response.responseTime + 'ms body=' + pm.response.text().slice(0, 600));",
                  "let J; try { J = pm.response.json(); } catch (e) { J = {}; }",
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('El nivel LEVE refleja el nuevo limite 28', function () { const u = J.items.find(function (x) { return String(x.id_umbral_ambiental) === pm.collectionVariables.get('id_umbral_temp'); }); pm.expect(u, 'umbral encontrado').to.exist; pm.expect(JSON.stringify((u || {}).niveles)).to.include('28'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "1.4 Evento en el nuevo borde (29.0 C) - se clasifica con el nuevo umbral (LEVE)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/iot/alertas",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": {{device_id}},\n  \"sensor_id\": {{sensor_temperatura_ambiental}},\n  \"access_key\": \"{{access_key}}\",\n  \"tipo_variable\": \"TEMPERATURA_AMBIENTAL\",\n  \"valor\": 29.0,\n  \"unidad\": \"°C\",\n  \"timestamp_evento\": \"{{ts_now}}\",\n  \"estado_dato\": \"LECTURA_VALIDA\",\n  \"severidad_edge\": \"LEVE\",\n  \"origen_evento\": \"EDGE\",\n  \"id_evento_edge_computing\": {{id_evento_edge}},\n  \"reglas_activadas\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const _n = Date.now(); const _iso = (ms) => new Date(ms).toISOString();",
                  "pm.variables.set('ts_now', _iso(_n));",
                  "pm.variables.set('ts_m1s', _iso(_n - 1000));",
                  "pm.variables.set('ts_m10m', _iso(_n - 10*60000));",
                  "pm.variables.set('ts_m20m', _iso(_n - 20*60000));",
                  "pm.variables.set('ts_m31m', _iso(_n - 31*60000));",
                  "pm.variables.set('ts_p1h', _iso(_n + 3600000));",
                  "pm.variables.set('ts_p10m', _iso(_n + 10*60000));",
                  "pm.variables.set('uniq', String(_n).slice(-9));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "console.log('[TC-M03-G57A 1.4] status=' + pm.response.code + ' t=' + pm.response.responseTime + 'ms body=' + pm.response.text().slice(0, 600));",
                  "let J; try { J = pm.response.json(); } catch (e) { J = {}; }",
                  "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Evento aceptado: es_duplicado=false e id_alerta presente', function () { pm.expect(J.es_duplicado).to.eql(false); pm.expect(J.id_alerta).to.exist; });",
                  "pm.test('severidad = LEVE', function () { pm.expect(J.severidad).to.eql('LEVE'); });",
                  "console.log('[OBS][OBSERVADO] tipo_alerta/severidad/es_duplicado = ' + JSON.stringify({tipo_alerta: J.tipo_alerta, severidad: J.severidad, es_duplicado: J.es_duplicado, id_alerta: J.id_alerta}));",
                  "(function () {",
                  "  const id = (J || {}).id_alerta; if (!id) { return; }",
                  "  const base = pm.variables.replaceIn('{{base_url}}'); const tk = pm.collectionVariables.get('token_admin');",
                  "  if (!tk) { return; }",
                  "  const hdr = {'Content-Type': 'application/json', 'Authorization': 'Bearer ' + tk};",
                  "  const patch = (estado, cb) => pm.sendRequest({url: base + '/iot/alertas/' + id + '/estado', method: 'PATCH', header: hdr, body: {mode: 'raw', raw: JSON.stringify({nuevo_estado: estado, motivo: 'QA limpieza automatica TC-M03'})}}, (e, r) => { if (cb) { cb(e, r); } });",
                  "  patch('DESCARTADA', (e, r) => { if (r && r.code === 200) { return; } patch('EN_ATENCION', () => patch('RESUELTA')); });",
                  "})();"
                ]
              }
            }
          ]
        },
