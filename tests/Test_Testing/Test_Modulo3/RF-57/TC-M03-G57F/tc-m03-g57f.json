            "url": "{{base_url}}/iot/alertas",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": {{device_id}},\n  \"sensor_id\": {{sensor_frecuencia_respiratoria}},\n  \"access_key\": \"{{access_key}}\",\n  \"tipo_variable\": \"FRECUENCIA_RESPIRATORIA\",\n  \"valor\": 76,\n  \"unidad\": \"rpm\",\n  \"timestamp_evento\": \"{{ts_now}}\",\n  \"estado_dato\": \"LECTURA_VALIDA\",\n  \"severidad_edge\": \"MODERADO\",\n  \"origen_evento\": \"EDGE\",\n  \"id_evento_edge_computing\": {{id_evento_edge}},\n  \"reglas_activadas\": [\"FR_LEVE\", \"TC_39_5\", \"NH3_25\"],\n  \"correlacion_variables\": {\n    \"TEMPERATURA_CORPORAL\": 39.6,\n    \"NH3\": 26\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const _n = Date.now(); const _iso = (ms) => new Date(ms).toISOString();",
                  "pm.variables.set('ts_now', _iso(_n));",
                  "pm.variables.set('ts_m1s', _iso(_n - 1000));",
                  "pm.variables.set('ts_m10m', _iso(_n - 10*60000));",
                  "pm.variables.set('ts_m20m', _iso(_n - 20*60000));",
                  "pm.variables.set('ts_m31m', _iso(_n - 31*60000));",
                  "pm.variables.set('ts_p1h', _iso(_n + 3600000));",
                  "pm.variables.set('ts_p10m', _iso(_n + 10*60000));",
                  "pm.variables.set('uniq', String(_n).slice(-9));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "console.log('[TC-M03-G57F 2.5] status=' + pm.response.code + ' t=' + pm.response.responseTime + 'ms body=' + pm.response.text().slice(0, 600));",
                  "let J; try { J = pm.response.json(); } catch (e) { J = {}; }",
                  "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
                  "if (J && J.id_alerta) { pm.collectionVariables.set('a57f_c', String(J.id_alerta)); }",
                  "pm.test('Evento aceptado: es_duplicado=false e id_alerta presente', function () { pm.expect(J.es_duplicado).to.eql(false); pm.expect(J.id_alerta).to.exist; });"
                ]
              }
            }
