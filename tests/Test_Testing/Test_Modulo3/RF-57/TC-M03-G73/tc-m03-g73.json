  "item": [
    {
      "name": "0A. Login admin.test (Administrador)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('ids_alertas', '[]');"
