    {
      "name": "2. Tormenta de alertas: N_sistema=20/min y N_unidad=5/min (TC-M03-163)",
      "item": [
        {
          "name": "2.1 Rafaga de 21 eventos en <60 s (supera N_sistema=20/min) y consulta de TORMENTA_DE_ALERTAS",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/iot/alertas?tipo_alerta=TORMENTA_DE_ALERTAS&por_pagina=20",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "iot",
                "alertas"
              ],
              "query": [
                {
                  "key": "tipo_alerta",
                  "value": "TORMENTA_DE_ALERTAS"
                },
                {
                  "key": "por_pagina",
                  "value": "20"
                }
              ]
            },
            "description": "Genera 21 eventos de rafaga con pm.sendRequest en el pre-request; la verificacion fina de N_unidad=5/min y de la desactivacion (tasa < 0.5xN durante 2 min) se ejecuta con k6."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const base = pm.variables.replaceIn('{{base_url}}');",
                  "const vars = ['TEMPERATURA_AMBIENTAL','HUMEDAD_RELATIVA','PH_AGUA','NH3','CO2'];",
                  "for (let i = 0; i < 21; i++) { const v = vars[i % vars.length]; const body = {device_id: Number(pm.collectionVariables.get('device_id')), sensor_id: Number(pm.collectionVariables.get('sensor_' + v.toLowerCase())), access_key: pm.collectionVariables.get('access_key'), tipo_variable: v, valor: 30 + i, unidad: 'u', timestamp_evento: new Date().toISOString(), estado_dato: 'LECTURA_VALIDA', severidad_edge: 'LEVE', origen_evento: 'EDGE', id_evento_edge_computing: Number(pm.collectionVariables.get('id_evento_edge')), reglas_activadas: []};",
                  "  pm.sendRequest({url: base + '/iot/alertas', method: 'POST', header: {'Content-Type': 'application/json'}, body: {mode: 'raw', raw: JSON.stringify(body)}}, function () {}); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "console.log('[TC-M03-G81 2.1] status=' + pm.response.code + ' t=' + pm.response.responseTime + 'ms body=' + pm.response.text().slice(0, 600));",
                  "let J; try { J = pm.response.json(); } catch (e) { J = {}; }",
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Modo agrupacion/tormenta: existe alerta TORMENTA_DE_ALERTAS para el administrador', function () { pm.expect(J.total).to.be.above(0); });",
                  "console.log('[G81-2.1][OBSERVADO] alertas de tormenta = ' + JSON.stringify((J.items || []).slice(0, 3)));"
                ]
              }
            }
          ]
        },
        {
          "name": "2.2 Los eventos CRITICOS se procesan siempre de forma individual (no agrupados)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/iot/alertas?severidad=CRITICO&por_pagina=50",
              "host": [
                "{{base_url}}"
              ],
              "path": [
