    {
      "name": "4. Notificacion al administrador para completar la asociacion (TC-M03-N21 / RF-22)",
      "item": [
        {
          "name": "4.1 Notificaciones del administrador tras los subcasos 2 y 3",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/notificaciones?pagina=1&tamano=20",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "notificaciones"
              ],
              "query": [
                {
                  "key": "pagina",
                  "value": "1"
                },
                {
                  "key": "tamano",
                  "value": "20"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "console.log('[TC-M03-G77 4.1] status=' + pm.response.code + ' t=' + pm.response.responseTime + 'ms body=' + pm.response.text().slice(0, 600));",
                  "let J; try { J = pm.response.json(); } catch (e) { J = {}; }",
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('El administrador recibe notificacion de contexto incompleto (completar asociacion del sensor)', function () { const items = J.items || J.notificaciones || J.data || []; pm.expect(JSON.stringify(items).toLowerCase()).to.include('asociaci'); });",
                  "console.log('[G77-4.1][OBSERVADO] notificaciones = ' + JSON.stringify((J.items || J.notificaciones || J.data || []).slice(0, 5)));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Z. Limpieza - cerrar alertas de prueba creadas",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "  let ids = []; try { ids = JSON.parse(pm.collectionVariables.get('ids_alertas') || '[]'); } catch (e) {}",
              "  const base = pm.variables.replaceIn('{{base_url}}'); const tk = pm.collectionVariables.get('token_admin');",
              "  const hdr = {'Content-Type': 'application/json', 'Authorization': 'Bearer ' + tk};",
              "  const patch = (id, estado, cb) => pm.sendRequest({url: base + '/iot/alertas/' + id + '/estado', method: 'PATCH', header: hdr, body: {mode: 'raw', raw: JSON.stringify({nuevo_estado: estado, motivo: 'QA limpieza final TC-M03'})}}, (e, r) => { if (cb) { cb(e, r); } });",
              "  ids.forEach(function (id) { patch(id, 'DESCARTADA', function (e, r) { if (r && r.code === 200) { return; } patch(id, 'RESUELTA', function (e2, r2) { if (r2 && r2.code === 200) { return; } patch(id, 'EN_ATENCION', function () { patch(id, 'RESUELTA'); }); }); }); });",
              "  console.log('[TC-M03-G77] limpieza final: ' + ids.length + ' alerta(s) de prueba cerradas (DESCARTADA/RESUELTA)');",
              "  pm.collectionVariables.set('ids_alertas', '[]');",
              "})();",
              "pm.test('Limpieza final ejecutada', function () { pm.expect(true).to.be.true; });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_admin}}"
          }
        ],
        "url": {
