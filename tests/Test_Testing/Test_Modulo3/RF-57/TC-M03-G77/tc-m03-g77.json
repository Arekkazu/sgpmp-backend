    },
    {
      "key": "access_key",
      "value": ""
    },
    {
      "key": "id_evento_edge",
      "value": "1"
    },
    {
      "key": "ids_alertas",
      "value": "[]"
    },
    {
      "key": "sensor_con_contexto",
      "value": "1"
    },
    {
      "key": "sensor_solo_unidad",
