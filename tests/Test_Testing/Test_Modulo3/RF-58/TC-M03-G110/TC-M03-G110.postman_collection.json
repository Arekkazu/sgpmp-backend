{
  "info": { "name": "TC-M03-G110 — TC-M03-263", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "event": [{ "listen": "prerequest", "script": { "type": "text/javascript", "exec": ["if(pm.environment.get('autorizado_run')!=='SI'||pm.environment.get('qa_autorizado')!=='SI'||pm.environment.get('ambiente')!=='TEST'||!pm.environment.get('autorizacion')||!pm.environment.get('run_id')||!/^https:\\/\\//.test(pm.environment.get('base_url')||'')||pm.environment.get('base_url')!==pm.environment.get('test_base_url')||/(^|[-\/.])dev([-\/.]|$)/i.test(pm.environment.get('base_url')||'')){pm.execution.skipRequest();throw Error('BLOQUEO_G110');}"] } }],
  "item": [
    { "name": "[TC-M03-263] dashboard", "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{token}}"},{"key":"X-Test-Run-Id","value":"{{run_id}}"},{"key":"X-Sandbox-Secret","value":"{{sandbox_secret}}"}], "url": "{{base_url}}/iot/monitoreo/dashboard/{{id_infraestructura}}?pagina=1&por_pagina=50" }, "event": [{"listen":"test","script":{"type":"text/javascript","exec":["let b={};try{b=pm.response.json()}catch{}const s=(b.sensores||[]).find(x=>Number(x.id_sensor)===Number(pm.environment.get('sensor_id')));","pm.test('[TC-M03-263][PRE] eco sandbox',()=>pm.expect(pm.response.headers.get('X-Test-Run-Id')).to.eql(pm.environment.get('run_id')));","pm.test('[TC-M03-263][ASSERT] último valor coincide con serie persistente',()=>{pm.expect(pm.response.code).to.eql(200);pm.expect(s).to.exist;pm.expect(s.ultimo_valor).not.to.be.oneOf([null,undefined]);pm.expect(Number(s.ultimo_valor)).to.eql(Number(pm.environment.get('expected_value')));});","pm.test('[TC-M03-263][ASSERT] unidad coincide con serie persistente',()=>pm.expect(s?.ultima_unidad).to.eql(pm.environment.get('expected_unit')));","pm.test('[TC-M03-263][ASSERT] timestamp coincide con serie persistente',()=>pm.expect(new Date(s?.ultimo_timestamp_captura).toISOString()).to.eql(new Date(pm.environment.get('expected_ts')).toISOString()));"]}}] },
    { "name": "[TC-M03-263] historial", "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{token}}"},{"key":"X-Test-Run-Id","value":"{{run_id}}"},{"key":"X-Sandbox-Secret","value":"{{sandbox_secret}}"}], "url": "{{base_url}}/iot/monitoreo/historial?fecha_inicio={{fecha_inicio}}&fecha_fin={{fecha_fin}}&sensor_id={{sensor_id}}&pagina=1&por_pagina=100&orden=DESC" }, "event": [{"listen":"test","script":{"type":"text/javascript","exec":["let b={};try{b=pm.response.json()}catch{}const h=(b.items||[]).find(x=>Number(x.id_telemetria)===Number(pm.environment.get('id_telemetria')));","pm.test('[TC-M03-263][PRE] eco sandbox',()=>pm.expect(pm.response.headers.get('X-Test-Run-Id')).to.eql(pm.environment.get('run_id')));","pm.test('[TC-M03-263][ASSERT] lectura reciente del mismo sensor e ID',()=>{pm.expect(pm.response.code).to.eql(200);pm.expect(h).to.exist;pm.expect(Number(h.id_sensor)).to.eql(Number(pm.environment.get('sensor_id')));pm.expect(Number(b.items[0].id_telemetria)).to.eql(Number(h.id_telemetria));});","pm.test('[TC-M03-263][ASSERT] valor coincide con serie persistente',()=>{pm.expect(h?.valor).not.to.be.oneOf([null,undefined]);pm.expect(Number(h.valor)).to.eql(Number(pm.environment.get('expected_value')))});","pm.test('[TC-M03-263][ASSERT] unidad coincide con serie persistente',()=>pm.expect(h?.unidad_medida).to.eql(pm.environment.get('expected_unit')));","pm.test('[TC-M03-263][ASSERT] timestamp coincide con serie persistente',()=>pm.expect(new Date(h?.timestamp_captura).toISOString()).to.eql(new Date(pm.environment.get('expected_ts')).toISOString()));"]}}] }
  ]
}
