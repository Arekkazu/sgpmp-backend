        {
          "name": "168 Dashboard Productor",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tok_prod}}"
              }
            ],
            "url": "{{base_url}}/iot/monitoreo/dashboard?id_infraestructura={{id_infraestructura}}&por_pagina=50"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const code = pm.response.code;",
                  "const body = code === 200 ? pm.response.json() : {};",
                  "const sensores = Array.isArray(body.sensores) ? body.sensores : [];",
                  "const s = sensores.find((x) => String(x.id_sensor) === String(pm.environment.get('sensor_a')));",
                  "const num = (v) => (v === null || v === undefined ? null : Number(v));",
                  "",
                  "pm.test('[TC-M03-168][PRE][PRE-168-03] Sesión del Productor vigente (no 401)', () => pm.expect(code).to.not.eql(401));",
                  "if (code !== 401) {",
                  "  pm.test('[TC-M03-168][ASSERT][API-168-01] Dashboard del Productor HTTP 200', () => pm.expect(code).to.eql(200));",
                  "  pm.test('[TC-M03-168][ASSERT][API-168-02] El sensor A aparece en el dashboard', () => pm.expect(s, 'sensor A presente').to.be.an('object'));",
                  "  if (s) {",
                  "    const v3 = Number(pm.collectionVariables.get('val_a3'));",
                  "    const t3 = Date.parse(pm.collectionVariables.get('ts_a3'));",
                  "    const vf = Number(pm.collectionVariables.get('val_af'));",
                  "    const tf = Date.parse(pm.collectionVariables.get('ts_af'));",
                  "    pm.test('[TC-M03-168][ASSERT][API-168-03] ultimo_valor = valor de la tercera lectura válida', () => {",
                  "      pm.expect(num(s.ultimo_valor), 'ultimo_valor').to.be.closeTo(v3, 0.0001);",
                  "    });",
                  "    pm.test('[TC-M03-168][ASSERT][API-168-04] ultima_unidad = unidad de la última lectura válida', () => {",
                  "      pm.expect(s.ultima_unidad, 'ultima_unidad').to.eql(pm.environment.get('unidad'));",
                  "    });",
                  "    pm.test('[TC-M03-168][ASSERT][API-168-05] ultimo_timestamp_captura = timestamp de la última lectura válida', () => {",
                  "      pm.expect(Date.parse(s.ultimo_timestamp_captura), 'ultimo_timestamp_captura (ms)').to.eql(t3);",
                  "    });",
                  "    pm.test('[TC-M03-168][ASSERT][API-168-06] Valor y timestamp no son los de la lectura FUERA_DE_RANGO', () => {",
                  "      pm.expect(num(s.ultimo_valor), 'ultimo_valor').to.not.be.closeTo(vf, 0.0001);",
                  "      pm.expect(Date.parse(s.ultimo_timestamp_captura), 'ultimo_timestamp_captura (ms)').to.not.eql(tf);",
                  "    });",
                  "  }",
                  "}",
                  ""
                ]
              }
            }
          ]
        }
      ]
