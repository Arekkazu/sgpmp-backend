          "name": "178 Dashboard Productor",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tok_prod}}"
              }
            ],
            "url": "{{base_url}}/iot/monitoreo/dashboard?id_infraestructura={{id_infraestructura}}&por_pagina=50"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const code = pm.response.code;",
                  "const body = code === 200 ? pm.response.json() : {};",
                  "const sensores = Array.isArray(body.sensores) ? body.sensores : [];",
                  "const s = sensores.find((x) => String(x.id_sensor) === String(pm.environment.get('sensor_c')));",
                  "const num = (v) => (v === null || v === undefined ? null : Number(v));",
                  "",
                  "const invalidos = [Number(pm.collectionVariables.get('val_c1')), Number(pm.collectionVariables.get('val_c2'))];",
                  "const esInvalido = (v) => v !== null && invalidos.some((x) => Math.abs(x - v) < 0.0001);",
                  "",
                  "const a = sensores.find((x) => String(x.id_sensor) === String(pm.environment.get('sensor_a')));",
                  "pm.test('[TC-M03-178][PRE][PRE-178-02] Sesión del Productor vigente (no 401)', () => pm.expect(code).to.not.eql(401));",
                  "if (code !== 401) {",
                  "  pm.test('[TC-M03-178][ASSERT][API-178-01] Productor: dashboard HTTP 200 y el sensor C permanece visible', () => {",
                  "    pm.expect(code).to.eql(200);",
                  "    pm.expect(s, 'sensor C presente en el dashboard del Productor').to.be.an('object');",
                  "  });",
                  "  if (s) {",
                  "    pm.test('[TC-M03-178][ASSERT][API-178-02] Productor: el valor ERROR_CALIBRACION no se presenta como lectura operativa', () => {",
                  "      pm.expect(esInvalido(num(s.ultimo_valor)), 'ultimo_valor=' + s.ultimo_valor).to.eql(false);",
                  "    });",
                  "    pm.test('[TC-M03-178][ASSERT][API-178-03] Productor: el sensor C no presenta alerta operativa asociada', () => {",
                  "      pm.expect(s.id_alerta, 'id_alerta').to.eql(null);",
                  "      pm.expect(s.severidad_alerta, 'severidad_alerta').to.eql(null);",
                  "    });",
                  "    pm.test('[TC-M03-178][ASSERT][API-178-04] Productor: no recibe información técnica (batería, RSSI, SNR)', () => {",
                  "      for (const x of [s, a].filter(Boolean)) {",
                  "        pm.expect(x.nivel_bateria_pct, 'nivel_bateria_pct sensor ' + x.id_sensor).to.eql(null);",
                  "        pm.expect(x.calidad_senal_rssi, 'calidad_senal_rssi sensor ' + x.id_sensor).to.eql(null);",
                  "        pm.expect(x.calidad_senal_snr, 'calidad_senal_snr sensor ' + x.id_sensor).to.eql(null);",
                  "      }",
                  "    });",
                  "  }",
                  "}",
                  ""
                ]
              }
            }
          ]
