{
  "info": {
    "name": "TC-M03-G87 — RF-58 última lectura válida ante datos anómalos",
    "description": "Colección oficial y reutilizable de TC-M03-G87 (TC-M03-168, TC-M03-177, TC-M03-178). Se ejecuta exclusivamente desde ejecutar_tc_m03_g87.mjs, que aporta el entorno, el sandbox y los datos preparados. Las pruebas se nombran [CASO][PRE|ASSERT|INFO][ID] para la trazabilidad por caso original.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// TC-M03-G87 — barrera de ejecución. La colección solo se ejecuta desde",
          "// ejecutar_tc_m03_g87.mjs con autorización vigente; manualmente se bloquea.",
          "const autorizado = pm.environment.get('qa_autorizado') === 'SI'",
          "  && !!pm.environment.get('run_id')",
          "  && /^https:\\/\\//.test(pm.environment.get('base_url') || '');",
          "if (!autorizado) {",
          "  if (pm.execution && typeof pm.execution.skipRequest === 'function') pm.execution.skipRequest();",
          "  throw new Error('BLOQUEO_G87: colección sin autorización de ejecución; usar ejecutar_tc_m03_g87.mjs.');",
          "}",
          "// Sandbox transaccional: el mismo X-Test-Run-Id en todas las peticiones del RUN.",
          "pm.request.headers.upsert({ key: 'X-Test-Run-Id', value: pm.environment.get('run_id') });",
          "pm.request.headers.upsert({ key: 'X-Sandbox-Secret', value: pm.environment.get('sandbox_secret') });",
          ""
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Comprueba que el backend atendió la petición dentro del sandbox del RUN.",
          "const eco = pm.response.headers.get('X-Test-Run-Id');",
          "if (eco !== pm.environment.get('run_id')) {",
          "  pm.test('[SETUP] Respuesta atendida dentro del sandbox (X-Test-Run-Id)', () => {",
          "    pm.expect(eco, 'X-Test-Run-Id devuelto').to.eql(pm.environment.get('run_id'));",
          "  });",
          "}",
          ""
        ]
      }
    }
  ],
