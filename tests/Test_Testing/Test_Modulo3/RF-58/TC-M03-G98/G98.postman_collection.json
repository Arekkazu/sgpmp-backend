{
  "info": { "name": "TC-M03-G98 — panel de alertas activas", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "item": [{
    "name": "API-191-01",
    "request": {
      "method": "GET",
      "header": [
        { "key": "Authorization", "value": "Bearer {{token}}" },
        { "key": "X-Test-Run-Id", "value": "{{run_id}}" },
        { "key": "X-Sandbox-Secret", "value": "{{sandbox_secret}}" }
      ],
      "url": "{{base_url}}/iot/monitoreo/dashboard/{{unidad}}?pagina={{pagina}}&por_pagina={{por_pagina}}"
    },
    "event": [
      { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
        "const base = pm.environment.get('base_url') || '';",
        "if (pm.environment.get('autorizado_run') !== 'SI' || !pm.environment.get('run_id') || !(base === 'https://www.api.inmero.co/api-sgpmp-test' || (pm.environment.get('ensayo_loopback') === 'SI' && /^http:\\/\\/(127\\.0\\.0\\.1|localhost):[0-9]+$/.test(base)))) { pm.execution.skipRequest(); throw Error('BLOQUEO_G98'); }"
      ] } },
      { "listen": "test", "script": { "type": "text/javascript", "exec": [
        "const eco = pm.response.headers.get('X-Test-Run-Id') === pm.environment.get('run_id');",
        "let b = null; try { b = pm.response.json(); } catch {}",
        "const obj = x => x && typeof x === 'object' && !Array.isArray(x);",
        "const key = (o, xs) => xs.find(k => Object.prototype.hasOwnProperty.call(o,k));",
        "const contenedores = obj(b) ? [b, ...['panel_alertas','panel_alertas_activas','alertas_activas_panel'].filter(k => obj(b[k])).map(k => b[k])] : [];",
        "const p = contenedores.map((o,i) => ({o,i,l:key(o,['alertas_activas','alertas','lista_alertas','items']),t:key(o,['total_alertas_activas','alertas_activas_total','total_alertas'])})).find(x => x.l && x.t && (x.i > 0 || x.l !== 'items'));",
        "if (pm.response.code === 200 && eco) pm.test('[TC-M03-191][ASSERT][API-191-01] panel, datos y orden', () => {",
        "  pm.expect(!!p, 'panel total + lista').to.eql(true);",
        "  pm.expect(Number.isInteger(p.o[p.t]) && p.o[p.t] >= 0, 'total').to.eql(true);",
        "  pm.expect(Array.isArray(p.o[p.l]), 'lista').to.eql(true);",
        "  const lista = p.o[p.l]; pm.expect(lista.length <= p.o[p.t], 'lista <= total').to.eql(true);",
        "  pm.expect(!(p.o[p.t] > 0 && lista.length === 0), 'total positivo con lista vacía').to.eql(true);",
        "  const grados = lista.map(a => {",
        "    pm.expect(obj(a), 'alerta objeto').to.eql(true);",
        "    if (Object.prototype.hasOwnProperty.call(a,'estado_alerta')) pm.expect(a.estado_alerta === 'ACTIVA', 'alerta activa').to.eql(true);",
        "    const s=key(a,['severidad','nivel_severidad']), t=key(a,['tipo_alerta','tipo']), v=key(a,['tipo_variable','variable_afectada','variable']), m=key(a,['tiempo_transcurrido','tiempo_transcurrido_min','minutos_transcurridos','elapsed']), h=key(a,['enlace_activo','url_activo','href_activo','id_activo_biologico','id_animal']);",
        "    pm.expect(!!s && !!t && !!v && !!m && !!h, 'campos exigidos').to.eql(true);",
        "    pm.expect(typeof a[t] === 'string' && !!a[t].trim() && typeof a[v] === 'string' && !!a[v].trim(), 'tipo y variable').to.eql(true);",
        "    pm.expect((typeof a[m] === 'string' && !!a[m].trim()) || (Number.isFinite(a[m]) && a[m] >= 0), 'tiempo').to.eql(true);",
        "    pm.expect((typeof a[h] === 'string' && !!a[h].trim()) || (Number.isInteger(a[h]) && a[h] > 0), 'activo').to.eql(true);",
        "    return typeof a[s] === 'string' ? a[s].normalize('NFD').replace(/[\\u0300-\\u036f]/g,'').toUpperCase().trim() : '';",
        "  });",
        "  const escalas=[{CRITICO:3,CRITICA:3,MODERADO:2,MODERADA:2,LEVE:1},{CRITICO:3,CRITICA:3,ALTA:2,MEDIA:1,BAJA:0}];",
        "  const escala=escalas.find(e => grados.every(g => Object.prototype.hasOwnProperty.call(e,g)));",
        "  pm.expect(!!escala || grados.length === 0, 'catálogo RF-57 o matriz').to.eql(true);",
        "  if (escala) for(let i=1;i<grados.length;i++) pm.expect(escala[grados[i]] <= escala[grados[i-1]], 'orden').to.eql(true);",
        "});",
        "const ids=JSON.parse(pm.environment.get('unidades')); const indice=Number(pm.environment.get('indice')); const pagina=Number(pm.environment.get('pagina'));",
        "const usadas=Number(pm.environment.get('paginas_usadas'))+1; pm.environment.set('paginas_usadas',String(usadas));",
        "const activas=obj(b) && ((Array.isArray(b.resumen_unidades) && b.resumen_unidades.some(u => Number(u.alertas_activas_count)>0)) || (Array.isArray(b.sensores) && b.sensores.some(s => s.id_alerta != null)) || (p && Number(p.o[p.t])>0));",
        "if (activas || pm.response.code >= 500 || !eco || pm.response.code !== 200 || usadas >= Number(pm.environment.get('limite_paginas'))) pm.execution.setNextRequest(null);",
        "else if (pagina*Number(pm.environment.get('por_pagina')) < Number(b?.total)) { pm.environment.set('pagina',String(pagina+1)); pm.execution.setNextRequest(pm.info.requestName); }",
        "else if (indice+1 < ids.length) { pm.environment.set('indice',String(indice+1)); pm.environment.set('unidad',String(ids[indice+1])); pm.environment.set('pagina','1'); pm.execution.setNextRequest(pm.info.requestName); }",
        "else pm.execution.setNextRequest(null);"
      ] } }
    ]
  }]
}
