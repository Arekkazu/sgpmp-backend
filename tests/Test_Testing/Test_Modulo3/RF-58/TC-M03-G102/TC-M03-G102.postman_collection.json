      "name": "[TC-M03-201][V:U51] segmento 2 de la unidad con 51 sensores",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const cuerpo = (() => { try { return pm.response.json(); } catch (e) { return null; } })();",
              "const sensores = cuerpo && Array.isArray(cuerpo.sensores) ? cuerpo.sensores : [];",
              "const idsDe = xs => xs.map(s => Number(s.id_sensor));",
              "const ordenar = xs => xs.slice().sort((a, b) => a - b);",
              "const iguales = (a, b) => JSON.stringify(ordenar(a)) === JSON.stringify(ordenar(b));",
              "const esperados = JSON.parse(pm.environment.get(\"ids_u51\") || \"[]\");",
              "const primero = JSON.parse(pm.collectionVariables.get(\"segmento1_u51\") || \"[]\");",
              "pm.test(\"[TC-M03-201][ASSERT][API-201-04][V:U51] la segmentación entrega el sensor restante: los 51 sin duplicados ni omisiones\", () => {",
              "  pm.expect(pm.response.code).to.eql(200);",
              "  pm.expect(sensores.length, \"sensores en la vista\").to.be.at.most(50);",
              "  const union = primero.concat(idsDe(sensores));",
              "  pm.expect(new Set(union).size, \"sin duplicados entre segmentos\").to.eql(union.length);",
              "  pm.expect(iguales(union, esperados), \"los dos segmentos cubren exactamente los 51 sensores\").to.eql(true);",
              "});"
            ]
          }
        }
