    {
      "name": "[TC-M03-202][V:U200] segmento de la unidad con 200 sensores",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const cuerpo = (() => { try { return pm.response.json(); } catch (e) { return null; } })();",
              "const sensores = cuerpo && Array.isArray(cuerpo.sensores) ? cuerpo.sensores : [];",
              "const idsDe = xs => xs.map(s => Number(s.id_sensor));",
              "const ordenar = xs => xs.slice().sort((a, b) => a - b);",
              "const iguales = (a, b) => JSON.stringify(ordenar(a)) === JSON.stringify(ordenar(b));",
              "const esperados = JSON.parse(pm.environment.get(\"ids_u200\") || \"[]\");",
              "const pagina = Number(pm.environment.get(\"pagina_u200\") || \"1\");",
              "const acumulado = JSON.parse(pm.collectionVariables.get(\"acumulado_u200\") || \"[]\").concat(idsDe(sensores));",
              "pm.collectionVariables.set(\"acumulado_u200\", JSON.stringify(acumulado));",
              "pm.test(`[TC-M03-202][ASSERT][API-202-01][V:U200] segmento ${pagina}: HTTP 200 y como máximo 50 sensores, todos de la unidad`, () => {",
              "  pm.expect(pm.response.code).to.eql(200);",
              "  pm.expect(sensores.length, \"sensores en la vista\").to.be.at.most(50);",
              "  pm.expect(sensores.every(s => Number(s.id_infraestructura) === Number(pm.environment.get(\"id_u200\"))), \"id_infraestructura de la unidad\").to.eql(true);",
              "});",
              "// Recorre segmentos hasta uno vacío (máximo 10: 200 sensores caben en 4 segmentos de 50).",
              "const fin = pm.response.code !== 200 || sensores.length === 0 || pagina >= 10;",
              "if (!fin) {",
              "  pm.environment.set(\"pagina_u200\", String(pagina + 1));",
              "  if (pm.execution && typeof pm.execution.setNextRequest === \"function\") pm.execution.setNextRequest(pm.info.requestName);",
              "  else postman.setNextRequest(pm.info.requestName);",
              "} else {",
              "  pm.test(`[TC-M03-202][INFO][V:U200] segmentos recorridos: ${pagina}; sensores obtenidos: ${acumulado.length}`, () => {});",
              "  pm.test(\"[TC-M03-202][ASSERT][API-202-02][V:U200] los 200 sensores se consultan por segmentos sin duplicados ni omisiones\", () => {",
              "    pm.expect(esperados.length, \"sensores construidos\").to.eql(200);",
              "    pm.expect(new Set(acumulado).size, \"sin duplicados\").to.eql(acumulado.length);",
              "    pm.expect(esperados.every(id => acumulado.includes(id)), \"sin omisiones\").to.eql(true);",
              "  });",
              "  pm.test(\"[TC-M03-202][ASSERT][API-202-03][V:U200] la segmentación no incluye sensores de otras unidades\", () => {",
              "    pm.expect(acumulado.filter(id => !esperados.includes(id)), \"sensores ajenos\").to.eql([]);",
              "  });",
              "}"
            ]
          }
        }
      ],
