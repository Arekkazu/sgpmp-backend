    "description": "TC-M03-201, 202 y 213. Solo se ejecuta desde ejecutar_tc_m03_g102.mjs con autorización vigente, dentro del sandbox del RUN."
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Barrera: la colección solo se ejecuta desde ejecutar_tc_m03_g102.mjs con autorización vigente.",
          "const autorizado = pm.environment.get(\"autorizado_run\") === \"SI\" && !!pm.environment.get(\"run_id\") && /^https:\\/\\//.test(pm.environment.get(\"base_url\") || \"\");",
          "if (!autorizado) { if (pm.execution && typeof pm.execution.skipRequest === \"function\") pm.execution.skipRequest(); throw Error(\"BLOQUEO_G102\"); }"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"[PRE] respuesta dentro del sandbox del RUN\", () => pm.expect(pm.response.headers.get(\"X-Test-Run-Id\")).to.eql(pm.environment.get(\"run_id\")));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "[TC-M03-201][V:U50] por_pagina=50 en la unidad con 50 sensores",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const cuerpo = (() => { try { return pm.response.json(); } catch (e) { return null; } })();",
              "const sensores = cuerpo && Array.isArray(cuerpo.sensores) ? cuerpo.sensores : [];",
              "const idsDe = xs => xs.map(s => Number(s.id_sensor));",
              "const ordenar = xs => xs.slice().sort((a, b) => a - b);",
              "const iguales = (a, b) => JSON.stringify(ordenar(a)) === JSON.stringify(ordenar(b));",
              "const esperados = JSON.parse(pm.environment.get(\"ids_u50\") || \"[]\");",
              "pm.test(\"[TC-M03-201][ASSERT][API-201-01][V:U50] por_pagina=50 devuelve HTTP 200\", () => pm.expect(pm.response.code).to.eql(200));",
              "pm.test(\"[TC-M03-201][ASSERT][API-201-02][V:U50] con 50 sensores la vista entrega los 50 de la unidad\", () => {",
              "  pm.expect(esperados.length, \"sensores construidos\").to.eql(50);",
              "  pm.expect(sensores.length, \"sensores en la vista\").to.eql(50);",
              "  pm.expect(iguales(idsDe(sensores), esperados), \"los sensores entregados son exactamente los de la unidad\").to.eql(true);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Test-Run-Id",
            "value": "{{run_id}}"
          },
          {
            "key": "X-Sandbox-Secret",
            "value": "{{sandbox_secret}}"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
