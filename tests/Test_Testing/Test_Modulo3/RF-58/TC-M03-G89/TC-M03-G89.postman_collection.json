    {
      "name": "Estado base VERDE (rango óptimo 20-30)",
      "item": [
        {
          "name": "173 Registrar umbral 20-30 (rango óptimo, T=1)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tok_setup}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/configuracion/umbrales",
            "body": {
              "mode": "raw",
              "raw": "{{umbral_cuerpo}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Umbral 20–30, tolerancia T=1, zona de tolerancia inferior (ver g88_casos.mjs).",
                  "const r = (x) => Math.round(x * 100) / 100;",
                  "const min = 20, max = 30, T = 1;",
                  "const niveles = \"inferior\" === 'inferior'",
                  "  ? [{ nivel: 'precaucion', limite_inferior: r(min - T), limite_superior: min }, { nivel: 'normal', limite_inferior: min, limite_superior: max }, { nivel: 'critico', limite_inferior: max, limite_superior: r(max + T) }]",
                  "  : [{ nivel: 'critico', limite_inferior: r(min - T), limite_superior: min }, { nivel: 'normal', limite_inferior: min, limite_superior: max }, { nivel: 'precaucion', limite_inferior: max, limite_superior: r(max + T) }];",
                  "const cuerpo = { valor_min: r(min - T), valor_max: r(max + T), niveles };",
                  "cuerpo.id_especie = Number(pm.environment.get('id_especie'));",
                  "cuerpo.id_variable_ambiental = 9;",
                  "pm.collectionVariables.set('umbral_cuerpo', JSON.stringify(cuerpo));",
                  "pm.collectionVariables.set('umbral_esperado', JSON.stringify(cuerpo));",
                  ""
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const code = pm.response.code;",
                  "const b = (code === 200 || code === 201) ? pm.response.json() : {};",
                  "const esp = JSON.parse(pm.collectionVariables.get('umbral_esperado'));",
                  "const norm = (ns) => (ns || []).map((n) => [n.nivel, Number(n.limite_inferior), Number(n.limite_superior)]).sort((a, b) => a[1] - b[1]);",
                  "pm.test('[TC-M03-173][PRE][PRE-173-01] Umbral 20–30 T=1 (tolerancia inferior) configurado en M09', () => {",
                  "  pm.expect(code, 'HTTP POST umbral').to.be.oneOf([200, 201]);",
                  "  pm.expect(Number(b.valor_min), 'valor_min').to.eql(esp.valor_min);",
                  "  pm.expect(Number(b.valor_max), 'valor_max').to.eql(esp.valor_max);",
                  "  pm.expect(norm(b.niveles), 'niveles almacenados').to.eql(norm(esp.niveles));",
                  "});",
                  "pm.test('[TC-M03-174][PRE][PRE-174-01] Umbral 20–30 T=1 (tolerancia inferior) configurado en M09', () => {",
                  "  pm.expect(code, 'HTTP POST umbral').to.be.oneOf([200, 201]);",
                  "  pm.expect(Number(b.valor_min), 'valor_min').to.eql(esp.valor_min);",
                  "  pm.expect(Number(b.valor_max), 'valor_max').to.eql(esp.valor_max);",
                  "  pm.expect(norm(b.niveles), 'niveles almacenados').to.eql(norm(esp.niveles));",
                  "});",
                  "if (code === 200 || code === 201) {",
                  "  pm.collectionVariables.set('id_umbral', String(b.id_umbral_ambiental));",
                  "  if (b.fecha_actualizacion) pm.collectionVariables.set('umbral_fecha', b.fecha_actualizacion);",
                  "}",
                  ""
                ]
              }
            }
          ]
        },
