          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const code = pm.response.code;",
                  "const body = code === 200 ? pm.response.json() : {};",
                  "const sensores = Array.isArray(body.sensores) ? body.sensores : [];",
                  "const s = (k) => sensores.find((x) => String(x.id_sensor) === String(pm.environment.get('sensor_' + k)));",
                  "pm.test('[TC-M03-173][PRE][PRE-173-06] Sesión del Productor vigente (no 401)', () => pm.expect(code).to.not.eql(401));",
                  "pm.test('[TC-M03-174][PRE][PRE-174-08] Sesión del Productor vigente (no 401)', () => pm.expect(code).to.not.eql(401));",
                  "if (code !== 401) {",
                  "",
                  "",
                  "  pm.test('[TC-M03-173][PRE][PRE-173-04] Antes de la alerta el sensor está en VERDE', () => {",
                  "    pm.expect(code).to.eql(200);",
                  "    pm.expect(s('173'), 'sensor 173').to.be.an('object');",
                  "    pm.expect(s('173').estado_semaforo, 'estado base').to.eql('VERDE');",
                  "  });",
                  "  pm.test('[TC-M03-174][PRE][PRE-174-04] Antes de las alertas los cuatro sensores están en VERDE', () => {",
                  "    pm.expect(code).to.eql(200);",
                  "    for (const k of [\"174a\",\"174b\",\"174c\",\"174d\"]) {",
                  "      pm.expect(s(k), 'sensor ' + k).to.be.an('object');",
                  "      pm.expect(s(k).estado_semaforo, 'estado base del sensor ' + k).to.eql('VERDE');",
                  "    }",
                  "  });",
                  "}",
                  ""
                ]
              }
            }
          ]
        }
