          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const code = pm.response.code;",
                  "const items = code === 200 ? (pm.response.json().items || []) : [];",
                  "const vinculada = (k) => {",
                  "  const tel = pm.collectionVariables.get('tel_' + k);",
                  "  const v = items.find((x) => String(x.id_telemetria) === String(tel));",
                  "  return { tel, estado: v ? v.estado_vinculacion : null, activo: v ? v.id_activo_biologico : null };",
                  "};",
                  "pm.test('[TC-M03-173][PRE][PRE-173-03] Lecturas VINCULADAS al único activo del área (RF-61)', () => {",
                  "  pm.expect(code, 'HTTP vinculaciones').to.eql(200);",
                  "  for (const k of [\"173\"]) {",
                  "    const v = vinculada(k);",
                  "    pm.expect(v.estado, 'vinculación de la telemetría ' + v.tel).to.eql('VINCULADA');",
                  "    pm.expect(String(v.activo), 'activo de la telemetría ' + v.tel).to.eql(String(pm.environment.get('id_activo')));",
                  "  }",
                  "});",
                  "pm.test('[TC-M03-174][PRE][PRE-174-03] Lecturas VINCULADAS al único activo del área (RF-61)', () => {",
                  "  pm.expect(code, 'HTTP vinculaciones').to.eql(200);",
                  "  for (const k of [\"174a\",\"174b\",\"174c\",\"174d\"]) {",
                  "    const v = vinculada(k);",
