            "listen": "test",
            "script": {
              "id": "07b732d8-4735-4ca4-a10d-a921ceb5358c",
              "type": "text/javascript",
              "exec": [
                "const caso = pm.environment.get('caso'); const id = pm.environment.get('check_id');",
                "pm.test('['+caso+'][ASSERT]['+id+'] Dashboard HTTP 200', () => pm.expect(pm.response.code).to.eql(200));",
                "pm.test('['+caso+'][PRE]['+id+'-RUN] Eco RUN', () => pm.expect(pm.response.headers.get('X-Test-Run-Id')).to.eql(pm.environment.get('run_id')));",
                "if (pm.response.code === 200) {",
                "  const sensores = pm.response.json().sensores || [];",
                "  const sensor = sensores.find(s => String(s.id_sensor) === pm.environment.get('sensor_id'));",
                "  pm.test('['+caso+'][ASSERT]['+id+'-ESTADO] Semáforo esperado', () => { pm.expect(sensor).to.be.an('object'); pm.expect(sensor.estado_semaforo).to.eql(pm.environment.get('esperado_estado')); });",
                "  if (pm.environment.get('esperado_alerta')) pm.test('['+caso+'][ASSERT]['+id+'-ALERTA] id_alerta asociado', () => pm.expect(String(sensor && sensor.id_alerta)).to.eql(pm.environment.get('esperado_alerta')));",
                "}"
              ],
              "_lastExecutionId": "859c07e5-81b5-408d-98d6-715a812cc0c7"
            }
          }
        ]
      }
    ],
