          "exec": [
            "if (pm.environment.get('qa_autorizado') !== 'SI') throw new Error('LANZADOR_NO_AUTORIZADO');",
            "pm.request.headers.upsert({key:'Authorization', value:'Bearer ' + pm.environment.get('token_productor')});",
