  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if(pm.environment.get('autorizado_run')!=='SI'||!pm.environment.get('run_id')||!/^https:\\/\\//.test(pm.environment.get('base_url')||'')){pm.execution.skipRequest();throw Error('BLOQUEO_G97');}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Productor TC-M03-188",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_prod}}"
          },
          {
            "key": "X-Test-Run-Id",
            "value": "{{run_id}}"
          },
          {
            "key": "X-Sandbox-Secret",
            "value": "{{sandbox_secret}}"
          }
        ],
        "url": "{{base_url}}/iot/monitoreo/dashboard/{{id_unidad}}?por_pagina=50"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let b={};try{b=pm.response.json();}catch{}",
              "pm.test('PRE sandbox',()=>{pm.expect(pm.response.headers.get('X-Test-Run-Id')).to.eql(pm.environment.get('run_id'));});",
              "pm.test('[TC-M03-188][ASSERT][API-188-01] HTTP 200, semaforo, valor, unidad y nombre',()=>{pm.expect(pm.response.code).to.eql(200);const s=b.sensores.find(x=>Number(x.id_sensor)===Number(pm.environment.get('id_sensor')));pm.expect(s).to.exist;pm.expect(s.estado_semaforo).to.be.a('string').and.not.empty;pm.expect(s.ultimo_valor).not.to.be.oneOf([null,undefined]);pm.expect(s.ultima_unidad).to.be.a('string').and.not.empty;pm.expect(s.nombre_sensor).to.be.a('string').and.not.empty;});"
            ]
          }
        }
      ]
    },
