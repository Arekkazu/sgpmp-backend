{
  "collection": {
    "item": [
      {
        "id": "84ccc911-8a2c-4237-9f3e-5a3b8b98cf9b",
        "name": "Ingesta de lectura del subcaso",
        "request": {
          "url": {
            "path": [
              "iot",
              "telemetria"
            ],
            "host": [
              "{{base_url}}"
            ],
            "query": [],
            "variable": []
          },
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "method": "POST",
          "body": {
            "mode": "raw",
            "raw": "{{cuerpo_ingesta}}"
          }
        },
        "response": [],
        "event": [
          {
            "listen": "test",
            "script": {
              "id": "4b6de360-87d9-4343-ab72-b1a5f7e312a6",
              "type": "text/javascript",
              "exec": [
                "const id=pm.environment.get('caso'); const code=pm.response.code; const b=code===201?pm.response.json():{};",
                "pm.test('['+id+'][PRE][PRE-'+id.slice(-3)+'-INGESTA] Respuesta de ingesta registrada',()=>{pm.expect(code).to.eql(201);pm.expect(b.id_telemetria).to.be.a('number');});",
                "if(code===201 && Number.isInteger(b.id_telemetria)){pm.environment.set('id_telemetria_run',String(b.id_telemetria));pm.environment.set('timestamp_captura_run',JSON.parse(pm.environment.get('cuerpo_ingesta')).timestamp_captura);};"
              ]
            }
          }
        ]
      },
      {
        "id": "72e161ca-aadf-46b0-a087-df2d0f7122be",
        "name": "Dashboard del subcaso",
        "request": {
          "url": {
            "path": [
              "iot",
              "monitoreo",
              "dashboard"
            ],
            "host": [
              "{{base_url}}"
            ],
            "query": [
              {
                "key": "id_infraestructura",
                "value": "{{id_infraestructura}}"
              },
              {
                "key": "por_pagina",
                "value": "50"
              }
            ],
            "variable": []
          },
          "header": [
            {
              "key": "Authorization",
              "value": "[REDACTADO]"
            }
          ],
          "method": "GET"
        },
        "response": [],
        "event": [
          {
            "listen": "test",
            "script": {
              "id": "e159cf02-cf22-4a99-9683-84a2b2d84e56",
              "type": "text/javascript",
              "exec": [
                "const id=pm.environment.get('caso'); const check=pm.environment.get('check_id'); const code=pm.response.code; const b=code===200?pm.response.json():{}; const s=(b.sensores||[]).find(x=>String(x.id_sensor)===String(pm.environment.get('sensor_id')));",
                "pm.test('['+id+'][PRE][PRE-'+id.slice(-3)+'-DASHBOARD] Productor y sensor accesibles',()=>{pm.expect(code).to.eql(200);pm.expect(s).to.be.an('object');});",
                "pm.test('['+id+'][ASSERT]['+check+'] Valor y semáforo observados',()=>{pm.expect(code).to.eql(200);pm.expect(s).to.be.an('object');if(pm.environment.get('esperado_valor')!=='')pm.expect(Number(s.ultimo_valor)).to.be.closeTo(Number(pm.environment.get('esperado_valor')),0.0001);if(pm.environment.get('esperado_estado'))pm.expect(s.estado_semaforo).to.be.oneOf(pm.environment.get('esperado_estado').split('/'));if(pm.environment.get('esperado_unidad'))pm.expect(s.ultima_unidad).to.eql(pm.environment.get('esperado_unidad'));});"
              ],
              "_lastExecutionId": "0224ff70-0018-45fc-b413-d1cb2c25f3c7"
            }
          }
        ]
      },
      {
        "id": "ea9ac5cc-a268-4697-b186-32750bbfe058",
        "name": "API-172-A umbrales de la especie (solo GET)",
        "request": {
          "url": {
            "path": [
              "configuracion",
              "umbrales"
            ],
            "host": [
              "{{base_url}}"
            ],
            "query": [
              {
                "key": "id_especie",
                "value": "{{especie_id}}"
              }
            ],
            "variable": []
          },
          "header": [
            {
              "key": "Authorization",
              "value": "[REDACTADO]"
            }
          ],
          "method": "GET"
        },
        "response": [],
        "event": [
          {
            "listen": "test",
            "script": {
              "id": "ed54d619-910e-431a-80ae-d44a10f57e6f",
              "type": "text/javascript",
              "exec": [
                "const b=pm.response.code===200?pm.response.json():{}; const xs=b.items||[]; const keys=xs.map(x=>({campos:Object.keys(x).sort(),niveles:(x.niveles||[]).map(n=>Object.keys(n).sort())}));",
                "const esT=k=>/toleran|tolerance|^t$|^t_|_t$/i.test(k); const ausente=xs.length>0 && keys.every(x=>!x.campos.some(esT) && x.niveles.every(n=>!n.some(esT)));",
                "pm.test('[TC-M03-172][ASSERT][API-172-A] T configurable disponible en respuesta M09',()=>{pm.expect(pm.response.code).to.eql(200);pm.expect(ausente,'ausencia de T en umbral y niveles').to.eql(false);});"
              ]
            }
          }
        ]
      }
    ],
    "event": [
      {
        "listen": "prerequest",
        "script": {
          "id": "4bfb43a1-e7c9-4ad3-ab90-5e682412e719",
          "type": "text/javascript",
          "exec": [
            "if (pm.environment.get('qa_autorizado') !== 'SI' || !pm.environment.get('run_id') || !pm.environment.get('sandbox_secret')) { pm.execution.skipRequest(); return; }",
            "pm.request.headers.upsert({key:'X-Test-Run-Id',value:pm.environment.get('run_id')});",
            "pm.request.headers.upsert({key:'X-Sandbox-Secret',value:pm.environment.get('sandbox_secret')});",
            "if (pm.environment.get('solo_umbrales') === 'SI' && !pm.request.url.toString().includes('/configuracion/umbrales')) { pm.execution.skipRequest(); return; }",
            "if (pm.environment.get('solo_umbrales') !== 'SI' && pm.request.url.toString().includes('/configuracion/umbrales')) { pm.execution.skipRequest(); return; }",
            "if (pm.request.method === 'POST') { if (pm.environment.get('skip_ingesta') === 'SI') { pm.execution.skipRequest(); return; } const t=pm.environment.get('broker_service_token'); if (!t) { pm.execution.skipRequest(); return; } pm.request.headers.upsert({key:'Authorization',value:'Bearer '+t}); pm.request.body.update(pm.environment.get('cuerpo_ingesta')); }"
          ],
          "_lastExecutionId": "58eaf94a-a7b9-4448-b1b9-ce42e7d9a580"
        }
      },
      {
        "listen": "test",
        "script": {
          "id": "9d4dca8d-8313-41b9-a836-27e9156d8b9d",
          "type": "text/javascript",
          "exec": [
            "pm.test('[SETUP] Eco del RUN',()=>pm.expect(pm.response.headers.get('X-Test-Run-Id')).to.eql(pm.environment.get('run_id')));"
          ],
          "_lastExecutionId": "7c365bd1-3dc8-4795-a9b7-de0d279ddbb1"
        }
      }
