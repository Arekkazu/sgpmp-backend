{
  "info": {
    "name": "TC-M03-G90 — RF-58 sensor sin señal",
    "description": "Matriz TC-M03-175/176. El ejecutor prepara por API y verifica SIN_SEÑAL real antes de esta colección. No se juzga precedencia ROJO/GRIS en 175.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if(pm.environment.get('qa_autorizado')!=='SI'||!pm.environment.get('run_id')||!/^https:\\/\\//.test(pm.environment.get('base_url')||'')){if(pm.execution?.skipRequest)pm.execution.skipRequest();throw new Error('BLOQUEO_G90');}",
          "pm.request.headers.upsert({key:'X-Test-Run-Id',value:pm.environment.get('run_id')});pm.request.headers.upsert({key:'X-Sandbox-Secret',value:pm.environment.get('sandbox_secret')});"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('[SETUP] respuesta en sandbox',()=>pm.expect(pm.response.headers.get('X-Test-Run-Id')).to.eql(pm.environment.get('run_id')));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Dashboard con sensores sin señal",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tok_prod}}"
          }
        ],
        "url": "{{base_url}}/iot/monitoreo/dashboard?id_infraestructura={{id_infraestructura}}&por_pagina=50"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const b=pm.response.code===200?pm.response.json():{};",
              "const ss=Array.isArray(b.sensores)?b.sensores:[];",
              "const s=k=>ss.find(x=>String(x.id_sensor)===pm.environment.get('sensor_'+k));",
              "const x=s('175'),y=s('176'),now=Date.now();",
              "pm.test('[TC-M03-175][PRE][PRE-175-01] lectura y alerta preparadas por API oficial',()=>{pm.expect(Number(pm.environment.get('alerta_175'))).to.be.greaterThan(0);pm.expect(Number.isFinite(Date.parse(pm.environment.get('lectura_175')))).to.eql(true);});",
              "pm.test('[TC-M03-175][PRE][PRE-175-02] SIN_SEÑAL real y más de 5 min',()=>{pm.expect(x).to.be.an('object');pm.expect(x.estado_conectividad).to.eql('SIN_SEÑAL');pm.expect(now-Date.parse(pm.environment.get('lectura_175'))).to.be.greaterThan(300000);});",
              "pm.test('[TC-M03-176][PRE][PRE-176-01] lectura válida preparada con muestreo de 5 min',()=>{pm.expect(Number.isFinite(Date.parse(pm.environment.get('lectura_176')))).to.eql(true);});",
              "pm.test('[TC-M03-176][PRE][PRE-176-02] SIN_SEÑAL real de sensor 176',()=>{pm.expect(y).to.be.an('object');pm.expect(y.estado_conectividad).to.eql('SIN_SEÑAL');pm.expect(now-Date.parse(pm.environment.get('lectura_176'))).to.be.greaterThan(300000);});",
              "pm.test('[TC-M03-175][ASSERT][API-175-01] sensor y último valor conservados',()=>{pm.expect(pm.response.code).to.eql(200);pm.expect(Number(x.ultimo_valor)).to.eql(25);pm.expect(Date.parse(x.ultimo_timestamp_captura)).to.eql(Date.parse(pm.environment.get('lectura_175')));});",
              "pm.test('[TC-M03-175][ASSERT][API-175-02] tiempo sin reporte y alerta crítica visibles',()=>{pm.expect(Number(x.tiempo_sin_reporte_min)).to.be.greaterThan(5);pm.expect(String(x.id_alerta)).to.eql(pm.environment.get('alerta_175'));pm.expect(x.severidad_alerta).to.eql('CRITICO');});",
              "pm.test('[TC-M03-176][ASSERT][API-176-01] sensor conserva último valor',()=>{pm.expect(pm.response.code).to.eql(200);pm.expect(Number(y.ultimo_valor)).to.eql(25);pm.expect(Date.parse(y.ultimo_timestamp_captura)).to.eql(Date.parse(pm.environment.get('lectura_176')));});",
              "pm.test('[TC-M03-176][ASSERT][API-176-02] desactualizado, tiempo y GRIS',()=>{pm.expect(y.dato_desactualizado).to.eql(true);pm.expect(Number(y.tiempo_sin_reporte_min)).to.be.greaterThan(5);pm.expect(y.estado_semaforo).to.eql('GRIS');});"
            ]
          }
        }
      ]
    }
  ]
}
