    {
      "name": "2. TC-M03-022 Aplicar calibración (dos juegos de parámetros)",
      "item": [
        {
          "name": "TC-M03-022 - Lectura de 25.0 °C del sensor A",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('ts_captura', new Date(Date.now() - 2000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('TC-M03-022 (A): lectura aceptada (201)', function () { pm.response.to.have.status(201); });",
                  "const j = pm.response.json();",
                  "pm.test('TC-M03-022 (A): estado_calidad = LECTURA_VALIDA', function () { pm.expect(j.estado_calidad).to.eql('LECTURA_VALIDA'); });",
                  "pm.collectionVariables.set('id_tel_a', j.id_telemetria);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/iot/telemetria",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "iot",
                "telemetria"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": {{device_id}},\n  \"sensor_id\": {{sensor_a}},\n  \"tipo_variable\": \"TEMPERATURA_AMBIENTAL\",\n  \"valor\": 25.0,\n  \"unidad\": \"°C\",\n  \"timestamp_captura\": \"{{ts_captura}}\",\n  \"origen\": \"TIEMPO_REAL\",\n  \"access_key\": \"{{access_key}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "TC-M03-022 - Verificar valores persistidos del sensor A (RF-59)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Historial responde 200', function () { pm.response.to.have.status(200); });",
                  "const it = (pm.response.json().items || []).find(x => x.id_telemetria === Number(pm.collectionVariables.get('id_tel_a')));",
