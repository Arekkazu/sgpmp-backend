                  "pm.test('TC-M03-011c (+2 h): código ERROR_TIEMPO', function () { pm.expect(j.error_code).to.eql('ERROR_TIEMPO'); });",
                  "pm.test('TC-M03-011c (+2 h): no devuelve id_telemetria (no se persiste)', function () { pm.expect(j.id_telemetria).to.be.undefined; });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
