    {
      "name": "2. TC-M03-011 Timestamp futuro",
      "item": [
        {
          "name": "TC-M03-011a - timestamp_captura = hora del servidor (límite, se acepta)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const desfase = Number(pm.collectionVariables.get('desfase_ms') || 0);",
                  "pm.collectionVariables.set('ts_captura', new Date(Date.now() + desfase + 0).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('TC-M03-011a: hora exacta del servidor se procesa (201)', function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set('id_tel_limite', pm.response.json().id_telemetria);",
                  "const fecha = pm.response.headers.get('Date');",
                  "if (fecha) {",
                  "  const servidor = new Date(fecha).getTime();",
                  "  // El header trunca al segundo: se usa el punto medio del segundo como estimación.",
                  "  pm.collectionVariables.set('desfase_ms', String(servidor + 500 - Date.now()));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/iot/telemetria",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "iot",
                "telemetria"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": {{device_id}},\n  \"sensor_id\": {{sensor_id}},\n  \"tipo_variable\": \"TEMPERATURA_AMBIENTAL\",\n  \"valor\": 25.0,\n  \"unidad\": \"°C\",\n  \"timestamp_captura\": \"{{ts_captura}}\",\n  \"origen\": \"TIEMPO_REAL\",\n  \"access_key\": \"{{access_key}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "TC-M03-011b - timestamp_captura = servidor + 1 segundo",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const desfase = Number(pm.collectionVariables.get('desfase_ms') || 0);",
                  "pm.collectionVariables.set('ts_captura', new Date(Date.now() + desfase + 1000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('TC-M03-011b (+1 s): rechazado con 400', function () { pm.response.to.have.status(400); });",
                  "let j = {}; try { j = pm.response.json(); } catch (e) {}",
                  "pm.test('TC-M03-011b (+1 s): código ERROR_TIEMPO', function () { pm.expect(j.error_code).to.eql('ERROR_TIEMPO'); });",
                  "pm.test('TC-M03-011b (+1 s): no devuelve id_telemetria (no se persiste)', function () { pm.expect(j.id_telemetria).to.be.undefined; });",
                  "const fecha = pm.response.headers.get('Date');",
                  "if (fecha) {",
                  "  const servidor = new Date(fecha).getTime();",
                  "  // El header trunca al segundo: se usa el punto medio del segundo como estimación.",
                  "  pm.collectionVariables.set('desfase_ms', String(servidor + 500 - Date.now()));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/iot/telemetria",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "iot",
                "telemetria"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": {{device_id}},\n  \"sensor_id\": {{sensor_id}},\n  \"tipo_variable\": \"TEMPERATURA_AMBIENTAL\",\n  \"valor\": 25.0,\n  \"unidad\": \"°C\",\n  \"timestamp_captura\": \"{{ts_captura}}\",\n  \"origen\": \"TIEMPO_REAL\",\n  \"access_key\": \"{{access_key}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "TC-M03-011c - timestamp_captura = servidor + 2 horas",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
