        {
          "name": "Medir hora del servidor (header Date)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Health responde 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('La respuesta trae header Date', function () { pm.expect(pm.response.headers.get('Date')).to.be.a('string'); });",
                  "const fecha = pm.response.headers.get('Date');",
                  "if (fecha) {",
                  "  const servidor = new Date(fecha).getTime();",
                  "  // El header trunca al segundo: se usa el punto medio del segundo como estimación.",
                  "  pm.collectionVariables.set('desfase_ms', String(servidor + 500 - Date.now()));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "response": []
        }
