    {
      "name": "2. TC-M03-016 Fuera de rango operativo (se persiste)",
      "item": [
        {
          "name": "TC-M03-016 - Temperatura 45 °C (fuera de 20-30, físicamente posible)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('ts_captura', new Date(Date.now() - 2000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('TC-M03-016: valor 45 físicamente posible se persiste (201)', function () { pm.response.to.have.status(201); });",
                  "const j = pm.response.json();",
                  "pm.test('TC-M03-016: estado_calidad = FUERA_DE_RANGO', function () { pm.expect(j.estado_calidad).to.eql('FUERA_DE_RANGO'); });",
                  "pm.collectionVariables.set('id_tel_45', j.id_telemetria);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/iot/telemetria",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "iot",
                "telemetria"
              ]
            },
