            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const letras = 'abcdefghijklmnopqrstuvwxyz';",
                  "let sufijo = '';",
                  "for (let i = 0; i < 8; i++) sufijo += letras.charAt(Math.floor(Math.random() * letras.length));",
                  "pm.collectionVariables.set('sufijo', sufijo);",
                  "const ymd = (x) => x.toISOString().slice(0, 10);",
                  "pm.collectionVariables.set('fecha_desde', ymd(new Date(Date.now() - 86400000)));",
                  "pm.collectionVariables.set('fecha_hasta', ymd(new Date(Date.now() + 86400000)));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Finca creada (201)', function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set('id_finca', pm.response.json().id_finca);"
