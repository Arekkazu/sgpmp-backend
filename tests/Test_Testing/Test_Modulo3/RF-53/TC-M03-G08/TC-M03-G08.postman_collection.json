    {
      "name": "3. TC-M03-032 Lote desordenado procesado en orden cronológico",
      "item": [
        {
          "name": "TC-M03-032 prep - Lectura ya existente en el minuto 4 (valor 99.0)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const desfase = Number(pm.collectionVariables.get('desfase_ms') || 0);",
                  "const ancla = Date.now() + desfase - 3 * 3600000;",
                  "const ts = (m) => new Date(ancla + m * 60000).toISOString();",
                  "pm.collectionVariables.set('ts_032_existente', ts(4));",
                  "const orden = [7, 2, 10, 4, 1, 9, 5, 3, 8, 6];",
                  "const registros = orden.map(m => ({",
                  "  device_id: Number(pm.collectionVariables.get('device_id')),",
                  "  sensor_id: Number(pm.collectionVariables.get('s032')),",
                  "  tipo_variable: 'TEMPERATURA_AMBIENTAL',",
                  "  valor: 20 + m,",
                  "  unidad: '°C',",
                  "  timestamp_captura: ts(m),",
                  "  origen: 'BUFFER_LOCAL',",
                  "  serial: pm.collectionVariables.get('access_key')",
                  "}));",
                  "pm.collectionVariables.set('lote_032', JSON.stringify({ registros: registros }));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Lectura previa registrada (201)', function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set('id_tel_032_existente', pm.response.json().id_telemetria);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{broker_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/iot/telemetria",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "iot",
                "telemetria"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": {{device_id}},\n  \"sensor_id\": {{s032}},\n  \"tipo_variable\": \"TEMPERATURA_AMBIENTAL\",\n  \"valor\": 99.0,\n  \"unidad\": \"°C\",\n  \"timestamp_captura\": \"{{ts_032_existente}}\",\n  \"origen\": \"BUFFER_LOCAL\",\n  \"serial\": \"{{access_key}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
