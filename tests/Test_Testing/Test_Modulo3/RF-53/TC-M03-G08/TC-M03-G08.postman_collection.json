    {
      "name": "2. TC-M03-021 Idempotencia ante 10 reenvíos",
      "item": [
        {
          "name": "TC-M03-021 - Reenvío del mismo datagrama BUFFER_LOCAL (x10)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let n = Number(pm.collectionVariables.get('reenvio_n') || 0);",
                  "if (n === 0) {",
                  "  const desfase = Number(pm.collectionVariables.get('desfase_ms') || 0);",
                  "  // Dato del buffer con 2 h de antigüedad; el mismo timestamp en los 10 envíos.",
                  "  pm.collectionVariables.set('ts_021', new Date(Date.now() + desfase - 2 * 3600000).toISOString());",
                  "  pm.collectionVariables.set('reenvio_codigos', '[]');",
                  "}",
                  "pm.collectionVariables.set('reenvio_n', String(n + 1));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const n = Number(pm.collectionVariables.get('reenvio_n'));",
                  "const codigos = JSON.parse(pm.collectionVariables.get('reenvio_codigos'));",
                  "let j = {}; try { j = pm.response.json(); } catch (e) {}",
                  "codigos.push({ intento: n, status: pm.response.code, id: j.id_telemetria || null, error_code: j.error_code || null });",
                  "pm.collectionVariables.set('reenvio_codigos', JSON.stringify(codigos));",
                  "if (n === 1) {",
                  "  pm.test('TC-M03-021 intento 1: se almacena (201)', function () { pm.response.to.have.status(201); });",
                  "  pm.collectionVariables.set('id_tel_021', j.id_telemetria);",
                  "} else {",
                  "  pm.test('TC-M03-021 intento ' + n + ': no crea un registro nuevo', function () {",
                  "    const mismo = pm.response.code === 200 && j.id_telemetria === Number(pm.collectionVariables.get('id_tel_021'));",
                  "    const dup = pm.response.code === 409 && j.error_code === 'ERROR_DUPLICADO';",
                  "    pm.expect(mismo || dup, 'status ' + pm.response.code + ' ' + (j.error_code || '')).to.eql(true);",
                  "  });",
                  "}",
                  "if (n < 10) { postman.setNextRequest('TC-M03-021 - Reenvío del mismo datagrama BUFFER_LOCAL (x10)'); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{broker_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/iot/telemetria",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "iot",
                "telemetria"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": {{device_id}},\n  \"sensor_id\": {{s021}},\n  \"tipo_variable\": \"TEMPERATURA_AMBIENTAL\",\n  \"valor\": 25.0,\n  \"unidad\": \"°C\",\n  \"timestamp_captura\": \"{{ts_021}}\",\n  \"origen\": \"BUFFER_LOCAL\",\n  \"serial\": \"{{access_key}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "TC-M03-021 - Existe un único registro tras los 10 reenvíos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "console.log('Reenvíos:', pm.collectionVariables.get('reenvio_codigos'));",
                  "pm.test('Historial responde 200', function () { pm.response.to.have.status(200); });",
                  "const items = pm.response.json().items || [];",
                  "pm.test('TC-M03-021: un solo registro en la base', function () {",
                  "  pm.expect(items.map(x => x.id_telemetria)).to.eql([Number(pm.collectionVariables.get('id_tel_021'))]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/iot/monitoreo/historial?fecha_inicio={{fecha_desde}}&fecha_fin={{fecha_hasta}}&sensor_id={{s021}}&orden=ASC&por_pagina=500",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "iot",
                "monitoreo",
                "historial"
              ],
              "query": [
                {
                  "key": "fecha_inicio",
                  "value": "{{fecha_desde}}"
                },
                {
                  "key": "fecha_fin",
                  "value": "{{fecha_hasta}}"
                },
                {
                  "key": "sensor_id",
                  "value": "{{s021}}"
                },
                {
                  "key": "orden",
                  "value": "ASC"
                },
                {
                  "key": "por_pagina",
                  "value": "500"
                }
              ]
            }
          },
          "response": []
