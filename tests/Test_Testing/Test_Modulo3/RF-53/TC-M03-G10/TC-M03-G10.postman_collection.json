        {
          "name": "TC-M03-024/059 - Verificar persistencia y trazabilidad (RF-59)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Historial responde 200', function () { pm.response.to.have.status(200); });",
                  "const items = pm.response.json().items || [];",
                  "pm.test('TC-M03-024: solo se persistieron los dos datos con ventana (024b y 059)', function () {",
                  "  const esperados = ['id_tel_024', 'id_tel_059'].map(k => Number(pm.collectionVariables.get(k))).sort();",
                  "  pm.expect(items.map(x => x.id_telemetria).sort()).to.eql(esperados);",
                  "});",
                  "const it = items.find(x => x.id_telemetria === Number(pm.collectionVariables.get('id_tel_059')));",
                  "if (it) {",
                  "  pm.test('TC-M03-059: origen EDGE_AGREGADO conservado', function () { pm.expect(it.origen_dato).to.eql('EDGE_AGREGADO'); });",
                  "  pm.test('TC-M03-059: estado LECTURA_VALIDA', function () { pm.expect(it.estado_calidad).to.eql('LECTURA_VALIDA'); });",
                  "  pm.test('TC-M03-059: valor 22 rpm de FRECUENCIA_RESPIRATORIA', function () {",
                  "    pm.expect(Number(it.valor)).to.eql(22); pm.expect(it.tipo_variable).to.eql('FRECUENCIA_RESPIRATORIA'); pm.expect(it.unidad_medida).to.eql('rpm');",
                  "  });",
                  "  pm.test('TC-M03-059: se expone tipo_dato=AGREGADO', function () { pm.expect(it.tipo_dato).to.eql('AGREGADO'); });",
                  "  pm.test('TC-M03-059: se expone la ventana_agregacion (5)', function () { pm.expect(Number(it.ventana_agregacion_min ?? it.ventana_agregacion)).to.eql(5); });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/iot/monitoreo/historial?fecha_inicio={{fecha_desde}}&fecha_fin={{fecha_hasta}}&sensor_id={{sensor_id}}",
              "host": [
