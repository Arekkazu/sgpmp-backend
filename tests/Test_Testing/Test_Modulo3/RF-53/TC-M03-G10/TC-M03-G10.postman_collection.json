                "telemetria"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": {{device_id}},\n  \"sensor_id\": {{sensor_id}},\n  \"tipo_variable\": \"FRECUENCIA_RESPIRATORIA\",\n  \"categoria_variable\": \"ANIMAL\",\n  \"valor\": 22,\n  \"unidad\": \"rpm\",\n  \"timestamp_captura\": \"{{ts_captura}}\",\n  \"origen\": \"EDGE_AGREGADO\",\n  \"valor_agregado\": true,\n  \"frecuencia_muestreo\": 1,\n  \"access_key\": \"{{access_key}}\"\n}",
              "options": {
