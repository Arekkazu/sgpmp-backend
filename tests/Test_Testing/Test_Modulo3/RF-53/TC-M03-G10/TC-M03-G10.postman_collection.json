      "name": "2. TC-M03-024 ventana_agregacion obligatoria con valor_agregado",
      "item": [
        {
          "name": "TC-M03-024a - valor_agregado=true sin ventana_agregacion",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('ts_captura', new Date(Date.now() - 2000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('TC-M03-024a: rechazado por estructura incompleta (400)', function () { pm.response.to.have.status(400); });",
                  "let j = {}; try { j = pm.response.json(); } catch (e) {}",
                  "pm.test('TC-M03-024a: código de rechazo estructural', function () { pm.expect(j.error_code).to.be.oneOf(['ERROR_ESTRUCTURA', 'VAL_ENTRADA', 'VALOR_NO_PERMITIDO']); });",
                  "pm.test('TC-M03-024a: no devuelve id_telemetria (no se persiste)', function () { pm.expect(j.id_telemetria).to.be.undefined; });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
