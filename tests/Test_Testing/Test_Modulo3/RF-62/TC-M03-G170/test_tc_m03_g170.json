      "item": [
        {
          "name": "00-Preflight-Login-Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sesiones/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sesiones",
                ""
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo_electronico\": \"administador.dev@gmail.com\",\n  \"contrasena\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 - Login exitoso en /sesiones/\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.token).to.be.a(\"string\").and.not.be.empty;",
                  "    pm.collectionVariables.set(\"token_admin\", res.token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "01-Descubrimiento-Sensor-G170",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/test-control/query",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "test-control",
                "query"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"SELECT s.id_sensores, s.id_dispositivo_iot, d.serial FROM modulo9.sensores s JOIN modulo9.dispositivos_iot d ON s.id_dispositivo_iot = d.id_dispositivo_iot WHERE s.es_activo = true AND d.es_activo = true ORDER BY s.id_sensores ASC LIMIT 1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 - Sensor descubierto\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const rows = pm.response.json().data || pm.response.json().rows || [];",
                  "    pm.expect(rows.length).to.be.above(0);",
                  "    pm.collectionVariables.set(\"sensor_id\", rows[0].id_sensores);",
                  "    pm.collectionVariables.set(\"device_id\", rows[0].id_dispositivo_iot);",
                  "    pm.collectionVariables.set(\"device_serial\", rows[0].serial);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
