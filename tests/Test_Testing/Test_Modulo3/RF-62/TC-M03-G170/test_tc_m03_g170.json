              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"INSERT INTO modulo3.telemetria_calidad (id_telemetria, id_sensor, timestamp_evaluacion, indice_calidad, clasificacion_calidad, apto_para_ia, apto_para_nic41, flags_detectados, parametros_aplicados, parametros_calibracion_aplicados, estado_evaluacion, version_evaluacion) SELECT t.id_telemetria, t.id_sensor, t.timestamp_captura, 90, 'APTO', true, true, '{\\\"posible_drift\\\": {\\\"activo\\\": true}}'::jsonb, '{\\\"k\\\": 3}'::jsonb, '{\\\"ganancia\\\": 1, \\\"offset\\\": -1.4}'::jsonb, 'VIGENTE', 'v1.0-inicial' FROM modulo3.telemetrias t WHERE t.id_sensor = {{sensor_id}} AND t.timestamp_captura >= '2026-10-10T10:00:00Z' AND t.timestamp_captura <= '2026-10-10T10:40:00Z' RETURNING id_evaluacion\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 - 5 evaluaciones vigentes creadas para el fixture\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const rows = pm.response.json().data || pm.response.json().rows || [];",
                  "    pm.expect(rows.length).to.equal(5);",
                  "});"
                ]
              }
            }
          ]
        }
