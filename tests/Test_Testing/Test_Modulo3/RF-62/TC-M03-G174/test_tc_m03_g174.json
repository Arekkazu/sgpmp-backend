          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 - Login exitoso para admin\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.token).to.be.a(\"string\").and.not.be.empty;",
                  "    pm.collectionVariables.set(\"token_admin\", res.token);",
                  "    // Extraer y validar claim rol del JWT",
                  "    try {",
                  "        const payload = JSON.parse(CryptoJS.enc.Utf8.stringify(CryptoJS.enc.Base64.parse(res.token.split(\".\")[1])));",
                  "        if (payload.rol !== 1) {",
                  "            console.log(\"[DISCREPANCIA] Rol en JWT para administador.dev@gmail.com: obtenido \" + payload.rol + \", esperado 1\");",
                  "        }",
                  "    } catch (e) {",
                  "        console.error(\"Error parseando JWT:\", e);",
                  "    }",
                  "});"
                ]
              }
            }
