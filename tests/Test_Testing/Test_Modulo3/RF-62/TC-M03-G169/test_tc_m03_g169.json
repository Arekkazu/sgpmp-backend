    {
      "name": "00-Preflight",
      "item": [
        {
          "name": "00.01-Login-Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sesiones/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sesiones",
                ""
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo_electronico\": \"administador.dev@gmail.com\",\n  \"contrasena\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const r = pm.response.json();",
                  "    pm.expect(r.token).to.be.a(\"string\").and.not.empty;",
                  "    pm.collectionVariables.set(\"token_admin\", r.token);",
                  "});",
                  "try {",
                  "    const parts = pm.response.json().token.split(\".\");",
                  "    if (parts.length === 3) {",
                  "        const payload = JSON.parse(Buffer.from(parts[1], \"base64\").toString(\"utf8\"));",
                  "        const id = payload.sub || payload.id_usuario || payload.user_id;",
                  "        pm.test(\"id_usuario extraido del JWT\", function () {",
                  "            pm.expect(id, \"JWT sin sub/id_usuario/user_id\").to.exist;",
                  "        });",
                  "        pm.collectionVariables.set(\"id_usuario_admin\", id);",
                  "    }",
                  "} catch (e) {",
                  "    pm.test(\"Decodificar JWT\", function () { pm.expect.fail(\"Error: \" + e.message); });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "TC-321-fuera-de-rango",
      "item": [
        {
          "name": "321.04-Ingestar-Lectura-Fuera-Rango",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{broker_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/iot/telemetria",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "iot",
                "telemetria"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"{{device_id_321}}\",\n  \"sensor_id\": \"{{sensor_id_321}}\",\n  \"tipo_variable\": \"TEMPERATURA_AMBIENTAL\",\n  \"valor\": 50,\n  \"unidad\": \"°C\",\n  \"timestamp_captura\": \"{{ts_321}}\",\n  \"serial\": \"{{serial_321}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const nowMs = Date.now();",
                  "const ts321 = new Date(nowMs - 60 * 1000).toISOString().slice(0, 19) + \"Z\";",
                  "pm.collectionVariables.set(\"ts_321\", ts321);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"321: Ingesta 201 con FUERA_DE_RANGO\", function () {",
                  "    pm.response.to.have.status(201);",
                  "    const r = pm.response.json();",
                  "    pm.expect(r.id_telemetria).to.be.a(\"number\").and.above(0);",
                  "    pm.expect(r.estado_calidad).to.equal(\"FUERA_DE_RANGO\");",
                  "    pm.collectionVariables.set(\"tel_id_321\", r.id_telemetria);",
                  "    pm.collectionVariables.set(\"id_telemetria_321\", r.id_telemetria);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "321.05-Evaluar-Calidad",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/iot/calidad/{{tel_id_321}}/evaluar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "iot",
                "calidad",
                "{{tel_id_321}}",
                "evaluar"
              ],
              "query": []
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"321: Evaluar 201 -> NO_APTO, índice 0, fuera_de_rango_rf53 activo\", function () {",
                  "    pm.response.to.have.status(201);",
                  "    const r = pm.response.json();",
                  "    pm.expect(r.indice_calidad).to.equal(0);",
                  "    pm.expect(r.clasificacion_calidad).to.equal(\"NO_APTO\");",
                  "    pm.expect(r.apto_para_ia).to.equal(false);",
                  "    pm.expect(r.apto_para_nic41).to.equal(false);",
                  "    const flags = r.flags_detectados || {};",
                  "    pm.expect(flags.fuera_de_rango_rf53).to.exist;",
                  "    pm.expect(flags.fuera_de_rango_rf53.activo).to.equal(true);",
                  "    pm.expect(flags.sensor_congelado).to.be.undefined;",
                  "    pm.expect(flags.outlier_estadistico).to.be.undefined;",
                  "    pm.expect(flags.posible_drift).to.be.undefined;",
                  "    pm.expect(flags.gap_temporal_anomalo).to.be.undefined;",
                  "});",
                  "pm.test(\"version_limites_fisicos_aplicada presente\", () => {",
                  "    const v = pm.response.json().version_limites_fisicos_aplicada;",
                  "    pm.expect(v).to.not.be.undefined;",
                  "    pm.expect(v).to.not.be.null;",
                  "});",
                  "pm.test(\"parametros_aplicados presente\", () => {",
                  "    const p = pm.response.json().parametros_aplicados;",
                  "    pm.expect(p).to.not.be.undefined;",
                  "    pm.expect(p).to.not.be.null;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "321.06-Verificar-Persistencia-GET",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/iot/calidad/{{tel_id_321}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "iot",
                "calidad",
                "{{tel_id_321}}"
              ],
              "query": []
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"321: GET calidad 200 coincide con evaluación\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const r = pm.response.json();",
                  "    pm.expect(r.indice_calidad).to.equal(0);",
                  "    pm.expect(r.clasificacion_calidad).to.equal(\"NO_APTO\");",
                  "    pm.expect(r.apto_para_ia).to.equal(false);",
                  "    pm.expect(r.apto_para_nic41).to.equal(false);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "321.07-Verificar-Inmutabilidad-RF53",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Sandbox-Secret",
                "value": "{{sandbox_secret}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/test-control/query",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "test-control",
                "query"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"SELECT _q.* FROM (SELECT set_config('app.current_role', 'Administrador', true) AS r, set_config('app.current_user_id', (SELECT modulo1.fn_id_usuario_por_correo('administador.dev@gmail.com')::text), true) AS u, set_config('app.usuario_id', (SELECT modulo1.fn_id_usuario_por_correo('administador.dev@gmail.com')::text), true) AS uid) _rls CROSS JOIN LATERAL (SELECT valor_crudo, unidad_medida, timestamp_captura, estado_calidad FROM modulo3.telemetrias WHERE id_telemetria = {{tel_id_321}}) _q WHERE _rls.r != '' AND _rls.u != '' AND _rls.uid != ''\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"TC-321: valor original en RF-53 intacto tras POST /evaluar\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const rows = pm.response.json().data || pm.response.json().rows || [];",
                  "    pm.expect(rows.length).to.be.above(0);",
                  "    const row = rows[0];",
                  "    pm.expect(parseFloat(row.valor_crudo !== undefined ? row.valor_crudo : row.valor)).to.equal(50.00);",
                  "    pm.expect(row.unidad_medida || row.unidad).to.equal(\"°C\");",
                  "    pm.expect(row.estado_calidad).to.equal(\"FUERA_DE_RANGO\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "321.09-Verificar-Sin-Alerta-Tecnica",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Sandbox-Secret",
                "value": "{{sandbox_secret}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/test-control/query",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "test-control",
                "query"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"SELECT _q.* FROM (SELECT set_config('app.current_role', 'Administrador', true) AS r, set_config('app.current_user_id', (SELECT modulo1.fn_id_usuario_por_correo('administador.dev@gmail.com')::text), true) AS u, set_config('app.usuario_id', (SELECT modulo1.fn_id_usuario_por_correo('administador.dev@gmail.com')::text), true) AS uid) _rls CROSS JOIN LATERAL (SELECT COUNT(*) AS n FROM modulo3.bitacora_auditoria_iot WHERE entidad_afectada_id = '{{id_telemetria_321}}' AND tipo_evento = 'ALERTA_TECNICA_EMITIDA') _q WHERE _rls.r != '' AND _rls.u != '' AND _rls.uid != ''\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"NO se disparó alerta técnica en RF-57 para FUERA_DE_RANGO\", () => {",
                  "    const resp = pm.response.json();",
                  "    const rows = resp.data || resp.rows || resp;",
                  "    const n = Array.isArray(rows) ? (rows[0] ? rows[0].n : 0) : (rows.n !== undefined ? rows.n : rows);",
                  "    pm.expect(parseInt(n)).to.eql(0);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
