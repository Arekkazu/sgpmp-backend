            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"INSERT INTO modulo3.telemetrias (id_sensor, id_variable, id_dispositivo_iot, valor_crudo, valor_ajustado, timestamp_captura, timestamp_procesamiento, origen, estado_calidad, calibrado, categoria_variable, unidad_medida) VALUES ({{s1_sensor_id}}, 9, {{s1_device_id}}, 150.00, NULL, '2026-10-15T10:00:00Z', NOW(), 'BUFFER_LOCAL', 'FUERA_DE_RANGO', false, 'AMBIENTAL', '°C') RETURNING id_telemetria\"\n}",
