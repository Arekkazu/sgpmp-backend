# ==============================================================
# Variables para docker-compose.yml / Dokploy
# Estas son las que docker-compose necesita literalmente para
# levantar los servicios "db" y "backend" (ver docker-compose.yml).
# ==============================================================

# Postgres del servicio "db". docker-compose arma DATABASE_URL
# automáticamente a partir de estas tres (no la definas aparte).
POSTGRES_USER=usuario
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_DB=sgpmp

# DB_PORT: único puerto de host que docker-compose.yml publica (Postgres).
# El backend no publica puerto de host: se enruta por dominio vía Traefik.
# Debe ser distinto por ambiente si corren varios (dev/test/prod) a la vez.
DB_PORT=5447

# ==============================================================
# Configuración del Backend y Seguridad (JWT)
# ==============================================================

# "production" habilita comportamiento específico de prod en main.py.
# Dejar vacío/"development" en dev y test.
ENV=

# Frontend URL (CORS + links en emails)
FRONTEND_URL=http://localhost:3000

# JWT (algoritmo fijo HS256, no configurable)
SECRET_KEY=clave_secreta_larga
JWT_EXPIRE_HOURS=8

# Refresh token (opaco, vía cookie HttpOnly — no es JWT)
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==============================================================
# Servicios Externos e Integraciones
# ==============================================================

# Firebase
FIREBASE_CREDENTIALS={"type":"service_account","project_id":"..."}
FIREBASE_STORAGE_BUCKET=tu-bucket.appspot.com

# Ruta donde se guardan los artefactos de modelos de predicción.
# Si no se define, cae a /tmp/sgpmp_modelos.
MODELOS_STORAGE_PATH=

# SMTP (envío de emails: activación de cuenta, recuperación, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Auditoría
AUDIT_SERVICE_URL=http://localhost:8002

# Broker MQTT (RF-23) — el hash sha256 de este valor debe existir en
# modulo1.credenciales_servicio (nombre_servicio='broker_mqtt', es_activo=true)
MQTT_BROKER_URL=http://localhost:8001
MQTT_BROKER_TOKEN=

# ==============================================================
# AGROFUSION — SSO e Integración
# Vacías/ausentes => SSO responde 503 y la sincronización server-to-server
# no se monta; el backend funciona 100% standalone sin esto.
# ==============================================================

# SSO con AgroFusion (Mecanismo A — handoff de login interactivo RS256)
AGROFUSION_SSO_PUBLIC_KEY_PATH=
AGROFUSION_PROJECT_CODE=
AGROFUSION_ISSUER=agrofusion-auth

# Integración con AgroFusion (Mecanismo B — sincronización server-to-server)
AGROFUSION_HUB_CLIENT_ID=
AGROFUSION_HUB_CLIENT_SECRET=