# ==============================================================
# Variables para docker-compose.yml / Dokploy
# Estas son las que docker-compose necesita literalmente para
# levantar los servicios "db" y "backend" (ver docker-compose.yml).
# ==============================================================

# Postgres del servicio "db". docker-compose arma DATABASE_URL
# automáticamente a partir de estas tres (no la definas aparte).
POSTGRES_USER=usuario
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_DB=sgpmp

# DB_PORT: único puerto de host que docker-compose.yml publica (Postgres).
# El backend no publica puerto de host: se enruta por dominio vía Traefik.
# Debe ser distinto por ambiente si corren varios (dev/test/prod) a la vez.
DB_PORT=5447

# Control de acceso por BD (F1 del plan de control de acceso, lado
# desarrollo): DATABASE_URL debe apuntar a `sgpmp_app` (LOGIN, sujeto a RLS,
# NUNCA al superusuario `postgres`). ALEMBIC_DATABASE_URL apunta a
# `sgpmp_owner` (NOLOGIN salvo para migraciones, dueño de los objetos) y la
# usa exclusivamente `alembic/env.py`; si no se define, las migraciones caen
# a DATABASE_URL. Ninguna de las dos existe todavía en docker-compose.yml —
# ese Postgres (Dokploy) no bootstrapea `sgpmp_app`/`sgpmp_owner` en ningún
# init-script (`Dockerfile.postgres` solo instala pg_cron); coordinar con
# chebaztian antes de cambiar el compose de producción.
# ALEMBIC_DATABASE_URL=postgresql://sgpmp_owner:clave@localhost:5432/sgpmp

# ==============================================================
# Configuración del Backend y Seguridad (JWT)
# ==============================================================

# "production" ya NO controla CORS (ver ALLOWED_ORIGINS más abajo). Solo
# afecta las cookies de refresh como fallback (ver COOKIE_SECURE abajo).
ENV=

# Flags de la cookie de refresh (HttpOnly). Obligatorias si ENV=production:
# el backend valida al arranque y se niega a levantar si faltan. Preferir
# estas variables explícitas antes que ENV: si ENV no vale literalmente
# "production", la cookie sale SameSite=Strict sin Secure y el front (en otro
# sitio) nunca la envía — el refresh falla y la sesión muere al navegar.
# Valores de ejemplo; ajústalos a tu ambiente:
# COOKIE_SECURE=true|false  (true siempre que el front use https)
# COOKIE_SAMESITE=none|lax|strict (none fuerza secure=true porque los
# navegadores descartan None sin Secure)
# Nota: si front y backend comparten dominio (solo rutas distintas, p. ej.
# / y /api), son el MISMO sitio y lax/strict funcionan; none solo hace falta
# cuando viven en dominios registrables distintos.
# docker-compose.yml debe reenviar estas variables al contenedor.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Origen(es) exactos permitidos para CORS, separados por coma, sin "/" final.
# localhost/127.0.0.1 (cualquier puerto) ya está permitido siempre aparte de
# esto, no hace falta listarlo. Agregar acá el front real de Dokploy cada vez
# que cambie de URL — es una env var en Dokploy, no un cambio de código.
ALLOWED_ORIGINS=https://tu-frontend-en-dokploy.example.com

# Prefijo externo que Dokploy le asigna a este servicio (su config de Path
# en el dominio). Solo afecta los links que genera /docs; no cambia el
# ruteo real (eso lo maneja Traefik con "Strip Path"). Vacío = /api.
ROOT_PATH=

# Frontend URL usada solo para armar links en emails (activación, reset de
# contraseña). Ya no controla CORS.
FRONTEND_URL=http://localhost:3000

# JWT (algoritmo fijo HS256, no configurable)
SECRET_KEY=clave_secreta_larga
JWT_EXPIRE_HOURS=8

# Tolerancia de skew de reloj al verificar exp (segundos). Evita
# TOKEN_EXPIRADO espurios cuando el reloj del servidor va por detrás del
# emisor del token.
JWT_LEEWAY_SECONDS=30

# Refresh token (opaco, vía cookie HttpOnly — no es JWT)
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==============================================================
# Servicios Externos e Integraciones
# ==============================================================

# Firebase — ruta al archivo de credenciales del service account (no el
# JSON inline). El código lee FIREBASE_CREDENTIALS_PATH, no FIREBASE_CREDENTIALS.
# Vacía => notificaciones push deshabilitadas, sin romper el resto de la app.
FIREBASE_CREDENTIALS_PATH=

# Ruta donde se guardan los artefactos de modelos de predicción.
# Si no se define, cae a /tmp/sgpmp_modelos.
MODELOS_STORAGE_PATH=

# Ruta donde se guardan los logotipos institucionales (RF-26).
# Si no se define, cae a /tmp/sgpmp_logos. En Docker debe apuntar a un
# volumen persistente montado en el contenedor (ver docker-compose.yml).
LOGOS_STORAGE_PATH=

# SMTP (envío de emails: activación de cuenta, recuperación, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Google reCAPTCHA v2 — clave secreta usada solo por el backend en RF-01.
# La site key pública se configura en el frontend, no en este repositorio.
RECAPTCHA_SECRET_KEY=

# Auditoría
AUDIT_SERVICE_URL=http://localhost:8002

# RF-52 E3 (M02): eventos de bitácora por segundo, por proceso, a partir de los
# cuales los INFO se encolan y se persisten por lotes. Opcional; por defecto 100.
AUDITORIA_M02_EVENTOS_POR_SEGUNDO=100

# RF-73 E2/E8 (M04, DEV-37): intentos de persistir un evento de la bitácora antes de
# ir al respaldo local, y carpeta del respaldo (audit_fallback_M04_YYYYMMDD.log).
# Opcionales; por defecto 3 y logs.
AUDITORIA_M04_REINTENTOS=3
AUDITORIA_M04_DIR_RESPALDO=logs

# OTA de modelos por componente (DEV-15, D6 de AIOT-DEV-03).
# OTA_URL_SECRET firma (HMAC-SHA256) las URLs temporales de descarga del artefacto;
# OTA_URL_BASE es la URL pública con la que el nodo llega al backend (con /api si
# hay proxy). Sin las dos, POST /prediccion/ota/distribuciones responde 503.
# OTA_ARTEFACTOS_DIR es la raíz de versiones_modelos.ruta_artefacto; vacío usa
# MODELOS_STORAGE_PATH, donde RF-69 guarda los artefactos.
# Los reportes del nodo (POST /prediccion/ota/reportes) usan BROKER_SERVICE_TOKEN (DEV-06).
OTA_URL_SECRET=
OTA_URL_BASE=http://localhost:8000
OTA_ARTEFACTOS_DIR=
OTA_URL_TTL_SEGUNDOS=86400

# Broker MQTT (RF-23) — el hash sha256 de este valor debe existir en
# modulo1.credenciales_servicio (nombre_servicio='broker_mqtt', es_activo=true)
MQTT_BROKER_URL=http://localhost:8001
MQTT_BROKER_TOKEN=

# Token de servicio broker -> backend (D3, AIOT-DEV-03): el broker lo envía en
# Authorization: Bearer al llamar /iot/*. Mismo valor que BROKER_SERVICE_TOKEN en
# BROKER-MQTT-SGPMP; se entrega por canal seguro, nunca en el repositorio.
# Vacío => los endpoints /iot/* de dispositivo responden 503.
BROKER_SERVICE_TOKEN=

# ==============================================================
# AGROFUSION — SSO e Integración
# Vacías/ausentes => SSO responde 503 y la sincronización server-to-server
# no se monta; el backend funciona 100% standalone sin esto.
# ==============================================================

# SSO con AgroFusion (Mecanismo A — handoff de login interactivo RS256)
AGROFUSION_SSO_PUBLIC_KEY_PATH=
AGROFUSION_PROJECT_CODE=
AGROFUSION_ISSUER=agrofusion-auth

# Integración con AgroFusion (Mecanismo B — sincronización server-to-server)
AGROFUSION_HUB_CLIENT_ID=
AGROFUSION_HUB_CLIENT_SECRET=

# RF-71 — clave interna para el registro de modelos de predicción
RF71_INTERNAL_KEY=

# DEV-05: son parámetros técnicos del procesador, no umbrales de negocio M09.
IOT_POSTCOMMIT_LOTE=50
IOT_POSTCOMMIT_INTERVALO_SEG=5
IOT_POSTCOMMIT_REINTENTO_SEG=60
# M3-12: la espera entre reintentos se duplica en cada fallo hasta este tope (1 día).
IOT_POSTCOMMIT_REINTENTO_MAX_SEG=86400
# INC-M03-113-G56 RF-56: cada cuántos segundos la cola reenvía paquetes de inferencia
# pendientes. Las esperas entre intentos (0/5/15/30/60 s) son de RF-56 y no se configuran.
IOT_INFERENCIA_REENVIO_SEG=5

# RF-56 Fase 6 (INC-M03-120-G63): cliente de transporte hacia M04 (motor de inferencia).
# Vacía => sin envío real: los paquetes quedan pendientes (MOTOR_INFERENCIA_NO_INTEGRADO).
# Solo https://; una URL http:// o un TLS mínimo < 1.2 se rechaza y se sigue con el stub.
# El endpoint y el token son provisionales hasta que se defina el contrato IA-1 de M04.
IOT_INFERENCIA_M04_URL=
IOT_INFERENCIA_M04_TOKEN=
# Versión mínima de TLS aceptada (1.3 por los RNF de M03; 1.2 solo si M04 no soporta 1.3).
IOT_INFERENCIA_TLS_MIN=1.3
# CA que firma el certificado de M04 (PEM). Vacía => CA del sistema.
IOT_INFERENCIA_CA_FILE=

# RF-56 E6 (INC-M03-121-G64): eventos Edge no CRITICO aceptados por dispositivo en 60 s
# (ventana deslizante, contador por proceso). Al superarlo: 429 LIMITE_TASA_EXCEDIDO con
# Retry-After. Los CRITICO nunca se frenan. Vacía => 60 (propuesta DEV-45, pendiente de Análisis).
IOT_EVENTOS_EDGE_LIMITE_POR_MINUTO=60
