# Base de datos PostgreSQL
#DATABASE_URL=postgresql://usuario:password@localhost:5432/sigma_db
DATABASE_URL=postgresql://usuario:password@localhost:5432/bd_test

# Frontend URL (para CORS)
FRONTEND_URL=http://localhost:3000

# JWT
SECRET_KEY=tu_clave_secreta_aqui

# Firebase (JSON completo como string escapado)
FIREBASE_CREDENTIALS={"type":"service_account","project_id":"..."}
FIREBASE_STORAGE_BUCKET=tu-bucket.appspot.com

# OAuth Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# OAuth Microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=

# API externa de usuarios
EXTERNAL_USERS_API_URL=http://localhost:8001

# Email (si se usa SMTP directo)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Auditoría
AUDIT_SERVICE_URL=http://localhost:8002
